*> Implementation test of client/src/regex.cob (REGEX-FIND; 08 §3.3): Java Pattern.asPredicate
*> find semantics (a match anywhere in the subject) for the supported subset: literals, ".",
*> escapes, character classes with ranges and negation, anchors, groups, alternation and greedy,
*> lazy and counted quantifiers; an invalid or unsupported pattern reports an error.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-REGEX.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 01 WS-PAT                 PIC X(128).
 01 WS-PAT-LENGTH          BINARY-LONG.
 01 WS-SUBJ                PIC X(256).
 01 WS-SUBJ-LENGTH         BINARY-LONG.
 01 WS-EXPECT              PIC X.
 01 WS-FIXED               BINARY-LONG VALUE 0.
 01 WS-MATCHED             BINARY-LONG.
 01 WS-ERROR               BINARY-LONG.
 01 WS-LF                  PIC X VALUE X"0A".
 01 WS-TAB                 PIC X VALUE X"09".
 PROCEDURE DIVISION.
     MOVE "abc" TO WS-PAT  MOVE "xxabcxx" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "abd" TO WS-PAT  MOVE "xxabcxx" TO WS-SUBJ  MOVE "0" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "^abc" TO WS-PAT  MOVE "abcx" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "^abc" TO WS-PAT  MOVE "xabc" TO WS-SUBJ  MOVE "0" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "abc$" TO WS-PAT  MOVE "xabc" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "abc$" TO WS-PAT  MOVE "abcx" TO WS-SUBJ  MOVE "0" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "a.c" TO WS-PAT  MOVE "abc" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "\.png$" TO WS-PAT  MOVE "block/stone.png" TO WS-SUBJ  MOVE "1" TO WS-EXPECT
     PERFORM CHECK-CASE
     MOVE "\.png$" TO WS-PAT  MOVE "block/stonexpng" TO WS-SUBJ  MOVE "0" TO WS-EXPECT
     PERFORM CHECK-CASE
     MOVE "\d+" TO WS-PAT  MOVE "abc123" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "\d" TO WS-PAT  MOVE "abc" TO WS-SUBJ  MOVE "0" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "\D" TO WS-PAT  MOVE "123" TO WS-SUBJ  MOVE "0" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "\D" TO WS-PAT  MOVE "12a" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "^\w+$" TO WS-PAT  MOVE "Stone_1" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "^\w+$" TO WS-PAT  MOVE "stone-1" TO WS-SUBJ  MOVE "0" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "\W" TO WS-PAT  MOVE "ab" TO WS-SUBJ  MOVE "0" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "\s" TO WS-PAT  MOVE "a b" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "[a-c]+x" TO WS-PAT  MOVE "zzbcax" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "^[^a-c]+$" TO WS-PAT  MOVE "xyz" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "^[^a-c]+$" TO WS-PAT  MOVE "xaz" TO WS-SUBJ  MOVE "0" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "[-a]" TO WS-PAT  MOVE "x-" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "[a-]" TO WS-PAT  MOVE "x-" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "[]a]" TO WS-PAT  MOVE "x]" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "[\d.]" TO WS-PAT  MOVE "x." TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "[\]]" TO WS-PAT  MOVE "x]" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "[\W]" TO WS-PAT  MOVE "ab/" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "[\W]" TO WS-PAT  MOVE "ab" TO WS-SUBJ  MOVE "0" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "[\x41-\x43]" TO WS-PAT  MOVE "xB" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "^(stone|dirt)$" TO WS-PAT  MOVE "dirt" TO WS-SUBJ  MOVE "1" TO WS-EXPECT
     PERFORM CHECK-CASE
     MOVE "^(stone|dirt)$" TO WS-PAT  MOVE "stones" TO WS-SUBJ  MOVE "0" TO WS-EXPECT
     PERFORM CHECK-CASE
     MOVE "^(?:ab)+$" TO WS-PAT  MOVE "ababab" TO WS-SUBJ  MOVE "1" TO WS-EXPECT
     PERFORM CHECK-CASE
     MOVE "^(?:ab)+$" TO WS-PAT  MOVE "ababa" TO WS-SUBJ  MOVE "0" TO WS-EXPECT
     PERFORM CHECK-CASE
     MOVE "colou?r" TO WS-PAT  MOVE "color" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "colou?r" TO WS-PAT  MOVE "colour" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "^a{3}$" TO WS-PAT  MOVE "aaa" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "^a{3}$" TO WS-PAT  MOVE "aaaa" TO WS-SUBJ  MOVE "0" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "^a{2,}$" TO WS-PAT  MOVE "a" TO WS-SUBJ  MOVE "0" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "^a{2,}$" TO WS-PAT  MOVE "aaaaa" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "^a{2,3}$" TO WS-PAT  MOVE "aaaa" TO WS-SUBJ  MOVE "0" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "^a{2,3}$" TO WS-PAT  MOVE "aaa" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "^a{0,1}b" TO WS-PAT  MOVE "b" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "^a*?b$" TO WS-PAT  MOVE "aab" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "^(a|ab)c$" TO WS-PAT  MOVE "abc" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "^(a+)+b$" TO WS-PAT  MOVE "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaac" TO WS-SUBJ
     MOVE "0" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "^(a*)*$" TO WS-PAT  MOVE "aaa" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "a|" TO WS-PAT  MOVE "b" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "x|y|z" TO WS-PAT  MOVE "aza" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "\/" TO WS-PAT  MOVE "a/b" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "\\" TO WS-PAT  MOVE "a\b" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "\x2F" TO WS-PAT  MOVE "a/b" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "a}]" TO WS-PAT  MOVE "a}]" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "\t\n\r\f\a\e" TO WS-PAT  MOVE "x" TO WS-SUBJ  MOVE "0" TO WS-EXPECT
     PERFORM CHECK-CASE
     MOVE "[\d-z]" TO WS-PAT  MOVE "y-" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "[\d-z]" TO WS-PAT  MOVE "y" TO WS-SUBJ  MOVE "0" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "[a&b]" TO WS-PAT  MOVE "&" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "()b" TO WS-PAT  MOVE "ab" TO WS-SUBJ  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE

*>   Line terminators: "." skips them, "$" also matches before a final one, \t is a tab.
     MOVE 1 TO WS-FIXED
     MOVE "a.c" TO WS-PAT  MOVE 3 TO WS-PAT-LENGTH
     STRING "a" WS-LF "c" DELIMITED BY SIZE INTO WS-SUBJ
     MOVE 3 TO WS-SUBJ-LENGTH  MOVE "0" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "a$" TO WS-PAT  MOVE 2 TO WS-PAT-LENGTH
     STRING "a" WS-LF DELIMITED BY SIZE INTO WS-SUBJ
     MOVE 2 TO WS-SUBJ-LENGTH  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "a$" TO WS-PAT  MOVE 2 TO WS-PAT-LENGTH
     STRING "a" WS-LF "b" DELIMITED BY SIZE INTO WS-SUBJ
     MOVE 3 TO WS-SUBJ-LENGTH  MOVE "0" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "a$" TO WS-PAT  MOVE 2 TO WS-PAT-LENGTH
     STRING "a" X"0D" WS-LF DELIMITED BY SIZE INTO WS-SUBJ
     MOVE 3 TO WS-SUBJ-LENGTH  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "a$" TO WS-PAT  MOVE 2 TO WS-PAT-LENGTH
     STRING "a" X"0D" DELIMITED BY SIZE INTO WS-SUBJ
     MOVE 2 TO WS-SUBJ-LENGTH  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "\t" TO WS-PAT  MOVE 2 TO WS-PAT-LENGTH
     STRING "a" WS-TAB DELIMITED BY SIZE INTO WS-SUBJ
     MOVE 2 TO WS-SUBJ-LENGTH  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "\S" TO WS-PAT  MOVE 2 TO WS-PAT-LENGTH
     MOVE SPACES TO WS-SUBJ  MOVE 3 TO WS-SUBJ-LENGTH  MOVE "0" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE "^$" TO WS-PAT  MOVE 2 TO WS-PAT-LENGTH
     MOVE 0 TO WS-SUBJ-LENGTH  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE SPACES TO WS-PAT  MOVE 0 TO WS-PAT-LENGTH
     MOVE "x" TO WS-SUBJ  MOVE 1 TO WS-SUBJ-LENGTH  MOVE "1" TO WS-EXPECT  PERFORM CHECK-CASE
*>   A counted repeat past the program size is "too complex", an error.
     MOVE ALL "a{99}" TO WS-PAT  MOVE 125 TO WS-PAT-LENGTH
     MOVE "a" TO WS-SUBJ  MOVE 1 TO WS-SUBJ-LENGTH  MOVE "E" TO WS-EXPECT  PERFORM CHECK-CASE
*>   A class-heavy pattern past the class table is an error too.
     MOVE ALL "[a]{9}" TO WS-PAT  MOVE 120 TO WS-PAT-LENGTH
     MOVE "a" TO WS-SUBJ  MOVE 1 TO WS-SUBJ-LENGTH  MOVE "E" TO WS-EXPECT  PERFORM CHECK-CASE
     MOVE 0 TO WS-FIXED

*>   Invalid or unsupported patterns.
     MOVE "x" TO WS-SUBJ  MOVE "E" TO WS-EXPECT
     MOVE "(abc" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "abc)" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "[abc" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "[\" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "[a-" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "*a" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "{2}" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "a**" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "a{2" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "a{2,3" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "a{,2}" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "a{3,2}" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "a{x}" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "a*+" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "\" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "\1" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "\b" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "\q" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "\p{L}" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "\x4" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "\xZZ" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "(?=a)" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "(?i)a" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "[a[b]]" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "[a&&b]" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "[z-a]" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "[a-[]" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "[a-\d]" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "[\q]" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "|*" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "(*)" TO WS-PAT  PERFORM CHECK-CASE
     MOVE "(a|b" TO WS-PAT  PERFORM CHECK-CASE
     STOP RUN.

 CHECK-CASE.
     IF WS-FIXED = 0
         MOVE 128 TO WS-PAT-LENGTH
         PERFORM UNTIL WS-PAT-LENGTH = 0 OR WS-PAT(WS-PAT-LENGTH:1) NOT = SPACE
             SUBTRACT 1 FROM WS-PAT-LENGTH
         END-PERFORM
         MOVE 256 TO WS-SUBJ-LENGTH
         PERFORM UNTIL WS-SUBJ-LENGTH = 0 OR WS-SUBJ(WS-SUBJ-LENGTH:1) NOT = SPACE
             SUBTRACT 1 FROM WS-SUBJ-LENGTH
         END-PERFORM
     END-IF
     MOVE 7 TO WS-MATCHED WS-ERROR
     CALL "REGEX-FIND" USING WS-PAT WS-PAT-LENGTH WS-SUBJ WS-SUBJ-LENGTH WS-MATCHED WS-ERROR
     MOVE SPACES TO TL-CASE
     IF WS-SUBJ-LENGTH = 0
         STRING "regex /" WS-PAT(1:FUNCTION MAX(WS-PAT-LENGTH, 1)) "/ on the empty subject"
             DELIMITED BY SIZE INTO TL-CASE
     ELSE
         STRING "regex /" WS-PAT(1:FUNCTION MAX(WS-PAT-LENGTH, 1)) "/ on " WS-SUBJ(1:WS-SUBJ-LENGTH)
             DELIMITED BY SIZE INTO TL-CASE
     END-IF
     INSPECT TL-CASE REPLACING ALL X"0A" BY "~" ALL X"0D" BY "~" ALL X"09" BY "~"
     MOVE "T" TO TL-MODE
     EVALUATE WS-EXPECT
         WHEN "1"
             MOVE "matched=1 error=0" TO TL-EXPECTED
         WHEN "0"
             MOVE "matched=0 error=0" TO TL-EXPECTED
         WHEN OTHER
             MOVE "matched=0 error=1" TO TL-EXPECTED
     END-EVALUATE
     MOVE SPACES TO TL-OBSERVED
     EVALUATE TRUE
         WHEN WS-MATCHED = 1 AND WS-ERROR = 0
             MOVE "matched=1 error=0" TO TL-OBSERVED
         WHEN WS-MATCHED = 0 AND WS-ERROR = 0
             MOVE "matched=0 error=0" TO TL-OBSERVED
         WHEN WS-MATCHED = 0 AND WS-ERROR = 1
             MOVE "matched=0 error=1" TO TL-OBSERVED
         WHEN OTHER
             MOVE "unexpected outputs" TO TL-OBSERVED
     END-EVALUATE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-REGEX.
