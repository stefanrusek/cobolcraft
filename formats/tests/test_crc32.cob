*> Implementation test of formats/src/crc32.cob (CRC32; 22 §7.2): the zip CRC-32 of a buffer, continued
*> from a running value (0 starts), over one buffer and over several, for an empty buffer (the running
*> value is returned unchanged), for bytes of 0xFF, and for a buffer longer than 65535 bytes.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-CRC32.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY FORMATS.
 01 WS-CRC                 BINARY-LONG UNSIGNED.
 01 WS-WHOLE               BINARY-LONG UNSIGNED.
 01 WS-LENGTH              BINARY-LONG.
 01 WS-TEXT                PIC X(64).
 01 WS-BIG                 PIC X(70000).
 01 WS-ZEROES              PIC X(32) VALUE LOW-VALUES.
 01 WS-FF                  PIC X(4).
 01 WS-HEX                 PIC X(1024).
 01 WS-HEX-LENGTH          BINARY-LONG.
 PROCEDURE DIVISION.
     MOVE "N" TO TL-MODE
     MOVE "123456789" TO WS-TEXT
     MOVE 0 TO WS-CRC
     MOVE 9 TO WS-LENGTH
     CALL "CRC32" USING WS-TEXT WS-LENGTH WS-CRC
     MOVE "crc32 of 123456789 is the check value cbf43926" TO TL-CASE
     MOVE FM-CRC-CHECK-VALUE TO TL-EXPECTED-N
     MOVE WS-CRC TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE 0 TO WS-CRC
     MOVE 5 TO WS-LENGTH
     CALL "CRC32" USING WS-TEXT WS-LENGTH WS-CRC
     MOVE "6789" TO WS-TEXT
     MOVE 4 TO WS-LENGTH
     CALL "CRC32" USING WS-TEXT WS-LENGTH WS-CRC
     MOVE "crc32 of 12345 then 6789 continues the running value" TO TL-CASE
     MOVE FM-CRC-CHECK-VALUE TO TL-EXPECTED-N
     MOVE WS-CRC TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE 0 TO WS-CRC
     MOVE 0 TO WS-LENGTH
     CALL "CRC32" USING WS-TEXT WS-LENGTH WS-CRC
     MOVE "crc32 of an empty buffer from 0 is 0" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-CRC TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE 305419896 TO WS-CRC
     CALL "CRC32" USING WS-TEXT WS-LENGTH WS-CRC
     MOVE "crc32 of an empty buffer leaves the running value 12345678 hex" TO TL-CASE
     MOVE 305419896 TO TL-EXPECTED-N
     MOVE WS-CRC TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "The quick brown fox jumps over the lazy dog" TO WS-TEXT
     MOVE 43 TO WS-LENGTH
     MOVE 0 TO WS-CRC
     CALL "CRC32" USING WS-TEXT WS-LENGTH WS-CRC
     MOVE "crc32 of the quick brown fox sentence is 414fa339" TO TL-CASE
     MOVE 1095738169 TO TL-EXPECTED-N
     MOVE WS-CRC TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE 32 TO WS-LENGTH
     MOVE 0 TO WS-CRC
     CALL "CRC32" USING WS-ZEROES WS-LENGTH WS-CRC
     MOVE "crc32 of 32 zero bytes is 190a55ad" TO TL-CASE
     MOVE 420107693 TO TL-EXPECTED-N
     MOVE WS-CRC TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE ALL X"FF" TO WS-FF
     MOVE 4 TO WS-LENGTH
     MOVE 0 TO WS-CRC
     CALL "CRC32" USING WS-FF WS-LENGTH WS-CRC
     MOVE "crc32 of four 0xFF bytes is ffffffff (an unsigned value above 2^31)" TO TL-CASE
     MOVE 4294967295 TO TL-EXPECTED-N
     MOVE WS-CRC TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE ALL "ab" TO WS-BIG
     MOVE 70000 TO WS-LENGTH
     MOVE 0 TO WS-WHOLE
     CALL "CRC32" USING WS-BIG WS-LENGTH WS-WHOLE
     MOVE 0 TO WS-CRC
     MOVE 65536 TO WS-LENGTH
     CALL "CRC32" USING WS-BIG WS-LENGTH WS-CRC
     MOVE 4464 TO WS-LENGTH
     CALL "CRC32" USING WS-BIG(65537:4464) WS-LENGTH WS-CRC
     MOVE "crc32 of 70000 bytes equals the crc of two pieces, 65536 and 4464" TO TL-CASE
     MOVE WS-WHOLE TO TL-EXPECTED-N
     MOVE WS-CRC TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "crc32 of 70000 bytes of ab is not 0 (the buffer was read)" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     IF WS-WHOLE = 0
         MOVE 0 TO TL-OBSERVED-N
     ELSE
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.
 END PROGRAM TEST-CRC32.
