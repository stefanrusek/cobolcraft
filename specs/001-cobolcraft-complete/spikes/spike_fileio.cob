       IDENTIFICATION DIVISION.
       PROGRAM-ID. SPIKE-FILEIO.
      * spike (throwaway): byte-stream random-access file I/O, directory
      * create/delete, and directory listing from pure GnuCOBOL.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-DIR      PIC X(64) VALUE "spike_fileio_tmp".
       01 WS-PATH     PIC X(64) VALUE "spike_fileio_tmp/r.0.0.mca".
       01 WS-HANDLE   PIC X(4).
       01 WS-ACCESS   PIC X COMP-X VALUE 3.
       01 WS-DENY     PIC X COMP-X VALUE 0.
       01 WS-DEV      PIC X COMP-X VALUE 0.
       01 WS-OFFSET   PIC X(8) COMP-X.
       01 WS-COUNT    PIC X(4) COMP-X.
       01 WS-FLAGS    BINARY-CHAR UNSIGNED VALUE 0.
       01 WS-BUF      PIC X(8).
       01 WS-RC       BINARY-LONG.
       01 WS-LISTH    USAGE POINTER.
       01 WS-NAME     PIC X(256).
       PROCEDURE DIVISION.
           CALL "CBL_CREATE_DIR" USING WS-DIR RETURNING WS-RC
           DISPLAY "CREATE-DIR RC=" WS-RC
           CALL "CBL_CREATE_FILE" USING WS-PATH WS-ACCESS WS-DENY
                WS-DEV WS-HANDLE RETURNING WS-RC
           DISPLAY "CREATE-FILE RC=" WS-RC
           MOVE 8192 TO WS-OFFSET
           MOVE 8 TO WS-COUNT
           MOVE X"0102030405060708" TO WS-BUF
           CALL "CBL_WRITE_FILE" USING WS-HANDLE WS-OFFSET WS-COUNT
                WS-FLAGS WS-BUF RETURNING WS-RC
           DISPLAY "WRITE@8192 RC=" WS-RC
           MOVE LOW-VALUES TO WS-BUF
           CALL "CBL_READ_FILE" USING WS-HANDLE WS-OFFSET WS-COUNT
                WS-FLAGS WS-BUF RETURNING WS-RC
           DISPLAY "READ@8192 RC=" WS-RC
           DISPLAY "  DATA=" FUNCTION HEX-OF(WS-BUF)
           MOVE 0 TO WS-OFFSET
           MOVE 8 TO WS-COUNT
           CALL "CBL_READ_FILE" USING WS-HANDLE WS-OFFSET WS-COUNT
                WS-FLAGS WS-BUF RETURNING WS-RC
           DISPLAY "READ@0 (hole) DATA=" FUNCTION HEX-OF(WS-BUF)
           MOVE 128 TO WS-FLAGS
           CALL "CBL_READ_FILE" USING WS-HANDLE WS-OFFSET WS-COUNT
                WS-FLAGS WS-BUF RETURNING WS-RC
           DISPLAY "FILE-SIZE=" WS-OFFSET
           CALL "CBL_CLOSE_FILE" USING WS-HANDLE
           CALL "C$LIST-DIRECTORY" USING 1 WS-DIR "*"
                RETURNING WS-LISTH
           ON EXCEPTION DISPLAY "C$LIST-DIRECTORY NOT AVAILABLE"
           END-CALL
           CALL "CBL_DELETE_FILE" USING WS-PATH RETURNING WS-RC
           DISPLAY "DELETE-FILE RC=" WS-RC
           CALL "CBL_DELETE_DIR" USING WS-DIR RETURNING WS-RC
           DISPLAY "DELETE-DIR RC=" WS-RC
           STOP RUN.
