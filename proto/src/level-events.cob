     END-PERFORM
     IF WS-ROW-INDEX > 22
         GOBACK
     END-IF
     MOVE 0 TO WS-POSITION
     MOVE 0 TO WS-BAD
     PERFORM VARYING WS-TOKEN-INDEX FROM 1 BY 1
             UNTIL WS-TOKEN-INDEX > 5 OR WS-BAD = 1
                 OR WS-ROW-TOKENS(WS-ROW-INDEX)(WS-TOKEN-INDEX:1) = SPACE
         MOVE WS-ROW-TOKENS(WS-ROW-INDEX)(WS-TOKEN-INDEX:1) TO WS-TOKEN
         EVALUATE WS-TOKEN
             WHEN "I"
             WHEN "F"
                 ADD 4 TO WS-POSITION
             WHEN "D"
                 ADD 8 TO WS-POSITION
             WHEN "V"
                 CALL "PB-PARTICLE-VARINT" USING L-DATA L-AVAILABLE WS-POSITION WS-VALUE
                 IF WS-VALUE < 0
