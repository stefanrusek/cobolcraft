         CALL "PB-PUT-IDENTIFIER" USING PB-BUFFER PB-LG-DIM-NAME(WS-I) PB-LG-DIM-LENGTH(WS-I)
     END-PERFORM
     CALL "PB-PUT-VARINT" USING PB-BUFFER PB-LG-MAX-PLAYERS
     CALL "PB-PUT-VARINT" USING PB-BUFFER PB-LG-VIEW-DISTANCE
     CALL "PB-PUT-VARINT" USING PB-BUFFER PB-LG-SIM-DISTANCE
     CALL "PB-PUT-BOOL" USING PB-BUFFER PB-LG-REDUCED-DEBUG
     CALL "PB-PUT-BOOL" USING PB-BUFFER PB-LG-DEATH-SCREEN
     CALL "PB-PUT-BOOL" USING PB-BUFFER PB-LG-LIMITED-CRAFT
     CALL "PB-PUT-SPAWN-INFO" USING PB-BUFFER PB-SPAWN-INFO
     CALL "PB-PUT-BOOL" USING PB-BUFFER PB-LG-ONLINE-MODE
     CALL "PB-PUT-BOOL" USING PB-BUFFER PB-LG-SECURE-CHAT
