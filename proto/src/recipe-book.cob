         END-IF
     END-PERFORM
     INITIALIZE TX-TEXT
     MOVE TX-TEXT-PLAIN TO TX-TX-KIND
     COMPUTE TX-TX-LENGTH = L-LENGTH - WS-FROM + 1
     IF TX-TX-LENGTH > 0
