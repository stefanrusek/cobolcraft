                 L-NODE
             MOVE PB-SDN-CHILD-B(L-NODE) TO LS-CHILD
             CALL "PB-PUT-SLOT-DISPLAY-NODE" USING PB-BUFFER PB-SLOT-DISPLAY-TABLE LS-CHILD
                 L-NODE
         WHEN PB-SDX-SMITHING-TRIM
             MOVE PB-SDN-CHILD-A(L-NODE) TO LS-CHILD
             CALL "PB-PUT-SLOT-DISPLAY-NODE" USING PB-BUFFER PB-SLOT-DISPLAY-TABLE LS-CHILD
                 L-NODE
             MOVE PB-SDN-CHILD-B(L-NODE) TO LS-CHILD
             CALL "PB-PUT-SLOT-DISPLAY-NODE" USING PB-BUFFER PB-SLOT-DISPLAY-TABLE LS-CHILD
                 L-NODE
             CALL "PB-PUT-SLOT-TRIM" USING PB-BUFFER PB-SDN-TRIM-ASSET(L-NODE)
                 PB-SDN-TRIM-LENGTH(L-NODE) PB-SDN-TRIM-DECAL(L-NODE)
         WHEN PB-SDX-WITH-REMAINDER
             MOVE PB-SDN-CHILD-A(L-NODE) TO LS-CHILD
             CALL "PB-PUT-SLOT-DISPLAY-NODE" USING PB-BUFFER PB-SLOT-DISPLAY-TABLE LS-CHILD
                 L-NODE
             MOVE PB-SDN-CHILD-B(L-NODE) TO LS-CHILD
