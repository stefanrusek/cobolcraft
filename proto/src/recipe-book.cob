 01 L-PARENT               BINARY-LONG.
 PROCEDURE DIVISION USING PB-BUFFER PB-SLOT-DISPLAY-TABLE L-NODE L-PARENT.
     IF PB-ERROR = 1
         GOBACK
     END-IF
     IF L-NODE <= L-PARENT OR L-NODE > PB-SDT-COUNT
         MOVE 1 TO PB-ERROR
         GOBACK
     END-IF
     CALL "PB-PUT-VARINT" USING PB-BUFFER PB-SDN-TYPE(L-NODE)
     EVALUATE PB-SDN-TYPE(L-NODE)
         WHEN PB-SDX-EMPTY
             CONTINUE
         WHEN PB-SDX-ANY-FUEL
             CONTINUE
         WHEN PB-SDX-WITH-ANY-POTION
             MOVE PB-SDN-CHILD-A(L-NODE) TO LS-CHILD
             CALL "PB-PUT-SLOT-DISPLAY-NODE" USING PB-BUFFER PB-SLOT-DISPLAY-TABLE LS-CHILD
