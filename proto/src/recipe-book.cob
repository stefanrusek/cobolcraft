         WHEN PB-SDX-WITH-REMAINDER
             CALL "PB-GET-SLOT-DISPLAY-NODE" USING PB-BUFFER PB-SLOT-DISPLAY-TABLE LS-CHILD
             MOVE LS-CHILD TO PB-SDN-CHILD-A(LS-NODE)
             CALL "PB-GET-SLOT-DISPLAY-NODE" USING PB-BUFFER PB-SLOT-DISPLAY-TABLE LS-CHILD
             MOVE LS-CHILD TO PB-SDN-CHILD-B(LS-NODE)
         WHEN PB-SDX-COMPOSITE
             CALL "PB-GET-VARINT" USING PB-BUFFER PB-SDN-LIST-COUNT(LS-NODE)
             IF PB-SDN-LIST-COUNT(LS-NODE) < 0 OR PB-SDN-LIST-COUNT(LS-NODE) > 8
                 MOVE 1 TO PB-ERROR
                 MOVE 0 TO PB-SDN-LIST-COUNT(LS-NODE)
             END-IF
             PERFORM VARYING LS-I FROM 1 BY 1
                     UNTIL LS-I > PB-SDN-LIST-COUNT(LS-NODE) OR PB-ERROR = 1
                 CALL "PB-GET-SLOT-DISPLAY-NODE" USING PB-BUFFER PB-SLOT-DISPLAY-TABLE LS-CHILD
                 MOVE LS-CHILD TO PB-SDN-LIST(LS-NODE, LS-I)
             END-PERFORM
         WHEN OTHER
             MOVE 1 TO PB-ERROR
     END-EVALUATE
     GOBACK.
 END PROGRAM PB-GET-SLOT-DISPLAY-NODE.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. PB-PUT-RECIPE-ENTRY.
*> USING PB-BUFFER, PB-RECIPE-ENTRY, PB-SLOT-DISPLAY-TABLE: a RecipeBookAddEntry (05b): the
*> RecipeDisplayEntry (VarInt display id; RecipeDisplay: VarInt type, then the type's slots as
*> PROTO.cpy lists them; OptionalVarInt group; RegistryId category; Optional crafting
*> requirements, each a HolderSet<item> of one item) and the flags Byte. shapeless and shaped write
*> PB-RE-INGREDIENT-COUNT (0 to 9) slots, shaped after width and height; furnace (2 slots, then
*> duration and experience), stonecutter (1) and smithing (3) ignore the count. A type outside 0 to
*> 4, a negative id, group, category, width, height or duration, flags outside 0 to 255, a
*> requirement count outside 0 to 9, a negative requirement item or a slot PB-PUT-SLOT-DISPLAY-NODE
*> rejects appends nothing and sets PB-ERROR.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-START               BINARY-LONG.
 01 WS-COUNT               BINARY-LONG.
 01 WS-FLAG                BINARY-LONG.
 01 WS-SELECTOR            BINARY-LONG VALUE 2.
 01 WS-NO-PARENT           BINARY-LONG VALUE 0.
 01 WS-I                   BINARY-LONG.
 LINKAGE SECTION.
 COPY PROTO.
 PROCEDURE DIVISION USING PB-BUFFER PB-RECIPE-ENTRY PB-SLOT-DISPLAY-TABLE.
     MOVE PB-LENGTH TO WS-START
     MOVE 0 TO WS-COUNT
     EVALUATE PB-RE-TYPE
         WHEN PB-RT-SHAPELESS
             MOVE PB-RE-INGREDIENT-COUNT TO WS-COUNT
         WHEN PB-RT-SHAPED
             MOVE PB-RE-INGREDIENT-COUNT TO WS-COUNT
         WHEN PB-RT-FURNACE
             MOVE 2 TO WS-COUNT
         WHEN PB-RT-STONECUTTER
             MOVE 1 TO WS-COUNT
         WHEN PB-RT-SMITHING
             MOVE 3 TO WS-COUNT
         WHEN OTHER
             MOVE 1 TO PB-ERROR
     END-EVALUATE
     IF PB-ERROR = 1 OR WS-COUNT < 0 OR WS-COUNT > PB-RECIPE-MAX-SLOTS
             OR PB-RE-DISPLAY-ID < 0 OR PB-RE-GROUP < 0 OR PB-RE-CATEGORY < 0
             OR PB-RE-WIDTH < 0 OR PB-RE-HEIGHT < 0 OR PB-RE-DURATION < 0
             OR PB-RE-FLAGS < 0 OR PB-RE-FLAGS > 255
         MOVE 1 TO PB-ERROR
         GOBACK
     END-IF
     IF PB-RE-REQ-PRESENT = 1
         IF PB-RE-REQ-COUNT < 0 OR PB-RE-REQ-COUNT > PB-RECIPE-MAX-SLOTS
             MOVE 1 TO PB-ERROR
             GOBACK
         END-IF
         PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > PB-RE-REQ-COUNT
             IF PB-RE-REQ-ITEM(WS-I) < 0
                 MOVE 1 TO PB-ERROR
                 GOBACK
             END-IF
         END-PERFORM
     END-IF
     CALL "PB-PUT-VARINT" USING PB-BUFFER PB-RE-DISPLAY-ID
     CALL "PB-PUT-VARINT" USING PB-BUFFER PB-RE-TYPE
     IF PB-RE-TYPE = PB-RT-SHAPED
         CALL "PB-PUT-VARINT" USING PB-BUFFER PB-RE-WIDTH
         CALL "PB-PUT-VARINT" USING PB-BUFFER PB-RE-HEIGHT
     END-IF
     IF PB-RE-TYPE = PB-RT-SHAPELESS OR PB-RE-TYPE = PB-RT-SHAPED
         CALL "PB-PUT-VARINT" USING PB-BUFFER WS-COUNT
     END-IF
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-COUNT
         CALL "PB-PUT-SLOT-DISPLAY-NODE" USING PB-BUFFER PB-SLOT-DISPLAY-TABLE
             PB-RE-INGREDIENT(WS-I) WS-NO-PARENT
     END-PERFORM
     CALL "PB-PUT-SLOT-DISPLAY-NODE" USING PB-BUFFER PB-SLOT-DISPLAY-TABLE PB-RE-RESULT
         WS-NO-PARENT
     CALL "PB-PUT-SLOT-DISPLAY-NODE" USING PB-BUFFER PB-SLOT-DISPLAY-TABLE PB-RE-STATION
         WS-NO-PARENT
     IF PB-RE-TYPE = PB-RT-FURNACE
         CALL "PB-PUT-VARINT" USING PB-BUFFER PB-RE-DURATION
         CALL "PB-PUT-FLOAT" USING PB-BUFFER PB-RE-EXPERIENCE
     END-IF
     CALL "PB-PUT-VARINT" USING PB-BUFFER PB-RE-GROUP
     CALL "PB-PUT-VARINT" USING PB-BUFFER PB-RE-CATEGORY
     MOVE PB-RE-REQ-PRESENT TO WS-FLAG
     CALL "PB-PUT-BOOL" USING PB-BUFFER WS-FLAG
     IF PB-RE-REQ-PRESENT = 1
         CALL "PB-PUT-VARINT" USING PB-BUFFER PB-RE-REQ-COUNT
         PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > PB-RE-REQ-COUNT
             CALL "PB-PUT-VARINT" USING PB-BUFFER WS-SELECTOR
             CALL "PB-PUT-VARINT" USING PB-BUFFER PB-RE-REQ-ITEM(WS-I)
         END-PERFORM
     END-IF
     CALL "PB-PUT-UBYTE" USING PB-BUFFER PB-RE-FLAGS
     IF PB-ERROR = 1
         MOVE WS-START TO PB-LENGTH
     END-IF
     GOBACK.
 END PROGRAM PB-PUT-RECIPE-ENTRY.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. PB-GET-RECIPE-ENTRY.
*> USING PB-BUFFER, PB-RECIPE-ENTRY out, PB-SLOT-DISPLAY-TABLE out: one RecipeBookAddEntry (layout of
*> PB-PUT-RECIPE-ENTRY); slots are numbered in the order read. A type outside 0 to 4, an ingredient
*> or requirement count outside 0 to 9, a requirement that is not a HolderSet of exactly one item,
*> a slot PB-GET-SLOT-DISPLAY-NODE rejects or a short read sets PB-ERROR, leaves PB-POS where it was
*> and yields an all-zero entry and an empty table.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-START               BINARY-LONG.
 01 WS-NODE                BINARY-LONG.
 01 WS-FLAG                BINARY-LONG.
 01 WS-SELECTOR            BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 LINKAGE SECTION.
 COPY PROTO.
 PROCEDURE DIVISION USING PB-BUFFER PB-RECIPE-ENTRY PB-SLOT-DISPLAY-TABLE.
     MOVE PB-POS TO WS-START
     INITIALIZE PB-RECIPE-ENTRY PB-SLOT-DISPLAY-TABLE
     CALL "PB-GET-VARINT" USING PB-BUFFER PB-RE-DISPLAY-ID
     CALL "PB-GET-VARINT" USING PB-BUFFER PB-RE-TYPE
     EVALUATE PB-RE-TYPE
         WHEN PB-RT-SHAPELESS
             CALL "PB-GET-VARINT" USING PB-BUFFER PB-RE-INGREDIENT-COUNT
         WHEN PB-RT-SHAPED
             CALL "PB-GET-VARINT" USING PB-BUFFER PB-RE-WIDTH
             CALL "PB-GET-VARINT" USING PB-BUFFER PB-RE-HEIGHT
             CALL "PB-GET-VARINT" USING PB-BUFFER PB-RE-INGREDIENT-COUNT
         WHEN PB-RT-FURNACE
             MOVE 2 TO PB-RE-INGREDIENT-COUNT
         WHEN PB-RT-STONECUTTER
             MOVE 1 TO PB-RE-INGREDIENT-COUNT
         WHEN PB-RT-SMITHING
             MOVE 3 TO PB-RE-INGREDIENT-COUNT
         WHEN OTHER
             MOVE 1 TO PB-ERROR
     END-EVALUATE
     IF PB-RE-INGREDIENT-COUNT < 0 OR PB-RE-INGREDIENT-COUNT > PB-RECIPE-MAX-SLOTS
         MOVE 1 TO PB-ERROR
         MOVE 0 TO PB-RE-INGREDIENT-COUNT
     END-IF
     PERFORM VARYING WS-I FROM 1 BY 1
             UNTIL WS-I > PB-RE-INGREDIENT-COUNT OR PB-ERROR = 1
         CALL "PB-GET-SLOT-DISPLAY-NODE" USING PB-BUFFER PB-SLOT-DISPLAY-TABLE WS-NODE
         MOVE WS-NODE TO PB-RE-INGREDIENT(WS-I)
     END-PERFORM
     CALL "PB-GET-SLOT-DISPLAY-NODE" USING PB-BUFFER PB-SLOT-DISPLAY-TABLE WS-NODE
     MOVE WS-NODE TO PB-RE-RESULT
     CALL "PB-GET-SLOT-DISPLAY-NODE" USING PB-BUFFER PB-SLOT-DISPLAY-TABLE WS-NODE
     MOVE WS-NODE TO PB-RE-STATION
     IF PB-RE-TYPE = PB-RT-FURNACE
         CALL "PB-GET-VARINT" USING PB-BUFFER PB-RE-DURATION
         CALL "PB-GET-FLOAT" USING PB-BUFFER PB-RE-EXPERIENCE
     END-IF
     CALL "PB-GET-VARINT" USING PB-BUFFER PB-RE-GROUP
     CALL "PB-GET-VARINT" USING PB-BUFFER PB-RE-CATEGORY
     CALL "PB-GET-BOOL" USING PB-BUFFER WS-FLAG
     MOVE WS-FLAG TO PB-RE-REQ-PRESENT
     IF WS-FLAG = 1
         CALL "PB-GET-VARINT" USING PB-BUFFER PB-RE-REQ-COUNT
         IF PB-RE-REQ-COUNT < 0 OR PB-RE-REQ-COUNT > PB-RECIPE-MAX-SLOTS
             MOVE 1 TO PB-ERROR
             MOVE 0 TO PB-RE-REQ-COUNT
         END-IF
         PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > PB-RE-REQ-COUNT
             CALL "PB-GET-VARINT" USING PB-BUFFER WS-SELECTOR
             CALL "PB-GET-VARINT" USING PB-BUFFER PB-RE-REQ-ITEM(WS-I)
             IF WS-SELECTOR NOT = 2
                 MOVE 1 TO PB-ERROR
             END-IF
         END-PERFORM
     END-IF
     CALL "PB-GET-UBYTE" USING PB-BUFFER PB-RE-FLAGS
     IF PB-ERROR = 1
         MOVE WS-START TO PB-POS
         INITIALIZE PB-RECIPE-ENTRY PB-SLOT-DISPLAY-TABLE
     END-IF
     GOBACK.
 END PROGRAM PB-GET-RECIPE-ENTRY.
