             CALL "PB-PUT-VARINT" USING PB-BUFFER PB-SDN-COUNT(L-NODE)
             CALL "PB-PUT-VARINT" USING PB-BUFFER LS-ZERO
             CALL "PB-PUT-VARINT" USING PB-BUFFER LS-ZERO
         WHEN PB-SDX-TAG
             CALL "PB-PUT-SLOT-TAG" USING PB-BUFFER PB-SDN-TAG(L-NODE) PB-SDN-TAG-LENGTH(L-NODE)
         WHEN PB-SDX-DYED
