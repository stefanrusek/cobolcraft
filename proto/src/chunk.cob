*> CHUNK-CONTAINER-ENCODE). The bits byte selects the kind (06 §5.3). A palette larger than
*> 2 ** bits or a data entry indexing past the palette: PB-ERROR.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-I                   BINARY-LONG.
 01 WS-J                   BINARY-LONG.
 01 WS-WIRE-BITS           BINARY-LONG.
 01 WS-DATA-BITS           BINARY-LONG.
 01 WS-INDIRECT            BINARY-LONG.
 01 WS-SIZE                BINARY-LONG.
 01 WS-VALUE               BINARY-LONG.
 01 WS-LIMIT               BINARY-LONG.
 01 WS-MINIMUM             BINARY-LONG.
 01 WS-PER-LONG            BINARY-LONG.
 01 WS-LONGS               BINARY-LONG.
 01 WS-DIVISOR             PIC 9(20).
 01 WS-PALETTE-TABLE.
    05 WS-PALETTE          BINARY-LONG OCCURS 256 TIMES.
 01 WS-WORD                PIC X(8).
 01 WS-SIGNED REDEFINES WS-WORD BINARY-DOUBLE SIGNED.
 01 WS-UNSIGNED REDEFINES WS-WORD BINARY-DOUBLE UNSIGNED.
 01 B-VALUES BASED.
    05 B-VALUE             BINARY-LONG OCCURS 4096 TIMES.
 LINKAGE SECTION.
 COPY PROTO.
 01 L-VALUES               PIC X.
 01 L-COUNT                BINARY-LONG.
 01 L-STRATEGY             BINARY-LONG.
 01 L-GLOBAL-BITS          BINARY-LONG.
 PROCEDURE DIVISION USING PB-BUFFER L-VALUES L-COUNT L-STRATEGY L-GLOBAL-BITS.
     SET ADDRESS OF B-VALUES TO ADDRESS OF L-VALUES
     COMPUTE WS-LIMIT = 8 - 5 * L-STRATEGY
     COMPUTE WS-MINIMUM = 4 - 3 * L-STRATEGY
     MOVE 0 TO WS-DATA-BITS WS-INDIRECT WS-SIZE
     CALL "PB-GET-UBYTE" USING PB-BUFFER WS-WIRE-BITS
     EVALUATE TRUE
         WHEN WS-WIRE-BITS = 0
             CALL "PB-GET-VARINT" USING PB-BUFFER WS-VALUE
             PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > L-COUNT
                 MOVE WS-VALUE TO B-VALUE(WS-I)
             END-PERFORM
         WHEN WS-WIRE-BITS <= WS-LIMIT
             MOVE 1 TO WS-INDIRECT
             COMPUTE WS-DATA-BITS = FUNCTION MAX(WS-WIRE-BITS, WS-MINIMUM)
             CALL "PB-GET-VARINT" USING PB-BUFFER WS-SIZE
             IF WS-SIZE < 0 OR WS-SIZE > 2 ** WS-DATA-BITS
                 MOVE 1 TO PB-ERROR
                 MOVE 0 TO WS-SIZE
             END-IF
             PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-SIZE
                 CALL "PB-GET-VARINT" USING PB-BUFFER WS-PALETTE(WS-J)
             END-PERFORM
         WHEN OTHER
             MOVE L-GLOBAL-BITS TO WS-DATA-BITS
     END-EVALUATE
     IF WS-DATA-BITS > 0
         COMPUTE WS-DIVISOR = 2 ** WS-DATA-BITS
         COMPUTE WS-PER-LONG = 64 / WS-DATA-BITS
         COMPUTE WS-LONGS = (L-COUNT + WS-PER-LONG - 1) / WS-PER-LONG
         MOVE 1 TO WS-I
         PERFORM WS-LONGS TIMES
             CALL "PB-GET-LONG" USING PB-BUFFER WS-SIGNED
             PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-PER-LONG OR WS-I > L-COUNT
                 DIVIDE WS-UNSIGNED BY WS-DIVISOR GIVING WS-UNSIGNED REMAINDER B-VALUE(WS-I)
                 ADD 1 TO WS-I
             END-PERFORM
         END-PERFORM
     END-IF
     IF WS-INDIRECT = 1
         PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > L-COUNT
             IF B-VALUE(WS-I) >= WS-SIZE
                 MOVE 1 TO PB-ERROR
                 MOVE 0 TO B-VALUE(WS-I)
             ELSE
                 MOVE WS-PALETTE(B-VALUE(WS-I) + 1) TO B-VALUE(WS-I)
             END-IF
         END-PERFORM
     END-IF
     GOBACK.
 END PROGRAM CHUNK-CONTAINER-DECODE.

