                 COMPUTE WS-SEQUENCE-BYTE(2) = 160 + WS-HIGH / 64
                 COMPUTE WS-SEQUENCE-BYTE(3) = 128 + FUNCTION MOD(WS-HIGH, 64)
                 COMPUTE WS-SEQUENCE-BYTE(5) = 176 + WS-LOW / 64
