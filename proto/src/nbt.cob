                     WHEN WS-ENTRY-TYPE = 0
                         CONTINUE
                     WHEN WS-NAME-LENGTH = WS-SEGMENT-LENGTH AND (WS-SEGMENT-LENGTH = 0
                             OR WS-NAME(1:WS-SEGMENT-LENGTH)
