             ADD 1 TO WS-OUT-LENGTH
             MOVE FUNCTION CHAR(WS-SEQUENCE-BYTE(WS-K) + 1) TO WS-OUT(WS-OUT-LENGTH:1)
         END-PERFORM
     END-PERFORM
     IF WS-OUT-LENGTH > 65535
         MOVE 1 TO PB-ERROR
