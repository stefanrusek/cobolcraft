                     + (FUNCTION ORD(B-TEXT(WS-I + 1:1)) - 129) * 4096
                     + (FUNCTION ORD(B-TEXT(WS-I + 2:1)) - 129) * 64
                     + FUNCTION ORD(B-TEXT(WS-I + 3:1)) - 129 - 65536
