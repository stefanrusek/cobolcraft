     END-IF
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > PB-PCH-SEEN-COUNT
         CALL "PB-GET-VARINT" USING PB-BUFFER PB-PCH-SEEN-REF(WS-I)
         COMPUTE WS-MIN-REF = FUNCTION MIN(WS-MIN-REF, PB-PCH-SEEN-REF(WS-I))
         IF PB-PCH-SEEN-REF(WS-I) = 0
             CALL "PB-GET-BYTES" USING PB-BUFFER PB-PCH-SEEN-SIGNATURE(WS-I)
                 WS-SIGNATURE-LENGTH
         END-IF
     END-PERFORM
     CALL "PB-GET-BOOL" USING PB-BUFFER WS-FLAG
     MOVE -1 TO PB-PCH-UNSIGNED-KIND
     IF WS-FLAG = 1
         CALL "PB-GET-CHAT-TEXT" USING PB-BUFFER PB-PCH-UNSIGNED-KIND PB-PCH-UNSIGNED-LENGTH
             PB-PCH-UNSIGNED WS-TEXT-CAPACITY
     END-IF
     CALL "PB-GET-VARINT" USING PB-BUFFER PB-PCH-FILTER-KIND
     IF PB-PCH-FILTER-KIND < 0 OR PB-PCH-FILTER-KIND > 2
         MOVE 1 TO PB-ERROR
         MOVE 0 TO PB-PCH-FILTER-KIND
     END-IF
     IF PB-PCH-FILTER-KIND = 2
         CALL "PB-GET-VARINT" USING PB-BUFFER PB-PCH-FILTER-LENGTH
         IF PB-PCH-FILTER-LENGTH < 0 OR PB-PCH-FILTER-LENGTH > PB-PCH-FILTER-MAX
             MOVE 1 TO PB-ERROR
             MOVE 0 TO PB-PCH-FILTER-LENGTH
         END-IF
         CALL "PB-GET-BYTES" USING PB-BUFFER PB-PCH-FILTER-MASK PB-PCH-FILTER-LENGTH
     END-IF
     CALL "PB-GET-CHAT-BOUND" USING PB-BUFFER PB-CHAT-BOUND
     IF PB-PCH-GLOBAL-INDEX < 0 OR PB-PCH-INDEX < 0 OR WS-MIN-REF < 0
         MOVE 1 TO PB-ERROR
     END-IF
     IF PB-ERROR = 1
         MOVE WS-START TO PB-POS
         INITIALIZE PB-PLAYER-CHAT PB-CHAT-BOUND
     END-IF
     GOBACK.
 END PROGRAM PB-GET-PLAYER-CHAT.

*> The component helpers come last: each takes a one-byte area, and under -Wall a call within one file
*> is size-checked against programs defined earlier only.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. PB-PUT-CHAT-TEXT.
*> USING PB-BUFFER, kind (BINARY-LONG: PB-TEXT-PLAIN, -LITERAL or -TRANSLATE), text (any area), byte
*> length (BINARY-LONG): a TextComponent as network NBT in the fixed form of PB-PUT-TEXT, without
*> translation arguments. The caller has checked the values (PB-CHAT-TEXT-OK).
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-ROOT                BINARY-LONG VALUE -2.
 01 WS-NO-NAME             PIC X VALUE SPACE.
 01 WS-NAME-LENGTH         BINARY-LONG.
 LINKAGE SECTION.
 COPY PROTO.
 01 L-KIND                 BINARY-LONG.
 01 L-TEXT                 PIC X.
 01 L-LENGTH               BINARY-LONG.
 PROCEDURE DIVISION USING PB-BUFFER L-KIND L-TEXT L-LENGTH.
     IF L-KIND = PB-TEXT-PLAIN
         CALL "NBT-WRITE-STRING" USING PB-BUFFER WS-NO-NAME WS-ROOT L-TEXT L-LENGTH
     ELSE
         CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WS-NO-NAME WS-ROOT
         IF L-KIND = PB-TEXT-LITERAL
             MOVE 4 TO WS-NAME-LENGTH
             CALL "NBT-WRITE-STRING" USING PB-BUFFER "text" WS-NAME-LENGTH L-TEXT L-LENGTH
         ELSE
             MOVE 9 TO WS-NAME-LENGTH
             CALL "NBT-WRITE-STRING" USING PB-BUFFER "translate" WS-NAME-LENGTH L-TEXT L-LENGTH
         END-IF
         CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     END-IF
     GOBACK.
 END PROGRAM PB-PUT-CHAT-TEXT.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. PB-GET-CHAT-TEXT.
*> USING PB-BUFFER, kind out (BINARY-LONG), length out (BINARY-LONG), text out (any area), capacity
*> (BINARY-LONG bytes): a TextComponent read with PB-GET-TEXT. Translation arguments, a text over the
*> capacity or an invalid component are an error (PB-POS is then the caller's to restore).
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY PROTO REPLACING LEADING ==PB-== BY ==WK-==.
 01 B-DST                  PIC X(1073741824) BASED.
 LINKAGE SECTION.
 COPY PROTO.
 01 L-KIND                 BINARY-LONG.
 01 L-LENGTH               BINARY-LONG.
 01 L-TEXT                 PIC X.
 01 L-CAPACITY             BINARY-LONG.
 PROCEDURE DIVISION USING PB-BUFFER L-KIND L-LENGTH L-TEXT L-CAPACITY.
     MOVE 0 TO L-LENGTH
     CALL "PB-GET-TEXT" USING PB-BUFFER WK-TEXT
     IF PB-ERROR = 1 OR WK-TX-ARG-COUNT > 0 OR WK-TX-LENGTH > L-CAPACITY
         MOVE 1 TO PB-ERROR
         GOBACK
     END-IF
     MOVE WK-TX-KIND TO L-KIND
     MOVE WK-TX-LENGTH TO L-LENGTH
     IF L-LENGTH > 0
         SET ADDRESS OF B-DST TO ADDRESS OF L-TEXT
         MOVE WK-TX-VALUE(1:L-LENGTH) TO B-DST(1:L-LENGTH)
     END-IF
     GOBACK.
 END PROGRAM PB-GET-CHAT-TEXT.
