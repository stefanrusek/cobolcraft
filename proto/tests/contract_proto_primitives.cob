     PERFORM DECODE-LIGHT-ERROR
     MOVE "01 01 00 01 01 00 01 8010" TO WS-HEX
     MOVE "contract proto LIGHT-DECODE bit in both sky mask and empty sky mask sets PB-ERROR"
         TO TL-CASE
     PERFORM DECODE-LIGHT-ERROR
     MOVE "01 01 00 00 00 00 00" TO WS-HEX
     MOVE "contract proto LIGHT-DECODE array count not matching the mask sets PB-ERROR" TO TL-CASE
     PERFORM DECODE-LIGHT-ERROR
     MOVE "01 01 00 00 00 01 05 0000000000 00" TO WS-HEX
     MOVE "contract proto LIGHT-DECODE array of 5 bytes sets PB-ERROR" TO TL-CASE
     PERFORM DECODE-LIGHT-ERROR
     MOVE "21" TO WS-HEX
     MOVE "contract proto LIGHT-DECODE mask of 33 bytes sets PB-ERROR" TO TL-CASE
     PERFORM DECODE-LIGHT-ERROR.

 DECODE-LIGHT-ERROR.
     PERFORM FILL
     CALL "LIGHT-DECODE" USING PB-BUFFER WS-LIGHT-COUNT WS-SKY-STATES WS-SKY-ARRAYS
         WS-BLOCK-STATES WS-BLOCK-ARRAYS
     PERFORM CHECK-ERROR.

*> ---- 07 §5.1 gzip NBT files ------------------------------------------------------------------
 NBT-FILE-CASES.
     CALL "PB-RESET" USING PB-BUFFER
     MOVE 0 TO WS-NAME-LENGTH
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WS-NO-NAME WS-NAME-LENGTH
     MOVE 1 TO WS-NAME-LENGTH
     MOVE 5 TO WS-INT
     CALL "NBT-WRITE-INT" USING PB-BUFFER "n" WS-NAME-LENGTH WS-INT
     MOVE "x" TO WS-TEXT
     MOVE 1 TO WS-LEN
     CALL "NBT-WRITE-STRING" USING PB-BUFFER "s" WS-NAME-LENGTH WS-TEXT WS-LEN
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE "build/test-proto-nbtfile.dat" TO WS-FILE-PATH
     MOVE 28 TO WS-FILE-PATH-LENGTH
     CALL "NBT-FILE-WRITE" USING WS-FILE-PATH WS-FILE-PATH-LENGTH PB-BUFFER WS-OUTCOME
     MOVE WS-OUTCOME TO WS-INT
     CALL "PB-RESET" USING PK-BUFFER
     CALL "NBT-FILE-READ" USING WS-FILE-PATH WS-FILE-PATH-LENGTH PK-BUFFER WS-OUTCOME
     MOVE 0 TO WS-OFFSET
     CALL "TEST-SLICE-EQUALS" USING PK-BUFFER WS-OFFSET PB-BUFFER WS-EQUAL
     MOVE "contract proto NBT-FILE-WRITE then NBT-FILE-READ reads back the same named root"
         TO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE "0 0 1 0 0" TO TL-EXPECTED
     PERFORM START-TEXT
     MOVE WS-INT TO WS-NUM
     PERFORM ADD-NUMBER
     MOVE WS-OUTCOME TO WS-NUM
     PERFORM ADD-NUMBER
     MOVE WS-EQUAL TO WS-NUM
     PERFORM ADD-NUMBER
     COMPUTE WS-NUM = PK-LENGTH - PB-LENGTH
     PERFORM ADD-NUMBER
     MOVE PK-POS TO WS-NUM
     PERFORM ADD-NUMBER
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "contract proto NBT-FILE-WRITE writes a gzip member (magic 1f8b)" TO TL-CASE
     PERFORM READ-RAW-MAGIC
     MOVE "build/test-proto-missing.dat" TO WS-FILE-PATH
     CALL "CBL_DELETE_FILE" USING WS-FILE-PATH
     MOVE "contract proto NBT-FILE-READ of a missing file is outcome 1" TO TL-CASE
     PERFORM READ-EXPECT-FAILURE
     MOVE "build/no-such-directory/x.dat" TO WS-FILE-PATH
     MOVE 29 TO WS-FILE-PATH-LENGTH
     CALL "NBT-FILE-WRITE" USING WS-FILE-PATH WS-FILE-PATH-LENGTH PB-BUFFER WS-OUTCOME
     MOVE "contract proto NBT-FILE-WRITE into a missing directory is outcome 1" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE WS-OUTCOME TO TL-OBSERVED-N
     PERFORM CHECK-NUMBER
     MOVE "build/test-proto-nbtfile.dat" TO WS-FILE-PATH
     MOVE 28 TO WS-FILE-PATH-LENGTH
     MOVE "1f8b0800" TO WS-HEX
     PERFORM WRITE-RAW
     MOVE "contract proto NBT-FILE-READ of a 4-byte file is outcome 1" TO TL-CASE
     PERFORM READ-EXPECT-FAILURE
     MOVE "1f8b0800000000000003 ffffffffffffffffffff 0000000005000000" TO WS-HEX
     PERFORM WRITE-RAW
     MOVE "contract proto NBT-FILE-READ of corrupt gzip data is outcome 1" TO TL-CASE
     PERFORM READ-EXPECT-FAILURE
     MOVE "08 0000 0001 41" TO WS-HEX
     PERFORM FILL
     CALL "NBT-FILE-WRITE" USING WS-FILE-PATH WS-FILE-PATH-LENGTH PB-BUFFER WS-OUTCOME
     MOVE "contract proto NBT-FILE-READ of a String root (not a named compound) is outcome 1"
         TO TL-CASE
     PERFORM READ-EXPECT-FAILURE
     CALL "CBL_DELETE_FILE" USING WS-FILE-PATH.

 READ-EXPECT-FAILURE.
     CALL "NBT-FILE-READ" USING WS-FILE-PATH WS-FILE-PATH-LENGTH PK-BUFFER WS-OUTCOME
     MOVE 1 TO TL-EXPECTED-N
     MOVE WS-OUTCOME TO TL-OBSERVED-N
     PERFORM CHECK-NUMBER.

*> Writes the bytes of WS-HEX to WS-FILE-PATH as they are.
 WRITE-RAW.
     PERFORM FILL
     MOVE SPACES TO WS-RAW-NAME
     MOVE WS-FILE-PATH TO WS-RAW-NAME
     MOVE 2 TO WS-RAW-ACCESS
     CALL "CBL_CREATE_FILE" USING WS-RAW-NAME WS-RAW-ACCESS WS-RAW-DENY WS-RAW-DEVICE
         WS-RAW-HANDLE
     MOVE 0 TO WS-RAW-OFFSET
     MOVE PB-LENGTH TO WS-RAW-COUNT
     SET ADDRESS OF B-RAW TO PB-ADDR
     CALL "CBL_WRITE_FILE" USING WS-RAW-HANDLE WS-RAW-OFFSET WS-RAW-COUNT WS-RAW-FLAGS B-RAW
     CALL "CBL_CLOSE_FILE" USING WS-RAW-HANDLE.

 READ-RAW-MAGIC.
     MOVE SPACES TO WS-RAW-NAME
     MOVE WS-FILE-PATH TO WS-RAW-NAME
     MOVE 1 TO WS-RAW-ACCESS
     CALL "CBL_OPEN_FILE" USING WS-RAW-NAME WS-RAW-ACCESS WS-RAW-DENY WS-RAW-DEVICE
         WS-RAW-HANDLE
     MOVE 0 TO WS-RAW-OFFSET
     MOVE 2 TO WS-RAW-COUNT
     CALL "CBL_READ_FILE" USING WS-RAW-HANDLE WS-RAW-OFFSET WS-RAW-COUNT WS-RAW-FLAGS
         WS-RAW-MAGIC
     CALL "CBL_CLOSE_FILE" USING WS-RAW-HANDLE
     MOVE "T" TO TL-MODE
     MOVE "1F8B" TO TL-EXPECTED
     MOVE FUNCTION HEX-OF(WS-RAW-MAGIC) TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 CHECK-PK-EQUALS-PB.
     MOVE 0 TO WS-OFFSET
     CALL "TEST-SLICE-EQUALS" USING PB-BUFFER WS-OFFSET PK-BUFFER WS-EQUAL
     MOVE "T" TO TL-MODE
     IF WS-EQUAL = 1 AND PK-LENGTH = PB-LENGTH
         MOVE "equal" TO TL-EXPECTED TL-OBSERVED
     ELSE
         CALL "TEST-BUFFER-HEX" USING PB-BUFFER TL-EXPECTED
         CALL "TEST-BUFFER-HEX" USING PK-BUFFER TL-OBSERVED
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

*> WS-HEX against WS-COUNT bytes of the buffer from WS-OFFSET.
 CHECK-SLICE.
     MOVE "T" TO TL-MODE
     MOVE WS-HEX TO TL-EXPECTED
     CALL "TEST-BUFFER-SLICE-HEX" USING PB-BUFFER WS-OFFSET WS-COUNT TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 CHECK-ERROR.
     MOVE 1 TO TL-EXPECTED-N
     MOVE PB-ERROR TO TL-OBSERVED-N
     PERFORM CHECK-NUMBER.

*> NBT-READ-FIND did not find the path: type 0, PB-POS back at WS-OFFSET, no error.
 CHECK-NOT-FOUND.
     MOVE "T" TO TL-MODE
     MOVE "0 0 0" TO TL-EXPECTED
     PERFORM START-TEXT
     MOVE WS-INT TO WS-NUM
     PERFORM ADD-NUMBER
     COMPUTE WS-NUM = PB-POS - WS-OFFSET
     PERFORM ADD-NUMBER
     MOVE PB-ERROR TO WS-NUM
     PERFORM ADD-NUMBER
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

*> ---- helpers -------------------------------------------------------------------------------
 FILL.
     CALL "TEST-FILL-HEX" USING WS-HEX PB-BUFFER.

 CHECK-BUFFER.
     MOVE "T" TO TL-MODE
     MOVE WS-HEX TO TL-EXPECTED
     CALL "TEST-BUFFER-HEX" USING PB-BUFFER TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 CHECK-NUMBER.
     MOVE "N" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

*> A read that fails: PB-ERROR 1, PB-POS back at 0, length out 0.
 CHECK-READ-ERROR.
     MOVE 100 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PB-ERROR * 100 + PB-POS * 10 + WS-LEN
     PERFORM CHECK-NUMBER.

 POSITION-TEXT.
     PERFORM START-TEXT
     MOVE WS-INT TO WS-NUM
     PERFORM ADD-NUMBER
     MOVE WS-INT2 TO WS-NUM
     PERFORM ADD-NUMBER
     MOVE WS-INT3 TO WS-NUM
     PERFORM ADD-NUMBER
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 START-TEXT.
     MOVE "T" TO TL-MODE
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR.

*> Appends WS-NUM to TL-OBSERVED, separated from an earlier number by one space.
 ADD-NUMBER.
     MOVE WS-NUM TO WS-EDIT
     IF WS-PTR > 1
         STRING " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-IF
     STRING FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR.
 END PROGRAM CONTRACT-PROTO-PRIMITIVES.
 COPY PROTOTEST.
