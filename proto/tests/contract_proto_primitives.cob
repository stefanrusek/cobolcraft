*> ---- 00 §2 Boolean -------------------------------------------------------------------------
 BOOL-CASES.
     CALL "PB-RESET" USING PB-BUFFER
     MOVE 1 TO WS-INT
     CALL "PB-PUT-BOOL" USING PB-BUFFER WS-INT
     MOVE 0 TO WS-INT
     CALL "PB-PUT-BOOL" USING PB-BUFFER WS-INT
     MOVE "contract proto BOOL put true and false is 01 00" TO TL-CASE
     MOVE "0100" TO WS-HEX
     PERFORM CHECK-BUFFER
     MOVE "01 00 02" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-BOOL" USING PB-BUFFER WS-INT
     CALL "PB-GET-BOOL" USING PB-BUFFER WS-INT2
     CALL "PB-GET-BOOL" USING PB-BUFFER WS-INT3
     MOVE "contract proto BOOL get 01 00 02 is true false true" TO TL-CASE
     MOVE 101 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-INT * 100 + WS-INT2 * 10 + WS-INT3
     PERFORM CHECK-NUMBER.

*> ---- 00 §2 Byte (signed) and UByte ----------------------------------------------------------
 BYTE-CASES.
     CALL "PB-RESET" USING PB-BUFFER
     MOVE -1 TO WS-INT
     CALL "PB-PUT-BYTE" USING PB-BUFFER WS-INT
     MOVE 127 TO WS-INT
     CALL "PB-PUT-BYTE" USING PB-BUFFER WS-INT
     MOVE -128 TO WS-INT
     CALL "PB-PUT-BYTE" USING PB-BUFFER WS-INT
     MOVE "contract proto BYTE put -1 127 -128 is ff 7f 80" TO TL-CASE
     MOVE "ff7f80" TO WS-HEX
     PERFORM CHECK-BUFFER
     MOVE "ff 80 7f" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-BYTE" USING PB-BUFFER WS-INT
     MOVE "contract proto BYTE get ff is -1" TO TL-CASE
     MOVE -1 TO TL-EXPECTED-N
     MOVE WS-INT TO TL-OBSERVED-N
     PERFORM CHECK-NUMBER
     CALL "PB-GET-BYTE" USING PB-BUFFER WS-INT
     MOVE "contract proto BYTE get 80 is -128" TO TL-CASE
     MOVE -128 TO TL-EXPECTED-N
     MOVE WS-INT TO TL-OBSERVED-N
     PERFORM CHECK-NUMBER
     CALL "PB-GET-BYTE" USING PB-BUFFER WS-INT
     MOVE "contract proto BYTE get 7f is 127" TO TL-CASE
     MOVE 127 TO TL-EXPECTED-N
     MOVE WS-INT TO TL-OBSERVED-N
     PERFORM CHECK-NUMBER
     CALL "PB-RESET" USING PB-BUFFER
     MOVE 255 TO WS-INT
     CALL "PB-PUT-UBYTE" USING PB-BUFFER WS-INT
     MOVE 0 TO WS-INT
     CALL "PB-PUT-UBYTE" USING PB-BUFFER WS-INT
     MOVE "contract proto UBYTE put 255 0 is ff 00" TO TL-CASE
     MOVE "ff00" TO WS-HEX
     PERFORM CHECK-BUFFER
     MOVE "ff" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-UBYTE" USING PB-BUFFER WS-INT
     MOVE "contract proto UBYTE get ff is 255" TO TL-CASE
     MOVE 255 TO TL-EXPECTED-N
     MOVE WS-INT TO TL-OBSERVED-N
     PERFORM CHECK-NUMBER.

*> ---- 00 §1, §2 Short and UShort, big-endian -------------------------------------------------
 SHORT-CASES.
     CALL "PB-RESET" USING PB-BUFFER
     MOVE 12345 TO WS-INT
     CALL "PB-PUT-SHORT" USING PB-BUFFER WS-INT
     MOVE -2 TO WS-INT
     CALL "PB-PUT-SHORT" USING PB-BUFFER WS-INT
     MOVE "contract proto SHORT put 12345 -2 is 3039 fffe" TO TL-CASE
     MOVE "3039fffe" TO WS-HEX
     PERFORM CHECK-BUFFER
     MOVE "8000 7fff" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-SHORT" USING PB-BUFFER WS-INT
     CALL "PB-GET-SHORT" USING PB-BUFFER WS-INT2
     MOVE "contract proto SHORT get 8000 7fff is -32768 32767" TO TL-CASE
     MOVE -32768 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-INT - (WS-INT2 - 32767)
     PERFORM CHECK-NUMBER
     CALL "PB-RESET" USING PB-BUFFER
     MOVE 25565 TO WS-INT
     CALL "PB-PUT-USHORT" USING PB-BUFFER WS-INT
     MOVE 65535 TO WS-INT
     CALL "PB-PUT-USHORT" USING PB-BUFFER WS-INT
     MOVE "contract proto USHORT put 25565 65535 is 63dd ffff" TO TL-CASE
     MOVE "63ddffff" TO WS-HEX
     PERFORM CHECK-BUFFER
     MOVE "ffff" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-USHORT" USING PB-BUFFER WS-INT
     MOVE "contract proto USHORT get ffff is 65535" TO TL-CASE
     MOVE 65535 TO TL-EXPECTED-N
     MOVE WS-INT TO TL-OBSERVED-N
     PERFORM CHECK-NUMBER.

*> ---- 00 §2 Int and Long, big-endian signed --------------------------------------------------
 INT-LONG-CASES.
     CALL "PB-RESET" USING PB-BUFFER
     MOVE 123456789 TO WS-INT
     CALL "PB-PUT-INT" USING PB-BUFFER WS-INT
     MOVE -1 TO WS-INT
     CALL "PB-PUT-INT" USING PB-BUFFER WS-INT
     MOVE "contract proto INT put 123456789 -1 is 075bcd15 ffffffff" TO TL-CASE
     MOVE "075bcd15ffffffff" TO WS-HEX
     PERFORM CHECK-BUFFER
     MOVE "80000000" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-INT" USING PB-BUFFER WS-INT
     MOVE "contract proto INT get 80000000 is -2147483648" TO TL-CASE
     MOVE -2147483648 TO TL-EXPECTED-N
     MOVE WS-INT TO TL-OBSERVED-N
     PERFORM CHECK-NUMBER
     CALL "PB-RESET" USING PB-BUFFER
     MOVE 123456789 TO WS-LONG
     CALL "PB-PUT-LONG" USING PB-BUFFER WS-LONG
     MOVE -2 TO WS-LONG
     CALL "PB-PUT-LONG" USING PB-BUFFER WS-LONG
     MOVE "contract proto LONG put 123456789 -2 big-endian" TO TL-CASE
     MOVE "00000000075bcd15fffffffffffffffe" TO WS-HEX
     PERFORM CHECK-BUFFER
     MOVE "80 00 00 00 00 00 00 00 7f ff ff ff ff ff ff ff" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-LONG" USING PB-BUFFER WS-LONG
     MOVE "contract proto LONG get 8000000000000000 is the minimum" TO TL-CASE
     MOVE -9223372036854775808 TO TL-EXPECTED-N
     MOVE WS-LONG TO TL-OBSERVED-N
     PERFORM CHECK-NUMBER
     CALL "PB-GET-LONG" USING PB-BUFFER WS-LONG
     MOVE "contract proto LONG get 7fffffffffffffff is the maximum" TO TL-CASE
     MOVE 9223372036854775807 TO TL-EXPECTED-N
     MOVE WS-LONG TO TL-OBSERVED-N
     PERFORM CHECK-NUMBER.

*> ---- 00 §2 Float and Double, IEEE-754 big-endian (research R2) -----------------------------
 FLOAT-CASES.
     CALL "PB-RESET" USING PB-BUFFER
     MOVE 1.5 TO WS-FLOAT
     CALL "PB-PUT-FLOAT" USING PB-BUFFER WS-FLOAT
     MOVE -0.125 TO WS-FLOAT
     CALL "PB-PUT-FLOAT" USING PB-BUFFER WS-FLOAT
     MOVE "contract proto FLOAT put 1.5 -0.125 is 3fc00000 be000000" TO TL-CASE
     MOVE "3fc00000be000000" TO WS-HEX
     PERFORM CHECK-BUFFER
     MOVE "be000000" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-FLOAT" USING PB-BUFFER WS-FLOAT
     MOVE "contract proto FLOAT get be000000 is -0.125" TO TL-CASE
     MOVE -125 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-FLOAT * 1000
     PERFORM CHECK-NUMBER
     CALL "PB-RESET" USING PB-BUFFER
     MOVE -2.25 TO WS-DOUBLE
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER WS-DOUBLE
     MOVE "contract proto DOUBLE put -2.25 is c002000000000000" TO TL-CASE
     MOVE "c002000000000000" TO WS-HEX
     PERFORM CHECK-BUFFER
     MOVE "3ff8000000000000" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-DOUBLE" USING PB-BUFFER WS-DOUBLE
     MOVE "contract proto DOUBLE get 3ff8000000000000 is 1.5" TO TL-CASE
     MOVE 1500 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-DOUBLE * 1000
     PERFORM CHECK-NUMBER.

