     MOVE "0005002401010201030506080002486901" TO TL-EXPECTED
     PERFORM CHECK-BYTES
     INITIALIZE PB-ITEMSTACK-X
     MOVE 2 TO WS-STATE
     MOVE -1 TO WS-SLOT
