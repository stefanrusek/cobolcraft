     PERFORM ADD-HEAD-3
     PERFORM ADD-STACK
     PERFORM END-FIELDS
     MOVE "00 02 ffff 00" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-CONTAINER-SET-SLOT" USING PB-BUFFER WS-CONTAINER WS-STATE WS-SLOT
         PB-ITEMSTACK-X
     MOVE "test containers SET-SLOT get of slot -1 with an empty stack" TO TL-CASE
     MOVE "0 2 -1 0 0 0 0 pos 5 error 0" TO TL-EXPECTED
     PERFORM START-FIELDS
     PERFORM ADD-HEAD-3
     PERFORM ADD-STACK
     PERFORM END-FIELDS
     MOVE "00 05 0024 01 01 01 00 10 00" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-CONTAINER-SET-SLOT" USING PB-BUFFER WS-CONTAINER WS-STATE WS-SLOT
         PB-ITEMSTACK-X
     MOVE "test containers SET-SLOT get of an unreadable stack sets PB-ERROR, PB-POS 0, zeros"
         TO TL-CASE
     MOVE "0 0 0 0 0 0 0 pos 0 error 1" TO TL-EXPECTED
     PERFORM START-FIELDS
     PERFORM ADD-HEAD-3
     PERFORM ADD-STACK
     PERFORM END-FIELDS
     MOVE "ffffffff0f 05 0024 00" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-CONTAINER-SET-SLOT" USING PB-BUFFER WS-CONTAINER WS-STATE WS-SLOT
         PB-ITEMSTACK-X
     MOVE "test containers SET-SLOT get of container -1 sets PB-ERROR, PB-POS 0, zeros"
         TO TL-CASE
     MOVE "0 0 0 0 0 0 0 pos 0 error 1" TO TL-EXPECTED
     PERFORM START-FIELDS
     PERFORM ADD-HEAD-3
     PERFORM ADD-STACK
     PERFORM END-FIELDS
     MOVE "00 05 00" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-CONTAINER-SET-SLOT" USING PB-BUFFER WS-CONTAINER WS-STATE WS-SLOT
         PB-ITEMSTACK-X
     MOVE "test containers SET-SLOT get cut inside the slot sets PB-ERROR, PB-POS 0, zeros"
         TO TL-CASE
     MOVE "0 0 0 0 0 0 0 pos 0 error 1" TO TL-EXPECTED
     PERFORM START-FIELDS
     PERFORM ADD-HEAD-3
     PERFORM ADD-STACK
     PERFORM END-FIELDS.

 CONTENT-CASES.
