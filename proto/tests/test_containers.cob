         PB-ITEMSTACK-X
     MOVE "test containers SET-SLOT put of slot -1 with an empty stack" TO TL-CASE
     MOVE "0002ffff00" TO TL-EXPECTED
     PERFORM CHECK-BYTES
     MOVE 32768 TO WS-SLOT
     CALL "PB-PUT-CONTAINER-SET-SLOT" USING PB-BUFFER WS-CONTAINER WS-STATE WS-SLOT
         PB-ITEMSTACK-X
     MOVE "test containers SET-SLOT put of slot 32768 sets PB-ERROR and appends nothing"
         TO TL-CASE
     PERFORM CHECK-PUT-ERROR
     MOVE -32769 TO WS-SLOT
     CALL "PB-PUT-CONTAINER-SET-SLOT" USING PB-BUFFER WS-CONTAINER WS-STATE WS-SLOT
         PB-ITEMSTACK-X
     MOVE "test containers SET-SLOT put of slot -32769 sets PB-ERROR and appends nothing"
         TO TL-CASE
     PERFORM CHECK-PUT-ERROR
     MOVE 0 TO WS-SLOT
     MOVE -1 TO WS-CONTAINER
     CALL "PB-PUT-CONTAINER-SET-SLOT" USING PB-BUFFER WS-CONTAINER WS-STATE WS-SLOT
         PB-ITEMSTACK-X
     MOVE "test containers SET-SLOT put of container -1 sets PB-ERROR and appends nothing"
         TO TL-CASE
     PERFORM CHECK-PUT-ERROR
     MOVE 0 TO WS-CONTAINER
     MOVE -1 TO WS-STATE
     CALL "PB-PUT-CONTAINER-SET-SLOT" USING PB-BUFFER WS-CONTAINER WS-STATE WS-SLOT
         PB-ITEMSTACK-X
     MOVE "test containers SET-SLOT put of state id -1 sets PB-ERROR and appends nothing"
         TO TL-CASE
     PERFORM CHECK-PUT-ERROR
     MOVE 0 TO WS-STATE
     MOVE 1 TO PB-ISX-COUNT
     MOVE -1 TO PB-ISX-ITEM
     CALL "PB-PUT-CONTAINER-SET-SLOT" USING PB-BUFFER WS-CONTAINER WS-STATE WS-SLOT
         PB-ITEMSTACK-X
     MOVE "test containers SET-SLOT put of a bad stack leaves no partial bytes" TO TL-CASE
     PERFORM CHECK-PUT-ERROR
     MOVE "00 05 0024 01 01 02 01 03 05 06 08 00 02 48 69 01" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-CONTAINER-SET-SLOT" USING PB-BUFFER WS-CONTAINER WS-STATE WS-SLOT
         PB-ITEMSTACK-X
