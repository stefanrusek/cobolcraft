     MOVE "test containers CLICK-HEAD put of slot -40000 sets PB-ERROR and appends nothing"
         TO TL-CASE
     PERFORM CHECK-PUT-ERROR
     MOVE 45 TO WS-SLOT
     MOVE -1 TO WS-CONTAINER
     CALL "PB-PUT-CONTAINER-CLICK-HEAD" USING PB-BUFFER WS-CONTAINER WS-STATE WS-SLOT
         WS-BUTTON WS-CLICK-TYPE WS-COUNT
     MOVE "test containers CLICK-HEAD put of container -1 sets PB-ERROR and appends nothing"
         TO TL-CASE
     PERFORM CHECK-PUT-ERROR
     MOVE 2 TO WS-CONTAINER
     MOVE -1 TO WS-STATE
     CALL "PB-PUT-CONTAINER-CLICK-HEAD" USING PB-BUFFER WS-CONTAINER WS-STATE WS-SLOT
         WS-BUTTON WS-CLICK-TYPE WS-COUNT
     MOVE "test containers CLICK-HEAD put of state id -1 sets PB-ERROR and appends nothing"
