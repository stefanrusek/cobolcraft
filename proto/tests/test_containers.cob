     PERFORM START-FIELDS
     PERFORM ADD-HASHED-FULL
     PERFORM END-FIELDS
     MOVE "01 01 ffffffff0f 00 00" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-HASHED-STACK" USING PB-BUFFER PB-HASHED-STACK
     MOVE "test containers HASHED-STACK get of a negative count sets PB-ERROR, PB-POS 0"
         TO TL-CASE
     MOVE "0 0 0 0 0 0 0 0 pos 0 error 1" TO TL-EXPECTED
     PERFORM START-FIELDS
     PERFORM ADD-HASHED-FULL
     PERFORM END-FIELDS
     MOVE "01 01 01 00 ffffffff0f" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-HASHED-STACK" USING PB-BUFFER PB-HASHED-STACK
     MOVE "test containers HASHED-STACK get of a negative removed count sets PB-ERROR, PB-POS 0"
         TO TL-CASE
     MOVE "0 0 0 0 0 0 0 0 pos 0 error 1" TO TL-EXPECTED
     PERFORM START-FIELDS
     PERFORM ADD-HASHED-FULL
     PERFORM END-FIELDS
     MOVE "01 01 01 ffffffff0f" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-HASHED-STACK" USING PB-BUFFER PB-HASHED-STACK
     MOVE "test containers HASHED-STACK get of a negative added count sets PB-ERROR, PB-POS 0"
         TO TL-CASE
     MOVE "0 0 0 0 0 0 0 0 pos 0 error 1" TO TL-EXPECTED
     PERFORM START-FIELDS
     PERFORM ADD-HASHED-FULL
     PERFORM END-FIELDS
     MOVE "01 01 01 01 03 dead" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-HASHED-STACK" USING PB-BUFFER PB-HASHED-STACK
     MOVE "test containers HASHED-STACK get cut inside a hash sets PB-ERROR, PB-POS 0" TO TL-CASE
     MOVE "0 0 0 0 0 0 0 0 pos 0 error 1" TO TL-EXPECTED
     PERFORM START-FIELDS
     PERFORM ADD-HASHED-FULL
     PERFORM END-FIELDS.

 SCREEN-CASES.
     CALL "PB-RESET" USING PB-BUFFER
     MOVE 127 TO WS-CONTAINER
     MOVE 2 TO WS-MENU
     INITIALIZE PB-TEXT
     MOVE PB-TEXT-PLAIN TO PB-TX-KIND
     MOVE "Loot" TO PB-TX-VALUE
     MOVE 4 TO PB-TX-LENGTH
     CALL "PB-PUT-OPEN-SCREEN" USING PB-BUFFER WS-CONTAINER WS-MENU PB-TEXT
     MOVE "test containers OPEN-SCREEN put of a chest titled Loot" TO TL-CASE
     MOVE "7f020800044c6f6f74" TO TL-EXPECTED
     PERFORM CHECK-BYTES
     MOVE 2 TO WS-CONTAINER
     MOVE 12 TO WS-MENU
     MOVE PB-TEXT-TRANSLATE TO PB-TX-KIND
     MOVE "container.crafting" TO PB-TX-VALUE
     MOVE 18 TO PB-TX-LENGTH
     CALL "PB-PUT-OPEN-SCREEN" USING PB-BUFFER WS-CONTAINER WS-MENU PB-TEXT
     MOVE "test containers OPEN-SCREEN put of the crafting table with a translated title"
         TO TL-CASE
     MOVE SPACES TO TL-EXPECTED
     STRING "020c0a0800097472616e736c6174650012" "636f6e7461696e65722e6372616674696e6700"
         DELIMITED BY SIZE INTO TL-EXPECTED
     PERFORM CHECK-BYTES
     MOVE -1 TO WS-CONTAINER
     CALL "PB-PUT-OPEN-SCREEN" USING PB-BUFFER WS-CONTAINER WS-MENU PB-TEXT
     MOVE "test containers OPEN-SCREEN put of container -1 sets PB-ERROR and appends nothing"
         TO TL-CASE
     PERFORM CHECK-PUT-ERROR
     MOVE 2 TO WS-CONTAINER
     MOVE -1 TO WS-MENU
     CALL "PB-PUT-OPEN-SCREEN" USING PB-BUFFER WS-CONTAINER WS-MENU PB-TEXT
     MOVE "test containers OPEN-SCREEN put of menu type -1 sets PB-ERROR and appends nothing"
         TO TL-CASE
     PERFORM CHECK-PUT-ERROR
     MOVE "7f 02 08 00 04 4c6f6f74" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-OPEN-SCREEN" USING PB-BUFFER WS-CONTAINER WS-MENU PB-TEXT
     MOVE "test containers OPEN-SCREEN get of a chest titled Loot" TO TL-CASE
     MOVE "127 2 plain Loot pos 9 error 0" TO TL-EXPECTED
     PERFORM START-FIELDS
     PERFORM ADD-HEAD-2
     PERFORM ADD-TITLE
     PERFORM END-FIELDS
     MOVE "02 0c 0a 08 00 09 7472616e736c617465 00 12 636f6e7461696e65722e6372616674696e67 00"
         TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-OPEN-SCREEN" USING PB-BUFFER WS-CONTAINER WS-MENU PB-TEXT
     MOVE "test containers OPEN-SCREEN get of the crafting table with a translated title"
         TO TL-CASE
     MOVE "2 12 translate container.crafting pos 36 error 0" TO TL-EXPECTED
     PERFORM START-FIELDS
     PERFORM ADD-HEAD-2
     PERFORM ADD-TITLE
     PERFORM END-FIELDS
     MOVE "02 0c 07" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-OPEN-SCREEN" USING PB-BUFFER WS-CONTAINER WS-MENU PB-TEXT
     MOVE "test containers OPEN-SCREEN get of an unreadable title sets PB-ERROR, PB-POS 0"
         TO TL-CASE
     MOVE "0 0 pos 0 error 1" TO TL-EXPECTED
     PERFORM START-FIELDS
     PERFORM ADD-HEAD-2
     PERFORM END-FIELDS
     MOVE "ffffffff0f 02 08 00 00" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-OPEN-SCREEN" USING PB-BUFFER WS-CONTAINER WS-MENU PB-TEXT
     MOVE "test containers OPEN-SCREEN get of container -1 sets PB-ERROR, PB-POS 0, zeros"
         TO TL-CASE
     MOVE "0 0 pos 0 error 1" TO TL-EXPECTED
     PERFORM START-FIELDS
     PERFORM ADD-HEAD-2
     PERFORM END-FIELDS
     MOVE "02" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-OPEN-SCREEN" USING PB-BUFFER WS-CONTAINER WS-MENU PB-TEXT
     MOVE "test containers OPEN-SCREEN get cut before the menu type sets PB-ERROR, PB-POS 0"
         TO TL-CASE
     MOVE "0 0 pos 0 error 1" TO TL-EXPECTED
     PERFORM START-FIELDS
     PERFORM ADD-HEAD-2
     PERFORM END-FIELDS.

 CLOSE-CASES.
     CALL "PB-RESET" USING PB-BUFFER
     MOVE 3 TO WS-CONTAINER
     MOVE 2 TO WS-SLOT
     MOVE 150 TO WS-COUNT
     CALL "PB-PUT-CONTAINER-SET-DATA" USING PB-BUFFER WS-CONTAINER WS-SLOT WS-COUNT
     MOVE "test containers SET-DATA put of container 3, property 2, value 150 (VarInt, Short, Short)" TO TL-CASE
     MOVE "0300020096" TO TL-EXPECTED
     PERFORM CHECK-BYTES
     MOVE -1 TO WS-COUNT
     CALL "PB-PUT-CONTAINER-SET-DATA" USING PB-BUFFER WS-CONTAINER WS-SLOT WS-COUNT
     MOVE "test containers SET-DATA put of value -1 is the Short ffff" TO TL-CASE
     MOVE "030002ffff" TO TL-EXPECTED
     PERFORM CHECK-BYTES
     MOVE 40000 TO WS-COUNT
     CALL "PB-PUT-CONTAINER-SET-DATA" USING PB-BUFFER WS-CONTAINER WS-SLOT WS-COUNT
     MOVE "test containers SET-DATA put of a value outside a Short sets PB-ERROR and appends nothing" TO TL-CASE
     PERFORM CHECK-PUT-ERROR
     MOVE "0300020096" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-CONTAINER-SET-DATA" USING PB-BUFFER WS-CONTAINER WS-SLOT WS-COUNT
     MOVE "test containers SET-DATA get gives container, property and value" TO TL-CASE
     MOVE "3 2 150 pos 5 error 0" TO TL-EXPECTED
     MOVE "T" TO TL-MODE
     MOVE 1 TO WS-PTR
     MOVE SPACES TO TL-OBSERVED
     MOVE WS-CONTAINER TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE WS-SLOT TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE WS-COUNT TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) " pos " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE PB-POS TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) " error " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE PB-ERROR TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "PB-RESET" USING PB-BUFFER
     MOVE "0300" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-CONTAINER-SET-DATA" USING PB-BUFFER WS-CONTAINER WS-SLOT WS-COUNT
     MOVE "test containers SET-DATA get of a cut-short packet sets PB-ERROR, PB-POS 0 and yields zeros" TO TL-CASE
     MOVE "0 0 0 pos 0 error 1" TO TL-EXPECTED
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR
     MOVE WS-CONTAINER TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE WS-SLOT TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE WS-COUNT TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) " pos " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE PB-POS TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) " error " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE PB-ERROR TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "PB-RESET" USING PB-BUFFER
     MOVE 0 TO WS-CONTAINER
     CALL "PB-PUT-CONTAINER-CLOSE" USING PB-BUFFER WS-CONTAINER
     MOVE "test containers CLOSE put of container 0" TO TL-CASE
     MOVE "00" TO TL-EXPECTED
     PERFORM CHECK-BYTES
     MOVE 300 TO WS-CONTAINER
     CALL "PB-PUT-CONTAINER-CLOSE" USING PB-BUFFER WS-CONTAINER
     MOVE "test containers CLOSE put of container 300 is a two-byte VarInt" TO TL-CASE
     MOVE "ac02" TO TL-EXPECTED
     PERFORM CHECK-BYTES
     MOVE -1 TO WS-CONTAINER
     CALL "PB-PUT-CONTAINER-CLOSE" USING PB-BUFFER WS-CONTAINER
     MOVE "test containers CLOSE put of container -1 sets PB-ERROR and appends nothing" TO TL-CASE
     PERFORM CHECK-PUT-ERROR
     MOVE "ac02" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-CONTAINER-CLOSE" USING PB-BUFFER WS-CONTAINER
     MOVE "test containers CLOSE get of container 300" TO TL-CASE
     MOVE "300 pos 2 error 0" TO TL-EXPECTED
     MOVE WS-CONTAINER TO WS-EDIT
     PERFORM START-FIELDS
     PERFORM ADD-FIELD
     PERFORM END-FIELDS
     MOVE "ffffffff0f" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-CONTAINER-CLOSE" USING PB-BUFFER WS-CONTAINER
     MOVE "test containers CLOSE get of container -1 sets PB-ERROR, PB-POS 0, zero" TO TL-CASE
     MOVE "0 pos 0 error 1" TO TL-EXPECTED
     PERFORM START-FIELDS
     MOVE WS-CONTAINER TO WS-EDIT
     PERFORM ADD-FIELD
     PERFORM END-FIELDS
     MOVE SPACES TO WS-HEX
     MOVE "." TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-CONTAINER-CLOSE" USING PB-BUFFER WS-CONTAINER
     MOVE "test containers CLOSE get of an empty body sets PB-ERROR, PB-POS 0, zero" TO TL-CASE
     MOVE "0 pos 0 error 1" TO TL-EXPECTED
     PERFORM START-FIELDS
     MOVE WS-CONTAINER TO WS-EDIT
     PERFORM ADD-FIELD
     PERFORM END-FIELDS.

*> ---- field printers: TL-OBSERVED is the fields, then " pos <PB-POS> error <PB-ERROR>" ----
 START-FIELDS.
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR.

 ADD-FIELD.
     IF WS-PTR > 1
         STRING " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-IF
     STRING FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR.

 ADD-HEAD-2.
     MOVE WS-CONTAINER TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE WS-MENU TO WS-EDIT
     PERFORM ADD-FIELD.

 ADD-HEAD-3.
     MOVE WS-CONTAINER TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE WS-STATE TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE WS-SLOT TO WS-EDIT
     PERFORM ADD-FIELD.

 ADD-HEAD-C.
     MOVE WS-CONTAINER TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE WS-STATE TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE WS-COUNT TO WS-EDIT
     PERFORM ADD-FIELD.

 ADD-HEAD-6.
     MOVE WS-CONTAINER TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE WS-STATE TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE WS-SLOT TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE WS-BUTTON TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE WS-CLICK-TYPE TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE WS-COUNT TO WS-EDIT
     PERFORM ADD-FIELD.

 ADD-STACK.
     MOVE PB-ISX-COUNT TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE PB-ISX-ITEM TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE PB-ISX-ADDED-COUNT TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE PB-ISX-REMOVED-COUNT TO WS-EDIT
     PERFORM ADD-FIELD.

*> present, item, count, added count, removed count of the hashed stack
 ADD-HASHED.
     MOVE PB-HS-PRESENT TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE PB-HS-ITEM TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE PB-HS-COUNT TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE PB-HS-ADDED-COUNT TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE PB-HS-REMOVED-COUNT TO WS-EDIT
     PERFORM ADD-FIELD.

*> as ADD-HASHED, with the first added entry and the first removed id
 ADD-HASHED-FULL.
     MOVE PB-HS-PRESENT TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE PB-HS-ITEM TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE PB-HS-COUNT TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE PB-HS-ADDED-COUNT TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE PB-HS-TYPE(1) TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE PB-HS-HASH(1) TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE PB-HS-REMOVED-COUNT TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE PB-HS-REMOVED(1) TO WS-EDIT
     PERFORM ADD-FIELD.

 ADD-TITLE.
     EVALUATE PB-TX-KIND
         WHEN PB-TEXT-PLAIN
             STRING " plain " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
         WHEN PB-TEXT-LITERAL
             STRING " literal " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
         WHEN OTHER
             STRING " translate " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-EVALUATE
     STRING PB-TX-VALUE(1:PB-TX-LENGTH) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR.

 END-FIELDS.
     MOVE PB-POS TO WS-EDIT
     STRING " pos " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED
         WITH POINTER WS-PTR
     MOVE PB-ERROR TO WS-EDIT
     STRING " error " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED
         WITH POINTER WS-PTR
     MOVE "T" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

*> The buffer's bytes (hex) against TL-EXPECTED; the buffer is emptied afterwards.
 CHECK-BYTES.
     MOVE "T" TO TL-MODE
     CALL "TEST-BUFFER-HEX" USING PB-BUFFER TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "PB-RESET" USING PB-BUFFER.

*> PB-ERROR 1 and nothing appended.
 CHECK-PUT-ERROR.
     MOVE "N" TO TL-MODE
     MOVE 10 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PB-ERROR * 10 + PB-LENGTH
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "PB-RESET" USING PB-BUFFER.

 FILL.
     CALL "TEST-FILL-HEX" USING WS-HEX PB-BUFFER.
 END PROGRAM TEST-CONTAINERS.
 COPY PROTOTEST.
