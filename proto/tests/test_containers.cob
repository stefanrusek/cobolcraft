         WS-BUTTON WS-CLICK-TYPE WS-COUNT
     MOVE "test containers CLICK-HEAD put of slot 45 button 1 PICKUP and one changed slot"
         TO TL-CASE
     MOVE "02ac02002d010001" TO TL-EXPECTED
     PERFORM CHECK-BYTES
     MOVE -999 TO WS-SLOT
     MOVE -1 TO WS-BUTTON
     MOVE 6 TO WS-CLICK-TYPE
     MOVE 128 TO WS-COUNT
     CALL "PB-PUT-CONTAINER-CLICK-HEAD" USING PB-BUFFER WS-CONTAINER WS-STATE WS-SLOT
         WS-BUTTON WS-CLICK-TYPE WS-COUNT
