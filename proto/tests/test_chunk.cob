*> Implementation test of proto/src/chunk.cob and proto/src/composites.cob: the remaining palette
*> widths of 06 §5.3 (biome Linear 2 and 3 bits, block HashMap 8 bits, block Global at 9 bits),
*> light sections without information (06 §7), and text and item stack edge cases.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-CHUNK.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY PROTO.
 COPY PROTO REPLACING LEADING ==PB-== BY ==PK-==.
 COPY TESTLIB.
 01 WS-CAPACITY            BINARY-LONG VALUE 64.
 01 WS-HEX                 PIC X(1024).
 01 WS-I                   BINARY-LONG.
 01 WS-OFFSET              BINARY-LONG.
 01 WS-COUNT               BINARY-LONG.
 01 WS-MISMATCHES          BINARY-LONG.
 01 WS-BLOCK-MODULUS       BINARY-LONG.
 01 WS-BIOME-MODULUS       BINARY-LONG.
 01 WS-NON-EMPTY           BINARY-LONG VALUE 4096.
 01 WS-FLUID               BINARY-LONG VALUE 0.
 01 WS-NON-EMPTY-2         BINARY-LONG.
 01 WS-FLUID-2             BINARY-LONG.
 01 WS-BLOCK-BITS          BINARY-LONG.
 01 WS-BIOME-BITS          BINARY-LONG VALUE 3.
 01 WS-BLOCKS.
    05 WS-BLOCK            BINARY-LONG OCCURS 4096 TIMES.
 01 WS-BIOMES.
    05 WS-BIOME            BINARY-LONG OCCURS 64 TIMES.
 01 WS-BLOCKS-2.
    05 WS-BLOCK-2          BINARY-LONG OCCURS 4096 TIMES.
 01 WS-BIOMES-2.
    05 WS-BIOME-2          BINARY-LONG OCCURS 64 TIMES.
 01 WS-LIGHT-COUNT         BINARY-LONG VALUE 20.
 01 WS-SKY-STATES.
    05 WS-SKY-STATE        BINARY-LONG OCCURS 20 TIMES.
 01 WS-SKY-ARRAYS.
    05 WS-SKY-ARRAY        PIC X(2048) OCCURS 20 TIMES.
 01 WS-BLOCK-STATES.
    05 WS-BLOCK-STATE      BINARY-LONG OCCURS 20 TIMES.
 01 WS-BLOCK-ARRAYS.
    05 WS-BLOCK-ARRAY      PIC X(2048) OCCURS 20 TIMES.
 01 WS-SKY-STATES-2.
    05 WS-SKY-STATE-2      BINARY-LONG OCCURS 20 TIMES.
 01 WS-SKY-ARRAYS-2.
    05 WS-SKY-ARRAY-2      PIC X(2048) OCCURS 20 TIMES.
 01 WS-BLOCK-STATES-2.
    05 WS-BLOCK-STATE-2    BINARY-LONG OCCURS 20 TIMES.
 01 WS-BLOCK-ARRAYS-2.
    05 WS-BLOCK-ARRAY-2    PIC X(2048) OCCURS 20 TIMES.
 01 WS-EDIT                PIC -(19)9.
 01 WS-PTR                 BINARY-LONG.
 01 WS-NUM                 BINARY-DOUBLE.
 PROCEDURE DIVISION.
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     CALL "PB-INIT" USING PK-BUFFER WS-CAPACITY
     MOVE 5 TO WS-BLOCK-BITS
*>   Biomes, Linear at 2 bits (3 distinct: 32 per Long, 2 Longs) and 3 bits (5 distinct: 21 per
*>   Long, 4 Longs, 06 §5.5); block states all one value.
     MOVE 1 TO WS-BLOCK-MODULUS
     MOVE 3 TO WS-BIOME-MODULUS
     PERFORM ENCODE-SECTION
     MOVE "test chunk biome Linear 2 bits: bits byte 2, palette 0 1 2, two Longs" TO TL-CASE
     MOVE "1000000000000203000102" TO WS-HEX
     MOVE 11 TO WS-COUNT
     PERFORM CHECK-SLICE
     MOVE 27 TO TL-EXPECTED-N
     PERFORM ROUND-TRIP
     MOVE 5 TO WS-BIOME-MODULUS
     PERFORM ENCODE-SECTION
     MOVE "test chunk biome Linear 3 bits: bits byte 3, palette of 5, four Longs" TO TL-CASE
     MOVE "100000000000030500010203" & "04" TO WS-HEX
     MOVE 13 TO WS-COUNT
     PERFORM CHECK-SLICE
     MOVE 45 TO TL-EXPECTED-N
     PERFORM ROUND-TRIP
*>   Block states, HashMap at 8 bits (256 distinct, 512 Longs) and Global at 9 bits (257
*>   distinct, 7 per Long, 586 Longs); biomes one value.
     MOVE 256 TO WS-BLOCK-MODULUS
     MOVE 1 TO WS-BIOME-MODULUS
     PERFORM ENCODE-SECTION
     MOVE "test chunk 256 block states: bits byte 8, VarInt palette size 256" TO TL-CASE
     MOVE "10000000088002" TO WS-HEX
     MOVE 7 TO WS-COUNT
     PERFORM CHECK-SLICE
     MOVE 4489 TO TL-EXPECTED-N
     PERFORM ROUND-TRIP
     MOVE 257 TO WS-BLOCK-MODULUS
     MOVE 9 TO WS-BLOCK-BITS
     PERFORM ENCODE-SECTION
     MOVE "test chunk 257 block states: Global at the global palette bits 9" TO TL-CASE
     MOVE 5 TO WS-COUNT
     MOVE "1000000009" TO WS-HEX
     PERFORM CHECK-SLICE
     MOVE 4695 TO TL-EXPECTED-N
     PERFORM ROUND-TRIP
*>   Light with indices that carry no information (state 0) on both sides of the arrays.
     INITIALIZE WS-SKY-STATES WS-BLOCK-STATES
     MOVE 1 TO WS-SKY-STATE(2)
     MOVE 2 TO WS-SKY-STATE(3)
     MOVE ALL "1" TO WS-SKY-ARRAY(3)
     MOVE 1 TO WS-BLOCK-STATE(9)
     MOVE 2 TO WS-BLOCK-STATE(20)
     MOVE ALL "2" TO WS-BLOCK-ARRAY(20)
     CALL "PB-RESET" USING PB-BUFFER
     CALL "LIGHT-ENCODE" USING PB-BUFFER WS-LIGHT-COUNT WS-SKY-STATES WS-SKY-ARRAYS
         WS-BLOCK-STATES WS-BLOCK-ARRAYS
     MOVE 0 TO WS-OFFSET
     MOVE 19 TO WS-COUNT
     MOVE "test chunk light masks of 20 sections with no-information indices, first array"
         TO TL-CASE
     MOVE "0104" & "03000008" & "0102" & "020001" & "01" & "8010" & "3131313131" TO WS-HEX
     PERFORM CHECK-SLICE
     MOVE 0 TO PB-POS
     CALL "LIGHT-DECODE" USING PB-BUFFER WS-LIGHT-COUNT WS-SKY-STATES-2 WS-SKY-ARRAYS-2
         WS-BLOCK-STATES-2 WS-BLOCK-ARRAYS-2
     MOVE "test chunk light round trip: states, arrays, length 4113, no error" TO TL-CASE
     MOVE "1 1 1 4113 0 0" TO TL-EXPECTED
     PERFORM START-TEXT
     MOVE 0 TO WS-NUM
     IF WS-SKY-STATES = WS-SKY-STATES-2 AND WS-BLOCK-STATES = WS-BLOCK-STATES-2
         MOVE 1 TO WS-NUM
     END-IF
     PERFORM ADD-NUMBER
     MOVE 0 TO WS-NUM
     IF WS-SKY-ARRAY(3) = WS-SKY-ARRAY-2(3)
         MOVE 1 TO WS-NUM
     END-IF
     PERFORM ADD-NUMBER
     MOVE 0 TO WS-NUM
     IF WS-BLOCK-ARRAY(20) = WS-BLOCK-ARRAY-2(20)
         MOVE 1 TO WS-NUM
     END-IF
     PERFORM ADD-NUMBER
     MOVE PB-LENGTH TO WS-NUM
     PERFORM ADD-NUMBER
     COMPUTE WS-NUM = PB-LENGTH - PB-POS
     PERFORM ADD-NUMBER
     MOVE PB-ERROR TO WS-NUM
     PERFORM ADD-NUMBER
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   Text: translate without arguments writes no "with"; PB-TEXT-MAX-ARGS arguments round trip;
*>   an empty "with" list is accepted; more arguments than PB-TEXT-MAX-ARGS are malformed.
     CALL "PB-RESET" USING PB-BUFFER
     MOVE PB-TEXT-TRANSLATE TO PB-TX-KIND
     MOVE "k" TO PB-TX-VALUE
     MOVE 1 TO PB-TX-LENGTH
     MOVE 0 TO PB-TX-ARG-COUNT
     CALL "PB-PUT-TEXT" USING PB-BUFFER PB-TEXT
     MOVE "test chunk TEXT translate without arguments has no with entry" TO TL-CASE
     MOVE "0a0800097472616e736c6174650001" & "6b00" TO WS-HEX
     PERFORM CHECK-BUFFER
     CALL "PB-RESET" USING PB-BUFFER
     MOVE PB-TEXT-MAX-ARGS TO PB-TX-ARG-COUNT
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > PB-TEXT-MAX-ARGS
         MOVE FUNCTION CHAR(97 + WS-I) TO PB-TX-ARG-VALUE(WS-I)
         MOVE 1 TO PB-TX-ARG-LENGTH(WS-I)
     END-PERFORM
     CALL "PB-PUT-TEXT" USING PB-BUFFER PB-TEXT
     INITIALIZE PB-TEXT
     CALL "PB-GET-TEXT" USING PB-BUFFER PB-TEXT
     MOVE "test chunk TEXT translate with 8 arguments round trip" TO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE "2 k 8 abcdefgh 0" TO TL-EXPECTED
     PERFORM START-TEXT
     MOVE PB-TX-KIND TO WS-NUM
     PERFORM ADD-NUMBER
     STRING " " PB-TX-VALUE(1:PB-TX-LENGTH) DELIMITED BY SIZE INTO TL-OBSERVED
         WITH POINTER WS-PTR
     MOVE PB-TX-ARG-COUNT TO WS-NUM
     PERFORM ADD-NUMBER
     STRING " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > PB-TX-ARG-COUNT
         STRING PB-TX-ARG-VALUE(WS-I)(1:PB-TX-ARG-LENGTH(WS-I)) DELIMITED BY SIZE
             INTO TL-OBSERVED WITH POINTER WS-PTR
     END-PERFORM
     MOVE PB-ERROR TO WS-NUM
     PERFORM ADD-NUMBER
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "0a 08 0009 7472616e736c617465 0001 6b 09 0004 77697468 00 00000000 00" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-TEXT" USING PB-BUFFER PB-TEXT
     MOVE "test chunk TEXT with an empty with list has no arguments" TO TL-CASE
     MOVE "N" TO TL-MODE
     MOVE 200 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PB-TX-KIND * 100 + PB-TX-ARG-COUNT * 10 + PB-ERROR
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "0a 08 0009 7472616e736c617465 0001 6b 09 0004 77697468 08 00000009" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-TEXT" USING PB-BUFFER PB-TEXT
     MOVE "test chunk TEXT with 9 arguments sets PB-ERROR" TO TL-CASE
     MOVE "N" TO TL-MODE
     MOVE 1 TO TL-EXPECTED-N
     MOVE PB-ERROR TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   Item stack: a negative count is the empty stack (00 §12.1).
     CALL "PB-RESET" USING PB-BUFFER
     MOVE -2 TO PB-IS-COUNT
     CALL "PB-PUT-ITEMSTACK" USING PB-BUFFER PB-ITEMSTACK
     MOVE "test chunk ITEMSTACK put of count -2 is the empty stack 00" TO TL-CASE
     MOVE "00" TO WS-HEX
     PERFORM CHECK-BUFFER
     CALL "PB-FREE" USING PK-BUFFER
     CALL "PB-FREE" USING PB-BUFFER
     STOP RUN.

*> Block i = (i - 1) mod WS-BLOCK-MODULUS, biome i = (i - 1) mod WS-BIOME-MODULUS, encoded alone.
 ENCODE-SECTION.
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 4096
         COMPUTE WS-BLOCK(WS-I) = FUNCTION MOD(WS-I - 1, WS-BLOCK-MODULUS)
     END-PERFORM
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 64
         COMPUTE WS-BIOME(WS-I) = FUNCTION MOD(WS-I - 1, WS-BIOME-MODULUS)
     END-PERFORM
     CALL "PB-RESET" USING PB-BUFFER
     CALL "CHUNK-SECTION-ENCODE" USING PB-BUFFER WS-NON-EMPTY WS-FLUID WS-BLOCKS WS-BIOMES
         WS-BLOCK-BITS WS-BIOME-BITS
     MOVE 0 TO WS-OFFSET.

*> TL-EXPECTED-N holds the expected encoded length; decodes the buffer and compares every entry.
 ROUND-TRIP.
     MOVE 0 TO PB-POS
     CALL "CHUNK-SECTION-DECODE" USING PB-BUFFER WS-BLOCK-BITS WS-BIOME-BITS WS-NON-EMPTY-2
         WS-FLUID-2 WS-BLOCKS-2 WS-BIOMES-2
     MOVE 0 TO WS-MISMATCHES
     IF WS-BLOCKS NOT = WS-BLOCKS-2 OR WS-BIOMES NOT = WS-BIOMES-2
         MOVE 1 TO WS-MISMATCHES
     END-IF
     MOVE TL-EXPECTED-N TO WS-NUM
     MOVE SPACES TO TL-EXPECTED
     STRING "round trip " FUNCTION TRIM(TL-CASE) DELIMITED BY SIZE INTO TL-EXPECTED
     MOVE TL-EXPECTED TO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE WS-NUM TO WS-EDIT
     MOVE SPACES TO TL-EXPECTED
     STRING FUNCTION TRIM(WS-EDIT) " 0 4096 0 0" DELIMITED BY SIZE INTO TL-EXPECTED
     PERFORM START-TEXT
     MOVE PB-LENGTH TO WS-NUM
     PERFORM ADD-NUMBER
     MOVE WS-MISMATCHES TO WS-NUM
     PERFORM ADD-NUMBER
     MOVE WS-NON-EMPTY-2 TO WS-NUM
     PERFORM ADD-NUMBER
     COMPUTE WS-NUM = PB-LENGTH - PB-POS
     PERFORM ADD-NUMBER
     MOVE PB-ERROR TO WS-NUM
     PERFORM ADD-NUMBER
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 FILL.
     CALL "TEST-FILL-HEX" USING WS-HEX PB-BUFFER.

 CHECK-BUFFER.
     MOVE "T" TO TL-MODE
     MOVE WS-HEX TO TL-EXPECTED
     CALL "TEST-BUFFER-HEX" USING PB-BUFFER TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 CHECK-SLICE.
     MOVE "T" TO TL-MODE
     MOVE WS-HEX TO TL-EXPECTED
     CALL "TEST-BUFFER-SLICE-HEX" USING PB-BUFFER WS-OFFSET WS-COUNT TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 START-TEXT.
     MOVE "T" TO TL-MODE
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR.

 ADD-NUMBER.
     MOVE WS-NUM TO WS-EDIT
     IF WS-PTR > 1
         STRING " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-IF
     STRING FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR.
 END PROGRAM TEST-CHUNK.
 COPY PROTOTEST.
