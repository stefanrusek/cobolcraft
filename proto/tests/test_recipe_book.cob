     MOVE "030001ac02" TO TL-EXPECTED
     PERFORM CHECK-BYTES
     MOVE 0 TO WS-COUNT
     CALL "PB-PUT-RECIPE-BOOK-REMOVE" USING PB-BUFFER WS-IDS WS-COUNT
     MOVE "test recipe-book REMOVE put of an empty list is 00" TO TL-CASE
     MOVE "00" TO TL-EXPECTED
     PERFORM CHECK-BYTES
     MOVE -1 TO WS-COUNT
     CALL "PB-PUT-RECIPE-BOOK-REMOVE" USING PB-BUFFER WS-IDS WS-COUNT
     MOVE "test recipe-book REMOVE put of count -1 sets PB-ERROR, appends nothing" TO TL-CASE
     PERFORM CHECK-PUT-ERROR
     MOVE 3 TO WS-COUNT
     MOVE -1 TO WS-ID(2)
     CALL "PB-PUT-RECIPE-BOOK-REMOVE" USING PB-BUFFER WS-IDS WS-COUNT
     MOVE "test recipe-book REMOVE put of display id -1 sets PB-ERROR, appends nothing"
