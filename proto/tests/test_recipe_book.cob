*>   ---- Settings (clientbound, four books) ----
     CALL "PB-RESET" USING PB-BUFFER
     INITIALIZE PB-RECIPE-BOOK-SETTINGS
     MOVE 1 TO PB-RBS-OPEN(1)
     MOVE 1 TO PB-RBS-FILTERING(2)
     MOVE 1 TO PB-RBS-OPEN(3)
     MOVE 1 TO PB-RBS-FILTERING(3)
     CALL "PB-PUT-RECIPE-BOOK-SETTINGS" USING PB-BUFFER PB-RECIPE-BOOK-SETTINGS
     MOVE "test recipe-book SETTINGS put of crafting open, furnace filtering, blast both"
         TO TL-CASE
     MOVE "0100000101010000" TO TL-EXPECTED
     PERFORM CHECK-BYTES
     MOVE "00 01 01 00 01 01 00 01" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-RECIPE-BOOK-SETTINGS" USING PB-BUFFER PB-RECIPE-BOOK-SETTINGS
     MOVE "test recipe-book SETTINGS get of eight Booleans" TO TL-CASE
     MOVE "0 1 1 0 1 1 0 1 pos 8 error 0" TO TL-EXPECTED
     PERFORM START-FIELDS
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > 4
         MOVE PB-RBS-OPEN(WS-J) TO WS-EDIT
         PERFORM ADD-FIELD
         MOVE PB-RBS-FILTERING(WS-J) TO WS-EDIT
         PERFORM ADD-FIELD
     END-PERFORM
     PERFORM END-FIELDS
     MOVE "00 01 01" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-RECIPE-BOOK-SETTINGS" USING PB-BUFFER PB-RECIPE-BOOK-SETTINGS
     MOVE "test recipe-book SETTINGS get cut short sets PB-ERROR, PB-POS 0, zeros" TO TL-CASE
     MOVE "0 0 0 0 0 0 0 0 pos 0 error 1" TO TL-EXPECTED
     PERFORM START-FIELDS
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > 4
         MOVE PB-RBS-OPEN(WS-J) TO WS-EDIT
         PERFORM ADD-FIELD
         MOVE PB-RBS-FILTERING(WS-J) TO WS-EDIT
         PERFORM ADD-FIELD
     END-PERFORM
     PERFORM END-FIELDS.

