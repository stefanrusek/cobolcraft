*> The put of the entry as it stands: PB-ERROR is expected. The caller names the case, then
*> CHECK-PUT-ERROR asserts PB-ERROR 1 and nothing appended.
 PUT-ENTRY-EXPECT-ERROR.
     CALL "PB-RESET" USING PB-BUFFER
     CALL "PB-PUT-RECIPE-ENTRY" USING PB-BUFFER PB-RECIPE-ENTRY PB-SLOT-DISPLAY-TABLE.

*> Decodes WS-HEX (a byte string ending the buffer) and asserts the all-zero failure result.
 GET-ENTRY-EXPECT-ERROR.
     PERFORM FILL
     CALL "PB-GET-RECIPE-ENTRY" USING PB-BUFFER PB-RECIPE-ENTRY PB-SLOT-DISPLAY-TABLE
     MOVE SPACES TO TL-EXPECTED
     STRING "E id=0 type=0 w=0 h=0 ing=0: res=0 st=0 dur=0 exp=0.00 grp=0 cat=0 req=0:0: "
         "flags=0 pos 0 error 1" DELIMITED BY SIZE INTO TL-EXPECTED
     PERFORM CHECK-ENTRY.

*> TL-OBSERVED: the entry's fields, each node of the table, then " pos <PB-POS> error <PB-ERROR>".
 CHECK-ENTRY.
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR
     MOVE PB-RE-DISPLAY-ID TO WS-EDIT
     STRING "E id=" FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE PB-RE-TYPE TO WS-EDIT
     STRING " type=" FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE PB-RE-WIDTH TO WS-EDIT
     STRING " w=" FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE PB-RE-HEIGHT TO WS-EDIT
     STRING " h=" FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE PB-RE-INGREDIENT-COUNT TO WS-EDIT
     STRING " ing=" FUNCTION TRIM(WS-EDIT) ":" DELIMITED BY SIZE INTO TL-OBSERVED
         WITH POINTER WS-PTR
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > PB-RE-INGREDIENT-COUNT
         IF WS-J > 1
             STRING "," DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
         END-IF
         MOVE PB-RE-INGREDIENT(WS-J) TO WS-EDIT
         STRING FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-PERFORM
     MOVE PB-RE-RESULT TO WS-EDIT
     STRING " res=" FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE PB-RE-STATION TO WS-EDIT
     STRING " st=" FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE PB-RE-DURATION TO WS-EDIT
     STRING " dur=" FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     COMPUTE WS-EXP-EDIT ROUNDED = PB-RE-EXPERIENCE
     STRING " exp=" FUNCTION TRIM(WS-EXP-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE PB-RE-GROUP TO WS-EDIT
     STRING " grp=" FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE PB-RE-CATEGORY TO WS-EDIT
     STRING " cat=" FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE PB-RE-REQ-PRESENT TO WS-EDIT
     STRING " req=" FUNCTION TRIM(WS-EDIT) ":" DELIMITED BY SIZE INTO TL-OBSERVED
         WITH POINTER WS-PTR
     MOVE PB-RE-REQ-COUNT TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) ":" DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > PB-RE-REQ-COUNT
         IF WS-J > 1
             STRING "," DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
         END-IF
         MOVE PB-RE-REQ-ITEM(WS-J) TO WS-EDIT
         STRING FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-PERFORM
     MOVE PB-RE-FLAGS TO WS-EDIT
     STRING " flags=" FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED
         WITH POINTER WS-PTR
     PERFORM VARYING WS-N FROM 1 BY 1 UNTIL WS-N > PB-SDT-COUNT
         PERFORM DESCRIBE-NODE
     END-PERFORM
     MOVE PB-POS TO WS-EDIT
     STRING " pos " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED
         WITH POINTER WS-PTR
     MOVE PB-ERROR TO WS-EDIT
     STRING " error " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED
         WITH POINTER WS-PTR
     MOVE "T" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

*> " | <n>:<type>,<item>,<count>,<component>,<A>,<B>,<list count>[,<list>...]" and for a tag
*> " tag=<text>", for a trim " trim=<asset>/<decal>".
 DESCRIBE-NODE.
     MOVE WS-N TO WS-EDIT
     STRING " | " FUNCTION TRIM(WS-EDIT) ":" DELIMITED BY SIZE INTO TL-OBSERVED
         WITH POINTER WS-PTR
     MOVE PB-SDN-TYPE(WS-N) TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE PB-SDN-ITEM(WS-N) TO WS-EDIT
     STRING "," FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE PB-SDN-COUNT(WS-N) TO WS-EDIT
     STRING "," FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE PB-SDN-COMPONENT(WS-N) TO WS-EDIT
     STRING "," FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE PB-SDN-CHILD-A(WS-N) TO WS-EDIT
     STRING "," FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE PB-SDN-CHILD-B(WS-N) TO WS-EDIT
     STRING "," FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE PB-SDN-LIST-COUNT(WS-N) TO WS-EDIT
     STRING "," FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > PB-SDN-LIST-COUNT(WS-N)
         MOVE PB-SDN-LIST(WS-N, WS-J) TO WS-EDIT
         STRING "," FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED
             WITH POINTER WS-PTR
     END-PERFORM
     MOVE PB-SDN-TAG-LENGTH(WS-N) TO WS-LEN
     IF WS-LEN > 0
         STRING " tag=" PB-SDN-TAG(WS-N)(1:WS-LEN) DELIMITED BY SIZE INTO TL-OBSERVED
             WITH POINTER WS-PTR
     END-IF
     MOVE PB-SDN-TRIM-LENGTH(WS-N) TO WS-LEN
     IF WS-LEN > 0
         STRING " trim=" PB-SDN-TRIM-ASSET(WS-N)(1:WS-LEN) "/" PB-SDN-TRIM-DECAL(WS-N)
             DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-IF.

*> PB-BUFFER (the decoded bytes) against PK-BUFFER (the re-encoded entry).
 CHECK-SAME-BYTES.
     CALL "TEST-BUFFER-HEX" USING PB-BUFFER WS-HEX
     CALL "TEST-BUFFER-HEX" USING PK-BUFFER WS-HEX-B
     MOVE "T" TO TL-MODE
     MOVE WS-HEX TO TL-EXPECTED
     MOVE WS-HEX-B TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

*> ---- field printers: TL-OBSERVED is the fields, then " pos <PB-POS> error <PB-ERROR>" ----
 START-FIELDS.
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR.

 ADD-FIELD.
     IF WS-PTR > 1
         STRING " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-IF
     STRING FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR.

 END-FIELDS.
     MOVE PB-POS TO WS-EDIT
     STRING " pos " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED
         WITH POINTER WS-PTR
     MOVE PB-ERROR TO WS-EDIT
     STRING " error " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED
         WITH POINTER WS-PTR
     MOVE "T" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

*> The buffer's bytes (hex) against TL-EXPECTED; the buffer is emptied afterwards.
 CHECK-BYTES.
     MOVE "T" TO TL-MODE
     CALL "TEST-BUFFER-HEX" USING PB-BUFFER TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "PB-RESET" USING PB-BUFFER.

*> PB-ERROR 1 and nothing appended.
 CHECK-PUT-ERROR.
     MOVE "N" TO TL-MODE
     MOVE 10 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PB-ERROR * 10 + PB-LENGTH
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "PB-RESET" USING PB-BUFFER.

 FILL.
     CALL "TEST-FILL-HEX" USING WS-HEX PB-BUFFER.
 END PROGRAM TEST-RECIPE-BOOK.
 COPY PROTOTEST.
