     MOVE 16 TO PB-SDN-TAG-LENGTH(1)
     MOVE PB-SDX-ITEM TO PB-SDN-TYPE(2)
     MOVE 62 TO PB-SDN-ITEM(2)
     MOVE PB-SDX-ITEM-STACK TO PB-SDN-TYPE(3)
     MOVE 1 TO PB-SDN-ITEM(3)
     MOVE 4 TO PB-SDN-COUNT(3)
     MOVE PB-SDX-EMPTY TO PB-SDN-TYPE(4)
     MOVE 0 TO PB-RE-DISPLAY-ID
     MOVE PB-RT-SHAPELESS TO PB-RE-TYPE
     MOVE 2 TO PB-RE-INGREDIENT-COUNT
     MOVE 1 TO PB-RE-INGREDIENT(1)
     MOVE 2 TO PB-RE-INGREDIENT(2)
     MOVE 3 TO PB-RE-RESULT
     MOVE 4 TO PB-RE-STATION
     MOVE 0 TO PB-RE-GROUP PB-RE-CATEGORY
     MOVE 1 TO PB-RE-REQ-PRESENT
