*>   the twelve RegistryId variants 21 to 32 carry ids 1 to 12
     PERFORM VARYING WS-I FROM 21 BY 1 UNTIL WS-I > 32
         PERFORM NEW-ENTRY
         MOVE WS-I TO PB-MX-INDEX PB-MX-SERIALIZER
         COMPUTE PB-MX-INT = WS-I - 20
         MOVE SPACES TO WS-NAME WS-WANT-HEX WS-WANT-DUMP
         MOVE WS-I TO WS-EDIT
         STRING "variant serializer " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO WS-NAME
         MOVE WS-I TO WS-VALUE
         PERFORM HEX-BYTE
         MOVE WS-HEX2 TO WS-WANT-HEX(1:2) WS-WANT-HEX(3:2)
         COMPUTE WS-VALUE = WS-I - 20
         PERFORM HEX-BYTE
         MOVE WS-HEX2 TO WS-WANT-HEX(5:2)
         MOVE 1 TO WS-PTR
         STRING FUNCTION TRIM(WS-EDIT) "." FUNCTION TRIM(WS-EDIT) "=" DELIMITED BY SIZE
             INTO WS-WANT-DUMP WITH POINTER WS-PTR
         MOVE PB-MX-INT TO WS-EDIT
         STRING FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO WS-WANT-DUMP WITH POINTER WS-PTR
         PERFORM ROUND-TRIP
     END-PERFORM
