     MOVE ALL "a" TO PB-MX-DATA(11:500)
     MOVE X"00" TO PB-MX-DATA(511:1)
     MOVE 511 TO PB-MX-DATA-LENGTH
     CALL "PB-RESET" USING PB-BUFFER
     CALL "PB-PUT-METADATA-ENTRY-X" USING PB-BUFFER PB-METADATA-ENTRY-X
     MOVE "test entity-metadata put of a 511-byte component is 513 bytes" TO TL-CASE
     MOVE PB-LENGTH TO TL-OBSERVED-N
     MOVE "N" TO TL-MODE
     MOVE 513 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "PB-GET-METADATA-ENTRY-X" USING PB-BUFFER PB-METADATA-ENTRY-X
     MOVE "test entity-metadata get of a 511-byte component reads it back" TO TL-CASE
     MOVE PB-MX-DATA-LENGTH TO TL-OBSERVED-N
     MOVE 511 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

