     MOVE 2 TO PB-MX-PRESENT
     MOVE "OPTIONAL_LIVING_ENTITY_REFERENCE present 2" TO WS-NAME
     PERFORM PUT-FAILS
     PERFORM NEW-ENTRY
     MOVE 6 TO PB-MX-SERIALIZER
     MOVE 2 TO PB-MX-PRESENT
     MOVE "OPTIONAL_COMPONENT present 2" TO WS-NAME
     PERFORM PUT-FAILS
     PERFORM NEW-ENTRY
     MOVE 6 TO PB-MX-SERIALIZER
     MOVE 3 TO PB-MX-DATA-LENGTH
     MOVE "OPTIONAL_COMPONENT absent with 3 data bytes" TO WS-NAME
     PERFORM PUT-FAILS
     PERFORM NEW-ENTRY
     MOVE 33 TO PB-MX-SERIALIZER
     MOVE 1 TO PB-MX-DATA-LENGTH
     MOVE "OPTIONAL_GLOBAL_POS absent with 1 data byte" TO WS-NAME
     PERFORM PUT-FAILS
     PERFORM NEW-ENTRY
     MOVE 5 TO PB-MX-SERIALIZER
     MOVE "COMPONENT without data" TO WS-NAME
     PERFORM PUT-FAILS
     PERFORM NEW-ENTRY
     MOVE 5 TO PB-MX-SERIALIZER
     MOVE FUNCTION HEX-TO-CHAR("0800016300") TO PB-MX-DATA(1:5)
     MOVE 5 TO PB-MX-DATA-LENGTH
     MOVE "COMPONENT with a trailing byte" TO WS-NAME
     PERFORM PUT-FAILS
     PERFORM NEW-ENTRY
     MOVE 5 TO PB-MX-SERIALIZER
     MOVE FUNCTION HEX-TO-CHAR("0800") TO PB-MX-DATA(1:2)
     MOVE 2 TO PB-MX-DATA-LENGTH
     MOVE "COMPONENT cut short" TO WS-NAME
     PERFORM PUT-FAILS
