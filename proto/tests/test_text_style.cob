*> Implementation test of the styled text component of proto/src/composites.cob (PB-PUT-TEXT and
*> PB-GET-TEXT with PB-TX-STYLED = 1; contract/copy/PROTO.cpy PB-TEXT). Command feedback is styled
*> (15 §4.6 and §10.4: red failures, a gray context line with a suggest_command click event, red
*> underlined rest, red italic <--[HERE]; §10.3 gray italic admin broadcast) and carries translation
*> arguments. The component keys are color, italic, underlined, click_event {action, command} and
*> extra (a List of Compounds {text or translate, color, italic, underlined}).
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-TEXT-STYLE.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY PROTO.
 COPY TESTLIB.
 01 WS-CAPACITY            BINARY-LONG VALUE 2048.
 01 WS-HEX                 PIC X(1024).
 01 WS-SAVED               PIC X(1024).
 01 WS-LIST-COUNT          BINARY-LONG.
 01 WS-LIST-TYPE           BINARY-LONG.
 01 WS-NO-NAME             PIC X VALUE SPACE.
 01 WS-ROOT                BINARY-LONG VALUE -2.
 01 WS-ELEMENT             BINARY-LONG VALUE -1.
 01 WS-LENGTH              BINARY-LONG.
 01 WS-ONE                 BINARY-LONG.
 PROCEDURE DIVISION.
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY

     INITIALIZE PB-TEXT
     MOVE PB-TEXT-LITERAL TO PB-TX-KIND
     MOVE "hi" TO PB-TX-VALUE
     MOVE 2 TO PB-TX-LENGTH
     MOVE 1 TO PB-TX-STYLED
     MOVE "red" TO PB-TX-COLOR
     CALL "PB-PUT-TEXT" USING PB-BUFFER PB-TEXT
     CALL "TEST-BUFFER-HEX" USING PB-BUFFER WS-HEX
     MOVE "test text style a literal with a color writes text then color" TO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE "0a0800047465787400026869080005636f6c6f72000372656400" TO TL-EXPECTED
     MOVE WS-HEX TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     CALL "PB-RESET" USING PB-BUFFER
     PERFORM BUILD-FULL
     CALL "PB-PUT-TEXT" USING PB-BUFFER PB-TEXT
     CALL "TEST-BUFFER-HEX" USING PB-BUFFER WS-HEX
     MOVE WS-HEX TO WS-SAVED
     MOVE "test text style a translate with an argument, style, click event and three extras "
         & "writes every key in order" TO TL-CASE
     MOVE "0a0800097472616e736c61746500036b2e78090004776974680800000001000176080005636f6c6f7200"
         & "04677261790100066974616c69630101000a756e6465726c696e6564010a000b636c69636b5f6576656e"
         & "74080006616374696f6e000f737567676573745f636f6d6d616e64080007636f6d6d616e6400052f6b69"
         & "6c6c0009000565787472610a000000030800047465787400026162080005636f6c6f7200046772617900"
         & "0800047465787400026364080005636f6c6f72000372656401000a756e6465726c696e65640100080009"
         & "7472616e736c6174650014636f6d6d616e642e636f6e746578742e68657265080005636f6c6f72000372"
         & "65640100066974616c6963010000" TO TL-EXPECTED
     MOVE WS-HEX TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     CALL "PB-GET-TEXT" USING PB-BUFFER PB-TEXT
     MOVE "test text style reading it back restores the argument, style, click event and extras"
         TO TL-CASE
     MOVE "N" TO TL-MODE
     MOVE 1000000 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF PB-ERROR = 0 AND PB-TX-STYLED = 1 AND PB-TX-COLOR = "gray" AND PB-TX-ITALIC = 1
             AND PB-TX-UNDERLINED = 1 AND PB-TX-CLICK-LENGTH = 5 AND PB-TX-CLICK(1:5) = "/kill"
             AND PB-TX-EXTRA-COUNT = 3 AND PB-TX-ARG-COUNT = 1 AND PB-TX-ARG-VALUE(1)(1:1) = "v"
             AND PB-TXE-KIND(1) = PB-TEXT-LITERAL AND PB-TXE-VALUE(1)(1:2) = "ab"
             AND PB-TXE-COLOR(1) = "gray" AND PB-TXE-UNDERLINED(2) = 1
             AND PB-TXE-COLOR(2) = "red" AND PB-TXE-KIND(3) = PB-TEXT-TRANSLATE
             AND PB-TXE-ITALIC(3) = 1 AND PB-TXE-LENGTH(3) = 20
         MOVE 1000000 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

*>   An unstyled component is read with the style fields cleared.
     CALL "PB-RESET" USING PB-BUFFER
     INITIALIZE PB-TEXT
     MOVE PB-TEXT-LITERAL TO PB-TX-KIND
     MOVE "plain" TO PB-TX-VALUE
     MOVE 5 TO PB-TX-LENGTH
     CALL "PB-PUT-TEXT" USING PB-BUFFER PB-TEXT
     CALL "TEST-BUFFER-HEX" USING PB-BUFFER WS-HEX
     MOVE "test text style an unstyled literal writes only its text" TO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE "0a080004746578740005706c61696e00" TO TL-EXPECTED
     MOVE WS-HEX TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 1 TO PB-TX-STYLED
     MOVE "gray" TO PB-TX-COLOR
     MOVE 1 TO PB-TX-EXTRA-COUNT
     CALL "PB-GET-TEXT" USING PB-BUFFER PB-TEXT
     MOVE "test text style a read of an unstyled component clears the style fields" TO TL-CASE
     MOVE "N" TO TL-MODE
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PB-TX-STYLED * 10 + PB-TX-EXTRA-COUNT + PB-ERROR
     IF PB-TX-COLOR NOT = SPACES
         ADD 100 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

*>   Reader limits: more than PB-TEXT-MAX-EXTRA extras, an extra that is not a compound, an extra
*>   with neither text nor translate.
     MOVE 9 TO WS-LIST-COUNT
     MOVE 10 TO WS-LIST-TYPE
     PERFORM BAD-EXTRA
     MOVE "test text style a list of nine extras sets PB-ERROR" TO TL-CASE
     PERFORM ASSERT-ERROR
     MOVE 1 TO WS-LIST-COUNT
     MOVE 8 TO WS-LIST-TYPE
     PERFORM BAD-EXTRA
     MOVE "test text style an extra that is a string sets PB-ERROR" TO TL-CASE
     PERFORM ASSERT-ERROR
     MOVE 1 TO WS-LIST-COUNT
     MOVE 10 TO WS-LIST-TYPE
     PERFORM BAD-EXTRA
     MOVE "test text style an extra compound with neither text nor translate sets PB-ERROR"
         TO TL-CASE
     PERFORM ASSERT-ERROR

*>   An unknown key inside an extra is skipped.
     CALL "PB-RESET" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WS-NO-NAME WS-ROOT
     MOVE 5 TO WS-LENGTH
     MOVE 10 TO WS-LIST-TYPE
     MOVE 1 TO WS-LIST-COUNT
     CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER "extra" WS-LENGTH WS-LIST-TYPE WS-LIST-COUNT
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WS-NO-NAME WS-ELEMENT
     MOVE 1 TO WS-LENGTH
     MOVE 7 TO WS-LIST-COUNT
     CALL "NBT-WRITE-INT" USING PB-BUFFER "x" WS-LENGTH WS-LIST-COUNT
     MOVE 4 TO WS-LENGTH
     MOVE 1 TO WS-ONE
     CALL "NBT-WRITE-STRING" USING PB-BUFFER "text" WS-LENGTH "t" WS-ONE
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE 4 TO WS-LENGTH
     CALL "NBT-WRITE-STRING" USING PB-BUFFER "text" WS-LENGTH "t" WS-ONE
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE 0 TO PB-ERROR
     CALL "PB-GET-TEXT" USING PB-BUFFER PB-TEXT
     MOVE "test text style an unknown key inside an extra is skipped" TO TL-CASE
     MOVE "N" TO TL-MODE
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PB-TX-EXTRA-COUNT + PB-ERROR
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     GOBACK.

 ASSERT-ERROR.
     MOVE "N" TO TL-MODE
     MOVE 1 TO TL-EXPECTED-N
     MOVE PB-ERROR TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

*> A text compound {text: "t", extra: <list of WS-LIST-COUNT elements of type WS-LIST-TYPE>}: a
*> string element is "e", a compound element is empty; then read with PB-GET-TEXT.
 BAD-EXTRA.
     CALL "PB-RESET" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WS-NO-NAME WS-ROOT
     MOVE 5 TO WS-LENGTH
     CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER "extra" WS-LENGTH WS-LIST-TYPE WS-LIST-COUNT
     IF WS-LIST-COUNT = 1
         IF WS-LIST-TYPE = 8
             MOVE 1 TO WS-LENGTH
             CALL "NBT-WRITE-STRING" USING PB-BUFFER WS-NO-NAME WS-ELEMENT "e" WS-LENGTH
         ELSE
             CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WS-NO-NAME WS-ELEMENT
             CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
         END-IF
     END-IF
     MOVE 4 TO WS-LENGTH
     MOVE 1 TO WS-ONE
     CALL "NBT-WRITE-STRING" USING PB-BUFFER "text" WS-LENGTH "t" WS-ONE
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE 0 TO PB-ERROR
     CALL "PB-GET-TEXT" USING PB-BUFFER PB-TEXT.

 BUILD-FULL.
     INITIALIZE PB-TEXT
     MOVE PB-TEXT-TRANSLATE TO PB-TX-KIND
     MOVE "k.x" TO PB-TX-VALUE
     MOVE 3 TO PB-TX-LENGTH
     MOVE 1 TO PB-TX-ARG-COUNT
     MOVE "v" TO PB-TX-ARG-VALUE(1)
     MOVE 1 TO PB-TX-ARG-LENGTH(1)
     MOVE 1 TO PB-TX-STYLED
     MOVE "gray" TO PB-TX-COLOR
     MOVE 1 TO PB-TX-ITALIC
     MOVE 1 TO PB-TX-UNDERLINED
     MOVE "/kill" TO PB-TX-CLICK
     MOVE 5 TO PB-TX-CLICK-LENGTH
     MOVE 3 TO PB-TX-EXTRA-COUNT
     MOVE PB-TEXT-LITERAL TO PB-TXE-KIND(1)
     MOVE "ab" TO PB-TXE-VALUE(1)
     MOVE 2 TO PB-TXE-LENGTH(1)
     MOVE "gray" TO PB-TXE-COLOR(1)
     MOVE PB-TEXT-LITERAL TO PB-TXE-KIND(2)
     MOVE "cd" TO PB-TXE-VALUE(2)
     MOVE 2 TO PB-TXE-LENGTH(2)
     MOVE "red" TO PB-TXE-COLOR(2)
     MOVE 1 TO PB-TXE-UNDERLINED(2)
     MOVE PB-TEXT-TRANSLATE TO PB-TXE-KIND(3)
     MOVE "command.context.here" TO PB-TXE-VALUE(3)
     MOVE 20 TO PB-TXE-LENGTH(3)
     MOVE "red" TO PB-TXE-COLOR(3)
     MOVE 1 TO PB-TXE-ITALIC(3).
 END PROGRAM TEST-TEXT-STYLE.
 COPY PROTOTEST.
