*> Implementation test of proto/src/scalars.cob and proto/src/buffer.cob: truncation of out-of-range
*> writer inputs, dropped high VarInt bits (00 §2.1), field limits of 00 §4.1, identifier edge cases
*> (00 §3.2), capacity checks and the sticky PB-ERROR.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-SCALARS.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY PROTO.
 COPY TESTLIB.
 01 WS-CAPACITY            BINARY-LONG VALUE 64.
 01 WS-HEX                 PIC X(1024).
 01 WS-INT                 BINARY-LONG.
 01 WS-INT2                BINARY-LONG.
 01 WS-INT3                BINARY-LONG.
 01 WS-LONG                BINARY-DOUBLE.
 01 WS-LEN                 BINARY-LONG.
 01 WS-MAX                 BINARY-LONG.
 01 WS-CAP                 BINARY-LONG.
 01 WS-TEXT                PIC X(64).
 01 WS-LONGS.
    05 WS-LONG-ITEM        BINARY-DOUBLE OCCURS 2 TIMES.
 01 WS-BITS                PIC X(4).
 01 WS-EDIT                PIC -(19)9.
 01 WS-PTR                 BINARY-LONG.
 01 WS-NUM                 BINARY-DOUBLE.
 PROCEDURE DIVISION.
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
*>   Writers keep the low bits of out-of-range values; BOOL writes 1 for any non-zero value.
     MOVE 5 TO WS-INT
     CALL "PB-PUT-BOOL" USING PB-BUFFER WS-INT
     MOVE -3 TO WS-INT
     CALL "PB-PUT-BOOL" USING PB-BUFFER WS-INT
     MOVE 300 TO WS-INT
     CALL "PB-PUT-BYTE" USING PB-BUFFER WS-INT
     MOVE -1 TO WS-INT
     CALL "PB-PUT-UBYTE" USING PB-BUFFER WS-INT
     MOVE 70000 TO WS-INT
     CALL "PB-PUT-SHORT" USING PB-BUFFER WS-INT
     MOVE -1 TO WS-INT
     CALL "PB-PUT-USHORT" USING PB-BUFFER WS-INT
     MOVE "test scalars BOOL 5 -3, BYTE 300, UBYTE -1, SHORT 70000, USHORT -1 keep the low bits"
         TO TL-CASE
     MOVE "01012cff1170ffff" TO WS-HEX
     PERFORM CHECK-BUFFER
*>   00 §2.1: bits beyond 32 (VarInt) or 64 (VarLong) in the last byte are dropped.
     MOVE "ffffffff7f ffffffffffffffffff7f" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-VARINT" USING PB-BUFFER WS-INT
     CALL "PB-GET-VARLONG" USING PB-BUFFER WS-LONG
     MOVE "test scalars VARINT ffffffff7f and VARLONG ffffffffffffffffff7f are -1" TO TL-CASE
     MOVE "-1 -1 0" TO TL-EXPECTED
     PERFORM START-TEXT
     MOVE WS-INT TO WS-NUM
     PERFORM ADD-NUMBER
     MOVE WS-LONG TO WS-NUM
     PERFORM ADD-NUMBER
     MOVE PB-ERROR TO WS-NUM
     PERFORM ADD-NUMBER
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   00 §4.1 field limits round trip.
     CALL "PB-RESET" USING PB-BUFFER
     MOVE 33554431 TO WS-INT
     MOVE 2047 TO WS-INT2
     MOVE -33554432 TO WS-INT3
     CALL "PB-PUT-POSITION" USING PB-BUFFER WS-INT WS-INT2 WS-INT3
     MOVE -33554432 TO WS-INT
     MOVE -2048 TO WS-INT2
     MOVE 33554431 TO WS-INT3
     CALL "PB-PUT-POSITION" USING PB-BUFFER WS-INT WS-INT2 WS-INT3
     CALL "PB-GET-POSITION" USING PB-BUFFER WS-INT WS-INT2 WS-INT3
     MOVE "test scalars POSITION (33554431 2047 -33554432) round trip" TO TL-CASE
     MOVE "33554431 2047 -33554432" TO TL-EXPECTED
     PERFORM POSITION-TEXT
     CALL "PB-GET-POSITION" USING PB-BUFFER WS-INT WS-INT2 WS-INT3
     MOVE "test scalars POSITION (-33554432 -2048 33554431) round trip" TO TL-CASE
     MOVE "-33554432 -2048 33554431" TO TL-EXPECTED
     PERFORM POSITION-TEXT
*>   00 §3.2: no ":" means namespace minecraft and the whole string is the path; an empty
*>   namespace before ":" is allowed; the empty string is a valid identifier.
     CALL "PB-RESET" USING PB-BUFFER
     MOVE ":a/b" TO WS-TEXT
     MOVE 4 TO WS-LEN
     CALL "PB-PUT-IDENTIFIER" USING PB-BUFFER WS-TEXT WS-LEN
     MOVE 0 TO WS-LEN
     CALL "PB-PUT-IDENTIFIER" USING PB-BUFFER WS-TEXT WS-LEN
     MOVE "test scalars IDENTIFIER :a/b and the empty identifier are valid" TO TL-CASE
     MOVE "043a612f6200" TO WS-HEX
     PERFORM CHECK-BUFFER
     MOVE "02 6121" TO WS-HEX
     PERFORM FILL
     MOVE 64 TO WS-CAP
     CALL "PB-GET-IDENTIFIER" USING PB-BUFFER WS-TEXT WS-CAP WS-LEN
     MOVE "test scalars IDENTIFIER get of a! sets PB-ERROR" TO TL-CASE
     PERFORM CHECK-READ-ERROR
*>   Capacity checks.
     MOVE "05 68656c6c6f" TO WS-HEX
     PERFORM FILL
     MOVE 255 TO WS-MAX
     MOVE 4 TO WS-CAP
     CALL "PB-GET-STRING" USING PB-BUFFER WS-MAX WS-TEXT WS-CAP WS-LEN
     MOVE "test scalars STRING get longer than the capacity sets PB-ERROR" TO TL-CASE
     PERFORM CHECK-READ-ERROR
     CALL "PB-RESET" USING PB-BUFFER
     MOVE -1 TO WS-LEN
     CALL "PB-PUT-STRING" USING PB-BUFFER WS-TEXT WS-LEN WS-MAX
     MOVE "test scalars STRING put of a negative length sets PB-ERROR" TO TL-CASE
     MOVE "N" TO TL-MODE
     MOVE 10 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PB-ERROR * 10 + PB-LENGTH
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "02 0000000000000001 0000000000000002" TO WS-HEX
     PERFORM FILL
     MOVE 1 TO WS-CAP
     CALL "PB-GET-BITSET" USING PB-BUFFER WS-CAP WS-LEN WS-LONGS
     MOVE "test scalars BITSET get of more Longs than the capacity sets PB-ERROR" TO TL-CASE
     PERFORM CHECK-READ-ERROR
     CALL "PB-RESET" USING PB-BUFFER
     MOVE 0 TO WS-INT
     CALL "PB-PUT-FIXED-BITSET" USING PB-BUFFER WS-INT WS-BITS
     MOVE 8 TO WS-INT
     MOVE FUNCTION HEX-TO-CHAR("FF") TO WS-BITS
     CALL "PB-PUT-FIXED-BITSET" USING PB-BUFFER WS-INT WS-BITS
     MOVE "test scalars FIXED-BITSET n=0 writes nothing, n=8 allows all 8 bits" TO TL-CASE
     MOVE "ff" TO WS-HEX
     PERFORM CHECK-BUFFER
*>   PB-ERROR is sticky: once set, reads yield 0 even when data remains.
     MOVE "01 00000007" TO WS-HEX
     PERFORM FILL
     MOVE 1 TO PB-ERROR
     CALL "PB-GET-INT" USING PB-BUFFER WS-INT
     MOVE "test scalars INT get after PB-ERROR yields 0 and keeps PB-POS" TO TL-CASE
     MOVE "N" TO TL-MODE
     MOVE 10 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PB-ERROR * 10 + PB-POS + WS-INT
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "PB-FREE" USING PB-BUFFER
     STOP RUN.

 FILL.
     CALL "TEST-FILL-HEX" USING WS-HEX PB-BUFFER.

 CHECK-BUFFER.
     MOVE "T" TO TL-MODE
     MOVE WS-HEX TO TL-EXPECTED
     CALL "TEST-BUFFER-HEX" USING PB-BUFFER TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

*> PB-ERROR 1, PB-POS back at 0, length or count 0.
 CHECK-READ-ERROR.
     MOVE "N" TO TL-MODE
     MOVE 100 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PB-ERROR * 100 + PB-POS * 10 + WS-LEN
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 POSITION-TEXT.
     PERFORM START-TEXT
     MOVE WS-INT TO WS-NUM
     PERFORM ADD-NUMBER
     MOVE WS-INT2 TO WS-NUM
     PERFORM ADD-NUMBER
     MOVE WS-INT3 TO WS-NUM
     PERFORM ADD-NUMBER
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 START-TEXT.
     MOVE "T" TO TL-MODE
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR.

 ADD-NUMBER.
     MOVE WS-NUM TO WS-EDIT
     IF WS-PTR > 1
         STRING " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-IF
     STRING FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR.
 END PROGRAM TEST-SCALARS.
 COPY PROTOTEST.
