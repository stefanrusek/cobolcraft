*> Implementation test of proto/src/registry-tags.cob: the Registry Data packet (docs/protocol/
*> 04-registry-sync.md, configuration 0x07: registry identifier, entries of identifier and optional
*> network NBT) and the Update Tags packet (0x0E and play 0x89: registries of tags of numeric ids).
*> The packet id is the caller's; the entry and tag programs are called once per entry or tag after the
*> head. Expected bytes are the field tables of 04 written out by hand.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-REGISTRY-TAGS.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY PROTO.
 COPY TESTLIB.
 01 WS-CAPACITY            BINARY-LONG VALUE 64.
 01 WS-EDIT                PIC -(9)9.
 01 WS-PTR                 BINARY-LONG.
 01 WS-N                   BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-J                   BINARY-LONG.
 01 WS-LABEL               PIC X(120).
 01 WS-EXPECT              PIC X(1024).
 01 WS-NAME                PIC X(64).
 01 WS-NAME-LEN            BINARY-LONG.
 01 WS-COUNT               BINARY-LONG.
 01 WS-PRESENT             BINARY-LONG.
 01 WS-DATA                PIC X(512).
 01 WS-DATA-LEN            BINARY-LONG.
 01 WO-NAME                PIC X(64).
 01 WO-NAME-LEN            BINARY-LONG.
 01 WO-COUNT               BINARY-LONG.
 01 WO-PRESENT             BINARY-LONG.
 01 WO-DATA                PIC X(512).
 01 WO-DATA-LEN            BINARY-LONG.
 01 WS-NAME-CAP            BINARY-LONG VALUE 64.
 01 WS-DATA-CAP            BINARY-LONG VALUE 512.
 01 WS-ID-CAP              BINARY-LONG VALUE 8.
 01 WS-IDS.
    05 WS-ID               BINARY-LONG OCCURS 8 TIMES.
 01 WO-IDS.
    05 WO-ID               BINARY-LONG OCCURS 8 TIMES.
 01 WS-HEX                 PIC X(1024).
 PROCEDURE DIVISION.
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     PERFORM REGISTRY-HEAD-CASES
     PERFORM REGISTRY-ENTRY-CASES
     PERFORM REGISTRY-ERROR-CASES
     PERFORM TAGS-CASES
     PERFORM TAGS-ERROR-CASES
     CALL "PB-FREE" USING PB-BUFFER
     STOP RUN.

*> ---- Registry Data: registry identifier and the entry count ----
 REGISTRY-HEAD-CASES.
     MOVE "head: minecraft:world_clock with 1 entry" TO WS-LABEL
     MOVE "minecraft:world_clock" TO WS-NAME
     MOVE 21 TO WS-NAME-LEN
     MOVE 1 TO WS-COUNT
     CALL "PB-RESET" USING PB-BUFFER
     CALL "PB-PUT-REGISTRY-DATA-HEAD" USING PB-BUFFER WS-NAME WS-NAME-LEN WS-COUNT
     MOVE SPACES TO WS-EXPECT
     STRING "15" FUNCTION LOWER-CASE(FUNCTION HEX-OF(WS-NAME(1:21))) "01" DELIMITED BY SIZE
         INTO WS-EXPECT
     PERFORM CHECK-BYTES
     MOVE "head: read back" TO WS-LABEL
     MOVE 0 TO PB-POS
     MOVE SPACES TO WO-NAME
     CALL "PB-GET-REGISTRY-DATA-HEAD" USING PB-BUFFER WO-NAME WS-NAME-CAP WO-NAME-LEN WO-COUNT
     PERFORM START-OBSERVED
     MOVE PB-ERROR TO WS-N
     PERFORM ADD-NUMBER
     COMPUTE WS-N = PB-LENGTH - PB-POS
     PERFORM ADD-NUMBER
     MOVE WO-NAME-LEN TO WS-N
     PERFORM ADD-NUMBER
     MOVE WO-COUNT TO WS-N
     PERFORM ADD-NUMBER
     STRING " " WO-NAME(1:WO-NAME-LEN) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE "0 0 21 1 minecraft:world_clock" TO TL-EXPECTED
     PERFORM ASSERT-OBSERVED
     MOVE "head: 300 entries is a two-byte VarInt" TO WS-LABEL
     MOVE "minecraft:chat_type" TO WS-NAME
     MOVE 19 TO WS-NAME-LEN
     MOVE 300 TO WS-COUNT
     CALL "PB-RESET" USING PB-BUFFER
     CALL "PB-PUT-REGISTRY-DATA-HEAD" USING PB-BUFFER WS-NAME WS-NAME-LEN WS-COUNT
     MOVE SPACES TO WS-EXPECT
     STRING "13" FUNCTION LOWER-CASE(FUNCTION HEX-OF(WS-NAME(1:19))) "ac02" DELIMITED BY SIZE
         INTO WS-EXPECT
     PERFORM CHECK-BYTES
     MOVE 0 TO PB-POS
     CALL "PB-GET-REGISTRY-DATA-HEAD" USING PB-BUFFER WO-NAME WS-NAME-CAP WO-NAME-LEN WO-COUNT
     MOVE "head: 300 entries read back" TO WS-LABEL
     MOVE WO-COUNT TO WS-N
     PERFORM OBSERVE-NUMBER
     MOVE "300" TO TL-EXPECTED
     PERFORM ASSERT-OBSERVED
     MOVE "head: a registry identifier with an upper-case letter is rejected" TO WS-LABEL
     MOVE "Minecraft:x" TO WS-NAME
     MOVE 11 TO WS-NAME-LEN
     CALL "PB-RESET" USING PB-BUFFER
     CALL "PB-PUT-REGISTRY-DATA-HEAD" USING PB-BUFFER WS-NAME WS-NAME-LEN WS-COUNT
     PERFORM OBSERVE-ERROR-LENGTH
     MOVE "1 0" TO TL-EXPECTED
     PERFORM ASSERT-OBSERVED
     MOVE "head: a negative entry count is rejected" TO WS-LABEL
     MOVE "minecraft:block" TO WS-NAME
     MOVE 15 TO WS-NAME-LEN
     MOVE -1 TO WS-COUNT
     CALL "PB-RESET" USING PB-BUFFER
     CALL "PB-PUT-REGISTRY-DATA-HEAD" USING PB-BUFFER WS-NAME WS-NAME-LEN WS-COUNT
     PERFORM OBSERVE-ERROR-LENGTH
     MOVE "1 0" TO TL-EXPECTED
     PERFORM ASSERT-OBSERVED
     MOVE "head read: invalid identifier" TO WS-LABEL
     MOVE "0b4d696e6563726166743a78" & "01" TO WS-HEX
     PERFORM FILL
     PERFORM HEAD-REJECTED
     MOVE "head read: negative count" TO WS-LABEL
     MOVE "0f" & "6d696e6563726166743a626c6f636b" & "ffffffff0f" TO WS-HEX
     PERFORM FILL
     PERFORM HEAD-REJECTED
     MOVE "head read: no count" TO WS-LABEL
     MOVE "0f" & "6d696e6563726166743a626c6f636b" TO WS-HEX
     PERFORM FILL
     PERFORM HEAD-REJECTED
     MOVE "head read: name longer than the capacity" TO WS-LABEL
     MOVE "0f" & "6d696e6563726166743a626c6f636b" & "01" TO WS-HEX
     PERFORM FILL
     MOVE 8 TO WS-NAME-CAP
     PERFORM HEAD-REJECTED
     MOVE 64 TO WS-NAME-CAP.

 HEAD-REJECTED.
     MOVE 0 TO PB-POS
     MOVE 77 TO WO-COUNT
     CALL "PB-GET-REGISTRY-DATA-HEAD" USING PB-BUFFER WO-NAME WS-NAME-CAP WO-NAME-LEN WO-COUNT
     PERFORM START-OBSERVED
     MOVE PB-ERROR TO WS-N
     PERFORM ADD-NUMBER
     MOVE PB-POS TO WS-N
     PERFORM ADD-NUMBER
     MOVE WO-NAME-LEN TO WS-N
     PERFORM ADD-NUMBER
     MOVE WO-COUNT TO WS-N
     PERFORM ADD-NUMBER
     MOVE "1 0 0 0" TO TL-EXPECTED
     PERFORM ASSERT-OBSERVED.

*> ---- Registry Data entries: identifier, present flag, the network NBT bytes verbatim ----
 REGISTRY-ENTRY-CASES.
     MOVE "entry: cobolcraft:daylight with an empty compound" TO WS-LABEL
     MOVE "cobolcraft:daylight" TO WS-NAME
     MOVE 19 TO WS-NAME-LEN
     MOVE 1 TO WS-PRESENT
     MOVE X"0a00" TO WS-DATA(1:2)
     MOVE 2 TO WS-DATA-LEN
     PERFORM ENTRY-ROUND-TRIP
     MOVE SPACES TO WS-EXPECT
     STRING "13" FUNCTION LOWER-CASE(FUNCTION HEX-OF(WS-NAME(1:19))) "01" "0a00"
         DELIMITED BY SIZE INTO WS-EXPECT
     PERFORM CHECK-BYTES-AFTER-PUT
     MOVE "entry: minecraft:plains without data (the client knows it from a pack)" TO WS-LABEL
     MOVE "minecraft:plains" TO WS-NAME
     MOVE 16 TO WS-NAME-LEN
     MOVE 0 TO WS-PRESENT WS-DATA-LEN
     PERFORM ENTRY-ROUND-TRIP
     MOVE SPACES TO WS-EXPECT
     STRING "10" FUNCTION LOWER-CASE(FUNCTION HEX-OF(WS-NAME(1:16))) "00"
         DELIMITED BY SIZE INTO WS-EXPECT
     PERFORM CHECK-BYTES-AFTER-PUT
     MOVE "entry: a String root tag is any tag too" TO WS-LABEL
     MOVE "minecraft:x" TO WS-NAME
     MOVE 11 TO WS-NAME-LEN
     MOVE 1 TO WS-PRESENT
     MOVE X"080003616263" TO WS-DATA(1:6)
     MOVE 6 TO WS-DATA-LEN
     PERFORM ENTRY-ROUND-TRIP
     MOVE SPACES TO WS-EXPECT
     STRING "0b" FUNCTION LOWER-CASE(FUNCTION HEX-OF(WS-NAME(1:11))) "01" "080003616263"
         DELIMITED BY SIZE INTO WS-EXPECT
     PERFORM CHECK-BYTES-AFTER-PUT
     MOVE "entry: a compound with a list of two Strings round trips as 17 bytes" TO WS-LABEL
     MOVE "minecraft:y" TO WS-NAME
     MOVE 1 TO WS-PRESENT
     MOVE X"0a09000178080000000200016100016200" TO WS-DATA(1:17)
     MOVE 17 TO WS-DATA-LEN
     PERFORM ENTRY-ROUND-TRIP
     MOVE SPACES TO WS-EXPECT
     STRING "0b" FUNCTION LOWER-CASE(FUNCTION HEX-OF(WS-NAME(1:11))) "01"
         "0a09000178080000000200016100016200" DELIMITED BY SIZE INTO WS-EXPECT
     PERFORM CHECK-BYTES-AFTER-PUT
     MOVE "entry: two entries one after the other read in order" TO WS-LABEL
     CALL "PB-RESET" USING PB-BUFFER
     MOVE "minecraft:a" TO WS-NAME
     MOVE 11 TO WS-NAME-LEN
     MOVE 1 TO WS-PRESENT
     MOVE X"0a00" TO WS-DATA(1:2)
     MOVE 2 TO WS-DATA-LEN
     CALL "PB-PUT-REGISTRY-ENTRY" USING PB-BUFFER WS-NAME WS-NAME-LEN WS-PRESENT WS-DATA
         WS-DATA-LEN
     MOVE "minecraft:b" TO WS-NAME
     MOVE 0 TO WS-PRESENT WS-DATA-LEN
     CALL "PB-PUT-REGISTRY-ENTRY" USING PB-BUFFER WS-NAME WS-NAME-LEN WS-PRESENT WS-DATA
         WS-DATA-LEN
     MOVE 0 TO PB-POS
     CALL "PB-GET-REGISTRY-ENTRY" USING PB-BUFFER WO-NAME WS-NAME-CAP WO-NAME-LEN WO-PRESENT
         WO-DATA WS-DATA-CAP WO-DATA-LEN
     PERFORM START-OBSERVED
     MOVE WO-PRESENT TO WS-N
     PERFORM ADD-NUMBER
     MOVE WO-DATA-LEN TO WS-N
     PERFORM ADD-NUMBER
     STRING " " WO-NAME(1:WO-NAME-LEN) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     CALL "PB-GET-REGISTRY-ENTRY" USING PB-BUFFER WO-NAME WS-NAME-CAP WO-NAME-LEN WO-PRESENT
         WO-DATA WS-DATA-CAP WO-DATA-LEN
     MOVE WO-PRESENT TO WS-N
     PERFORM ADD-NUMBER
     MOVE WO-DATA-LEN TO WS-N
     PERFORM ADD-NUMBER
     STRING " " WO-NAME(1:WO-NAME-LEN) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE PB-ERROR TO WS-N
     PERFORM ADD-NUMBER
     COMPUTE WS-N = PB-LENGTH - PB-POS
     PERFORM ADD-NUMBER
     MOVE "1 2 minecraft:a 0 0 minecraft:b 0 0" TO TL-EXPECTED
     PERFORM ASSERT-OBSERVED.

*> Writes the entry of WS-NAME/WS-PRESENT/WS-DATA, reads it back and asserts the fields come back.
 ENTRY-ROUND-TRIP.
     CALL "PB-RESET" USING PB-BUFFER
     CALL "PB-PUT-REGISTRY-ENTRY" USING PB-BUFFER WS-NAME WS-NAME-LEN WS-PRESENT WS-DATA
         WS-DATA-LEN
     MOVE PB-LENGTH TO WS-I
     MOVE 0 TO PB-POS
     MOVE SPACES TO WO-NAME WO-DATA
     CALL "PB-GET-REGISTRY-ENTRY" USING PB-BUFFER WO-NAME WS-NAME-CAP WO-NAME-LEN WO-PRESENT
         WO-DATA WS-DATA-CAP WO-DATA-LEN
     MOVE "T" TO TL-MODE
     MOVE SPACES TO TL-CASE
     STRING "test registry-tags " FUNCTION TRIM(WS-LABEL) ": read back" DELIMITED BY SIZE
         INTO TL-CASE
     PERFORM START-OBSERVED
     MOVE PB-ERROR TO WS-N
     PERFORM ADD-NUMBER
     COMPUTE WS-N = PB-LENGTH - PB-POS
     PERFORM ADD-NUMBER
     MOVE WO-PRESENT TO WS-N
     PERFORM ADD-NUMBER
     MOVE WO-DATA-LEN TO WS-N
     PERFORM ADD-NUMBER
     MOVE 0 TO WS-N
     IF WO-NAME(1:WO-NAME-LEN) = WS-NAME(1:WS-NAME-LEN) AND WO-NAME-LEN = WS-NAME-LEN
         MOVE 1 TO WS-N
     END-IF
     PERFORM ADD-NUMBER
     MOVE 1 TO WS-N
     IF WS-DATA-LEN > 0
         IF WO-DATA(1:WS-DATA-LEN) NOT = WS-DATA(1:WS-DATA-LEN)
             MOVE 0 TO WS-N
         END-IF
     END-IF
     PERFORM ADD-NUMBER
     MOVE SPACES TO TL-EXPECTED
     MOVE 1 TO WS-J
     MOVE WS-PRESENT TO WS-EDIT
     STRING "0 0 " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-EXPECTED WITH POINTER WS-J
     MOVE WS-DATA-LEN TO WS-EDIT
     STRING " " FUNCTION TRIM(WS-EDIT) " 1 1" DELIMITED BY SIZE INTO TL-EXPECTED
         WITH POINTER WS-J
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 REGISTRY-ERROR-CASES.
     MOVE "minecraft:x" TO WS-NAME
     MOVE 11 TO WS-NAME-LEN
     MOVE 1 TO WS-PRESENT
     MOVE X"0a00" TO WS-DATA(1:2)
     MOVE 2 TO WS-DATA-LEN
     MOVE "entry put: upper-case identifier" TO WS-LABEL
     MOVE "Minecraft:x" TO WS-NAME
     PERFORM ENTRY-PUT-REJECTED
     MOVE "minecraft:x" TO WS-NAME
     MOVE "entry put: present flag 2" TO WS-LABEL
     MOVE 2 TO WS-PRESENT
     PERFORM ENTRY-PUT-REJECTED
     MOVE 1 TO WS-PRESENT
     MOVE "entry put: present with no data bytes" TO WS-LABEL
     MOVE 0 TO WS-DATA-LEN
     PERFORM ENTRY-PUT-REJECTED
     MOVE "entry put: present with a negative length" TO WS-LABEL
     MOVE -1 TO WS-DATA-LEN
     PERFORM ENTRY-PUT-REJECTED
     MOVE "entry put: root tag End" TO WS-LABEL
     MOVE X"00" TO WS-DATA(1:1)
     MOVE 1 TO WS-DATA-LEN
     PERFORM ENTRY-PUT-REJECTED
     MOVE "entry put: a stray byte after the compound" TO WS-LABEL
     MOVE X"0a0000" TO WS-DATA(1:3)
     MOVE 3 TO WS-DATA-LEN
     PERFORM ENTRY-PUT-REJECTED
     MOVE "entry put: compound cut short" TO WS-LABEL
     MOVE X"0a09" TO WS-DATA(1:2)
     MOVE 2 TO WS-DATA-LEN
     PERFORM ENTRY-PUT-REJECTED
     MOVE "entry put: unknown tag type 13" TO WS-LABEL
     MOVE X"0d" TO WS-DATA(1:1)
     MOVE 1 TO WS-DATA-LEN
     PERFORM ENTRY-PUT-REJECTED
     MOVE "entry read: upper-case identifier" TO WS-LABEL
     MOVE "0b4d696e6563726166743a7800" TO WS-HEX
     PERFORM FILL
     PERFORM ENTRY-GET-REJECTED
     MOVE "entry read: root tag End" TO WS-LABEL
     MOVE "0b" & "6d696e6563726166743a78" & "0100" TO WS-HEX
     PERFORM FILL
     PERFORM ENTRY-GET-REJECTED
     MOVE "entry read: compound cut short" TO WS-LABEL
     MOVE "0b" & "6d696e6563726166743a78" & "010a09" TO WS-HEX
     PERFORM FILL
     PERFORM ENTRY-GET-REJECTED
     MOVE "entry read: no present flag" TO WS-LABEL
     MOVE "0b" & "6d696e6563726166743a78" TO WS-HEX
     PERFORM FILL
     PERFORM ENTRY-GET-REJECTED
     MOVE "entry read: data longer than the capacity" TO WS-LABEL
     MOVE "0b" & "6d696e6563726166743a78" & "010a00" TO WS-HEX
     PERFORM FILL
     MOVE 1 TO WS-DATA-CAP
     PERFORM ENTRY-GET-REJECTED
     MOVE 512 TO WS-DATA-CAP
     MOVE "entry read: name longer than the capacity" TO WS-LABEL
     MOVE 4 TO WS-NAME-CAP
     PERFORM ENTRY-GET-REJECTED
     MOVE 64 TO WS-NAME-CAP.

 ENTRY-PUT-REJECTED.
     CALL "PB-RESET" USING PB-BUFFER
     CALL "PB-PUT-REGISTRY-ENTRY" USING PB-BUFFER WS-NAME WS-NAME-LEN WS-PRESENT WS-DATA
         WS-DATA-LEN
     MOVE SPACES TO TL-CASE
     STRING "test registry-tags " FUNCTION TRIM(WS-LABEL) DELIMITED BY SIZE INTO TL-CASE
     PERFORM OBSERVE-ERROR-LENGTH
     MOVE "1 0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 ENTRY-GET-REJECTED.
     MOVE 0 TO PB-POS
     MOVE 77 TO WO-DATA-LEN WO-PRESENT
     CALL "PB-GET-REGISTRY-ENTRY" USING PB-BUFFER WO-NAME WS-NAME-CAP WO-NAME-LEN WO-PRESENT
         WO-DATA WS-DATA-CAP WO-DATA-LEN
     MOVE SPACES TO TL-CASE
     STRING "test registry-tags " FUNCTION TRIM(WS-LABEL) DELIMITED BY SIZE INTO TL-CASE
     PERFORM START-OBSERVED
     MOVE PB-ERROR TO WS-N
     PERFORM ADD-NUMBER
     MOVE PB-POS TO WS-N
     PERFORM ADD-NUMBER
     MOVE WO-NAME-LEN TO WS-N
     PERFORM ADD-NUMBER
     MOVE WO-PRESENT TO WS-N
     PERFORM ADD-NUMBER
     MOVE WO-DATA-LEN TO WS-N
     PERFORM ADD-NUMBER
     MOVE "1 0 0 0 0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

*> ---- Update Tags: registries of tags of numeric ids ----
 TAGS-CASES.
     MOVE "tags: the standard example of three registries" TO WS-LABEL
     CALL "PB-RESET" USING PB-BUFFER
     MOVE 3 TO WS-COUNT
     CALL "PB-PUT-TAGS-HEAD" USING PB-BUFFER WS-COUNT
     MOVE "minecraft:block" TO WS-NAME
     MOVE 15 TO WS-NAME-LEN
     MOVE 2 TO WS-COUNT
     CALL "PB-PUT-TAG-REGISTRY-HEAD" USING PB-BUFFER WS-NAME WS-NAME-LEN WS-COUNT
     MOVE "minecraft:planks" TO WS-NAME
     MOVE 16 TO WS-NAME-LEN
     MOVE 13 TO WS-ID(1)
     MOVE 1 TO WS-COUNT
     CALL "PB-PUT-TAG" USING PB-BUFFER WS-NAME WS-NAME-LEN WS-IDS WS-COUNT
     MOVE "minecraft:base_stone_overworld" TO WS-NAME
     MOVE 30 TO WS-NAME-LEN
     MOVE 1 TO WS-ID(1)
     MOVE 12 TO WS-ID(2)
     MOVE 2 TO WS-COUNT
     CALL "PB-PUT-TAG" USING PB-BUFFER WS-NAME WS-NAME-LEN WS-IDS WS-COUNT
     MOVE "minecraft:item" TO WS-NAME
     MOVE 14 TO WS-NAME-LEN
     MOVE 0 TO WS-COUNT
     MOVE 1 TO WS-COUNT
     CALL "PB-PUT-TAG-REGISTRY-HEAD" USING PB-BUFFER WS-NAME WS-NAME-LEN WS-COUNT
     MOVE "minecraft:planks" TO WS-NAME
     MOVE 16 TO WS-NAME-LEN
     MOVE 300 TO WS-ID(1)
     MOVE 1 TO WS-COUNT
     CALL "PB-PUT-TAG" USING PB-BUFFER WS-NAME WS-NAME-LEN WS-IDS WS-COUNT
     MOVE "minecraft:dimension_type" TO WS-NAME
     MOVE 24 TO WS-NAME-LEN
     MOVE 1 TO WS-COUNT
     CALL "PB-PUT-TAG-REGISTRY-HEAD" USING PB-BUFFER WS-NAME WS-NAME-LEN WS-COUNT
     MOVE "minecraft:in_overworld" TO WS-NAME
     MOVE 22 TO WS-NAME-LEN
     MOVE 0 TO WS-COUNT
     CALL "PB-PUT-TAG" USING PB-BUFFER WS-NAME WS-NAME-LEN WS-IDS WS-COUNT
     MOVE SPACES TO WS-EXPECT
     STRING "03" "0f" FUNCTION LOWER-CASE(FUNCTION HEX-OF("minecraft:block")) "02"
         "10" FUNCTION LOWER-CASE(FUNCTION HEX-OF("minecraft:planks")) "010d"
         "1e" FUNCTION LOWER-CASE(FUNCTION HEX-OF("minecraft:base_stone_overworld")) "02010c"
         "0e" FUNCTION LOWER-CASE(FUNCTION HEX-OF("minecraft:item")) "01"
         "10" FUNCTION LOWER-CASE(FUNCTION HEX-OF("minecraft:planks")) "01ac02"
         "18" FUNCTION LOWER-CASE(FUNCTION HEX-OF("minecraft:dimension_type")) "01"
         "16" FUNCTION LOWER-CASE(FUNCTION HEX-OF("minecraft:in_overworld")) "00"
         DELIMITED BY SIZE INTO WS-EXPECT
     PERFORM CHECK-BYTES
*>   Read the whole packet back.
     MOVE "tags: read back registry heads, tags and ids" TO WS-LABEL
     MOVE 0 TO PB-POS
     CALL "PB-GET-TAGS-HEAD" USING PB-BUFFER WO-COUNT
     PERFORM START-OBSERVED
     MOVE WO-COUNT TO WS-N
     PERFORM ADD-NUMBER
     CALL "PB-GET-TAG-REGISTRY-HEAD" USING PB-BUFFER WO-NAME WS-NAME-CAP WO-NAME-LEN WO-COUNT
     STRING " " WO-NAME(1:WO-NAME-LEN) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE WO-COUNT TO WS-N
     PERFORM ADD-NUMBER
     PERFORM 2 TIMES
         CALL "PB-GET-TAG" USING PB-BUFFER WO-NAME WS-NAME-CAP WO-NAME-LEN WO-IDS WS-ID-CAP
             WO-COUNT
         STRING " " WO-NAME(1:WO-NAME-LEN) DELIMITED BY SIZE INTO TL-OBSERVED
             WITH POINTER WS-PTR
         MOVE WO-COUNT TO WS-N
         PERFORM ADD-NUMBER
         PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WO-COUNT
             MOVE WO-ID(WS-I) TO WS-N
             PERFORM ADD-NUMBER
         END-PERFORM
     END-PERFORM
     CALL "PB-GET-TAG-REGISTRY-HEAD" USING PB-BUFFER WO-NAME WS-NAME-CAP WO-NAME-LEN WO-COUNT
     CALL "PB-GET-TAG" USING PB-BUFFER WO-NAME WS-NAME-CAP WO-NAME-LEN WO-IDS WS-ID-CAP WO-COUNT
     STRING " " WO-NAME(1:WO-NAME-LEN) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE WO-ID(1) TO WS-N
     PERFORM ADD-NUMBER
     CALL "PB-GET-TAG-REGISTRY-HEAD" USING PB-BUFFER WO-NAME WS-NAME-CAP WO-NAME-LEN WO-COUNT
     CALL "PB-GET-TAG" USING PB-BUFFER WO-NAME WS-NAME-CAP WO-NAME-LEN WO-IDS WS-ID-CAP WO-COUNT
     STRING " " WO-NAME(1:WO-NAME-LEN) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE WO-COUNT TO WS-N
     PERFORM ADD-NUMBER
     MOVE PB-ERROR TO WS-N
     PERFORM ADD-NUMBER
     COMPUTE WS-N = PB-LENGTH - PB-POS
     PERFORM ADD-NUMBER
     MOVE "3 minecraft:block 2 minecraft:planks 1 13 minecraft:base_stone_overworld 2 1 12"
         & " minecraft:planks 300 minecraft:in_overworld 0 0 0" TO TL-EXPECTED
     PERFORM ASSERT-OBSERVED.

 TAGS-ERROR-CASES.
     MOVE "minecraft:planks" TO WS-NAME
     MOVE 16 TO WS-NAME-LEN
     MOVE 13 TO WS-ID(1)
     MOVE 1 TO WS-COUNT
     MOVE "tags put: negative registry count" TO WS-LABEL
     CALL "PB-RESET" USING PB-BUFFER
     MOVE -1 TO WS-N
     CALL "PB-PUT-TAGS-HEAD" USING PB-BUFFER WS-N
     PERFORM OBSERVE-ERROR-LENGTH
     MOVE "1 0" TO TL-EXPECTED
     PERFORM ASSERT-OBSERVED
     MOVE "tags put: registry head with an invalid identifier" TO WS-LABEL
     CALL "PB-RESET" USING PB-BUFFER
     MOVE "Minecraft:block" TO WS-HEX
     MOVE 15 TO WS-N
     MOVE 2 TO WS-COUNT
     CALL "PB-PUT-TAG-REGISTRY-HEAD" USING PB-BUFFER WS-HEX WS-N WS-COUNT
     PERFORM OBSERVE-ERROR-LENGTH
     MOVE "1 0" TO TL-EXPECTED
     PERFORM ASSERT-OBSERVED
     MOVE "tags put: registry head with a negative tag count" TO WS-LABEL
     CALL "PB-RESET" USING PB-BUFFER
     MOVE "minecraft:block" TO WS-HEX
     MOVE -2 TO WS-COUNT
     CALL "PB-PUT-TAG-REGISTRY-HEAD" USING PB-BUFFER WS-HEX WS-N WS-COUNT
     PERFORM OBSERVE-ERROR-LENGTH
     MOVE "1 0" TO TL-EXPECTED
     PERFORM ASSERT-OBSERVED
     MOVE 1 TO WS-COUNT
     MOVE "tags put: invalid tag name" TO WS-LABEL
     MOVE "minecraft:Planks" TO WS-NAME
     PERFORM TAG-PUT-REJECTED
     MOVE "minecraft:planks" TO WS-NAME
     MOVE "tags put: negative id" TO WS-LABEL
     MOVE -1 TO WS-ID(1)
     PERFORM TAG-PUT-REJECTED
     MOVE 13 TO WS-ID(1)
     MOVE "tags put: negative id count" TO WS-LABEL
     MOVE -1 TO WS-COUNT
     PERFORM TAG-PUT-REJECTED
     MOVE 1 TO WS-COUNT
     MOVE "tags read: negative registry count" TO WS-LABEL
     MOVE "ffffffff0f" TO WS-HEX
     PERFORM FILL
     MOVE 0 TO PB-POS
     CALL "PB-GET-TAGS-HEAD" USING PB-BUFFER WO-COUNT
     PERFORM OBSERVE-ERROR-POS
     MOVE "1 0" TO TL-EXPECTED
     PERFORM ASSERT-OBSERVED
     MOVE "tags read: registry head negative tag count" TO WS-LABEL
     MOVE "0f" & "6d696e6563726166743a626c6f636b" & "ffffffff0f" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-TAG-REGISTRY-HEAD" USING PB-BUFFER WO-NAME WS-NAME-CAP WO-NAME-LEN WO-COUNT
     PERFORM OBSERVE-ERROR-POS
     MOVE "1 0" TO TL-EXPECTED
     PERFORM ASSERT-OBSERVED
     MOVE "tags read: registry head name too long for the capacity" TO WS-LABEL
     MOVE "0f" & "6d696e6563726166743a626c6f636b" & "01" TO WS-HEX
     PERFORM FILL
     MOVE 4 TO WS-NAME-CAP
     CALL "PB-GET-TAG-REGISTRY-HEAD" USING PB-BUFFER WO-NAME WS-NAME-CAP WO-NAME-LEN WO-COUNT
     PERFORM OBSERVE-ERROR-POS
     MOVE "1 0" TO TL-EXPECTED
     PERFORM ASSERT-OBSERVED
     MOVE 64 TO WS-NAME-CAP
     MOVE "tags read: tag with 9 ids for a capacity of 8" TO WS-LABEL
     MOVE "10" & "6d696e6563726166743a706c616e6b73" & "09010203040506070809" TO WS-HEX
     PERFORM FILL
     MOVE 0 TO PB-POS
     CALL "PB-GET-TAG" USING PB-BUFFER WO-NAME WS-NAME-CAP WO-NAME-LEN WO-IDS WS-ID-CAP WO-COUNT
     PERFORM OBSERVE-ERROR-POS
     MOVE "1 0" TO TL-EXPECTED
     PERFORM ASSERT-OBSERVED
     MOVE "tags read: tag with a negative id" TO WS-LABEL
     MOVE "10" & "6d696e6563726166743a706c616e6b73" & "01ffffffff0f" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-TAG" USING PB-BUFFER WO-NAME WS-NAME-CAP WO-NAME-LEN WO-IDS WS-ID-CAP WO-COUNT
     PERFORM OBSERVE-ERROR-POS
     MOVE "1 0" TO TL-EXPECTED
     PERFORM ASSERT-OBSERVED
     MOVE "tags read: tag with a negative id count" TO WS-LABEL
     MOVE "10" & "6d696e6563726166743a706c616e6b73" & "ffffffff0f" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-TAG" USING PB-BUFFER WO-NAME WS-NAME-CAP WO-NAME-LEN WO-IDS WS-ID-CAP WO-COUNT
     PERFORM OBSERVE-ERROR-POS
     MOVE "1 0" TO TL-EXPECTED
     PERFORM ASSERT-OBSERVED
     MOVE "tags read: tag with an invalid name" TO WS-LABEL
     MOVE "04" & "41424344" & "00" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-TAG" USING PB-BUFFER WO-NAME WS-NAME-CAP WO-NAME-LEN WO-IDS WS-ID-CAP WO-COUNT
     PERFORM OBSERVE-ERROR-POS
     MOVE "1 0" TO TL-EXPECTED
     PERFORM ASSERT-OBSERVED.

 TAG-PUT-REJECTED.
     CALL "PB-RESET" USING PB-BUFFER
     CALL "PB-PUT-TAG" USING PB-BUFFER WS-NAME WS-NAME-LEN WS-IDS WS-COUNT
     PERFORM OBSERVE-ERROR-LENGTH
     MOVE "1 0" TO TL-EXPECTED
     PERFORM ASSERT-OBSERVED.

*> ---- helpers ----
 CHECK-BYTES-AFTER-PUT.
     PERFORM CHECK-BYTES.

 CHECK-BYTES.
     MOVE SPACES TO TL-CASE
     STRING "test registry-tags " FUNCTION TRIM(WS-LABEL) DELIMITED BY SIZE INTO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE WS-EXPECT TO TL-EXPECTED
     CALL "TEST-BUFFER-HEX" USING PB-BUFFER TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 FILL.
     MOVE SPACES TO WS-EXPECT
     STRING FUNCTION TRIM(WS-HEX) "." DELIMITED BY SIZE INTO WS-EXPECT
     CALL "TEST-FILL-HEX" USING WS-EXPECT PB-BUFFER.

 OBSERVE-ERROR-LENGTH.
     MOVE SPACES TO TL-CASE
     STRING "test registry-tags " FUNCTION TRIM(WS-LABEL) DELIMITED BY SIZE INTO TL-CASE
     PERFORM START-OBSERVED
     MOVE PB-ERROR TO WS-N
     PERFORM ADD-NUMBER
     MOVE PB-LENGTH TO WS-N
     PERFORM ADD-NUMBER.

 OBSERVE-ERROR-POS.
     MOVE SPACES TO TL-CASE
     STRING "test registry-tags " FUNCTION TRIM(WS-LABEL) DELIMITED BY SIZE INTO TL-CASE
     PERFORM START-OBSERVED
     MOVE PB-ERROR TO WS-N
     PERFORM ADD-NUMBER
     MOVE PB-POS TO WS-N
     PERFORM ADD-NUMBER.

 OBSERVE-NUMBER.
     PERFORM START-OBSERVED
     PERFORM ADD-NUMBER.

 ASSERT-OBSERVED.
     MOVE SPACES TO TL-CASE
     STRING "test registry-tags " FUNCTION TRIM(WS-LABEL) DELIMITED BY SIZE INTO TL-CASE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 START-OBSERVED.
     MOVE "T" TO TL-MODE
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR.

 ADD-NUMBER.
     MOVE WS-N TO WS-EDIT
     IF WS-PTR > 1
         STRING " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-IF
     STRING FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR.
 END PROGRAM TEST-REGISTRY-TAGS.
 COPY PROTOTEST.
