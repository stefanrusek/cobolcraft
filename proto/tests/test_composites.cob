     MOVE "07 0000000000000000 00 00" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-PLAYER-ACTION" USING PB-BUFFER WS-STATUS WS-X WS-Y WS-Z WS-FACE WS-SEQUENCE
     MOVE "test composites PLAYER-ACTION get of swap with off-hand (7) decodes status 7" TO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE "7 0 0 0 0 0 pos 11 error 0" TO TL-EXPECTED
     PERFORM START-FIELDS
     MOVE WS-STATUS TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE WS-X TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE WS-Y TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE WS-Z TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE WS-FACE TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE WS-SEQUENCE TO WS-EDIT
     PERFORM ADD-FIELD
     PERFORM END-FIELDS
     MOVE "09 0000000000000000 00 00" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-PLAYER-ACTION" USING PB-BUFFER WS-STATUS WS-X WS-Y WS-Z WS-FACE WS-SEQUENCE
     MOVE "test composites PLAYER-ACTION get of action 9sets PB-ERROR, PB-POS 0, zeros"
         TO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE "0 0 0 0 0 0 pos 0 error 1" TO TL-EXPECTED
     PERFORM START-FIELDS
     MOVE WS-STATUS TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE WS-X TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE WS-Y TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE WS-Z TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE WS-FACE TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE WS-SEQUENCE TO WS-EDIT
     PERFORM ADD-FIELD
     PERFORM END-FIELDS
     MOVE "00 0000000000000000 01" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-PLAYER-ACTION" USING PB-BUFFER WS-STATUS WS-X WS-Y WS-Z WS-FACE WS-SEQUENCE
     MOVE "test composites PLAYER-ACTION get without its sequence sets PB-ERROR, PB-POS 0, zeros"
         TO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE "0 0 0 0 0 0 pos 0 error 1" TO TL-EXPECTED
     PERFORM START-FIELDS
     MOVE WS-STATUS TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE WS-X TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE WS-Y TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE WS-Z TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE WS-FACE TO WS-EDIT
     PERFORM ADD-FIELD
     MOVE WS-SEQUENCE TO WS-EDIT
     PERFORM ADD-FIELD
     PERFORM END-FIELDS.

*> Builds TL-OBSERVED as the edited fields, then " pos <PB-POS> error <PB-ERROR>", and asserts.
 START-FIELDS.
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR.

 ADD-FIELD.
     IF WS-PTR > 1
         STRING " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-IF
     STRING FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR.

 END-FIELDS.
     MOVE PB-POS TO WS-EDIT
     STRING " pos " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED
         WITH POINTER WS-PTR
     MOVE PB-ERROR TO WS-EDIT
     STRING " error " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED
         WITH POINTER WS-PTR
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 FILL.
     CALL "TEST-FILL-HEX" USING WS-HEX PB-BUFFER.

*> PB-ERROR 1 and nothing appended; the buffer is reset for the next case.
 CHECK-PUT-ERROR.
     MOVE "N" TO TL-MODE
     MOVE 10 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PB-ERROR * 10 + PB-LENGTH
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "PB-RESET" USING PB-BUFFER.

*> PB-ERROR 1, PB-POS back at 0, every field of the entry 0.
 CHECK-GET-ERROR.
     MOVE "N" TO TL-MODE
     MOVE 1000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PB-ERROR * 1000 + PB-POS * 100 + PB-MD-INDEX + PB-MD-SERIALIZER
         + PB-MD-INT + PB-MD-FLOAT + PB-MD-IS-COUNT + PB-MD-IS-ITEM
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

*> PB-ERROR 1, PB-POS back at 0, every field of the slot display 0.
 CHECK-SLOT-GET-ERROR.
     MOVE "N" TO TL-MODE
     MOVE 1000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PB-ERROR * 1000 + PB-POS * 100 + PB-SD-TYPE + PB-SD-ITEM
         + PB-SD-COUNT
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

*> PB-ERROR 1, PB-POS back at 0, the entry all zero (every field summed).
 CHECK-RECIPE-GET-ERROR.
     MOVE "N" TO TL-MODE
     MOVE 1000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PB-ERROR * 1000 + PB-POS * 100 + PB-RD-DISPLAY-ID + PB-RD-TYPE
         + PB-RD-WIDTH + PB-RD-HEIGHT + PB-RD-INGREDIENT-COUNT + PB-RD-IN-TYPE(1)
         + PB-RD-IN-ITEM(1) + PB-RD-IN-COUNT(1) + PB-RD-RES-TYPE + PB-RD-RES-ITEM
         + PB-RD-RES-COUNT + PB-RD-ST-TYPE + PB-RD-GROUP + PB-RD-CATEGORY + PB-RD-REQ-PRESENT
         + PB-RD-REQ-COUNT + PB-RD-REQ-ITEM(1)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

*> PB-ERROR 1, PB-POS back at 0, the node all zero (every numeric field summed, texts spaces).
 CHECK-NODE-GET-ERROR.
     MOVE "N" TO TL-MODE
     MOVE 1000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PB-ERROR * 1000 + PB-POS * 100 + PB-CN-FLAGS + PB-CN-CHILD-COUNT
         + PB-CN-CHILD(1) + PB-CN-REDIRECT + PB-CN-NAME-LENGTH + PB-CN-PARSER
         + PB-CN-STRING-KIND + PB-CN-RANGE-FLAGS + PB-CN-MIN-INT + PB-CN-MAX-INT
         + PB-CN-MIN-DOUBLE + PB-CN-MAX-DOUBLE + PB-CN-SUGGEST-LENGTH
     IF PB-CN-NAME NOT = SPACES OR PB-CN-SUGGEST NOT = SPACES
         ADD 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-COMPOSITES.
 COPY PROTOTEST.
