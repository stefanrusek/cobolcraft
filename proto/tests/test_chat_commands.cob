     MOVE "N" TO TL-MODE
     MOVE 32770 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PB-LENGTH + PB-ERROR * 100000
     PERFORM ASSERT-NUMBER
     CALL "PB-RESET" USING PB-BUFFER
     MOVE 32768 TO WS-LEN
     CALL "PB-PUT-CHAT-COMMAND" USING PB-BUFFER WS-BIG WS-LEN
     MOVE "chat command of 32768 characters" TO WS-NAME
     PERFORM PUT-ERROR
     MOVE -1 TO WS-LEN
     CALL "PB-PUT-CHAT-COMMAND" USING PB-BUFFER WS-BIG WS-LEN
     MOVE "chat command of length -1" TO WS-NAME
     PERFORM PUT-ERROR
     MOVE "chat command with no bytes" TO WS-NAME
     MOVE SPACES TO WS-HEX
     MOVE 77 TO WS-LEN
     CALL "TEST-FILL-HEX" USING WS-HEX PB-BUFFER
     CALL "PB-GET-CHAT-COMMAND" USING PB-BUFFER WS-TEXT WS-CAP WS-LEN
     MOVE 0 TO WS-TRANS
     PERFORM CHECK-REQUEST-ERROR
     MOVE "chat command longer than the caller's capacity" TO WS-NAME
     MOVE "05 6162636465" TO WS-HEX
     CALL "TEST-FILL-HEX" USING WS-HEX PB-BUFFER
     MOVE 4 TO WS-CAP
     CALL "PB-GET-CHAT-COMMAND" USING PB-BUFFER WS-TEXT WS-CAP WS-LEN
     MOVE 256 TO WS-CAP
