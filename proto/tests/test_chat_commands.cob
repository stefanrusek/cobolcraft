*>   Every cut of a valid response is an error.
     INITIALIZE PB-SUGGESTIONS
     MOVE 300 TO PB-SG-TRANSACTION
     MOVE 2 TO PB-SG-COUNT
     MOVE 1 TO PB-SG-TEXT-LENGTH(1)
     MOVE "a" TO PB-SG-TEXT(1)
     MOVE -1 TO PB-SG-TOOLTIP-KIND(1)
     MOVE 1 TO PB-SG-TEXT-LENGTH(2)
     MOVE "b" TO PB-SG-TEXT(2)
     MOVE PB-TEXT-PLAIN TO PB-SG-TOOLTIP-KIND(2)
     MOVE 1 TO PB-SG-TOOLTIP-LENGTH(2)
     MOVE "c" TO PB-SG-TOOLTIP(2)
     CALL "PB-RESET" USING PB-BUFFER
     CALL "PB-PUT-SUGGESTIONS" USING PB-BUFFER PB-SUGGESTIONS
     MOVE PB-LENGTH TO WS-FULL
     MOVE 0 TO WS-BAD
     INITIALIZE WS-ZERO-SUGGESTIONS
     PERFORM VARYING WS-CUT FROM 0 BY 1 UNTIL WS-CUT >= WS-FULL
         MOVE WS-CUT TO PB-LENGTH
         MOVE 0 TO PB-POS PB-ERROR
         CALL "PB-GET-SUGGESTIONS" USING PB-BUFFER PK-SUGGESTIONS
         IF PB-ERROR = 0 OR PB-POS NOT = 0 OR PK-SUGGESTIONS NOT = WS-ZERO-SUGGESTIONS
             ADD 1 TO WS-BAD
         END-IF
     END-PERFORM
     MOVE "suggestions: every cut of a valid response is an error" TO WS-NAME
     MOVE "N" TO TL-MODE
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-BAD TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER.

*> One entry with one text and no tooltip in the second slot, the rest of the response valid.
 ONE-SUGGESTION.
     INITIALIZE PB-SUGGESTIONS
     MOVE 1 TO PB-SG-TRANSACTION
     MOVE 2 TO PB-SG-COUNT
     MOVE 1 TO PB-SG-TEXT-LENGTH(1)
     MOVE "a" TO PB-SG-TEXT(1)
     MOVE -1 TO PB-SG-TOOLTIP-KIND(1)
     MOVE 1 TO PB-SG-TEXT-LENGTH(2)
     MOVE "b" TO PB-SG-TEXT(2)
     MOVE PB-TEXT-PLAIN TO PB-SG-TOOLTIP-KIND(2)
     MOVE 1 TO PB-SG-TOOLTIP-LENGTH(2)
     MOVE "c" TO PB-SG-TOOLTIP(2).

 SUGGESTIONS-PUT-READ.
     CALL "PB-RESET" USING PB-BUFFER
     CALL "PB-PUT-SUGGESTIONS" USING PB-BUFFER PB-SUGGESTIONS
     PERFORM CHECK-BYTES
     PERFORM SUGGESTIONS-READ-BACK.

 SUGGESTIONS-READ-BACK.
     MOVE 0 TO PB-POS
     CALL "PB-GET-SUGGESTIONS" USING PB-BUFFER PK-SUGGESTIONS
     MOVE SPACES TO WS-SAME
     IF PB-ERROR = 0 AND PB-POS = PB-LENGTH AND PK-SUGGESTIONS = PB-SUGGESTIONS
         MOVE "same" TO WS-SAME
     ELSE
         MOVE "different" TO WS-SAME
     END-IF
     PERFORM CHECK-SAME.

 SUGGESTIONS-PUT-ERROR.
     CALL "PB-RESET" USING PB-BUFFER
     CALL "PB-PUT-SUGGESTIONS" USING PB-BUFFER PB-SUGGESTIONS
     PERFORM PUT-ERROR.

 SUGGESTIONS-GET-ERROR.
     CALL "TEST-FILL-HEX" USING WS-HEX PB-BUFFER
     INITIALIZE PB-SUGGESTIONS
     MOVE 77 TO PK-SG-TRANSACTION
     CALL "PB-GET-SUGGESTIONS" USING PB-BUFFER PK-SUGGESTIONS
     MOVE SPACES TO TL-CASE
     STRING "test chat commands get of suggestions with " FUNCTION TRIM(WS-NAME)
         " sets PB-ERROR, keeps PB-POS and yields an all-zero value" DELIMITED BY SIZE
         INTO TL-CASE
     MOVE "N" TO TL-MODE
     MOVE 1000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PB-ERROR * 1000 + PB-POS * 100
     IF PK-SUGGESTIONS NOT = PB-SUGGESTIONS
         ADD 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

