     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

*> The encoded signed message in PB-BUFFER cut to every length below WS-FULL: all must fail.
 CUT-CASES.
     MOVE 0 TO WS-BAD
     PERFORM VARYING WS-CUT FROM 0 BY 1 UNTIL WS-CUT >= WS-FULL
         MOVE WS-CUT TO PB-LENGTH
         MOVE 0 TO PB-POS PB-ERROR
         CALL "PB-GET-PLAYER-CHAT" USING PB-BUFFER PK-PLAYER-CHAT PK-CHAT-BOUND
         INITIALIZE PB-PLAYER-CHAT PB-CHAT-BOUND
         IF PB-ERROR = 0 OR PB-POS NOT = 0 OR PK-PLAYER-CHAT NOT = PB-PLAYER-CHAT
                 OR PK-CHAT-BOUND NOT = PB-CHAT-BOUND
             ADD 1 TO WS-BAD
         END-IF
     END-PERFORM
     MOVE "player chat: every cut of a valid message is an error" TO WS-NAME
     MOVE "N" TO TL-MODE
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-BAD TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER.

*> ---- shared helpers ----
 ADD-FIELD.
     IF WS-PTR > 1
         STRING " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-IF
     STRING FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR.

*> Compares TL-OBSERVED with TL-EXPECTED for the case "<WS-NAME>".
 CHECK-FIELDS.
     MOVE SPACES TO TL-CASE
     STRING "test chat commands " FUNCTION TRIM(WS-NAME) DELIMITED BY SIZE INTO TL-CASE
     MOVE "T" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 CHECK-SAME.
     MOVE SPACES TO TL-CASE
     STRING "test chat commands " FUNCTION TRIM(WS-NAME) " decodes to the same value"
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE "same" TO TL-EXPECTED
     MOVE WS-SAME TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 ASSERT-NUMBER.
     MOVE SPACES TO TL-CASE
     STRING "test chat commands " FUNCTION TRIM(WS-NAME) DELIMITED BY SIZE INTO TL-CASE
     MOVE "N" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

*> The buffer's bytes against WS-EXPECT (hex, spaces ignored).
 CHECK-BYTES.
     MOVE SPACES TO TL-CASE
     STRING "test chat commands " FUNCTION TRIM(WS-NAME) " encodes to " FUNCTION TRIM(WS-EXPECT)
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "T" TO TL-MODE
     PERFORM NORMALISE-EXPECT
     CALL "TEST-BUFFER-HEX" USING PB-BUFFER TL-OBSERVED
     IF PB-ERROR NOT = 0
         MOVE "error" TO TL-OBSERVED
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

*> WS-COUNT bytes of the buffer from WS-OFFSET against WS-EXPECT.
 CHECK-SLICE.
     MOVE SPACES TO TL-CASE
     MOVE WS-OFFSET TO WS-EDIT
     STRING "test chat commands player chat bytes at " FUNCTION TRIM(WS-EDIT) " are "
         FUNCTION TRIM(WS-EXPECT) DELIMITED BY SIZE INTO TL-CASE
     MOVE "T" TO TL-MODE
     PERFORM NORMALISE-EXPECT
     CALL "TEST-BUFFER-SLICE-HEX" USING PB-BUFFER WS-OFFSET WS-COUNT TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 NORMALISE-EXPECT.
     MOVE SPACES TO TL-EXPECTED
     MOVE 1 TO WS-J
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 1024
         IF WS-EXPECT(WS-I:1) NOT = SPACE
             MOVE WS-EXPECT(WS-I:1) TO TL-EXPECTED(WS-J:1)
             ADD 1 TO WS-J
         END-IF
     END-PERFORM.

*> PB-ERROR 1 and nothing appended; the case is "put of <WS-NAME> ...".
 PUT-ERROR.
     MOVE SPACES TO TL-CASE
     STRING "test chat commands put of " FUNCTION TRIM(WS-NAME)
         " sets PB-ERROR and appends nothing" DELIMITED BY SIZE INTO TL-CASE
     MOVE "N" TO TL-MODE
     MOVE 10 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PB-ERROR * 10 + PB-LENGTH
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-CHAT-COMMANDS.
 COPY PROTOTEST.
