*> Implementation test of proto/src/nbt.cob and proto/src/nbtfile.cob: the limits and malformed-input
*> paths the contract test leaves unexecuted (07 §1 to §4).
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-NBT.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY PROTO.
 COPY TESTLIB.
 01 WS-CAPACITY            BINARY-LONG VALUE 64.
 01 WS-HEX                 PIC X(1024).
 01 WS-BIG                 PIC X(65536).
 01 WS-LEN                 BINARY-LONG.
 01 WS-CAP                 BINARY-LONG.
 01 WS-COUNT               BINARY-LONG.
 01 WS-TYPE                BINARY-LONG.
 01 WS-FOUND               BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-BYTE                BINARY-LONG.
 01 WS-ELEMENT             BINARY-LONG VALUE -1.
 01 WS-NO-NAME             PIC X VALUE SPACE.
 01 WS-TEXT                PIC X(64).
 01 WS-PATH                PIC X(64).
 01 WS-INTS.
    05 WS-INT-ITEM         BINARY-LONG OCCURS 4 TIMES.
 01 WS-LONGS.
    05 WS-LONG-ITEM        BINARY-DOUBLE OCCURS 4 TIMES.
 01 WS-EDIT                PIC -(19)9.
 01 WS-PTR                 BINARY-LONG.
 01 WS-NUM                 BINARY-DOUBLE.
 PROCEDURE DIVISION.
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
*>   07 §2: a string payload is at most 65535 bytes once encoded.
     MOVE ALL "a" TO WS-BIG
     MOVE 65535 TO WS-LEN
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WS-NO-NAME WS-ELEMENT WS-BIG WS-LEN
     MOVE "test nbt string of 65535 bytes is written with UShort length ffff" TO TL-CASE
     MOVE "65537 0" TO TL-EXPECTED
     PERFORM START-TEXT
     MOVE PB-LENGTH TO WS-NUM
     PERFORM ADD-NUMBER
     MOVE PB-ERROR TO WS-NUM
     PERFORM ADD-NUMBER
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "PB-RESET" USING PB-BUFFER
     MOVE 65536 TO WS-LEN
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WS-NO-NAME WS-ELEMENT WS-BIG WS-LEN
     MOVE "test nbt string of 65536 bytes sets PB-ERROR and writes nothing" TO TL-CASE
     MOVE "0 1" TO TL-EXPECTED
     PERFORM START-TEXT
     MOVE PB-LENGTH TO WS-NUM
     PERFORM ADD-NUMBER
     MOVE PB-ERROR TO WS-NUM
     PERFORM ADD-NUMBER
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "PB-RESET" USING PB-BUFFER
     MOVE LOW-VALUES TO WS-BIG(1:32768)
     MOVE 32768 TO WS-LEN
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WS-NO-NAME WS-ELEMENT WS-BIG WS-LEN
     MOVE "test nbt 32768 NUL characters encode to 65536 bytes (C0 80 each): PB-ERROR" TO TL-CASE
     PERFORM CHECK-ERROR
*>   NBT-READ-STRING limits; a lone surrogate is copied as it is.
     MOVE "0003 616263" TO WS-HEX
     PERFORM FILL
     MOVE 2 TO WS-CAP
     CALL "NBT-READ-STRING" USING PB-BUFFER WS-TEXT WS-CAP WS-LEN
     MOVE "test nbt read string longer than the capacity sets PB-ERROR, keeps PB-POS" TO TL-CASE
     PERFORM CHECK-READ-ERROR
     MOVE "0005 6162" TO WS-HEX
     PERFORM FILL
     MOVE 64 TO WS-CAP
     CALL "NBT-READ-STRING" USING PB-BUFFER WS-TEXT WS-CAP WS-LEN
     MOVE "test nbt read string beyond the data sets PB-ERROR, keeps PB-POS" TO TL-CASE
     PERFORM CHECK-READ-ERROR
     MOVE "0004 eda08041" TO WS-HEX
     PERFORM FILL
     CALL "NBT-READ-STRING" USING PB-BUFFER WS-TEXT WS-CAP WS-LEN
     MOVE "test nbt read string copies a lone surrogate unchanged" TO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE "EDA08041" TO TL-EXPECTED
     MOVE FUNCTION HEX-OF(WS-TEXT(1:WS-LEN)) TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   Headers.
     MOVE "0d" TO WS-HEX
     PERFORM FILL
     CALL "NBT-READ-COMPOUND-NEXT" USING PB-BUFFER WS-TYPE WS-TEXT WS-CAP WS-LEN
     MOVE "test nbt compound entry of tag type 13 sets PB-ERROR, type 0" TO TL-CASE
     MOVE "1 0" TO TL-EXPECTED
     PERFORM ERROR-AND-TYPE
     MOVE "08 0005 6162" TO WS-HEX
     PERFORM FILL
     CALL "NBT-READ-COMPOUND-NEXT" USING PB-BUFFER WS-TYPE WS-TEXT WS-CAP WS-LEN
     MOVE "test nbt compound entry with a truncated name sets PB-ERROR, type 0" TO TL-CASE
     MOVE "1 0" TO TL-EXPECTED
     PERFORM ERROR-AND-TYPE
     MOVE "0d 00000000" TO WS-HEX
     PERFORM FILL
     CALL "NBT-READ-LIST-BEGIN" USING PB-BUFFER WS-TYPE WS-COUNT
     MOVE "test nbt list of element type 13 sets PB-ERROR" TO TL-CASE
     PERFORM CHECK-ERROR
     MOVE "0a 0005 6162" TO WS-HEX
     PERFORM FILL
     MOVE 1 TO WS-I
     CALL "NBT-READ-ROOT" USING PB-BUFFER WS-I WS-TYPE
     MOVE "test nbt file root with a truncated name sets PB-ERROR, type 0" TO TL-CASE
     MOVE "1 0" TO TL-EXPECTED
     PERFORM ERROR-AND-TYPE
*>   Arrays.
     MOVE "00000005 0102030405" TO WS-HEX
     PERFORM FILL
     MOVE 2 TO WS-CAP
     CALL "NBT-READ-BYTE-ARRAY" USING PB-BUFFER WS-CAP WS-COUNT WS-TEXT
     MOVE "test nbt byte array longer than the capacity sets PB-ERROR, count 0" TO TL-CASE
     PERFORM CHECK-COUNT-ERROR
     MOVE "ffffffff" TO WS-HEX
     PERFORM FILL
     CALL "NBT-READ-BYTE-ARRAY" USING PB-BUFFER WS-CAP WS-COUNT WS-TEXT
     MOVE "test nbt byte array of negative length sets PB-ERROR" TO TL-CASE
     PERFORM CHECK-COUNT-ERROR
     MOVE "00000002 00000001" TO WS-HEX
     PERFORM FILL
     MOVE 4 TO WS-CAP
     CALL "NBT-READ-INT-ARRAY" USING PB-BUFFER WS-CAP WS-COUNT WS-INTS
     MOVE "test nbt int array beyond the data sets PB-ERROR" TO TL-CASE
     PERFORM CHECK-COUNT-ERROR
     MOVE "00000005 00000001" TO WS-HEX
     PERFORM FILL
     CALL "NBT-READ-INT-ARRAY" USING PB-BUFFER WS-CAP WS-COUNT WS-INTS
     MOVE "test nbt int array longer than the capacity sets PB-ERROR" TO TL-CASE
     PERFORM CHECK-COUNT-ERROR
     MOVE "00000002 0000000000000001" TO WS-HEX
     PERFORM FILL
     CALL "NBT-READ-LONG-ARRAY" USING PB-BUFFER WS-CAP WS-COUNT WS-LONGS
     MOVE "test nbt long array beyond the data sets PB-ERROR" TO TL-CASE
     PERFORM CHECK-COUNT-ERROR
*>   NBT-READ-SKIP nesting limit (07 §4: depth 512). The root compound is level 1; n nested
*>   compounds inside it make n + 1 levels.
     MOVE 511 TO WS-COUNT
     PERFORM BUILD-NESTED
     MOVE "test nbt skip of 512 nested compound levels succeeds" TO TL-CASE
     MOVE "0 0" TO TL-EXPECTED
     PERFORM SKIP-NESTED
     MOVE 512 TO WS-COUNT
     PERFORM BUILD-NESTED
     MOVE "test nbt skip of 513 nested compound levels sets PB-ERROR" TO TL-CASE
     MOVE "1" TO TL-EXPECTED
     PERFORM SKIP-NESTED
*>   Skipping each payload kind inside a list, and find through a list of lists.
     MOVE "09 0001 6c 09 00000002 03 00000001 00000007 01 00000002 0506 00" TO WS-HEX
     PERFORM FILL
     MOVE 10 TO WS-TYPE
     MOVE "l[1][1]" TO WS-PATH
     MOVE 7 TO WS-LEN
     CALL "NBT-READ-FIND" USING PB-BUFFER WS-TYPE WS-PATH WS-LEN WS-FOUND
     CALL "PB-GET-BYTE" USING PB-BUFFER WS-BYTE
     MOVE "test nbt find l[1][1] in a list of lists is Byte 6" TO TL-CASE
     MOVE "1 6 0" TO TL-EXPECTED
     PERFORM START-TEXT
     MOVE WS-FOUND TO WS-NUM
     PERFORM ADD-NUMBER
     MOVE WS-BYTE TO WS-NUM
     PERFORM ADD-NUMBER
     MOVE PB-ERROR TO WS-NUM
     PERFORM ADD-NUMBER
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "0a 07000162 00000001 ff 08000173 000178 0b000169 00000001 00000002"
         & " 0c00016c 00000001 0000000000000003 02000168 0001 06000164 3ff0000000000000"
         & " 05000166 3f800000 04000167 0000000000000004 00" TO WS-HEX
     PERFORM FILL
     MOVE 10 TO WS-TYPE
     MOVE 1 TO PB-POS
     CALL "NBT-READ-SKIP" USING PB-BUFFER WS-TYPE
     MOVE "test nbt skip of a compound holding every array and scalar type" TO TL-CASE
     MOVE "0 0" TO TL-EXPECTED
     PERFORM START-TEXT
     MOVE PB-ERROR TO WS-NUM
     PERFORM ADD-NUMBER
     COMPUTE WS-NUM = PB-LENGTH - PB-POS
     PERFORM ADD-NUMBER
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "PB-FREE" USING PB-BUFFER
     STOP RUN.

*> A network root compound with WS-COUNT compounds nested inside it (each named ""), all closed.
 BUILD-NESTED.
     CALL "PB-RESET" USING PB-BUFFER
     MOVE 10 TO WS-BYTE
     CALL "PB-PUT-UBYTE" USING PB-BUFFER WS-BYTE
     PERFORM WS-COUNT TIMES
         MOVE 10 TO WS-BYTE
         CALL "PB-PUT-UBYTE" USING PB-BUFFER WS-BYTE
         MOVE 0 TO WS-BYTE
         CALL "PB-PUT-USHORT" USING PB-BUFFER WS-BYTE
     END-PERFORM
     MOVE 0 TO WS-BYTE
     PERFORM WS-COUNT TIMES
         CALL "PB-PUT-UBYTE" USING PB-BUFFER WS-BYTE
     END-PERFORM
     CALL "PB-PUT-UBYTE" USING PB-BUFFER WS-BYTE.

*> TL-EXPECTED against "error remaining" (or just "error" when it is set).
 SKIP-NESTED.
     MOVE 1 TO PB-POS
     MOVE 10 TO WS-TYPE
     CALL "NBT-READ-SKIP" USING PB-BUFFER WS-TYPE
     PERFORM START-TEXT
     MOVE PB-ERROR TO WS-NUM
     PERFORM ADD-NUMBER
     IF PB-ERROR = 0
         COMPUTE WS-NUM = PB-LENGTH - PB-POS
         PERFORM ADD-NUMBER
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 FILL.
     CALL "TEST-FILL-HEX" USING WS-HEX PB-BUFFER.

 CHECK-ERROR.
     MOVE "N" TO TL-MODE
     MOVE 1 TO TL-EXPECTED-N
     MOVE PB-ERROR TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

*> PB-ERROR 1, PB-POS back at 0, length 0.
 CHECK-READ-ERROR.
     MOVE "N" TO TL-MODE
     MOVE 100 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PB-ERROR * 100 + PB-POS * 10 + WS-LEN
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

*> PB-ERROR 1, PB-POS back at 0, count 0.
 CHECK-COUNT-ERROR.
     MOVE "N" TO TL-MODE
     MOVE 100 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PB-ERROR * 100 + PB-POS * 10 + WS-COUNT
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 ERROR-AND-TYPE.
     PERFORM START-TEXT
     MOVE PB-ERROR TO WS-NUM
     PERFORM ADD-NUMBER
     MOVE WS-TYPE TO WS-NUM
     PERFORM ADD-NUMBER
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 START-TEXT.
     MOVE "T" TO TL-MODE
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR.

 ADD-NUMBER.
     MOVE WS-NUM TO WS-EDIT
     IF WS-PTR > 1
         STRING " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-IF
     STRING FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR.
 END PROGRAM TEST-NBT.
 COPY PROTOTEST.
