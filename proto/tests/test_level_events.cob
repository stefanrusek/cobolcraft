    05 FILLER PIC X(150) VALUE "3a 00 00".
    05 FILLER PIC X(150) VALUE "3a 01 05 3f 80".
    05 FILLER PIC X(150) VALUE "3a".
    05 FILLER PIC X(150) VALUE "16 00 00".
    05 FILLER PIC X(150) VALUE "01 ff ff ff ff 0f".
    05 FILLER PIC X(150) VALUE "3a 01 80".
 01 WS-BAD-PARTICLES REDEFINES WS-BAD-PARTICLE-TABLE.
    05 WS-BP-HEX              PIC X(150) OCCURS 15 TIMES.
 01 WS-BAD-PUT-TABLE.
    05 FILLER PIC X(5)   VALUE "-1".
    05 FILLER PIC X(5)   VALUE "0".
    05 FILLER PIC X(150) VALUE " ".
    05 FILLER PIC X(5)   VALUE "128".
    05 FILLER PIC X(5)   VALUE "0".
    05 FILLER PIC X(150) VALUE " ".
    05 FILLER PIC X(5)   VALUE "0".
    05 FILLER PIC X(5)   VALUE "1".
    05 FILLER PIC X(150) VALUE "05".
    05 FILLER PIC X(5)   VALUE "21".
    05 FILLER PIC X(5)   VALUE "7".
    05 FILLER PIC X(150) VALUE "00 ff 00 00 40 00 00".
    05 FILLER PIC X(5)   VALUE "21".
    05 FILLER PIC X(5)   VALUE "9".
    05 FILLER PIC X(150) VALUE "00 ff 00 00 40 00 00 00 00".
    05 FILLER PIC X(5)   VALUE "1".
    05 FILLER PIC X(5)   VALUE "2".
    05 FILLER PIC X(150) VALUE "8a 97".
    05 FILLER PIC X(5)   VALUE "21".
    05 FILLER PIC X(5)   VALUE "65".
    05 FILLER PIC X(150) VALUE "00 ff 00 00 40 00 00 00".
    05 FILLER PIC X(5)   VALUE "21".
    05 FILLER PIC X(5)   VALUE "-1".
    05 FILLER PIC X(150) VALUE "00 ff 00 00 40 00 00 00".
    05 FILLER PIC X(5)   VALUE "57".
    05 FILLER PIC X(5)   VALUE "4".
    05 FILLER PIC X(150) VALUE "02 01 01 00".
    05 FILLER PIC X(5)   VALUE "58".
    05 FILLER PIC X(5)   VALUE "3".
    05 FILLER PIC X(150) VALUE "02 00 14".
 01 WS-BAD-PUTS REDEFINES WS-BAD-PUT-TABLE.
    05 WS-BU                  OCCURS 10 TIMES.
       10 WS-BU-TYPE          PIC X(5).
       10 WS-BU-LEN           PIC X(5).
       10 WS-BU-HEX           PIC X(150).
 PROCEDURE DIVISION.
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     CALL "PB-INIT" USING PK-BUFFER WS-CAPACITY
*>   ---- Level Event ----
     MOVE 2001 TO WS-EVENT
     MOVE -3 TO WS-X
     MOVE 12 TO WS-Y
     MOVE 9 TO WS-Z
     MOVE 88 TO WS-DATA-INT
     MOVE 5 TO WS-GLOBAL
     CALL "PB-PUT-LEVEL-EVENT" USING PB-BUFFER WS-EVENT WS-X WS-Y WS-Z WS-DATA-INT WS-GLOBAL
     MOVE "test level events LEVEL-EVENT put of event 2001 at (-3, 12, 9) data 88 global true"
         TO TL-CASE
     MOVE "000007d1ffffff400000900c0000005801" TO TL-EXPECTED
     PERFORM CHECK-PUT
     MOVE "00 00 07 d1 ff ff ff 40 00 00 90 0c 00 00 00 58 00" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-LEVEL-EVENT" USING PB-BUFFER WS-EVENT WS-X WS-Y WS-Z WS-DATA-INT WS-GLOBAL
     PERFORM START-OBS
     MOVE WS-EVENT TO WS-EDIT
     PERFORM ADD-NUM
     MOVE WS-X TO WS-EDIT
     PERFORM ADD-NUM
     MOVE WS-Y TO WS-EDIT
     PERFORM ADD-NUM
     MOVE WS-Z TO WS-EDIT
     PERFORM ADD-NUM
     MOVE WS-DATA-INT TO WS-EDIT
     PERFORM ADD-NUM
     MOVE WS-GLOBAL TO WS-EDIT
     PERFORM ADD-NUM
     MOVE "test level events LEVEL-EVENT get reads the six fields" TO TL-CASE
     MOVE "2001 -3 12 9 88 0 ok" TO TL-EXPECTED
     PERFORM END-GET
     MOVE "00 00 07 d1 ff ff ff 40 00 00 90 0c 00 00 00 58 ff" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-LEVEL-EVENT" USING PB-BUFFER WS-EVENT WS-X WS-Y WS-Z WS-DATA-INT WS-GLOBAL
     MOVE "test level events LEVEL-EVENT get takes any non-zero Global byte as true" TO TL-CASE
     MOVE WS-GLOBAL TO TL-OBSERVED-N
     MOVE "N" TO TL-MODE
     MOVE 1 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "00 00 07 d1 ff ff ff 40 00 00 90 0c 00 00 00 58" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-LEVEL-EVENT" USING PB-BUFFER WS-EVENT WS-X WS-Y WS-Z WS-DATA-INT WS-GLOBAL
     PERFORM START-OBS
     COMPUTE WS-EDIT = WS-EVENT + WS-X + WS-Y + WS-Z + WS-DATA-INT + WS-GLOBAL
     PERFORM ADD-NUM
     MOVE "test level events LEVEL-EVENT get without the Global byte fails with zeros" TO TL-CASE
     MOVE "0 e1 p0" TO TL-EXPECTED
     PERFORM END-GET
*>   ---- Block Event ----
     MOVE 3 TO WS-X
     MOVE 64 TO WS-Y
     MOVE -5 TO WS-Z
     MOVE 1 TO WS-P0
     MOVE 2 TO WS-P1
     MOVE 300 TO WS-BLOCK
     CALL "PB-PUT-BLOCK-EVENT" USING PB-BUFFER WS-X WS-Y WS-Z WS-P0 WS-P1 WS-BLOCK
     MOVE "test level events BLOCK-EVENT put at (3, 64, -5) params 1 2 block 300" TO TL-CASE
     MOVE "000000ffffffb0400102ac02" TO TL-EXPECTED
     PERFORM CHECK-PUT
     MOVE 255 TO WS-P0
     MOVE 0 TO WS-P1
     CALL "PB-PUT-BLOCK-EVENT" USING PB-BUFFER WS-X WS-Y WS-Z WS-P0 WS-P1 WS-BLOCK
     MOVE "test level events BLOCK-EVENT put accepts parameter 255" TO TL-CASE
     MOVE "000000ffffffb040ff00ac02" TO TL-EXPECTED
     PERFORM CHECK-PUT
     MOVE 256 TO WS-P0
     CALL "PB-PUT-BLOCK-EVENT" USING PB-BUFFER WS-X WS-Y WS-Z WS-P0 WS-P1 WS-BLOCK
     MOVE "test level events BLOCK-EVENT put of parameter 256 sets PB-ERROR, appends nothing"
         TO TL-CASE
     MOVE "ERROR" TO TL-EXPECTED
     PERFORM CHECK-PUT
     MOVE -1 TO WS-P0
     CALL "PB-PUT-BLOCK-EVENT" USING PB-BUFFER WS-X WS-Y WS-Z WS-P0 WS-P1 WS-BLOCK
     MOVE "test level events BLOCK-EVENT put of parameter -1 sets PB-ERROR, appends nothing"
         TO TL-CASE
     MOVE "ERROR" TO TL-EXPECTED
     PERFORM CHECK-PUT
     MOVE 1 TO WS-P0
     MOVE 256 TO WS-P1
     CALL "PB-PUT-BLOCK-EVENT" USING PB-BUFFER WS-X WS-Y WS-Z WS-P0 WS-P1 WS-BLOCK
     MOVE "test level events BLOCK-EVENT put of second parameter 256 sets PB-ERROR" TO TL-CASE
     MOVE "ERROR" TO TL-EXPECTED
     PERFORM CHECK-PUT
     MOVE -1 TO WS-P1
     CALL "PB-PUT-BLOCK-EVENT" USING PB-BUFFER WS-X WS-Y WS-Z WS-P0 WS-P1 WS-BLOCK
     MOVE "test level events BLOCK-EVENT put of second parameter -1 sets PB-ERROR" TO TL-CASE
     MOVE "ERROR" TO TL-EXPECTED
     PERFORM CHECK-PUT
     MOVE 2 TO WS-P1
     MOVE -1 TO WS-BLOCK
     CALL "PB-PUT-BLOCK-EVENT" USING PB-BUFFER WS-X WS-Y WS-Z WS-P0 WS-P1 WS-BLOCK
     MOVE "test level events BLOCK-EVENT put of block -1 sets PB-ERROR, appends nothing" TO TL-CASE
     MOVE "ERROR" TO TL-EXPECTED
     PERFORM CHECK-PUT
     MOVE "00 00 00 ff ff ff b0 40 ff 07 ac 02" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-BLOCK-EVENT" USING PB-BUFFER WS-X WS-Y WS-Z WS-P0 WS-P1 WS-BLOCK
     PERFORM START-OBS
     MOVE WS-X TO WS-EDIT
     PERFORM ADD-NUM
     MOVE WS-Y TO WS-EDIT
     PERFORM ADD-NUM
     MOVE WS-Z TO WS-EDIT
     PERFORM ADD-NUM
     MOVE WS-P0 TO WS-EDIT
     PERFORM ADD-NUM
     MOVE WS-P1 TO WS-EDIT
     PERFORM ADD-NUM
     MOVE WS-BLOCK TO WS-EDIT
     PERFORM ADD-NUM
     MOVE "test level events BLOCK-EVENT get reads the six fields" TO TL-CASE
     MOVE "3 64 -5 255 7 300 ok" TO TL-EXPECTED
     PERFORM END-GET
     MOVE "00 00 00 ff ff ff b0 40 ff 07 ac" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-BLOCK-EVENT" USING PB-BUFFER WS-X WS-Y WS-Z WS-P0 WS-P1 WS-BLOCK
     PERFORM START-OBS
     COMPUTE WS-EDIT = WS-X + WS-Y + WS-Z + WS-P0 + WS-P1 + WS-BLOCK
     PERFORM ADD-NUM
     MOVE "test level events BLOCK-EVENT get with a cut VarInt fails with zeros" TO TL-CASE
     MOVE "0 e1 p0" TO TL-EXPECTED
     PERFORM END-GET
*>   ---- Block Entity Data ----
     MOVE -8 TO WS-X
     MOVE 70 TO WS-Y
     MOVE 21 TO WS-Z
     MOVE 7 TO WS-BE-TYPE
     MOVE "0a 01 00 01 61 05 00" TO WS-HEX
     PERFORM NBT-FROM-HEX
     CALL "PB-PUT-BLOCK-ENTITY-DATA" USING PB-BUFFER WS-X WS-Y WS-Z WS-BE-TYPE WS-NBT WS-NBT-LEN
     MOVE "test level events BLOCK-ENTITY-DATA put of a compound at (-8, 70, 21) type 7" TO TL-CASE
     MOVE "fffffe0000015046070a010001610500" TO TL-EXPECTED
     PERFORM CHECK-PUT
     MOVE -1 TO WS-BE-TYPE
     CALL "PB-PUT-BLOCK-ENTITY-DATA" USING PB-BUFFER WS-X WS-Y WS-Z WS-BE-TYPE WS-NBT WS-NBT-LEN
     MOVE "test level events BLOCK-ENTITY-DATA put of type -1 sets PB-ERROR, appends nothing"
         TO TL-CASE
     MOVE "ERROR" TO TL-EXPECTED
     PERFORM CHECK-PUT
     MOVE 7 TO WS-BE-TYPE
     MOVE 0 TO WS-NBT-LEN
     CALL "PB-PUT-BLOCK-ENTITY-DATA" USING PB-BUFFER WS-X WS-Y WS-Z WS-BE-TYPE WS-NBT WS-NBT-LEN
     MOVE "test level events BLOCK-ENTITY-DATA put of no data sets PB-ERROR, appends nothing"
         TO TL-CASE
     MOVE "ERROR" TO TL-EXPECTED
     PERFORM CHECK-PUT
     MOVE "08 00 02 68 69" TO WS-HEX
     PERFORM NBT-FROM-HEX
     CALL "PB-PUT-BLOCK-ENTITY-DATA" USING PB-BUFFER WS-X WS-Y WS-Z WS-BE-TYPE WS-NBT WS-NBT-LEN
     MOVE "test level events BLOCK-ENTITY-DATA put of a string tag sets PB-ERROR" TO TL-CASE
     MOVE "ERROR" TO TL-EXPECTED
     PERFORM CHECK-PUT
     MOVE "00" TO WS-HEX
     PERFORM NBT-FROM-HEX
     CALL "PB-PUT-BLOCK-ENTITY-DATA" USING PB-BUFFER WS-X WS-Y WS-Z WS-BE-TYPE WS-NBT WS-NBT-LEN
     MOVE "test level events BLOCK-ENTITY-DATA put of a lone End tag sets PB-ERROR" TO TL-CASE
     MOVE "ERROR" TO TL-EXPECTED
     PERFORM CHECK-PUT
     MOVE "0a 00 ff" TO WS-HEX
     PERFORM NBT-FROM-HEX
     CALL "PB-PUT-BLOCK-ENTITY-DATA" USING PB-BUFFER WS-X WS-Y WS-Z WS-BE-TYPE WS-NBT WS-NBT-LEN
     MOVE "test level events BLOCK-ENTITY-DATA put of a compound with a trailing byte sets PB-ERROR"
         TO TL-CASE
     MOVE "ERROR" TO TL-EXPECTED
     PERFORM CHECK-PUT
     MOVE "0a 01 00" TO WS-HEX
     PERFORM NBT-FROM-HEX
     CALL "PB-PUT-BLOCK-ENTITY-DATA" USING PB-BUFFER WS-X WS-Y WS-Z WS-BE-TYPE WS-NBT WS-NBT-LEN
     MOVE "test level events BLOCK-ENTITY-DATA put of a cut compound sets PB-ERROR" TO TL-CASE
     MOVE "ERROR" TO TL-EXPECTED
     PERFORM CHECK-PUT
     MOVE "ff ff fe 00 00 01 50 46 07 0a 01 00 01 61 05 00" TO WS-HEX
     PERFORM FILL
     MOVE 64 TO WS-NBT-CAP
     CALL "PB-GET-BLOCK-ENTITY-DATA" USING PB-BUFFER WS-X WS-Y WS-Z WS-BE-TYPE WS-NBT WS-NBT-CAP
         WS-NBT-LEN
     PERFORM START-OBS
     MOVE WS-X TO WS-EDIT
     PERFORM ADD-NUM
     MOVE WS-Y TO WS-EDIT
     PERFORM ADD-NUM
     MOVE WS-Z TO WS-EDIT
     PERFORM ADD-NUM
     MOVE WS-BE-TYPE TO WS-EDIT
     PERFORM ADD-NUM
     MOVE WS-NBT-LEN TO WS-EDIT
     PERFORM ADD-NUM
     STRING " " FUNCTION LOWER-CASE(FUNCTION HEX-OF(WS-NBT(1:WS-NBT-LEN))) DELIMITED BY SIZE
         INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE "test level events BLOCK-ENTITY-DATA get reads the position, type and compound bytes"
         TO TL-CASE
     MOVE "-8 70 21 7 7 0a010001610500 ok" TO TL-EXPECTED
     PERFORM END-GET
     MOVE "ff ff fe 00 00 01 50 46 07 0a 01 00 01 61 05 00" TO WS-HEX
     PERFORM FILL
     MOVE 6 TO WS-NBT-CAP
     CALL "PB-GET-BLOCK-ENTITY-DATA" USING PB-BUFFER WS-X WS-Y WS-Z WS-BE-TYPE WS-NBT WS-NBT-CAP
         WS-NBT-LEN
     PERFORM START-OBS
     COMPUTE WS-EDIT = WS-X + WS-Y + WS-Z + WS-BE-TYPE + WS-NBT-LEN
     PERFORM ADD-NUM
     MOVE "test level events BLOCK-ENTITY-DATA get of a compound above the capacity fails" TO TL-CASE
     MOVE "0 e1 p0" TO TL-EXPECTED
     PERFORM END-GET
     MOVE "ff ff fe 00 00 01 50 46 07 00" TO WS-HEX
     PERFORM FILL
     MOVE 64 TO WS-NBT-CAP
     CALL "PB-GET-BLOCK-ENTITY-DATA" USING PB-BUFFER WS-X WS-Y WS-Z WS-BE-TYPE WS-NBT WS-NBT-CAP
         WS-NBT-LEN
     PERFORM START-OBS
     COMPUTE WS-EDIT = WS-X + WS-Y + WS-Z + WS-BE-TYPE + WS-NBT-LEN
     PERFORM ADD-NUM
     MOVE "test level events BLOCK-ENTITY-DATA get of a lone End tag fails" TO TL-CASE
     MOVE "0 e1 p0" TO TL-EXPECTED
     PERFORM END-GET
     MOVE "ff ff fe 00 00 01 50 46 07 08 00 02 68 69" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-BLOCK-ENTITY-DATA" USING PB-BUFFER WS-X WS-Y WS-Z WS-BE-TYPE WS-NBT WS-NBT-CAP
         WS-NBT-LEN
     PERFORM START-OBS
     COMPUTE WS-EDIT = WS-X + WS-Y + WS-Z + WS-BE-TYPE + WS-NBT-LEN
     PERFORM ADD-NUM
     MOVE "test level events BLOCK-ENTITY-DATA get of a string tag fails" TO TL-CASE
     MOVE "0 e1 p0" TO TL-EXPECTED
     PERFORM END-GET
     MOVE "ff ff fe 00 00 01 50 46 ff ff ff ff 0f 0a 00" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-BLOCK-ENTITY-DATA" USING PB-BUFFER WS-X WS-Y WS-Z WS-BE-TYPE WS-NBT WS-NBT-CAP
         WS-NBT-LEN
     PERFORM START-OBS
     COMPUTE WS-EDIT = WS-X + WS-Y + WS-Z + WS-BE-TYPE + WS-NBT-LEN
     PERFORM ADD-NUM
     MOVE "test level events BLOCK-ENTITY-DATA get of type -1 fails" TO TL-CASE
     MOVE "0 e1 p0" TO TL-EXPECTED
     PERFORM END-GET
     MOVE "ff ff fe 00 00 01 50 46" TO WS-HEX
     PERFORM FILL
     CALL "PB-GET-BLOCK-ENTITY-DATA" USING PB-BUFFER WS-X WS-Y WS-Z WS-BE-TYPE WS-NBT WS-NBT-CAP
         WS-NBT-LEN
     PERFORM START-OBS
     COMPUTE WS-EDIT = WS-X + WS-Y + WS-Z + WS-BE-TYPE + WS-NBT-LEN
     PERFORM ADD-NUM
     MOVE "test level events BLOCK-ENTITY-DATA get without type and data fails" TO TL-CASE
     MOVE "0 e1 p0" TO TL-EXPECTED
     PERFORM END-GET
*>   ---- Particle ----
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 26
         MOVE WS-PT-HEX(WS-I) TO WS-HEX
         PERFORM FILL
         CALL "TEST-BUFFER-HEX" USING PB-BUFFER WS-HEX-A
         CALL "PB-GET-PARTICLE" USING PB-BUFFER WS-TYPE WS-LEN WS-DATA
         PERFORM START-OBS
         MOVE WS-TYPE TO WS-EDIT
         PERFORM ADD-NUM
         MOVE WS-LEN TO WS-EDIT
         PERFORM ADD-NUM
         MOVE SPACES TO TL-CASE
         STRING "test level events PARTICLE get of " FUNCTION TRIM(WS-PT-HEX(WS-I))
             DELIMITED BY SIZE INTO TL-CASE
         STRING FUNCTION TRIM(WS-PT-EXPECT(WS-I)) " ok" DELIMITED BY SIZE INTO TL-EXPECTED
         PERFORM END-GET
         CALL "PB-RESET" USING PK-BUFFER
         CALL "PB-PUT-PARTICLE" USING PK-BUFFER WS-TYPE WS-LEN WS-DATA
         CALL "TEST-BUFFER-HEX" USING PK-BUFFER WS-HEX-B
         MOVE SPACES TO TL-CASE
         STRING "test level events PARTICLE put of " FUNCTION TRIM(WS-PT-HEX(WS-I))
             " re-encodes the same bytes" DELIMITED BY SIZE INTO TL-CASE
         MOVE "T" TO TL-MODE
         MOVE WS-HEX-A TO TL-EXPECTED
         MOVE WS-HEX-B TO TL-OBSERVED
         CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     END-PERFORM
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 15
         MOVE WS-BP-HEX(WS-I) TO WS-HEX
         PERFORM FILL
         MOVE 77 TO WS-TYPE
         MOVE 77 TO WS-LEN
         MOVE SPACES TO WS-DATA
         CALL "PB-GET-PARTICLE" USING PB-BUFFER WS-TYPE WS-LEN WS-DATA
         PERFORM START-OBS
         COMPUTE WS-EDIT = WS-TYPE + WS-LEN
         PERFORM ADD-NUM
         MOVE SPACES TO TL-CASE
         STRING "test level events PARTICLE get of [" FUNCTION TRIM(WS-BP-HEX(WS-I))
             "] fails" DELIMITED BY SIZE INTO TL-CASE
         MOVE "0 e1 p0" TO TL-EXPECTED
         PERFORM END-GET
     END-PERFORM
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 10
         MOVE WS-BU-HEX(WS-I) TO WS-HEX
         CALL "TEST-FILL-HEX" USING WS-HEX PK-BUFFER
         MOVE SPACES TO WS-DATA
         IF PK-LENGTH > 0
             CALL "PB-GET-BYTES" USING PK-BUFFER WS-DATA PK-LENGTH
         END-IF
         MOVE FUNCTION NUMVAL(WS-BU-TYPE(WS-I)) TO WS-TYPE
         MOVE FUNCTION NUMVAL(WS-BU-LEN(WS-I)) TO WS-LEN
         CALL "PB-PUT-PARTICLE" USING PB-BUFFER WS-TYPE WS-LEN WS-DATA
         MOVE SPACES TO TL-CASE
         STRING "test level events PARTICLE put of type " FUNCTION TRIM(WS-BU-TYPE(WS-I))
             " length " FUNCTION TRIM(WS-BU-LEN(WS-I)) " sets PB-ERROR, appends nothing" DELIMITED BY SIZE INTO TL-CASE
         MOVE "ERROR" TO TL-EXPECTED
         PERFORM CHECK-PUT
     END-PERFORM
*>   ---- Level Particles ----
     MOVE 21 TO PB-LP-TYPE
     MOVE 8 TO PB-LP-DATA-LENGTH
     MOVE "00 ff 00 00 40 00 00 00" TO WS-HEX
