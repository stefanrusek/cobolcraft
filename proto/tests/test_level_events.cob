*> Implementation test of the level packets of proto/src/level-events.cob: Level Event (05a 0x2F), Block
*> Event (0x07), Block Entity Data (0x06), the Particle composite and Level Particles (0x30), the
*> CommonPlayerSpawnInfo composite, Login (0x32) and Respawn (05b 0x54). A writer that cannot encode a
*> value appends nothing and sets PB-ERROR; a failed read leaves PB-POS where it was and yields an
*> all-zero value. Expected bytes are written out by hand from the field tables of the documents.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-LEVEL-EVENTS.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY PROTO.
 COPY PBLEVEL.
 COPY PROTO REPLACING LEADING ==PB-== BY ==PK-==.
 COPY TESTLIB.
 01 WS-CAPACITY            BINARY-LONG VALUE 64.
 01 WS-HEX                 PIC X(1024).
 01 WS-HEX-A               PIC X(1024).
 01 WS-HEX-B               PIC X(1024).
 01 WS-EDIT                PIC -(9)9.
 01 WS-FLT                 PIC -(5)9.99.
 01 WS-PTR                 BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-X                   BINARY-LONG.
 01 WS-Y                   BINARY-LONG.
 01 WS-Z                   BINARY-LONG.
 01 WS-EVENT               BINARY-LONG.
 01 WS-DATA-INT            BINARY-LONG.
 01 WS-GLOBAL              BINARY-LONG.
 01 WS-P0                  BINARY-LONG.
 01 WS-P1                  BINARY-LONG.
 01 WS-BLOCK               BINARY-LONG.
 01 WS-BE-TYPE             BINARY-LONG.
 01 WS-NBT                 PIC X(64).
 01 WS-NBT-LEN             BINARY-LONG.
 01 WS-NBT-CAP             BINARY-LONG.
 01 WS-TYPE                BINARY-LONG.
 01 WS-LEN                 BINARY-LONG.
 01 WS-DATA                PIC X(64).
 01 WS-KEEP                BINARY-LONG.
 01 WS-PARTICLE-TABLE.
    05 FILLER PIC X(10)  VALUE "0 0".
    05 FILLER PIC X(150) VALUE "00".
    05 FILLER PIC X(10)  VALUE "3 0".
    05 FILLER PIC X(150) VALUE "03".
    05 FILLER PIC X(10)  VALUE "127 0".
    05 FILLER PIC X(150) VALUE "7f".
    05 FILLER PIC X(10)  VALUE "1 3".
    05 FILLER PIC X(150) VALUE "01 8a 97 02".
    05 FILLER PIC X(10)  VALUE "2 1".
    05 FILLER PIC X(150) VALUE "02 05".
    05 FILLER PIC X(10)  VALUE "7 4".
    05 FILLER PIC X(150) VALUE "07 00 00 00 03".
    05 FILLER PIC X(10)  VALUE "8 8".
    05 FILLER PIC X(150) VALUE "08 00 00 00 03 40 00 00 00".
    05 FILLER PIC X(10)  VALUE "9 8".
    05 FILLER PIC X(150) VALUE "09 ff ff ff ff 3f 80 00 00".
    05 FILLER PIC X(10)  VALUE "10 4".
    05 FILLER PIC X(150) VALUE "0a 00 00 00 01".
    05 FILLER PIC X(10)  VALUE "15 4".
    05 FILLER PIC X(150) VALUE "0f 3f 80 00 00".
    05 FILLER PIC X(10)  VALUE "21 8".
    05 FILLER PIC X(150) VALUE "15 00 ff 00 00 40 00 00 00".
    05 FILLER PIC X(10)  VALUE "22 12".
    05 FILLER PIC X(150) VALUE "16 00 ff 00 00 00 00 ff 00 3f 80 00 00".
    05 FILLER PIC X(10)  VALUE "23 8".
    05 FILLER PIC X(150) VALUE "17 ff ff 00 00 3f 80 00 00".
    05 FILLER PIC X(10)  VALUE "28 4".
    05 FILLER PIC X(150) VALUE "1c ff 00 ff 00".
    05 FILLER PIC X(10)  VALUE "36 1".
    05 FILLER PIC X(150) VALUE "24 7f".
    05 FILLER PIC X(10)  VALUE "46 4".
    05 FILLER PIC X(150) VALUE "2e 80 80 80 80".
    05 FILLER PIC X(10)  VALUE "48 4".
    05 FILLER PIC X(150) VALUE "30 3f 80 00 00".
    05 FILLER PIC X(10)  VALUE "52 4".
    05 FILLER PIC X(150) VALUE "34 ff ff ff ff".
    05 FILLER PIC X(10)  VALUE "56 8".
    05 FILLER PIC X(150) VALUE "38 00 11 22 33 40 00 00 00".
    05 FILLER PIC X(10)  VALUE "57 4".
    05 FILLER PIC X(150) VALUE "39 02 01 00 00".
    05 FILLER PIC X(10)  VALUE "58 10".
    05 FILLER PIC X(150) VALUE "3a 00 00 00 00 00 00 00 00 00 14".
    05 FILLER PIC X(10)  VALUE "58 7".
    05 FILLER PIC X(150) VALUE "3a 01 05 3f 80 00 00 14".
    05 FILLER PIC X(10)  VALUE "59 29".
    05 FILLER PIC X(150) VALUE
       "3b 3f f0 00 00 00 00 00 00 40 00 00 00 00 00 00 00 40 08 00 00 00 00 00 00 00 ff 00 00 05".
    05 FILLER PIC X(10)  VALUE "115 1".
    05 FILLER PIC X(150) VALUE "73 05".
    05 FILLER PIC X(10)  VALUE "121 2".
    05 FILLER PIC X(150) VALUE "79 8a 07".
    05 FILLER PIC X(10)  VALUE "125 1".
    05 FILLER PIC X(150) VALUE "7d 09".
 01 WS-PARTICLES REDEFINES WS-PARTICLE-TABLE.
    05 WS-PT                  OCCURS 26 TIMES.
       10 WS-PT-EXPECT        PIC X(10).
       10 WS-PT-HEX           PIC X(150).
 01 WS-BAD-PARTICLE-TABLE.
    05 FILLER PIC X(150) VALUE " ".
    05 FILLER PIC X(150) VALUE "80 01".
    05 FILLER PIC X(150) VALUE "ff ff ff ff 0f".
    05 FILLER PIC X(150) VALUE "15 00 ff 00 00 40 00".
    05 FILLER PIC X(150) VALUE "01".
    05 FILLER PIC X(150) VALUE "01 80 80 80 80 80 80".
    05 FILLER PIC X(150) VALUE "39 02 01 01 00".
    05 FILLER PIC X(150) VALUE "39 02 01 00".
