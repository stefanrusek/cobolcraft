*> Implementation test of client/src/atlas.cob (ATLAS-BUILD, ATLAS-FIND, ATLAS-UV, MISSING-TEXTURE;
*> 08 §7.2, §7.3, §10.2; standin-content §1.4.2): the block and item atlas definitions of the packs
*> collect the block sprites, which are stitched into the block atlas (texture 0) with lookup by
*> sprite id and texture coordinates by sprite; sprite 1 is the missing-texture stripes, generated by
*> the client (at any size by the same formula) and used for every unresolved sprite id (ATLAS-FIND
*> gives 0); a sprite with partial alpha is translucent (08 §5.3).
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-ATLAS.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CLSTATE.
 COPY TESTLIB.
 01 WS-NAME                PIC X(80).
 01 WS-NAME-LENGTH         BINARY-LONG.
 01 WS-SPRITE              BINARY-LONG.
 01 WS-SPRITE2             BINARY-LONG.
 01 WS-SPRITE3             BINARY-LONG.
 01 WS-FIXTURE             PIC X(256).
 01 WS-REFERENCE           PIC X(1024).
 01 WS-CAPACITY            BINARY-LONG VALUE 1024.
 01 WS-LENGTH              BINARY-LONG.
 01 WS-DIFF                BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-Y                   BINARY-LONG.
 01 WS-U16                 FLOAT-SHORT.
 01 WS-V16                 FLOAT-SHORT.
 01 WS-U                   FLOAT-SHORT.
 01 WS-V                   FLOAT-SHORT.
 01 WS-EDIT                PIC -9.9(5).
 01 WS-EDIT2               PIC -9.9(5).
 01 WS-SMALL               PIC X(64).
 01 WS-FOUR                BINARY-LONG VALUE 4.
 01 WS-FOUR2               BINARY-LONG VALUE 4.
 01 WS-HEX                 PIC X(1024).
 01 WS-SIXTY-FOUR          BINARY-LONG VALUE 64.
 01 B-ATLAS                PIC X(1073741824) BASED.
 PROCEDURE DIVISION.
     CALL "CL-INIT" USING CLIENT-STATE
     CALL "PACK-STACK-INIT" USING CLIENT-STATE
     CALL "ATLAS-BUILD" USING CLIENT-STATE
     CALL "ATLAS-BUILD" USING CLIENT-STATE
     SET ADDRESS OF B-ATLAS TO AT-ADDR
     MOVE "atlas the built-in pack gives 15 block sprites and 6 item sprites (items.json) after the "
         & "missing sprite; the atlas is marked for upload" TO TL-CASE
     MOVE "N" TO TL-MODE
     MOVE 221 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = AT-SPRITE-COUNT * 10 + AT-UPLOAD(1)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "missing" TO WS-NAME
     MOVE 1 TO WS-SPRITE
     PERFORM COMPARE-SPRITE
     MOVE "atlas sprite 1 is the missing texture of standin-content §1.4.2, generated by the client"
         TO TL-CASE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "cobolcraft:block/greystone" TO WS-NAME
     MOVE 26 TO WS-NAME-LENGTH
     CALL "ATLAS-FIND" USING CLIENT-STATE WS-NAME WS-NAME-LENGTH WS-SPRITE
     MOVE "greystone" TO WS-NAME
     PERFORM COMPARE-SPRITE
     MOVE "atlas sprite cobolcraft:block/greystone is found and its atlas pixels equal the texture"
         TO TL-CASE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "cobolcraft:block/lucite" TO WS-NAME
     MOVE 23 TO WS-NAME-LENGTH
     CALL "ATLAS-FIND" USING CLIENT-STATE WS-NAME WS-NAME-LENGTH WS-SPRITE2
     MOVE "cobolcraft:block/nothing" TO WS-NAME
     MOVE 24 TO WS-NAME-LENGTH
     CALL "ATLAS-FIND" USING CLIENT-STATE WS-NAME WS-NAME-LENGTH WS-SPRITE3
     MOVE "atlas lucite is translucent, greystone is not, an unknown sprite id is not found"
         TO TL-CASE
     MOVE 100 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = AT-TRANSLUCENT(WS-SPRITE2) * 100 + AT-TRANSLUCENT(WS-SPRITE) * 10
         + WS-SPRITE3
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE 8 TO WS-U16
     MOVE 16 TO WS-V16
     CALL "ATLAS-UV" USING CLIENT-STATE WS-SPRITE WS-U16 WS-V16 WS-U WS-V
     MOVE "atlas texture coordinates of sprite (8, 16) are (x + 8, y + 16) / atlas size" TO TL-CASE
     MOVE "T" TO TL-MODE
     COMPUTE WS-EDIT ROUNDED = (AT-X(WS-SPRITE) + 8) / AT-W
     COMPUTE WS-EDIT2 ROUNDED = (AT-Y(WS-SPRITE) + 16) / AT-H
     MOVE SPACES TO TL-EXPECTED TL-OBSERVED
     STRING WS-EDIT " " WS-EDIT2 DELIMITED BY SIZE INTO TL-EXPECTED
     COMPUTE WS-EDIT ROUNDED = WS-U
     COMPUTE WS-EDIT2 ROUNDED = WS-V
     STRING WS-EDIT " " WS-EDIT2 DELIMITED BY SIZE INTO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     CALL "MISSING-TEXTURE" USING WS-FOUR WS-FOUR2 WS-SMALL
     CALL "TEST-HEX-OF" USING WS-SMALL WS-SIXTY-FOUR WS-HEX
     MOVE "atlas the missing texture at 4 x 4 follows the same stripe formula" TO TL-CASE
     MOVE "f28c28fff28c28ff1a1a1aff1a1a1aff" & "f28c28ff1a1a1aff1a1a1afff28c28ff"
         & "1a1a1aff1a1a1afff28c28fff28c28ff" & "1a1a1afff28c28fff28c28ff1a1a1aff" TO TL-EXPECTED
     MOVE WS-HEX TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 COMPARE-SPRITE.
     MOVE SPACES TO WS-FIXTURE
     STRING "client/tests/fixtures/textures/" FUNCTION TRIM(WS-NAME) ".rgba" DELIMITED BY SIZE
         INTO WS-FIXTURE
     CALL "TEST-READ-FILE" USING WS-FIXTURE WS-REFERENCE WS-CAPACITY WS-LENGTH
     MOVE 0 TO WS-DIFF
     PERFORM VARYING WS-Y FROM 0 BY 1 UNTIL WS-Y > 15
         COMPUTE WS-I = ((AT-Y(WS-SPRITE) + WS-Y) * AT-W + AT-X(WS-SPRITE)) * 4 + 1
         IF B-ATLAS(WS-I:64) NOT = WS-REFERENCE(WS-Y * 64 + 1:64)
             ADD 1 TO WS-DIFF
         END-IF
     END-PERFORM
     MOVE "N" TO TL-MODE
     MOVE 161600 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = AT-SW(WS-SPRITE) * 10000 + AT-SH(WS-SPRITE) * 100 + WS-DIFF.
 END PROGRAM TEST-ATLAS.
 COPY CLTEST.
