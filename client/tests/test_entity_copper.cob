 *> Copper golem walk (34-3 9.2, Appendix A COPPER_GOLEM_WALK): the row is code W and ENTITY-POSE-MORE runs EM3-COPPER-ANIM with the walk state: at walk position 0 and speed 1
*> the arms are at the first key (right arm 70, left arm -80 degrees about x), the head at -10 degrees; a golem that stands still keeps the rest pose.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-ENTITY-COPPER.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CLSTATE.
 COPY CLCONST.
 COPY CONTENT.
 COPY CLMODELS.
 COPY CLEMM.
 COPY TESTLIB.
 01 WS-KEY                 PIC X(112).
 01 WS-KEY20               PIC X(20).
 01 WS-KEY24               PIC X(24).
 01 WS-ROW-AREA            PIC X(66).
 01 WS-STATUS              BINARY-LONG.
 01 WS-TYPE                BINARY-LONG.
 01 WS-X                   FLOAT-LONG VALUE 10.5.
 01 WS-Y                   FLOAT-LONG VALUE 64.
 01 WS-Z                   FLOAT-LONG VALUE 10.5.
 01 WS-YAW                 FLOAT-SHORT VALUE 0.
 01 WS-ID                  BINARY-LONG.
 01 WS-J                   BINARY-LONG.
 01 WS-MODEL               BINARY-LONG.
 01 WS-RA                  BINARY-LONG.
 01 WS-LA                  BINARY-LONG.
 01 WS-HEAD                BINARY-LONG.
 01 WS-AGE                 FLOAT-LONG VALUE 0.
 01 WS-DIFF                FLOAT-LONG.
 01 WS-SUM1                FLOAT-LONG.
 01 WS-SUM2                FLOAT-LONG.
 01 WS-IN.
    05 WS-IV               FLOAT-LONG OCCURS 16 TIMES.
 01 WS-EYE-TABLE.
    05 WS-EYE              FLOAT-LONG OCCURS 3 TIMES.
 PROCEDURE DIVISION.
     CALL "CL-INIT" USING CLIENT-STATE
     MOVE 0 TO PK-COUNT
     CALL "ENTITY-ATLAS-BUILD" USING CLIENT-STATE
     MOVE 256 TO PL-HEIGHT
     MOVE 0 TO SK-U
     MOVE 10 TO WS-EYE(1) WS-EYE(3)
     MOVE 64 TO WS-EYE(2)
     MOVE 1 TO CT-OPEN
     MOVE CT-TYPE-STANDARD TO CT-SET-TYPE
     MOVE "copper_golem" TO WS-KEY24
     CALL "ENTITY-MODEL-FIND" USING WS-KEY24 WS-MODEL
     MOVE "acceptance copper golem row is code W" TO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE "W" TO TL-EXPECTED
     MOVE CL-MD-ANIM(WS-MODEL) TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "ENTITY-MODEL-BUILD" USING EMM-MODEL WS-MODEL WS-STATUS
     MOVE "right_arm" TO WS-KEY24
     CALL "EMM-FIND" USING EMM-MODEL WS-KEY24 WS-RA
     MOVE "left_arm" TO WS-KEY24
     CALL "EMM-FIND" USING EMM-MODEL WS-KEY24 WS-LA
     MOVE "head" TO WS-KEY24
     CALL "EMM-FIND" USING EMM-MODEL WS-KEY24 WS-HEAD
     MOVE "copper_golem" TO WS-KEY20
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > 16
         MOVE 0 TO WS-IV(WS-J)
     END-PERFORM
     MOVE 1 TO WS-IV(4)
     CALL "ENTITY-POSE-MORE" USING EMM-MODEL WS-KEY20 WS-IN WS-AGE
     MOVE "acceptance copper golem walking right arm" TO TL-CASE
     COMPUTE WS-DIFF = MM-CXROT(WS-RA) - 1.2217305
     PERFORM CHECK-SMALL
     MOVE "acceptance copper golem walking left arm" TO TL-CASE
     COMPUTE WS-DIFF = MM-CXROT(WS-LA) + 1.3962634
     PERFORM CHECK-SMALL
     MOVE "acceptance copper golem walking head" TO TL-CASE
     COMPUTE WS-DIFF = MM-CXROT(WS-HEAD) + 0.17453292
     PERFORM CHECK-SMALL
     MOVE 0 TO WS-IV(4)
     CALL "ENTITY-POSE-MORE" USING EMM-MODEL WS-KEY20 WS-IN WS-AGE
     MOVE "acceptance copper golem standing keeps the rest pose" TO TL-CASE
     COMPUTE WS-DIFF = MM-CXROT(WS-RA) + MM-CXROT(WS-LA) + MM-CXROT(WS-HEAD)
     PERFORM CHECK-SMALL
*>   Drawn: the walk state of the replica changes the vertices.
     CALL "ENTITIES-CLEAR" USING CLIENT-STATE
     MOVE 0 TO EA-MT-COUNT
     MOVE "copper_golem" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-TYPE WS-ROW-AREA WS-STATUS
     MOVE 1 TO WS-ID
     CALL "MM-SPAWN" USING CLIENT-STATE WS-ID WS-TYPE WS-X WS-Y WS-Z WS-YAW
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     PERFORM SUM-MESH
     MOVE WS-SUM2 TO WS-SUM1
     MOVE 1 TO EN-WALK-SPEED(1)
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     PERFORM SUM-MESH
     MOVE "acceptance copper golem walking draws other vertices" TO TL-CASE
     MOVE "N" TO TL-MODE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF WS-SUM2 - WS-SUM1 > 0.001 OR WS-SUM1 - WS-SUM2 > 0.001
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.
 SUM-MESH.
     MOVE 0 TO WS-SUM2
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > RL-EN-COUNT
         COMPUTE WS-SUM2 = WS-SUM2 + RL-EN-Y(WS-J) + RL-EN-X(WS-J) + RL-EN-Z(WS-J)
     END-PERFORM.
 CHECK-SMALL.
     MOVE "N" TO TL-MODE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF WS-DIFF < 0.00001 AND WS-DIFF > -0.00001
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-ENTITY-COPPER.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. MM-SPAWN.
*> USING CLIENT-STATE, entity id, type (registry id), x y z (FLOAT-LONG), yaw (FLOAT-SHORT, also the head yaw): Add Entity.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY PROTO.
 01 WS-READY               BINARY-LONG VALUE 0.
 01 WS-CAPACITY            BINARY-LONG VALUE 1024.
 01 WS-ADD                 BINARY-LONG VALUE 1.
 01 WS-ZERO                BINARY-LONG VALUE 0.
 01 WS-UUID                PIC X(16) VALUE LOW-VALUES.
 01 WS-V0                  FLOAT-LONG VALUE 0.
 01 WS-V1                  FLOAT-LONG VALUE 0.
 01 WS-V2                  FLOAT-LONG VALUE 0.
 01 WS-A0                  FLOAT-SHORT VALUE 0.
 LINKAGE SECTION.
 COPY CLSTATE.
 01 L-ID                   BINARY-LONG.
 01 L-TYPE                 BINARY-LONG.
 01 L-X                    FLOAT-LONG.
 01 L-Y                    FLOAT-LONG.
 01 L-Z                    FLOAT-LONG.
 01 L-YAW                  FLOAT-SHORT.
 PROCEDURE DIVISION USING CLIENT-STATE L-ID L-TYPE L-X L-Y L-Z L-YAW.
     IF WS-READY = 0
         CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
         MOVE 1 TO WS-READY
     END-IF
     CALL "PB-RESET" USING PB-BUFFER
     CALL "PB-PUT-VARINT" USING PB-BUFFER L-ID
     CALL "PB-PUT-UUID" USING PB-BUFFER WS-UUID
     CALL "PB-PUT-VARINT" USING PB-BUFFER L-TYPE
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER L-X
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER L-Y
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER L-Z
     CALL "PB-PUT-LPVEC3" USING PB-BUFFER WS-V0 WS-V1 WS-V2
     CALL "PB-PUT-ANGLE" USING PB-BUFFER WS-A0
     CALL "PB-PUT-ANGLE" USING PB-BUFFER L-YAW
     CALL "PB-PUT-ANGLE" USING PB-BUFFER L-YAW
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-ZERO
     MOVE 0 TO PB-POS
     CALL "ENTITY-PACKET" USING CLIENT-STATE PB-BUFFER WS-ADD
     GOBACK.
 END PROGRAM MM-SPAWN.

