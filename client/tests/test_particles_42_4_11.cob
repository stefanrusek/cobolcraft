*> Acceptance test of docs/protocol/42-particles-4-block-item-dust-ambient.md section 11 (`SnowflakeParticle`): the rules, table rows,
*> formulas and worked cases of the section with the document's numbers; every float case compares
*> the value times 100000 rounded. Draws are injected through the draw tables.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-PARTICLES-42-4-11.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CLPCL.
 COPY CLPCLX.
 COPY TESTLIB.
 01 WS-NAME                PIC X(160).
 01 WS-DRAWS.
    05 WS-D                FLOAT-LONG OCCURS 16 TIMES.
 01 WS-EDRAWS.
    05 WS-E                FLOAT-LONG OCCURS 16 TIMES.
 01 W1                     FLOAT-LONG.
 01 W2                     FLOAT-LONG.
 01 W3                     FLOAT-LONG.
 01 W4                     FLOAT-LONG.
 01 W5                     FLOAT-LONG.
 01 W6                     FLOAT-LONG.
 01 W7                     FLOAT-LONG.
 01 W8                     FLOAT-LONG.
 01 I1                     BINARY-LONG.
 01 I2                     BINARY-LONG.
 01 I3                     BINARY-LONG.
 01 I4                     BINARY-LONG.
 01 I5                     BINARY-LONG.
 01 B1                     BINARY-DOUBLE.
 01 T1                     PIC X(80).
 01 Z1                     FLOAT-LONG VALUE 0.
 01 Z2                     FLOAT-LONG VALUE 0.
 01 Z3                     FLOAT-LONG VALUE 0.
 01 Z4                     FLOAT-LONG VALUE 0.
 01 Z5                     FLOAT-LONG VALUE 0.
 01 Z6                     FLOAT-LONG VALUE 0.
 PROCEDURE DIVISION.
     PERFORM VARYING I1 FROM 1 BY 1 UNTIL I1 > 16
         MOVE 0.5 TO WS-D(I1)
     END-PERFORM
     MOVE 100 TO W2
     MOVE 0.1 TO W4
     MOVE -0.1 TO W6
     MOVE 0.75 TO WS-D(3)
     CALL "P4-SNOW-NEW" USING PCL Z1 W2 Z3 W4 Z5 W6 WS-DRAWS
     MOVE "11 gravity 0.225" TO WS-NAME
     MOVE 22500 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-GRAVITY) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "11 friction 1.0" TO WS-NAME
     MOVE 100000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-FRICTION) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "11 xd = vx + (draw * 2 - 1) * 0.05 (0.75 gives +0.025)" TO WS-NAME
     MOVE 12500 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-XD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "11 yd = vy + (0.5 * 2 - 1) * 0.05" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-YD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "11 zd = vz" TO WS-NAME
     MOVE -10000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-ZD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "11 quad size assigned 0.1 * (r1 * r2 + 1)" TO WS-NAME
     MOVE 12500 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-QUAD-SIZE) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "11 example 8: lifetime (int)(16 / 0.6) + 2 = 28" TO WS-NAME
     MOVE 28 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-LIFETIME
     PERFORM ASSERT-NUMBER
     MOVE "11 colour red" TO WS-NAME
     MOVE 92300 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-RCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "11 colour green" TO WS-NAME
     MOVE 96400 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-GCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "11 colour blue" TO WS-NAME
     MOVE 99900 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-BCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 0 TO PC-XD
     MOVE 0 TO PC-ZD
     MOVE 0 TO PK-COUNT
     MOVE 8 TO I2
     CALL "P4-SNOW-TICK" USING PCL PCL-COLLIDERS I2
     MOVE "11 tick 1: yd = (0 - 0.009) * 0.9 (example 8)" TO WS-NAME
     MOVE -810 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-YD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "11 tick 1: the move used -0.009 (y)" TO WS-NAME
     MOVE 9999100 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-Y) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     CALL "P4-SNOW-TICK" USING PCL PCL-COLLIDERS I2
     MOVE "11 tick 2: yd = -0.01539" TO WS-NAME
     MOVE -1539 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-YD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "11 tick 2: y" TO WS-NAME
     MOVE 9997390 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-Y) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 1 TO W3
     MOVE 1 TO PC-XD
     MOVE 1 TO PC-ZD
     CALL "P4-SNOW-TICK" USING PCL PCL-COLLIDERS I2
     MOVE "11 drag on x after the move: 0.949999988079071" TO WS-NAME
     MOVE 95000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-XD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "11 drag on z" TO WS-NAME
     MOVE 95000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-ZD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 1.0 TO WS-D(8)
     CALL "P4-SNOW-NEW" USING PCL Z1 W2 Z3 W4 Z5 W6 WS-DRAWS
     MOVE "11 lifetime upper end: (int)(16 / 1.0) + 2 = 18" TO WS-NAME
     MOVE 18 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-LIFETIME
     PERFORM ASSERT-NUMBER
     MOVE 0 TO WS-D(8)
     CALL "P4-SNOW-NEW" USING PCL Z1 W2 Z3 W4 Z5 W6 WS-DRAWS
     MOVE "11 lifetime lower end: (int)(16 / 0.2) + 2 = 82" TO WS-NAME
     MOVE 82 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-LIFETIME
     PERFORM ASSERT-NUMBER
     STOP RUN.

 ASSERT-NUMBER.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-4§11 `SnowflakeParticle`: " FUNCTION TRIM(WS-NAME)
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "N" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 ASSERT-TEXT.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-4§11 `SnowflakeParticle`: " FUNCTION TRIM(WS-NAME)
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "T" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-PARTICLES-42-4-11.
