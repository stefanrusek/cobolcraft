*> Acceptance test of docs/protocol/42-particles-4-block-item-dust-ambient.md section 6 (Dust family): the rules, table rows,
*> formulas and worked cases of the section with the document's numbers; every float case compares
*> the value times 100000 rounded. Draws are injected through the draw tables.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-PARTICLES-42-4-6.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CLPCL.
 COPY CLPCLX.
 COPY CLP4X.
 COPY TESTLIB.
 01 WS-NAME                PIC X(160).
 01 WS-DRAWS.
    05 WS-D                FLOAT-LONG OCCURS 16 TIMES.
 01 WS-EDRAWS.
    05 WS-E                FLOAT-LONG OCCURS 16 TIMES.
 01 W1                     FLOAT-LONG.
 01 W2                     FLOAT-LONG.
 01 W3                     FLOAT-LONG.
 01 W4                     FLOAT-LONG.
 01 W5                     FLOAT-LONG.
 01 W6                     FLOAT-LONG.
 01 W7                     FLOAT-LONG.
 01 W8                     FLOAT-LONG.
 01 I1                     BINARY-LONG.
 01 I2                     BINARY-LONG.
 01 I3                     BINARY-LONG.
 01 I4                     BINARY-LONG.
 01 I5                     BINARY-LONG.
 01 B1                     BINARY-DOUBLE.
 01 T1                     PIC X(80).
 01 Z1                     FLOAT-LONG VALUE 0.
 01 Z2                     FLOAT-LONG VALUE 0.
 01 Z3                     FLOAT-LONG VALUE 0.
 01 Z4                     FLOAT-LONG VALUE 0.
 01 Z5                     FLOAT-LONG VALUE 0.
 01 Z6                     FLOAT-LONG VALUE 0.
 01 WS-ARGB               BINARY-DOUBLE.
 01 WS-ARGB2              BINARY-DOUBLE.
 PROCEDURE DIVISION.
     PERFORM VARYING I1 FROM 1 BY 1 UNTIL I1 > 16
         MOVE 0.5 TO WS-D(I1)
     END-PERFORM
     MOVE 0.75 TO WS-D(2)
     MOVE 0 TO W1
     MOVE -0.375 TO W4
     MOVE 2.0 TO W7
     MOVE 0.5 TO W8
     CALL "P4-DUST-BASE-NEW" USING PCL Z1 Z2 Z3 Z4 Z5 Z6 W7 WS-DRAWS W8
     MOVE "example 4: base = (int)(8 / (0.5 * 0.8 + 0.2)) = 13, scale 2 gives lifetime 26" TO WS-NAME
     MOVE 26 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-LIFETIME
     PERFORM ASSERT-NUMBER
     MOVE "quad size = 0.15 * 0.75 * scale" TO WS-NAME
     MOVE 22500 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-QUAD-SIZE) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "friction 0.96" TO WS-NAME
     MOVE 96000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-FRICTION) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "speedUpWhenYMotionIsBlocked" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-SPEED-UP
     PERFORM ASSERT-NUMBER
     MOVE "burst x scaled to a tenth (0.2 jitter: 0.12 * 0.1)" TO WS-NAME
     MOVE 1200 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-XD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "burst y scaled to a tenth ((0 + 0.1) * 0.1)" TO WS-NAME
     MOVE 1000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-YD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 1.0 TO W7
     CALL "P4-DUST-BASE-NEW" USING PCL Z1 Z2 Z3 Z4 Z5 Z6 W7 WS-DRAWS W8
     MOVE "scale 1 with d = 0.5 gives lifetime 13" TO WS-NAME
     MOVE 13 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-LIFETIME
     PERFORM ASSERT-NUMBER
     MOVE 0 TO W8
     CALL "P4-DUST-BASE-NEW" USING PCL Z1 Z2 Z3 Z4 Z5 Z6 W7 WS-DRAWS W8
     MOVE "scale 1 with d = 0 gives lifetime 40" TO WS-NAME
     MOVE 40 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-LIFETIME
     PERFORM ASSERT-NUMBER
     MOVE 1.0 TO W8
     CALL "P4-DUST-BASE-NEW" USING PCL Z1 Z2 Z3 Z4 Z5 Z6 W7 WS-DRAWS W8
     MOVE "scale 1 with d = 1 gives lifetime 8" TO WS-NAME
     MOVE 8 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-LIFETIME
     PERFORM ASSERT-NUMBER
     MOVE 0.009999999776482582 TO W7
     MOVE 0.5 TO W8
     CALL "P4-DUST-BASE-NEW" USING PCL Z1 Z2 Z3 Z4 Z5 Z6 W7 WS-DRAWS W8
     MOVE "the lifetime is never below 1" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-LIFETIME
     PERFORM ASSERT-NUMBER
     MOVE 0.5 TO W2
     MOVE 1.0 TO W3
     MOVE 0.8 TO W4
     CALL "P4-DUST-RANDOMIZE" USING W2 W3 W4 W5
     MOVE "randomizeColor = (draw * 0.2 + 0.8) * a * b" TO WS-NAME
     MOVE 72000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((W5) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 16711680 TO WS-ARGB
     MOVE 1.0 TO W7
     MOVE 0.5 TO W8
     CALL "P4-DUST-NEW" USING PCL Z1 Z2 Z3 Z4 Z5 Z6 W7 WS-DRAWS W8 WS-ARGB
     MOVE "dust red channel (0.5 * 0.2 + 0.8) * 1.0 * 0.8" TO WS-NAME
     MOVE 72000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-RCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "dust green channel of a pure red option" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-GCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "dust blue channel of a pure red option" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-BCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "dust alpha stays 1" TO WS-NAME
     MOVE 100000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-ALPHA) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 0 TO WS-D(8)
     MOVE 0 TO WS-D(9)
     CALL "P4-DUST-NEW" USING PCL Z1 Z2 Z3 Z4 Z5 Z6 W7 WS-DRAWS W8 WS-ARGB
     MOVE "dust channel minimum 0.8 * 0.6 = 0.48 of the option colour" TO WS-NAME
     MOVE 48000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-RCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 0.5 TO WS-D(8)
     MOVE 0.5 TO WS-D(9)
     MOVE 0 TO I2
     CALL "P4-DUST-OPTION" USING I2 WS-ARGB WS-ARGB2 W1
     MOVE "REDSTONE colour is 0xFF0000" TO WS-NAME
     MOVE 16711680 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-ARGB
     PERFORM ASSERT-NUMBER
     MOVE "REDSTONE has no second colour (the same)" TO WS-NAME
     MOVE 16711680 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-ARGB2
     PERFORM ASSERT-NUMBER
     MOVE 1 TO I2
     CALL "P4-DUST-OPTION" USING I2 WS-ARGB WS-ARGB2 W1
     MOVE "SCULK_TO_REDSTONE from 0x39D6E0" TO WS-NAME
     MOVE 3790560 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-ARGB
     PERFORM ASSERT-NUMBER
     MOVE "SCULK_TO_REDSTONE to 0xFF0000" TO WS-NAME
     MOVE 16711680 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-ARGB2
     PERFORM ASSERT-NUMBER
     MOVE "option scale 1.0" TO WS-NAME
     MOVE 100000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((W1) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 3790560 TO WS-ARGB
     MOVE 16711680 TO WS-ARGB2
     CALL "P4-DUST-TRANSITION-NEW" USING PCL P4X Z1 Z2 Z3 Z4 Z5 Z6 W7 WS-DRAWS W8 WS-ARGB WS-ARGB2
     MOVE "transition from red channel 0.72 * 57 / 255" TO WS-NAME
     MOVE 16094 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((X4-FROM(1)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "transition from green channel 0.72 * 214 / 255" TO WS-NAME
     MOVE 60424 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((X4-FROM(2)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "transition to red channel 0.72" TO WS-NAME
     MOVE 72000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((X4-TO(1)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "transition to green channel 0" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((X4-TO(2)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 0 TO PC-AGE
     MOVE 24 TO PC-LIFETIME
     MOVE 0 TO W2
     CALL "P4-DUST-TRANSITION-COLOR" USING PCL P4X W2
     MOVE "at age 0, partial 0 the colour is the from colour" TO WS-NAME
     MOVE 16094 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-RCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 11 TO PC-AGE
     MOVE 1 TO W2
     CALL "P4-DUST-TRANSITION-COLOR" USING PCL P4X W2
     MOVE "t = (age + partial) / (lifetime + 1) = 0.48: red" TO WS-NAME
     MOVE 42929 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-RCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "t = 0.48: green" TO WS-NAME
     MOVE 31420 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-GCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "t = 0.48: blue" TO WS-NAME
     MOVE 32888 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-BCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     STOP RUN.

 ASSERT-NUMBER.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-4§6 Dust family: " FUNCTION TRIM(WS-NAME)
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "N" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 ASSERT-TEXT.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-4§6 Dust family: " FUNCTION TRIM(WS-NAME)
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "T" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-PARTICLES-42-4-6.
