*> Cost test (lane resume, T5820): ENTITIES-MESH with 70 hostile mobs (zombie, creeper, skeleton, spider) within 40 blocks of the eye, 100 frames. The mean
*> time of a frame's entity mesh is shown (DISPLAY "BENCH ..."), and must stay below a generous bound.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-ENTITIES-BENCH.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CLSTATE.
 COPY CLCONST.
 COPY CONTENT.
 COPY CLMODELS.
 COPY TESTLIB.
 01 WS-KEY                 PIC X(112).
 01 WS-ROW-AREA            PIC X(66).
 01 WS-STATUS              BINARY-LONG.
 01 WS-ID                  BINARY-LONG.
 01 WS-TYPES.
    05 WS-TYPE             BINARY-LONG OCCURS 4 TIMES.
 01 WS-NAMES.
    05 FILLER PIC X(24) VALUE "zombie".
    05 FILLER PIC X(24) VALUE "creeper".
    05 FILLER PIC X(24) VALUE "skeleton".
    05 FILLER PIC X(24) VALUE "spider".
 01 WS-NAME-TABLE REDEFINES WS-NAMES.
    05 WS-KEY-NAME         PIC X(24) OCCURS 4 TIMES.
 01 WS-T                   BINARY-LONG.
 01 WS-X                   FLOAT-LONG.
 01 WS-Y                   FLOAT-LONG.
 01 WS-Z                   FLOAT-LONG.
 01 WS-YAW                 FLOAT-SHORT.
 01 WS-ANGLE               FLOAT-LONG.
 01 WS-DISTANCE            FLOAT-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-FRAMES              BINARY-LONG VALUE 100.
 01 WS-DATE                PIC X(21).
 01 WS-T0                  BINARY-DOUBLE.
 01 WS-HUNDREDTHS          BINARY-DOUBLE.
 01 WS-MS                  FLOAT-LONG.
 01 WS-MS-TEXT             PIC -(5)9.99.
 01 WS-COUNT               BINARY-LONG.
 01 WS-VERTS               BINARY-LONG.
 01 WS-FIRST-X             FLOAT-SHORT.
 01 WS-MODEL1              BINARY-LONG.
 01 WS-EYE-TABLE.
    05 WS-EYE              FLOAT-LONG OCCURS 3 TIMES.
 PROCEDURE DIVISION.
     CALL "CL-INIT" USING CLIENT-STATE
     MOVE 0 TO PK-COUNT
     CALL "ENTITY-ATLAS-BUILD" USING CLIENT-STATE
     MOVE 256 TO PL-HEIGHT
     MOVE 0 TO SK-U
     MOVE 10 TO WS-EYE(1) WS-EYE(3)
     MOVE 64 TO WS-EYE(2)
     MOVE 1 TO CT-OPEN
     MOVE CT-TYPE-STANDARD TO CT-SET-TYPE
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 4
         MOVE SPACES TO WS-KEY
         MOVE WS-KEY-NAME(WS-I) TO WS-KEY
         CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-TYPE(WS-I) WS-ROW-AREA WS-STATUS
     END-PERFORM
     MOVE 64 TO WS-Y
     PERFORM VARYING WS-I FROM 0 BY 1 UNTIL WS-I > 69
         COMPUTE WS-ID = 100 + WS-I
         COMPUTE WS-ANGLE = WS-I * 2.399963
         COMPUTE WS-DISTANCE = 8 + FUNCTION MOD(WS-I * 7, 33)
         COMPUTE WS-X = 10 + WS-DISTANCE * FUNCTION COS(WS-ANGLE)
         COMPUTE WS-Z = 10 + WS-DISTANCE * FUNCTION SIN(WS-ANGLE)
         COMPUTE WS-T = FUNCTION MOD(WS-I, 4) + 1
         COMPUTE WS-YAW = FUNCTION MOD(WS-I * 37, 360)
         CALL "ETM-SPAWN" USING CLIENT-STATE WS-ID WS-TYPE(WS-T) WS-X WS-Y WS-Z WS-YAW
     END-PERFORM
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     PERFORM NOW
     MOVE WS-HUNDREDTHS TO WS-T0
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-FRAMES
         CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     END-PERFORM
     PERFORM NOW
     COMPUTE WS-MS = (WS-HUNDREDTHS - WS-T0) * 10 / WS-FRAMES
     MOVE WS-MS TO WS-MS-TEXT
     DISPLAY "BENCH entities-mesh ms per frame (70 mobs): " WS-MS-TEXT " vertices " RL-EN-COUNT
     COMPUTE WS-COUNT = WS-MS
     MOVE "N" TO TL-MODE
     MOVE "test entities bench: the entity mesh of 70 mobs costs less than 20 ms a frame" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF WS-COUNT < 20
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   The baked mesh follows the row: a row whose model changes and changes back draws the same vertices; a third model in turn replaces an entry.
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     MOVE RL-EN-COUNT TO WS-VERTS
     MOVE RL-EN-X(1) TO WS-FIRST-X
     MOVE EN-MODEL(1) TO WS-MODEL1
     MOVE EN-MODEL(2) TO EN-MODEL(1)
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     MOVE EN-MODEL(3) TO EN-MODEL(1)
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     MOVE EN-MODEL(2) TO EN-MODEL(1)
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     MOVE WS-MODEL1 TO EN-MODEL(1)
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     MOVE "test entities bench: a row whose model changes and changes back draws the same vertices" TO TL-CASE
     MOVE WS-VERTS TO TL-EXPECTED-N
     MOVE RL-EN-COUNT TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "test entities bench: the first vertex is where it was" TO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE SPACES TO TL-EXPECTED TL-OBSERVED
     IF RL-EN-X(1) = WS-FIRST-X
         MOVE "same" TO TL-OBSERVED
     ELSE
         MOVE "moved" TO TL-OBSERVED
     END-IF
     MOVE "same" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.
 NOW.
     MOVE FUNCTION CURRENT-DATE TO WS-DATE
     COMPUTE WS-HUNDREDTHS = FUNCTION NUMVAL(WS-DATE(9:2)) * 360000 + FUNCTION NUMVAL(WS-DATE(11:2)) * 6000
         + FUNCTION NUMVAL(WS-DATE(13:2)) * 100 + FUNCTION NUMVAL(WS-DATE(15:2)).
 END PROGRAM TEST-ENTITIES-BENCH.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. ETM-SPAWN.
*> USING CLIENT-STATE, entity id, type (registry id), x y z (FLOAT-LONG), yaw (FLOAT-SHORT, also the head yaw): Add Entity.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY PROTO.
 01 WS-READY               BINARY-LONG VALUE 0.
 01 WS-CAPACITY            BINARY-LONG VALUE 1024.
 01 WS-ADD                 BINARY-LONG VALUE 1.
 01 WS-ZERO                BINARY-LONG VALUE 0.
 01 WS-UUID                PIC X(16) VALUE LOW-VALUES.
 01 WS-V0                  FLOAT-LONG VALUE 0.
 01 WS-V1                  FLOAT-LONG VALUE 0.
 01 WS-V2                  FLOAT-LONG VALUE 0.
 01 WS-A0                  FLOAT-SHORT VALUE 0.
 LINKAGE SECTION.
 COPY CLSTATE.
 01 L-ID                   BINARY-LONG.
 01 L-TYPE                 BINARY-LONG.
 01 L-X                    FLOAT-LONG.
 01 L-Y                    FLOAT-LONG.
 01 L-Z                    FLOAT-LONG.
 01 L-YAW                  FLOAT-SHORT.
 PROCEDURE DIVISION USING CLIENT-STATE L-ID L-TYPE L-X L-Y L-Z L-YAW.
     IF WS-READY = 0
         CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
         MOVE 1 TO WS-READY
     END-IF
     CALL "PB-RESET" USING PB-BUFFER
     CALL "PB-PUT-VARINT" USING PB-BUFFER L-ID
     CALL "PB-PUT-UUID" USING PB-BUFFER WS-UUID
     CALL "PB-PUT-VARINT" USING PB-BUFFER L-TYPE
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER L-X
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER L-Y
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER L-Z
     CALL "PB-PUT-LPVEC3" USING PB-BUFFER WS-V0 WS-V1 WS-V2
     CALL "PB-PUT-ANGLE" USING PB-BUFFER WS-A0
     CALL "PB-PUT-ANGLE" USING PB-BUFFER L-YAW
     CALL "PB-PUT-ANGLE" USING PB-BUFFER L-YAW
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-ZERO
     MOVE 0 TO PB-POS
     CALL "ENTITY-PACKET" USING CLIENT-STATE PB-BUFFER WS-ADD
     GOBACK.
 END PROGRAM ETM-SPAWN.

 COPY CLTEST.
