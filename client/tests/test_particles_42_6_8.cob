*> Acceptance test of docs/protocol/42-particles-6-emitters-blocks.md section 8: the emitter rules.
*> Expected texts are computed independently by a script from the document's formulas; each case injects the draws in the documented order and
*> compares the emission list (5 decimals), the sounds and the count of draws consumed.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-PARTICLES-42-6-8.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CLP6EM.
 COPY TESTLIB.
 01 WS-NAME                PIC X(160).
 01 WS-CLASS               PIC X(24).
 01 WS-PT                  PIC X(80).
 01 WS-PRT                 PIC X(80).
 01 WS-DRT                 PIC X(4000).
 01 WS-EXP                 PIC X(4000).
 01 WS-OBS                 PIC X(12000).
 01 WS-OBS2                PIC X(12000).
 01 WS-LEN                 BINARY-LONG.
 01 WS-START               BINARY-LONG.
 01 WS-BLOCK.
    05 WS-BP               BINARY-LONG OCCURS 3 TIMES.
 01 WS-PROPS.
    05 WS-PR               BINARY-LONG OCCURS 12 TIMES.
 01 WS-LIST.
    05 WS-NUM              FLOAT-LONG OCCURS 2100 TIMES.
 01 WS-COUNT               BINARY-LONG.
 01 WS-TEXT                PIC X(4000).
 01 WS-TOK                 PIC X(40).
 01 WS-PTR                 BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-PTR2                BINARY-LONG.
 01 WS-ED                  PIC -(5)9.99999.
 01 WS-EDC                 PIC -(10)9.
 01 WS-EDS                 PIC 9.99.
 01 WS-EDR                 PIC 9.99999.
 01 WS-V                   FLOAT-LONG.
 COPY CLP6PK.
 01 WS-FALL                FLOAT-LONG.
 01 WS-SAFE                FLOAT-LONG.
 01 WS-EPA.
    05 WS-EP               FLOAT-LONG OCCURS 3 TIMES.
 01 WS-EBA.
    05 WS-EB               BINARY-LONG OCCURS 2 TIMES.
 01 WS-SBA.
    05 WS-SB               BINARY-LONG OCCURS 2 TIMES.
 01 WS-STATE               BINARY-LONG.
 01 WS-SEND                BINARY-LONG.
 01 WS-EX                  FLOAT-LONG.
 01 WS-EZ                  FLOAT-LONG.
 01 WS-PKT                 PIC X(300).
 01 WS-ED2                 PIC -(5)9.99999.
 01 WS-EDN                 PIC -(9)9.
 PROCEDURE DIVISION.
     MOVE "sprint dust inside block" TO WS-NAME
     MOVE "sprint" TO WS-CLASS
     MOVE "10 64 -3" TO WS-PT
     MOVE "9 10500 64000 -2500 600 100 -50 10 -3 0 0" TO WS-PRT
     MOVE "0.25 0.75" TO WS-DRT
     MOVE "block 10.35000 64.10000 -2.35000 -0.40000 1.50000 0.20000 st=9 (2)" TO WS-EXP
     PERFORM RUN-CASE
     MOVE "sprint dust clamps outside block" TO WS-NAME
     MOVE "sprint" TO WS-CLASS
     MOVE "10 64 -3" TO WS-PT
     MOVE "9 10900 64000 -2900 600 100 -50 11 -4 0 0" TO WS-PRT
     MOVE "0.9 0.1" TO WS-DRT
     MOVE "block 11.00000 64.10000 -3.00000 -0.40000 1.50000 0.20000 st=9 (2)" TO WS-EXP
     PERFORM RUN-CASE
     MOVE "sprint dust inside the neighbour column" TO WS-NAME
     MOVE "sprint" TO WS-CLASS
     MOVE "10 64 -3" TO WS-PT
     MOVE "9 10900 64000 -2900 600 100 -50 11 -4 0 0" TO WS-PRT
     MOVE "0.1 0.9" TO WS-DRT
     MOVE "block 10.66000 64.10000 -2.66000 -0.40000 1.50000 0.20000 st=9 (2)" TO WS-EXP
     PERFORM RUN-CASE
     MOVE "sprint dust clamps below and above the block" TO WS-NAME
     MOVE "sprint" TO WS-CLASS
     MOVE "10 64 -3" TO WS-PT
     MOVE "9 9900 64000 -1900 600 100 -50 9 -2 0 0" TO WS-PRT
     MOVE "0.1 0.9" TO WS-DRT
     MOVE "block 10.00000 64.10000 -2.00000 -0.40000 1.50000 0.20000 st=9 (2)" TO WS-EXP
     PERFORM RUN-CASE
     MOVE "honey slide" TO WS-NAME
     MOVE "honey" TO WS-CLASS
     MOVE "10 64 -3" TO WS-PT
     MOVE "5 10500 64250 -2500 0" TO WS-PRT
     MOVE SPACES TO WS-DRT
     MOVE "block 10.50000 64.25000 -2.50000 0.00000 0.00000 0.00000 st=5 | block 10.50000 64.25000 -2"
         & ".50000 0.00000 0.00000 0.00000 st=5 | block 10.50000 64.25000 -2.50000 0.00000 0.00000 0.0"
         & "0000 st=5 | block 10.50000 64.25000 -2.50000 0.00000 0.00000 0.00000 st=5 | block 10.50000"
         & " 64.25000 -2.50000 0.00000 0.00000 0.00000 st=5 (0)" TO WS-EXP
     PERFORM RUN-CASE
     MOVE "honey jump" TO WS-NAME
     MOVE "honey" TO WS-CLASS
     MOVE "10 64 -3" TO WS-PT
     MOVE "5 10500 64250 -2500 1" TO WS-PRT
     MOVE SPACES TO WS-DRT
     MOVE "block 10.50000 64.25000 -2.50000 0.00000 0.00000 0.00000 st=5 | block 10.50000 64.25000 -2"
         & ".50000 0.00000 0.00000 0.00000 st=5 | block 10.50000 64.25000 -2.50000 0.00000 0.00000 0.0"
         & "0000 st=5 | block 10.50000 64.25000 -2.50000 0.00000 0.00000 0.00000 st=5 | block 10.50000"
         & " 64.25000 -2.50000 0.00000 0.00000 0.00000 st=5 | block 10.50000 64.25000 -2.50000 0.00000"
         & " 0.00000 0.00000 st=5 | block 10.50000 64.25000 -2.50000 0.00000 0.00000 0.00000 st=5 | bl"
         & "ock 10.50000 64.25000 -2.50000 0.00000 0.00000 0.00000 st=5 | block 10.50000 64.25000 -2.5"
         & "0000 0.00000 0.00000 0.00000 st=5 | block 10.50000 64.25000 -2.50000 0.00000 0.00000 0.000"
         & "00 st=5 (0)" TO WS-EXP
     PERFORM RUN-CASE
     MOVE "decorated pot dust plume" TO WS-NAME
     MOVE "decorated_pot" TO WS-CLASS
     MOVE "10 64 -3" TO WS-PT
     MOVE SPACES TO WS-PRT
     MOVE SPACES TO WS-DRT
     MOVE "dust_plume 10.50000 65.20000 -2.50000 0.00000 0.00000 0.00000 | dust_plume 10.50000 65.200"
         & "00 -2.50000 0.00000 0.00000 0.00000 | dust_plume 10.50000 65.20000 -2.50000 0.00000 0.0000"
         & "0 0.00000 | dust_plume 10.50000 65.20000 -2.50000 0.00000 0.00000 0.00000 | dust_plume 10."
         & "50000 65.20000 -2.50000 0.00000 0.00000 0.00000 | dust_plume 10.50000 65.20000 -2.50000 0."
         & "00000 0.00000 0.00000 | dust_plume 10.50000 65.20000 -2.50000 0.00000 0.00000 0.00000 (0)" TO WS-EXP
     PERFORM RUN-CASE
     MOVE 10 TO WS-BP(1)
     MOVE 64 TO WS-BP(2)
     MOVE -3 TO WS-BP(3)
     MOVE 9 TO WS-STATE
     MOVE 10 TO WS-FALL
     MOVE 3 TO WS-SAFE
     MOVE 10.5 TO WS-EP(1)
     MOVE 64 TO WS-EP(2)
     MOVE -2.5 TO WS-EP(3)
     MOVE 10 TO WS-EB(1)
     MOVE -3 TO WS-EB(2)
     MOVE 10 TO WS-SB(1)
     MOVE -3 TO WS-SB(2)
     CALL "P6-LANDING" USING WS-FALL WS-SAFE WS-EPA WS-EBA WS-SBA WS-STATE WS-SEND P6-PACKET
     MOVE "landing worked example, fall of 10 blocks: sent" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     MOVE WS-SEND TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     PERFORM RENDER-PACKET
     MOVE "landing worked example, fall of 10 blocks: packet" TO WS-NAME
     MOVE "block 10.50000 64.00000 -2.50000 n=100 d=0.00000,0.00000,0.00000 v=0.15000,0.15000,0.15000 m=0 st=9" TO WS-EXP
     PERFORM ASSERT-PACKET
     MOVE 10 TO WS-FALL
     MOVE 3 TO WS-SAFE
     MOVE 10.9 TO WS-EP(1)
     MOVE 64 TO WS-EP(2)
     MOVE -3.4 TO WS-EP(3)
     MOVE 10 TO WS-EB(1)
     MOVE -4 TO WS-EB(2)
     MOVE 11 TO WS-SB(1)
     MOVE -4 TO WS-SB(2)
     CALL "P6-LANDING" USING WS-FALL WS-SAFE WS-EPA WS-EBA WS-SBA WS-STATE WS-SEND P6-PACKET
     MOVE "landing edge of the supporting block: sent" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     MOVE WS-SEND TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     PERFORM RENDER-PACKET
     MOVE "landing edge of the supporting block: packet" TO WS-NAME
     MOVE "block 11.00000 64.00000 -3.41667 n=100 d=0.00000,0.00000,0.00000 v=0.15000,0.15000,0.15000 m=0 st=9" TO WS-EXP
     PERFORM ASSERT-PACKET
     MOVE 3 TO WS-FALL
     MOVE 3 TO WS-SAFE
     MOVE 10.5 TO WS-EP(1)
     MOVE 64 TO WS-EP(2)
     MOVE -2.5 TO WS-EP(3)
     MOVE 10 TO WS-EB(1)
     MOVE -3 TO WS-EB(2)
     MOVE 10 TO WS-SB(1)
     MOVE -3 TO WS-SB(2)
     CALL "P6-LANDING" USING WS-FALL WS-SAFE WS-EPA WS-EBA WS-SBA WS-STATE WS-SEND P6-PACKET
     MOVE "landing a fall at the safe distance sends nothing: sent" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-SEND TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     MOVE 50 TO WS-FALL
     MOVE 3 TO WS-SAFE
     MOVE 10.5 TO WS-EP(1)
     MOVE 64 TO WS-EP(2)
     MOVE -2.5 TO WS-EP(3)
     MOVE 10 TO WS-EB(1)
     MOVE -3 TO WS-EB(2)
     MOVE 10 TO WS-SB(1)
     MOVE -3 TO WS-SB(2)
     CALL "P6-LANDING" USING WS-FALL WS-SAFE WS-EPA WS-EBA WS-SBA WS-STATE WS-SEND P6-PACKET
     MOVE "landing amount cap of 2.5: sent" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     MOVE WS-SEND TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     PERFORM RENDER-PACKET
     MOVE "landing amount cap of 2.5: packet" TO WS-NAME
     MOVE "block 10.50000 64.00000 -2.50000 n=375 d=0.00000,0.00000,0.00000 v=0.15000,0.15000,0.15000 m=0 st=9" TO WS-EXP
     PERFORM ASSERT-PACKET
     MOVE 20 TO WS-FALL
     MOVE 3 TO WS-SAFE
     MOVE 10.5 TO WS-EP(1)
     MOVE 64 TO WS-EP(2)
     MOVE -2.5 TO WS-EP(3)
     MOVE 10 TO WS-EB(1)
     MOVE -3 TO WS-EB(2)
     MOVE 10 TO WS-SB(1)
     MOVE -3 TO WS-SB(2)
     CALL "P6-LANDING" USING WS-FALL WS-SAFE WS-EPA WS-EBA WS-SBA WS-STATE WS-SEND P6-PACKET
     MOVE "landing larger fall: sent" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     MOVE WS-SEND TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     PERFORM RENDER-PACKET
     MOVE "landing larger fall: packet" TO WS-NAME
     MOVE "block 10.50000 64.00000 -2.50000 n=200 d=0.00000,0.00000,0.00000 v=0.15000,0.15000,0.15000 m=0 st=9" TO WS-EXP
     PERFORM ASSERT-PACKET
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 2048
         MOVE 0.5 TO EM-DRAW(WS-I)
     END-PERFORM
     MOVE 0.7 TO EM-DRAW(1)
     MOVE 0.75 TO EM-DRAW(2)
     MOVE 0.25 TO EM-DRAW(3)
     MOVE 0 TO EM-COUNT EM-CUR EM-SOUND-COUNT
     MOVE 10.5 TO WS-EX
     MOVE -2.5 TO WS-EZ
     CALL "P6-POWDER-SNOW" USING P6-EMITS WS-EX WS-EZ WS-BLOCK WS-SEND P6-PACKET
     MOVE "powder snow sends: sent" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     MOVE WS-SEND TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     MOVE "powder snow sends: draws" TO WS-NAME
     MOVE 3 TO TL-EXPECTED-N
     MOVE EM-CUR TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     PERFORM RENDER-PACKET
     MOVE "powder snow sends: packet" TO WS-NAME
     MOVE "snowflake 10.50000 65.00000 -2.50000 n=1 d=0.00000,0.00000,0.00000 v=0.04167,0.05000,-0.04167 m=1 st=0" TO WS-EXP
     PERFORM ASSERT-PACKET
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 2048
         MOVE 0.5 TO EM-DRAW(WS-I)
     END-PERFORM
     MOVE 0.2 TO EM-DRAW(1)
     MOVE 0.75 TO EM-DRAW(2)
     MOVE 0.25 TO EM-DRAW(3)
     MOVE 0 TO EM-COUNT EM-CUR EM-SOUND-COUNT
     MOVE 10.5 TO WS-EX
     MOVE -2.5 TO WS-EZ
     CALL "P6-POWDER-SNOW" USING P6-EMITS WS-EX WS-EZ WS-BLOCK WS-SEND P6-PACKET
     MOVE "powder snow with rb false sends nothing: sent" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-SEND TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     MOVE "powder snow with rb false sends nothing: draws" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     MOVE EM-CUR TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     CALL "P6-POT-PACKET" USING WS-BLOCK P6-PACKET
     PERFORM RENDER-PACKET
     MOVE "decorated pot packet" TO WS-NAME
     MOVE "dust_plume 10.50000 65.20000 -2.50000 n=7 d=0.00000,0.00000,0.00000 v=0.00000,0.00000,0.00000 m=0 st=0" TO WS-EXP
     PERFORM ASSERT-PACKET
     STOP RUN.

 RUN-CASE.
     MOVE WS-PT TO WS-TEXT
     PERFORM PARSE-LIST
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 3
         MOVE WS-NUM(WS-I) TO WS-BP(WS-I)
     END-PERFORM
     MOVE WS-PRT TO WS-TEXT
     PERFORM PARSE-LIST
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 12
         MOVE 0 TO WS-PR(WS-I)
     END-PERFORM
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-COUNT
         MOVE WS-NUM(WS-I) TO WS-PR(WS-I)
     END-PERFORM
     MOVE WS-DRT TO WS-TEXT
     PERFORM PARSE-LIST
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 2048
         MOVE 0.5 TO EM-DRAW(WS-I)
     END-PERFORM
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-COUNT
         MOVE WS-NUM(WS-I) TO EM-DRAW(WS-I)
     END-PERFORM
     CALL "P6-BLOCK-EFFECT" USING WS-CLASS WS-BLOCK WS-PROPS P6-EMITS
     PERFORM RENDER
     MOVE FUNCTION LENGTH(FUNCTION TRIM(WS-OBS)) TO WS-LEN
     IF WS-LEN > 1000
         MOVE WS-OBS(1:480) TO WS-OBS2(1:480)
         MOVE "..." TO WS-OBS2(481:3)
         COMPUTE WS-START = WS-LEN - 479
         MOVE WS-OBS(WS-START:480) TO WS-OBS2(484:480)
         MOVE WS-OBS2 TO WS-OBS
     END-IF
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-6§8 Entity-on-block particles: " FUNCTION TRIM(WS-NAME)
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE WS-EXP TO TL-EXPECTED
     MOVE WS-OBS TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 RENDER-PACKET.
     MOVE SPACES TO WS-PKT
     MOVE 1 TO WS-PTR2
     STRING FUNCTION TRIM(PK-NAME) " " DELIMITED BY SIZE INTO WS-PKT WITH POINTER WS-PTR2
     MOVE PK-X TO WS-V
     PERFORM PK-NUMBER
     MOVE PK-Y TO WS-V
     PERFORM PK-NUMBER
     MOVE PK-Z TO WS-V
     COMPUTE WS-ED2 ROUNDED = WS-V
     STRING FUNCTION TRIM(WS-ED2) DELIMITED BY SIZE INTO WS-PKT WITH POINTER WS-PTR2
     MOVE PK-COUNT TO WS-EDN
     STRING " n=" FUNCTION TRIM(WS-EDN) " d=" DELIMITED BY SIZE INTO WS-PKT WITH POINTER WS-PTR2
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 3
         COMPUTE WS-ED2 ROUNDED = PK-DIST(WS-I)
         STRING FUNCTION TRIM(WS-ED2) DELIMITED BY SIZE INTO WS-PKT WITH POINTER WS-PTR2
         IF WS-I < 3
             STRING "," DELIMITED BY SIZE INTO WS-PKT WITH POINTER WS-PTR2
         END-IF
     END-PERFORM
     STRING " v=" DELIMITED BY SIZE INTO WS-PKT WITH POINTER WS-PTR2
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 3
         COMPUTE WS-ED2 ROUNDED = PK-SPEED(WS-I)
         STRING FUNCTION TRIM(WS-ED2) DELIMITED BY SIZE INTO WS-PKT WITH POINTER WS-PTR2
         IF WS-I < 3
             STRING "," DELIMITED BY SIZE INTO WS-PKT WITH POINTER WS-PTR2
         END-IF
     END-PERFORM
     MOVE PK-MODE TO WS-EDN
     STRING " m=" FUNCTION TRIM(WS-EDN) DELIMITED BY SIZE INTO WS-PKT WITH POINTER WS-PTR2
     MOVE PK-STATE TO WS-EDN
     STRING " st=" FUNCTION TRIM(WS-EDN) DELIMITED BY SIZE INTO WS-PKT WITH POINTER WS-PTR2.

 PK-NUMBER.
     COMPUTE WS-ED2 ROUNDED = WS-V
     STRING FUNCTION TRIM(WS-ED2) " " DELIMITED BY SIZE INTO WS-PKT WITH POINTER WS-PTR2.

 ASSERT-PACKET.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-6§8 Entity-on-block particles: " FUNCTION TRIM(WS-NAME)
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE WS-EXP TO TL-EXPECTED
     MOVE WS-PKT TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 ASSERT-NUMBER.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-6§8 Entity-on-block particles: " FUNCTION TRIM(WS-NAME)
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "N" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 PARSE-LIST.
     MOVE 0 TO WS-COUNT
     MOVE 1 TO WS-PTR
     PERFORM UNTIL WS-PTR > 4000 OR WS-TEXT(WS-PTR:) = SPACES
         MOVE SPACES TO WS-TOK
         UNSTRING WS-TEXT DELIMITED BY ALL SPACE INTO WS-TOK WITH POINTER WS-PTR
         IF WS-TOK NOT = SPACES
             ADD 1 TO WS-COUNT
             COMPUTE WS-NUM(WS-COUNT) = FUNCTION NUMVAL(WS-TOK)
         END-IF
     END-PERFORM.

 RENDER.
     MOVE SPACES TO WS-OBS
     MOVE 1 TO WS-PTR2
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > EM-COUNT
         IF WS-I > 1
             STRING " | " DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2
         END-IF
         STRING FUNCTION TRIM(EM-NAME(WS-I)) " " DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2
         MOVE EM-X(WS-I) TO WS-V
         PERFORM ADD-NUMBER
         MOVE EM-Y(WS-I) TO WS-V
         PERFORM ADD-NUMBER
         MOVE EM-Z(WS-I) TO WS-V
         PERFORM ADD-NUMBER
         MOVE EM-VX(WS-I) TO WS-V
         PERFORM ADD-NUMBER
         MOVE EM-VY(WS-I) TO WS-V
         PERFORM ADD-NUMBER
         MOVE EM-VZ(WS-I) TO WS-V
         PERFORM ADD-LAST-NUMBER
         IF EM-COLOR(WS-I) NOT = 0
             MOVE EM-COLOR(WS-I) TO WS-EDC
             COMPUTE WS-EDS ROUNDED = EM-SCALE(WS-I)
             STRING " c=" FUNCTION TRIM(WS-EDC) " s=" WS-EDS DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2
         END-IF
         IF EM-COLOR(WS-I) = 0 AND EM-SCALE(WS-I) NOT = 0
             COMPUTE WS-EDR ROUNDED = EM-SCALE(WS-I)
             STRING " r=" WS-EDR DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2
         END-IF
         IF EM-STATE(WS-I) NOT = 0
             MOVE EM-STATE(WS-I) TO WS-EDC
             STRING " st=" FUNCTION TRIM(WS-EDC) DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2
         END-IF
     END-PERFORM
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > EM-SOUND-COUNT
         STRING " # " FUNCTION TRIM(EM-SOUND(WS-I)) DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2
     END-PERFORM
     MOVE EM-CUR TO WS-EDC
     STRING " (" FUNCTION TRIM(WS-EDC) ")" DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2.

 ADD-NUMBER.
     PERFORM ADD-LAST-NUMBER
     STRING " " DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2.

 ADD-LAST-NUMBER.
     COMPUTE WS-ED ROUNDED = WS-V
     STRING FUNCTION TRIM(WS-ED) DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2.
 END PROGRAM TEST-PARTICLES-42-6-8.
