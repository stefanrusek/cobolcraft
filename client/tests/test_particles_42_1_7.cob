*> Acceptance test of docs/protocol/42-particles-1-shared-model-engine.md section 7 (entry paths): the
*> four entry methods and their force and alwaysVisible values, the status computation and its draws,
*> the tests of doFAddParticle (E6), the Level Particles packet decoding and the three randomisation
*> modes (E11).
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-PARTICLES-42-1-7.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY PROTO.
 COPY CLPART.
 COPY CLPKT.
 COPY TESTLIB.
 01 WS-NAME                PIC X(160).
 01 WS-ENTRY               BINARY-LONG.
 01 WS-TYPE-OVERRIDE       BINARY-LONG.
 01 WS-ARG-OVERRIDE        BINARY-LONG.
 01 WS-ARG-ALWAYS          BINARY-LONG.
 01 WS-FORCE               BINARY-LONG.
 01 WS-VISIBLE             BINARY-LONG.
 01 WS-STATUS-IN           BINARY-LONG.
 01 WS-STATUS              BINARY-LONG.
 01 WS-D10                 BINARY-LONG.
 01 WS-D3                  BINARY-LONG.
 01 WS-USED                BINARY-LONG.
 01 WS-DIST2               FLOAT-LONG.
 01 WS-CREATE              BINARY-LONG.
 01 WS-CAP                 BINARY-LONG VALUE 256.
 01 WS-INT                 BINARY-LONG.
 01 WS-FLOAT               FLOAT-SHORT.
 01 WS-DOUBLE              FLOAT-LONG.
 01 WS-DRAWS.
    05 WS-D                FLOAT-LONG OCCURS 192 TIMES.
 01 WS-VAL                 FLOAT-LONG.
 01 WS-SCALE               BINARY-DOUBLE.
 01 WS-I                   BINARY-LONG.
 PROCEDURE DIVISION.
*>   7.1 table. Type override 1 (like explosion), argument override 0, alwaysShow 1.
     MOVE 1 TO WS-TYPE-OVERRIDE
     MOVE 0 TO WS-ARG-OVERRIDE
     MOVE 1 TO WS-ARG-ALWAYS
     MOVE 1 TO WS-ENTRY
     CALL "PENTRY-FLAGS" USING WS-ENTRY WS-TYPE-OVERRIDE WS-ARG-OVERRIDE WS-ARG-ALWAYS WS-FORCE WS-VISIBLE
     MOVE "entry 1 addParticle(options, x..): force = type override, alwaysVisible false" TO WS-NAME
     MOVE 10 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-FORCE * 10 + WS-VISIBLE
     PERFORM ASSERT-NUMBER
     MOVE 0 TO WS-TYPE-OVERRIDE
     MOVE 2 TO WS-ENTRY
     CALL "PENTRY-FLAGS" USING WS-ENTRY WS-TYPE-OVERRIDE WS-ARG-OVERRIDE WS-ARG-ALWAYS WS-FORCE WS-VISIBLE
     MOVE "entry 2 (packet): force = type OR argument (0), alwaysVisible = the argument (1)" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-FORCE * 10 + WS-VISIBLE
     PERFORM ASSERT-NUMBER
     MOVE 1 TO WS-ARG-OVERRIDE
     CALL "PENTRY-FLAGS" USING WS-ENTRY WS-TYPE-OVERRIDE WS-ARG-OVERRIDE WS-ARG-ALWAYS WS-FORCE WS-VISIBLE
     MOVE "entry 2 (packet): the override argument forces" TO WS-NAME
     MOVE 11 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-FORCE * 10 + WS-VISIBLE
     PERFORM ASSERT-NUMBER
     MOVE 3 TO WS-ENTRY
     MOVE 1 TO WS-TYPE-OVERRIDE
     CALL "PENTRY-FLAGS" USING WS-ENTRY WS-TYPE-OVERRIDE WS-ARG-OVERRIDE WS-ARG-ALWAYS WS-FORCE WS-VISIBLE
     MOVE "entry 3 addAlwaysVisibleParticle(options..): force false, alwaysVisible true" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-FORCE * 10 + WS-VISIBLE
     PERFORM ASSERT-NUMBER
     MOVE 4 TO WS-ENTRY
     MOVE 0 TO WS-TYPE-OVERRIDE
     MOVE 0 TO WS-ARG-OVERRIDE
     CALL "PENTRY-FLAGS" USING WS-ENTRY WS-TYPE-OVERRIDE WS-ARG-OVERRIDE WS-ARG-ALWAYS WS-FORCE WS-VISIBLE
     MOVE "entry 4 addAlwaysVisibleParticle(options, override..): force type OR argument (0), visible true" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-FORCE * 10 + WS-VISIBLE
     PERFORM ASSERT-NUMBER
     MOVE 1 TO WS-TYPE-OVERRIDE
     CALL "PENTRY-FLAGS" USING WS-ENTRY WS-TYPE-OVERRIDE WS-ARG-OVERRIDE WS-ARG-ALWAYS WS-FORCE WS-VISIBLE
     MOVE "entry 4: the type override forces" TO WS-NAME
     MOVE 11 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-FORCE * 10 + WS-VISIBLE
     PERFORM ASSERT-NUMBER
*>   7.1 step 1: calculateParticleLevel. Status ALL (0), DECREASED (1), MINIMAL (2).
     MOVE 0 TO WS-STATUS-IN
     MOVE 0 TO WS-VISIBLE
     MOVE 0 TO WS-D10 WS-D3
     CALL "PENTRY-STATUS" USING WS-VISIBLE WS-STATUS-IN WS-D10 WS-D3 WS-STATUS WS-USED
     MOVE "status ALL: unchanged, no draw" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-STATUS * 10 + WS-USED
     PERFORM ASSERT-NUMBER
     MOVE 1 TO WS-STATUS-IN
     MOVE 0 TO WS-D3
     CALL "PENTRY-STATUS" USING WS-VISIBLE WS-STATUS-IN WS-D10 WS-D3 WS-STATUS WS-USED
     MOVE "status DECREASED with nextInt(3) = 0 becomes MINIMAL, one draw" TO WS-NAME
     MOVE 21 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-STATUS * 10 + WS-USED
     PERFORM ASSERT-NUMBER
     MOVE 2 TO WS-D3
     CALL "PENTRY-STATUS" USING WS-VISIBLE WS-STATUS-IN WS-D10 WS-D3 WS-STATUS WS-USED
     MOVE "status DECREASED with nextInt(3) = 2 stays DECREASED, one draw" TO WS-NAME
     MOVE 11 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-STATUS * 10 + WS-USED
     PERFORM ASSERT-NUMBER
     MOVE 2 TO WS-STATUS-IN
     CALL "PENTRY-STATUS" USING WS-VISIBLE WS-STATUS-IN WS-D10 WS-D3 WS-STATUS WS-USED
     MOVE "status MINIMAL, not always visible: stays MINIMAL, no draw" TO WS-NAME
     MOVE 20 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-STATUS * 10 + WS-USED
     PERFORM ASSERT-NUMBER
     MOVE 1 TO WS-VISIBLE
     MOVE 5 TO WS-D10
     CALL "PENTRY-STATUS" USING WS-VISIBLE WS-STATUS-IN WS-D10 WS-D3 WS-STATUS WS-USED
     MOVE "always visible MINIMAL, nextInt(10) = 5: stays MINIMAL, one draw" TO WS-NAME
     MOVE 21 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-STATUS * 10 + WS-USED
     PERFORM ASSERT-NUMBER
     MOVE 0 TO WS-D10
     MOVE 2 TO WS-D3
     CALL "PENTRY-STATUS" USING WS-VISIBLE WS-STATUS-IN WS-D10 WS-D3 WS-STATUS WS-USED
     MOVE "always visible MINIMAL, nextInt(10) = 0: upgraded to DECREASED, then nextInt(3) = 2 keeps it: two draws" TO WS-NAME
     MOVE 12 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-STATUS * 10 + WS-USED
     PERFORM ASSERT-NUMBER
     MOVE 0 TO WS-D3
     CALL "PENTRY-STATUS" USING WS-VISIBLE WS-STATUS-IN WS-D10 WS-D3 WS-STATUS WS-USED
     MOVE "always visible MINIMAL upgraded then thinned back to MINIMAL: two draws" TO WS-NAME
     MOVE 22 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-STATUS * 10 + WS-USED
     PERFORM ASSERT-NUMBER
*>   7.1 steps 2 to 5 and E6: camera (0, 64, 0).
     MOVE 1044 TO WS-DIST2
     MOVE 0 TO WS-FORCE
     MOVE 0 TO WS-STATUS
     CALL "PENTRY-DECIDE" USING WS-FORCE WS-STATUS WS-DIST2 WS-CREATE
     MOVE "E6: squared distance 1044 > 1024 is dropped even with status ALL" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-CREATE TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     MOVE 964 TO WS-DIST2
     CALL "PENTRY-DECIDE" USING WS-FORCE WS-STATUS WS-DIST2 WS-CREATE
     MOVE "E6: squared distance 964 is created" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     MOVE WS-CREATE TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     MOVE 1024 TO WS-DIST2
     CALL "PENTRY-DECIDE" USING WS-FORCE WS-STATUS WS-DIST2 WS-CREATE
     MOVE "distance exactly 1024 (32 blocks) is created: only greater than is dropped" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     MOVE WS-CREATE TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     MOVE 1 TO WS-FORCE
     MOVE 40000 TO WS-DIST2
     MOVE 2 TO WS-STATUS
     CALL "PENTRY-DECIDE" USING WS-FORCE WS-STATUS WS-DIST2 WS-CREATE
     MOVE "E6: a forced type at distance 200 with status MINIMAL is created" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     MOVE WS-CREATE TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     MOVE 0 TO WS-FORCE
     MOVE 100 TO WS-DIST2
     CALL "PENTRY-DECIDE" USING WS-FORCE WS-STATUS WS-DIST2 WS-CREATE
     MOVE "status MINIMAL drops a non-forced particle in range" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-CREATE TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
*>   7.2 packet decoding: particle (power type 15 with Float power), flags, position, spread, speeds, count, mode.
     CALL "PB-INIT" USING PB-BUFFER WS-CAP
     MOVE 15 TO WS-INT
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-INT
     MOVE 0.5 TO WS-FLOAT
     CALL "PB-PUT-FLOAT" USING PB-BUFFER WS-FLOAT
     MOVE 1 TO WS-INT
     CALL "PB-PUT-BOOL" USING PB-BUFFER WS-INT
     MOVE 0 TO WS-INT
     CALL "PB-PUT-BOOL" USING PB-BUFFER WS-INT
     MOVE 10.5 TO WS-DOUBLE
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER WS-DOUBLE
     MOVE 64.0 TO WS-DOUBLE
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER WS-DOUBLE
     MOVE -3.25 TO WS-DOUBLE
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER WS-DOUBLE
     MOVE 0.5 TO WS-FLOAT
     CALL "PB-PUT-FLOAT" USING PB-BUFFER WS-FLOAT
     MOVE 1.0 TO WS-FLOAT
     CALL "PB-PUT-FLOAT" USING PB-BUFFER WS-FLOAT
     MOVE 2.0 TO WS-FLOAT
     CALL "PB-PUT-FLOAT" USING PB-BUFFER WS-FLOAT
     MOVE 0.1 TO WS-FLOAT
     CALL "PB-PUT-FLOAT" USING PB-BUFFER WS-FLOAT
     MOVE 0.2 TO WS-FLOAT
     CALL "PB-PUT-FLOAT" USING PB-BUFFER WS-FLOAT
     MOVE 0.3 TO WS-FLOAT
     CALL "PB-PUT-FLOAT" USING PB-BUFFER WS-FLOAT
     MOVE 5 TO WS-INT
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-INT
     MOVE 7 TO WS-INT
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-INT
     CALL "PENTRY-PACKET" USING PB-BUFFER PART-PACKET PART-OPTIONS
     MOVE "packet: particle id 15 with its power option 0.5" TO WS-NAME
     COMPUTE TL-EXPECTED-N = 15 * 1000 + 500
     COMPUTE TL-OBSERVED-N = PP-TYPE * 1000 + FUNCTION INTEGER(PO-POWER * 1000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "packet: override limiter 1, always show 0" TO WS-NAME
     MOVE 10 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PP-OVERRIDE * 10 + PP-ALWAYS
     PERFORM ASSERT-NUMBER
     MOVE 1000 TO WS-SCALE
     MOVE "packet: x 10.5" TO WS-NAME
     MOVE PP-X TO WS-VAL
     MOVE 10500 TO TL-EXPECTED-N
     PERFORM ASSERT-SCALED
     MOVE "packet: y 64" TO WS-NAME
     MOVE PP-Y TO WS-VAL
     MOVE 64000 TO TL-EXPECTED-N
     PERFORM ASSERT-SCALED
     MOVE "packet: z -3.25" TO WS-NAME
     MOVE PP-Z TO WS-VAL
     MOVE -3250 TO TL-EXPECTED-N
     PERFORM ASSERT-SCALED
     MOVE "packet: distances (0.5, 1, 2) and max speeds (0.1, 0.2, 0.3) in tenths of a percent" TO WS-NAME
     COMPUTE TL-EXPECTED-N = 500 * 1000000000 + 1000 * 1000000 + 2000 * 1000 + 100
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER(PP-DX * 1000 + 0.5) * 1000000000
         + FUNCTION INTEGER(PP-DY * 1000 + 0.5) * 1000000 + FUNCTION INTEGER(PP-DZ * 1000 + 0.5) * 1000
         + FUNCTION INTEGER(PP-SX * 1000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "packet: speed y and z, count 5, randomisation 7 maps to 0, no error" TO WS-NAME
     COMPUTE TL-EXPECTED-N = 200 * 10000000 + 300 * 10000 + 5 * 10 + 0
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER(PP-SY * 1000 + 0.5) * 10000000
         + FUNCTION INTEGER(PP-SZ * 1000 + 0.5) * 10000 + PP-COUNT * 10 + PP-RANDOM + PP-ERROR
     PERFORM ASSERT-NUMBER
     CALL "PB-RESET" USING PB-BUFFER
     MOVE 15 TO WS-INT
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-INT
     CALL "PENTRY-PACKET" USING PB-BUFFER PART-PACKET PART-OPTIONS
     MOVE "packet: truncated is an error" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     MOVE PP-ERROR TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
*>   E11: count 0 speed mode: distance (0, 1, 0), max speed (0, 0.2, 0): velocity (0, 0.2, 0), no draws.
     MOVE 10.0 TO PP-X
     MOVE 64.0 TO PP-Y
     MOVE 20.0 TO PP-Z
     MOVE 0 TO PP-DX PP-DZ PP-SX PP-SZ
     MOVE 1.0 TO PP-DY
     MOVE 0.2 TO PP-SY
     MOVE 0 TO PP-COUNT
     MOVE 0 TO PP-RANDOM
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 192
         MOVE 0.5 TO WS-D(WS-I)
     END-PERFORM
     CALL "PENTRY-SPAWNS" USING PART-PACKET WS-DRAWS PART-SPAWNS
     MOVE "E11: count 0: exactly one particle at the given position" TO WS-NAME
     COMPUTE TL-EXPECTED-N = 1 * 1000000 + 10 * 10000 + 64 * 100 + 20
     COMPUTE TL-OBSERVED-N = PS-N * 1000000 + PS-V(1, 1) * 10000 + PS-V(1, 2) * 100 + PS-V(1, 3)
     PERFORM ASSERT-NUMBER
     MOVE "E11: count 0 velocity = maxSpeed * distance = (0, 0.2, 0)" TO WS-NAME
     MOVE 1000 TO WS-SCALE
     COMPUTE TL-EXPECTED-N = 200
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER(PS-V(1, 5) * 1000 + 0.5) + FUNCTION ABS(PS-V(1, 4) * 1000)
         + FUNCTION ABS(PS-V(1, 6) * 1000)
     PERFORM ASSERT-NUMBER
*>   E11 DEFAULT: count 5, distances 0.5, speeds 0.1: gaussians (1, 2, -1, 3, 0, -2) for the first particle.
     MOVE 5 TO PP-COUNT
     MOVE 0.5 TO PP-DX PP-DY PP-DZ
     MOVE 0.1 TO PP-SX PP-SY PP-SZ
     MOVE 1.0 TO WS-D(1)
     MOVE 2.0 TO WS-D(2)
     MOVE -1.0 TO WS-D(3)
     MOVE 3.0 TO WS-D(4)
     MOVE 0.0 TO WS-D(5)
     MOVE -2.0 TO WS-D(6)
     CALL "PENTRY-SPAWNS" USING PART-PACKET WS-DRAWS PART-SPAWNS
     MOVE "E11 DEFAULT: five particles" TO WS-NAME
     MOVE 5 TO TL-EXPECTED-N
     MOVE PS-N TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     MOVE 1000 TO WS-SCALE
     MOVE "E11 DEFAULT: x = 10 + 1 * 0.5" TO WS-NAME
     MOVE PS-V(1, 1) TO WS-VAL
     MOVE 10500 TO TL-EXPECTED-N
     PERFORM ASSERT-SCALED
     MOVE "E11 DEFAULT: y = 64 + 2 * 0.5" TO WS-NAME
     MOVE PS-V(1, 2) TO WS-VAL
     MOVE 65000 TO TL-EXPECTED-N
     PERFORM ASSERT-SCALED
     MOVE "E11 DEFAULT: z = 20 - 1 * 0.5" TO WS-NAME
     MOVE PS-V(1, 3) TO WS-VAL
     MOVE 19500 TO TL-EXPECTED-N
     PERFORM ASSERT-SCALED
     MOVE "E11 DEFAULT: velocity = v * maxSpeed: (0.3, 0, -0.2) (hundredths 30, 0, -20)" TO WS-NAME
     COMPUTE TL-EXPECTED-N = 30 * 10000 + 0 * 100 - 20
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER(PS-V(1, 4) * 100 + 0.5) * 10000
         + FUNCTION INTEGER(PS-V(1, 5) * 100 + 0.5) * 100 + FUNCTION INTEGER(PS-V(1, 6) * 100 + 0.5)
     PERFORM ASSERT-NUMBER
*>   ALTERNATIVE: three nextDouble offsets uniform in [0, dist), velocity exactly the max speeds, no more draws.
     MOVE 1 TO PP-RANDOM
     MOVE 0.5 TO WS-D(1)
     MOVE 0.25 TO WS-D(2)
     MOVE 0.75 TO WS-D(3)
     MOVE 2 TO PP-COUNT
     MOVE 0.8 TO WS-D(4) WS-D(5) WS-D(6)
     CALL "PENTRY-SPAWNS" USING PART-PACKET WS-DRAWS PART-SPAWNS
     MOVE 1000 TO WS-SCALE
     MOVE "ALTERNATIVE: x = 10 + 0.5 * 0.5" TO WS-NAME
     MOVE PS-V(1, 1) TO WS-VAL
     MOVE 10250 TO TL-EXPECTED-N
     PERFORM ASSERT-SCALED
     MOVE "ALTERNATIVE: y = 64 + 0.25 * 0.5" TO WS-NAME
     MOVE PS-V(1, 2) TO WS-VAL
     MOVE 64125 TO TL-EXPECTED-N
     PERFORM ASSERT-SCALED
     MOVE "ALTERNATIVE: z = 20 + 0.75 * 0.5" TO WS-NAME
     MOVE PS-V(1, 3) TO WS-VAL
     MOVE 20375 TO TL-EXPECTED-N
     PERFORM ASSERT-SCALED
     MOVE "ALTERNATIVE: velocity equals the max speeds (0.1)" TO WS-NAME
     MOVE 100 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER(PS-V(1, 4) * 1000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "ALTERNATIVE: the second particle uses draws 4 to 6 (x = 10 + 0.8 * 0.5)" TO WS-NAME
     MOVE PS-V(2, 1) TO WS-VAL
     MOVE 10400 TO TL-EXPECTED-N
     PERFORM ASSERT-SCALED
*>   ALTERNATIVE_WITH_SPEED: three more draws multiply the velocity components.
     MOVE 2 TO PP-RANDOM
     MOVE 1 TO PP-COUNT
     MOVE 0.5 TO WS-D(1) WS-D(2) WS-D(3)
     MOVE 0.5 TO WS-D(4)
     MOVE 0.25 TO WS-D(5)
     MOVE 1.0 TO WS-D(6)
     CALL "PENTRY-SPAWNS" USING PART-PACKET WS-DRAWS PART-SPAWNS
     MOVE "ALTERNATIVE_WITH_SPEED: velocity = maxSpeed * draws (0.05, 0.025, 0.1) in thousandths" TO WS-NAME
     COMPUTE TL-EXPECTED-N = 50 * 1000000 + 25 * 1000 + 100
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER(PS-V(1, 4) * 1000 + 0.5) * 1000000
         + FUNCTION INTEGER(PS-V(1, 5) * 1000 + 0.5) * 1000 + FUNCTION INTEGER(PS-V(1, 6) * 1000 + 0.5)
     PERFORM ASSERT-NUMBER
*>   Spawns are capped at 32 by this implementation.
     MOVE 0 TO PP-RANDOM
     MOVE 40 TO PP-COUNT
     CALL "PENTRY-SPAWNS" USING PART-PACKET WS-DRAWS PART-SPAWNS
     MOVE "count above the capacity of the spawn table is cut to 32" TO WS-NAME
     MOVE 32 TO TL-EXPECTED-N
     MOVE PS-N TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     STOP RUN.

 ASSERT-SCALED.
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER(WS-VAL * WS-SCALE + 0.5)
     PERFORM ASSERT-NUMBER.

 ASSERT-NUMBER.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-1§7 Entry paths: " FUNCTION TRIM(WS-NAME)
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "N" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-PARTICLES-42-1-7.
