*> Paragraphs of the row checker (see EMCHKW.cpy): CK-RESET-COUNTS before a model, CK-ROW-CHECK for each expected row; the case text is CK-PREFIX plus the row.
 CK-RESET-COUNTS.
     PERFORM VARYING CK-K FROM 1 BY 1 UNTIL CK-K > 40
         MOVE 0 TO CK-CN(CK-K)
     END-PERFORM.

 CK-ROW-CHECK.
     MOVE 1 TO CK-PTR
     MOVE 0 TO CK-N
     PERFORM VARYING CK-K FROM 1 BY 1 UNTIL CK-K > 14
         MOVE SPACES TO CK-TOK(CK-K)
         MOVE 0 TO CK-NUM(CK-K)
     END-PERFORM
     PERFORM UNTIL CK-PTR > 100 OR CK-N >= 14
         ADD 1 TO CK-N
         UNSTRING CK-ROW DELIMITED BY ALL SPACE INTO CK-TOK(CK-N) WITH POINTER CK-PTR
     END-PERFORM
     PERFORM VARYING CK-K FROM 3 BY 1 UNTIL CK-K > 14
         IF CK-TOK(CK-K) NOT = SPACES
             COMPUTE CK-NUM(CK-K) = FUNCTION NUMVAL(CK-TOK(CK-K))
         END-IF
     END-PERFORM
     MOVE 0 TO CK-BAD
     MOVE CK-TOK(2) TO CK-NAME
     CALL "EMM-FIND" USING EMM-MODEL CK-NAME CK-PART
     IF CK-PART = 0
         MOVE 99 TO CK-BAD
     ELSE
         IF CK-TOK(1) = "P"
             PERFORM CK-POSE-CHECK
         ELSE
             PERFORM CK-CUBE-CHECK
         END-IF
     END-IF
     MOVE SPACES TO TL-CASE
     STRING FUNCTION TRIM(CK-PREFIX) ": " FUNCTION TRIM(CK-ROW) DELIMITED BY SIZE INTO TL-CASE
     MOVE "N" TO TL-MODE
     MOVE 0 TO TL-EXPECTED-N
     MOVE CK-BAD TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 CK-POSE-CHECK.
     MOVE CK-TOK(3) TO CK-NAME
     CALL "EMM-FIND" USING EMM-MODEL CK-NAME CK-PAR
     IF MM-PARENT(CK-PART) NOT = CK-PAR
         ADD 1 TO CK-BAD
     END-IF
     PERFORM CK-DIFF-POSE
     PERFORM CK-DIFF-SCALE.

 CK-DIFF-POSE.
     PERFORM VARYING CK-K FROM 1 BY 1 UNTIL CK-K > 6
         EVALUATE CK-K
             WHEN 1 COMPUTE CK-DIFF = MM-X(CK-PART) - CK-NUM(4)
             WHEN 2 COMPUTE CK-DIFF = MM-Y(CK-PART) - CK-NUM(5)
             WHEN 3 COMPUTE CK-DIFF = MM-Z(CK-PART) - CK-NUM(6)
             WHEN 4 COMPUTE CK-DIFF = MM-XROT(CK-PART) - CK-NUM(7)
             WHEN 5 COMPUTE CK-DIFF = MM-YROT(CK-PART) - CK-NUM(8)
             WHEN OTHER COMPUTE CK-DIFF = MM-ZROT(CK-PART) - CK-NUM(9)
         END-EVALUATE
         PERFORM CK-COUNT-DIFF
     END-PERFORM.

 CK-DIFF-SCALE.
     IF CK-TOK(10) = SPACES
         MOVE 1 TO CK-NUM(10) CK-NUM(11) CK-NUM(12)
     END-IF
     COMPUTE CK-DIFF = MM-XSCALE(CK-PART) - CK-NUM(10)
     PERFORM CK-COUNT-DIFF
     COMPUTE CK-DIFF = MM-YSCALE(CK-PART) - CK-NUM(11)
     PERFORM CK-COUNT-DIFF
     COMPUTE CK-DIFF = MM-ZSCALE(CK-PART) - CK-NUM(12)
     PERFORM CK-COUNT-DIFF.

 CK-CUBE-CHECK.
     ADD 1 TO CK-CN(CK-PART)
     MOVE CK-CN(CK-PART) TO CK-C
     IF CK-C > MM-NCUBES(CK-PART)
         MOVE 99 TO CK-BAD
     ELSE
         PERFORM CK-DIFF-CUBE
     END-IF.

 CK-DIFF-CUBE.
     COMPUTE CK-DIFF = MC-U(CK-PART, CK-C) - CK-NUM(3)
     PERFORM CK-COUNT-DIFF
     COMPUTE CK-DIFF = MC-V(CK-PART, CK-C) - CK-NUM(4)
     PERFORM CK-COUNT-DIFF
     COMPUTE CK-DIFF = MC-OX(CK-PART, CK-C) - CK-NUM(5)
     PERFORM CK-COUNT-DIFF
     COMPUTE CK-DIFF = MC-OY(CK-PART, CK-C) - CK-NUM(6)
     PERFORM CK-COUNT-DIFF
     COMPUTE CK-DIFF = MC-OZ(CK-PART, CK-C) - CK-NUM(7)
     PERFORM CK-COUNT-DIFF
     COMPUTE CK-DIFF = MC-W(CK-PART, CK-C) - CK-NUM(8)
     PERFORM CK-COUNT-DIFF
     COMPUTE CK-DIFF = MC-H(CK-PART, CK-C) - CK-NUM(9)
     PERFORM CK-COUNT-DIFF
     COMPUTE CK-DIFF = MC-D(CK-PART, CK-C) - CK-NUM(10)
     PERFORM CK-COUNT-DIFF
     COMPUTE CK-DIFF = MC-GX(CK-PART, CK-C) - CK-NUM(11)
     PERFORM CK-COUNT-DIFF
     COMPUTE CK-DIFF = MC-GY(CK-PART, CK-C) - CK-NUM(11)
     PERFORM CK-COUNT-DIFF
     COMPUTE CK-DIFF = MC-GZ(CK-PART, CK-C) - CK-NUM(11)
     PERFORM CK-COUNT-DIFF
     IF MC-MIRROR(CK-PART, CK-C) NOT = CK-NUM(12)
         ADD 1 TO CK-BAD
     END-IF.

 CK-COUNT-DIFF.
     IF CK-DIFF > 0.000001 OR CK-DIFF < -0.000001
         ADD 1 TO CK-BAD
     END-IF.
