*> Acceptance test of docs/protocol/42-particles-4-block-item-dust-ambient.md section 5 (`FallingDustParticle`): the rules, table rows,
*> formulas and worked cases of the section with the document's numbers; every float case compares
*> the value times 100000 rounded. Draws are injected through the draw tables.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-PARTICLES-42-4-5.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CLPCL.
 COPY CLPCLX.
 COPY CLP4X.
 COPY TESTLIB.
 01 WS-NAME                PIC X(160).
 01 WS-DRAWS.
    05 WS-D                FLOAT-LONG OCCURS 16 TIMES.
 01 WS-EDRAWS.
    05 WS-E                FLOAT-LONG OCCURS 16 TIMES.
 01 W1                     FLOAT-LONG.
 01 W2                     FLOAT-LONG.
 01 W3                     FLOAT-LONG.
 01 W4                     FLOAT-LONG.
 01 W5                     FLOAT-LONG.
 01 W6                     FLOAT-LONG.
 01 W7                     FLOAT-LONG.
 01 W8                     FLOAT-LONG.
 01 I1                     BINARY-LONG.
 01 I2                     BINARY-LONG.
 01 I3                     BINARY-LONG.
 01 I4                     BINARY-LONG.
 01 I5                     BINARY-LONG.
 01 B1                     BINARY-DOUBLE.
 01 T1                     PIC X(80).
 01 Z1                     FLOAT-LONG VALUE 0.
 01 Z2                     FLOAT-LONG VALUE 0.
 01 Z3                     FLOAT-LONG VALUE 0.
 01 Z4                     FLOAT-LONG VALUE 0.
 01 Z5                     FLOAT-LONG VALUE 0.
 01 Z6                     FLOAT-LONG VALUE 0.
 01 WS-NAME8              PIC X(32).
 01 WS-ARGB               BINARY-DOUBLE.
 01 WS-F1                 BINARY-LONG.
 01 WS-F2                 BINARY-LONG.
 01 WS-POS.
    05 WS-O                FLOAT-LONG OCCURS 3 TIMES.
 01 WS-P.
    05 WS-PP               FLOAT-LONG OCCURS 3 TIMES.
 PROCEDURE DIVISION.
     MOVE 1 TO WS-F1
     MOVE 1 TO WS-F2
     CALL "P4-FALLDUST-BRANCH" USING WS-F1 WS-F2 I1
     MOVE "a FallingBlock uses getDustColor first (branch 1)" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I1
     PERFORM ASSERT-NUMBER
     MOVE 0 TO WS-F1
     CALL "P4-FALLDUST-BRANCH" USING WS-F1 WS-F2 I1
     MOVE "else a tint source of index 0 (branch 2)" TO WS-NAME
     MOVE 2 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I1
     PERFORM ASSERT-NUMBER
     MOVE 0 TO WS-F2
     CALL "P4-FALLDUST-BRANCH" USING WS-F1 WS-F2 I1
     MOVE "else the map colour (branch 3), also suspicious sand" TO WS-NAME
     MOVE 3 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I1
     PERFORM ASSERT-NUMBER
     MOVE "sand" TO WS-NAME8
     CALL "P4-FALLDUST-BLOCK-COLOR" USING WS-NAME8 WS-ARGB I1
     MOVE "sand colour 14406560" TO WS-NAME
     MOVE 14406560 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-ARGB
     PERFORM ASSERT-NUMBER
     MOVE "sand is a fixed colour (1)" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I1
     PERFORM ASSERT-NUMBER
     MOVE "red_sand" TO WS-NAME8
     CALL "P4-FALLDUST-BLOCK-COLOR" USING WS-NAME8 WS-ARGB I1
     MOVE "red_sand colour 11098145" TO WS-NAME
     MOVE 11098145 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-ARGB
     PERFORM ASSERT-NUMBER
     MOVE "gravel" TO WS-NAME8
     CALL "P4-FALLDUST-BLOCK-COLOR" USING WS-NAME8 WS-ARGB I1
     MOVE "gravel colour -8356741" TO WS-NAME
     MOVE -8356741 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-ARGB
     PERFORM ASSERT-NUMBER
     MOVE "dragon_egg" TO WS-NAME8
     CALL "P4-FALLDUST-BLOCK-COLOR" USING WS-NAME8 WS-ARGB I1
     MOVE "dragon egg is black -16777216" TO WS-NAME
     MOVE -16777216 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-ARGB
     PERFORM ASSERT-NUMBER
     MOVE "white_concrete_powder" TO WS-NAME8
     CALL "P4-FALLDUST-BLOCK-COLOR" USING WS-NAME8 WS-ARGB I1
     MOVE "concrete powder uses the map colour (2)" TO WS-NAME
     MOVE 2 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I1
     PERFORM ASSERT-NUMBER
     MOVE "chipped_anvil" TO WS-NAME8
     CALL "P4-FALLDUST-BLOCK-COLOR" USING WS-NAME8 WS-ARGB I1
     MOVE "anvil uses the map colour (2)" TO WS-NAME
     MOVE 2 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I1
     PERFORM ASSERT-NUMBER
     MOVE "suspicious_sand" TO WS-NAME8
     CALL "P4-FALLDUST-BLOCK-COLOR" USING WS-NAME8 WS-ARGB I1
     MOVE "a brushable block is not a FallingBlock (0)" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I1
     PERFORM ASSERT-NUMBER
     MOVE -8356741 TO WS-ARGB
     CALL "P4-FALLDUST-RGB" USING WS-ARGB W1 W2 W3
     MOVE "gravel red channel 128 / 255 (alpha dropped)" TO WS-NAME
     MOVE 50196 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((W1) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "gravel green channel 124 / 255" TO WS-NAME
     MOVE 48627 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((W2) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "gravel blue channel 123 / 255" TO WS-NAME
     MOVE 48235 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((W3) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 0.3 TO WS-D(1)
     MOVE 0.5 TO WS-D(2)
     MOVE 0.5 TO WS-D(3)
     MOVE 0.75 TO WS-D(4)
     MOVE 0.25 TO WS-D(5)
     MOVE 1 TO W1
     MOVE 2 TO W2
     MOVE 3 TO W3
     MOVE 0.2 TO W4
     MOVE 0.4 TO W5
     MOVE 0.6 TO W6
     CALL "P4-FALLDUST-NEW" USING PCL P4X W1 W2 W3 W4 W5 W6 WS-DRAWS
     MOVE "colour is the supplied channel (red)" TO WS-NAME
     MOVE 20000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-RCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "colour is the supplied channel (blue)" TO WS-NAME
     MOVE 60000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-BCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "quad size 0.15 * 0.67499995" TO WS-NAME
     MOVE 10125 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-QUAD-SIZE) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "example 5: f = 0.5 gives lifetime 47" TO WS-NAME
     MOVE 47 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-LIFETIME
     PERFORM ASSERT-NUMBER
     MOVE "rotSpeed = (draw - 0.5) * 0.1" TO WS-NAME
     MOVE 2500 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((X4-ROT-SPEED) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "roll = draw * 6.2831855" TO WS-NAME
     MOVE 157080 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-ROLL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "the particle starts at rest" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-XD + PC-YD + PC-ZD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 1.0 TO WS-D(3)
     CALL "P4-FALLDUST-NEW" USING PCL P4X W1 W2 W3 W4 W5 W6 WS-DRAWS
     MOVE "f = 1: 32 * 0.9 = 28" TO WS-NAME
     MOVE 28 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-LIFETIME
     PERFORM ASSERT-NUMBER
     MOVE 0 TO WS-D(3)
     CALL "P4-FALLDUST-NEW" USING PCL P4X W1 W2 W3 W4 W5 W6 WS-DRAWS
     MOVE "f = 0: 160 * 0.9f = 144 in float32" TO WS-NAME
     MOVE 144 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-LIFETIME
     PERFORM ASSERT-NUMBER
     MOVE 0.5 TO WS-D(3)
     CALL "P4-FALLDUST-NEW" USING PCL P4X W1 W2 W3 W4 W5 W6 WS-DRAWS
     MOVE 0.5 TO W7
     CALL "P4-GROW-SIZE" USING PCL W7 W8
     MOVE "grow-in: age 0 partial 0.5 gives 0.5 / 47 * 32 of the size" TO WS-NAME
     MOVE 3447 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((W8) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 2 TO PC-AGE
     CALL "P4-GROW-SIZE" USING PCL W7 W8
     MOVE "grow-in: full size once (age + partial) / lifetime * 32 >= 1" TO WS-NAME
     MOVE 10125 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((W8) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 0 TO PK-COUNT
     MOVE 100 TO PC-LIFETIME
     MOVE 0 TO PC-AGE
     MOVE 8 TO I2
     CALL "P4-FALLDUST-TICK" USING PCL P4X PCL-COLLIDERS I2
     MOVE "tick 1: yd -= 0.003000000026077032" TO WS-NAME
     MOVE -300 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-YD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "tick 1: the move used the velocity before the change (y)" TO WS-NAME
     MOVE 200000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-Y) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "tick 1: roll += 3.1415927 * rotSpeed * 2" TO WS-NAME
     MOVE 172788 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-ROLL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "tick 1: age incremented" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-AGE
     PERFORM ASSERT-NUMBER
     MOVE "tick 1: xd and zd stay 0" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-XD + PC-ZD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     PERFORM 60 TIMES
         CALL "P4-FALLDUST-TICK" USING PCL P4X PCL-COLLIDERS I2
     END-PERFORM
     MOVE "terminal fall speed 0.14" TO WS-NAME
     MOVE -14000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-YD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 1 TO PC-ON-GROUND
     CALL "P4-FALLDUST-TICK" USING PCL P4X PCL-COLLIDERS I2
     MOVE "on the ground the roll is reset to 0" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-ROLL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 5 TO PC-LIFETIME
     MOVE 5 TO PC-AGE
     MOVE 0 TO PC-REMOVED
     CALL "P4-FALLDUST-TICK" USING PCL P4X PCL-COLLIDERS I2
     MOVE "removed when the old age reaches the lifetime" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-REMOVED
     PERFORM ASSERT-NUMBER
     MOVE 10 TO WS-PP(1)
     MOVE 64 TO WS-PP(2)
     MOVE 20 TO WS-PP(3)
     MOVE 0.3 TO W1
     MOVE 0.7 TO W2
     MOVE 0 TO I1
     MOVE 1 TO WS-F1
     CALL "P4-FALLDUST-EMIT" USING WS-P I1 WS-F1 W1 W2 WS-POS I2
     MOVE "nextInt(16) = 0 and a free block below emits" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I2
     PERFORM ASSERT-NUMBER
     MOVE "emission x = x + nextDouble" TO WS-NAME
     MOVE 1030000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-O(1)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "emission y = y - 0.05" TO WS-NAME
     MOVE 6395000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-O(2)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "emission z = z + nextDouble" TO WS-NAME
     MOVE 2070000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-O(3)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 5 TO I1
     CALL "P4-FALLDUST-EMIT" USING WS-P I1 WS-F1 W1 W2 WS-POS I2
     MOVE "nextInt(16) other than 0 does not emit" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I2
     PERFORM ASSERT-NUMBER
     MOVE 0 TO I1
     MOVE 0 TO WS-F1
     CALL "P4-FALLDUST-EMIT" USING WS-P I1 WS-F1 W1 W2 WS-POS I2
     MOVE "a block below that is not free does not emit" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I2
     PERFORM ASSERT-NUMBER
     MOVE -5 TO PC-AGE
     MOVE 100 TO PC-LIFETIME
     MOVE 0.1 TO PC-QUAD-SIZE
     MOVE 0 TO W7
     CALL "P4-GROW-SIZE" USING PCL W7 W8
     MOVE "grow-in clamps a negative factor to 0" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((W8) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     STOP RUN.

 ASSERT-NUMBER.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-4§5 `FallingDustParticle`: " FUNCTION TRIM(WS-NAME)
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "N" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 ASSERT-TEXT.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-4§5 `FallingDustParticle`: " FUNCTION TRIM(WS-NAME)
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "T" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-PARTICLES-42-4-5.
