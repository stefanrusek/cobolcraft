*> Acceptance test of docs/protocol/42-particles-6-emitters-blocks.md section 7: the emitter rules.
*> Expected texts are computed independently by a script from the document's formulas; each case injects the draws in the documented order and
*> compares the emission list (5 decimals), the sounds and the count of draws consumed.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-PARTICLES-42-6-7.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CLP6EM.
 COPY TESTLIB.
 01 WS-NAME                PIC X(160).
 01 WS-CLASS               PIC X(24).
 01 WS-PT                  PIC X(80).
 01 WS-PRT                 PIC X(80).
 01 WS-DRT                 PIC X(4000).
 01 WS-EXP                 PIC X(4000).
 01 WS-OBS                 PIC X(12000).
 01 WS-OBS2                PIC X(12000).
 01 WS-LEN                 BINARY-LONG.
 01 WS-START               BINARY-LONG.
 01 WS-BLOCK.
    05 WS-BP               BINARY-LONG OCCURS 3 TIMES.
 01 WS-PROPS.
    05 WS-PR               BINARY-LONG OCCURS 12 TIMES.
 01 WS-LIST.
    05 WS-NUM              FLOAT-LONG OCCURS 2100 TIMES.
 01 WS-COUNT               BINARY-LONG.
 01 WS-TEXT                PIC X(4000).
 01 WS-TOK                 PIC X(40).
 01 WS-PTR                 BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-PTR2                BINARY-LONG.
 01 WS-ED                  PIC -(5)9.99999.
 01 WS-EDC                 PIC -(10)9.
 01 WS-EDS                 PIC 9.99.
 01 WS-EDR                 PIC 9.99999.
 01 WS-V                   FLOAT-LONG.
 01 WS-STATE               BINARY-LONG.
 01 WS-NB                  BINARY-LONG.
 01 WS-BOXES.
    05 WS-BOX              OCCURS 16 TIMES.
       10 WS-BX            FLOAT-LONG OCCURS 6 TIMES.
 01 WS-OBSX               PIC X(2000).
 01 WS-SAVE                BINARY-LONG.
 PROCEDURE DIVISION.
     MOVE "crack down full block" TO WS-NAME
     MOVE "crack" TO WS-CLASS
     MOVE "10 64 -3" TO WS-PT
     MOVE "1 0 0 0 0 1000 1000 1000" TO WS-PRT
     MOVE "0.5 0.5 0.5" TO WS-DRT
     MOVE "block 10.50000 63.90000 -2.50000 0.00000 0.00000 0.00000 r=0.60000 st=1 (3)" TO WS-EXP
     PERFORM RUN-CASE
     MOVE "crack up" TO WS-NAME
     MOVE "crack" TO WS-CLASS
     MOVE "10 64 -3" TO WS-PT
     MOVE "1 1 0 0 0 1000 1000 1000" TO WS-PRT
     MOVE "0.25 0.5 0.75" TO WS-DRT
     MOVE "block 10.30000 65.10000 -2.30000 0.00000 0.00000 0.00000 r=0.60000 st=1 (3)" TO WS-EXP
     PERFORM RUN-CASE
     MOVE "crack north" TO WS-NAME
     MOVE "crack" TO WS-CLASS
     MOVE "10 64 -3" TO WS-PT
     MOVE "1 2 0 0 0 1000 1000 1000" TO WS-PRT
     MOVE "0.25 0.5 0.75" TO WS-DRT
     MOVE "block 10.30000 64.50000 -3.10000 0.00000 0.00000 0.00000 r=0.60000 st=1 (3)" TO WS-EXP
     PERFORM RUN-CASE
     MOVE "crack south" TO WS-NAME
     MOVE "crack" TO WS-CLASS
     MOVE "10 64 -3" TO WS-PT
     MOVE "1 3 0 0 0 1000 1000 1000" TO WS-PRT
     MOVE "0.25 0.5 0.75" TO WS-DRT
     MOVE "block 10.30000 64.50000 -1.90000 0.00000 0.00000 0.00000 r=0.60000 st=1 (3)" TO WS-EXP
     PERFORM RUN-CASE
     MOVE "crack west" TO WS-NAME
     MOVE "crack" TO WS-CLASS
     MOVE "10 64 -3" TO WS-PT
     MOVE "1 4 0 0 0 1000 1000 1000" TO WS-PRT
     MOVE "0.25 0.5 0.75" TO WS-DRT
     MOVE "block 9.90000 64.50000 -2.30000 0.00000 0.00000 0.00000 r=0.60000 st=1 (3)" TO WS-EXP
     PERFORM RUN-CASE
     MOVE "crack east" TO WS-NAME
     MOVE "crack" TO WS-CLASS
     MOVE "10 64 -3" TO WS-PT
     MOVE "7 5 0 0 0 1000 1000 1000" TO WS-PRT
     MOVE "0.25 0.5 0.75" TO WS-DRT
     MOVE "block 11.10000 64.50000 -2.30000 0.00000 0.00000 0.00000 r=0.60000 st=7 (3)" TO WS-EXP
     PERFORM RUN-CASE
     MOVE "crack up on a slab-like shape" TO WS-NAME
     MOVE "crack" TO WS-CLASS
     MOVE "10 64 -3" TO WS-PT
     MOVE "7 1 250 0 250 750 500 750" TO WS-PRT
     MOVE "0.1 0.9 0.3" TO WS-DRT
     MOVE "block 10.38000 64.60000 -2.56000 0.00000 0.00000 0.00000 r=0.60000 st=7 (3)" TO WS-EXP
     PERFORM RUN-CASE
     MOVE "10 64 -3" TO WS-PT
     MOVE 10 TO WS-BP(1)
     MOVE 64 TO WS-BP(2)
     MOVE -3 TO WS-BP(3)
     MOVE 0 TO WS-BX(1, 1)
     MOVE 0 TO WS-BX(1, 2)
     MOVE 0 TO WS-BX(1, 3)
     MOVE 1 TO WS-BX(1, 4)
     MOVE 1 TO WS-BX(1, 5)
     MOVE 1 TO WS-BX(1, 6)
     MOVE 1 TO WS-STATE
     MOVE 1 TO WS-NB
     CALL "P6-DESTROY" USING WS-BLOCK WS-STATE WS-NB WS-BOXES P6-EMITS
     MOVE "full block: rows" TO WS-NAME
     MOVE 64 TO TL-EXPECTED-N
     MOVE EM-COUNT TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     MOVE 1 TO WS-I
     PERFORM RENDER-ONE
     MOVE "full block: first row" TO WS-NAME
     MOVE "block 10.12500 64.12500 -2.87500 -0.37500 -0.37500 -0.37500 st=1" TO WS-EXP
     PERFORM ASSERT-ONE
     MOVE 64 TO WS-I
     PERFORM RENDER-ONE
     MOVE "full block: last row" TO WS-NAME
     MOVE "block 10.87500 64.87500 -2.12500 0.37500 0.37500 0.37500 st=1" TO WS-EXP
     PERFORM ASSERT-ONE
     MOVE 22 TO WS-I
     PERFORM RENDER-ONE
     MOVE "full block: row 22 row" TO WS-NAME
     MOVE "block 10.37500 64.37500 -2.62500 -0.12500 -0.12500 -0.12500 st=1" TO WS-EXP
     PERFORM ASSERT-ONE
     MOVE 0 TO WS-BX(1, 1)
     MOVE 0 TO WS-BX(1, 2)
     MOVE 0 TO WS-BX(1, 3)
     MOVE 1 TO WS-BX(1, 4)
     MOVE 0.5 TO WS-BX(1, 5)
     MOVE 1 TO WS-BX(1, 6)
     MOVE 2 TO WS-STATE
     MOVE 1 TO WS-NB
     CALL "P6-DESTROY" USING WS-BLOCK WS-STATE WS-NB WS-BOXES P6-EMITS
     MOVE "slab: rows" TO WS-NAME
     MOVE 32 TO TL-EXPECTED-N
     MOVE EM-COUNT TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     MOVE 1 TO WS-I
     PERFORM RENDER-ONE
     MOVE "slab: first row" TO WS-NAME
     MOVE "block 10.12500 64.12500 -2.87500 -0.37500 -0.25000 -0.37500 st=2" TO WS-EXP
     PERFORM ASSERT-ONE
     MOVE 32 TO WS-I
     PERFORM RENDER-ONE
     MOVE "slab: last row" TO WS-NAME
     MOVE "block 10.87500 64.37500 -2.12500 0.37500 0.25000 0.37500 st=2" TO WS-EXP
     PERFORM ASSERT-ONE
     MOVE 0.375 TO WS-BX(1, 1)
     MOVE 0 TO WS-BX(1, 2)
     MOVE 0.375 TO WS-BX(1, 3)
     MOVE 0.625 TO WS-BX(1, 4)
     MOVE 0.625 TO WS-BX(1, 5)
     MOVE 0.625 TO WS-BX(1, 6)
     MOVE 7 TO WS-STATE
     MOVE 1 TO WS-NB
     CALL "P6-DESTROY" USING WS-BLOCK WS-STATE WS-NB WS-BOXES P6-EMITS
     MOVE "torch: rows" TO WS-NAME
     MOVE 12 TO TL-EXPECTED-N
     MOVE EM-COUNT TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     MOVE 1 TO WS-I
     PERFORM RENDER-ONE
     MOVE "torch: first row" TO WS-NAME
     MOVE "block 10.43750 64.10417 -2.56250 -0.25000 -0.33333 -0.25000 st=7" TO WS-EXP
     PERFORM ASSERT-ONE
     MOVE 12 TO WS-I
     PERFORM RENDER-ONE
     MOVE "torch: last row" TO WS-NAME
     MOVE "block 10.56250 64.52083 -2.43750 0.25000 0.33333 0.25000 st=7" TO WS-EXP
     PERFORM ASSERT-ONE
     MOVE 0 TO WS-BX(1, 1)
     MOVE 0 TO WS-BX(1, 2)
     MOVE 0 TO WS-BX(1, 3)
     MOVE 1 TO WS-BX(1, 4)
     MOVE 1 TO WS-BX(1, 5)
     MOVE 1 TO WS-BX(1, 6)
     MOVE 0 TO WS-BX(2, 1)
     MOVE 0 TO WS-BX(2, 2)
     MOVE 0 TO WS-BX(2, 3)
     MOVE 1 TO WS-BX(2, 4)
     MOVE 0.5 TO WS-BX(2, 5)
     MOVE 1 TO WS-BX(2, 6)
     MOVE 3 TO WS-STATE
     MOVE 2 TO WS-NB
     CALL "P6-DESTROY" USING WS-BLOCK WS-STATE WS-NB WS-BOXES P6-EMITS
     MOVE "two boxes: rows" TO WS-NAME
     MOVE 96 TO TL-EXPECTED-N
     MOVE EM-COUNT TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     MOVE 1 TO WS-I
     PERFORM RENDER-ONE
     MOVE "two boxes: first row" TO WS-NAME
     MOVE "block 10.12500 64.12500 -2.87500 -0.37500 -0.37500 -0.37500 st=3" TO WS-EXP
     PERFORM ASSERT-ONE
     MOVE 96 TO WS-I
     PERFORM RENDER-ONE
     MOVE "two boxes: last row" TO WS-NAME
     MOVE "block 10.87500 64.37500 -2.12500 0.37500 0.25000 0.37500 st=3" TO WS-EXP
     PERFORM ASSERT-ONE
     MOVE -0.5 TO WS-BX(1, 1)
     MOVE 0 TO WS-BX(1, 2)
     MOVE -0.5 TO WS-BX(1, 3)
     MOVE 1.5 TO WS-BX(1, 4)
     MOVE 1 TO WS-BX(1, 5)
     MOVE 1.5 TO WS-BX(1, 6)
     MOVE 4 TO WS-STATE
     MOVE 1 TO WS-NB
     CALL "P6-DESTROY" USING WS-BLOCK WS-STATE WS-NB WS-BOXES P6-EMITS
     MOVE "oversized box is capped at one block: rows" TO WS-NAME
     MOVE 64 TO TL-EXPECTED-N
     MOVE EM-COUNT TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     MOVE 1 TO WS-I
     PERFORM RENDER-ONE
     MOVE "oversized box is capped at one block: first row" TO WS-NAME
     MOVE "block 9.62500 64.12500 -3.37500 -0.37500 -0.37500 -0.37500 st=4" TO WS-EXP
     PERFORM ASSERT-ONE
     MOVE 64 TO WS-I
     PERFORM RENDER-ONE
     MOVE "oversized box is capped at one block: last row" TO WS-NAME
     MOVE "block 10.37500 64.87500 -2.62500 0.37500 0.37500 0.37500 st=4" TO WS-EXP
     PERFORM ASSERT-ONE
     MOVE 0 TO WS-NB
     CALL "P6-DESTROY" USING WS-BLOCK WS-STATE WS-NB WS-BOXES P6-EMITS
     MOVE "no boxes emit nothing" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     MOVE EM-COUNT TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     STOP RUN.

 RUN-CASE.
     MOVE WS-PT TO WS-TEXT
     PERFORM PARSE-LIST
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 3
         MOVE WS-NUM(WS-I) TO WS-BP(WS-I)
     END-PERFORM
     MOVE WS-PRT TO WS-TEXT
     PERFORM PARSE-LIST
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 12
         MOVE 0 TO WS-PR(WS-I)
     END-PERFORM
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-COUNT
         MOVE WS-NUM(WS-I) TO WS-PR(WS-I)
     END-PERFORM
     MOVE WS-DRT TO WS-TEXT
     PERFORM PARSE-LIST
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 2048
         MOVE 0.5 TO EM-DRAW(WS-I)
     END-PERFORM
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-COUNT
         MOVE WS-NUM(WS-I) TO EM-DRAW(WS-I)
     END-PERFORM
     CALL "P6-BLOCK-EFFECT" USING WS-CLASS WS-BLOCK WS-PROPS P6-EMITS
     PERFORM RENDER
     MOVE FUNCTION LENGTH(FUNCTION TRIM(WS-OBS)) TO WS-LEN
     IF WS-LEN > 1000
         MOVE WS-OBS(1:480) TO WS-OBS2(1:480)
         MOVE "..." TO WS-OBS2(481:3)
         COMPUTE WS-START = WS-LEN - 479
         MOVE WS-OBS(WS-START:480) TO WS-OBS2(484:480)
         MOVE WS-OBS2 TO WS-OBS
     END-IF
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-6§7 Block break, hit and crack: " FUNCTION TRIM(WS-NAME)
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE WS-EXP TO TL-EXPECTED
     MOVE WS-OBS TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 RENDER-ONE.
     MOVE EM-COUNT TO WS-SAVE
     MOVE EM-ROW(WS-I) TO EM-ROW(1)
     MOVE 1 TO EM-COUNT
     MOVE 0 TO EM-SOUND-COUNT
     PERFORM RENDER
     MOVE WS-OBS TO WS-OBSX
     MOVE WS-SAVE TO EM-COUNT.

 ASSERT-ONE.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-6§7 Block break, hit and crack: " FUNCTION TRIM(WS-NAME)
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE SPACES TO TL-EXPECTED
     STRING FUNCTION TRIM(WS-EXP) " (0)" DELIMITED BY SIZE INTO TL-EXPECTED
     MOVE WS-OBSX TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 ASSERT-NUMBER.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-6§7 Block break, hit and crack: " FUNCTION TRIM(WS-NAME)
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "N" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 PARSE-LIST.
     MOVE 0 TO WS-COUNT
     MOVE 1 TO WS-PTR
     PERFORM UNTIL WS-PTR > 4000 OR WS-TEXT(WS-PTR:) = SPACES
         MOVE SPACES TO WS-TOK
         UNSTRING WS-TEXT DELIMITED BY ALL SPACE INTO WS-TOK WITH POINTER WS-PTR
         IF WS-TOK NOT = SPACES
             ADD 1 TO WS-COUNT
             COMPUTE WS-NUM(WS-COUNT) = FUNCTION NUMVAL(WS-TOK)
         END-IF
     END-PERFORM.

 RENDER.
     MOVE SPACES TO WS-OBS
     MOVE 1 TO WS-PTR2
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > EM-COUNT
         IF WS-I > 1
             STRING " | " DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2
         END-IF
         STRING FUNCTION TRIM(EM-NAME(WS-I)) " " DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2
         MOVE EM-X(WS-I) TO WS-V
         PERFORM ADD-NUMBER
         MOVE EM-Y(WS-I) TO WS-V
         PERFORM ADD-NUMBER
         MOVE EM-Z(WS-I) TO WS-V
         PERFORM ADD-NUMBER
         MOVE EM-VX(WS-I) TO WS-V
         PERFORM ADD-NUMBER
         MOVE EM-VY(WS-I) TO WS-V
         PERFORM ADD-NUMBER
         MOVE EM-VZ(WS-I) TO WS-V
         PERFORM ADD-LAST-NUMBER
         IF EM-COLOR(WS-I) NOT = 0
             MOVE EM-COLOR(WS-I) TO WS-EDC
             COMPUTE WS-EDS ROUNDED = EM-SCALE(WS-I)
             STRING " c=" FUNCTION TRIM(WS-EDC) " s=" WS-EDS DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2
         END-IF
         IF EM-COLOR(WS-I) = 0 AND EM-SCALE(WS-I) NOT = 0
             COMPUTE WS-EDR ROUNDED = EM-SCALE(WS-I)
             STRING " r=" WS-EDR DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2
         END-IF
         IF EM-STATE(WS-I) NOT = 0
             MOVE EM-STATE(WS-I) TO WS-EDC
             STRING " st=" FUNCTION TRIM(WS-EDC) DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2
         END-IF
     END-PERFORM
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > EM-SOUND-COUNT
         STRING " # " FUNCTION TRIM(EM-SOUND(WS-I)) DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2
     END-PERFORM
     MOVE EM-CUR TO WS-EDC
     STRING " (" FUNCTION TRIM(WS-EDC) ")" DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2.

 ADD-NUMBER.
     PERFORM ADD-LAST-NUMBER
     STRING " " DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2.

 ADD-LAST-NUMBER.
     COMPUTE WS-ED ROUNDED = WS-V
     STRING FUNCTION TRIM(WS-ED) DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2.
 END PROGRAM TEST-PARTICLES-42-6-7.
