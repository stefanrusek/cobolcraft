*> T28400 (lane 002-lane-p70d): the item a mob holds in the stand-in set, with no pack: a block item is the unit cube with the default display transform of block/block (rotation (75, 45, 0),
*> translation (0, 2.5, 0), scale 0.375; the left arm mirrored: rotation y -45), posed in the frame of the arm part (the identity axes at (0.5, 1, 0.25), the entity (0.5, 0, 0.5) from the eye;
*> expected vertices from the same independent script as test_entity_held_pose).
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-ENTITY-HELD-DEFAULT.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CLSTATE.
 COPY CLCONST.
 COPY CONTENT.
 COPY TESTLIB.
 01 WS-KEY                 PIC X(112).
 01 WS-ROW-AREA            PIC X(66).
 01 WS-STATUS              BINARY-LONG.
 01 WS-TYPE                BINARY-LONG.
 01 WS-X                   FLOAT-LONG VALUE 10.5.
 01 WS-Y                   FLOAT-LONG VALUE 64.
 01 WS-Z                   FLOAT-LONG VALUE 10.5.
 01 WS-YAW                 FLOAT-SHORT VALUE 0.
 01 WS-ID                  BINARY-LONG.
 01 WS-ITEM                BINARY-LONG VALUE 1.
 01 WS-HAND                BINARY-LONG.
 01 WS-HAND-I              BINARY-LONG.
 01 WS-BAD                 BINARY-LONG.
 01 WS-EXPECT.
    05 WS-EX               FLOAT-LONG OCCURS 9 TIMES.
 01 WS-EYE-TABLE.
    05 WS-EYE              FLOAT-LONG OCCURS 3 TIMES.
 PROCEDURE DIVISION.
     CALL "CL-INIT" USING CLIENT-STATE
     MOVE 0 TO PK-COUNT
     MOVE 256 TO PL-HEIGHT
     MOVE 0 TO SK-U
     MOVE 10 TO WS-EYE(1) WS-EYE(3)
     MOVE 64 TO WS-EYE(2)
     MOVE 0 TO CT-OPEN
     MOVE "N" TO TL-MODE
     CALL "ENTITIES-CLEAR" USING CLIENT-STATE
     MOVE 1 TO WS-ID
     MOVE 3 TO WS-TYPE
     CALL "MM-SPAWN" USING CLIENT-STATE WS-ID WS-TYPE WS-X WS-Y WS-Z WS-YAW
     PERFORM VARYING WS-HAND-I FROM 1 BY 1 UNTIL WS-HAND-I > 2
         MOVE 1 TO EN-HAND-FOK(1, WS-HAND-I)
         MOVE 0.5 TO EN-HAND-F(1, WS-HAND-I, 1)
         MOVE 1 TO EN-HAND-F(1, WS-HAND-I, 2)
         MOVE 0.25 TO EN-HAND-F(1, WS-HAND-I, 3)
         MOVE 0 TO EN-HAND-F(1, WS-HAND-I, 4) EN-HAND-F(1, WS-HAND-I, 5) EN-HAND-F(1, WS-HAND-I, 6)
         MOVE 0 TO EN-HAND-F(1, WS-HAND-I, 7) EN-HAND-F(1, WS-HAND-I, 8) EN-HAND-F(1, WS-HAND-I, 9)
         MOVE 0 TO EN-HAND-F(1, WS-HAND-I, 10) EN-HAND-F(1, WS-HAND-I, 11) EN-HAND-F(1, WS-HAND-I, 12)
         MOVE 1 TO EN-HAND-F(1, WS-HAND-I, 4) EN-HAND-F(1, WS-HAND-I, 8) EN-HAND-F(1, WS-HAND-I, 12)
     END-PERFORM
     MOVE 1 TO WS-HAND
     MOVE 0 TO RL-GI-COUNT
     CALL "ENTITY-HELD-POSED" USING CLIENT-STATE WS-ID WS-HAND WS-ITEM WS-EYE-TABLE
     MOVE "T28400 a stand-in block item is a cube of 36 vertices" TO TL-CASE
     MOVE 36 TO TL-EXPECTED-N
     MOVE RL-GI-COUNT TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 0.9375 TO WS-EX(1)
     MOVE 1.37526 TO WS-EX(2)
     MOVE 0.67635 TO WS-EX(3)
     MOVE 0.67233 TO WS-EX(4)
     MOVE 1.44389 TO WS-EX(5)
     MOVE 0.42022 TO WS-EX(6)
     MOVE 0.67233 TO WS-EX(7)
     MOVE 1.80611 TO WS-EX(8)
     MOVE 0.51728 TO WS-EX(9)
     MOVE "T28400 the stand-in cube in the right hand takes the default (75, 45, 0) / 0.375" TO TL-CASE
     PERFORM CHECK-3
     MOVE 2 TO WS-HAND
     MOVE 0 TO RL-GI-COUNT
     CALL "ENTITY-HELD-POSED" USING CLIENT-STATE WS-ID WS-HAND WS-ITEM WS-EYE-TABLE
     MOVE 1.32767 TO WS-EX(1)
     MOVE 1.44389 TO WS-EX(2)
     MOVE 0.42022 TO WS-EX(3)
     MOVE 1.0625 TO WS-EX(4)
     MOVE 1.37526 TO WS-EX(5)
     MOVE 0.67635 TO WS-EX(6)
     MOVE 1.0625 TO WS-EX(7)
     MOVE 1.73748 TO WS-EX(8)
     MOVE 0.77341 TO WS-EX(9)
     MOVE "T28400 the stand-in cube in the left hand takes the mirrored default (rotation y -45)" TO TL-CASE
     PERFORM CHECK-3
     STOP RUN.

*> Vertices 1 to 3 of the mesh equal WS-EX (within 0.001).
 CHECK-3.
     MOVE 0 TO WS-BAD
     IF FUNCTION ABS(RL-GI-X(1) - WS-EX(1)) > 0.001 OR FUNCTION ABS(RL-GI-Y(1) - WS-EX(2)) > 0.001 OR FUNCTION ABS(RL-GI-Z(1) - WS-EX(3)) > 0.001
         ADD 1 TO WS-BAD
     END-IF
     IF FUNCTION ABS(RL-GI-X(2) - WS-EX(4)) > 0.001 OR FUNCTION ABS(RL-GI-Y(2) - WS-EX(5)) > 0.001 OR FUNCTION ABS(RL-GI-Z(2) - WS-EX(6)) > 0.001
         ADD 1 TO WS-BAD
     END-IF
     IF FUNCTION ABS(RL-GI-X(3) - WS-EX(7)) > 0.001 OR FUNCTION ABS(RL-GI-Y(3) - WS-EX(8)) > 0.001 OR FUNCTION ABS(RL-GI-Z(3) - WS-EX(9)) > 0.001
         ADD 1 TO WS-BAD
     END-IF
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-BAD TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-ENTITY-HELD-DEFAULT.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. MM-SPAWN.
*> USING CLIENT-STATE, entity id, type (registry id), x y z (FLOAT-LONG), yaw (FLOAT-SHORT, also the head yaw): Add Entity.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY PROTO.
 01 WS-READY               BINARY-LONG VALUE 0.
 01 WS-CAPACITY            BINARY-LONG VALUE 1024.
 01 WS-ADD                 BINARY-LONG VALUE 1.
 01 WS-ZERO                BINARY-LONG VALUE 0.
 01 WS-UUID                PIC X(16) VALUE LOW-VALUES.
 01 WS-V0                  FLOAT-LONG VALUE 0.
 01 WS-V1                  FLOAT-LONG VALUE 0.
 01 WS-V2                  FLOAT-LONG VALUE 0.
 01 WS-A0                  FLOAT-SHORT VALUE 0.
 LINKAGE SECTION.
 COPY CLSTATE.
 01 L-ID                   BINARY-LONG.
 01 L-TYPE                 BINARY-LONG.
 01 L-X                    FLOAT-LONG.
 01 L-Y                    FLOAT-LONG.
 01 L-Z                    FLOAT-LONG.
 01 L-YAW                  FLOAT-SHORT.
 PROCEDURE DIVISION USING CLIENT-STATE L-ID L-TYPE L-X L-Y L-Z L-YAW.
     IF WS-READY = 0
         CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
         MOVE 1 TO WS-READY
     END-IF
     CALL "PB-RESET" USING PB-BUFFER
     CALL "PB-PUT-VARINT" USING PB-BUFFER L-ID
     CALL "PB-PUT-UUID" USING PB-BUFFER WS-UUID
     CALL "PB-PUT-VARINT" USING PB-BUFFER L-TYPE
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER L-X
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER L-Y
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER L-Z
     CALL "PB-PUT-LPVEC3" USING PB-BUFFER WS-V0 WS-V1 WS-V2
     CALL "PB-PUT-ANGLE" USING PB-BUFFER WS-A0
     CALL "PB-PUT-ANGLE" USING PB-BUFFER L-YAW
     CALL "PB-PUT-ANGLE" USING PB-BUFFER L-YAW
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-ZERO
     MOVE 0 TO PB-POS
     CALL "ENTITY-PACKET" USING CLIENT-STATE PB-BUFFER WS-ADD
     GOBACK.
 END PROGRAM MM-SPAWN.

 COPY CLTEST.
