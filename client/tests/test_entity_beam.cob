 01 WS-EXP REDEFINES WS-EXP-DATA.
    05 WS-G OCCURS 7 TIMES.
       10 WS-GOFF          PIC 9(4).
       10 WS-GV OCCURS 6 TIMES.
          15 WS-GVX        FLOAT-LONG OCCURS 5 TIMES.
 01 WS-KEY                 PIC X(112).
 01 WS-ROW-AREA            PIC X(66).
 01 WS-STATUS              BINARY-LONG.
 01 WS-TYPE                BINARY-LONG.
 01 WS-X                   FLOAT-LONG VALUE 10.5.
 01 WS-Y                   FLOAT-LONG VALUE 64.
 01 WS-Z                   FLOAT-LONG VALUE 10.5.
 01 WS-TX                  FLOAT-LONG VALUE 14.5.
 01 WS-YAW                 FLOAT-SHORT VALUE 0.
 01 WS-ID                  BINARY-LONG.
 01 WS-J                   BINARY-LONG.
 01 WS-G1                  BINARY-LONG.
 01 WS-V                   BINARY-LONG.
 01 WS-BASE                BINARY-LONG.
 01 WS-COUNT0              BINARY-LONG.
 01 WS-YT                  FLOAT-LONG VALUE 63.725.
 01 WS-QUAD.
    05 WS-QV               FLOAT-LONG OCCURS 20 TIMES VALUE 0.
 01 WS-FRAME.
    05 WS-FV               FLOAT-LONG OCCURS 12 TIMES VALUE 0.
 01 WS-TINTS.
    05 WS-TV               FLOAT-LONG OCCURS 4 TIMES VALUE 0.
 01 WS-COUNT1              BINARY-LONG.
 01 WS-BM                  BINARY-LONG.
 01 WS-SLOT                BINARY-LONG.
 01 WS-S                   BINARY-LONG.
 01 WS-DIFF                FLOAT-LONG.
 01 WS-MAXD                FLOAT-LONG.
 01 WS-EU                  FLOAT-LONG.
 01 WS-EV                  FLOAT-LONG.
 01 WS-BMKEY               PIC X(24) VALUE "guardian_beam".
 01 WS-EYE-TABLE.
    05 WS-EYE              FLOAT-LONG OCCURS 3 TIMES.
 PROCEDURE DIVISION.
     CALL "CL-INIT" USING CLIENT-STATE
     MOVE 0 TO PK-COUNT
     CALL "ENTITY-ATLAS-BUILD" USING CLIENT-STATE
     MOVE 256 TO PL-HEIGHT
     MOVE 0 TO SK-U
     MOVE 10 TO WS-EYE(1) WS-EYE(3)
     MOVE 64 TO WS-EYE(2)
     MOVE 1 TO CT-OPEN
     MOVE CT-TYPE-STANDARD TO CT-SET-TYPE
     CALL "ENTITIES-CLEAR" USING CLIENT-STATE
*>   Row 1 the target (a cow 1.4 high, id 2), row 2 the guardian (id 1): the beam is the last thing meshed.
     MOVE "cow" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-TYPE WS-ROW-AREA WS-STATUS
     MOVE 2 TO WS-ID
     CALL "MM-SPAWN" USING CLIENT-STATE WS-ID WS-TYPE WS-TX WS-Y WS-Z WS-YAW
     MOVE 1.4 TO EN-BOX-HEIGHT(1)
     MOVE "guardian" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-TYPE WS-ROW-AREA WS-STATUS
     MOVE 1 TO WS-ID
     CALL "MM-SPAWN" USING CLIENT-STATE WS-ID WS-TYPE WS-X WS-Y WS-Z WS-YAW
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     MOVE RL-EN-COUNT TO WS-COUNT0
     MOVE "acceptance beam none without a target" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF WS-COUNT0 > 0
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     PERFORM CHECK-N
     MOVE 2 TO EN-TGT(2)
     MOVE 30 TO EN-RS(2)
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     MOVE RL-EN-COUNT TO WS-COUNT1
     MOVE "acceptance beam vertex count (14 strips x 2 planes x 12, and the cap 12)" TO TL-CASE
     COMPUTE TL-OBSERVED-N = WS-COUNT1 - WS-COUNT0
     MOVE 348 TO TL-EXPECTED-N
     PERFORM CHECK-N
     CALL "ENTITY-MODEL-FIND" USING WS-BMKEY WS-BM
     MOVE 0 TO WS-SLOT
     PERFORM VARYING WS-S FROM 1 BY 1 UNTIL WS-S > EA-MT-COUNT
         IF EA-MT-MODEL(WS-S) = WS-BM AND EA-MT-TEX(WS-S) = 0
             MOVE WS-S TO WS-SLOT
         END-IF
     END-PERFORM
     MOVE "acceptance beam image has an atlas slot" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF WS-SLOT > 0
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     PERFORM CHECK-N
     IF WS-SLOT = 0
         STOP RUN
     END-IF
     PERFORM VARYING WS-G1 FROM 1 BY 1 UNTIL WS-G1 > 7
         MOVE 0 TO WS-MAXD
         PERFORM VARYING WS-V FROM 1 BY 1 UNTIL WS-V > 6
             COMPUTE WS-BASE = WS-COUNT0 + WS-GOFF(WS-G1) + WS-V
             COMPUTE WS-DIFF = FUNCTION ABS(RL-EN-X(WS-BASE) - WS-GVX(WS-G1, WS-V, 1))
             IF WS-DIFF > WS-MAXD
                 MOVE WS-DIFF TO WS-MAXD
             END-IF
             COMPUTE WS-DIFF = FUNCTION ABS(RL-EN-Y(WS-BASE) - WS-GVX(WS-G1, WS-V, 2))
             IF WS-DIFF > WS-MAXD
                 MOVE WS-DIFF TO WS-MAXD
             END-IF
             COMPUTE WS-DIFF = FUNCTION ABS(RL-EN-Z(WS-BASE) - WS-GVX(WS-G1, WS-V, 3))
             IF WS-DIFF > WS-MAXD
                 MOVE WS-DIFF TO WS-MAXD
             END-IF
         END-PERFORM
         MOVE SPACES TO TL-CASE
         STRING "acceptance beam positions " FUNCTION TRIM(WS-GN(WS-G1)) DELIMITED BY SIZE INTO TL-CASE
         MOVE WS-MAXD TO WS-DIFF
         PERFORM CHECK-SMALL
         MOVE 0 TO WS-MAXD
         PERFORM VARYING WS-V FROM 1 BY 1 UNTIL WS-V > 6
             COMPUTE WS-BASE = WS-COUNT0 + WS-GOFF(WS-G1) + WS-V
             COMPUTE WS-EU = (EA-MT-X(WS-SLOT) + WS-GVX(WS-G1, WS-V, 4) * EA-MT-W(WS-SLOT)) / EA-W
             COMPUTE WS-EV = (EA-MT-Y(WS-SLOT) + WS-GVX(WS-G1, WS-V, 5) * EA-MT-H(WS-SLOT)) / EA-H
             COMPUTE WS-DIFF = FUNCTION ABS(RL-EN-U(WS-BASE) - WS-EU)
             IF WS-DIFF > WS-MAXD
                 MOVE WS-DIFF TO WS-MAXD
             END-IF
             COMPUTE WS-DIFF = FUNCTION ABS(RL-EN-V(WS-BASE) - WS-EV)
             IF WS-DIFF > WS-MAXD
                 MOVE WS-DIFF TO WS-MAXD
             END-IF
         END-PERFORM
         MOVE SPACES TO TL-CASE
         STRING "acceptance beam texture coordinates " FUNCTION TRIM(WS-GN(WS-G1)) DELIMITED BY SIZE INTO TL-CASE
         MOVE WS-MAXD TO WS-DIFF
         PERFORM CHECK-SMALL
     END-PERFORM
*>   Every beam vertex: tint of the attack scale (92, 60, 119 of 255), full bright, no sky term, opaque.
     MOVE 0 TO WS-MAXD
     PERFORM VARYING WS-J FROM WS-COUNT0 BY 1 UNTIL WS-J >= WS-COUNT1
         COMPUTE WS-BASE = WS-J + 1
         COMPUTE WS-DIFF = FUNCTION ABS(RL-EN-R(WS-BASE) - 0.3607843) + FUNCTION ABS(RL-EN-G(WS-BASE) - 0.2352941) + FUNCTION ABS(RL-EN-BLUE(WS-BASE) - 0.4666667)
             + FUNCTION ABS(RL-EN-B(WS-BASE) - 1) + FUNCTION ABS(RL-EN-A(WS-BASE) - 1) + FUNCTION ABS(RL-EN-SKY(WS-BASE))
         IF WS-DIFF > WS-MAXD
             MOVE WS-DIFF TO WS-MAXD
         END-IF
     END-PERFORM
     MOVE "acceptance beam tint, brightness and alpha of every vertex" TO TL-CASE
     MOVE WS-MAXD TO WS-DIFF
     PERFORM CHECK-SMALL
*>   The target is not in the replica: nothing is drawn.
     MOVE 99 TO EN-TGT(2)
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     MOVE "acceptance beam none for a target that is not known" TO TL-CASE
     COMPUTE TL-OBSERVED-N = RL-EN-COUNT - WS-COUNT0
     MOVE 0 TO TL-EXPECTED-N
     PERFORM CHECK-N
*>   The local player is a target (the replica holds no row for it): its position and a height of 1.8.
     MOVE 77 TO PL-ENTITY-ID
     MOVE 77 TO EN-TGT(2)
     MOVE 14.5 TO PL-X
     MOVE 64 TO PL-Y
     MOVE 10.5 TO PL-Z
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     MOVE "acceptance beam to the local player" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF RL-EN-COUNT - WS-COUNT0 > 12
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     PERFORM CHECK-N
*>   The elder guardian has its own eye height (0.99875): the beam starts higher.
     CALL "ENTITIES-CLEAR" USING CLIENT-STATE
     MOVE "cow" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-TYPE WS-ROW-AREA WS-STATUS
     MOVE 2 TO WS-ID
     CALL "MM-SPAWN" USING CLIENT-STATE WS-ID WS-TYPE WS-TX WS-Y WS-Z WS-YAW
     MOVE 1.4 TO EN-BOX-HEIGHT(1)
     MOVE "elder_guardian" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-TYPE WS-ROW-AREA WS-STATUS
     MOVE 1 TO WS-ID
     CALL "MM-SPAWN" USING CLIENT-STATE WS-ID WS-TYPE WS-X WS-Y WS-Z WS-YAW
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     MOVE RL-EN-COUNT TO WS-COUNT0
     MOVE 2 TO EN-TGT(2)
     MOVE 30 TO EN-RS(2)
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     MOVE "acceptance beam of the elder guardian" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF RL-EN-COUNT - WS-COUNT0 > 12
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     PERFORM CHECK-N
*>   A target exactly at the guardian's eye (0.425 above its feet; a cow's centre 0.7 above its own) is a beam of no length: nothing is drawn.
     CALL "ENTITIES-CLEAR" USING CLIENT-STATE
     MOVE "cow" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-TYPE WS-ROW-AREA WS-STATUS
     MOVE 2 TO WS-ID
     CALL "MM-SPAWN" USING CLIENT-STATE WS-ID WS-TYPE WS-X WS-YT WS-Z WS-YAW
     MOVE 1.4 TO EN-BOX-HEIGHT(1)
     MOVE "guardian" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-TYPE WS-ROW-AREA WS-STATUS
     MOVE 1 TO WS-ID
     CALL "MM-SPAWN" USING CLIENT-STATE WS-ID WS-TYPE WS-X WS-Y WS-Z WS-YAW
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     MOVE RL-EN-COUNT TO WS-COUNT0
     MOVE 2 TO EN-TGT(2)
     MOVE 30 TO EN-RS(2)
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     MOVE "acceptance beam of no length draws nothing" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = RL-EN-COUNT - WS-COUNT0
     PERFORM CHECK-N
*>   A full entity mesh takes no more beam quad (one quad is 12 vertices from both sides).
     COMPUTE RL-EN-COUNT = CL-MAX-ENTITY-VERTICES - 6
     CALL "BEAM-QUAD" USING CLIENT-STATE WS-QUAD WS-FRAME WS-TINTS
     MOVE "acceptance beam quad on a full mesh adds nothing" TO TL-CASE
     COMPUTE TL-EXPECTED-N = CL-MAX-ENTITY-VERTICES - 6
     MOVE RL-EN-COUNT TO TL-OBSERVED-N
     PERFORM CHECK-N
     STOP RUN.
 CHECK-SMALL.
     MOVE "N" TO TL-MODE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF WS-DIFF < 0.0002 AND WS-DIFF > -0.0002
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 CHECK-N.
     MOVE "N" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-ENTITY-BEAM.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. MM-SPAWN.
*> USING CLIENT-STATE, entity id, type (registry id), x y z (FLOAT-LONG), yaw (FLOAT-SHORT, also the head yaw): Add Entity.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY PROTO.
 01 WS-READY               BINARY-LONG VALUE 0.
 01 WS-CAPACITY            BINARY-LONG VALUE 1024.
 01 WS-ADD                 BINARY-LONG VALUE 1.
 01 WS-ZERO                BINARY-LONG VALUE 0.
 01 WS-UUID                PIC X(16) VALUE LOW-VALUES.
 01 WS-V0                  FLOAT-LONG VALUE 0.
 01 WS-V1                  FLOAT-LONG VALUE 0.
 01 WS-V2                  FLOAT-LONG VALUE 0.
 01 WS-A0                  FLOAT-SHORT VALUE 0.
 LINKAGE SECTION.
 COPY CLSTATE.
 01 L-ID                   BINARY-LONG.
 01 L-TYPE                 BINARY-LONG.
 01 L-X                    FLOAT-LONG.
 01 L-Y                    FLOAT-LONG.
 01 L-Z                    FLOAT-LONG.
 01 L-YAW                  FLOAT-SHORT.
 PROCEDURE DIVISION USING CLIENT-STATE L-ID L-TYPE L-X L-Y L-Z L-YAW.
     IF WS-READY = 0
         CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
         MOVE 1 TO WS-READY
     END-IF
     CALL "PB-RESET" USING PB-BUFFER
     CALL "PB-PUT-VARINT" USING PB-BUFFER L-ID
     CALL "PB-PUT-UUID" USING PB-BUFFER WS-UUID
     CALL "PB-PUT-VARINT" USING PB-BUFFER L-TYPE
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER L-X
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER L-Y
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER L-Z
     CALL "PB-PUT-LPVEC3" USING PB-BUFFER WS-V0 WS-V1 WS-V2
     CALL "PB-PUT-ANGLE" USING PB-BUFFER WS-A0
     CALL "PB-PUT-ANGLE" USING PB-BUFFER L-YAW
     CALL "PB-PUT-ANGLE" USING PB-BUFFER L-YAW
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-ZERO
     MOVE 0 TO PB-POS
     CALL "ENTITY-PACKET" USING CLIENT-STATE PB-BUFFER WS-ADD
     GOBACK.
 END PROGRAM MM-SPAWN.


