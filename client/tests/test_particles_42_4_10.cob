*> Acceptance test of docs/protocol/42-particles-4-block-item-dust-ambient.md section 10 (Suspended particles): the rules, table rows,
*> formulas and worked cases of the section with the document's numbers; every float case compares
*> the value times 100000 rounded. Draws are injected through the draw tables.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-PARTICLES-42-4-10.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CLPCL.
 COPY CLPCLX.
 COPY CLP4X.
 COPY TESTLIB.
 01 WS-NAME                PIC X(160).
 01 WS-DRAWS.
    05 WS-D                FLOAT-LONG OCCURS 16 TIMES.
 01 WS-EDRAWS.
    05 WS-E                FLOAT-LONG OCCURS 16 TIMES.
 01 W1                     FLOAT-LONG.
 01 W2                     FLOAT-LONG.
 01 W3                     FLOAT-LONG.
 01 W4                     FLOAT-LONG.
 01 W5                     FLOAT-LONG.
 01 W6                     FLOAT-LONG.
 01 W7                     FLOAT-LONG.
 01 W8                     FLOAT-LONG.
 01 I1                     BINARY-LONG.
 01 I2                     BINARY-LONG.
 01 I3                     BINARY-LONG.
 01 I4                     BINARY-LONG.
 01 I5                     BINARY-LONG.
 01 B1                     BINARY-DOUBLE.
 01 T1                     PIC X(80).
 01 Z1                     FLOAT-LONG VALUE 0.
 01 Z2                     FLOAT-LONG VALUE 0.
 01 Z3                     FLOAT-LONG VALUE 0.
 01 Z4                     FLOAT-LONG VALUE 0.
 01 Z5                     FLOAT-LONG VALUE 0.
 01 Z6                     FLOAT-LONG VALUE 0.
 01 WS-KIND               BINARY-LONG.
 PROCEDURE DIVISION.
     PERFORM VARYING I1 FROM 1 BY 1 UNTIL I1 > 16
         MOVE 0.5 TO WS-D(I1)
     END-PERFORM
     MOVE 0.75 TO WS-D(2)
     MOVE 0 TO WS-KIND
     CALL "P4-TOWN-NEW" USING PCL Z1 Z2 Z3 Z4 Z5 Z6 WS-KIND WS-DRAWS
     MOVE "10.1 grey = f * 0.1 + 0.2" TO WS-NAME
     MOVE 25000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-RCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "10.1 box 0.02" TO WS-NAME
     MOVE 2000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-BBW) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "10.1 quad size 0.15 * (draw * 0.6 + 0.5)" TO WS-NAME
     MOVE 12000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-QUAD-SIZE) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "10.1 velocity * 0.02 (xd)" TO WS-NAME
     MOVE 240 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-XD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "10.1 velocity * 0.02 (yd)" TO WS-NAME
     MOVE 200 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-YD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "10.1 lifetime (int)(20 / (0.5 * 0.8 + 0.2)) = 33" TO WS-NAME
     MOVE 33 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-LIFETIME
     PERFORM ASSERT-NUMBER
     MOVE "10.1 no physics" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-HAS-PHYSICS
     PERFORM ASSERT-NUMBER
     MOVE 1.0 TO WS-D(10)
     CALL "P4-TOWN-NEW" USING PCL Z1 Z2 Z3 Z4 Z5 Z6 WS-KIND WS-DRAWS
     MOVE "10.1 lifetime 20 at the top" TO WS-NAME
     MOVE 20 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-LIFETIME
     PERFORM ASSERT-NUMBER
     MOVE 0 TO WS-D(10)
     CALL "P4-TOWN-NEW" USING PCL Z1 Z2 Z3 Z4 Z5 Z6 WS-KIND WS-DRAWS
     MOVE "10.1 lifetime 100 at the bottom" TO WS-NAME
     MOVE 100 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-LIFETIME
     PERFORM ASSERT-NUMBER
     MOVE 1 TO WS-KIND
     MOVE 0.5 TO WS-D(10)
     CALL "P4-TOWN-NEW" USING PCL Z1 Z2 Z3 Z4 Z5 Z6 WS-KIND WS-DRAWS
     MOVE "10.1 egg_crack is white (sum of channels)" TO WS-NAME
     MOVE 300000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-RCOL + PC-GCOL + PC-BCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 0 TO PK-COUNT
     MOVE 0 TO WS-KIND
     CALL "P4-TOWN-NEW" USING PCL Z1 Z2 Z3 Z4 Z5 Z6 WS-KIND WS-DRAWS
     MOVE 1 TO PC-LIFETIME
     CALL "P4-TOWN-TICK" USING PCL PCL-COLLIDERS
     MOVE "10.1 tick: lifetime decrements (1 to 0)" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-LIFETIME
     PERFORM ASSERT-NUMBER
     MOVE "10.1 tick: not yet removed (old value 1)" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-REMOVED
     PERFORM ASSERT-NUMBER
     MOVE "10.1 tick: moved by xd (no collision)" TO WS-NAME
     MOVE 240 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-X) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "10.1 tick: velocity * 0.99" TO WS-NAME
     MOVE 238 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-XD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "10.1 tick: age is not used" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-AGE
     PERFORM ASSERT-NUMBER
     CALL "P4-TOWN-TICK" USING PCL PCL-COLLIDERS
     MOVE "10.1 removed on the tick where the old lifetime <= 0" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-REMOVED
     PERFORM ASSERT-NUMBER
     MOVE 10 TO W1
     MOVE 0.2 TO W4
     MOVE 0.4 TO W5
     MOVE 0.6 TO W6
     MOVE 0 TO WS-KIND
     CALL "P4-SPORE-NEW" USING PCL Z1 W1 Z3 Z4 Z5 Z6 WS-DRAWS
     MOVE "10.2 the spawn y is lowered by 0.125" TO WS-NAME
     MOVE 987500 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-Y) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "10.2 box 0.01" TO WS-NAME
     MOVE 1000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-BBW) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "10.2 quad size 0.15 * (draw * 0.6 + 0.6)" TO WS-NAME
     MOVE 13500 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-QUAD-SIZE) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "10.2 lifetime (int)(16 / (0.5 * 0.8 + 0.2)) = 26" TO WS-NAME
     MOVE 26 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-LIFETIME
     PERFORM ASSERT-NUMBER
     MOVE "10.2 no physics" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-HAS-PHYSICS
     PERFORM ASSERT-NUMBER
     MOVE "10.2 friction 1.0" TO WS-NAME
     MOVE 100000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-FRICTION) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "10.2 gravity 0" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-GRAVITY) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 1 TO W2
     MOVE 2 TO W3
     MOVE -1 TO W7
     MOVE 0 TO WS-KIND
     CALL "P4-SPORE-ARGS" USING WS-KIND W2 W3 W7 W4 W5 W6
     MOVE "10.2 crimson vx = g1 * 1e-6 (float, shown times 1e6)" TO WS-NAME
     MOVE 100000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((W4 * 1000000) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "10.2 crimson vy = g2 * 1e-4 (float)" TO WS-NAME
     MOVE 20 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((W5) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "10.2 crimson vz = g3 * 1e-6 (times 1e6)" TO WS-NAME
     MOVE -100000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((W6 * 1000000) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 0.5 TO W2
     MOVE 0.5 TO W3
     MOVE 1 TO WS-KIND
     CALL "P4-SPORE-ARGS" USING WS-KIND W2 W3 W7 W4 W5 W6
     MOVE "10.2 warped vy = (r1 * -1.9) * r2 * 0.1" TO WS-NAME
     MOVE -4750 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((W5) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "10.2 warped vx is 0" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((W4) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 2 TO WS-KIND
     CALL "P4-SPORE-ARGS" USING WS-KIND W2 W3 W7 W4 W5 W6
     MOVE "10.2 spore_blossom_air vy = float -0.8" TO WS-NAME
     MOVE -80000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((W5) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 0 TO WS-KIND
     CALL "P4-SPORE-FINISH" USING PCL WS-KIND W2
     MOVE "10.2 crimson colour red 0.9" TO WS-NAME
     MOVE 90000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-RCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "10.2 crimson colour blue 0.5" TO WS-NAME
     MOVE 50000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-BCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 1 TO WS-KIND
     CALL "P4-SPORE-FINISH" USING PCL WS-KIND W2
     MOVE "10.2 warped colour blue 0.3" TO WS-NAME
     MOVE 30000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-BCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "10.2 warped box 0.001" TO WS-NAME
     MOVE 100 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-BBW) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 2 TO WS-KIND
     MOVE 0.5 TO W2
     CALL "P4-SPORE-FINISH" USING PCL WS-KIND W2
     MOVE "10.2 spore_blossom_air lifetime randomBetweenInclusive(500, 1000), 0.5 gives 750" TO WS-NAME
     MOVE 750 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-LIFETIME
     PERFORM ASSERT-NUMBER
     MOVE "10.2 spore_blossom_air gravity 0.01" TO WS-NAME
     MOVE 1000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-GRAVITY) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "10.2 spore_blossom_air colour green 0.5" TO WS-NAME
     MOVE 50000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-GCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 0 TO W7
     MOVE 0.5 TO WS-D(2)
     MOVE -0.800000011920929 TO W5
     CALL "P4-SPORE-NEW" USING PCL Z1 Z2 Z3 Z4 W5 Z6 WS-DRAWS
     MOVE "10.2 blossom burst with a downward bias: yd = -0.02 (inferred range -0.08 to 0.04)" TO WS-NAME
     MOVE -2000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-YD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 97 TO I2
     CALL "P4-SPORE-LIMIT" USING I2 I1
     MOVE "spore_blossom_air is limited to 1000 live particles" TO WS-NAME
     MOVE 1000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I1
     PERFORM ASSERT-NUMBER
     MOVE 95 TO I2
     CALL "P4-SPORE-LIMIT" USING I2 I1
     MOVE "crimson_spore has no limit of its own (0)" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I1
     PERFORM ASSERT-NUMBER
     STOP RUN.

 ASSERT-NUMBER.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-4§10 Suspended particles: " FUNCTION TRIM(WS-NAME)
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "N" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 ASSERT-TEXT.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-4§10 Suspended particles: " FUNCTION TRIM(WS-NAME)
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "T" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-PARTICLES-42-4-10.
