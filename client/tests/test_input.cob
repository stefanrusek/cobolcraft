*> Implementation test of client/src/input.cob (INPUT-BEGIN-FRAME, INPUT-EVENT; shim-abi.md §8):
*> event records of every kind 1 to 9 update the input state: keys held and pressed this frame,
*> modifiers, text code points (including a non-ASCII one), mouse buttons and the click position,
*> the free cursor position, the accumulated look delta while captured, scroll, window resize and
*> the close request; a new frame clears what belongs to one frame.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-INPUT.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CLSTATE.
 COPY CCSHIM.
 COPY TESTLIB.
 01 WS-EDIT                PIC -(5)9.99.
 01 WS-EDIT2               PIC -(5)9.99.
 PROCEDURE DIVISION.
     CALL "CL-INIT" USING CLIENT-STATE
     CALL "INPUT-BEGIN-FRAME" USING CLIENT-STATE
     INITIALIZE CC-EVENT
     MOVE CC-EV-KEY-DOWN TO CC-EV-KIND
     MOVE CC-KEY-W TO CC-EV-A
     MOVE CC-MOD-CONTROL TO CC-EV-B
     CALL "INPUT-EVENT" USING CLIENT-STATE CC-EVENT
     MOVE "input kind 1 key down: W held and pressed this frame, modifiers kept" TO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE IN-MODS TO WS-EDIT
     MOVE SPACES TO TL-OBSERVED
     STRING IN-KEY-DOWN(CC-KEY-W + 1) " " IN-KEY-PRESSED(CC-KEY-W + 1) " "
         FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "1 1 2.00" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE 1 TO CC-EV-C
     MOVE 999 TO CC-EV-A
     CALL "INPUT-EVENT" USING CLIENT-STATE CC-EVENT
     CALL "INPUT-BEGIN-FRAME" USING CLIENT-STATE
     MOVE CC-EV-KEY-UP TO CC-EV-KIND
     MOVE CC-KEY-W TO CC-EV-A
     MOVE 0 TO CC-EV-B CC-EV-C
     CALL "INPUT-EVENT" USING CLIENT-STATE CC-EVENT
     MOVE "input kind 2 key up: W released; a new frame cleared pressed; an unknown key code is ignored"
         TO TL-CASE
     MOVE "0 0" TO TL-EXPECTED
     MOVE SPACES TO TL-OBSERVED
     STRING IN-KEY-DOWN(CC-KEY-W + 1) " " IN-KEY-PRESSED(CC-KEY-W + 1)
         DELIMITED BY SIZE INTO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE CC-EV-TEXT TO CC-EV-KIND
     MOVE 97 TO CC-EV-A
     CALL "INPUT-EVENT" USING CLIENT-STATE CC-EVENT
     MOVE 252 TO CC-EV-A
     CALL "INPUT-EVENT" USING CLIENT-STATE CC-EVENT
     MOVE "input kind 3 text: code points 97 and 252 (u umlaut, any keyboard layout) in order"
         TO TL-CASE
     MOVE "2 97 252" TO TL-EXPECTED
     MOVE SPACES TO TL-OBSERVED
     MOVE IN-TEXT(1) TO WS-EDIT
     MOVE IN-TEXT(2) TO WS-EDIT2
     STRING "2 " FUNCTION TRIM(WS-EDIT) " " FUNCTION TRIM(WS-EDIT2) DELIMITED BY SIZE
         INTO TL-OBSERVED
     IF IN-TEXT-COUNT NOT = 2
         MOVE "wrong count" TO TL-OBSERVED
     END-IF
     MOVE "2 97.00 252.00" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE CC-EV-BUTTON-DOWN TO CC-EV-KIND
     MOVE CC-BUTTON-RIGHT TO CC-EV-A
     MOVE 120.5 TO CC-EV-X
     MOVE 64 TO CC-EV-Y
     CALL "INPUT-EVENT" USING CLIENT-STATE CC-EVENT
     MOVE "input kind 4 button down: right button held and pressed, click at (120.5, 64)"
         TO TL-CASE
     MOVE IN-CLICK-X TO WS-EDIT
     MOVE IN-CLICK-Y TO WS-EDIT2
     MOVE SPACES TO TL-OBSERVED
     STRING IN-BUTTON-DOWN(2) IN-BUTTON-PRESSED(2) " " FUNCTION TRIM(WS-EDIT) " "
         FUNCTION TRIM(WS-EDIT2) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "11 120.50 64.00" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE CC-EV-BUTTON-UP TO CC-EV-KIND
     CALL "INPUT-EVENT" USING CLIENT-STATE CC-EVENT
     MOVE "input kind 5 button up: right button released, pressed stays for this frame" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     STRING IN-BUTTON-DOWN(2) IN-BUTTON-PRESSED(2) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "01" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE CC-EV-CURSOR TO CC-EV-KIND
     MOVE 10 TO CC-EV-X
     MOVE 20 TO CC-EV-Y
     CALL "INPUT-EVENT" USING CLIENT-STATE CC-EVENT
     MOVE "input kind 6 cursor, free: the position is (10, 20), no look delta" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE IN-CURSOR-X TO WS-EDIT
     MOVE IN-CURSOR-Y TO WS-EDIT2
     STRING FUNCTION TRIM(WS-EDIT) " " FUNCTION TRIM(WS-EDIT2) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE IN-DELTA-X TO WS-EDIT
     STRING FUNCTION TRIM(TL-OBSERVED) " " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE
         INTO TL-OBSERVED
     MOVE "10.00 20.00 0.00" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE 1 TO IN-CAPTURED
     MOVE 3 TO CC-EV-X
     MOVE -2 TO CC-EV-Y
     CALL "INPUT-EVENT" USING CLIENT-STATE CC-EVENT
     CALL "INPUT-EVENT" USING CLIENT-STATE CC-EVENT
     MOVE "input kind 6 cursor, captured: deltas accumulate to (6, -4), the position is kept"
         TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE IN-DELTA-X TO WS-EDIT
     MOVE IN-DELTA-Y TO WS-EDIT2
     STRING FUNCTION TRIM(WS-EDIT) " " FUNCTION TRIM(WS-EDIT2) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE IN-CURSOR-X TO WS-EDIT
     STRING FUNCTION TRIM(TL-OBSERVED) " " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE
         INTO TL-OBSERVED
     MOVE "6.00 -4.00 10.00" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE CC-EV-SCROLL TO CC-EV-KIND
     MOVE 0 TO CC-EV-X
     MOVE -1 TO CC-EV-Y
     CALL "INPUT-EVENT" USING CLIENT-STATE CC-EVENT
     CALL "INPUT-EVENT" USING CLIENT-STATE CC-EVENT
     MOVE "input kind 7 scroll: offsets accumulate over the frame" TO TL-CASE
     MOVE IN-SCROLL-Y TO WS-EDIT
     MOVE FUNCTION TRIM(WS-EDIT) TO TL-OBSERVED
     MOVE "-2.00" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE CC-EV-RESIZE TO CC-EV-KIND
     MOVE 800 TO CC-EV-A
     MOVE 600 TO CC-EV-B
     CALL "INPUT-EVENT" USING CLIENT-STATE CC-EVENT
     MOVE "input kind 8 resize: window 800 x 600, resized this frame" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE IN-WIN-W TO WS-EDIT
     MOVE IN-WIN-H TO WS-EDIT2
     STRING FUNCTION TRIM(WS-EDIT) " " FUNCTION TRIM(WS-EDIT2) " " IN-RESIZED
         DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "800.00 600.00 1" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE CC-EV-CLOSE-REQUEST TO CC-EV-KIND
     CALL "INPUT-EVENT" USING CLIENT-STATE CC-EVENT
     CALL "INPUT-BEGIN-FRAME" USING CLIENT-STATE
     MOVE "input kind 9 close request is kept; a new frame clears text, delta, scroll, resized and "
         & "pressed buttons" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE IN-TEXT-COUNT TO WS-EDIT
     STRING IN-CLOSE " " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE IN-DELTA-X TO WS-EDIT
     MOVE IN-SCROLL-Y TO WS-EDIT2
     STRING FUNCTION TRIM(TL-OBSERVED) " " FUNCTION TRIM(WS-EDIT) " " FUNCTION TRIM(WS-EDIT2) " "
         IN-RESIZED IN-BUTTON-PRESSED(2) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "1 0.00 0.00 0.00 00" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.
 END PROGRAM TEST-INPUT.
