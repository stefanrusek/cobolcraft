*> Evoker fangs (34-3 4.8): the replica keeps the attack flag (Entity Event 4 on an evoker_fangs) and lifeTicks (22, decremented each tick once started); the fangs are not drawn until
*> the bite starts, the jaws and the root follow the progress (EM3-FANGS-ANIM), the render sequence is EM3-FANGS-OPS (ENTITY-FANGS-SEQUENCE).
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-ENTITY-FANGS.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CLSTATE.
 COPY CLCONST.
 COPY CONTENT.
 COPY CLMODELS.
 COPY TESTLIB.
 01 WS-KEY                 PIC X(112).
 01 WS-ROW-AREA            PIC X(66).
 01 WS-STATUS              BINARY-LONG.
 01 WS-TYPE                BINARY-LONG.
 01 WS-X                   FLOAT-LONG VALUE 10.5.
 01 WS-Y                   FLOAT-LONG VALUE 64.
 01 WS-Z                   FLOAT-LONG VALUE 10.5.
 01 WS-YAW                 FLOAT-SHORT VALUE 0.
 01 WS-ID                  BINARY-LONG.
 01 WS-J                   BINARY-LONG.
 01 WS-ROW                 BINARY-LONG.
 01 WS-EV                  BINARY-LONG.
 01 WS-P                   FLOAT-LONG.
 01 WS-DIFF                FLOAT-LONG.
 01 WS-SUM1                FLOAT-LONG.
 01 WS-SUM2                FLOAT-LONG.
 01 WS-OPS.
    05 WS-OV               FLOAT-LONG OCCURS 64 TIMES.
 01 WS-EYE-TABLE.
    05 WS-EYE              FLOAT-LONG OCCURS 3 TIMES.
 PROCEDURE DIVISION.
     CALL "CL-INIT" USING CLIENT-STATE
     MOVE 0 TO PK-COUNT
     CALL "ENTITY-ATLAS-BUILD" USING CLIENT-STATE
     MOVE 256 TO PL-HEIGHT
     MOVE 0 TO SK-U
     MOVE 10 TO WS-EYE(1) WS-EYE(3)
     MOVE 64 TO WS-EYE(2)
     MOVE 1 TO CT-OPEN
     MOVE CT-TYPE-STANDARD TO CT-SET-TYPE
     CALL "ENTITIES-CLEAR" USING CLIENT-STATE
     MOVE "evoker_fangs" TO WS-KEY
     PERFORM SPAWN-ONE
     MOVE 1 TO WS-ROW
     MOVE "acceptance fangs lifeTicks start at 22" TO TL-CASE
     MOVE EN-FL(1) TO TL-OBSERVED-N
     MOVE 22 TO TL-EXPECTED-N
     PERFORM CHECK-N
     CALL "ENTITY-FANGS-PROGRESS" USING CLIENT-STATE WS-ROW WS-P
     MOVE "acceptance fangs progress 0 before the bite" TO TL-CASE
     MOVE WS-P TO WS-DIFF
     PERFORM CHECK-SMALL
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     MOVE "acceptance fangs not drawn before the bite" TO TL-CASE
     MOVE RL-EN-COUNT TO TL-OBSERVED-N
     MOVE 0 TO TL-EXPECTED-N
     PERFORM CHECK-N
     CALL "ENTITIES-ANIM-TICK" USING CLIENT-STATE
     MOVE "acceptance fangs lifeTicks keep until the bite starts" TO TL-CASE
     MOVE EN-FL(1) TO TL-OBSERVED-N
     MOVE 22 TO TL-EXPECTED-N
     PERFORM CHECK-N
     MOVE 3 TO WS-EV
     MOVE 1 TO WS-ID
     CALL "ENTITY-EVENT" USING CLIENT-STATE WS-ID WS-EV
     MOVE "acceptance fangs event 3 does not start the bite" TO TL-CASE
     MOVE EN-FA(1) TO TL-OBSERVED-N
     MOVE 0 TO TL-EXPECTED-N
     PERFORM CHECK-N
     MOVE 4 TO WS-EV
     CALL "ENTITY-EVENT" USING CLIENT-STATE WS-ID WS-EV
     MOVE "acceptance fangs event 4 starts the bite" TO TL-CASE
     MOVE EN-FA(1) TO TL-OBSERVED-N
     MOVE 1 TO TL-EXPECTED-N
     PERFORM CHECK-N
     CALL "ENTITY-FANGS-PROGRESS" USING CLIENT-STATE WS-ROW WS-P
     MOVE "acceptance fangs progress at lifeTicks 22 (partial 1)" TO TL-CASE
     COMPUTE WS-DIFF = WS-P - 0.05
     PERFORM CHECK-SMALL
     CALL "ENTITIES-ANIM-TICK" USING CLIENT-STATE
     MOVE "acceptance fangs lifeTicks fall by 1 a tick" TO TL-CASE
     MOVE EN-FL(1) TO TL-OBSERVED-N
     MOVE 21 TO TL-EXPECTED-N
     PERFORM CHECK-N
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     PERFORM SUM-MESH
     MOVE WS-SUM2 TO WS-SUM1
     MOVE "acceptance fangs drawn after the bite starts" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF RL-EN-COUNT > 0
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     PERFORM CHECK-N
     MOVE 10 TO EN-FL(1)
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     PERFORM SUM-MESH
     MOVE "acceptance fangs drawn with the progress" TO TL-CASE
     COMPUTE WS-DIFF = WS-SUM2 - WS-SUM1
     PERFORM CHECK-OTHER
     MOVE 2 TO EN-FL(1)
     CALL "ENTITY-FANGS-PROGRESS" USING CLIENT-STATE WS-ROW WS-P
     MOVE "acceptance fangs progress 1 at the end" TO TL-CASE
     COMPUTE WS-DIFF = WS-P - 1
     PERFORM CHECK-SMALL
*>   The sequence: rotate Y by 90 - yaw, scale (-1, -1, 1), translate (0, -1.501, 0).
     MOVE 30 TO EN-YAW(1)
     CALL "ENTITY-FANGS-SEQUENCE" USING CLIENT-STATE WS-ROW WS-OPS
     MOVE "acceptance fangs sequence count" TO TL-CASE
     COMPUTE WS-DIFF = WS-OV(1) - 3
     PERFORM CHECK-SMALL
     MOVE "acceptance fangs sequence yaw" TO TL-CASE
     COMPUTE WS-DIFF = WS-OV(2) - 3 + WS-OV(3) - 60
     PERFORM CHECK-SMALL
     MOVE "acceptance fangs sequence scale and translate" TO TL-CASE
     COMPUTE WS-DIFF = WS-OV(6) - 2 + WS-OV(7) + 1 + WS-OV(8) + 1 + WS-OV(9) - 1 + WS-OV(10) - 1 + WS-OV(12) + 1.501
     PERFORM CHECK-SMALL
*>   Another mob keeps the flag at event 4.
     CALL "ENTITIES-CLEAR" USING CLIENT-STATE
     MOVE "cow" TO WS-KEY
     PERFORM SPAWN-ONE
     CALL "ENTITY-EVENT" USING CLIENT-STATE WS-ID WS-EV
     MOVE "acceptance fangs event 4 of another mob" TO TL-CASE
     MOVE EN-FA(1) TO TL-OBSERVED-N
     MOVE 0 TO TL-EXPECTED-N
     PERFORM CHECK-N
     STOP RUN.
 SPAWN-ONE.
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-TYPE WS-ROW-AREA WS-STATUS
     MOVE 1 TO WS-ID
     CALL "MM-SPAWN" USING CLIENT-STATE WS-ID WS-TYPE WS-X WS-Y WS-Z WS-YAW.
 SUM-MESH.
     MOVE 0 TO WS-SUM2
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > RL-EN-COUNT
         COMPUTE WS-SUM2 = WS-SUM2 + (RL-EN-Y(WS-J) + RL-EN-X(WS-J) * 2 + RL-EN-Z(WS-J) * 3) * WS-J
     END-PERFORM.
 CHECK-SMALL.
     MOVE "N" TO TL-MODE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF WS-DIFF < 0.0001 AND WS-DIFF > -0.0001
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 CHECK-OTHER.
     MOVE "N" TO TL-MODE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF WS-DIFF > 0.001 OR WS-DIFF < -0.001
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 CHECK-N.
     MOVE "N" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-ENTITY-FANGS.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. MM-SPAWN.
*> USING CLIENT-STATE, entity id, type (registry id), x y z (FLOAT-LONG), yaw (FLOAT-SHORT, also the head yaw): Add Entity.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY PROTO.
 01 WS-READY               BINARY-LONG VALUE 0.
 01 WS-CAPACITY            BINARY-LONG VALUE 1024.
 01 WS-ADD                 BINARY-LONG VALUE 1.
 01 WS-ZERO                BINARY-LONG VALUE 0.
 01 WS-UUID                PIC X(16) VALUE LOW-VALUES.
 01 WS-V0                  FLOAT-LONG VALUE 0.
 01 WS-V1                  FLOAT-LONG VALUE 0.
 01 WS-V2                  FLOAT-LONG VALUE 0.
 01 WS-A0                  FLOAT-SHORT VALUE 0.
 LINKAGE SECTION.
 COPY CLSTATE.
 01 L-ID                   BINARY-LONG.
 01 L-TYPE                 BINARY-LONG.
 01 L-X                    FLOAT-LONG.
 01 L-Y                    FLOAT-LONG.
 01 L-Z                    FLOAT-LONG.
 01 L-YAW                  FLOAT-SHORT.
 PROCEDURE DIVISION USING CLIENT-STATE L-ID L-TYPE L-X L-Y L-Z L-YAW.
     IF WS-READY = 0
         CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
         MOVE 1 TO WS-READY
     END-IF
     CALL "PB-RESET" USING PB-BUFFER
     CALL "PB-PUT-VARINT" USING PB-BUFFER L-ID
     CALL "PB-PUT-UUID" USING PB-BUFFER WS-UUID
     CALL "PB-PUT-VARINT" USING PB-BUFFER L-TYPE
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER L-X
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER L-Y
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER L-Z
     CALL "PB-PUT-LPVEC3" USING PB-BUFFER WS-V0 WS-V1 WS-V2
     CALL "PB-PUT-ANGLE" USING PB-BUFFER WS-A0
     CALL "PB-PUT-ANGLE" USING PB-BUFFER L-YAW
     CALL "PB-PUT-ANGLE" USING PB-BUFFER L-YAW
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-ZERO
     MOVE 0 TO PB-POS
     CALL "ENTITY-PACKET" USING CLIENT-STATE PB-BUFFER WS-ADD
     GOBACK.
 END PROGRAM MM-SPAWN.


