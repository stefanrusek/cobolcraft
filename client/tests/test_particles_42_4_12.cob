*> Acceptance test of docs/protocol/42-particles-4-block-item-dust-ambient.md section 12 (`FireflyParticle`): the rules, table rows,
*> formulas and worked cases of the section with the document's numbers; every float case compares
*> the value times 100000 rounded. Draws are injected through the draw tables.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-PARTICLES-42-4-12.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CLPCL.
 COPY CLPCLX.
 COPY CLP4X.
 COPY TESTLIB.
 01 WS-NAME                PIC X(160).
 01 WS-DRAWS.
    05 WS-D                FLOAT-LONG OCCURS 16 TIMES.
 01 WS-EDRAWS.
    05 WS-E                FLOAT-LONG OCCURS 16 TIMES.
 01 W1                     FLOAT-LONG.
 01 W2                     FLOAT-LONG.
 01 W3                     FLOAT-LONG.
 01 W4                     FLOAT-LONG.
 01 W5                     FLOAT-LONG.
 01 W6                     FLOAT-LONG.
 01 W7                     FLOAT-LONG.
 01 W8                     FLOAT-LONG.
 01 I1                     BINARY-LONG.
 01 I2                     BINARY-LONG.
 01 I3                     BINARY-LONG.
 01 I4                     BINARY-LONG.
 01 I5                     BINARY-LONG.
 01 B1                     BINARY-DOUBLE.
 01 T1                     PIC X(80).
 01 Z1                     FLOAT-LONG VALUE 0.
 01 Z2                     FLOAT-LONG VALUE 0.
 01 Z3                     FLOAT-LONG VALUE 0.
 01 Z4                     FLOAT-LONG VALUE 0.
 01 Z5                     FLOAT-LONG VALUE 0.
 01 Z6                     FLOAT-LONG VALUE 0.
 01 WS-LIGHT              BINARY-LONG.
 PROCEDURE DIVISION.
     PERFORM VARYING I1 FROM 1 BY 1 UNTIL I1 > 16
         MOVE 0.5 TO WS-D(I1)
     END-PERFORM
     MOVE 0.25 TO W1
     MOVE 0.3 TO W2
     MOVE 0.5 TO W3
     CALL "P4-FADE" USING W1 W2 W3 W4
     MOVE "fade(0.25, 0.3, 0.5) = 0.5 (example 7)" TO WS-NAME
     MOVE 50000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((W4) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 0.6 TO W1
     CALL "P4-FADE" USING W1 W2 W3 W4
     MOVE "fade(0.6, 0.3, 0.5) = 1 (the middle part)" TO WS-NAME
     MOVE 100000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((W4) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 0.85 TO W1
     CALL "P4-FADE" USING W1 W2 W3 W4
     MOVE "fade(0.85, 0.3, 0.5) = (1 - 0.85) / 0.3 = 0.5" TO WS-NAME
     MOVE 50000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((W4) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 0.3 TO W3
     MOVE 0.05 TO W1
     MOVE 0.1 TO W2
     CALL "P4-FADE" USING W1 W2 W3 W4
     MOVE "fade(0.05, 0.1, 0.3) = 0.1667" TO WS-NAME
     MOVE 16667 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((W4) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 0.37 TO W5
     MOVE 0.62 TO W6
     MOVE 0.1 TO W7
     MOVE 1 TO I2
     CALL "P4-FIREFLY-ARGS" USING W5 I2 W7 W6 W1 W2 W3
     MOVE "provider xArg = 0.5 - nextDouble" TO WS-NAME
     MOVE 13000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((W1) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "provider yArg keeps the sign when the boolean is true" TO WS-NAME
     MOVE 10000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((W2) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "provider zArg = 0.5 - nextDouble" TO WS-NAME
     MOVE -12000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((W3) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 0 TO I2
     CALL "P4-FIREFLY-ARGS" USING W5 I2 W7 W6 W1 W2 W3
     MOVE "provider yArg flips the sign when the boolean is false" TO WS-NAME
     MOVE -10000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((W2) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 0.75 TO WS-D(2)
     MOVE 0.5 TO W7
     CALL "P4-FIREFLY-NEW" USING PCL P4X Z1 Z2 Z3 Z4 Z5 Z6 WS-DRAWS W7
     MOVE "velocity * 0.8 (xd = 0.12 * 0.8)" TO WS-NAME
     MOVE 9600 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-XD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "velocity * 0.8 (yd = 0.1 * 0.8)" TO WS-NAME
     MOVE 8000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-YD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "quad size 0.15 * 0.75 * 1.5" TO WS-NAME
     MOVE 16875 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-QUAD-SIZE) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "box 0.3 after scale(1.5)" TO WS-NAME
     MOVE 30000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-BBW) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "alpha 0 at creation" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-ALPHA) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "lifetime nextIntBetweenInclusive(200, 300): 0.5 gives 250" TO WS-NAME
     MOVE 250 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-LIFETIME
     PERFORM ASSERT-NUMBER
     MOVE "friction 0.96" TO WS-NAME
     MOVE 96000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-FRICTION) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "speedUpWhenYMotionIsBlocked" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-SPEED-UP
     PERFORM ASSERT-NUMBER
     MOVE "layer is TRANSLUCENT (1)" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = X4-LAYER
     PERFORM ASSERT-NUMBER
     MOVE 5 TO PC-AGE
     MOVE 100 TO PC-LIFETIME
     MOVE 0 TO W5
     CALL "P4-FIREFLY-LIGHT" USING PCL W5 WS-LIGHT
     MOVE "example 7: light at progress 0.05 is (int)(255 * 0.1667) = 42" TO WS-NAME
     MOVE 42 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-LIGHT
     PERFORM ASSERT-NUMBER
     MOVE 95 TO PC-AGE
     CALL "P4-FIREFLY-LIGHT" USING PCL W5 WS-LIGHT
     MOVE "example 7: light at progress 0.95 is 127" TO WS-NAME
     MOVE 127 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-LIGHT
     PERFORM ASSERT-NUMBER
     MOVE 50 TO PC-AGE
     CALL "P4-FIREFLY-LIGHT" USING PCL W5 WS-LIGHT
     MOVE "light between 0.3 and 0.9 is 255" TO WS-NAME
     MOVE 255 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-LIGHT
     PERFORM ASSERT-NUMBER
     MOVE 0 TO PK-COUNT
     MOVE 250 TO PC-LIFETIME
     MOVE 4 TO PC-AGE
     MOVE 0 TO PC-REMOVED
     MOVE 1 TO I2
     MOVE 0.5 TO W1
     MOVE 0.5 TO W2
     MOVE 0.5 TO W3
     MOVE 0.5 TO W4
     CALL "P4-FIREFLY-TICK" USING PCL I2 W1 W2 W3 W4 PCL-COLLIDERS
     MOVE "tick: alpha = fade(age / lifetime, 0.3, 0.5) (5 / 250 / 0.5)" TO WS-NAME
     MOVE 4000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-ALPHA) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "tick: stays alive in an air block" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-REMOVED
     PERFORM ASSERT-NUMBER
     MOVE "tick: no new velocity when the draw is not above 0.95 (xd keeps decaying)" TO WS-NAME
     MOVE 9216 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-XD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 0.96 TO W1
     MOVE 0.5 TO W2
     MOVE 0 TO W3
     MOVE 1 TO W4
     CALL "P4-FIREFLY-TICK" USING PCL I2 W1 W2 W3 W4 PCL-COLLIDERS
     MOVE "tick: a draw above 0.95 sets a new velocity (-0.05 + 0.1 * r): x" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-XD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "tick: new velocity y" TO WS-NAME
     MOVE -5000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-YD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "tick: new velocity z" TO WS-NAME
     MOVE 5000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-ZD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 0 TO PC-AGE
     MOVE 0.1 TO W1
     CALL "P4-FIREFLY-TICK" USING PCL I2 W1 W2 W3 W4 PCL-COLLIDERS
     MOVE "tick: age 1 always sets a new velocity (z)" TO WS-NAME
     MOVE 5000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-ZD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 0 TO I2
     CALL "P4-FIREFLY-TICK" USING PCL I2 W1 W2 W3 W4 PCL-COLLIDERS
     MOVE "a block that is not air removes the particle" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-REMOVED
     PERFORM ASSERT-NUMBER
     MOVE 250 TO PC-LIFETIME
     MOVE -10 TO PC-AGE
     CALL "P4-FIREFLY-LIGHT" USING PCL W5 WS-LIGHT
     MOVE "light: progress is clamped at 0 before the start" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-LIGHT
     PERFORM ASSERT-NUMBER
     MOVE 400 TO PC-AGE
     CALL "P4-FIREFLY-LIGHT" USING PCL W5 WS-LIGHT
     MOVE "light: progress is clamped at 1 after the end (fade 0)" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-LIGHT
     PERFORM ASSERT-NUMBER
     MOVE 250 TO PC-AGE
     MOVE 0 TO PC-REMOVED
     MOVE 1 TO I2
     CALL "P4-FIREFLY-TICK" USING PCL I2 W1 W2 W3 W4 PCL-COLLIDERS
     MOVE "the base tick removes a particle whose age reached the lifetime" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-REMOVED
     PERFORM ASSERT-NUMBER
     STOP RUN.

 ASSERT-NUMBER.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-4§12 `FireflyParticle`: " FUNCTION TRIM(WS-NAME)
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "N" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 ASSERT-TEXT.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-4§12 `FireflyParticle`: " FUNCTION TRIM(WS-NAME)
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "T" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-PARTICLES-42-4-12.
