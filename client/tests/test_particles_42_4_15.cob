*> Acceptance test of docs/protocol/42-particles-4-block-item-dust-ambient.md section 15 (Emission paths used by this part): the rules, table rows,
*> formulas and worked cases of the section with the document's numbers; every float case compares
*> the value times 100000 rounded. Draws are injected through the draw tables.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-PARTICLES-42-4-15.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CLPCL.
 COPY CLPCLX.
 COPY TESTLIB.
 01 WS-NAME                PIC X(160).
 01 WS-DRAWS.
    05 WS-D                FLOAT-LONG OCCURS 16 TIMES.
 01 WS-EDRAWS.
    05 WS-E                FLOAT-LONG OCCURS 16 TIMES.
 01 W1                     FLOAT-LONG.
 01 W2                     FLOAT-LONG.
 01 W3                     FLOAT-LONG.
 01 W4                     FLOAT-LONG.
 01 W5                     FLOAT-LONG.
 01 W6                     FLOAT-LONG.
 01 W7                     FLOAT-LONG.
 01 W8                     FLOAT-LONG.
 01 I1                     BINARY-LONG.
 01 I2                     BINARY-LONG.
 01 I3                     BINARY-LONG.
 01 I4                     BINARY-LONG.
 01 I5                     BINARY-LONG.
 01 B1                     BINARY-DOUBLE.
 01 T1                     PIC X(80).
 01 Z1                     FLOAT-LONG VALUE 0.
 01 Z2                     FLOAT-LONG VALUE 0.
 01 Z3                     FLOAT-LONG VALUE 0.
 01 Z4                     FLOAT-LONG VALUE 0.
 01 Z5                     FLOAT-LONG VALUE 0.
 01 Z6                     FLOAT-LONG VALUE 0.
 01 WS-P.
    05 WS-PP               BINARY-LONG OCCURS 3 TIMES.
 01 WS-OUT.
    05 WS-O                FLOAT-LONG OCCURS 3 TIMES.
 01 WS-VEL.
    05 WS-V                FLOAT-LONG OCCURS 3 TIMES.
 01 WS-G.
    05 WS-GG               FLOAT-LONG OCCURS 3 TIMES.
 01 WS-U.
    05 WS-UU               FLOAT-LONG OCCURS 3 TIMES.
 01 WS-S.
    05 WS-SS               FLOAT-LONG OCCURS 3 TIMES.
 01 WS-F1                 BINARY-LONG.
 01 WS-F2                 BINARY-LONG.
 01 WS-FACE               BINARY-LONG.
 01 WS-STEP.
    05 WS-ST               BINARY-LONG OCCURS 3 TIMES.
 PROCEDURE DIVISION.
     MOVE 10 TO WS-PP(1)
     MOVE 64 TO WS-PP(2)
     MOVE 20 TO WS-PP(3)
     MOVE 0.3 TO W1
     MOVE 0.7 TO W2
     CALL "P4-SPAWN-BELOW-INT" USING WS-P W1 W2 WS-OUT
     MOVE "15.2 spawnParticleBelow x = x + nextDouble" TO WS-NAME
     MOVE 1030000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-O(1)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "15.2 spawnParticleBelow y = y - 0.05" TO WS-NAME
     MOVE 6395000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-O(2)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "15.2 spawnParticleBelow z = z + nextDouble" TO WS-NAME
     MOVE 2070000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-O(3)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 1 TO WS-GG(1)
     MOVE 2 TO WS-GG(2)
     MOVE -1 TO WS-GG(3)
     MOVE 0.5 TO WS-UU(1)
     MOVE 0.5 TO WS-UU(2)
     MOVE 0.5 TO WS-UU(3)
     MOVE 0.3 TO W1
     MOVE 1.0 TO W2
     MOVE 1 TO WS-F1
     MOVE 0 TO WS-F2
     CALL "P4-SPAWN-PARTICLE" USING WS-P W1 W2 WS-F1 WS-F2 WS-G WS-U WS-OUT WS-VEL I1
     MOVE "15.3 a particle is added when the block below is not air" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I1
     PERFORM ASSERT-NUMBER
     MOVE "15.3 velocity x = gaussian * 0.02" TO WS-NAME
     MOVE 2000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-V(1)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "15.3 velocity y" TO WS-NAME
     MOVE 4000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-V(2)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "15.3 velocity z" TO WS-NAME
     MOVE -2000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-V(3)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "15.3 x = pos.x + (0.5 - spread) + nextDouble * spread * 2" TO WS-NAME
     MOVE 1050000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-O(1)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "15.3 y = pos.y + nextDouble * yExtent" TO WS-NAME
     MOVE 6450000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-O(2)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "15.3 z = pos.z + inset + nextDouble * spread * 2" TO WS-NAME
     MOVE 2050000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-O(3)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 0 TO WS-F1
     MOVE 1 TO WS-F2
     CALL "P4-SPAWN-PARTICLE" USING WS-P W1 W2 WS-F1 WS-F2 WS-G WS-U WS-OUT WS-VEL I1
     MOVE "15.3 not allowed in the air with air below: skipped" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I1
     PERFORM ASSERT-NUMBER
     MOVE 1 TO WS-F1
     CALL "P4-SPAWN-PARTICLE" USING WS-P W1 W2 WS-F1 WS-F2 WS-G WS-U WS-OUT WS-VEL I1
     MOVE "15.3 allowed in the air: added" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I1
     PERFORM ASSERT-NUMBER
     MOVE 1 TO I2
     MOVE 0.7 TO W3
     CALL "P4-IN-BLOCK-EXTENT" USING I2 W3 W4
     MOVE "15.3 spawnParticleInBlock: the extent is 1.0 for an air block" TO WS-NAME
     MOVE 100000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((W4) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 0 TO I2
     MOVE 0.5 TO W3
     CALL "P4-IN-BLOCK-EXTENT" USING I2 W3 W4
     MOVE "15.3 else the maximum y of the block shape" TO WS-NAME
     MOVE 50000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((W4) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 1 TO WS-FACE
     CALL "P4-FACE-STEP" USING WS-FACE WS-STEP
     MOVE "15.4 UP has step y = 1" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-ST(2)
     PERFORM ASSERT-NUMBER
     MOVE 2 TO WS-FACE
     CALL "P4-FACE-STEP" USING WS-FACE WS-STEP
     MOVE "15.4 NORTH has step z = -1" TO WS-NAME
     MOVE -1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-ST(3)
     PERFORM ASSERT-NUMBER
     MOVE 4 TO WS-FACE
     CALL "P4-FACE-STEP" USING WS-FACE WS-STEP
     MOVE "15.4 WEST has step x = -1" TO WS-NAME
     MOVE -1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-ST(1)
     PERFORM ASSERT-NUMBER
     MOVE 5 TO WS-FACE
     CALL "P4-FACE-STEP" USING WS-FACE WS-STEP
     MOVE "15.4 EAST has step x = 1" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-ST(1)
     PERFORM ASSERT-NUMBER
     MOVE 10 TO WS-PP(1)
     MOVE 64 TO WS-PP(2)
     MOVE -3 TO WS-PP(3)
     MOVE 0.9 TO WS-SS(1)
     MOVE 0.9 TO WS-SS(2)
     MOVE 0.1 TO WS-SS(3)
     MOVE 0.75 TO WS-UU(1)
     MOVE 0.25 TO WS-UU(2)
     MOVE 0.5 TO WS-UU(3)
     MOVE 1 TO WS-FACE
     CALL "P4-FACE-PARTICLE" USING WS-P WS-FACE WS-S WS-U WS-OUT WS-VEL I1
     MOVE "example 9: UP face x offset is uniform (-0.5 + 0.75)" TO WS-NAME
     MOVE 1075000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-O(1)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "example 9: UP face y = centre + 0.55" TO WS-NAME
     MOVE 6505000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-O(2)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "example 9: UP face z offset (-0.5 + 0.25)" TO WS-NAME
     MOVE -275000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-O(3)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "example 9: in-plane velocity x = speed x (0.9 - 0.5)" TO WS-NAME
     MOVE 40000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-V(1)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "example 9: the velocity on the step axis is 0" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-V(2)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "example 9: in-plane velocity z" TO WS-NAME
     MOVE -40000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-V(3)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "15.4 an UP face consumes two position draws (x and z)" TO WS-NAME
     MOVE 2 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I1
     PERFORM ASSERT-NUMBER
     MOVE 2 TO WS-FACE
     MOVE 0.5 TO WS-UU(1)
     MOVE 0.5 TO WS-UU(2)
     CALL "P4-FACE-PARTICLE" USING WS-P WS-FACE WS-S WS-U WS-OUT WS-VEL I1
     MOVE "15.4 NORTH face: z = centre - 0.55" TO WS-NAME
     MOVE -305000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-O(3)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "15.4 NORTH face: x offset 0 at 0.5" TO WS-NAME
     MOVE 1050000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-O(1)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 0 TO WS-PP(1)
     MOVE 0 TO WS-PP(2)
     MOVE 0 TO WS-PP(3)
     MOVE 0.75 TO WS-UU(1)
     MOVE 0.25 TO WS-UU(2)
     MOVE 0.5 TO WS-UU(3)
     MOVE 0.75 TO W1
     MOVE 0 TO WS-FACE
     MOVE 0.125 TO W2
     CALL "P4-AXIS-PARTICLE" USING WS-P WS-FACE W2 WS-U W1 WS-OUT WS-VEL
     MOVE "15.4 along x: x = centre + u * 0.5 (u = 0.5)" TO WS-NAME
     MOVE 75000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-O(1)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "15.4 along x: y = centre + u * spread (u = -0.5)" TO WS-NAME
     MOVE 43750 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-O(2)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "15.4 along x: z = centre (u = 0)" TO WS-NAME
     MOVE 50000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-O(3)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "15.4 along x: velocity only on the chosen axis (0.5)" TO WS-NAME
     MOVE 50000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-V(1)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "15.4 along x: the other velocity components are 0" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-V(2) + WS-V(3)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 0.99 TO W1
     MOVE 3 TO I2
     MOVE 5 TO I3
     CALL "P4-UNIFORM-INT" USING I2 I3 W1 I1
     MOVE "UniformInt(3, 5) at 0.99 gives 5" TO WS-NAME
     MOVE 5 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I1
     PERFORM ASSERT-NUMBER
     MOVE 0 TO W1
     CALL "P4-UNIFORM-INT" USING I2 I3 W1 I1
     MOVE "UniformInt(3, 5) at 0 gives 3" TO WS-NAME
     MOVE 3 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I1
     PERFORM ASSERT-NUMBER
     MOVE 6 TO I3
     MOVE 0.5 TO W1
     CALL "P4-UNIFORM-INT" USING I2 I3 W1 I1
     MOVE "UniformInt(3, 6) at 0.5 gives 5" TO WS-NAME
     MOVE 5 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I1
     PERFORM ASSERT-NUMBER
     MOVE 10 TO I2
     MOVE 19 TO I3
     CALL "P4-UNIFORM-INT" USING I2 I3 W1 I1
     MOVE "UniformInt(10, 19) at 0.5 gives 15" TO WS-NAME
     MOVE 15 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I1
     PERFORM ASSERT-NUMBER
     STOP RUN.

 ASSERT-NUMBER.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-4§15 Emission paths used by this part: " FUNCTION TRIM(WS-NAME)
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "N" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 ASSERT-TEXT.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-4§15 Emission paths used by this part: " FUNCTION TRIM(WS-NAME)
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "T" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-PARTICLES-42-4-15.
