 PROCEDURE DIVISION.
     CALL "CL-INIT" USING CLIENT-STATE
     MOVE 0 TO PK-COUNT
     CALL "ENTITY-ATLAS-BUILD" USING CLIENT-STATE
     MOVE 256 TO PL-HEIGHT
     MOVE 0 TO SK-U
     MOVE 10 TO WS-EYE(1) WS-EYE(3)
     MOVE 64 TO WS-EYE(2)
     MOVE 1 TO CT-OPEN
     MOVE CT-TYPE-STANDARD TO CT-SET-TYPE
*>   4.2: the pose programs on the eight cases.
     PERFORM VARYING WS-C FROM 1 BY 1 UNTIL WS-C > 8
         CALL "EF8-LAYER" USING EMM-MODEL WS-LAYER WS-OK
         PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > 16
             MOVE 0 TO WS-IV(WS-J)
         END-PERFORM
         PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > 7
             MOVE WS-CIN(WS-C, WS-J) TO WS-IV(WS-J)
         END-PERFORM
         CALL "EF8-AXOLOTL-POSE" USING EMM-MODEL WS-IN
         PERFORM VARYING WS-F FROM 1 BY 1 UNTIL WS-F > 23
             MOVE WS-FPART(WS-F) TO WS-PN
             CALL "EMM-FIND" USING EMM-MODEL WS-PN WS-P
             EVALUATE WS-FCHAN(WS-F)
                 WHEN 1
                     MOVE MM-CXROT(WS-P) TO WS-PART
                 WHEN 2
                     MOVE MM-CYROT(WS-P) TO WS-PART
                 WHEN 3
                     MOVE MM-CZROT(WS-P) TO WS-PART
                 WHEN OTHER
                     MOVE MM-CY(WS-P) TO WS-PART
             END-EVALUATE
             COMPUTE WS-DIFF = WS-PART - WS-COUT(WS-C, WS-F)
             MOVE SPACES TO TL-CASE
             MOVE WS-C TO WS-CC
             STRING "acceptance axolotl pose case " WS-CC " " FUNCTION TRIM(WS-FNAME(WS-F)) DELIMITED BY SIZE INTO TL-CASE
             PERFORM CHECK-SMALL
         END-PERFORM
     END-PERFORM
*>   4.5: the BinaryAnimator. Ten ticks of true reach 10, the old value is 9; a false tick steps down.
     MOVE 0 TO WS-TICKS WS-OLD
     MOVE 1 TO WS-FLAG
     PERFORM 10 TIMES
         CALL "EF8-BINARY-TICK" USING WS-TICKS WS-OLD WS-FLAG
     END-PERFORM
     MOVE "acceptance axolotl animator ticks after ten true" TO TL-CASE
     MOVE WS-TICKS TO TL-OBSERVED-N
     MOVE 10 TO TL-EXPECTED-N
     PERFORM CHECK-N
     MOVE "acceptance axolotl animator old value after ten true" TO TL-CASE
     MOVE WS-OLD TO TL-OBSERVED-N
     MOVE 9 TO TL-EXPECTED-N
     PERFORM CHECK-N
     CALL "EF8-BINARY-TICK" USING WS-TICKS WS-OLD WS-FLAG
     MOVE "acceptance axolotl animator stays at 10" TO TL-CASE
     COMPUTE TL-OBSERVED-N = WS-TICKS * 100 + WS-OLD
     MOVE 1010 TO TL-EXPECTED-N
     PERFORM CHECK-N
     MOVE 0 TO WS-FLAG
     CALL "EF8-BINARY-TICK" USING WS-TICKS WS-OLD WS-FLAG
     MOVE "acceptance axolotl animator steps down" TO TL-CASE
     COMPUTE TL-OBSERVED-N = WS-TICKS * 100 + WS-OLD
     MOVE 910 TO TL-EXPECTED-N
     PERFORM CHECK-N
     MOVE 0 TO WS-TICKS WS-OLD
     CALL "EF8-BINARY-TICK" USING WS-TICKS WS-OLD WS-FLAG
     MOVE "acceptance axolotl animator stays at 0" TO TL-CASE
     MOVE WS-TICKS TO TL-OBSERVED-N
     MOVE 0 TO TL-EXPECTED-N
     PERFORM CHECK-N
     MOVE 4 TO WS-TICKS
     MOVE 3 TO WS-OLD
     MOVE 1 TO WS-PART
     CALL "EF8-BINARY-FACTOR" USING WS-TICKS WS-OLD WS-PART WS-FACTOR
     MOVE "acceptance axolotl animator factor at partial 1 (ease 0.4)" TO TL-CASE
     COMPUTE WS-DIFF = WS-FACTOR - 0.3454915
     PERFORM CHECK-SMALL
     MOVE 0.5 TO WS-PART
     CALL "EF8-BINARY-FACTOR" USING WS-TICKS WS-OLD WS-PART WS-FACTOR
     MOVE "acceptance axolotl animator factor at partial 0.5 (ease 0.35)" TO TL-CASE
     COMPUTE WS-DIFF = WS-FACTOR - 0.2730048
     PERFORM CHECK-SMALL
     MOVE 10 TO WS-TICKS WS-OLD
     MOVE 1 TO WS-PART
     CALL "EF8-BINARY-FACTOR" USING WS-TICKS WS-OLD WS-PART WS-FACTOR
     MOVE "acceptance axolotl animator factor at 10 is 1" TO TL-CASE
     COMPUTE WS-DIFF = WS-FACTOR - 1
     PERFORM CHECK-SMALL
     MOVE 0 TO WS-TICKS WS-OLD
     CALL "EF8-BINARY-FACTOR" USING WS-TICKS WS-OLD WS-PART WS-FACTOR
     MOVE "acceptance axolotl animator factor at 0 is 0" TO TL-CASE
     MOVE WS-FACTOR TO WS-DIFF
     PERFORM CHECK-SMALL
*>   The replica: water at (10, 64, 10) only.
     CALL "STATE-TABLES-ENSURE" USING CLIENT-STATE
     MOVE 1 TO ST-FLUID(5)
     MOVE 0 TO ST-LEVEL(5) ST-OPAQUE(5)
     MOVE 4 TO WS-STATE
     MOVE 10 TO WS-BX WS-BZ
     MOVE 64 TO WS-BY
     CALL "TEST-SET-BLOCK" USING CLIENT-STATE WS-BX WS-BY WS-BZ WS-STATE
     CALL "ENTITIES-CLEAR" USING CLIENT-STATE
     MOVE "axolotl" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-TYPE WS-ROW-AREA WS-STATUS
     CALL "MM-SPAWN" USING CLIENT-STATE WS-ID WS-TYPE WS-X WS-Y WS-Z WS-YAW
     MOVE 1 TO WS-ROW
*>   In water and still: the in-water animator rises, the others stay.
     PERFORM 3 TIMES
         CALL "ENTITIES-ANIM-TICK" USING CLIENT-STATE
     END-PERFORM
     MOVE "acceptance axolotl in water: animator ticks" TO TL-CASE
     PERFORM TICKS-CODE
     MOVE 300 TO TL-EXPECTED-N
     PERFORM CHECK-N
     MOVE "acceptance axolotl in water: old ticks" TO TL-CASE
     PERFORM OLD-CODE
     MOVE 200 TO TL-EXPECTED-N
     PERFORM CHECK-N
*>   Out of the water on the ground: on-ground rises, in-water falls.
     MOVE 80 TO EN-Y(1)
     MOVE 80 TO EN-OY(1)
     MOVE 1 TO EN-ON-GROUND(1)
     PERFORM 2 TIMES
         CALL "ENTITIES-ANIM-TICK" USING CLIENT-STATE
     END-PERFORM
     MOVE "acceptance axolotl on the ground: animator ticks" TO TL-CASE
     PERFORM TICKS-CODE
     MOVE 20100 TO TL-EXPECTED-N
     PERFORM CHECK-N
*>   In the air (neither): all three fall.
     MOVE 0 TO EN-ON-GROUND(1)
     PERFORM 3 TIMES
         CALL "ENTITIES-ANIM-TICK" USING CLIENT-STATE
     END-PERFORM
     MOVE "acceptance axolotl in the air: animator ticks" TO TL-CASE
     PERFORM TICKS-CODE
     MOVE 0 TO TL-EXPECTED-N
     PERFORM CHECK-N
*>   Playing dead (entry 19, BOOLEAN) takes priority over the water and the ground.
     MOVE 64 TO EN-Y(1)
     MOVE 64 TO EN-OY(1)
     MOVE 1 TO EN-ON-GROUND(1)
     MOVE 19 TO WS-INDEX
     MOVE 8 TO WS-SERIAL
     MOVE 1 TO WS-INT
     MOVE 0 TO WS-INT2 WS-INT3 WS-LONG
     CALL "ENTITY-VARIANT-SET" USING CLIENT-STATE WS-ROW WS-INDEX WS-SERIAL WS-INT WS-INT2 WS-INT3 WS-LONG
     MOVE "acceptance axolotl entry 19 keeps the playing-dead flag" TO TL-CASE
     MOVE EN-AX-PD(1) TO TL-OBSERVED-N
     MOVE 1 TO TL-EXPECTED-N
     PERFORM CHECK-N
     PERFORM 2 TIMES
         CALL "ENTITIES-ANIM-TICK" USING CLIENT-STATE
     END-PERFORM
     MOVE "acceptance axolotl playing dead: animator ticks" TO TL-CASE
     PERFORM TICKS-CODE
     MOVE 2 TO TL-EXPECTED-N
     PERFORM CHECK-N
     MOVE 0 TO WS-INT
     CALL "ENTITY-VARIANT-SET" USING CLIENT-STATE WS-ROW WS-INDEX WS-SERIAL WS-INT WS-INT2 WS-INT3 WS-LONG
     MOVE "acceptance axolotl entry 19 clears the playing-dead flag" TO TL-CASE
     MOVE EN-AX-PD(1) TO TL-OBSERVED-N
     MOVE 0 TO TL-EXPECTED-N
     PERFORM CHECK-N
*>   The moving flag: a change of the rotation counts for one tick, a walk for as long as the speed is above 1e-5.
     CALL "ENTITIES-CLEAR" USING CLIENT-STATE
     MOVE 80 TO WS-Y
     CALL "MM-SPAWN" USING CLIENT-STATE WS-ID WS-TYPE WS-X WS-Y WS-Z WS-YAW
     MOVE 30 TO EN-YAW(1)
     CALL "ENTITIES-ANIM-TICK" USING CLIENT-STATE
     MOVE "acceptance axolotl turning: moving animator after one tick" TO TL-CASE
     PERFORM TICKS-CODE
     MOVE 1000000 TO TL-EXPECTED-N
     PERFORM CHECK-N
     CALL "ENTITIES-ANIM-TICK" USING CLIENT-STATE
     MOVE "acceptance axolotl no longer turning: moving animator falls" TO TL-CASE
     PERFORM TICKS-CODE
     MOVE 0 TO TL-EXPECTED-N
     PERFORM CHECK-N
     MOVE 40 TO EN-AX-XR(1)
     CALL "ENTITIES-ANIM-TICK" USING CLIENT-STATE
     MOVE "acceptance axolotl pitch change: moving animator rises" TO TL-CASE
     PERFORM TICKS-CODE
     MOVE 1000000 TO TL-EXPECTED-N
     PERFORM CHECK-N
     MOVE 0 TO EN-AX-O(1, 4)
     MOVE 0 TO EN-AX-T(1, 4)
     PERFORM 3 TIMES
         COMPUTE EN-X(1) = EN-X(1) + 0.5
         CALL "ENTITIES-ANIM-TICK" USING CLIENT-STATE
     END-PERFORM
     MOVE "acceptance axolotl walking: moving animator ticks" TO TL-CASE
     PERFORM TICKS-CODE
     MOVE 3000000 TO TL-EXPECTED-N
     PERFORM CHECK-N
*>   A baby has the animators too.
     CALL "ENTITIES-CLEAR" USING CLIENT-STATE
     MOVE 64 TO WS-Y
     CALL "MM-SPAWN" USING CLIENT-STATE WS-ID WS-TYPE WS-X WS-Y WS-Z WS-YAW
     MOVE 1 TO EN-BABY(1)
     PERFORM 2 TIMES
         CALL "ENTITIES-ANIM-TICK" USING CLIENT-STATE
     END-PERFORM
     MOVE "acceptance axolotl baby: animator ticks" TO TL-CASE
     PERFORM TICKS-CODE
     MOVE 200 TO TL-EXPECTED-N
     PERFORM CHECK-N
*>   The drawn mesh follows the factors: the same axolotl with the in-water animator full, with the on-ground animator full and with the playing-dead animator full.
     CALL "ENTITIES-CLEAR" USING CLIENT-STATE
     CALL "MM-SPAWN" USING CLIENT-STATE WS-ID WS-TYPE WS-X WS-Y WS-Z WS-YAW
     MOVE 10 TO EN-AX-T(1, 2)
     MOVE 9 TO EN-AX-O(1, 2)
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     PERFORM SUM-MESH
     MOVE WS-SUM2 TO WS-SUM1
     MOVE "acceptance axolotl drawn" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF RL-EN-COUNT > 0
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     PERFORM CHECK-N
     MOVE 0 TO EN-AX-T(1, 2)
     MOVE 0 TO EN-AX-O(1, 2)
     MOVE 10 TO EN-AX-T(1, 3)
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     PERFORM SUM-MESH
     MOVE WS-SUM2 TO WS-SUM3
     MOVE "acceptance axolotl on the ground is posed differently from in water" TO TL-CASE
     COMPUTE WS-DIFF = WS-SUM3 - WS-SUM1
     PERFORM CHECK-OTHER
     MOVE 0 TO EN-AX-T(1, 3)
     MOVE 10 TO EN-AX-T(1, 1)
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     PERFORM SUM-MESH
     MOVE "acceptance axolotl playing dead is posed differently from on the ground" TO TL-CASE
     COMPUTE WS-DIFF = WS-SUM2 - WS-SUM3
     PERFORM CHECK-OTHER
     STOP RUN.
 TICKS-CODE.
     COMPUTE TL-OBSERVED-N = EN-AX-T(1, 4) * 1000000 + EN-AX-T(1, 3) * 10000 + EN-AX-T(1, 2) * 100 + EN-AX-T(1, 1).
 OLD-CODE.
     COMPUTE TL-OBSERVED-N = EN-AX-O(1, 4) * 1000000 + EN-AX-O(1, 3) * 10000 + EN-AX-O(1, 2) * 100 + EN-AX-O(1, 1).
 SUM-MESH.
     MOVE 0 TO WS-SUM2
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > RL-EN-COUNT
         COMPUTE WS-SUM2 = WS-SUM2 + (RL-EN-Y(WS-J) + RL-EN-X(WS-J) * 2 + RL-EN-Z(WS-J) * 3) * WS-J
     END-PERFORM.
 CHECK-SMALL.
     MOVE "N" TO TL-MODE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF WS-DIFF < 0.00001 AND WS-DIFF > -0.00001
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 CHECK-OTHER.
     MOVE "N" TO TL-MODE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF WS-DIFF > 0.001 OR WS-DIFF < -0.001
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 CHECK-N.
     MOVE "N" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-ENTMODEL-AXOLOTL.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. MM-SPAWN.
*> USING CLIENT-STATE, entity id, type (registry id), x y z (FLOAT-LONG), yaw (FLOAT-SHORT, also the head yaw): Add Entity.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY PROTO.
 01 WS-READY               BINARY-LONG VALUE 0.
 01 WS-CAPACITY            BINARY-LONG VALUE 1024.
 01 WS-ADD                 BINARY-LONG VALUE 1.
 01 WS-ZERO                BINARY-LONG VALUE 0.
 01 WS-UUID                PIC X(16) VALUE LOW-VALUES.
 01 WS-V0                  FLOAT-LONG VALUE 0.
 01 WS-V1                  FLOAT-LONG VALUE 0.
 01 WS-V2                  FLOAT-LONG VALUE 0.
 01 WS-A0                  FLOAT-SHORT VALUE 0.
 LINKAGE SECTION.
 COPY CLSTATE.
 01 L-ID                   BINARY-LONG.
 01 L-TYPE                 BINARY-LONG.
 01 L-X                    FLOAT-LONG.
 01 L-Y                    FLOAT-LONG.
 01 L-Z                    FLOAT-LONG.
 01 L-YAW                  FLOAT-SHORT.
 PROCEDURE DIVISION USING CLIENT-STATE L-ID L-TYPE L-X L-Y L-Z L-YAW.
     IF WS-READY = 0
         CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
         MOVE 1 TO WS-READY
     END-IF
     CALL "PB-RESET" USING PB-BUFFER
     CALL "PB-PUT-VARINT" USING PB-BUFFER L-ID
     CALL "PB-PUT-UUID" USING PB-BUFFER WS-UUID
     CALL "PB-PUT-VARINT" USING PB-BUFFER L-TYPE
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER L-X
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER L-Y
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER L-Z
     CALL "PB-PUT-LPVEC3" USING PB-BUFFER WS-V0 WS-V1 WS-V2
     CALL "PB-PUT-ANGLE" USING PB-BUFFER WS-A0
     CALL "PB-PUT-ANGLE" USING PB-BUFFER L-YAW
     CALL "PB-PUT-ANGLE" USING PB-BUFFER L-YAW
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-ZERO
     MOVE 0 TO PB-POS
     CALL "ENTITY-PACKET" USING CLIENT-STATE PB-BUFFER WS-ADD
     GOBACK.
 END PROGRAM MM-SPAWN.



 COPY CLTEST.
