*> Implementation test of client/src/json.cob (JSON-PARSE, JSON-STRING, JSON-KEY, JSON-MEMBER,
*> JSON-ELEMENT, JSON-FIND; RFC 8259): objects, arrays, strings with every escape and \u escapes
*> (including a surrogate pair), numbers with sign, fraction and exponent, true, false, null, path
*> lookup, and malformed texts reported as an error with no nodes.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-JSON.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY JSONDOC.
 COPY TESTLIB.
 01 WS-TEXT                PIC X(512).
 01 WS-LENGTH              BINARY-LONG.
 01 WS-NODE                BINARY-LONG.
 01 WS-NODE2               BINARY-LONG.
 01 WS-NODE3               BINARY-LONG.
 01 WS-INDEX               BINARY-LONG.
 01 WS-OUT                 PIC X(512).
 01 WS-CAP                 BINARY-LONG VALUE 256.
 01 WS-OUT-LENGTH          BINARY-LONG.
 01 WS-PATH                PIC X(64).
 01 WS-PATH-LENGTH         BINARY-LONG.
 01 WS-EDIT                PIC -(6)9.9(4).
 01 WS-HEX                 PIC X(1024).
 01 WS-I                   BINARY-LONG.
 01 WS-BAD.
    05 FILLER PIC X(24) VALUE "{".
    05 FILLER PIC X(24) VALUE "[1,]".
    05 FILLER PIC X(24) VALUE '{"a" 1}'.
    05 FILLER PIC X(24) VALUE '"abc'.
    05 FILLER PIC X(24) VALUE '"\q"'.
    05 FILLER PIC X(24) VALUE "tru".
    05 FILLER PIC X(24) VALUE "[1] 2".
    05 FILLER PIC X(24) VALUE "-".
    05 FILLER PIC X(24) VALUE '{"a":1,}'.
    05 FILLER PIC X(24) VALUE '"~u12G4"'.
    05 FILLER PIC X(24) VALUE "1.e5".
    05 FILLER PIC X(24) VALUE "@".
    05 FILLER PIC X(24) VALUE SPACES.
    05 FILLER PIC X(24) VALUE '{1:2}'.
    05 FILLER PIC X(24) VALUE '[1 2]'.
    05 FILLER PIC X(24) VALUE '1e+'.
 01 WS-BAD-TABLE REDEFINES WS-BAD.
    05 WS-BAD-TEXT         PIC X(24) OCCURS 16 TIMES.
 PROCEDURE DIVISION.
*>   "~" stands for a backslash (C compilers read a backslash-u in a literal as a character name).
     MOVE '{"name":"cobol~"craft~~~/","list":[1,-2.5,3e2,true,false,null,{"k":[]}],'
         & '"esc":"~b~f~n~r~t","u":"~u00e9~ud83d~ude00~u0041","empty":{},"e":1.5E-1}'
         TO WS-TEXT
     INSPECT WS-TEXT REPLACING ALL "~" BY X"5C"
     MOVE FUNCTION LENGTH(FUNCTION TRIM(WS-TEXT)) TO WS-LENGTH
     CALL "JSON-PARSE" USING JSON-DOC WS-TEXT WS-LENGTH
     MOVE "json a valid document parses with no error into 15 nodes, root an object of 6 members"
         TO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE "0 18 1 6" TO TL-EXPECTED
     MOVE SPACES TO TL-OBSERVED
     MOVE JD-COUNT TO WS-EDIT
     STRING JD-ERROR " " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE JN-TYPE(1) TO WS-EDIT
     STRING FUNCTION TRIM(TL-OBSERVED) " " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE JN-COUNT(1) TO WS-EDIT
     STRING FUNCTION TRIM(TL-OBSERVED) " " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "0 15.0000 1.0000 6.0000" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "name" TO WS-PATH
     MOVE 4 TO WS-PATH-LENGTH
     CALL "JSON-FIND" USING JSON-DOC WS-PATH WS-PATH-LENGTH WS-NODE
     CALL "JSON-STRING" USING JSON-DOC WS-NODE WS-OUT WS-CAP WS-OUT-LENGTH
     MOVE "json path name: a string with escaped quote, backslash and slash" TO TL-CASE
     MOVE 'cobol"craft\/' TO TL-EXPECTED
     MOVE WS-OUT(1:WS-OUT-LENGTH) TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "esc" TO WS-PATH
     MOVE 3 TO WS-PATH-LENGTH
     CALL "JSON-FIND" USING JSON-DOC WS-PATH WS-PATH-LENGTH WS-NODE
     CALL "JSON-STRING" USING JSON-DOC WS-NODE WS-OUT WS-CAP WS-OUT-LENGTH
     CALL "TEST-HEX-OF" USING WS-OUT WS-OUT-LENGTH WS-HEX
     MOVE "json escapes \b \f \n \r \t decode to bytes 08 0c 0a 0d 09" TO TL-CASE
     MOVE "080c0a0d09" TO TL-EXPECTED
     MOVE WS-HEX TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "u" TO WS-PATH
     MOVE 1 TO WS-PATH-LENGTH
     CALL "JSON-FIND" USING JSON-DOC WS-PATH WS-PATH-LENGTH WS-NODE
     CALL "JSON-STRING" USING JSON-DOC WS-NODE WS-OUT WS-CAP WS-OUT-LENGTH
     CALL "TEST-HEX-OF" USING WS-OUT WS-OUT-LENGTH WS-HEX
     MOVE "json \u escapes decode to UTF-8, a surrogate pair to one 4-byte character" TO TL-CASE
     MOVE "c3a9f09f988041" TO TL-EXPECTED
     MOVE WS-HEX TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "json numbers: list[0] 1, list[1] -2.5, list[2] 3e2, e 1.5E-1" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE "list[0]" TO WS-PATH
     MOVE 7 TO WS-PATH-LENGTH
     CALL "JSON-FIND" USING JSON-DOC WS-PATH WS-PATH-LENGTH WS-NODE
     COMPUTE WS-EDIT ROUNDED = JN-NUM(WS-NODE)
     MOVE FUNCTION TRIM(WS-EDIT) TO TL-OBSERVED
     MOVE "list[1]" TO WS-PATH
     CALL "JSON-FIND" USING JSON-DOC WS-PATH WS-PATH-LENGTH WS-NODE
     COMPUTE WS-EDIT ROUNDED = JN-NUM(WS-NODE)
     STRING FUNCTION TRIM(TL-OBSERVED) " " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "list[2]" TO WS-PATH
     CALL "JSON-FIND" USING JSON-DOC WS-PATH WS-PATH-LENGTH WS-NODE
     COMPUTE WS-EDIT ROUNDED = JN-NUM(WS-NODE)
     STRING FUNCTION TRIM(TL-OBSERVED) " " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "e" TO WS-PATH
     MOVE 1 TO WS-PATH-LENGTH
     CALL "JSON-FIND" USING JSON-DOC WS-PATH WS-PATH-LENGTH WS-NODE
     COMPUTE WS-EDIT ROUNDED = JN-NUM(WS-NODE)
     STRING FUNCTION TRIM(TL-OBSERVED) " " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "1.0000 -2.5000 300.0000 0.1500" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "json literals and nesting: list[3..5] true false null, list[6].k an empty array, "
         & "list[7] absent" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE 7 TO WS-PATH-LENGTH
     MOVE "list[3]" TO WS-PATH
     CALL "JSON-FIND" USING JSON-DOC WS-PATH WS-PATH-LENGTH WS-NODE
     MOVE JN-TYPE(WS-NODE) TO WS-I
     MOVE "list[4]" TO WS-PATH
     CALL "JSON-FIND" USING JSON-DOC WS-PATH WS-PATH-LENGTH WS-NODE
     COMPUTE WS-I = WS-I * 10 + JN-TYPE(WS-NODE)
     MOVE "list[5]" TO WS-PATH
     CALL "JSON-FIND" USING JSON-DOC WS-PATH WS-PATH-LENGTH WS-NODE
     COMPUTE WS-I = WS-I * 10 + JN-TYPE(WS-NODE)
     MOVE "list[6].k" TO WS-PATH
     MOVE 9 TO WS-PATH-LENGTH
     CALL "JSON-FIND" USING JSON-DOC WS-PATH WS-PATH-LENGTH WS-NODE
     COMPUTE WS-I = WS-I * 10 + JN-TYPE(WS-NODE)
     COMPUTE WS-I = WS-I * 10 + JN-COUNT(WS-NODE)
     MOVE "list[7]" TO WS-PATH
     MOVE 7 TO WS-PATH-LENGTH
     CALL "JSON-FIND" USING JSON-DOC WS-PATH WS-PATH-LENGTH WS-NODE
     COMPUTE WS-I = WS-I * 10 + WS-NODE
     MOVE WS-I TO WS-EDIT
     MOVE FUNCTION TRIM(WS-EDIT) TO TL-OBSERVED
     MOVE "567200.0000" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "nope.x" TO WS-PATH
     MOVE 6 TO WS-PATH-LENGTH
     CALL "JSON-FIND" USING JSON-DOC WS-PATH WS-PATH-LENGTH WS-NODE
     MOVE "name[0]" TO WS-PATH
     MOVE 7 TO WS-PATH-LENGTH
     CALL "JSON-FIND" USING JSON-DOC WS-PATH WS-PATH-LENGTH WS-NODE2
     MOVE "name.x" TO WS-PATH
     MOVE 6 TO WS-PATH-LENGTH
     CALL "JSON-FIND" USING JSON-DOC WS-PATH WS-PATH-LENGTH WS-INDEX
     MOVE "json path lookup: an absent member, an index into a string and a member of a string "
         & "give node 0" TO TL-CASE
     MOVE "N" TO TL-MODE
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-NODE + WS-NODE2 + WS-INDEX
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE 1 TO WS-NODE
     MOVE "empty" TO WS-OUT
     MOVE 5 TO WS-OUT-LENGTH
     CALL "JSON-MEMBER" USING JSON-DOC WS-NODE WS-OUT WS-OUT-LENGTH WS-NODE2
     CALL "JSON-KEY" USING JSON-DOC WS-NODE2 WS-OUT WS-CAP WS-OUT-LENGTH
     MOVE 2 TO WS-INDEX
     MOVE "list" TO WS-PATH
     MOVE 4 TO WS-PATH-LENGTH
     CALL "JSON-FIND" USING JSON-DOC WS-PATH WS-PATH-LENGTH WS-NODE
     CALL "JSON-ELEMENT" USING JSON-DOC WS-NODE WS-INDEX WS-NODE3
     MOVE WS-NODE3 TO WS-NODE
     MOVE "json member empty is an empty object with key empty; element 2 of list is 300"
         TO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE SPACES TO TL-OBSERVED
     COMPUTE WS-EDIT ROUNDED = JN-NUM(WS-NODE)
     MOVE JN-TYPE(WS-NODE2) TO WS-I
     STRING WS-OUT(1:WS-OUT-LENGTH) " " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED
     IF WS-I NOT = 1 OR JN-COUNT(WS-NODE2) NOT = 0
         MOVE "not an empty object" TO TL-OBSERVED
     END-IF
     MOVE "empty 300.0000" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE ' "a\"b" ' TO WS-TEXT
     MOVE 8 TO WS-LENGTH
     CALL "JSON-PARSE" USING JSON-DOC WS-TEXT WS-LENGTH
     MOVE 1 TO WS-NODE
     MOVE 2 TO WS-CAP
     CALL "JSON-STRING" USING JSON-DOC WS-NODE WS-OUT WS-CAP WS-OUT-LENGTH
     MOVE "json a root string with whitespace around it; decoding stops at the capacity" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     STRING WS-OUT(1:WS-OUT-LENGTH) "|" DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE 'a"|' TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 256 TO WS-CAP

     MOVE "json malformed texts give an error and no nodes: " TO TL-CASE
     MOVE SPACES TO TL-OBSERVED TL-EXPECTED
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 16
         MOVE WS-BAD-TEXT(WS-I) TO WS-TEXT
         INSPECT WS-TEXT REPLACING ALL "~" BY X"5C"
         MOVE FUNCTION LENGTH(FUNCTION TRIM(WS-BAD-TEXT(WS-I) TRAILING)) TO WS-LENGTH
         IF WS-BAD-TEXT(WS-I) = SPACES
             MOVE 0 TO WS-LENGTH
         END-IF
         CALL "JSON-PARSE" USING JSON-DOC WS-TEXT WS-LENGTH
         STRING FUNCTION TRIM(TL-EXPECTED) "1" DELIMITED BY SIZE INTO TL-EXPECTED
         IF JD-ERROR = 1 AND JD-COUNT = 0
             STRING FUNCTION TRIM(TL-OBSERVED) "1" DELIMITED BY SIZE INTO TL-OBSERVED
         ELSE
             STRING FUNCTION TRIM(TL-OBSERVED) "0" DELIMITED BY SIZE INTO TL-OBSERVED
         END-IF
     END-PERFORM
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE '{"":"~u20ac~ud800x~udc00"}' TO WS-TEXT
     INSPECT WS-TEXT REPLACING ALL "~" BY X"5C"
     MOVE 26 TO WS-LENGTH
     CALL "JSON-PARSE" USING JSON-DOC WS-TEXT WS-LENGTH
     MOVE 1 TO WS-NODE
     MOVE 0 TO WS-OUT-LENGTH
     CALL "JSON-MEMBER" USING JSON-DOC WS-NODE WS-OUT WS-OUT-LENGTH WS-NODE2
     CALL "JSON-STRING" USING JSON-DOC WS-NODE2 WS-OUT WS-CAP WS-OUT-LENGTH
     CALL "TEST-HEX-OF" USING WS-OUT WS-OUT-LENGTH WS-HEX
     MOVE "json the empty key is found; a 3-byte character, a lone high and a lone low surrogate "
         & "(each U+FFFD)" TO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE "e282acefbfbd78efbfbd" TO TL-EXPECTED
     MOVE WS-HEX TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

*>   UTF-8 decoding: 1 to 4 byte characters, a stray continuation byte, a bad continuation and a
*>   sequence cut by the end each give U+FFFD and move one byte.
     MOVE SPACES TO WS-TEXT
     STRING "A" FUNCTION CHAR(197) FUNCTION CHAR(171) FUNCTION CHAR(228) FUNCTION CHAR(132)
         FUNCTION CHAR(174) FUNCTION CHAR(242) FUNCTION CHAR(161) FUNCTION CHAR(154)
         FUNCTION CHAR(130) FUNCTION CHAR(130) FUNCTION CHAR(198) "B" FUNCTION CHAR(226)
         DELIMITED BY SIZE INTO WS-TEXT
     MOVE 14 TO WS-LENGTH
     MOVE 1 TO WS-I
     MOVE SPACES TO TL-OBSERVED
     PERFORM UNTIL WS-I > WS-LENGTH
         CALL "UTF8-DECODE" USING WS-TEXT WS-LENGTH WS-I WS-NODE
         MOVE WS-NODE TO WS-EDIT
         STRING FUNCTION TRIM(TL-OBSERVED) FUNCTION TRIM(WS-EDIT) "," DELIMITED BY SIZE
             INTO TL-OBSERVED
     END-PERFORM
     MOVE "json UTF-8 decoding of 1, 2, 3 and 4 byte characters and of invalid bytes" TO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE "65.0000,298.0000,12525.0000,394817.0000,65533.0000,65533.0000,66.0000,65533.0000,"
         TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE ALL "[" TO WS-TEXT
     MOVE 100 TO WS-LENGTH
     CALL "JSON-PARSE" USING JSON-DOC WS-TEXT WS-LENGTH
     MOVE "json nesting deeper than 64 levels is malformed" TO TL-CASE
     MOVE "N" TO TL-MODE
     MOVE 1 TO TL-EXPECTED-N
     MOVE JD-ERROR TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.
 END PROGRAM TEST-JSON.
 COPY CLTEST.
