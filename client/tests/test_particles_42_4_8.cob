*> Acceptance test of docs/protocol/42-particles-4-block-item-dust-ambient.md section 8 (Item break particles): the rules, table rows,
*> formulas and worked cases of the section with the document's numbers; every float case compares
*> the value times 100000 rounded. Draws are injected through the draw tables.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-PARTICLES-42-4-8.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CLPCL.
 COPY CLPCLX.
 COPY CLP4X.
 COPY TESTLIB.
 01 WS-NAME                PIC X(160).
 01 WS-DRAWS.
    05 WS-D                FLOAT-LONG OCCURS 16 TIMES.
 01 WS-EDRAWS.
    05 WS-E                FLOAT-LONG OCCURS 16 TIMES.
 01 W1                     FLOAT-LONG.
 01 W2                     FLOAT-LONG.
 01 W3                     FLOAT-LONG.
 01 W4                     FLOAT-LONG.
 01 W5                     FLOAT-LONG.
 01 W6                     FLOAT-LONG.
 01 W7                     FLOAT-LONG.
 01 W8                     FLOAT-LONG.
 01 I1                     BINARY-LONG.
 01 I2                     BINARY-LONG.
 01 I3                     BINARY-LONG.
 01 I4                     BINARY-LONG.
 01 I5                     BINARY-LONG.
 01 B1                     BINARY-DOUBLE.
 01 T1                     PIC X(80).
 01 Z1                     FLOAT-LONG VALUE 0.
 01 Z2                     FLOAT-LONG VALUE 0.
 01 Z3                     FLOAT-LONG VALUE 0.
 01 Z4                     FLOAT-LONG VALUE 0.
 01 Z5                     FLOAT-LONG VALUE 0.
 01 Z6                     FLOAT-LONG VALUE 0.
 01 WS-ARGB               BINARY-DOUBLE.
 01 WS-NAME8              PIC X(32).
 01 WS-ARGS.
    05 WS-GS              FLOAT-LONG.
    05 WS-WB              FLOAT-LONG.
    05 WS-SW              BINARY-LONG.
    05 WS-FA              BINARY-LONG.
    05 WS-SZ              FLOAT-LONG.
    05 WS-FS              FLOAT-LONG.
 01 WS-SPR                BINARY-LONG.
 PROCEDURE DIVISION.
     MOVE 41 TO I2
     CALL "P4-LEAF-ARGS" USING I2 WS-ARGS WS-SPR
     MOVE "cherry gravityScale 0.25" TO WS-NAME
     MOVE 25000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-GS) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "cherry windBig 2.0" TO WS-NAME
     MOVE 200000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-WB) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "cherry swirl false" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-SW
     PERFORM ASSERT-NUMBER
     MOVE "cherry flowAway true" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-FA
     PERFORM ASSERT-NUMBER
     MOVE "cherry sizeScale 1.0" TO WS-NAME
     MOVE 100000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-SZ) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "cherry fallSpeed 0.0" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-FS) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "cherry has 12 sprites" TO WS-NAME
     MOVE 12 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-SPR
     PERFORM ASSERT-NUMBER
     MOVE 42 TO I2
     CALL "P4-LEAF-ARGS" USING I2 WS-ARGS WS-SPR
     MOVE "pale oak gravityScale 0.07" TO WS-NAME
     MOVE 7000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-GS) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "pale oak windBig 10.0" TO WS-NAME
     MOVE 1000000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-WB) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "pale oak swirl true" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-SW
     PERFORM ASSERT-NUMBER
     MOVE "pale oak flowAway false" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-FA
     PERFORM ASSERT-NUMBER
     MOVE "pale oak sizeScale 2.0" TO WS-NAME
     MOVE 200000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-SZ) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "pale oak fallSpeed 0.021" TO WS-NAME
     MOVE 2100 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-FS) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 44 TO I2
     CALL "P4-LEAF-ARGS" USING I2 WS-ARGS WS-SPR
     MOVE "orange poplar uses the same numbers (gravityScale)" TO WS-NAME
     MOVE 7000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-GS) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "poplar has 4 sprites" TO WS-NAME
     MOVE 4 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-SPR
     PERFORM ASSERT-NUMBER
     MOVE 46 TO I2
     CALL "P4-LEAF-ARGS" USING I2 WS-ARGS WS-SPR
     MOVE "tinted leaves sizeScale 2.0" TO WS-NAME
     MOVE 200000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-SZ) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "tinted leaves have 12 sprites" TO WS-NAME
     MOVE 12 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-SPR
     PERFORM ASSERT-NUMBER
     MOVE 0.5 TO W1
     MOVE 4 TO I2
     CALL "P4-LEAF-SPRITE" USING I2 W1 I3
     MOVE "sprites.get(random) is nextInt(n): 0.5 of 4 gives 2" TO WS-NAME
     MOVE 2 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I3
     PERFORM ASSERT-NUMBER
     PERFORM VARYING I1 FROM 1 BY 1 UNTIL I1 > 16
         MOVE 0.5 TO WS-D(I1)
     END-PERFORM
     MOVE 1 TO WS-D(3)
     MOVE 0 TO WS-D(4)
     MOVE 1 TO WS-D(5)
     MOVE 0 TO W1
     MOVE 41 TO I2
     CALL "P4-LEAF-NEW" USING PCL PCLX Z1 Z2 Z3 I2 WS-DRAWS
     MOVE "cherry per-tick gravity 0.25 * 1.2 * 0.0025" TO WS-NAME
     MOVE 75 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-GRAVITY) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "cherry quad size 1.0 * 0.05 (boolean true)" TO WS-NAME
     MOVE 5000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-QUAD-SIZE) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "cherry initial yd = -0" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-YD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "cherry keeps colour 1, 1, 1" TO WS-NAME
     MOVE 300000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-RCOL + PC-GCOL + PC-BCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 42 TO I2
     CALL "P4-LEAF-NEW" USING PCL PCLX Z1 Z2 Z3 I2 WS-DRAWS
     MOVE "pale oak per-tick gravity 0.07 * 1.2 * 0.0025" TO WS-NAME
     MOVE 21 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-GRAVITY) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "pale oak quad size 2.0 * 0.05" TO WS-NAME
     MOVE 10000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-QUAD-SIZE) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "pale oak initial yd = -0.021" TO WS-NAME
     MOVE -2100 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-YD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 0 TO WS-D(5)
     CALL "P4-LEAF-NEW" USING PCL PCLX Z1 Z2 Z3 I2 WS-DRAWS
     MOVE "pale oak quad size 2.0 * 0.075 (boolean false)" TO WS-NAME
     MOVE 15000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-QUAD-SIZE) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 1 TO WS-D(5)
     MOVE -9399763 TO WS-ARGB
     MOVE 46 TO I2
     CALL "P4-LEAF-NEW" USING PCL PCLX Z1 Z2 Z3 I2 WS-DRAWS
     CALL "P4-LEAF-TINT" USING PCL WS-ARGB
     MOVE "tinted: red 112 / 255 (the azalea colour)" TO WS-NAME
     MOVE 43922 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-RCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "tinted: green 146 / 255" TO WS-NAME
     MOVE 57255 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-GCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "tinted: blue 45 / 255" TO WS-NAME
     MOVE 17647 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-BCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "cherry_leaves" TO WS-NAME8
     CALL "P4-LEAF-CHANCE" USING WS-NAME8 W1 I2 WS-ARGB I3
     MOVE "cherry leaves chance 0.1" TO WS-NAME
     MOVE 10000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((W1) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "cherry leaves emit cherry_leaves (41)" TO WS-NAME
     MOVE 41 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I2
     PERFORM ASSERT-NUMBER
     MOVE "pale_oak_leaves" TO WS-NAME8
     CALL "P4-LEAF-CHANCE" USING WS-NAME8 W1 I2 WS-ARGB I3
     MOVE "pale oak chance 0.02" TO WS-NAME
     MOVE 2000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((W1) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "pale oak emits pale_oak_leaves (42)" TO WS-NAME
     MOVE 42 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I2
     PERFORM ASSERT-NUMBER
     MOVE "oak_leaves" TO WS-NAME8
     CALL "P4-LEAF-CHANCE" USING WS-NAME8 W1 I2 WS-ARGB I3
     MOVE "oak chance 0.01" TO WS-NAME
     MOVE 1000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((W1) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "oak emits tinted_leaves (46) with the client tint (colour 0)" TO WS-NAME
     MOVE 46 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I2
     PERFORM ASSERT-NUMBER
     MOVE "oak colour is the client leaf tint" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-ARGB
     PERFORM ASSERT-NUMBER
     MOVE "mangrove_leaves" TO WS-NAME8
     CALL "P4-LEAF-CHANCE" USING WS-NAME8 W1 I2 WS-ARGB I3
     MOVE "mangrove chance 0.01 (tinted like oak)" TO WS-NAME
     MOVE 1000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((W1) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "mangrove emits tinted_leaves" TO WS-NAME
     MOVE 46 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I2
     PERFORM ASSERT-NUMBER
     MOVE "azalea_leaves" TO WS-NAME8
     CALL "P4-LEAF-CHANCE" USING WS-NAME8 W1 I2 WS-ARGB I3
     MOVE "azalea emits tinted_leaves with the fixed colour -9399763" TO WS-NAME
     MOVE -9399763 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-ARGB
     PERFORM ASSERT-NUMBER
     MOVE "flowering_azalea_leaves" TO WS-NAME8
     CALL "P4-LEAF-CHANCE" USING WS-NAME8 W1 I2 WS-ARGB I3
     MOVE "flowering azalea has the same fixed colour" TO WS-NAME
     MOVE -9399763 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-ARGB
     PERFORM ASSERT-NUMBER
     MOVE "yellow_poplar_leaves" TO WS-NAME8
     CALL "P4-LEAF-CHANCE" USING WS-NAME8 W1 I2 WS-ARGB I3
     MOVE "yellow poplar emits its own particle (45)" TO WS-NAME
     MOVE 45 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I2
     PERFORM ASSERT-NUMBER
     MOVE "spruce_leaves" TO WS-NAME8
     CALL "P4-LEAF-CHANCE" USING WS-NAME8 W1 I2 WS-ARGB I3
     MOVE "spruce leaves emit nothing" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I3
     PERFORM ASSERT-NUMBER
     MOVE "spruce leaves have no particle id" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I2
     PERFORM ASSERT-NUMBER
     MOVE 0.05 TO W2
     MOVE 0.1 TO W1
     MOVE 0 TO I2
     CALL "P4-LEAF-EMIT" USING W1 W2 I2 I3
     MOVE "draw below the chance and no full face emits" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I3
     PERFORM ASSERT-NUMBER
     MOVE 0.1 TO W2
     CALL "P4-LEAF-EMIT" USING W1 W2 I2 I3
     MOVE "draw equal to the chance stops (r < chance continues)" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I3
     PERFORM ASSERT-NUMBER
     MOVE 0.05 TO W2
     MOVE 1 TO I2
     CALL "P4-LEAF-EMIT" USING W1 W2 I2 I3
     MOVE "a full up face below stops" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I3
     PERFORM ASSERT-NUMBER
     MOVE 1 TO I2
     MOVE 4286627904 TO B1
     CALL "P4-LEAF-TINT-COLOR" USING I2 B1 WS-ARGB
     MOVE "a state with a tint source gives the in-world colour" TO WS-NAME
     MOVE 4286627904 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-ARGB
     PERFORM ASSERT-NUMBER
     MOVE 0 TO I2
     CALL "P4-LEAF-TINT-COLOR" USING I2 B1 WS-ARGB
     MOVE "a state without a tint source gives -1 (white)" TO WS-NAME
     MOVE -1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-ARGB
     PERFORM ASSERT-NUMBER
     STOP RUN.

 ASSERT-NUMBER.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-4§8 Item break particles: " FUNCTION TRIM(WS-NAME)
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "N" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 ASSERT-TEXT.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-4§8 Item break particles: " FUNCTION TRIM(WS-NAME)
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "T" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-PARTICLES-42-4-8.
