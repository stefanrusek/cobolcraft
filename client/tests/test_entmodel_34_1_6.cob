     CALL "EM6-COLOUR-MULTIPLY" USING WS-X WS-Y WS-Z
     MOVE "0x26FFFFFF times grey 0xFF808080 is 0x26808080" TO WS-NAME
     COMPUTE WS-E = 38 * 16777216 + 128 * 65536 + 128 * 256 + 128
     MOVE WS-Z TO WS-O
     PERFORM CHECK-NUM
     MOVE -1 TO WS-X
     CALL "EM6-COLOUR-MULTIPLY" USING WS-X WS-Y WS-Z
     MOVE "white times grey is grey (int -8355712)" TO WS-NAME
     MOVE -8355712 TO WS-E
     MOVE WS-Z TO WS-O
     PERFORM CHECK-NUM
*>   overlay texture: red rows 0-7, white rows 8-15 with the alpha of the column.
     MOVE 3 TO WS-ROW
     MOVE 9 TO WS-COL
     CALL "EM6-OVERLAY-TEX" USING WS-ROW WS-COL WS-Z
     MOVE "overlay red row is 0xB2FF0000" TO WS-NAME
     COMPUTE WS-E = 178 * 16777216 + 255 * 65536
     MOVE WS-Z TO WS-O
     PERFORM CHECK-NUM
     MOVE 8 TO WS-ROW
     MOVE 15 TO WS-COL
     CALL "EM6-OVERLAY-TEX" USING WS-ROW WS-COL WS-Z
     MOVE "overlay white row column 15 alpha 63" TO WS-NAME
     COMPUTE WS-E = 63 * 16777216 + 16777215
     MOVE WS-Z TO WS-O
     PERFORM CHECK-NUM
     MOVE 15 TO WS-ROW
     MOVE 0 TO WS-COL
     CALL "EM6-OVERLAY-TEX" USING WS-ROW WS-COL WS-Z
     MOVE "overlay white row column 0 alpha 255" TO WS-NAME
     COMPUTE WS-E = 255 * 16777216 + 16777215
     MOVE WS-Z TO WS-O
     PERFORM CHECK-NUM
*>   pipeline facts
     MOVE "entityCutout" TO WS-PNAME
     PERFORM CHECK-PIPE
     MOVE "entityCutoutCull" TO WS-PNAME
     PERFORM CHECK-PIPE
     MOVE "entityTranslucent" TO WS-PNAME
     PERFORM CHECK-PIPE
     MOVE "entityTranslucentCull" TO WS-PNAME
     PERFORM CHECK-PIPE
     MOVE "entity_cutout_z_offset" TO WS-PNAME
     PERFORM CHECK-PIPE
     MOVE "entity_cutout_dissolve" TO WS-PNAME
     PERFORM CHECK-PIPE
     MOVE "armorCutoutNoCull" TO WS-PNAME
     PERFORM CHECK-PIPE
     MOVE "eyes" TO WS-PNAME
     PERFORM CHECK-PIPE
     MOVE "energySwirl" TO WS-PNAME
     PERFORM CHECK-PIPE
     MOVE "entity_translucent_emissive" TO WS-PNAME
     PERFORM CHECK-PIPE
     MOVE "entityShadow" TO WS-PNAME
     PERFORM CHECK-PIPE
     MOVE "nothing" TO WS-PNAME
     CALL "EM6-PIPELINE" USING WS-PNAME WS-OUT
     MOVE "an unread pipeline reports unknown (-1)" TO WS-NAME
     MOVE -1 TO WS-E
     MOVE WS-OV(1) TO WS-O
     PERFORM CHECK-NUM
*>   6.8 culling box
     MOVE 0 TO WS-I(1) WS-I(2) WS-I(3)
     MOVE 1 TO WS-I(4)
     MOVE 2 TO WS-I(5)
     MOVE 1 TO WS-I(6)
     MOVE 0 TO WS-I(7) WS-I(8)
     MOVE 10 TO WS-I(9) WS-I(10) WS-I(11)
     CALL "EM6-CULL-BOX" USING WS-IN WS-OUT
     MOVE "cull box inflated by 0.5" TO WS-NAME
     MOVE -0.5 TO WS-EV(1)
     MOVE 2.5 TO WS-EV(5)
     MOVE 1.5 TO WS-EV(6)
     MOVE WS-EV(1) TO WS-E
     MOVE WS-OV(1) TO WS-O
     PERFORM CHECK-NUM-ONE
     MOVE WS-OV(5) TO WS-O
     MOVE WS-EV(5) TO WS-E
     PERFORM CHECK-NUM-ONE
     MOVE WS-OV(6) TO WS-O
     MOVE WS-EV(6) TO WS-E
     PERFORM CHECK-NUM-ONE
     MOVE 1 TO WS-I(7)
     CALL "EM6-CULL-BOX" USING WS-IN WS-OUT
     MOVE "dragon head inflates by a further 0.5" TO WS-NAME
     MOVE -1 TO WS-E
     MOVE WS-OV(1) TO WS-O
     PERFORM CHECK-NUM-ONE
     MOVE 3 TO WS-E
     MOVE WS-OV(5) TO WS-O
     PERFORM CHECK-NUM-ONE
     MOVE 1 TO WS-I(8)
     CALL "EM6-CULL-BOX" USING WS-IN WS-OUT
     MOVE "a NaN box becomes a 4-block cube around the position" TO WS-NAME
     MOVE 8 TO WS-E
     MOVE WS-OV(1) TO WS-O
     PERFORM CHECK-NUM-ONE
     MOVE 12 TO WS-E
     MOVE WS-OV(4) TO WS-O
