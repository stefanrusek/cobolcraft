     STOP RUN.

 CHECK-PIPE.
     CALL "EM6-PIPELINE" USING WS-PNAME WS-OUT
     MOVE SPACES TO WS-NAME
     STRING "pipeline " FUNCTION TRIM(WS-PNAME) DELIMITED BY SIZE INTO WS-NAME
*>   expectations: alpha cutout, per-face lighting, culling on, blend (0 none 1 translucent 2 additive), depth GEQ, depth write, no overlay, no
*>   lightmap, dissolve
     EVALUATE FUNCTION TRIM(WS-PNAME)
         WHEN "entityCutout"
             PERFORM SET-EXPECT-CUTOUT
         WHEN "entityCutoutCull"
             PERFORM SET-EXPECT-CUTOUT
             MOVE 0 TO WS-EV(2)
             MOVE 1 TO WS-EV(3)
         WHEN "entityTranslucent"
             PERFORM SET-EXPECT-CUTOUT
             MOVE 1 TO WS-EV(4)
         WHEN "entityTranslucentCull"
             PERFORM SET-EXPECT-CUTOUT
             MOVE 0 TO WS-EV(2)
             MOVE 1 TO WS-EV(3)
             MOVE 1 TO WS-EV(4)
         WHEN "entity_cutout_z_offset"
             PERFORM SET-EXPECT-CUTOUT
         WHEN "entity_cutout_dissolve"
             PERFORM SET-EXPECT-CUTOUT
             MOVE 1 TO WS-EV(9)
         WHEN "armorCutoutNoCull"
             PERFORM SET-EXPECT-CUTOUT
             MOVE 1 TO WS-EV(7)
         WHEN "eyes"
             PERFORM SET-EXPECT-CUTOUT
             MOVE 0 TO WS-EV(1) WS-EV(2) WS-EV(6)
             MOVE 1 TO WS-EV(3) WS-EV(4) WS-EV(5) WS-EV(8)
         WHEN "energySwirl"
             PERFORM SET-EXPECT-CUTOUT
             MOVE 0 TO WS-EV(1) WS-EV(2)
             MOVE 1 TO WS-EV(3)
             MOVE 2 TO WS-EV(4)
         WHEN "entity_translucent_emissive"
             PERFORM SET-EXPECT-CUTOUT
             MOVE 1 TO WS-EV(4) WS-EV(5) WS-EV(8)
             MOVE 0 TO WS-EV(6)
         WHEN OTHER
             PERFORM SET-EXPECT-CUTOUT
             MOVE 0 TO WS-EV(1) WS-EV(2)
             MOVE 1 TO WS-EV(3) WS-EV(4)
     END-EVALUATE
     MOVE 9 TO WS-NOUT
     PERFORM CHECK-OUT.

 SET-EXPECT-CUTOUT.
     MOVE 0.1 TO WS-EV(1)
     MOVE 1 TO WS-EV(2)
     MOVE 0 TO WS-EV(3) WS-EV(4) WS-EV(5) WS-EV(7) WS-EV(8) WS-EV(9)
     MOVE 1 TO WS-EV(6).

 CHECK-OUT.
     PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-NOUT
         MOVE WS-EV(WS-K) TO WS-E
         MOVE WS-OV(WS-K) TO WS-O
         MOVE WS-K TO WS-KD
         PERFORM CHECK-NUM-AT
     END-PERFORM.

 CHECK-NUM-AT.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US15 34-1§6 The entity renderer framework: " FUNCTION TRIM(WS-NAME) " [" WS-KD "]" DELIMITED BY SIZE INTO TL-CASE
     MOVE "N" TO TL-MODE
     COMPUTE TL-EXPECTED-N ROUNDED = WS-E * 1000
     COMPUTE TL-OBSERVED-N ROUNDED = WS-O * 1000
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 CHECK-NUM-ONE.
     PERFORM CHECK-NUM.

 CHECK-NUM.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US15 34-1§6 The entity renderer framework: " FUNCTION TRIM(WS-NAME) DELIMITED BY SIZE INTO TL-CASE
     MOVE "N" TO TL-MODE
     COMPUTE TL-EXPECTED-N ROUNDED = WS-E * 1000
     COMPUTE TL-OBSERVED-N ROUNDED = WS-O * 1000
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-ENTMODEL-34-1-6.
