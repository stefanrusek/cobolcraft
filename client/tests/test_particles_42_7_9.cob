     MOVE 6250335.0 TO WS-E
     MOVE WS-OV(1) TO WS-O
     PERFORM CHECK-NUM
     MOVE "creaking heart trail flag 0 draw 0.5 [2]" TO WS-NAME
     MOVE 30.0 TO WS-E
     MOVE WS-OV(2) TO WS-O
     PERFORM CHECK-NUM
     MOVE 1.0 TO WS-IV(1)
     MOVE 0.999 TO WS-IV(2)
     CALL "P7-HEART-TRAIL" USING WS-IN WS-OUT
     MOVE "creaking heart trail flag 1 draw 0.999 [1]" TO WS-NAME
     MOVE 16545810.0 TO WS-E
     MOVE WS-OV(1) TO WS-O
     PERFORM CHECK-NUM
     MOVE "creaking heart trail flag 1 draw 0.999 [2]" TO WS-NAME
     MOVE 49.0 TO WS-E
     MOVE WS-OV(2) TO WS-O
     PERFORM CHECK-NUM
     MOVE 70.0 TO WS-IV(1)
     MOVE 64.0 TO WS-IV(2)
     MOVE 40.0 TO WS-IV(3)
     MOVE 0.0 TO WS-IV(4)
     CALL "P7-GEYSER" USING WS-IN WS-OUT
     MOVE "geyser source y 70 block y 64 time 40 eruption 0 (emit, water blocks) [1]" TO WS-NAME
     MOVE 1.0 TO WS-E
     MOVE WS-OV(1) TO WS-O
     PERFORM CHECK-NUM
     MOVE "geyser source y 70 block y 64 time 40 eruption 0 (emit, water blocks) [2]" TO WS-NAME
     MOVE 5.0 TO WS-E
     MOVE WS-OV(2) TO WS-O
     PERFORM CHECK-NUM
     MOVE 70.0 TO WS-IV(1)
     MOVE 64.0 TO WS-IV(2)
     MOVE 41.0 TO WS-IV(3)
     MOVE 0.0 TO WS-IV(4)
     CALL "P7-GEYSER" USING WS-IN WS-OUT
     MOVE "geyser source y 70 block y 64 time 41 eruption 0 (emit, water blocks) [1]" TO WS-NAME
     MOVE 0.0 TO WS-E
     MOVE WS-OV(1) TO WS-O
     PERFORM CHECK-NUM
     MOVE "geyser source y 70 block y 64 time 41 eruption 0 (emit, water blocks) [2]" TO WS-NAME
     MOVE 5.0 TO WS-E
     MOVE WS-OV(2) TO WS-O
     PERFORM CHECK-NUM
     MOVE 70.5 TO WS-IV(1)
     MOVE 64.0 TO WS-IV(2)
     MOVE 100.0 TO WS-IV(3)
     MOVE 20.0 TO WS-IV(4)
     CALL "P7-GEYSER" USING WS-IN WS-OUT
     MOVE "geyser source y 70.5 block y 64 time 100 eruption 20 (emit, water blocks) [1]" TO WS-NAME
     MOVE 1.0 TO WS-E
     MOVE WS-OV(1) TO WS-O
     PERFORM CHECK-NUM
     MOVE "geyser source y 70.5 block y 64 time 100 eruption 20 (emit, water blocks) [2]" TO WS-NAME
     MOVE 5.5 TO WS-E
     MOVE WS-OV(2) TO WS-O
     PERFORM CHECK-NUM
     MOVE 65.0 TO WS-IV(1)
     MOVE 64.0 TO WS-IV(2)
     MOVE 60.0 TO WS-IV(3)
     MOVE 0.0 TO WS-IV(4)
     CALL "P7-GEYSER" USING WS-IN WS-OUT
     MOVE "geyser source y 65 block y 64 time 60 eruption 0 (emit, water blocks) [1]" TO WS-NAME
     MOVE 1.0 TO WS-E
     MOVE WS-OV(1) TO WS-O
     PERFORM CHECK-NUM
     MOVE "geyser source y 65 block y 64 time 60 eruption 0 (emit, water blocks) [2]" TO WS-NAME
     MOVE 0.0 TO WS-E
     MOVE WS-OV(2) TO WS-O
     PERFORM CHECK-NUM
 STOP RUN.

 RUN-CASE.
     MOVE WS-INT TO WS-TEXT
     PERFORM PARSE-LIST
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 16
         MOVE 0 TO WS-IV(WS-I)
     END-PERFORM
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-COUNT
         MOVE WS-NUM(WS-I) TO WS-IV(WS-I)
     END-PERFORM
     MOVE WS-DRT TO WS-TEXT
     PERFORM PARSE-LIST
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 2048
         MOVE 0.5 TO EM-DRAW(WS-I)
     END-PERFORM
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-COUNT
         MOVE WS-NUM(WS-I) TO EM-DRAW(WS-I)
     END-PERFORM
     MOVE 0 TO EM-COUNT EM-CUR EM-SOUND-COUNT
     CALL "P7-BLOCK" USING WS-CLASS WS-IN P6-EMITS
     PERFORM RENDER
     MOVE FUNCTION LENGTH(FUNCTION TRIM(WS-OBS)) TO WS-LEN
     IF WS-LEN > 1000
         MOVE SPACES TO WS-OBS2
         MOVE WS-OBS(1:480) TO WS-OBS2(1:480)
         MOVE "..." TO WS-OBS2(481:3)
         COMPUTE WS-START = WS-LEN - 479
         MOVE WS-OBS(WS-START:480) TO WS-OBS2(484:480)
         MOVE WS-OBS2 TO WS-OBS
     END-IF
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-7§9 Block-entity and environment emitters: " FUNCTION TRIM(WS-NAME) DELIMITED BY SIZE INTO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE WS-EXP TO TL-EXPECTED
     MOVE WS-OBS TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 CHECK-NUM.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-7§9 Block-entity and environment emitters: " FUNCTION TRIM(WS-NAME) DELIMITED BY SIZE INTO TL-CASE
     MOVE "N" TO TL-MODE
     IF FUNCTION ABS(WS-O - WS-E) <= 0.00002
         MOVE WS-E TO WS-O
     END-IF
     COMPUTE TL-EXPECTED-N ROUNDED = WS-E * 100000
     COMPUTE TL-OBSERVED-N ROUNDED = WS-O * 100000
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 CHECK-TEXT.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-7§9 Block-entity and environment emitters: " FUNCTION TRIM(WS-NAME) DELIMITED BY SIZE INTO TL-CASE
     MOVE "T" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 PARSE-LIST.
     MOVE 0 TO WS-COUNT
     MOVE 1 TO WS-PTR
     PERFORM UNTIL WS-PTR > 8000 OR WS-TEXT(WS-PTR:) = SPACES
         MOVE SPACES TO WS-TOK
         UNSTRING WS-TEXT DELIMITED BY ALL SPACE INTO WS-TOK WITH POINTER WS-PTR
         IF WS-TOK NOT = SPACES
             ADD 1 TO WS-COUNT
             COMPUTE WS-NUM(WS-COUNT) = FUNCTION NUMVAL(WS-TOK)
         END-IF
     END-PERFORM.

 RENDER.
     MOVE SPACES TO WS-OBS
     MOVE 1 TO WS-PTR2
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > EM-COUNT
         IF WS-I > 1
             STRING " | " DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2
         END-IF
         STRING FUNCTION TRIM(EM-NAME(WS-I)) " " DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2
         MOVE EM-X(WS-I) TO WS-V
         PERFORM ADD-NUMBER
         MOVE EM-Y(WS-I) TO WS-V
         PERFORM ADD-NUMBER
         MOVE EM-Z(WS-I) TO WS-V
         PERFORM ADD-NUMBER
         MOVE EM-VX(WS-I) TO WS-V
         PERFORM ADD-NUMBER
         MOVE EM-VY(WS-I) TO WS-V
         PERFORM ADD-NUMBER
         MOVE EM-VZ(WS-I) TO WS-V
         PERFORM ADD-LAST-NUMBER
         IF EM-COLOR(WS-I) NOT = 0
             MOVE EM-COLOR(WS-I) TO WS-EDC
             COMPUTE WS-EDS ROUNDED = EM-SCALE(WS-I)
             STRING " c=" FUNCTION TRIM(WS-EDC) " s=" WS-EDS DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2
         END-IF
         IF EM-COLOR(WS-I) = 0 AND EM-SCALE(WS-I) NOT = 0
             COMPUTE WS-EDR ROUNDED = EM-SCALE(WS-I)
             STRING " r=" WS-EDR DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2
         END-IF
         IF EM-STATE(WS-I) NOT = 0
             MOVE EM-STATE(WS-I) TO WS-EDC
             STRING " st=" FUNCTION TRIM(WS-EDC) DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2
         END-IF
     END-PERFORM
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > EM-SOUND-COUNT
         STRING " # " FUNCTION TRIM(EM-SOUND(WS-I)) DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2
     END-PERFORM
     MOVE EM-CUR TO WS-EDC
     STRING " (" FUNCTION TRIM(WS-EDC) ")" DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2.

 ADD-NUMBER.
     PERFORM ADD-LAST-NUMBER
     STRING " " DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2.

 ADD-LAST-NUMBER.
     COMPUTE WS-ED ROUNDED = WS-V
     STRING FUNCTION TRIM(WS-ED) DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2.
 END PROGRAM TEST-PARTICLES-42-7-9.
