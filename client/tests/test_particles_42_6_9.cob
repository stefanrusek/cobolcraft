*> Acceptance test of docs/protocol/42-particles-6-emitters-blocks.md section 9: the emitter rules.
*> Expected texts are computed independently by a script from the document's formulas; each case injects the draws in the documented order and
*> compares the emission list (5 decimals), the sounds and the count of draws consumed.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-PARTICLES-42-6-9.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CLP6EM.
 COPY TESTLIB.
 01 WS-NAME                PIC X(160).
 01 WS-CLASS               PIC X(24).
 01 WS-PT                  PIC X(80).
 01 WS-PRT                 PIC X(80).
 01 WS-DRT                 PIC X(4000).
 01 WS-EXP                 PIC X(4000).
 01 WS-OBS                 PIC X(12000).
 01 WS-OBS2                PIC X(12000).
 01 WS-LEN                 BINARY-LONG.
 01 WS-START               BINARY-LONG.
 01 WS-BLOCK.
    05 WS-BP               BINARY-LONG OCCURS 3 TIMES.
 01 WS-PROPS.
    05 WS-PR               BINARY-LONG OCCURS 12 TIMES.
 01 WS-LIST.
    05 WS-NUM              FLOAT-LONG OCCURS 2100 TIMES.
 01 WS-COUNT               BINARY-LONG.
 01 WS-TEXT                PIC X(4000).
 01 WS-TOK                 PIC X(40).
 01 WS-PTR                 BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-PTR2                BINARY-LONG.
 01 WS-ED                  PIC -(5)9.99999.
 01 WS-EDC                 PIC -(10)9.
 01 WS-EDS                 PIC 9.99.
 01 WS-EDR                 PIC 9.99999.
 01 WS-V                   FLOAT-LONG.
 COPY CLP6PK.
 01 WS-FALL                FLOAT-LONG.
 01 WS-SAFE                FLOAT-LONG.
 01 WS-EPA.
    05 WS-EP               FLOAT-LONG OCCURS 3 TIMES.
 01 WS-EBA.
    05 WS-EB               BINARY-LONG OCCURS 2 TIMES.
 01 WS-SBA.
    05 WS-SB               BINARY-LONG OCCURS 2 TIMES.
 01 WS-STATE               BINARY-LONG.
 01 WS-SEND                BINARY-LONG.
 01 WS-EX                  FLOAT-LONG.
 01 WS-EZ                  FLOAT-LONG.
 01 WS-PKT                 PIC X(300).
 01 WS-ED2                 PIC -(5)9.99999.
 01 WS-EDN                 PIC -(9)9.
 01 WS-ACT                BINARY-LONG.
 01 WS-COLOR              BINARY-DOUBLE.
 01 WS-DUR                BINARY-LONG.
 PROCEDURE DIVISION.
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 2048
         MOVE 0.5 TO EM-DRAW(WS-I)
     END-PERFORM
     MOVE "flame" TO PK-NAME
     MOVE 1 TO PK-X
     MOVE 2 TO PK-Y
     MOVE 3 TO PK-Z
     MOVE 0 TO PK-COUNT
     MOVE 0.5 TO PK-DIST(1)
     MOVE 0.25 TO PK-DIST(2)
     MOVE 0.1 TO PK-DIST(3)
     MOVE 2 TO PK-SPEED(1)
     MOVE 4 TO PK-SPEED(2)
     MOVE 10 TO PK-SPEED(3)
     MOVE 0 TO PK-MODE
     MOVE 0 TO PK-STATE
     MOVE 0 TO PK-COLOR
     MOVE 0 TO EM-COUNT EM-CUR EM-SOUND-COUNT
     CALL "P6-HANDLE-PACKET" USING P6-PACKET P6-EMITS
     PERFORM RENDER
     MOVE "handle count 0 uses speed times distance" TO WS-NAME
     MOVE "flame 1.00000 2.00000 3.00000 1.00000 1.00000 1.00000 (0)" TO WS-EXP
     PERFORM ASSERT-RENDER
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 2048
         MOVE 0.5 TO EM-DRAW(WS-I)
     END-PERFORM
     MOVE 0.1 TO EM-DRAW(1)
     MOVE 0.2 TO EM-DRAW(2)
     MOVE 0.3 TO EM-DRAW(3)
     MOVE 0.4 TO EM-DRAW(4)
     MOVE 0.5 TO EM-DRAW(5)
     MOVE 0.6 TO EM-DRAW(6)
     MOVE "smoke" TO PK-NAME
     MOVE 1 TO PK-X
     MOVE 2 TO PK-Y
     MOVE 3 TO PK-Z
     MOVE 2 TO PK-COUNT
     MOVE 1 TO PK-DIST(1)
     MOVE 2 TO PK-DIST(2)
     MOVE 3 TO PK-DIST(3)
     MOVE 0.1 TO PK-SPEED(1)
     MOVE 0.2 TO PK-SPEED(2)
     MOVE 0.3 TO PK-SPEED(3)
     MOVE 1 TO PK-MODE
     MOVE 0 TO PK-STATE
     MOVE 0 TO PK-COLOR
     MOVE 0 TO EM-COUNT EM-CUR EM-SOUND-COUNT
     CALL "P6-HANDLE-PACKET" USING P6-PACKET P6-EMITS
     PERFORM RENDER
     MOVE "handle alternative: offsets by distance, velocity is the speed" TO WS-NAME
     MOVE "smoke 1.10000 2.40000 3.90000 0.10000 0.20000 0.30000 | smoke 1.40000 3.00000 4.80000 0.10000 0.20000 0.30000 (6)" TO WS-EXP
     PERFORM ASSERT-RENDER
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 2048
         MOVE 0.5 TO EM-DRAW(WS-I)
     END-PERFORM
     MOVE 0.1 TO EM-DRAW(1)
     MOVE 0.2 TO EM-DRAW(2)
     MOVE 0.3 TO EM-DRAW(3)
     MOVE 0.5 TO EM-DRAW(4)
     MOVE 0.25 TO EM-DRAW(5)
     MOVE 0.75 TO EM-DRAW(6)
     MOVE 0.4 TO EM-DRAW(7)
     MOVE 0.5 TO EM-DRAW(8)
     MOVE 0.6 TO EM-DRAW(9)
     MOVE 0.1 TO EM-DRAW(10)
     MOVE 0.2 TO EM-DRAW(11)
     MOVE 0.3 TO EM-DRAW(12)
     MOVE "smoke" TO PK-NAME
     MOVE 1 TO PK-X
     MOVE 2 TO PK-Y
     MOVE 3 TO PK-Z
     MOVE 2 TO PK-COUNT
     MOVE 1 TO PK-DIST(1)
     MOVE 2 TO PK-DIST(2)
     MOVE 3 TO PK-DIST(3)
     MOVE 0.1 TO PK-SPEED(1)
     MOVE 0.2 TO PK-SPEED(2)
     MOVE 0.3 TO PK-SPEED(3)
     MOVE 2 TO PK-MODE
     MOVE 0 TO PK-STATE
     MOVE 0 TO PK-COLOR
     MOVE 0 TO EM-COUNT EM-CUR EM-SOUND-COUNT
     CALL "P6-HANDLE-PACKET" USING P6-PACKET P6-EMITS
     PERFORM RENDER
     MOVE "handle alternative with speed: velocity times an extra draw" TO WS-NAME
     MOVE "smoke 1.10000 2.40000 3.90000 0.05000 0.05000 0.22500 | smoke 1.40000 3.00000 4.80000 0.01000 0.04000 0.09000 (12)" TO WS-EXP
     PERFORM ASSERT-RENDER
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 2048
         MOVE 0.5 TO EM-DRAW(WS-I)
     END-PERFORM
     MOVE 1.0 TO EM-DRAW(1)
     MOVE -2.0 TO EM-DRAW(2)
     MOVE 0.5 TO EM-DRAW(3)
     MOVE 0.1 TO EM-DRAW(4)
     MOVE 0.2 TO EM-DRAW(5)
     MOVE 0.3 TO EM-DRAW(6)
     MOVE 0.5 TO EM-DRAW(7)
     MOVE 0.5 TO EM-DRAW(8)
     MOVE 0.5 TO EM-DRAW(9)
     MOVE -1.0 TO EM-DRAW(10)
     MOVE -1.0 TO EM-DRAW(11)
     MOVE -1.0 TO EM-DRAW(12)
     MOVE "smoke" TO PK-NAME
     MOVE 1 TO PK-X
     MOVE 2 TO PK-Y
     MOVE 3 TO PK-Z
     MOVE 2 TO PK-COUNT
     MOVE 1 TO PK-DIST(1)
     MOVE 2 TO PK-DIST(2)
     MOVE 3 TO PK-DIST(3)
     MOVE 0.1 TO PK-SPEED(1)
     MOVE 0.2 TO PK-SPEED(2)
     MOVE 0.3 TO PK-SPEED(3)
     MOVE 0 TO PK-MODE
     MOVE 0 TO PK-STATE
     MOVE 0 TO PK-COLOR
     MOVE 0 TO EM-COUNT EM-CUR EM-SOUND-COUNT
     CALL "P6-HANDLE-PACKET" USING P6-PACKET P6-EMITS
     PERFORM RENDER
     MOVE "handle default: Gaussian offsets and velocities" TO WS-NAME
     MOVE "smoke 2.00000 -2.00000 4.50000 0.01000 0.04000 0.09000 | smoke 1.50000 3.00000 4.50000 -0.10000 -0.20000 -0.30000 (12)" TO WS-EXP
     PERFORM ASSERT-RENDER
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 2048
         MOVE 0.5 TO EM-DRAW(WS-I)
     END-PERFORM
     MOVE 0.1 TO EM-DRAW(1)
     MOVE 0.2 TO EM-DRAW(2)
     MOVE 0.3 TO EM-DRAW(3)
     MOVE 0.4 TO EM-DRAW(4)
     MOVE 0.5 TO EM-DRAW(5)
     MOVE 0.6 TO EM-DRAW(6)
     MOVE "block" TO PK-NAME
     MOVE 1 TO PK-X
     MOVE 2 TO PK-Y
     MOVE 3 TO PK-Z
     MOVE 1 TO PK-COUNT
     MOVE 0 TO PK-DIST(1)
     MOVE 0 TO PK-DIST(2)
     MOVE 0 TO PK-DIST(3)
     MOVE 0 TO PK-SPEED(1)
     MOVE 0 TO PK-SPEED(2)
     MOVE 0 TO PK-SPEED(3)
     MOVE 0 TO PK-MODE
     MOVE 9 TO PK-STATE
     MOVE 16545810 TO PK-COLOR
     MOVE 0 TO EM-COUNT EM-CUR EM-SOUND-COUNT
     CALL "P6-HANDLE-PACKET" USING P6-PACKET P6-EMITS
     PERFORM RENDER
     MOVE "handle block state and colour options are carried" TO WS-NAME
     MOVE "block 1.00000 2.00000 3.00000 0.00000 0.00000 0.00000 c=16545810 s=0.00 st=9 (6)" TO WS-EXP
     PERFORM ASSERT-RENDER
     MOVE 10 TO WS-BP(1)
     MOVE 64 TO WS-BP(2)
     MOVE -3 TO WS-BP(3)
     CALL "P6-CATALYST-PACKET" USING WS-BLOCK P6-PACKET
     PERFORM RENDER-PACKET
     MOVE "sculk catalyst bloom packet" TO WS-NAME
     MOVE "sculk_soul 10.50000 65.15000 -2.50000 n=2 d=0.20000,0.00000,0.20000 v=0.00000,0.00000,0.00000 m=0 st=0" TO WS-EXP
     PERFORM ASSERT-PACKET
     MOVE 0 TO EM-CUR
     MOVE 0.5 TO EM-DRAW(1)
     MOVE 1 TO WS-ACT
     CALL "P6-CREAKING-OPTIONS" USING P6-EMITS WS-ACT WS-COLOR WS-DUR
     MOVE "creaking heart option (active 1, draw 0.5): colour" TO WS-NAME
     MOVE 16545810 TO TL-EXPECTED-N
     MOVE WS-COLOR TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     MOVE "creaking heart option (active 1, draw 0.5): duration" TO WS-NAME
     MOVE 30 TO TL-EXPECTED-N
     MOVE WS-DUR TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     MOVE 0 TO EM-CUR
     MOVE 0.99 TO EM-DRAW(1)
     MOVE 0 TO WS-ACT
     CALL "P6-CREAKING-OPTIONS" USING P6-EMITS WS-ACT WS-COLOR WS-DUR
     MOVE "creaking heart option (active 0, draw 0.99): colour" TO WS-NAME
     MOVE 6250335 TO TL-EXPECTED-N
     MOVE WS-COLOR TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     MOVE "creaking heart option (active 0, draw 0.99): duration" TO WS-NAME
     MOVE 49 TO TL-EXPECTED-N
     MOVE WS-DUR TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     MOVE 0 TO EM-CUR
     MOVE 0 TO EM-DRAW(1)
     MOVE 1 TO WS-ACT
     CALL "P6-CREAKING-OPTIONS" USING P6-EMITS WS-ACT WS-COLOR WS-DUR
     MOVE "creaking heart option (active 1, draw 0): colour" TO WS-NAME
     MOVE 16545810 TO TL-EXPECTED-N
     MOVE WS-COLOR TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     MOVE "creaking heart option (active 1, draw 0): duration" TO WS-NAME
     MOVE 10 TO TL-EXPECTED-N
     MOVE WS-DUR TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     MOVE 0 TO EM-CUR
     MOVE 0.5 TO EM-DRAW(1)
     CALL "P6-EYEBLOSSOM-DURATION" USING P6-EMITS WS-DUR
     MOVE "eyeblossom transform duration (draw 0.5)" TO WS-NAME
     MOVE 20 TO TL-EXPECTED-N
     MOVE WS-DUR TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     MOVE 0 TO EM-CUR
     MOVE 0.25 TO EM-DRAW(1)
     CALL "P6-EYEBLOSSOM-DURATION" USING P6-EMITS WS-DUR
     MOVE "eyeblossom transform duration (draw 0.25)" TO WS-NAME
     MOVE 15 TO TL-EXPECTED-N
     MOVE WS-DUR TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     MOVE 0 TO EM-CUR
     MOVE 0.99 TO EM-DRAW(1)
     CALL "P6-EYEBLOSSOM-DURATION" USING P6-EMITS WS-DUR
     MOVE "eyeblossom transform duration (draw 0.99)" TO WS-NAME
     MOVE 29 TO TL-EXPECTED-N
     MOVE WS-DUR TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     STOP RUN.

 RUN-CASE.
     MOVE WS-PT TO WS-TEXT
     PERFORM PARSE-LIST
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 3
         MOVE WS-NUM(WS-I) TO WS-BP(WS-I)
     END-PERFORM
     MOVE WS-PRT TO WS-TEXT
     PERFORM PARSE-LIST
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 12
         MOVE 0 TO WS-PR(WS-I)
     END-PERFORM
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-COUNT
         MOVE WS-NUM(WS-I) TO WS-PR(WS-I)
     END-PERFORM
     MOVE WS-DRT TO WS-TEXT
     PERFORM PARSE-LIST
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 2048
         MOVE 0.5 TO EM-DRAW(WS-I)
     END-PERFORM
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-COUNT
         MOVE WS-NUM(WS-I) TO EM-DRAW(WS-I)
     END-PERFORM
     CALL "P6-BLOCK-TICK" USING WS-CLASS WS-BLOCK WS-PROPS P6-EMITS
     PERFORM RENDER
     MOVE FUNCTION LENGTH(FUNCTION TRIM(WS-OBS)) TO WS-LEN
     IF WS-LEN > 1000
         MOVE WS-OBS(1:480) TO WS-OBS2(1:480)
         MOVE "..." TO WS-OBS2(481:3)
         COMPUTE WS-START = WS-LEN - 479
         MOVE WS-OBS(WS-START:480) TO WS-OBS2(484:480)
         MOVE WS-OBS2 TO WS-OBS
     END-IF
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-6§9 Server-sourced particle semantics: " FUNCTION TRIM(WS-NAME)
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE WS-EXP TO TL-EXPECTED
     MOVE WS-OBS TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 RENDER-PACKET.
     MOVE SPACES TO WS-PKT
     MOVE 1 TO WS-PTR2
     STRING FUNCTION TRIM(PK-NAME) " " DELIMITED BY SIZE INTO WS-PKT WITH POINTER WS-PTR2
     MOVE PK-X TO WS-V
     PERFORM PK-NUMBER
     MOVE PK-Y TO WS-V
     PERFORM PK-NUMBER
     MOVE PK-Z TO WS-V
     COMPUTE WS-ED2 ROUNDED = WS-V
     STRING FUNCTION TRIM(WS-ED2) DELIMITED BY SIZE INTO WS-PKT WITH POINTER WS-PTR2
     MOVE PK-COUNT TO WS-EDN
     STRING " n=" FUNCTION TRIM(WS-EDN) " d=" DELIMITED BY SIZE INTO WS-PKT WITH POINTER WS-PTR2
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 3
         COMPUTE WS-ED2 ROUNDED = PK-DIST(WS-I)
         STRING FUNCTION TRIM(WS-ED2) DELIMITED BY SIZE INTO WS-PKT WITH POINTER WS-PTR2
         IF WS-I < 3
             STRING "," DELIMITED BY SIZE INTO WS-PKT WITH POINTER WS-PTR2
         END-IF
     END-PERFORM
     STRING " v=" DELIMITED BY SIZE INTO WS-PKT WITH POINTER WS-PTR2
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 3
         COMPUTE WS-ED2 ROUNDED = PK-SPEED(WS-I)
         STRING FUNCTION TRIM(WS-ED2) DELIMITED BY SIZE INTO WS-PKT WITH POINTER WS-PTR2
         IF WS-I < 3
             STRING "," DELIMITED BY SIZE INTO WS-PKT WITH POINTER WS-PTR2
         END-IF
     END-PERFORM
     MOVE PK-MODE TO WS-EDN
     STRING " m=" FUNCTION TRIM(WS-EDN) DELIMITED BY SIZE INTO WS-PKT WITH POINTER WS-PTR2
     MOVE PK-STATE TO WS-EDN
     STRING " st=" FUNCTION TRIM(WS-EDN) DELIMITED BY SIZE INTO WS-PKT WITH POINTER WS-PTR2.

 PK-NUMBER.
     COMPUTE WS-ED2 ROUNDED = WS-V
     STRING FUNCTION TRIM(WS-ED2) " " DELIMITED BY SIZE INTO WS-PKT WITH POINTER WS-PTR2.

 ASSERT-PACKET.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-6§9 Server-sourced particle semantics: " FUNCTION TRIM(WS-NAME)
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE WS-EXP TO TL-EXPECTED
     MOVE WS-PKT TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.


 ASSERT-RENDER.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-6§9 Server-sourced particle semantics: " FUNCTION TRIM(WS-NAME)
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE WS-EXP TO TL-EXPECTED
     MOVE WS-OBS TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 ASSERT-NUMBER.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-6§9 Server-sourced particle semantics: " FUNCTION TRIM(WS-NAME)
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "N" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 PARSE-LIST.
     MOVE 0 TO WS-COUNT
     MOVE 1 TO WS-PTR
     PERFORM UNTIL WS-PTR > 4000 OR WS-TEXT(WS-PTR:) = SPACES
         MOVE SPACES TO WS-TOK
         UNSTRING WS-TEXT DELIMITED BY ALL SPACE INTO WS-TOK WITH POINTER WS-PTR
         IF WS-TOK NOT = SPACES
             ADD 1 TO WS-COUNT
             COMPUTE WS-NUM(WS-COUNT) = FUNCTION NUMVAL(WS-TOK)
         END-IF
     END-PERFORM.

 RENDER.
     MOVE SPACES TO WS-OBS
     MOVE 1 TO WS-PTR2
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > EM-COUNT
         IF WS-I > 1
             STRING " | " DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2
         END-IF
         STRING FUNCTION TRIM(EM-NAME(WS-I)) " " DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2
         MOVE EM-X(WS-I) TO WS-V
         PERFORM ADD-NUMBER
         MOVE EM-Y(WS-I) TO WS-V
         PERFORM ADD-NUMBER
         MOVE EM-Z(WS-I) TO WS-V
         PERFORM ADD-NUMBER
         MOVE EM-VX(WS-I) TO WS-V
         PERFORM ADD-NUMBER
         MOVE EM-VY(WS-I) TO WS-V
         PERFORM ADD-NUMBER
         MOVE EM-VZ(WS-I) TO WS-V
         PERFORM ADD-LAST-NUMBER
         IF EM-COLOR(WS-I) NOT = 0
             MOVE EM-COLOR(WS-I) TO WS-EDC
             COMPUTE WS-EDS ROUNDED = EM-SCALE(WS-I)
             STRING " c=" FUNCTION TRIM(WS-EDC) " s=" WS-EDS DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2
         END-IF
         IF EM-COLOR(WS-I) = 0 AND EM-SCALE(WS-I) NOT = 0
             COMPUTE WS-EDR ROUNDED = EM-SCALE(WS-I)
             STRING " r=" WS-EDR DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2
         END-IF
         IF EM-STATE(WS-I) NOT = 0
             MOVE EM-STATE(WS-I) TO WS-EDC
             STRING " st=" FUNCTION TRIM(WS-EDC) DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2
         END-IF
     END-PERFORM
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > EM-SOUND-COUNT
         STRING " # " FUNCTION TRIM(EM-SOUND(WS-I)) DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2
     END-PERFORM
     MOVE EM-CUR TO WS-EDC
     STRING " (" FUNCTION TRIM(WS-EDC) ")" DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2.

 ADD-NUMBER.
     PERFORM ADD-LAST-NUMBER
     STRING " " DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2.

 ADD-LAST-NUMBER.
     COMPUTE WS-ED ROUNDED = WS-V
     STRING FUNCTION TRIM(WS-ED) DELIMITED BY SIZE INTO WS-OBS WITH POINTER WS-PTR2.
 END PROGRAM TEST-PARTICLES-42-6-9.
