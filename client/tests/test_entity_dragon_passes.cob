 01 WS-HEAD0               BINARY-LONG.
 01 WS-TM0                 FLOAT-LONG.
 01 WS-EYE-TABLE.
    05 WS-EYE              FLOAT-LONG OCCURS 3 TIMES.
 PROCEDURE DIVISION.
     CALL "CL-INIT" USING CLIENT-STATE
     MOVE 0 TO PK-COUNT
     CALL "ENTITY-ATLAS-BUILD" USING CLIENT-STATE
     MOVE 256 TO PL-HEIGHT
     MOVE 0 TO SK-U
     MOVE 10 TO WS-EYE(1) WS-EYE(3)
     MOVE 64 TO WS-EYE(2)
     MOVE 1 TO CT-OPEN
     MOVE CT-TYPE-STANDARD TO CT-SET-TYPE
*>   The eyes pass: the dragon alone; the second half of its vertices is the eyes layer, full bright, a hair larger.
     CALL "ENTITIES-CLEAR" USING CLIENT-STATE
     MOVE "ender_dragon" TO WS-KEY
     MOVE 5 TO WS-ID
     PERFORM SPAWN
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     MOVE "acceptance dragon two passes: the vertex count is even and not 0" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF RL-EN-COUNT > 0 AND FUNCTION MOD(RL-EN-COUNT, 2) = 0
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     PERFORM CHECK-N
     COMPUTE WS-HALF = RL-EN-COUNT / 2
     MOVE 0 TO WS-MAXD
     MOVE 0 TO WS-MIND
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-HALF
         COMPUTE WS-DIFF = FUNCTION ABS(RL-EN-B(WS-J + WS-HALF) - 1)
         IF WS-DIFF > WS-MAXD
             MOVE WS-DIFF TO WS-MAXD
         END-IF
         COMPUTE WS-DIFF = FUNCTION ABS(RL-EN-B(WS-J) - 1)
         IF WS-DIFF > WS-MIND
             MOVE WS-DIFF TO WS-MIND
         END-IF
     END-PERFORM
     MOVE "acceptance dragon eyes pass is full bright" TO TL-CASE
     MOVE WS-MAXD TO WS-DIFF
     PERFORM CHECK-SMALL
     MOVE "acceptance dragon body pass is not full bright" TO TL-CASE
     MOVE WS-MIND TO WS-DIFF
     PERFORM CHECK-OTHER
     MOVE 0 TO WS-MAXD
     MOVE 0 TO WS-MIND
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-HALF
         COMPUTE WS-DIFF = FUNCTION ABS(RL-EN-X(WS-J + WS-HALF) - RL-EN-X(WS-J)) + FUNCTION ABS(RL-EN-Y(WS-J + WS-HALF) - RL-EN-Y(WS-J))
             + FUNCTION ABS(RL-EN-Z(WS-J + WS-HALF) - RL-EN-Z(WS-J))
         IF WS-DIFF > WS-MAXD
             MOVE WS-DIFF TO WS-MAXD
         END-IF
         IF WS-DIFF > 0.00001
             MOVE 1 TO WS-MIND
         END-IF
     END-PERFORM
     MOVE "acceptance dragon eyes pass lies within a hair of the body" TO TL-CASE
     COMPUTE WS-DIFF = WS-MAXD - 0.5
     IF WS-DIFF < 0
         MOVE 0 TO WS-DIFF
     END-IF
     PERFORM CHECK-SMALL
     MOVE "acceptance dragon eyes pass is not the same vertices" TO TL-CASE
     MOVE WS-MIND TO TL-OBSERVED-N
     MOVE 1 TO TL-EXPECTED-N
     PERFORM CHECK-N
*>   Health (entry 9, FLOAT) and the dying dragon.
     MOVE 5 TO WS-ID
     MOVE 9 TO WS-INDEX
     MOVE 3 TO WS-SERIAL
     MOVE 150 TO WS-HP
     MOVE 0 TO WS-PX WS-PY WS-PZ WS-PRESENT
     CALL "ENTITY-DRAGON-SET" USING CLIENT-STATE WS-ID WS-INDEX WS-SERIAL WS-HP WS-PX WS-PY WS-PZ WS-PRESENT
     MOVE "acceptance dragon entry 9 keeps the health" TO TL-CASE
     MOVE EN-HP(1) TO TL-OBSERVED-N
     MOVE 150 TO TL-EXPECTED-N
     PERFORM CHECK-N
     CALL "ENTITIES-ANIM-TICK" USING CLIENT-STATE
     MOVE "acceptance dragon alive: no death time" TO TL-CASE
     MOVE EN-DD(1) TO TL-OBSERVED-N
     MOVE 0 TO TL-EXPECTED-N
     PERFORM CHECK-N
     MOVE EN-DR-HEAD TO WS-HEAD0
     MOVE EN-TM(1) TO WS-TM0
     MOVE 0 TO WS-HP
     CALL "ENTITY-DRAGON-SET" USING CLIENT-STATE WS-ID WS-INDEX WS-SERIAL WS-HP WS-PX WS-PY WS-PZ WS-PRESENT
     PERFORM 3 TIMES
         CALL "ENTITIES-ANIM-TICK" USING CLIENT-STATE
     END-PERFORM
     MOVE "acceptance dragon dying: the death time counts up" TO TL-CASE
     MOVE EN-DD(1) TO TL-OBSERVED-N
     MOVE 3 TO TL-EXPECTED-N
     PERFORM CHECK-N
     MOVE "acceptance dragon dying: the flight history stops" TO TL-CASE
     COMPUTE TL-OBSERVED-N = EN-DR-HEAD - WS-HEAD0
     MOVE 0 TO TL-EXPECTED-N
     PERFORM CHECK-N
     MOVE "acceptance dragon dying: the flap time stops" TO TL-CASE
     COMPUTE WS-DIFF = EN-TM(1) - WS-TM0
     PERFORM CHECK-SMALL
     MOVE 199 TO EN-DD(1)
     PERFORM 3 TIMES
         CALL "ENTITIES-ANIM-TICK" USING CLIENT-STATE
     END-PERFORM
     MOVE "acceptance dragon dying: the death time stops at 200" TO TL-CASE
     MOVE EN-DD(1) TO TL-OBSERVED-N
     MOVE 200 TO TL-EXPECTED-N
     PERFORM CHECK-N
*>   The nearest healing crystal: crystals 6 (20 away), 7 (5 away), 8 (90 away, outside the box inflated by 32).
     CALL "ENTITIES-CLEAR" USING CLIENT-STATE
     MOVE "ender_dragon" TO WS-KEY
     MOVE 5 TO WS-ID
     PERFORM SPAWN
     MOVE 8 TO EN-BOX-HALF(1)
     MOVE 8 TO EN-BOX-HEIGHT(1)
     MOVE "end_crystal" TO WS-KEY
     MOVE 6 TO WS-ID
     MOVE 30.5 TO WS-X
     PERFORM SPAWN
     MOVE 7 TO WS-ID
     MOVE 15.5 TO WS-X
     PERFORM SPAWN
     MOVE 8 TO WS-ID
     MOVE 100.5 TO WS-X
     PERFORM SPAWN
     CALL "ENTITIES-ANIM-TICK" USING CLIENT-STATE
     MOVE "acceptance dragon nearest crystal is the nearest in the inflated box" TO TL-CASE
     MOVE EN-NCI(1) TO TL-OBSERVED-N
     MOVE 7 TO TL-EXPECTED-N
     PERFORM CHECK-N
     MOVE 0 TO EN-USED(3)
     CALL "ENTITIES-ANIM-TICK" USING CLIENT-STATE
     MOVE "acceptance dragon nearest crystal after that one is gone" TO TL-CASE
     MOVE EN-NCI(1) TO TL-OBSERVED-N
     MOVE 6 TO TL-EXPECTED-N
     PERFORM CHECK-N
     MOVE 0 TO EN-USED(2)
     CALL "ENTITIES-ANIM-TICK" USING CLIENT-STATE
     MOVE "acceptance dragon no crystal in the box: none" TO TL-CASE
     MOVE EN-NCI(1) TO TL-OBSERVED-N
     MOVE 0 TO TL-EXPECTED-N
     PERFORM CHECK-N
*>   The beam of a crystal with a beam target (entry 8, OPTIONAL_BLOCK_POS).
     CALL "ENTITIES-CLEAR" USING CLIENT-STATE
     MOVE 20.5 TO WS-X
     MOVE 70 TO WS-Y
     MOVE 20.5 TO WS-Z
     MOVE "end_crystal" TO WS-KEY
     MOVE 3 TO WS-ID
     PERFORM SPAWN
     MOVE 40 TO EN-AGE(1)
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     MOVE RL-EN-COUNT TO WS-COUNT0
     MOVE 8 TO WS-INDEX
     MOVE 11 TO WS-SERIAL
     MOVE 0 TO WS-HP
     MOVE 30 TO WS-PX
     MOVE 90 TO WS-PY
     MOVE 12 TO WS-PZ
     MOVE 1 TO WS-PRESENT
     CALL "ENTITY-DRAGON-SET" USING CLIENT-STATE WS-ID WS-INDEX WS-SERIAL WS-HP WS-PX WS-PY WS-PZ WS-PRESENT
     MOVE "acceptance crystal beam target is kept" TO TL-CASE
     COMPUTE TL-OBSERVED-N = EN-BP(1) * 1000000 + EN-BX(1) * 10000 + EN-BY(1) * 100 + EN-BZ(1)
     MOVE 1309012 TO TL-EXPECTED-N
     PERFORM CHECK-N
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     MOVE RL-EN-COUNT TO WS-COUNT1
     MOVE "acceptance crystal beam vertex count (2 strips x 8 quads x 12)" TO TL-CASE
     COMPUTE TL-OBSERVED-N = WS-COUNT1 - WS-COUNT0
     MOVE 192 TO TL-EXPECTED-N
     PERFORM CHECK-N
     CALL "ENTITY-MODEL-FIND" USING WS-BMKEY WS-BM
     MOVE 0 TO WS-SLOT
     PERFORM VARYING WS-S FROM 1 BY 1 UNTIL WS-S > EA-MT-COUNT
         IF EA-MT-MODEL(WS-S) = WS-BM AND EA-MT-TEX(WS-S) = 0
             MOVE WS-S TO WS-SLOT
         END-IF
     END-PERFORM
     MOVE "acceptance crystal beam image has an atlas slot" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF WS-SLOT > 0
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     PERFORM CHECK-N
     IF WS-SLOT = 0
         STOP RUN
     END-IF
     PERFORM VARYING WS-G FROM 1 BY 1 UNTIL WS-G > 6
         MOVE 0 TO WS-MAXD
         PERFORM VARYING WS-V FROM 1 BY 1 UNTIL WS-V > 6
             COMPUTE WS-BASE = WS-COUNT0 + WS-G1OFF(WS-G) + WS-V
             COMPUTE WS-DIFF = FUNCTION ABS(RL-EN-X(WS-BASE) - WS-G1X(WS-G, WS-V, 1)) + FUNCTION ABS(RL-EN-Y(WS-BASE) - WS-G1X(WS-G, WS-V, 2))
                 + FUNCTION ABS(RL-EN-Z(WS-BASE) - WS-G1X(WS-G, WS-V, 3))
             IF WS-DIFF > WS-MAXD
                 MOVE WS-DIFF TO WS-MAXD
             END-IF
             COMPUTE WS-EU = (EA-MT-X(WS-SLOT) + WS-G1X(WS-G, WS-V, 4) * EA-MT-W(WS-SLOT)) / EA-W
             COMPUTE WS-EV = (EA-MT-Y(WS-SLOT) + WS-G1X(WS-G, WS-V, 5) * EA-MT-H(WS-SLOT)) / EA-H
             COMPUTE WS-DIFF = FUNCTION ABS(RL-EN-U(WS-BASE) - WS-EU) + FUNCTION ABS(RL-EN-V(WS-BASE) - WS-EV)
                 + FUNCTION ABS(RL-EN-R(WS-BASE) - WS-G1X(WS-G, WS-V, 6)) + FUNCTION ABS(RL-EN-G(WS-BASE) - WS-G1X(WS-G, WS-V, 6))
                 + FUNCTION ABS(RL-EN-BLUE(WS-BASE) - WS-G1X(WS-G, WS-V, 6))
             IF WS-DIFF > WS-MAXD
                 MOVE WS-DIFF TO WS-MAXD
             END-IF
         END-PERFORM
         MOVE SPACES TO TL-CASE
         MOVE WS-G TO WS-JJ
         STRING "acceptance crystal beam vertices, texture and tint of the group " WS-JJ DELIMITED BY SIZE INTO TL-CASE
         MOVE WS-MAXD TO WS-DIFF
         PERFORM CHECK-SMALL
     END-PERFORM
*>   The beam of the dragon to its nearest crystal (crystal 6 at (30.5, 64, 10.5), age 40, row 1; the dragon, row 2, age 12): the beam is the last thing meshed.
     CALL "ENTITIES-CLEAR" USING CLIENT-STATE
     MOVE "end_crystal" TO WS-KEY
     MOVE 6 TO WS-ID
     MOVE 30.5 TO WS-X
     MOVE 64 TO WS-Y
     MOVE 10.5 TO WS-Z
     PERFORM SPAWN
     MOVE 40 TO EN-AGE(1)
     MOVE "ender_dragon" TO WS-KEY
     MOVE 5 TO WS-ID
     MOVE 10.5 TO WS-X
     PERFORM SPAWN
     MOVE 8 TO EN-BOX-HALF(2)
     MOVE 8 TO EN-BOX-HEIGHT(2)
     MOVE 12 TO EN-AGE(2)
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     MOVE RL-EN-COUNT TO WS-COUNT0
     MOVE 6 TO EN-NCI(2)
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     MOVE "acceptance dragon beam vertex count" TO TL-CASE
     COMPUTE TL-OBSERVED-N = RL-EN-COUNT - WS-COUNT0
     MOVE 192 TO TL-EXPECTED-N
     PERFORM CHECK-N
     PERFORM VARYING WS-G FROM 1 BY 1 UNTIL WS-G > 6
         MOVE 0 TO WS-MAXD
         PERFORM VARYING WS-V FROM 1 BY 1 UNTIL WS-V > 6
             COMPUTE WS-BASE = WS-COUNT0 + WS-G2OFF(WS-G) + WS-V
             COMPUTE WS-DIFF = FUNCTION ABS(RL-EN-X(WS-BASE) - WS-G2X(WS-G, WS-V, 1)) + FUNCTION ABS(RL-EN-Y(WS-BASE) - WS-G2X(WS-G, WS-V, 2))
                 + FUNCTION ABS(RL-EN-Z(WS-BASE) - WS-G2X(WS-G, WS-V, 3))
             IF WS-DIFF > WS-MAXD
                 MOVE WS-DIFF TO WS-MAXD
             END-IF
             COMPUTE WS-EU = (EA-MT-X(WS-SLOT) + WS-G2X(WS-G, WS-V, 4) * EA-MT-W(WS-SLOT)) / EA-W
             COMPUTE WS-EV = (EA-MT-Y(WS-SLOT) + WS-G2X(WS-G, WS-V, 5) * EA-MT-H(WS-SLOT)) / EA-H
             COMPUTE WS-DIFF = FUNCTION ABS(RL-EN-U(WS-BASE) - WS-EU) + FUNCTION ABS(RL-EN-V(WS-BASE) - WS-EV)
                 + FUNCTION ABS(RL-EN-R(WS-BASE) - WS-G2X(WS-G, WS-V, 6))
             IF WS-DIFF > WS-MAXD
                 MOVE WS-DIFF TO WS-MAXD
             END-IF
         END-PERFORM
         MOVE SPACES TO TL-CASE
         MOVE WS-G TO WS-JJ
         STRING "acceptance dragon beam vertices, texture and tint of the group " WS-JJ DELIMITED BY SIZE INTO TL-CASE
         MOVE WS-MAXD TO WS-DIFF
         PERFORM CHECK-SMALL
     END-PERFORM
     STOP RUN.
 SPAWN.
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-TYPE WS-ROW-AREA WS-STATUS
     CALL "MM-SPAWN" USING CLIENT-STATE WS-ID WS-TYPE WS-X WS-Y WS-Z WS-YAW.
 CHECK-SMALL.
     MOVE "N" TO TL-MODE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF WS-DIFF < 0.0003 AND WS-DIFF > -0.0003
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 CHECK-OTHER.
     MOVE "N" TO TL-MODE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF WS-DIFF > 0.001 OR WS-DIFF < -0.001
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 CHECK-N.
     MOVE "N" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-ENTITY-DRAGON-PASSES.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. MM-SPAWN.
*> USING CLIENT-STATE, entity id, type (registry id), x y z (FLOAT-LONG), yaw (FLOAT-SHORT, also the head yaw): Add Entity.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY PROTO.
 01 WS-READY               BINARY-LONG VALUE 0.
 01 WS-CAPACITY            BINARY-LONG VALUE 1024.
 01 WS-ADD                 BINARY-LONG VALUE 1.
 01 WS-ZERO                BINARY-LONG VALUE 0.
 01 WS-UUID                PIC X(16) VALUE LOW-VALUES.
 01 WS-V0                  FLOAT-LONG VALUE 0.
 01 WS-V1                  FLOAT-LONG VALUE 0.
 01 WS-V2                  FLOAT-LONG VALUE 0.
 01 WS-A0                  FLOAT-SHORT VALUE 0.
 LINKAGE SECTION.
 COPY CLSTATE.
 01 L-ID                   BINARY-LONG.
 01 L-TYPE                 BINARY-LONG.
 01 L-X                    FLOAT-LONG.
 01 L-Y                    FLOAT-LONG.
 01 L-Z                    FLOAT-LONG.
 01 L-YAW                  FLOAT-SHORT.
 PROCEDURE DIVISION USING CLIENT-STATE L-ID L-TYPE L-X L-Y L-Z L-YAW.
     IF WS-READY = 0
         CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
         MOVE 1 TO WS-READY
     END-IF
     CALL "PB-RESET" USING PB-BUFFER
     CALL "PB-PUT-VARINT" USING PB-BUFFER L-ID
     CALL "PB-PUT-UUID" USING PB-BUFFER WS-UUID
     CALL "PB-PUT-VARINT" USING PB-BUFFER L-TYPE
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER L-X
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER L-Y
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER L-Z
     CALL "PB-PUT-LPVEC3" USING PB-BUFFER WS-V0 WS-V1 WS-V2
     CALL "PB-PUT-ANGLE" USING PB-BUFFER WS-A0
     CALL "PB-PUT-ANGLE" USING PB-BUFFER L-YAW
     CALL "PB-PUT-ANGLE" USING PB-BUFFER L-YAW
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-ZERO
     MOVE 0 TO PB-POS
     CALL "ENTITY-PACKET" USING CLIENT-STATE PB-BUFFER WS-ADD
     GOBACK.
 END PROGRAM MM-SPAWN.


