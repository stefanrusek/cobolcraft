     CALL "P4-BREAK-COUNT" USING WS-BOX I1 WS-NX WS-NY WS-NZ
     MOVE "3.6 a bottom slab gives 32 (example 2)" TO WS-NAME
     MOVE 32 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I1
     PERFORM ASSERT-NUMBER
     MOVE "3.6 a slab has ny = 2" TO WS-NAME
     MOVE 2 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-NY
     PERFORM ASSERT-NUMBER
     MOVE 0.375 TO WS-B(1)
     MOVE 0 TO WS-B(2)
     MOVE 0.375 TO WS-B(3)
     MOVE 0.625 TO WS-B(4)
     MOVE 1 TO WS-B(5)
     MOVE 0.625 TO WS-B(6)
