     MOVE "3.3 structure_void sets noTerrainParticles" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I1
     PERFORM ASSERT-NUMBER
     MOVE "stone" TO WS-TNAME
