     MOVE 45000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-YD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "3.5 pillar zd = g3 / 30" TO WS-NAME
     MOVE -2000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-ZD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "3.5 pillar lifetime = 20 + nextInt(20)" TO WS-NAME
     MOVE 30 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-LIFETIME
     PERFORM ASSERT-NUMBER
     MOVE 0 TO WS-B(1)
     MOVE 0 TO WS-B(2)
