     MOVE "3.3 shouldSpawnTerrainParticles false creates none" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I1
     PERFORM ASSERT-NUMBER
     MOVE "barrier" TO WS-TNAME
