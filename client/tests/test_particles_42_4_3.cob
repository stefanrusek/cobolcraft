     MOVE "3.1 tint 0xFF80C040: red 0.6 * 128 / 255" TO WS-NAME
     MOVE 30118 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-RCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "3.1 tint 0xFF80C040: green 0.6 * 192 / 255" TO WS-NAME
     MOVE 45176 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-GCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "3.1 tint 0xFF80C040: blue 0.6 * 64 / 255" TO WS-NAME
     MOVE 15059 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-BCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 1.5 TO W1
     MOVE 0.5 TO W2
     MOVE 0 TO WS-S(1)
     MOVE 1 TO WS-S(2)
     MOVE 0 TO WS-S(3)
     MOVE 1 TO WS-S(4)
     CALL "P4-WINDOW" USING W1 W2 WS-SPR WS-UV
