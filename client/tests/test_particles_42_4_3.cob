     PERFORM ASSERT-NUMBER
     MOVE 0 TO WS-B(1)
     MOVE 0 TO WS-B(2)
     MOVE 0 TO WS-B(3)
     MOVE 1 TO WS-B(4)
     MOVE 1 TO WS-B(5)
     MOVE 1 TO WS-B(6)
     MOVE 10 TO WS-PP(1)
     MOVE 64 TO WS-PP(2)
     MOVE -3 TO WS-PP(3)
     MOVE 0 TO I1
     MOVE 0 TO I2
     MOVE 0 TO I3
     CALL "P4-BREAK-CELL" USING WS-BOX WS-P I1 I2 I3 WS-POS WS-BIAS
     MOVE "3.6 first cell x = P.x + 0.125" TO WS-NAME
     MOVE 1012500 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-O(1)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "3.6 first cell y" TO WS-NAME
     MOVE 6412500 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-O(2)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "3.6 first cell z" TO WS-NAME
     MOVE -287500 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-O(3)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "3.6 first cell bias is -0.375" TO WS-NAME
     MOVE -37500 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-BI(1)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 3 TO I1
     MOVE 3 TO I2
     MOVE 3 TO I3
     CALL "P4-BREAK-CELL" USING WS-BOX WS-P I1 I2 I3 WS-POS WS-BIAS
     MOVE "3.6 last cell x = P.x + 0.875" TO WS-NAME
     MOVE 1087500 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-O(1)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "3.6 last cell bias is +0.375" TO WS-NAME
     MOVE 37500 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((WS-BI(3)) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 0.5 TO WS-UU(1)
     MOVE 0.5 TO WS-UU(2)
     MOVE 0.5 TO WS-UU(3)
     MOVE 1 TO WS-FACE
     CALL "P4-CRACK-POS" USING WS-P WS-BOX WS-FACE WS-U WS-POS
     MOVE "3.7 UP face: y = P.y + maxY + 0.1 (example 3)" TO WS-NAME
