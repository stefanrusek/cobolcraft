     MOVE "3.3 stone does not" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I1
     PERFORM ASSERT-NUMBER
     MOVE 0.7 TO PC-XD
     MOVE 0.7 TO PC-YD
     MOVE 0.7 TO PC-ZD
