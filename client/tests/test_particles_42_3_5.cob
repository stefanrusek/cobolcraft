         MOVE 0.5 TO WS-D(WS-I)
         MOVE 0.5 TO WS-E(WS-I)
     END-PERFORM
     MOVE 1 TO WS-VX
     MOVE 0 TO WS-VY
     MOVE 0 TO WS-VZ
     CALL "P3-BUBBLE-NEW" USING PCL WS-X WS-Y WS-Z WS-VX WS-VY WS-VZ WS-DRAWS
