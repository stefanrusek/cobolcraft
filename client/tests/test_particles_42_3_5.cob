     MOVE 1000 TO WS-SCALE
     MOVE 70 TO TL-EXPECTED-N
     PERFORM ASSERT-SCALED
     MOVE "5.3 rain: lifetime (int)(8 / 0.6) = 13" TO WS-NAME
     MOVE 13 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-LIFETIME
     PERFORM ASSERT-NUMBER
     MOVE "5.3 rain: quadSize 0.15" TO WS-NAME
     COMPUTE WS-CHK = PC-QUAD-SIZE
     MOVE 1000 TO WS-SCALE
     MOVE 150 TO TL-EXPECTED-N
     PERFORM ASSERT-SCALED
     MOVE 1 TO WS-KIND
     MOVE 1 TO WS-VX
     MOVE 0 TO WS-VY
