     MOVE "5.1 bubble: lifetime 0 removes it" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-REMOVED
     PERFORM ASSERT-NUMBER
