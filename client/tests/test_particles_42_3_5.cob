     MOVE 0 TO WS-VY
     MOVE 0 TO WS-VZ
     CALL "P3-DROP-NEW" USING PCL WS-X WS-Y WS-Z WS-VX WS-VY WS-VZ WS-KIND WS-DRAWS
     MOVE "5.3 splash: all zero keeps the random velocity: yd 0.2" TO WS-NAME
     COMPUTE WS-CHK = PC-YD
     MOVE 1000 TO WS-SCALE
     MOVE 200 TO TL-EXPECTED-N
     PERFORM ASSERT-SCALED
     MOVE 0 TO WS-KIND
     CALL "P3-DROP-NEW" USING PCL WS-X WS-Y WS-Z WS-VX WS-VY WS-VZ WS-KIND WS-DRAWS
     MOVE 0.6 TO WS-VAL
     MOVE 0 TO WS-VAL2
     MOVE 0 TO WS-N
