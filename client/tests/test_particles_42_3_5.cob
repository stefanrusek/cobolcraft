     COMPUTE WS-CHK = PC-YD
     MOVE 10000 TO WS-SCALE
     MOVE 1760 TO TL-EXPECTED-N
     PERFORM ASSERT-SCALED
     MOVE 0 TO WS-VX
     MOVE 0 TO WS-VY
     MOVE 0 TO WS-VZ
     MOVE 0 TO WS-KIND
     CALL "P3-DROP-NEW" USING PCL WS-X WS-Y WS-Z WS-VX WS-VY WS-VZ WS-KIND WS-DRAWS
     MOVE "5.3 rain: yd = 0.5 * 0.2 + 0.1 = 0.2" TO WS-NAME
     COMPUTE WS-CHK = PC-YD
     MOVE 1000 TO WS-SCALE
     MOVE 200 TO TL-EXPECTED-N
     PERFORM ASSERT-SCALED
     MOVE "5.3 rain: xd 0.3 * 0 = 0" TO WS-NAME
     COMPUTE WS-CHK = PC-XD
     MOVE 1000 TO WS-SCALE
     MOVE 0 TO TL-EXPECTED-N
     PERFORM ASSERT-SCALED
     MOVE "5.3 rain: gravity 0.06, box 0.01 (thousandths: gravity + box)" TO WS-NAME
