*> Contract test, the client's consumer side of the C glue ABI (contracts/shim-abi.md §1, §3, §5, §8,
*> §9, §10): every CCSHIM.cpy constant the client uses has the contract's value, the 24-byte event
*> record and the 28-byte vertex have their lengths, and the cc_net_* calls the client makes
*> (connect, status, send, recv, close) and cc_deflate / cc_inflate link and return defined
*> outcomes on minimal calls with the calling convention of research R2. The window and Vulkan calls
*> are exercised against the real GPU by test_submit.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. CLIENT-CONTRACT-SHIM-CONSUMER.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CCSHIM.
 COPY TESTLIB.
 01 WS-HOST                PIC X(16) VALUE Z"127.0.0.1".
 01 WS-BAD-HOST            PIC X(32) VALUE Z"no.such.host.invalid".
 01 WS-ZERO                BINARY-LONG VALUE 0.
 01 WS-ONE                 BINARY-LONG VALUE 1.
 01 WS-THREE               BINARY-LONG VALUE 3.
 01 WS-WAIT                BINARY-LONG VALUE 1000.
 01 WS-LISTENER            BINARY-LONG.
 01 WS-PORT                BINARY-LONG.
 01 WS-CLIENT              BINARY-LONG.
 01 WS-SERVER              BINARY-LONG.
 01 WS-RC                  BINARY-LONG.
 01 WS-RC2                 BINARY-LONG.
 01 WS-SENT                BINARY-LONG.
 01 WS-GOT                 BINARY-LONG.
 01 WS-HANDLES.
    05 WS-HANDLE           BINARY-LONG.
 01 WS-READY               PIC X(2).
 01 WS-DATA                PIC X(3) VALUE "abc".
 01 WS-AREA                PIC X(64).
 01 WS-CAPACITY            BINARY-LONG VALUE 64.
 01 WS-PLAIN               PIC X(32) VALUE "cobolcraft cobolcraft cobolcraft".
 01 WS-PLAIN-LENGTH        BINARY-LONG VALUE 32.
 01 WS-PACKED              PIC X(128).
 01 WS-PACKED-CAP          BINARY-LONG VALUE 128.
 01 WS-PACKED-LENGTH       BINARY-LONG.
 01 WS-BACK                PIC X(32).
 01 WS-BACK-CAP            BINARY-LONG VALUE 32.
 01 WS-BACK-LENGTH         BINARY-LONG.
 01 WS-MODE                BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 PROCEDURE DIVISION.
     MOVE "contract client shim consumer outcomes CC-AGAIN 1, CC-UNRESOLVED 3, CC-CLOSED 4"
         TO TL-CASE
     MOVE "N" TO TL-MODE
     MOVE 134 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = CC-AGAIN * 100 + CC-UNRESOLVED * 10 + CC-CLOSED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "contract client shim consumer event kinds 1 to 9, buttons 0 to 2, modifiers 1 and 2"
         TO TL-CASE
     MOVE 123456789012012 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = CC-EV-KEY-DOWN * 100000000000000 + CC-EV-KEY-UP * 10000000000000
         + CC-EV-TEXT * 1000000000000 + CC-EV-BUTTON-DOWN * 100000000000
         + CC-EV-BUTTON-UP * 10000000000 + CC-EV-CURSOR * 1000000000 + CC-EV-SCROLL * 100000000
         + CC-EV-RESIZE * 10000000 + CC-EV-CLOSE-REQUEST * 1000000 + CC-BUTTON-LEFT * 100000
         + CC-BUTTON-RIGHT * 10000 + CC-BUTTON-MIDDLE * 1000 + CC-MOD-SHIFT * 10 + CC-MOD-CONTROL
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "contract client shim consumer key codes Escape 256, Enter 257, Backspace 259, W 87"
         TO TL-CASE
     MOVE 256257259087 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = CC-KEY-ESCAPE * 1000000000 + CC-KEY-ENTER * 1000000
         + CC-KEY-BACKSPACE * 1000 + CC-KEY-W
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "contract client shim consumer pipelines 0, 1, 2; textures 0 to 3; mesh slots 1 to 65535"
         TO TL-CASE
     MOVE 120123165535 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = CC-PIPE-OPAQUE * 10000000000000 + CC-PIPE-TRANSLUCENT * 100000000000
         + CC-PIPE-UI * 10000000000 + CC-TEX-BLOCKS * 1000000000 + CC-TEX-ENTITIES * 100000000
         + CC-TEX-UI * 10000000 + CC-TEX-ENVIRONMENT * 1000000 + CC-MESH-SLOT-MIN * 100000
         + CC-MESH-SLOT-MAX
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "contract client shim consumer the crumbling pipeline is 3 (CC-PIPE-CRUMBLING)" TO TL-CASE
     MOVE 3 TO TL-EXPECTED-N
     MOVE CC-PIPE-CRUMBLING TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "contract client shim consumer the event record is 24 bytes and the vertex 28 (records and "
         & "CC-EVENT-SIZE, CC-VERTEX-SIZE)" TO TL-CASE
     MOVE 24282428 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION LENGTH(CC-EVENT) * 1000000
         + FUNCTION LENGTH(CC-VERTEX) * 10000 + CC-EVENT-SIZE * 100 + CC-VERTEX-SIZE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

*>   cc_net_connect to a loopback listener: started, connected, bytes both ways, closed.
     CALL STATIC "cc_net_listen" USING BY VALUE WS-ZERO BY REFERENCE WS-LISTENER
         BY REFERENCE WS-PORT RETURNING WS-RC
     CALL STATIC "cc_net_connect" USING BY REFERENCE WS-HOST BY VALUE WS-PORT
         BY REFERENCE WS-CLIENT RETURNING WS-RC
     MOVE WS-LISTENER TO WS-HANDLE
     CALL STATIC "cc_net_poll" USING BY VALUE WS-WAIT BY REFERENCE WS-HANDLES BY VALUE WS-ONE
         BY VALUE WS-ZERO BY REFERENCE WS-READY RETURNING WS-RC2
     CALL STATIC "cc_net_accept" USING BY VALUE WS-LISTENER BY REFERENCE WS-SERVER
         RETURNING WS-RC2
     MOVE 1 TO WS-RC2
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-RC2 NOT = CC-AGAIN OR WS-I > 100
         CALL STATIC "cc_net_status" USING BY VALUE WS-CLIENT RETURNING WS-RC2
     END-PERFORM
     MOVE "contract client shim consumer cc_net_connect returns 0 and cc_net_status then 0"
         TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-RC * 10 + WS-RC2
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL STATIC "cc_net_send" USING BY VALUE WS-CLIENT BY REFERENCE WS-DATA BY VALUE WS-THREE
         BY REFERENCE WS-SENT RETURNING WS-RC
     MOVE WS-SERVER TO WS-HANDLE
     CALL STATIC "cc_net_poll" USING BY VALUE WS-WAIT BY REFERENCE WS-HANDLES BY VALUE WS-ONE
         BY VALUE WS-ZERO BY REFERENCE WS-READY RETURNING WS-RC2
     CALL STATIC "cc_net_recv" USING BY VALUE WS-SERVER BY REFERENCE WS-AREA BY VALUE WS-CAPACITY
         BY REFERENCE WS-GOT RETURNING WS-RC2
     MOVE "contract client shim consumer cc_net_send of 3 bytes returns 0, they arrive" TO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE "0 0 abc" TO TL-EXPECTED
     MOVE SPACES TO TL-OBSERVED
     STRING FUNCTION CHAR(WS-RC + 49) " " FUNCTION CHAR(WS-RC2 + 49) " " WS-AREA(1:WS-GOT)
         DELIMITED BY SIZE INTO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL STATIC "cc_net_recv" USING BY VALUE WS-CLIENT BY REFERENCE WS-AREA BY VALUE WS-CAPACITY
         BY REFERENCE WS-GOT RETURNING WS-RC
     CALL STATIC "cc_net_close" USING BY VALUE WS-SERVER
     CALL STATIC "cc_net_poll" USING BY VALUE WS-WAIT BY REFERENCE WS-HANDLES BY VALUE WS-ONE
         BY VALUE WS-ZERO BY REFERENCE WS-READY RETURNING WS-RC2
     MOVE WS-CLIENT TO WS-HANDLE
     CALL STATIC "cc_net_poll" USING BY VALUE WS-WAIT BY REFERENCE WS-HANDLES BY VALUE WS-ONE
         BY VALUE WS-ZERO BY REFERENCE WS-READY RETURNING WS-RC2
     CALL STATIC "cc_net_recv" USING BY VALUE WS-CLIENT BY REFERENCE WS-AREA BY VALUE WS-CAPACITY
         BY REFERENCE WS-GOT RETURNING WS-RC2
     MOVE "contract client shim consumer cc_net_recv: CC_AGAIN with nothing sent, CC_CLOSED after "
         & "the peer closed" TO TL-CASE
     MOVE "N" TO TL-MODE
     COMPUTE TL-EXPECTED-N = CC-AGAIN * 10 + CC-CLOSED
     COMPUTE TL-OBSERVED-N = WS-RC * 10 + WS-RC2
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL STATIC "cc_net_close" USING BY VALUE WS-CLIENT
     CALL STATIC "cc_net_close" USING BY VALUE WS-LISTENER
     CALL STATIC "cc_net_connect" USING BY REFERENCE WS-BAD-HOST BY VALUE WS-PORT
         BY REFERENCE WS-CLIENT RETURNING WS-RC
     MOVE "contract client shim consumer cc_net_connect to an unresolvable host: CC_UNRESOLVED"
         TO TL-CASE
     MOVE CC-UNRESOLVED TO TL-EXPECTED-N
     MOVE WS-RC TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE CC-ZLIB TO WS-MODE
     CALL STATIC "cc_deflate" USING BY VALUE WS-MODE BY REFERENCE WS-PLAIN BY VALUE WS-PLAIN-LENGTH
         BY REFERENCE WS-PACKED BY VALUE WS-PACKED-CAP BY REFERENCE WS-PACKED-LENGTH RETURNING WS-RC
     CALL STATIC "cc_inflate" USING BY VALUE WS-MODE BY REFERENCE WS-PACKED
         BY VALUE WS-PACKED-LENGTH BY REFERENCE WS-BACK BY VALUE WS-BACK-CAP
         BY REFERENCE WS-BACK-LENGTH RETURNING WS-RC2
     MOVE "contract client shim consumer cc_deflate and cc_inflate (zlib mode 0) round-trip"
         TO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE "0 0 cobolcraft cobolcraft cobolcraft" TO TL-EXPECTED
     MOVE SPACES TO TL-OBSERVED
     STRING FUNCTION CHAR(WS-RC + 49) " " FUNCTION CHAR(WS-RC2 + 49) " "
         WS-BACK(1:WS-BACK-LENGTH) DELIMITED BY SIZE INTO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.
 END PROGRAM CLIENT-CONTRACT-SHIM-CONSUMER.
