 COPY CLSTATE.
 01 L-ID                   BINARY-LONG.
 01 L-DIR                  BINARY-LONG.
 01 L-ITEM                 BINARY-LONG.
 01 L-ROT                  BINARY-LONG.
 PROCEDURE DIVISION USING CLIENT-STATE L-ID L-DIR L-ITEM L-ROT.
     IF WS-READY = 0
         CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
         MOVE 1 TO WS-READY
     END-IF
     CALL "PB-RESET" USING PB-BUFFER
     CALL "PB-PUT-VARINT" USING PB-BUFFER L-ID
     INITIALIZE MD-METADATA-ENTRY-X
     MOVE 8 TO MD-MX-INDEX
     MOVE 12 TO MD-MX-SERIALIZER
     MOVE L-DIR TO MD-MX-INT
     CALL "PB-PUT-METADATA-ENTRY-X" USING PB-BUFFER MD-METADATA-ENTRY-X
     INITIALIZE MD-METADATA-ENTRY-X
     MOVE 9 TO MD-MX-INDEX
     MOVE 7 TO MD-MX-SERIALIZER
     MOVE 1 TO MD-MX-IS-COUNT
     MOVE L-ITEM TO MD-MX-IS-ITEM
     CALL "PB-PUT-METADATA-ENTRY-X" USING PB-BUFFER MD-METADATA-ENTRY-X
     INITIALIZE MD-METADATA-ENTRY-X
     MOVE 10 TO MD-MX-INDEX
     MOVE 1 TO MD-MX-SERIALIZER
     MOVE L-ROT TO MD-MX-INT
     CALL "PB-PUT-METADATA-ENTRY-X" USING PB-BUFFER MD-METADATA-ENTRY-X
     INITIALIZE MD-METADATA-ENTRY-X
     MOVE MD-MD-END TO MD-MX-INDEX
     CALL "PB-PUT-METADATA-ENTRY-X" USING PB-BUFFER MD-METADATA-ENTRY-X
