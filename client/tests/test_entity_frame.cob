 PROCEDURE DIVISION.
     CALL "CL-INIT" USING CLIENT-STATE
     CALL "PACK-STACK-INIT" USING CLIENT-STATE
     ADD 1 TO PK-COUNT
     INITIALIZE PK-PACK(PK-COUNT)
     MOVE 1 TO PK-KIND(PK-COUNT)
     MOVE 3 TO PK-LEVEL(PK-COUNT)
     MOVE "generated/vanilla" TO PK-ID(PK-COUNT)
     MOVE 17 TO PK-ID-LENGTH(PK-COUNT)
     MOVE "client/tests/fixtures/mini-vanilla" TO PK-ROOT(PK-COUNT)
     MOVE 34 TO PK-ROOT-LENGTH(PK-COUNT)
     CALL "PACK-STACK-OPEN" USING CLIENT-STATE
     CALL "PACK-SOURCE-FILES" USING CLIENT-STATE PK-COUNT
     CALL "ATLAS-BUILD" USING CLIENT-STATE
     CALL "ENTITY-ATLAS-BUILD" USING CLIENT-STATE
     MOVE CT-TYPE-STANDARD TO CT-SET-TYPE
     CALL "CONTENT-SET-COUNTS"
     MOVE 1 TO CT-OPEN
     MOVE 256 TO PL-HEIGHT
     MOVE 0 TO SK-U
     MOVE 10 TO WS-EYE(1) WS-EYE(3)
     MOVE 64 TO WS-EYE(2)
     MOVE "stick" TO WS-KEY
     CALL "CONTENT-ITEM-BY-KEY" USING WS-KEY WS-STICK WS-ITEM-ROW WS-STATUS
     MOVE "stone" TO WS-KEY
     CALL "CONTENT-ITEM-BY-KEY" USING WS-KEY WS-STONE WS-ITEM-ROW WS-STATUS
     MOVE "N" TO TL-MODE
     PERFORM VARYING WS-C FROM 1 BY 1 UNTIL WS-C > 6
         CALL "ENTITIES-CLEAR" USING CLIENT-STATE
         MOVE "item_frame" TO WS-KEY
         IF WS-C = 6
             MOVE "glow_item_frame" TO WS-KEY
         END-IF
         CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-TYPE WS-ROW-AREA WS-STATUS
         COMPUTE WS-X = WS-CX2(WS-C) / 2
         MOVE WS-CY1(WS-C) TO WS-Y
         COMPUTE WS-Z = WS-CZ2(WS-C) / 2
         CALL "MM-SPAWN" USING CLIENT-STATE WS-ID WS-TYPE WS-X WS-Y WS-Z WS-YAW
         MOVE WS-CDIR(WS-C) TO WS-INT
         MOVE WS-CROT(WS-C) TO WS-INT2
         CALL "FR-DATA" USING CLIENT-STATE WS-ID WS-INT WS-STICK WS-INT2
         IF WS-CINV(WS-C) = 1
             MOVE 32 TO EN-FLAGS(1)
         END-IF
         MOVE WS-C TO WS-CC
         IF WS-C = 1
             MOVE "acceptance frame keeps direction, item and rotation (north, stick, 0)" TO TL-CASE
             COMPUTE TL-OBSERVED-N = EN-FDIR(1) * 1000 + EN-STACK-COUNT(1) * 100 + EN-FROT(1)
             COMPUTE TL-EXPECTED-N = 2000 + 100 + 0
             CALL "TEST-ASSERT" USING TESTLIB-ASSERT
             MOVE "acceptance frame keeps the item" TO TL-CASE
             MOVE EN-STACK-ITEM(1) TO TL-OBSERVED-N
             MOVE WS-STICK TO TL-EXPECTED-N
             CALL "TEST-ASSERT" USING TESTLIB-ASSERT
         END-IF
         CALL "GROUND-ITEMS-MESH" USING CLIENT-STATE WS-EYE-TABLE
         MOVE SPACES TO TL-CASE
         STRING "acceptance frame " FUNCTION TRIM(WS-NM(WS-C)) " draws the icon: 12 vertices" DELIMITED BY SIZE INTO TL-CASE
         MOVE RL-GI-COUNT TO TL-OBSERVED-N
         MOVE 12 TO TL-EXPECTED-N
         CALL "TEST-ASSERT" USING TESTLIB-ASSERT
         MOVE 0 TO WS-MAXD
         PERFORM VARYING WS-V FROM 1 BY 1 UNTIL WS-V > 12
             COMPUTE WS-DIFF = FUNCTION ABS(RL-GI-X(WS-V) - WS-CVX(WS-C, WS-V, 1)) + FUNCTION ABS(RL-GI-Y(WS-V) - WS-CVX(WS-C, WS-V, 2))
                 + FUNCTION ABS(RL-GI-Z(WS-V) - WS-CVX(WS-C, WS-V, 3))
             IF WS-DIFF > WS-MAXD
                 MOVE WS-DIFF TO WS-MAXD
             END-IF
         END-PERFORM
         MOVE SPACES TO TL-CASE
         STRING "acceptance frame " FUNCTION TRIM(WS-NM(WS-C)) " vertex positions" DELIMITED BY SIZE INTO TL-CASE
         MOVE 1 TO TL-EXPECTED-N
         MOVE 0 TO TL-OBSERVED-N
         IF WS-MAXD < 0.001
             MOVE 1 TO TL-OBSERVED-N
         END-IF
         CALL "TEST-ASSERT" USING TESTLIB-ASSERT
         IF WS-C = 6
             MOVE "acceptance glow frame is full bright (the face shade only)" TO TL-CASE
             MOVE 1 TO TL-EXPECTED-N
             MOVE 0 TO TL-OBSERVED-N
             IF RL-GI-B(1) >= 0.4999
                 MOVE 1 TO TL-OBSERVED-N
             END-IF
             CALL "TEST-ASSERT" USING TESTLIB-ASSERT
         END-IF
         IF WS-C = 5
             MOVE "acceptance plain frame is lit by its cell (0.1 at least, no light here)" TO TL-CASE
             MOVE 1 TO TL-EXPECTED-N
             MOVE 0 TO TL-OBSERVED-N
             IF RL-GI-B(1) <= 0.1001
                 MOVE 1 TO TL-OBSERVED-N
             END-IF
             CALL "TEST-ASSERT" USING TESTLIB-ASSERT
         END-IF
     END-PERFORM
*>   A stone is a cube: 36 vertices. An empty frame draws nothing.
     CALL "ENTITIES-CLEAR" USING CLIENT-STATE
     MOVE "item_frame" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-TYPE WS-ROW-AREA WS-STATUS
     MOVE 10.5 TO WS-X
     MOVE 64 TO WS-Y
     MOVE 10.5 TO WS-Z
     CALL "MM-SPAWN" USING CLIENT-STATE WS-ID WS-TYPE WS-X WS-Y WS-Z WS-YAW
     MOVE 2 TO WS-INT
     MOVE 0 TO WS-INT2
     CALL "FR-DATA" USING CLIENT-STATE WS-ID WS-INT WS-STONE WS-INT2
     CALL "GROUND-ITEMS-MESH" USING CLIENT-STATE WS-EYE-TABLE
     MOVE "acceptance frame with a stone: a cube of 36 vertices" TO TL-CASE
     MOVE RL-GI-COUNT TO TL-OBSERVED-N
     MOVE 36 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 0 TO EN-STACK-COUNT(1)
     CALL "GROUND-ITEMS-MESH" USING CLIENT-STATE WS-EYE-TABLE
     MOVE "acceptance an empty frame draws nothing" TO TL-CASE
     MOVE RL-GI-COUNT TO TL-OBSERVED-N
     MOVE 0 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.
 END PROGRAM TEST-ENTITY-FRAME.

