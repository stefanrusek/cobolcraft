     CALL "PART-OPT-DECODE" USING PB-BUFFER WS-ID PART-OPTIONS
     MOVE "trail: target x y z (hundredths)" TO WS-NAME
     COMPUTE TL-EXPECTED-N = 150 - 6425 + 100000
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER(PO-TARGET-X * 100 + 0.5)
         + FUNCTION INTEGER(PO-TARGET-Y * 100 + 0.5) + FUNCTION INTEGER(PO-TARGET-Z * 100 + 0.5)
