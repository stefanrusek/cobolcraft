     CALL "PB-PUT-FLOAT" USING PB-BUFFER WS-FLOAT
     CALL "PART-EXPLOSION-INFO" USING PB-BUFFER WS-TYPE PART-OPTIONS WS-SCALING WS-SPEED
     MOVE "explosion info: particle type 15 (dragon_breath), power 0.5, scaling 2.0, speed 4.0" TO WS-NAME
     COMPUTE TL-EXPECTED-N = 15 * 10000 + 50 + 200 * 100000 + 400 * 1000000000
     COMPUTE TL-OBSERVED-N = WS-TYPE * 10000 + FUNCTION INTEGER(PO-POWER * 100 + 0.5)
         + FUNCTION INTEGER(WS-SCALING * 100 + 0.5) * 100000
         + FUNCTION INTEGER(WS-SPEED * 100 + 0.5) * 1000000000
     PERFORM ASSERT-NUMBER
     MOVE "explosion info: JSON defaults scaling and speed 1.0" TO WS-NAME
     CALL "PART-EXPLOSION-DEFAULTS" USING WS-SCALING WS-SPEED
     COMPUTE TL-EXPECTED-N = 2
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER(WS-SCALING + WS-SPEED + 0.5)
     PERFORM ASSERT-NUMBER
*>   ParticleLimit: spore_blossom_air only, 1000.
     MOVE "spore_blossom_air" TO WS-NAME
     CALL "PART-TYPE-ID" USING WS-NAME WS-ID
     CALL "PART-LIMIT" USING WS-ID WS-LIMIT
     MOVE "particle limit: spore_blossom_air is 1000" TO WS-NAME
     MOVE 1000 TO TL-EXPECTED-N
     MOVE WS-LIMIT TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     MOVE 0 TO WS-ID
     CALL "PART-LIMIT" USING WS-ID WS-LIMIT
     MOVE "particle limit: other types have none" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-LIMIT TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
*>   An id outside the registry has no options class: error.
     CALL "PB-RESET" USING PB-BUFFER
     MOVE 200 TO WS-ID
     CALL "PART-OPT-DECODE" USING PB-BUFFER WS-ID PART-OPTIONS
     MOVE "unknown registry id is an error" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     MOVE PO-ERROR TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
*>   Item template with count 0 is malformed; an unsupported component type is malformed.
     CALL "PB-RESET" USING PB-BUFFER
     MOVE 57 TO WS-ID
     MOVE 5 TO WS-INT
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-INT
     MOVE 0 TO WS-INT
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-INT
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-INT
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-INT
     CALL "PART-OPT-DECODE" USING PB-BUFFER WS-ID PART-OPTIONS
     MOVE "item: count 0 is an error" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     MOVE PO-ERROR TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     CALL "PB-RESET" USING PB-BUFFER
     MOVE 5 TO WS-INT
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-INT
     MOVE 1 TO WS-INT
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-INT
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-INT
     MOVE 0 TO WS-INT
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-INT
     MOVE 99 TO WS-INT
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-INT
     CALL "PART-OPT-DECODE" USING PB-BUFFER WS-ID PART-OPTIONS
     MOVE "item: a component type with no known layout is an error" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     MOVE PO-ERROR TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
*>   JSON check of kinds without ranges; unknown constant; explosion info with a short read.
     MOVE 0 TO WS-ID
     CALL "PART-OPT-DEFAULTS" USING WS-ID PART-OPTIONS
     CALL "PART-OPT-JSON-CHECK" USING PART-OPTIONS WS-MSG
     MOVE "JSON check: a simple type has nothing to reject" TO WS-NAME
     MOVE "T" TO TL-MODE
     MOVE SPACES TO TL-EXPECTED
     MOVE WS-MSG TO TL-OBSERVED
     PERFORM ASSERT-TEXT
     MOVE "NO_SUCH_CONSTANT" TO WS-CONST
     CALL "PART-OPT-CONSTANT" USING WS-CONST PART-OPTIONS
     MOVE "unknown constant leaves the kind blank" TO WS-NAME
     MOVE "T" TO TL-MODE
     MOVE SPACES TO TL-EXPECTED
     MOVE PO-KIND TO TL-OBSERVED
     PERFORM ASSERT-TEXT
     CALL "PB-RESET" USING PB-BUFFER
     MOVE 15 TO WS-INT
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-INT
     CALL "PART-EXPLOSION-INFO" USING PB-BUFFER WS-TYPE PART-OPTIONS WS-SCALING WS-SPEED
     MOVE "explosion info: truncated is an error" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     MOVE PO-ERROR TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     STOP RUN.

 TEXT-CASE-KIND.
     MOVE "T" TO TL-MODE
     MOVE "block" TO TL-EXPECTED
     MOVE PO-KIND TO TL-OBSERVED
     PERFORM ASSERT-TEXT.

 ASSERT-NUMBER.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-1§3 Particle options and their forms: " FUNCTION TRIM(WS-NAME)
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "N" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 ASSERT-TEXT.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-1§3 Particle options and their forms: " FUNCTION TRIM(WS-NAME)
         DELIMITED BY SIZE INTO TL-CASE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-PARTICLES-42-1-3.
