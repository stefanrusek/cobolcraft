*>   Getters: red, green, blue, alpha are byte / 255.0.
     MOVE 2147483648 TO WS-PACKED
     ADD 8355711 TO WS-PACKED
     CALL "PART-COLOR-GET" USING WS-PACKED WS-A WS-R WS-G WS-B
     MOVE "color getters: alpha 128 of 0x807F7F7F" TO WS-NAME
     COMPUTE TL-EXPECTED-N = 128
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER(WS-A * 255 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "color getters: red 127" TO WS-NAME
     COMPUTE TL-EXPECTED-N = 127
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER(WS-R * 255 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 4294967295 TO WS-PACKED
     CALL "PART-COLOR-GET" USING WS-PACKED WS-A WS-R WS-G WS-B
     MOVE "color getters: -1 reads as white (blue 1.0)" TO WS-NAME
     COMPUTE TL-EXPECTED-N = 255
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER(WS-B * 255 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "color getters: exact 1.0 for byte 255" TO WS-NAME
     COMPUTE TL-EXPECTED-N = 1000
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER(WS-B * 1000 + 0.001)
     PERFORM ASSERT-NUMBER
*>   dust (21): Int RGB24, Float scale (clamped to 0.01 .. 4.0).
     CALL "PB-RESET" USING PB-BUFFER
     MOVE 21 TO WS-ID
     MOVE 16711680 TO WS-INT
     CALL "PB-PUT-INT" USING PB-BUFFER WS-INT
     MOVE 0.5 TO WS-FLOAT
     CALL "PB-PUT-FLOAT" USING PB-BUFFER WS-FLOAT
     CALL "PART-OPT-DECODE" USING PB-BUFFER WS-ID PART-OPTIONS
     MOVE "dust: colour" TO WS-NAME
     MOVE 16711680 TO TL-EXPECTED-N
     MOVE PO-COLOR TO TL-OBSERVED-N
     PERFORM ASSERT-NUMBER
     MOVE "dust: scale 0.5 in thousandths" TO WS-NAME
     MOVE 500 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER(PO-SCALE * 1000 + 0.5)
     PERFORM ASSERT-NUMBER
     PERFORM VARYING WS-CMP FROM 1 BY 1 UNTIL WS-CMP > 2
         CALL "PB-RESET" USING PB-BUFFER
         MOVE 16711680 TO WS-INT
         CALL "PB-PUT-INT" USING PB-BUFFER WS-INT
         IF WS-CMP = 1
             MOVE 100.0 TO WS-FLOAT
         ELSE
             MOVE 0.0 TO WS-FLOAT
         END-IF
         CALL "PB-PUT-FLOAT" USING PB-BUFFER WS-FLOAT
         CALL "PART-OPT-DECODE" USING PB-BUFFER WS-ID PART-OPTIONS
         IF WS-CMP = 1
             MOVE "dust: scale above the range clamps to 4.0 (hundredths)" TO WS-NAME
             MOVE 400 TO TL-EXPECTED-N
         ELSE
             MOVE "dust: scale below the range clamps to 0.01 (hundredths)" TO WS-NAME
             MOVE 1 TO TL-EXPECTED-N
         END-IF
         COMPUTE TL-OBSERVED-N = FUNCTION INTEGER(PO-SCALE * 100 + 0.5)
         PERFORM ASSERT-NUMBER
         MOVE "dust: wire value outside the range is not an error" TO WS-NAME
         MOVE 0 TO TL-EXPECTED-N
         MOVE PO-ERROR TO TL-OBSERVED-N
         PERFORM ASSERT-NUMBER
     END-PERFORM
*>   dust_color_transition (22): from, to, scale.
     CALL "PB-RESET" USING PB-BUFFER
