 PROCEDURE DIVISION.
     CALL "CL-INIT" USING CLIENT-STATE
     CALL "PACK-STACK-INIT" USING CLIENT-STATE
     ADD 1 TO PK-COUNT
     INITIALIZE PK-PACK(PK-COUNT)
     MOVE 1 TO PK-KIND(PK-COUNT)
     MOVE 3 TO PK-LEVEL(PK-COUNT)
     MOVE "generated/vanilla" TO PK-ID(PK-COUNT)
     MOVE 17 TO PK-ID-LENGTH(PK-COUNT)
     MOVE "client/tests/fixtures/mini-vanilla" TO PK-ROOT(PK-COUNT)
     MOVE 34 TO PK-ROOT-LENGTH(PK-COUNT)
     CALL "PACK-STACK-OPEN" USING CLIENT-STATE
     CALL "PACK-SOURCE-FILES" USING CLIENT-STATE PK-COUNT
     CALL "ATLAS-BUILD" USING CLIENT-STATE
     CALL "ENTITY-ATLAS-BUILD" USING CLIENT-STATE
     MOVE CT-TYPE-STANDARD TO CT-SET-TYPE
     CALL "CONTENT-SET-COUNTS"
     MOVE 1 TO CT-OPEN
     MOVE 256 TO PL-HEIGHT
     MOVE 0 TO SK-U
     MOVE 10 TO WS-EYE(1) WS-EYE(3)
     MOVE 64 TO WS-EYE(2)
     MOVE "N" TO TL-MODE
     CALL "STATE-TABLES-ENSURE" USING CLIENT-STATE
*>   The states of shulker_box and red_shulker_box: six facings each, found by the property text of the content set.
     PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 2
         IF WS-K = 1
             MOVE "shulker_box" TO WS-KEY
         ELSE
             MOVE "red_shulker_box" TO WS-KEY
         END-IF
         CALL "CONTENT-BLOCK-BY-KEY" USING WS-KEY WS-BLOCK WS-BLOCK-ROW WS-STATUS
         MOVE WS-BLOCK-ROW TO CT-BLOCK-ROW
         COMPUTE WS-FIRST = FUNCTION NUMVAL(CT-BR-FIRST-STATE)
         PERFORM VARYING WS-I FROM 0 BY 1 UNTIL WS-I > 5
             COMPUTE WS-CODE = WS-FIRST + WS-I
             CALL "CONTENT-STATE-PROPS" USING WS-CODE WS-PROPS WS-STATUS
             MOVE 0 TO WS-C
             PERFORM VARYING WS-P FROM 1 BY 1 UNTIL WS-P > WS-P-COUNT
                 IF WS-P-NAME(WS-P) = "facing"
                     EVALUATE WS-P-VALUE(WS-P)
                         WHEN "down"
                             MOVE 1 TO WS-C
                         WHEN "up"
                             MOVE 2 TO WS-C
                         WHEN "north"
                             MOVE 3 TO WS-C
                         WHEN "south"
                             MOVE 4 TO WS-C
                         WHEN "west"
                             MOVE 5 TO WS-C
                         WHEN OTHER
                             MOVE 6 TO WS-C
                     END-EVALUATE
                 END-IF
             END-PERFORM
             IF WS-C > 0 AND WS-K = 1
                 MOVE WS-CODE TO WS-SU(WS-C)
             END-IF
             IF WS-C > 0 AND WS-K = 2
                 MOVE WS-CODE TO WS-RU(WS-C)
             END-IF
         END-PERFORM
     END-PERFORM
     MOVE "stone" TO WS-KEY
     CALL "CONTENT-BLOCK-BY-KEY" USING WS-KEY WS-BLOCK WS-BLOCK-ROW WS-STATUS
     MOVE WS-BLOCK-ROW TO CT-BLOCK-ROW
     COMPUTE WS-STONE = FUNCTION NUMVAL(CT-BR-FIRST-STATE)
*>   A chunk with a shulker box: the block change finds it, with the colour (16 undyed, 14 red) and the facing (1 up, 5 east; the Direction order).
     MOVE 0 TO SB-COUNT
     MOVE 0 TO WS-CHX WS-CHZ
     CALL "WORLD-ROW-NEW" USING CLIENT-STATE WS-CHX WS-CHZ WS-NEWROW
     MOVE 3 TO WS-X
     MOVE 70 TO WS-Y
     MOVE 3 TO WS-Z
     CALL "WORLD-BLOCK-SET" USING CLIENT-STATE WS-X WS-Y WS-Z WS-SU(2)
     MOVE "acceptance shulker block change adds the box" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE SB-COUNT TO TL-OBSERVED-N
     PERFORM CHECK-N
     MOVE "acceptance shulker undyed box: colour 16 and facing up (1)" TO TL-CASE
     COMPUTE TL-OBSERVED-N = SB-COLOUR(1) * 10 + SB-FACE(1)
     MOVE 161 TO TL-EXPECTED-N
     PERFORM CHECK-N
     MOVE "acceptance shulker box at its block position" TO TL-CASE
     COMPUTE TL-OBSERVED-N = SB-X(1) * 10000 + SB-Y(1) * 100 + SB-Z(1)
     MOVE 37003 TO TL-EXPECTED-N
     PERFORM CHECK-N
*>   The same box again changes nothing; the red one at another place; stone is no shulker box.
     CALL "WORLD-BLOCK-SET" USING CLIENT-STATE WS-X WS-Y WS-Z WS-SU(6)
     MOVE "acceptance shulker box set again is the same box with the new facing (east 5)" TO TL-CASE
     COMPUTE TL-OBSERVED-N = SB-COUNT * 100 + SB-FACE(1)
     MOVE 105 TO TL-EXPECTED-N
     PERFORM CHECK-N
     MOVE 5 TO WS-X
     CALL "WORLD-BLOCK-SET" USING CLIENT-STATE WS-X WS-Y WS-Z WS-RU(2)
     MOVE "acceptance shulker red box: colour 14" TO TL-CASE
     MOVE 14 TO TL-EXPECTED-N
     MOVE SB-COLOUR(2) TO TL-OBSERVED-N
     PERFORM CHECK-N
     MOVE 7 TO WS-X
     CALL "WORLD-BLOCK-SET" USING CLIENT-STATE WS-X WS-Y WS-Z WS-STONE
     MOVE "acceptance shulker stone is not a shulker box" TO TL-CASE
     MOVE 2 TO TL-EXPECTED-N
     MOVE SB-COUNT TO TL-OBSERVED-N
     PERFORM CHECK-N
*>   The scan of a loaded chunk finds both again after the table is cleared (and builds the state table of the boxes when it is not ready).
     MOVE 0 TO SB-COUNT SB-READY
     MOVE 0 TO SB-USED(1) SB-USED(2)
     CALL "SHULKER-SCAN" USING CLIENT-STATE WS-CHX WS-CHZ
     MOVE "acceptance shulker scan of a chunk finds its two boxes" TO TL-CASE
     MOVE 2 TO TL-EXPECTED-N
     MOVE SB-COUNT TO TL-OBSERVED-N
     PERFORM CHECK-N
*>   Block Event 1: the parameter 1 opens, ticks open the lid by a tenth, the tenth tick flips the status; the parameter 0 closes; a 2 changes nothing.
     MOVE 3 TO WS-X
     MOVE 1 TO WS-ACTION
     MOVE 1 TO WS-PARAM
     CALL "SHULKER-EVENT" USING CLIENT-STATE WS-X WS-Y WS-Z WS-ACTION WS-PARAM
     MOVE "acceptance shulker event 1 / 1: opening (status 1), ticks 0" TO TL-CASE
     COMPUTE TL-OBSERVED-N = SB-STATUS(1) * 100 + SB-T(1)
     MOVE 100 TO TL-EXPECTED-N
     PERFORM CHECK-N
     PERFORM 5 TIMES
         CALL "SHULKER-TICK" USING CLIENT-STATE
     END-PERFORM
     MOVE "acceptance shulker five ticks of opening: ticks 5, old 4, still opening" TO TL-CASE
     COMPUTE TL-OBSERVED-N = SB-STATUS(1) * 10000 + SB-T(1) * 100 + SB-TOLD(1)
     MOVE 10504 TO TL-EXPECTED-N
     PERFORM CHECK-N
     PERFORM 4 TIMES
         CALL "SHULKER-TICK" USING CLIENT-STATE
     END-PERFORM
     MOVE "acceptance shulker nine ticks of opening: ticks 9, still opening" TO TL-CASE
     COMPUTE TL-OBSERVED-N = SB-STATUS(1) * 100 + SB-T(1)
     MOVE 109 TO TL-EXPECTED-N
     PERFORM CHECK-N
     CALL "SHULKER-TICK" USING CLIENT-STATE
     MOVE "acceptance shulker the tenth tick of opening: opened (status 2), ticks 10" TO TL-CASE
     COMPUTE TL-OBSERVED-N = SB-STATUS(1) * 100 + SB-T(1)
     MOVE 210 TO TL-EXPECTED-N
     PERFORM CHECK-N
     CALL "SHULKER-TICK" USING CLIENT-STATE
     MOVE "acceptance shulker an opened box stays at 10" TO TL-CASE
     COMPUTE TL-OBSERVED-N = SB-STATUS(1) * 100 + SB-T(1)
     COMPUTE TL-EXPECTED-N = 210
     PERFORM CHECK-N
     MOVE 2 TO WS-PARAM
     CALL "SHULKER-EVENT" USING CLIENT-STATE WS-X WS-Y WS-Z WS-ACTION WS-PARAM
     MOVE "acceptance shulker event parameter 2 changes nothing" TO TL-CASE
     COMPUTE TL-OBSERVED-N = SB-STATUS(1) * 100 + SB-T(1)
     MOVE 210 TO TL-EXPECTED-N
     PERFORM CHECK-N
     MOVE 0 TO WS-PARAM
     CALL "SHULKER-EVENT" USING CLIENT-STATE WS-X WS-Y WS-Z WS-ACTION WS-PARAM
     MOVE "acceptance shulker event 1 / 0: closing (status 3)" TO TL-CASE
     MOVE 3 TO TL-EXPECTED-N
     MOVE SB-STATUS(1) TO TL-OBSERVED-N
     PERFORM CHECK-N
     PERFORM 9 TIMES
         CALL "SHULKER-TICK" USING CLIENT-STATE
     END-PERFORM
     MOVE "acceptance shulker nine ticks of closing: ticks 1, old 2, still closing" TO TL-CASE
     COMPUTE TL-OBSERVED-N = SB-STATUS(1) * 10000 + SB-T(1) * 100 + SB-TOLD(1)
     MOVE 30102 TO TL-EXPECTED-N
     PERFORM CHECK-N
     CALL "SHULKER-TICK" USING CLIENT-STATE
     MOVE "acceptance shulker the tenth tick of closing: closed (status 0), ticks 0" TO TL-CASE
     COMPUTE TL-OBSERVED-N = SB-STATUS(1) * 100 + SB-T(1)
     MOVE 0 TO TL-EXPECTED-N
     PERFORM CHECK-N
*>   The event of a block that is no shulker box or another action changes nothing.
     MOVE 9 TO WS-X
     MOVE 1 TO WS-PARAM
     CALL "SHULKER-EVENT" USING CLIENT-STATE WS-X WS-Y WS-Z WS-ACTION WS-PARAM
     MOVE "acceptance shulker an event at a place without a box adds none" TO TL-CASE
     MOVE 2 TO TL-EXPECTED-N
     MOVE SB-COUNT TO TL-OBSERVED-N
     PERFORM CHECK-N
     MOVE 3 TO WS-X
     MOVE 2 TO WS-ACTION
     CALL "SHULKER-EVENT" USING CLIENT-STATE WS-X WS-Y WS-Z WS-ACTION WS-PARAM
     MOVE "acceptance shulker another action id changes nothing" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE SB-STATUS(1) TO TL-OBSERVED-N
     PERFORM CHECK-N
*>   The packet: Block Event (0x07) with a position, the action 1, the parameter 1 and the block id of the box.
     MOVE PH-PLAY TO CN-PHASE(1)
     MOVE 1 TO WS-ACTION
     IF WS-READY = 0
         CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
         MOVE 1 TO WS-READY
     END-IF
     CALL "PB-RESET" USING PB-BUFFER
     MOVE 3 TO WS-X
     CALL "PB-PUT-POSITION" USING PB-BUFFER WS-X WS-Y WS-Z
     CALL "PB-PUT-UBYTE" USING PB-BUFFER WS-ONE
     CALL "PB-PUT-UBYTE" USING PB-BUFFER WS-ONE
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-ZERO
     MOVE 0 TO PB-POS
     CALL "PROTO-PACKET" USING CLIENT-STATE WS-CONN PB-BUFFER WS-PACKET-ID
     MOVE "acceptance shulker Block Event packet opens the box" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE SB-STATUS(1) TO TL-OBSERVED-N
     PERFORM CHECK-N
*>   The pose chain: the box is a lid and a base of 36 vertices each at the corners of the script; the tint is white.
     PERFORM VARYING WS-C FROM 1 BY 1 UNTIL WS-C > 6
         MOVE 0 TO SB-COUNT
         MOVE 0 TO SB-USED(1) SB-USED(2)
         MOVE WS-CELL-X(WS-C) TO WS-X
         MOVE WS-CELL-Y(WS-C) TO WS-Y
         MOVE WS-CELL-Z(WS-C) TO WS-Z
         COMPUTE WS-CHX = FUNCTION INTEGER(WS-X / 16)
         COMPUTE WS-CHZ = FUNCTION INTEGER(WS-Z / 16)
         CALL "WORLD-ROW-NEW" USING CLIENT-STATE WS-CHX WS-CHZ WS-NEWROW
         COMPUTE WS-K = WS-CFACE(WS-C) + 1
         CALL "WORLD-BLOCK-SET" USING CLIENT-STATE WS-X WS-Y WS-Z WS-SU(WS-K)
         MOVE WS-CTICKS(WS-C) TO SB-T(1)
         MOVE WS-CTICKS(WS-C) TO SB-TOLD(1)
         MOVE 1 TO SB-STATUS(1)
         MOVE 0 TO WS-FIRSTV
         MOVE 10 TO WS-EYE(1) WS-EYE(3)
         MOVE 64 TO WS-EYE(2)
         CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
         MOVE WS-C TO WS-CC
         MOVE SPACES TO TL-CASE
         STRING "acceptance shulker box " WS-CC " draws a lid and a base: 72 vertices" DELIMITED BY SIZE INTO TL-CASE
         MOVE 72 TO TL-EXPECTED-N
         MOVE RL-EN-COUNT TO TL-OBSERVED-N
         PERFORM CHECK-N
         PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 2
             MOVE 0 TO WS-MAXD
             PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 8
                 MOVE 0 TO WS-CV(WS-I)
             END-PERFORM
             PERFORM VARYING WS-V FROM 1 BY 1 UNTIL WS-V > 36
                 COMPUTE WS-P = (WS-K - 1) * 36 + WS-V
                 MOVE 1000000 TO WS-MIND
                 PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 8
                     COMPUTE WS-DIST = FUNCTION ABS(RL-EN-X(WS-P) - WS-CX(WS-C, WS-K, WS-I, 1)) + FUNCTION ABS(RL-EN-Y(WS-P) - WS-CX(WS-C, WS-K, WS-I, 2))
                         + FUNCTION ABS(RL-EN-Z(WS-P) - WS-CX(WS-C, WS-K, WS-I, 3))
                     IF WS-DIST < WS-MIND
                         MOVE WS-DIST TO WS-MIND
                     END-IF
                     IF WS-DIST < 0.003
                         MOVE 1 TO WS-CV(WS-I)
                     END-IF
                 END-PERFORM
                 IF WS-MIND > WS-MAXD
                     MOVE WS-MIND TO WS-MAXD
                 END-IF
             END-PERFORM
             MOVE 0 TO WS-HITS
             PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 8
                 ADD WS-CV(WS-I) TO WS-HITS
             END-PERFORM
             MOVE WS-K TO WS-KK
             MOVE SPACES TO TL-CASE
             STRING "acceptance shulker box " WS-CC " cuboid " WS-KK ": every vertex is a corner" DELIMITED BY SIZE INTO TL-CASE
             MOVE 1 TO TL-EXPECTED-N
             MOVE 0 TO TL-OBSERVED-N
             IF WS-MAXD < 0.003
                 MOVE 1 TO TL-OBSERVED-N
             END-IF
             PERFORM CHECK-N
             MOVE SPACES TO TL-CASE
             STRING "acceptance shulker box " WS-CC " cuboid " WS-KK ": all eight corners are used" DELIMITED BY SIZE INTO TL-CASE
             MOVE 8 TO TL-EXPECTED-N
             MOVE WS-HITS TO TL-OBSERVED-N
             PERFORM CHECK-N
         END-PERFORM
     END-PERFORM
*>   The image: the model row shulker_box takes an atlas slot for the colour (16 undyed).
     CALL "ENTITY-MODEL-FIND" USING WS-KEY24 WS-SM
     MOVE 0 TO WS-SLOTS
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > EA-MT-COUNT
         IF EA-MT-MODEL(WS-I) = WS-SM AND EA-MT-TEX(WS-I) = 7016
             ADD 1 TO WS-SLOTS
         END-IF
     END-PERFORM
     MOVE "acceptance shulker undyed texture has an atlas slot (code 7016)" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE WS-SLOTS TO TL-OBSERVED-N
     PERFORM CHECK-N
     MOVE "shulker_box" TO WS-KEY24
     MOVE 7014 TO WS-CODE
     MOVE SPACES TO WS-KEY
     CALL "ENTITY-TEX-PATH" USING WS-KEY24 WS-CODE WS-KEY
     MOVE "acceptance shulker red texture path" TO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE "textures/entity/shulker/shulker_red.png" TO TL-EXPECTED
     MOVE WS-KEY(1:64) TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 7016 TO WS-CODE
     MOVE SPACES TO WS-KEY
     CALL "ENTITY-TEX-PATH" USING WS-KEY24 WS-CODE WS-KEY
     MOVE "acceptance shulker undyed texture path" TO TL-CASE
     MOVE "textures/entity/shulker/shulker.png" TO TL-EXPECTED
     MOVE WS-KEY(1:64) TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "N" TO TL-MODE
*>   A box that is no longer there is dropped by the next tick; the chunk's forgetting drops its boxes; the dimension's clearing drops all.
     MOVE 0 TO SB-COUNT
     MOVE 0 TO SB-USED(1) SB-USED(2)
     MOVE 0 TO WS-CHX WS-CHZ
     CALL "WORLD-ROW-NEW" USING CLIENT-STATE WS-CHX WS-CHZ WS-NEWROW
     MOVE 3 TO WS-X
     MOVE 70 TO WS-Y
     MOVE 3 TO WS-Z
     CALL "WORLD-BLOCK-SET" USING CLIENT-STATE WS-X WS-Y WS-Z WS-SU(2)
     CALL "WORLD-BLOCK-SET" USING CLIENT-STATE WS-X WS-Y WS-Z WS-ZERO
     CALL "SHULKER-TICK" USING CLIENT-STATE
     MOVE "acceptance shulker a box whose block is gone is dropped by the tick" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE SB-COUNT TO TL-OBSERVED-N
     PERFORM CHECK-N
     CALL "WORLD-BLOCK-SET" USING CLIENT-STATE WS-X WS-Y WS-Z WS-SU(2)
     CALL "WORLD-FORGET" USING CLIENT-STATE WS-CHX WS-CHZ
     MOVE "acceptance shulker forgetting the chunk forgets its boxes" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE SB-COUNT TO TL-OBSERVED-N
     PERFORM CHECK-N
     CALL "WORLD-ROW-NEW" USING CLIENT-STATE WS-CHX WS-CHZ WS-NEWROW
     CALL "WORLD-BLOCK-SET" USING CLIENT-STATE WS-X WS-Y WS-Z WS-SU(2)
     CALL "WORLD-CLEAR" USING CLIENT-STATE
     MOVE "acceptance shulker clearing the world forgets every box" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE SB-COUNT TO TL-OBSERVED-N
     PERFORM CHECK-N
     STOP RUN.
 CHECK-N.
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-SHULKER-BOX.

 COPY CLTEST.
