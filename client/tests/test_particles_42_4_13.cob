*> Acceptance test of docs/protocol/42-particles-4-block-item-dust-ambient.md section 13 (`GlowParticle` family): the rules, table rows,
*> formulas and worked cases of the section with the document's numbers; every float case compares
*> the value times 100000 rounded. Draws are injected through the draw tables.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-PARTICLES-42-4-13.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CLPCL.
 COPY CLPCLX.
 COPY TESTLIB.
 01 WS-NAME                PIC X(160).
 01 WS-DRAWS.
    05 WS-D                FLOAT-LONG OCCURS 16 TIMES.
 01 WS-EDRAWS.
    05 WS-E                FLOAT-LONG OCCURS 16 TIMES.
 01 W1                     FLOAT-LONG.
 01 W2                     FLOAT-LONG.
 01 W3                     FLOAT-LONG.
 01 W4                     FLOAT-LONG.
 01 W5                     FLOAT-LONG.
 01 W6                     FLOAT-LONG.
 01 W7                     FLOAT-LONG.
 01 W8                     FLOAT-LONG.
 01 I1                     BINARY-LONG.
 01 I2                     BINARY-LONG.
 01 I3                     BINARY-LONG.
 01 I4                     BINARY-LONG.
 01 I5                     BINARY-LONG.
 01 B1                     BINARY-DOUBLE.
 01 T1                     PIC X(80).
 01 Z1                     FLOAT-LONG VALUE 0.
 01 Z2                     FLOAT-LONG VALUE 0.
 01 Z3                     FLOAT-LONG VALUE 0.
 01 Z4                     FLOAT-LONG VALUE 0.
 01 Z5                     FLOAT-LONG VALUE 0.
 01 Z6                     FLOAT-LONG VALUE 0.
 01 WS-KIND               BINARY-LONG.
 01 WS-LIGHT              BINARY-LONG.
 01 WS-EV                 BINARY-LONG.
 01 WS-DATA               BINARY-LONG.
 01 WS-PID                BINARY-LONG.
 01 WS-MODE               BINARY-LONG.
 01 WS-MIN                BINARY-LONG.
 01 WS-MAX                BINARY-LONG.
 01 WS-FOUND              BINARY-LONG.
 PROCEDURE DIVISION.
     PERFORM VARYING I1 FROM 1 BY 1 UNTIL I1 > 16
         MOVE 0.5 TO WS-D(I1)
         MOVE 0.5 TO WS-E(I1)
     END-PERFORM
     MOVE 0.5 TO W4
     MOVE 1.0 TO W5
     MOVE 0.5 TO W6
     MOVE 1 TO WS-KIND
     CALL "P4-GLOW-NEW" USING PCL Z1 Z2 Z3 W4 W5 W6 WS-KIND WS-DRAWS WS-EDRAWS
     MOVE "13.2 wax_on velocity x = vx * 0.01 / 2" TO WS-NAME
     MOVE 250 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-XD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "13.2 wax_on velocity y = vy * 0.01" TO WS-NAME
     MOVE 1000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-YD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "13.2 wax_on colour red 0.91" TO WS-NAME
     MOVE 91000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-RCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "13.2 wax_on colour blue 0.08" TO WS-NAME
     MOVE 8000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-BCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "13.2 wax_on lifetime nextInt(30) + 10 (0.5 gives 25)" TO WS-NAME
     MOVE 25 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-LIFETIME
     PERFORM ASSERT-NUMBER
     MOVE "13.1 friction 0.96" TO WS-NAME
     MOVE 96000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-FRICTION) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "13.1 no physics" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-HAS-PHYSICS
     PERFORM ASSERT-NUMBER
     MOVE "13.1 quad size * 0.75" TO WS-NAME
     MOVE 11250 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-QUAD-SIZE) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE 3 TO WS-KIND
     CALL "P4-GLOW-NEW" USING PCL Z1 Z2 Z3 W4 W5 W6 WS-KIND WS-DRAWS WS-EDRAWS
     MOVE "13.2 electric_spark velocity x = vx * 0.25" TO WS-NAME
     MOVE 12500 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-XD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "13.2 electric_spark lifetime nextInt(2) + 2 = 3" TO WS-NAME
     MOVE 3 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-LIFETIME
     PERFORM ASSERT-NUMBER
     MOVE 4 TO WS-KIND
     CALL "P4-GLOW-NEW" USING PCL Z1 Z2 Z3 W4 W5 W6 WS-KIND WS-DRAWS WS-EDRAWS
     MOVE "13.2 scrape colour for a true boolean: green 0.58" TO WS-NAME
     MOVE 58000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-GCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "13.2 scrape velocity x = vx * 0.01" TO WS-NAME
     MOVE 500 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-XD) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "13.2 scrape lifetime nextInt(30) + 10 = 25" TO WS-NAME
     MOVE 25 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-LIFETIME
     PERFORM ASSERT-NUMBER
     MOVE 0 TO WS-KIND
     CALL "P4-GLOW-NEW" USING PCL Z1 Z2 Z3 W4 W5 W6 WS-KIND WS-DRAWS WS-EDRAWS
     MOVE "13.2 glow colour for a true boolean: red 0.6" TO WS-NAME
     MOVE 60000 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER((PC-RCOL) * 100000 + 0.5)
     PERFORM ASSERT-NUMBER
     MOVE "13.2 glow lifetime (int)(8 / (0.5 * 0.8 + 0.2)) = 13" TO WS-NAME
     MOVE 13 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PC-LIFETIME
     PERFORM ASSERT-NUMBER
     MOVE 5 TO PC-AGE
     MOVE 10 TO PC-LIFETIME
     MOVE 15728640 TO WS-LIGHT
     MOVE 0 TO W7
     CALL "P4-GLOW-LIGHT" USING PCL WS-LIGHT W7 I1
     MOVE "13.1 light: block part grows by (age + partial) / lifetime * 240 (120 at half)" TO WS-NAME
     MOVE 15728760 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I1
     PERFORM ASSERT-NUMBER
     MOVE 5 TO PC-AGE
     MOVE 20 TO PC-LIFETIME
     CALL "P4-GLOW-LIGHT" USING PCL WS-LIGHT W7 I1
     MOVE "13.1 light at a quarter of the life adds 60" TO WS-NAME
     MOVE 15728700 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I1
     PERFORM ASSERT-NUMBER
     MOVE 30 TO PC-AGE
     CALL "P4-GLOW-LIGHT" USING PCL WS-LIGHT W7 I1
     MOVE "13.1 light is capped at the block value 240" TO WS-NAME
     MOVE 15728880 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = I1
     PERFORM ASSERT-NUMBER
     MOVE 3003 TO WS-EV
     MOVE 0 TO WS-DATA
     CALL "P4-LEVEL-EVENT" USING WS-EV WS-DATA WS-PID WS-MODE WS-MIN WS-MAX WS-FOUND
     MOVE "13.3 event 3003 spawns wax_on (111)" TO WS-NAME
     MOVE 111 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-PID
     PERFORM ASSERT-NUMBER
     MOVE "13.3 3003 is on the block faces" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-MODE
     PERFORM ASSERT-NUMBER
     MOVE "13.3 3003 minimum 3 per face" TO WS-NAME
     MOVE 3 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-MIN
     PERFORM ASSERT-NUMBER
     MOVE "13.3 3003 maximum 5 per face" TO WS-NAME
     MOVE 5 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-MAX
     PERFORM ASSERT-NUMBER
     MOVE 3004 TO WS-EV
     CALL "P4-LEVEL-EVENT" USING WS-EV WS-DATA WS-PID WS-MODE WS-MIN WS-MAX WS-FOUND
     MOVE "13.3 event 3004 spawns wax_off (112)" TO WS-NAME
     MOVE 112 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-PID
     PERFORM ASSERT-NUMBER
     MOVE 3005 TO WS-EV
     CALL "P4-LEVEL-EVENT" USING WS-EV WS-DATA WS-PID WS-MODE WS-MIN WS-MAX WS-FOUND
     MOVE "13.3 event 3005 spawns scrape (114)" TO WS-NAME
     MOVE 114 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-PID
     PERFORM ASSERT-NUMBER
     MOVE 3002 TO WS-EV
     MOVE 1 TO WS-DATA
     CALL "P4-LEVEL-EVENT" USING WS-EV WS-DATA WS-PID WS-MODE WS-MIN WS-MAX WS-FOUND
     MOVE "13.3 event 3002 spawns electric_spark (113)" TO WS-NAME
     MOVE 113 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-PID
     PERFORM ASSERT-NUMBER
     MOVE "13.3 3002 with data 0 to 2 runs along an axis" TO WS-NAME
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-MODE
     PERFORM ASSERT-NUMBER
     MOVE "13.3 3002 along an axis: 10 to 19" TO WS-NAME
     MOVE 10 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-MIN
     PERFORM ASSERT-NUMBER
     MOVE "13.3 3002 along an axis maximum 19" TO WS-NAME
     MOVE 19 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-MAX
     PERFORM ASSERT-NUMBER
     MOVE 3 TO WS-DATA
     CALL "P4-LEVEL-EVENT" USING WS-EV WS-DATA WS-PID WS-MODE WS-MIN WS-MAX WS-FOUND
     MOVE "13.3 3002 with any other data falls back to the faces" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-MODE
     PERFORM ASSERT-NUMBER
     MOVE "13.3 3002 fallback minimum 3" TO WS-NAME
     MOVE 3 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-MIN
     PERFORM ASSERT-NUMBER
     MOVE 3009 TO WS-EV
     CALL "P4-LEVEL-EVENT" USING WS-EV WS-DATA WS-PID WS-MODE WS-MIN WS-MAX WS-FOUND
     MOVE "13.3 event 3009 spawns egg_crack (116)" TO WS-NAME
     MOVE 116 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-PID
     PERFORM ASSERT-NUMBER
     MOVE "13.3 3009 maximum 6 per face" TO WS-NAME
     MOVE 6 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-MAX
     PERFORM ASSERT-NUMBER
     MOVE 9999 TO WS-EV
     CALL "P4-LEVEL-EVENT" USING WS-EV WS-DATA WS-PID WS-MODE WS-MIN WS-MAX WS-FOUND
     MOVE "13.3 an unrelated event is not handled here" TO WS-NAME
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-FOUND
     PERFORM ASSERT-NUMBER
     STOP RUN.

 ASSERT-NUMBER.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-4§13 `GlowParticle` family: " FUNCTION TRIM(WS-NAME)
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "N" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 ASSERT-TEXT.
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 42-4§13 `GlowParticle` family: " FUNCTION TRIM(WS-NAME)
         DELIMITED BY SIZE INTO TL-CASE
     MOVE "T" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-PARTICLES-42-4-13.
