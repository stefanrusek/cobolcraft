 PROCEDURE DIVISION.
     CALL "CL-INIT" USING CLIENT-STATE
     CALL "PACK-STACK-INIT" USING CLIENT-STATE
     ADD 1 TO PK-COUNT
     INITIALIZE PK-PACK(PK-COUNT)
     MOVE 1 TO PK-KIND(PK-COUNT)
     MOVE 3 TO PK-LEVEL(PK-COUNT)
     MOVE "generated/vanilla" TO PK-ID(PK-COUNT)
     MOVE 17 TO PK-ID-LENGTH(PK-COUNT)
     MOVE "client/tests/fixtures/mini-vanilla" TO PK-ROOT(PK-COUNT)
     MOVE 34 TO PK-ROOT-LENGTH(PK-COUNT)
     CALL "PACK-STACK-OPEN" USING CLIENT-STATE
     CALL "PACK-SOURCE-FILES" USING CLIENT-STATE PK-COUNT
     CALL "ATLAS-BUILD" USING CLIENT-STATE
     CALL "ENTITY-ATLAS-BUILD" USING CLIENT-STATE
     MOVE CT-TYPE-STANDARD TO CT-SET-TYPE
     CALL "CONTENT-SET-COUNTS"
     MOVE 1 TO CT-OPEN
     MOVE 256 TO PL-HEIGHT
     MOVE 0 TO SK-U
     MOVE 10 TO WS-EYE(1) WS-EYE(3)
     MOVE 64 TO WS-EYE(2)
     MOVE 1 TO CL-CAMERA
     MOVE "red_banner" TO WS-KEY
     CALL "CONTENT-ITEM-BY-KEY" USING WS-KEY WS-RED WS-ITEM-ROW WS-STATUS
     MOVE "N" TO TL-MODE
*>   A zombie with a red banner (stripe_bottom blue, border white) in its main hand: the atlas slots and the mesh.
     CALL "ENTITIES-CLEAR" USING CLIENT-STATE
     MOVE "zombie" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-TYPE WS-ROW-AREA WS-STATUS
     CALL "MM-SPAWN" USING CLIENT-STATE WS-ID WS-TYPE WS-X WS-Y WS-Z WS-YAW
     MOVE WS-RED TO EN-EQ(1, 1)
     MOVE 2 TO EN-HB-COUNT(1, 1)
     MOVE 32 TO EN-HB-PAT(1, 1, 1)
     MOVE 11 TO EN-HB-DYE(1, 1, 1)
     MOVE 2 TO EN-HB-PAT(1, 1, 2)
     MOVE 0 TO EN-HB-DYE(1, 1, 2)
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     MOVE "banner" TO WS-KEY
     CALL "ENTITY-MODEL-FIND" USING WS-KEY WS-ROW
     MOVE 0 TO WS-SLOTS
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > EA-MT-COUNT
         IF EA-MT-MODEL(WS-I) = WS-ROW
             ADD 1 TO WS-SLOTS
         END-IF
     END-PERFORM
     MOVE "acceptance mob banner takes four atlas slots (banner_base, base, two patterns)" TO TL-CASE
     MOVE 4 TO TL-EXPECTED-N
     MOVE WS-SLOTS TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "GROUND-ITEMS-MESH" USING CLIENT-STATE WS-EYE-TABLE
     MOVE "acceptance mob banner mesh: pole, bar, flag, base layer, two patterns: 6 cuboids of 36 vertices" TO TL-CASE
     MOVE 216 TO TL-EXPECTED-N
     MOVE RL-GI-COUNT TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   Without layers: pole, bar, flag and the base layer (the flag with the banner sprite, order 1 over it).
     MOVE 0 TO EN-HB-COUNT(1, 1)
     CALL "GROUND-ITEMS-MESH" USING CLIENT-STATE WS-EYE-TABLE
     MOVE "acceptance mob banner without patterns: 4 cuboids" TO TL-CASE
     MOVE 144 TO TL-EXPECTED-N
     MOVE RL-GI-COUNT TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   A banner in the off hand of a left-handed mob (the main hand's stack is in the left arm): its own layers (EN-HB of the main slot).
     MOVE 2 TO EN-MOB-FLAGS(1)
     MOVE 1 TO EN-HB-COUNT(1, 1)
     MOVE 5 TO EN-HB-PAT(1, 1, 1)
     MOVE 3 TO EN-HB-DYE(1, 1, 1)
     MOVE 0 TO EN-HB-COUNT(1, 2)
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     CALL "GROUND-ITEMS-MESH" USING CLIENT-STATE WS-EYE-TABLE
     MOVE "acceptance left-handed mob: the main hand's banner is in the left arm with its layers (5 cuboids)" TO TL-CASE
     MOVE 180 TO TL-EXPECTED-N
     MOVE RL-GI-COUNT TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   The pose chain on a frame set by hand: the identity axes at (0.5, 1, 0.25), both hands, two layers.
     CALL "ENTITIES-CLEAR" USING CLIENT-STATE
     MOVE 1 TO WS-ID
     MOVE "zombie" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-TYPE WS-ROW-AREA WS-STATUS
     CALL "MM-SPAWN" USING CLIENT-STATE WS-ID WS-TYPE WS-X WS-Y WS-Z WS-YAW
     MOVE 2 TO EN-HB-COUNT(1, 1) EN-HB-COUNT(1, 2)
     MOVE 32 TO EN-HB-PAT(1, 1, 1) EN-HB-PAT(1, 2, 1)
     MOVE 11 TO EN-HB-DYE(1, 1, 1) EN-HB-DYE(1, 2, 1)
     MOVE 2 TO EN-HB-PAT(1, 1, 2) EN-HB-PAT(1, 2, 2)
     MOVE 0 TO EN-HB-DYE(1, 1, 2) EN-HB-DYE(1, 2, 2)
     MOVE WS-RED TO EN-EQ(1, 1) EN-EQ(1, 2)
     PERFORM VARYING WS-HAND FROM 1 BY 1 UNTIL WS-HAND > 2
         MOVE 1 TO EN-HAND-FOK(1, WS-HAND)
         MOVE 0.5 TO EN-HAND-F(1, WS-HAND, 1)
         MOVE 1 TO EN-HAND-F(1, WS-HAND, 2)
         MOVE 0.25 TO EN-HAND-F(1, WS-HAND, 3)
         MOVE 0 TO EN-HAND-F(1, WS-HAND, 4) EN-HAND-F(1, WS-HAND, 5) EN-HAND-F(1, WS-HAND, 6)
         MOVE 0 TO EN-HAND-F(1, WS-HAND, 7) EN-HAND-F(1, WS-HAND, 8) EN-HAND-F(1, WS-HAND, 9)
         MOVE 0 TO EN-HAND-F(1, WS-HAND, 10) EN-HAND-F(1, WS-HAND, 11) EN-HAND-F(1, WS-HAND, 12)
         MOVE 1 TO EN-HAND-F(1, WS-HAND, 4) EN-HAND-F(1, WS-HAND, 8) EN-HAND-F(1, WS-HAND, 12)
     END-PERFORM
     PERFORM VARYING WS-HAND FROM 1 BY 1 UNTIL WS-HAND > 2
         MOVE 0 TO RL-GI-COUNT
         CALL "ENTITY-HELD-POSED" USING CLIENT-STATE WS-ID WS-HAND WS-RED WS-EYE-TABLE
         MOVE "acceptance banner held 6 cuboids of 36 vertices" TO TL-CASE
         MOVE 216 TO TL-EXPECTED-N
         MOVE RL-GI-COUNT TO TL-OBSERVED-N
         CALL "TEST-ASSERT" USING TESTLIB-ASSERT
         PERFORM VARYING WS-C FROM 1 BY 1 UNTIL WS-C > 5
             MOVE 0 TO WS-MAXD
             PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 8
                 MOVE 0 TO WS-COV(WS-K)
             END-PERFORM
             PERFORM VARYING WS-V FROM 1 BY 1 UNTIL WS-V > 36
                 COMPUTE WS-I = WS-FS(WS-C) + WS-V
                 MOVE 1000000 TO WS-MIND
                 PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 8
                     COMPUTE WS-DIST = FUNCTION ABS(RL-GI-X(WS-I) - WS-CX(WS-HAND, WS-C, WS-K, 1)) + FUNCTION ABS(RL-GI-Y(WS-I) - WS-CX(WS-HAND, WS-C, WS-K, 2))
                         + FUNCTION ABS(RL-GI-Z(WS-I) - WS-CX(WS-HAND, WS-C, WS-K, 3))
                     IF WS-DIST < WS-MIND
                         MOVE WS-DIST TO WS-MIND
                     END-IF
                     IF WS-DIST < 0.002
                         MOVE 1 TO WS-COV(WS-K)
                     END-IF
                 END-PERFORM
                 IF WS-MIND > WS-MAXD
                     MOVE WS-MIND TO WS-MAXD
                 END-IF
             END-PERFORM
             MOVE 0 TO WS-HITS
             PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 8
                 ADD WS-COV(WS-K) TO WS-HITS
             END-PERFORM
             MOVE SPACES TO TL-CASE
             MOVE WS-HAND TO WS-HD
             STRING "acceptance banner hand " WS-HD " " FUNCTION TRIM(WS-CN(WS-C)) ": every vertex is a corner of the box" DELIMITED BY SIZE INTO TL-CASE
             MOVE 1 TO TL-EXPECTED-N
             MOVE 0 TO TL-OBSERVED-N
             IF WS-MAXD < 0.002
                 MOVE 1 TO TL-OBSERVED-N
             END-IF
             CALL "TEST-ASSERT" USING TESTLIB-ASSERT
             MOVE SPACES TO TL-CASE
             MOVE WS-HAND TO WS-HD
             STRING "acceptance banner hand " WS-HD " " FUNCTION TRIM(WS-CN(WS-C)) ": all eight corners are used" DELIMITED BY SIZE INTO TL-CASE
             MOVE 8 TO TL-EXPECTED-N
             MOVE WS-HITS TO TL-OBSERVED-N
             CALL "TEST-ASSERT" USING TESTLIB-ASSERT
         END-PERFORM
     END-PERFORM
*>   The tint of the base colour layer (order 1): red, B02E26 (43 section 6.3); the pole is untinted.
     MOVE 0 TO RL-GI-COUNT
     MOVE 1 TO WS-HAND
     CALL "ENTITY-HELD-POSED" USING CLIENT-STATE WS-ID WS-HAND WS-RED WS-EYE-TABLE
     MOVE "acceptance banner tints: the pole is white" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF RL-GI-R(1) > 0.9999 AND RL-GI-G(1) > 0.9999 AND RL-GI-BLUE(1) > 0.9999
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance banner tints: the base layer is the red dye colour" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF FUNCTION ABS(RL-GI-R(109) - 0.6901961) < 0.001 AND FUNCTION ABS(RL-GI-G(109) - 0.1803922) < 0.001 AND FUNCTION ABS(RL-GI-BLUE(109) - 0.1490196) < 0.001
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.
 END PROGRAM TEST-ENTITY-BANNER.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. MM-SPAWN.
*> USING CLIENT-STATE, entity id, type (registry id), x y z (FLOAT-LONG), yaw (FLOAT-SHORT, also the head yaw): Add Entity.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY PROTO.
 01 WS-READY               BINARY-LONG VALUE 0.
 01 WS-CAPACITY            BINARY-LONG VALUE 1024.
 01 WS-ADD                 BINARY-LONG VALUE 1.
 01 WS-ZERO                BINARY-LONG VALUE 0.
 01 WS-UUID                PIC X(16) VALUE LOW-VALUES.
 01 WS-V0                  FLOAT-LONG VALUE 0.
 01 WS-V1                  FLOAT-LONG VALUE 0.
 01 WS-V2                  FLOAT-LONG VALUE 0.
 01 WS-A0                  FLOAT-SHORT VALUE 0.
 LINKAGE SECTION.
 COPY CLSTATE.
 01 L-ID                   BINARY-LONG.
 01 L-TYPE                 BINARY-LONG.
 01 L-X                    FLOAT-LONG.
 01 L-Y                    FLOAT-LONG.
 01 L-Z                    FLOAT-LONG.
 01 L-YAW                  FLOAT-SHORT.
 PROCEDURE DIVISION USING CLIENT-STATE L-ID L-TYPE L-X L-Y L-Z L-YAW.
     IF WS-READY = 0
         CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
         MOVE 1 TO WS-READY
     END-IF
     CALL "PB-RESET" USING PB-BUFFER
     CALL "PB-PUT-VARINT" USING PB-BUFFER L-ID
     CALL "PB-PUT-UUID" USING PB-BUFFER WS-UUID
     CALL "PB-PUT-VARINT" USING PB-BUFFER L-TYPE
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER L-X
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER L-Y
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER L-Z
     CALL "PB-PUT-LPVEC3" USING PB-BUFFER WS-V0 WS-V1 WS-V2
     CALL "PB-PUT-ANGLE" USING PB-BUFFER WS-A0
     CALL "PB-PUT-ANGLE" USING PB-BUFFER L-YAW
     CALL "PB-PUT-ANGLE" USING PB-BUFFER L-YAW
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-ZERO
     MOVE 0 TO PB-POS
     CALL "ENTITY-PACKET" USING CLIENT-STATE PB-BUFFER WS-ADD
     GOBACK.
 END PROGRAM MM-SPAWN.

 COPY CLTEST.
