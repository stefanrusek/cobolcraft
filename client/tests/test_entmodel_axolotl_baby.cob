    05 FILLER PIC X(9) VALUE "rot z".
    05 FILLER PIC X(9) VALUE "scale x".
    05 FILLER PIC X(9) VALUE "scale y".
    05 FILLER PIC X(9) VALUE "scale z".
 01 WS-LABELS REDEFINES WS-LABELS-DATA.
    05 WS-LABEL            PIC X(9) OCCURS 9 TIMES.
 01 WS-KEY                 PIC X(112).
 01 WS-ROW-AREA            PIC X(66).
 01 WS-STATUS              BINARY-LONG.
 01 WS-TYPE                BINARY-LONG.
 01 WS-X                   FLOAT-LONG VALUE 10.5.
 01 WS-Y                   FLOAT-LONG VALUE 64.
 01 WS-Z                   FLOAT-LONG VALUE 10.5.
 01 WS-YAW                 FLOAT-SHORT VALUE 0.
 01 WS-ID                  BINARY-LONG VALUE 1.
 01 WS-ROW                 BINARY-LONG.
 01 WS-BX                  BINARY-LONG.
 01 WS-BY                  BINARY-LONG.
 01 WS-BZ                  BINARY-LONG.
 01 WS-STATE               BINARY-LONG.
 01 WS-INDEX               BINARY-LONG.
 01 WS-SERIAL              BINARY-LONG.
 01 WS-INT                 BINARY-LONG.
 01 WS-INT2                BINARY-LONG.
 01 WS-INT3                BINARY-LONG.
 01 WS-LONG                BINARY-DOUBLE.
 01 WS-SUM1                FLOAT-LONG.
 01 WS-SUM2                FLOAT-LONG.
 01 WS-EYE-TABLE.
    05 WS-EYE              FLOAT-LONG OCCURS 3 TIMES.
 PROCEDURE DIVISION.
     CALL "CL-INIT" USING CLIENT-STATE
     MOVE 0 TO PK-COUNT
     CALL "ENTITY-ATLAS-BUILD" USING CLIENT-STATE
     MOVE 256 TO PL-HEIGHT
     MOVE 0 TO SK-U
     MOVE 10 TO WS-EYE(1) WS-EYE(3)
     MOVE 64 TO WS-EYE(2)
     MOVE 1 TO CT-OPEN
     MOVE CT-TYPE-STANDARD TO CT-SET-TYPE
*>   The definitions: lengths, looping and channel counts of Appendix A.1 (the channels that add nothing, a constant scale of 1 or an all-zero offset, are left out).
     PERFORM VARYING WS-C FROM 1 BY 1 UNTIL WS-C > 7
         PERFORM CLEAR-IO
         MOVE WS-DO(WS-C) TO WS-IV(1)
         CALL "EM3-ANIM-INFO" USING WS-IN WS-OUT
         MOVE SPACES TO TL-CASE
         MOVE WS-DO(WS-C) TO WS-CC
         STRING "acceptance baby axolotl definition " WS-CC " length" DELIMITED BY SIZE INTO TL-CASE
         COMPUTE WS-DIFF = WS-OV(1) - WS-DLEN(WS-C)
         PERFORM CHECK-SMALL
         MOVE SPACES TO TL-CASE
         STRING "acceptance baby axolotl definition " WS-CC " looping" DELIMITED BY SIZE INTO TL-CASE
         MOVE WS-OV(2) TO TL-OBSERVED-N
         MOVE WS-DLOOP(WS-C) TO TL-EXPECTED-N
         PERFORM CHECK-N
         MOVE SPACES TO TL-CASE
         STRING "acceptance baby axolotl definition " WS-CC " channels" DELIMITED BY SIZE INTO TL-CASE
         MOVE WS-OV(3) TO TL-OBSERVED-N
         MOVE WS-DCH(WS-C) TO TL-EXPECTED-N
         PERFORM CHECK-N
     END-PERFORM
*>   Keyframes typed from the document (the authoring conversions: rotation degrees to radians, position y negated).
     PERFORM VARYING WS-C FROM 1 BY 1 UNTIL WS-C > 5
         MOVE WS-KO(WS-C) TO WS-ORD
         MOVE WS-KB(WS-C) TO WS-BN
         MOVE WS-KT(WS-C) TO WS-TG
         MOVE 0 TO WS-FOUND
         PERFORM VARYING WS-CH FROM 1 BY 1 UNTIL WS-CH > 24
             CALL "EM3-ANIM-BONE" USING WS-ORD WS-CH WS-BN2 WS-J WS-NK
             IF WS-BN2 = WS-BN AND WS-J = WS-TG AND WS-FOUND = 0
                 MOVE WS-CH TO WS-FOUND
             END-IF
         END-PERFORM
         MOVE SPACES TO TL-CASE
         MOVE WS-C TO WS-CC
         STRING "acceptance baby axolotl keyframe " WS-CC " channel exists" DELIMITED BY SIZE INTO TL-CASE
         MOVE 1 TO TL-EXPECTED-N
         MOVE 0 TO TL-OBSERVED-N
         IF WS-FOUND > 0
             MOVE 1 TO TL-OBSERVED-N
         END-IF
         PERFORM CHECK-N
         IF WS-FOUND > 0
             PERFORM CLEAR-IO
             MOVE WS-ORD TO WS-IV(1)
             MOVE WS-FOUND TO WS-IV(2)
             MOVE WS-KTIME(WS-C) TO WS-IV(3)
             MOVE 1 TO WS-IV(4)
             CALL "EM3-ANIM-EVAL" USING WS-IN WS-OUT
             MOVE SPACES TO TL-CASE
             STRING "acceptance baby axolotl keyframe " WS-CC " x" DELIMITED BY SIZE INTO TL-CASE
             COMPUTE WS-DIFF = WS-OV(1) - WS-KX(WS-C)
             PERFORM CHECK-SMALL
             MOVE SPACES TO TL-CASE
             STRING "acceptance baby axolotl keyframe " WS-CC " y" DELIMITED BY SIZE INTO TL-CASE
             COMPUTE WS-DIFF = WS-OV(2) - WS-KY(WS-C)
             PERFORM CHECK-SMALL
             MOVE SPACES TO TL-CASE
             STRING "acceptance baby axolotl keyframe " WS-CC " z" DELIMITED BY SIZE INTO TL-CASE
             COMPUTE WS-DIFF = WS-OV(3) - WS-KZ(WS-C)
             PERFORM CHECK-SMALL
         END-IF
     END-PERFORM
*>   The pose program on the cases.
     PERFORM VARYING WS-C FROM 1 BY 1 UNTIL WS-C > 8
         CALL "EF8-LAYER" USING EMM-MODEL WS-LAYER WS-OK
         PERFORM CLEAR-IO
         MOVE WS-CIN(WS-C, 2) TO WS-IV(1)
         MOVE WS-CIN(WS-C, 3) TO WS-IV(2)
         MOVE WS-CIN(WS-C, 4) TO WS-IV(3)
         MOVE WS-CIN(WS-C, 1) TO WS-IV(4)
         MOVE WS-CIN(WS-C, 5) TO WS-IV(5)
         CALL "EF8-BABY-AXOLOTL-ANIM" USING EMM-MODEL WS-IN
         PERFORM VARYING WS-B FROM 1 BY 1 UNTIL WS-B > 10
             MOVE WS-BONE(WS-B) TO WS-BN
             CALL "EMM-FIND" USING EMM-MODEL WS-BN WS-P
             PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 9
                 EVALUATE WS-K
                     WHEN 1
                         COMPUTE WS-PART = MM-CX(WS-P) - MM-X(WS-P)
                     WHEN 2
                         COMPUTE WS-PART = MM-CY(WS-P) - MM-Y(WS-P)
                     WHEN 3
                         COMPUTE WS-PART = MM-CZ(WS-P) - MM-Z(WS-P)
                     WHEN 4
                         COMPUTE WS-PART = MM-CXROT(WS-P) - MM-XROT(WS-P)
                     WHEN 5
                         COMPUTE WS-PART = MM-CYROT(WS-P) - MM-YROT(WS-P)
                     WHEN 6
                         COMPUTE WS-PART = MM-CZROT(WS-P) - MM-ZROT(WS-P)
                     WHEN 7
                         COMPUTE WS-PART = MM-CXSCALE(WS-P) - MM-XSCALE(WS-P)
                     WHEN 8
                         COMPUTE WS-PART = MM-CYSCALE(WS-P) - MM-YSCALE(WS-P)
                     WHEN OTHER
                         COMPUTE WS-PART = MM-CZSCALE(WS-P) - MM-ZSCALE(WS-P)
                 END-EVALUATE
                 COMPUTE WS-DIFF = WS-PART - WS-CV(WS-C, WS-B, WS-K)
                 MOVE SPACES TO TL-CASE
                 MOVE WS-C TO WS-CC
                 STRING "acceptance baby axolotl case " WS-CC " " FUNCTION TRIM(WS-BONE(WS-B)) " " FUNCTION TRIM(WS-LABEL(WS-K)) DELIMITED BY SIZE INTO TL-CASE
                 PERFORM CHECK-SMALL
             END-PERFORM
         END-PERFORM
     END-PERFORM
*>   The replica: water at (10, 64, 10) only; a baby chooses one animation state (4.5).
     CALL "STATE-TABLES-ENSURE" USING CLIENT-STATE
     MOVE 1 TO ST-FLUID(5)
     MOVE 0 TO ST-LEVEL(5) ST-OPAQUE(5)
     MOVE 4 TO WS-STATE
     MOVE 10 TO WS-BX WS-BZ
     MOVE 64 TO WS-BY
     CALL "TEST-SET-BLOCK" USING CLIENT-STATE WS-BX WS-BY WS-BZ WS-STATE
     CALL "ENTITIES-CLEAR" USING CLIENT-STATE
     MOVE "axolotl" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-TYPE WS-ROW-AREA WS-STATUS
     CALL "MM-SPAWN" USING CLIENT-STATE WS-ID WS-TYPE WS-X WS-Y WS-Z WS-YAW
     MOVE 1 TO EN-BABY(1)
     CALL "ENTITIES-ANIM-TICK" USING CLIENT-STATE
     CALL "ENTITIES-ANIM-TICK" USING CLIENT-STATE
     MOVE "acceptance baby axolotl in water, still: idle underwater (4) from tick 0" TO TL-CASE
     PERFORM STATE-CODE
     MOVE 40 TO TL-EXPECTED-N
     PERFORM CHECK-N
     MOVE 1 TO EN-ON-GROUND(1)
     CALL "ENTITIES-ANIM-TICK" USING CLIENT-STATE
     MOVE "acceptance baby axolotl in water on the ground: idle underwater on ground (5) from tick 2" TO TL-CASE
     PERFORM STATE-CODE
     MOVE 52 TO TL-EXPECTED-N
     PERFORM CHECK-N
     MOVE 80 TO EN-Y(1)
     MOVE 80 TO EN-OY(1)
     CALL "ENTITIES-ANIM-TICK" USING CLIENT-STATE
     MOVE "acceptance baby axolotl on the ground out of water, still: idle on ground (6) from tick 3" TO TL-CASE
     PERFORM STATE-CODE
     MOVE 63 TO TL-EXPECTED-N
     PERFORM CHECK-N
     COMPUTE EN-X(1) = EN-X(1) + 0.5
     CALL "ENTITIES-ANIM-TICK" USING CLIENT-STATE
     MOVE "acceptance baby axolotl walking on the ground: walk (2) from tick 4" TO TL-CASE
     PERFORM STATE-CODE
     MOVE 24 TO TL-EXPECTED-N
     PERFORM CHECK-N
     MOVE 64 TO EN-Y(1)
     MOVE 64 TO EN-OY(1)
     MOVE 10.2 TO EN-X(1)
     MOVE 10.2 TO EN-OX(1)
     MOVE 0 TO EN-ON-GROUND(1)
     COMPUTE EN-X(1) = EN-X(1) + 0.25
     CALL "ENTITIES-ANIM-TICK" USING CLIENT-STATE
     MOVE "acceptance baby axolotl swimming: swim (1) from tick 5" TO TL-CASE
     PERFORM STATE-CODE
     MOVE 15 TO TL-EXPECTED-N
     PERFORM CHECK-N
     MOVE 1 TO EN-ON-GROUND(1)
     COMPUTE EN-X(1) = EN-X(1) - 0.25
     CALL "ENTITIES-ANIM-TICK" USING CLIENT-STATE
     MOVE "acceptance baby axolotl walking in water on the ground: walk underwater (3) from tick 6" TO TL-CASE
     PERFORM STATE-CODE
     MOVE 36 TO TL-EXPECTED-N
     PERFORM CHECK-N
     MOVE 19 TO WS-INDEX
     MOVE 8 TO WS-SERIAL
     MOVE 1 TO WS-INT
     MOVE 0 TO WS-INT2 WS-INT3 WS-LONG
     CALL "ENTITY-VARIANT-SET" USING CLIENT-STATE WS-ID WS-INDEX WS-SERIAL WS-INT WS-INT2 WS-INT3 WS-LONG
     CALL "ENTITIES-ANIM-TICK" USING CLIENT-STATE
     MOVE "acceptance baby axolotl playing dead: play dead (7) from tick 7" TO TL-CASE
     PERFORM STATE-CODE
     MOVE 77 TO TL-EXPECTED-N
     PERFORM CHECK-N
*>   An adult chooses no animation state.
     CALL "ENTITIES-CLEAR" USING CLIENT-STATE
     CALL "MM-SPAWN" USING CLIENT-STATE WS-ID WS-TYPE WS-X WS-Y WS-Z WS-YAW
     CALL "ENTITIES-ANIM-TICK" USING CLIENT-STATE
     MOVE "acceptance baby axolotl an adult has no animation state" TO TL-CASE
     PERFORM STATE-CODE
     MOVE 0 TO TL-EXPECTED-N
     PERFORM CHECK-N
*>   The mesh of a baby follows the state and the age: idle underwater at two ages, then the other states.
     CALL "ENTITIES-CLEAR" USING CLIENT-STATE
     CALL "MM-SPAWN" USING CLIENT-STATE WS-ID WS-TYPE WS-X WS-Y WS-Z WS-YAW
     MOVE 1 TO EN-BABY(1)
     MOVE 4 TO EN-AX-BS(1)
     MOVE 0 TO EN-AX-BT(1)
     MOVE 10 TO EN-AGE(1)
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     PERFORM SUM-MESH
     MOVE WS-SUM2 TO WS-SUM1
     MOVE "acceptance baby axolotl drawn" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF RL-EN-COUNT > 0
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     PERFORM CHECK-N
     MOVE 37 TO EN-AGE(1)
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     PERFORM SUM-MESH
     MOVE "acceptance baby axolotl idle underwater animates with the age" TO TL-CASE
     COMPUTE WS-DIFF = WS-SUM2 - WS-SUM1
     PERFORM CHECK-OTHER
     MOVE WS-SUM2 TO WS-SUM1
     MOVE 7 TO EN-AX-BS(1)
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     PERFORM SUM-MESH
     MOVE "acceptance baby axolotl playing dead is posed differently from idle underwater" TO TL-CASE
     COMPUTE WS-DIFF = WS-SUM2 - WS-SUM1
     PERFORM CHECK-OTHER
     MOVE WS-SUM2 TO WS-SUM1
     MOVE 0 TO EN-AX-BS(1)
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     PERFORM SUM-MESH
     MOVE "acceptance baby axolotl without a state is posed differently from playing dead" TO TL-CASE
     COMPUTE WS-DIFF = WS-SUM2 - WS-SUM1
     PERFORM CHECK-OTHER
     STOP RUN.
 CLEAR-IO.
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > 16
         MOVE 0 TO WS-IV(WS-J)
     END-PERFORM
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > 64
         MOVE 0 TO WS-OV(WS-J)
     END-PERFORM.
 STATE-CODE.
     COMPUTE TL-OBSERVED-N = EN-AX-BS(1) * 10 + EN-AX-BT(1).
 SUM-MESH.
     MOVE 0 TO WS-SUM2
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > RL-EN-COUNT
         COMPUTE WS-SUM2 = WS-SUM2 + (RL-EN-Y(WS-J) + RL-EN-X(WS-J) * 2 + RL-EN-Z(WS-J) * 3) * WS-J
     END-PERFORM.
 CHECK-SMALL.
     MOVE "N" TO TL-MODE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF WS-DIFF < 0.00001 AND WS-DIFF > -0.00001
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 CHECK-OTHER.
     MOVE "N" TO TL-MODE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF WS-DIFF > 0.001 OR WS-DIFF < -0.001
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 CHECK-N.
     MOVE "N" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-ENTMODEL-AXOLOTL-BABY.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. MM-SPAWN.
*> USING CLIENT-STATE, entity id, type (registry id), x y z (FLOAT-LONG), yaw (FLOAT-SHORT, also the head yaw): Add Entity.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY PROTO.
 01 WS-READY               BINARY-LONG VALUE 0.
 01 WS-CAPACITY            BINARY-LONG VALUE 1024.
 01 WS-ADD                 BINARY-LONG VALUE 1.
 01 WS-ZERO                BINARY-LONG VALUE 0.
 01 WS-UUID                PIC X(16) VALUE LOW-VALUES.
 01 WS-V0                  FLOAT-LONG VALUE 0.
 01 WS-V1                  FLOAT-LONG VALUE 0.
 01 WS-V2                  FLOAT-LONG VALUE 0.
 01 WS-A0                  FLOAT-SHORT VALUE 0.
 LINKAGE SECTION.
 COPY CLSTATE.
 01 L-ID                   BINARY-LONG.
 01 L-TYPE                 BINARY-LONG.
 01 L-X                    FLOAT-LONG.
 01 L-Y                    FLOAT-LONG.
 01 L-Z                    FLOAT-LONG.
 01 L-YAW                  FLOAT-SHORT.
 PROCEDURE DIVISION USING CLIENT-STATE L-ID L-TYPE L-X L-Y L-Z L-YAW.
     IF WS-READY = 0
         CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
         MOVE 1 TO WS-READY
     END-IF
     CALL "PB-RESET" USING PB-BUFFER
     CALL "PB-PUT-VARINT" USING PB-BUFFER L-ID
     CALL "PB-PUT-UUID" USING PB-BUFFER WS-UUID
     CALL "PB-PUT-VARINT" USING PB-BUFFER L-TYPE
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER L-X
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER L-Y
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER L-Z
     CALL "PB-PUT-LPVEC3" USING PB-BUFFER WS-V0 WS-V1 WS-V2
     CALL "PB-PUT-ANGLE" USING PB-BUFFER WS-A0
     CALL "PB-PUT-ANGLE" USING PB-BUFFER L-YAW
     CALL "PB-PUT-ANGLE" USING PB-BUFFER L-YAW
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-ZERO
     MOVE 0 TO PB-POS
     CALL "ENTITY-PACKET" USING CLIENT-STATE PB-BUFFER WS-ADD
     GOBACK.
 END PROGRAM MM-SPAWN.



 COPY CLTEST.
