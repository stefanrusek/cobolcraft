*> Acceptance test of docs/protocol/43-tint-sources.md section 8 (dye colours): all 16 rows of the
*> table, the diffuse and text colours opaque and the firework colour raw RGB, the map colour names
*> and their terracotta variants, ids in declaration order.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-TINT-43-8.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 01 WS-DIFFUSE             PIC X(96) VALUE
     "F9FFFEF9801DC74EBD3AB3DAFED83D80C71FF38BAA474F529D9D97169C9C8932B83C44AA8354325E7C16B02E261D1D21".
 01 WS-DIFFUSE-R REDEFINES WS-DIFFUSE.
    05 WS-DIF              PIC X(6) OCCURS 16 TIMES.
 01 WS-FIREWORK            PIC X(96) VALUE
     "F0F0F0EB8844C354CD6689D3DECF2A41CD34D88198434343ABABAB2876977B2FBE25319251301A3B511AB3312C1E1B1B".
 01 WS-FIREWORK-R REDEFINES WS-FIREWORK.
    05 WS-FW               PIC X(6) OCCURS 16 TIMES.
 01 WS-TEXT                PIC X(96) VALUE
     "FFFFFFFF681FFF00FF9AC0CDFFFF00BFFF00FF69B4808080D3D3D300FFFFA020F00000FF8B451300FF00FF0000000000".
 01 WS-TEXT-R REDEFINES WS-TEXT.
    05 WS-TX               PIC X(6) OCCURS 16 TIMES.
 01 WS-MAPNAMES            PIC X(384) VALUE
     "SNOW                    COLOR_ORANGE            COLOR_MAGENTA           " &
     "COLOR_LIGHT_BLUE        COLOR_YELLOW            COLOR_LIGHT_GREEN       " &
     "COLOR_PINK              COLOR_GRAY              COLOR_LIGHT_GRAY        " &
     "COLOR_CYAN              COLOR_PURPLE            COLOR_BLUE              " &
     "COLOR_BROWN             COLOR_GREEN             COLOR_RED               " &
     "COLOR_BLACK             ".
 01 WS-MAPNAMES-R REDEFINES WS-MAPNAMES.
    05 WS-MN               PIC X(24) OCCURS 16 TIMES.
 01 WS-TERRA               PIC X(384) VALUE
     "TERRACOTTA_WHITE        TERRACOTTA_ORANGE       TERRACOTTA_MAGENTA      " &
     "TERRACOTTA_LIGHT_BLUE   TERRACOTTA_YELLOW       TERRACOTTA_LIGHT_GREEN  " &
     "TERRACOTTA_PINK         TERRACOTTA_GRAY         TERRACOTTA_LIGHT_GRAY   " &
     "TERRACOTTA_CYAN         TERRACOTTA_PURPLE       TERRACOTTA_BLUE         " &
     "TERRACOTTA_BROWN        TERRACOTTA_GREEN        TERRACOTTA_RED          " &
     "TERRACOTTA_BLACK        ".
 01 WS-TERRA-R REDEFINES WS-TERRA.
    05 WS-TN               PIC X(24) OCCURS 16 TIMES.
 01 WS-ID                  BINARY-LONG.
 01 WS-COLUMN              BINARY-LONG.
 01 WS-COLOUR              BINARY-DOUBLE.
 01 WS-VARIANT             BINARY-LONG.
 01 WS-NAME                PIC X(24).
 01 WS-CASE                PIC X(240).
 01 WS-EXPECT              PIC X(8).
 01 WS-DI                  PIC 99.
 PROCEDURE DIVISION.
     PERFORM VARYING WS-ID FROM 0 BY 1 UNTIL WS-ID > 15
         MOVE WS-ID TO WS-DI
         MOVE 1 TO WS-COLUMN
         CALL "TINT-DYE" USING WS-ID WS-COLUMN WS-COLOUR
         MOVE SPACES TO WS-CASE WS-EXPECT
         STRING "acceptance US11 43§8 Dye colours: diffuse of dye " WS-DI DELIMITED BY SIZE
             INTO WS-CASE
         STRING "FF" WS-DIF(WS-ID + 1) DELIMITED BY SIZE INTO WS-EXPECT
         CALL "TINT-CHECK" USING WS-CASE WS-EXPECT WS-COLOUR
         MOVE 2 TO WS-COLUMN
         CALL "TINT-DYE" USING WS-ID WS-COLUMN WS-COLOUR
         MOVE SPACES TO WS-CASE WS-EXPECT
         STRING "acceptance US11 43§8 Dye colours: firework of dye " WS-DI DELIMITED BY SIZE
             INTO WS-CASE
         STRING "00" WS-FW(WS-ID + 1) DELIMITED BY SIZE INTO WS-EXPECT
         CALL "TINT-CHECK" USING WS-CASE WS-EXPECT WS-COLOUR
         MOVE 3 TO WS-COLUMN
         CALL "TINT-DYE" USING WS-ID WS-COLUMN WS-COLOUR
         MOVE SPACES TO WS-CASE WS-EXPECT
         STRING "acceptance US11 43§8 Dye colours: text of dye " WS-DI DELIMITED BY SIZE
             INTO WS-CASE
         STRING "FF" WS-TX(WS-ID + 1) DELIMITED BY SIZE INTO WS-EXPECT
         CALL "TINT-CHECK" USING WS-CASE WS-EXPECT WS-COLOUR
         MOVE 0 TO WS-VARIANT
         CALL "TINT-DYE-MAP" USING WS-ID WS-VARIANT WS-NAME
         MOVE "acceptance US11 43§8 Dye colours: map colour name" TO TL-CASE
         MOVE "T" TO TL-MODE
         MOVE WS-MN(WS-ID + 1) TO TL-EXPECTED
         MOVE WS-NAME TO TL-OBSERVED
         CALL "TEST-ASSERT" USING TESTLIB-ASSERT
         MOVE 1 TO WS-VARIANT
         CALL "TINT-DYE-MAP" USING WS-ID WS-VARIANT WS-NAME
         MOVE "acceptance US11 43§8 Dye colours: terracotta map colour name" TO TL-CASE
         MOVE WS-TN(WS-ID + 1) TO TL-EXPECTED
         MOVE WS-NAME TO TL-OBSERVED
         CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     END-PERFORM
*>   An id outside 0 to 15 has no colour.
     MOVE 16 TO WS-ID
     MOVE 1 TO WS-COLUMN
     CALL "TINT-DYE" USING WS-ID WS-COLUMN WS-COLOUR
     MOVE "acceptance US11 43§8 Dye colours: id 16 is colour 0" TO WS-CASE
     MOVE "00000000" TO WS-EXPECT
     CALL "TINT-CHECK" USING WS-CASE WS-EXPECT WS-COLOUR
     CALL "TINT-DYE-MAP" USING WS-ID WS-VARIANT WS-NAME
     MOVE "acceptance US11 43§8 Dye colours: id 16 has no map colour" TO TL-CASE
     MOVE SPACES TO TL-EXPECTED
     MOVE "NONE" TO TL-EXPECTED
     MOVE WS-NAME TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.
 END PROGRAM TEST-TINT-43-8.
 COPY TINTTEST.
