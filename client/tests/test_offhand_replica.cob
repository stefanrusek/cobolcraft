*> Implementation test of the off-hand slot of client/src/inventory-replica.cob (13 §4; 05a Container Set Content 0x12 entry 45, Container Set
*> Slot 0x14 slot 45, 05b Set Player Inventory 0x6E slot 40): each keeps the off-hand stack; the same packets of another container leave it.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-OFFHAND-REPLICA.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CLSTATE.
 COPY PROTO.
 COPY TESTLIB.
 01 WS-CAPACITY            BINARY-LONG VALUE 4096.
 01 WS-ID                  BINARY-LONG.
 01 WS-V                   BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 PROCEDURE DIVISION.
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     CALL "CL-INIT" USING CLIENT-STATE
     MOVE "N" TO TL-MODE
*>   Container Set Slot, container 0, slot 45: 7 of item 4.
     CALL "PB-RESET" USING PB-BUFFER
     MOVE 0 TO WS-V
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-V
     MOVE 3 TO WS-V
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-V
     MOVE 45 TO WS-V
     CALL "PB-PUT-SHORT" USING PB-BUFFER WS-V
     MOVE 7 TO PB-IS-COUNT
     MOVE 4 TO PB-IS-ITEM
     CALL "PB-PUT-ITEMSTACK" USING PB-BUFFER PB-ITEMSTACK
     MOVE 20 TO WS-ID
     CALL "INVENTORY-PACKET" USING CLIENT-STATE PB-BUFFER WS-ID
     MOVE "offhand replica Container Set Slot 45 sets the off hand: 7 x item 4" TO TL-CASE
     MOVE 704 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PL-OFFHAND-COUNT * 100 + PL-OFFHAND-ITEM
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   Set Player Inventory slot 40: 2 of item 5.
     CALL "PB-RESET" USING PB-BUFFER
     MOVE 40 TO WS-V
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-V
     MOVE 2 TO PB-IS-COUNT
     MOVE 5 TO PB-IS-ITEM
     CALL "PB-PUT-ITEMSTACK" USING PB-BUFFER PB-ITEMSTACK
     MOVE 110 TO WS-ID
     CALL "INVENTORY-PACKET" USING CLIENT-STATE PB-BUFFER WS-ID
     MOVE "offhand replica Set Player Inventory 40 sets the off hand: 2 x item 5" TO TL-CASE
     MOVE 205 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PL-OFFHAND-COUNT * 100 + PL-OFFHAND-ITEM
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   Container Set Content, container 0: 46 slots, the 46th is the off hand: 9 of item 6; the cursor empty.
     CALL "PB-RESET" USING PB-BUFFER
     MOVE 0 TO WS-V
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-V
     MOVE 4 TO WS-V
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-V
     MOVE 46 TO WS-V
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-V
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 46
         MOVE 0 TO PB-IS-COUNT
         IF WS-I = 46
             MOVE 9 TO PB-IS-COUNT
             MOVE 6 TO PB-IS-ITEM
         END-IF
         CALL "PB-PUT-ITEMSTACK" USING PB-BUFFER PB-ITEMSTACK
     END-PERFORM
     MOVE 0 TO PB-IS-COUNT
     CALL "PB-PUT-ITEMSTACK" USING PB-BUFFER PB-ITEMSTACK
     MOVE 18 TO WS-ID
     CALL "INVENTORY-PACKET" USING CLIENT-STATE PB-BUFFER WS-ID
     MOVE "offhand replica Container Set Content entry 46 sets the off hand: 9 x item 6" TO TL-CASE
     MOVE 906 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PL-OFFHAND-COUNT * 100 + PL-OFFHAND-ITEM
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   Container Set Slot of another container 45: ignored.
     CALL "PB-RESET" USING PB-BUFFER
     MOVE 1 TO WS-V
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-V
     MOVE 3 TO WS-V
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-V
     MOVE 45 TO WS-V
     CALL "PB-PUT-SHORT" USING PB-BUFFER WS-V
     MOVE 1 TO PB-IS-COUNT
     MOVE 1 TO PB-IS-ITEM
     CALL "PB-PUT-ITEMSTACK" USING PB-BUFFER PB-ITEMSTACK
     MOVE 20 TO WS-ID
     CALL "INVENTORY-PACKET" USING CLIENT-STATE PB-BUFFER WS-ID
     MOVE "offhand replica a Container Set Slot 45 of container 1 leaves the off hand as it was" TO TL-CASE
     MOVE 906 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PL-OFFHAND-COUNT * 100 + PL-OFFHAND-ITEM
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.
 END PROGRAM TEST-OFFHAND-REPLICA.

 COPY CLTEST.
