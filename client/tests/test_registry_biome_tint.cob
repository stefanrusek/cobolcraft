*> Implementation test of the biome colour data of REGISTRY-READ (client/src/protocol-config.cob; 04 section 6
*> biome codec, 43 section 5): a Registry Data packet of two biomes whose effects use an Int colour, a
*> "#RRGGBB" String, a grass colour modifier and fields the client skips fills the biome colour table
*> (TINT-BIOME-SET under the registry index) and TT-PLAINS names minecraft:plains.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-REGISTRY-BIOME-TINT.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CLSTATE.
 COPY CLCONST.
 COPY CLTINT.
 COPY PROTO.
 COPY TESTLIB.
 01 WS-CAPACITY            BINARY-LONG VALUE 4096.
 01 WS-NAME                PIC X(64).
 01 WS-LEN                 BINARY-LONG.
 01 WS-NEG2                BINARY-LONG VALUE -2.
 01 WS-NEG1                BINARY-LONG VALUE -1.
 01 WS-ONE                 BINARY-LONG VALUE 1.
 01 WS-TWO                 BINARY-LONG VALUE 2.
 01 WS-FIVE                BINARY-LONG VALUE 5.
 01 WS-INT                 BINARY-LONG.
 01 WS-FLOAT               FLOAT-SHORT.
 01 WS-KEY                 PIC X(32).
 01 WS-KEY-LENGTH          BINARY-LONG.
 01 WS-TEXT                PIC X(64).
 01 WS-TEXT-LENGTH         BINARY-LONG.
 01 WS-KIND                BINARY-LONG VALUE 1.
 01 WS-OK                  BINARY-LONG.
 01 WS-EXPECT-WATER        BINARY-DOUBLE.
 01 WS-EXPECT-GRASS        BINARY-DOUBLE.
 PROCEDURE DIVISION.
     CALL "CL-INIT" USING CLIENT-STATE
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     MOVE "minecraft:worldgen/biome" TO WS-NAME
     MOVE 24 TO WS-LEN
     CALL "PB-PUT-IDENTIFIER" USING PB-BUFFER WS-NAME WS-LEN
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-TWO
*>   Entry 1: minecraft:plains.
     MOVE "minecraft:plains" TO WS-NAME
     MOVE 16 TO WS-LEN
     CALL "PB-PUT-IDENTIFIER" USING PB-BUFFER WS-NAME WS-LEN
     CALL "PB-PUT-BOOL" USING PB-BUFFER WS-ONE
     MOVE SPACE TO WS-KEY
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WS-KEY WS-NEG2
     MOVE "has_precipitation" TO WS-KEY
     MOVE 17 TO WS-KEY-LENGTH
     CALL "NBT-WRITE-BYTE" USING PB-BUFFER WS-KEY WS-KEY-LENGTH WS-ONE
     MOVE "temperature" TO WS-KEY
     MOVE 11 TO WS-KEY-LENGTH
     MOVE 0.8 TO WS-FLOAT
     CALL "NBT-WRITE-FLOAT" USING PB-BUFFER WS-KEY WS-KEY-LENGTH WS-FLOAT
     MOVE "downfall" TO WS-KEY
     MOVE 8 TO WS-KEY-LENGTH
     MOVE 0.4 TO WS-FLOAT
     CALL "NBT-WRITE-FLOAT" USING PB-BUFFER WS-KEY WS-KEY-LENGTH WS-FLOAT
     MOVE "other" TO WS-KEY
     MOVE 5 TO WS-KEY-LENGTH
     CALL "NBT-WRITE-INT" USING PB-BUFFER WS-KEY WS-KEY-LENGTH WS-FIVE
     MOVE "effects" TO WS-KEY
     MOVE 7 TO WS-KEY-LENGTH
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WS-KEY WS-KEY-LENGTH
     MOVE "water_color" TO WS-KEY
     MOVE 11 TO WS-KEY-LENGTH
     MOVE 4159204 TO WS-INT
     CALL "NBT-WRITE-INT" USING PB-BUFFER WS-KEY WS-KEY-LENGTH WS-INT
     MOVE "dry_foliage_color" TO WS-KEY
     MOVE 17 TO WS-KEY-LENGTH
     MOVE "#112233" TO WS-TEXT
     MOVE 7 TO WS-TEXT-LENGTH
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WS-KEY WS-KEY-LENGTH WS-TEXT WS-TEXT-LENGTH
     MOVE "grass_color_modifier" TO WS-KEY
     MOVE 20 TO WS-KEY-LENGTH
     MOVE "swamp" TO WS-TEXT
     MOVE 5 TO WS-TEXT-LENGTH
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WS-KEY WS-KEY-LENGTH WS-TEXT WS-TEXT-LENGTH
     MOVE "fog_color" TO WS-KEY
     MOVE 9 TO WS-KEY-LENGTH
     CALL "NBT-WRITE-INT" USING PB-BUFFER WS-KEY WS-KEY-LENGTH WS-FIVE
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
*>   Entry 2: cobolcraft:upland, a plain grass colour String, no modifier.
     MOVE "cobolcraft:upland" TO WS-NAME
     MOVE 17 TO WS-LEN
     CALL "PB-PUT-IDENTIFIER" USING PB-BUFFER WS-NAME WS-LEN
     CALL "PB-PUT-BOOL" USING PB-BUFFER WS-ONE
     MOVE SPACE TO WS-KEY
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WS-KEY WS-NEG2
     MOVE "effects" TO WS-KEY
     MOVE 7 TO WS-KEY-LENGTH
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WS-KEY WS-KEY-LENGTH
     MOVE "grass_color" TO WS-KEY
     MOVE 11 TO WS-KEY-LENGTH
     MOVE "#445566" TO WS-TEXT
     MOVE 7 TO WS-TEXT-LENGTH
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WS-KEY WS-KEY-LENGTH WS-TEXT WS-TEXT-LENGTH
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE 0 TO PB-POS
     CALL "REGISTRY-READ" USING CLIENT-STATE PB-BUFFER

*>   The Int colour is parsed like its decimal text (43 section 5: an integer as written).
     MOVE "4159204" TO WS-TEXT
     MOVE 7 TO WS-TEXT-LENGTH
     CALL "TINT-COLOR-PARSE" USING WS-KIND WS-TEXT WS-TEXT-LENGTH WS-EXPECT-WATER WS-OK
     MOVE "registry biome tint plains: an Int water colour as written, a String dry foliage colour "
         & "#112233 (opaque), the swamp modifier, temperature 0.8, TT-PLAINS 0, no grass override"
         TO TL-CASE
     MOVE "N" TO TL-MODE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF WS-OK = 1 AND TB-WATER(1) = WS-EXPECT-WATER AND TB-DRY(1) = 4279312947 AND TB-MOD(1) = 2
             AND TB-TEMP(1) > 0.79 AND TB-TEMP(1) < 0.81 AND TT-PLAINS = 0 AND TB-GRASS(1) = -1
             AND TB-FOLIAGE(1) = -1 AND TT-BIOMES = 2
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "registry biome tint upland: the grass colour #445566, no dry foliage override, modifier none"
         TO TL-CASE
     MOVE 0 TO TL-OBSERVED-N
     IF TB-GRASS(2) = 4282668390 AND TB-DRY(2) = -1 AND TB-MOD(2) = 0
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.
 END PROGRAM TEST-REGISTRY-BIOME-TINT.
 COPY CLTEST.
