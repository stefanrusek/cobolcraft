*> The salmon's tail wiggle (docs/protocol/34-entity-models-8-aquatic-nautilus-boats.md section 5.2, EF8-FISH-ANIM): body_back.yRot = -a x 0.25 x sin(b x 0.6 A) with
*> a 1 and b 1 in water, else a 1.3 (so a x 0.25 = 0.325) and b 1.7, for age in ticks A = 10.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-ENTITY-FISH-ANIM.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CLSTATE.
 COPY CLCONST.
 COPY CONTENT.
 COPY CLMODELS.
 COPY CLEMM.
 COPY TESTLIB.
 01 WS-KEY24               PIC X(24).
 01 WS-STATUS              BINARY-LONG.
 01 WS-MODEL               BINARY-LONG.
 01 WS-PART                BINARY-LONG.
 01 WS-DIFF                FLOAT-LONG.
 01 WS-IN.
    05 WS-IV               FLOAT-LONG OCCURS 16 TIMES.
 PROCEDURE DIVISION.
     CALL "CL-INIT" USING CLIENT-STATE
     MOVE 0 TO PK-COUNT
     CALL "ENTITY-ATLAS-BUILD" USING CLIENT-STATE
     MOVE "salmon~s" TO WS-KEY24
     CALL "ENTITY-MODEL-FIND" USING WS-KEY24 WS-MODEL
     CALL "ENTITY-MODEL-BUILD" USING EMM-MODEL WS-MODEL WS-STATUS
     PERFORM VARYING WS-PART FROM 1 BY 1 UNTIL WS-PART > 16
         MOVE 0 TO WS-IV(WS-PART)
     END-PERFORM
     MOVE 3 TO WS-IV(1)
     MOVE 10 TO WS-IV(2)
     MOVE 1 TO WS-IV(3)
     CALL "EF8-FISH-ANIM" USING EMM-MODEL WS-IN
     MOVE "body_back" TO WS-KEY24
     CALL "EMM-FIND" USING EMM-MODEL WS-KEY24 WS-PART
     MOVE "acceptance salmon in water body_back yRot is -0.25 sin(0.6 A)" TO TL-CASE
     COMPUTE WS-DIFF = MM-CYROT(WS-PART) - 0.0698537
     PERFORM CHECK-SMALL
     MOVE 0 TO WS-IV(3)
     CALL "EF8-FISH-ANIM" USING EMM-MODEL WS-IN
     MOVE "body_back" TO WS-KEY24
     CALL "EMM-FIND" USING EMM-MODEL WS-KEY24 WS-PART
     MOVE "acceptance salmon out of water body_back yRot is -0.325 sin(1.7 x 0.6 A)" TO TL-CASE
     COMPUTE WS-DIFF = MM-CYROT(WS-PART) - 0.2274593
     PERFORM CHECK-SMALL
     STOP RUN.

 CHECK-SMALL.
     MOVE "N" TO TL-MODE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF WS-DIFF < 0.00001 AND WS-DIFF > -0.00001
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-ENTITY-FISH-ANIM.

 COPY CLTEST.
