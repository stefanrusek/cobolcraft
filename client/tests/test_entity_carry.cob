*>   A snow golem with its pumpkin (the default, EN-X1 0): the carved pumpkin's six faces (36 vertices), a cube of 0.625 blocks centred on the head's pivot (10.5, 65.251, 10.5)
*>   plus the layer's translate (0, -0.34375, 0) in the flipped model space: (10.5, 65.59475, 10.5).
     CALL "ENTITIES-CLEAR" USING CLIENT-STATE
     MOVE SPACES TO WS-KEY
     MOVE "snow_golem" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-TYPE WS-ROW-AREA WS-STATUS
     MOVE 1 TO WS-ID
     CALL "MM-SPAWN" USING CLIENT-STATE WS-ID WS-TYPE WS-X WS-Y WS-Z WS-YAW
     CALL "ENTITIES-MESH" USING CLIENT-STATE WS-EYE-TABLE
     CALL "GROUND-ITEMS-MESH" USING CLIENT-STATE WS-EYE-TABLE
     MOVE "T9905 a snow golem with its pumpkin draws six faces" TO TL-CASE
     MOVE 36 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = RL-GI-COUNT
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "BB-GI" USING CLIENT-STATE WS-EYE-TABLE WS-BB
     COMPUTE WS-CV(1) = (WS-BV(1) + WS-BV(4)) / 2
     COMPUTE WS-CV(2) = (WS-BV(2) + WS-BV(5)) / 2
     COMPUTE WS-CV(3) = (WS-BV(3) + WS-BV(6)) / 2
     COMPUTE WS-A = WS-CV(1)
     COMPUTE WS-B = 10.5
     CALL "NEAR-FLAG" USING WS-A WS-B WS-TOL WS-FLAG
     MOVE "T9905 pumpkin centre x" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-FLAG
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     COMPUTE WS-A = WS-CV(2)
     COMPUTE WS-B = 65.59475
     CALL "NEAR-FLAG" USING WS-A WS-B WS-TOL WS-FLAG
     MOVE "T9905 pumpkin centre y" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-FLAG
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     COMPUTE WS-A = WS-CV(3)
     COMPUTE WS-B = 10.5
     CALL "NEAR-FLAG" USING WS-A WS-B WS-TOL WS-FLAG
     MOVE "T9905 pumpkin centre z" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-FLAG
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     COMPUTE WS-A = WS-BV(4) - WS-BV(1)
     COMPUTE WS-B = 0.625
     CALL "NEAR-FLAG" USING WS-A WS-B WS-TOL WS-FLAG
     MOVE "T9905 pumpkin width 0.625" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-FLAG
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     COMPUTE WS-A = WS-BV(5) - WS-BV(2)
     COMPUTE WS-B = 0.625
     CALL "NEAR-FLAG" USING WS-A WS-B WS-TOL WS-FLAG
     MOVE "T9905 pumpkin height 0.625" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-FLAG
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     COMPUTE WS-A = WS-BV(6) - WS-BV(3)
     COMPUTE WS-B = 0.625
     CALL "NEAR-FLAG" USING WS-A WS-B WS-TOL WS-FLAG
