         MOVE 0 TO CS-ANSWERS
         CALL "PB-GET-VARINT" USING PB-BUFFER WS-VALUE
         CALL "PB-GET-VARINT" USING PB-BUFFER WS-VALUE
         CALL "PB-GET-VARINT" USING PB-BUFFER WS-COUNT
