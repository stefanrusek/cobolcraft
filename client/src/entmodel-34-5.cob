 PROGRAM-ID. EF5-KF-INDEX.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-K                   BINARY-LONG.
 01 WS-N                   BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-J                   BINARY-LONG.
 LINKAGE SECTION.
 01 L-IN.
    05 L-I                 FLOAT-LONG OCCURS 16 TIMES.
 01 L-OUT.
    05 L-O                 FLOAT-LONG OCCURS 64 TIMES.
 PROCEDURE DIVISION USING L-IN L-OUT.
     COMPUTE WS-N = L-I(1)
     MOVE 0 TO WS-I
     PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-N
         IF L-I(2 + WS-K) < L-I(2)
             MOVE WS-K TO WS-I
         END-IF
     END-PERFORM
     IF WS-I < 1
         MOVE 1 TO WS-I
     END-IF
     COMPUTE WS-J = WS-I + 1
     IF WS-J > WS-N
         MOVE WS-N TO WS-J
     END-IF
     MOVE WS-I TO L-O(1)
     MOVE WS-J TO L-O(2)
     MOVE 0 TO L-O(3)
     IF WS-I NOT = WS-J
         COMPUTE L-O(3) = (L-I(2) - L-I(2 + WS-I)) / (L-I(2 + WS-J) - L-I(2 + WS-I))
         COMPUTE L-O(3) = FUNCTION MIN(1, FUNCTION MAX(0, L-O(3)))
     END-IF
     GOBACK.
 END PROGRAM EF5-KF-INDEX.

