 01 L-SLOT                 BINARY-LONG.
 01 L-INNER                FLOAT-LONG.
 01 L-OUTER                FLOAT-LONG.
 PROCEDURE DIVISION USING EMM-MODEL L-SLOT L-INNER L-OUTER.
     MOVE L-OUTER TO WS-GR
     IF L-SLOT = 3
         MOVE L-INNER TO WS-GR
     END-IF
     CALL "EMD-HUMANOID" USING EMM-MODEL WS-GR WS-Y
     MOVE WS-GR TO WS-GV(1) WS-GV(2) WS-GV(3)
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 8
         CALL "EMM-ROW" USING EMM-MODEL WS-ROW(WS-I) WS-G
     END-PERFORM
     MOVE 32 TO MM-TEXH
     EVALUATE L-SLOT
         WHEN 1
             MOVE 1 TO WS-MODE
             MOVE "head" TO WS-SET
         WHEN 2
             MOVE 2 TO WS-MODE
             MOVE "body|left_arm|right_arm" TO WS-SET
         WHEN 3
             MOVE 2 TO WS-MODE
             MOVE "left_leg|right_leg|body" TO WS-SET
         WHEN OTHER
             MOVE 2 TO WS-MODE
             MOVE "left_leg|right_leg" TO WS-SET
     END-EVALUATE
     CALL "EMD-RETAIN" USING EMM-MODEL WS-MODE WS-SET
     GOBACK.
 END PROGRAM EMD-STAND-ARMOR.

