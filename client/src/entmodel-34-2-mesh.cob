         WHEN "ZOMBIE"
             CALL "EMD-HUMANOID" USING EMM-MODEL WS-ZERO WS-ZERO2
         WHEN "HUSK"
             CALL "EMD-HUMANOID" USING EMM-MODEL WS-ZERO WS-ZERO2
             MOVE 1.0625 TO WS-S
             CALL "EMD-SCALE-ROOT" USING EMM-MODEL WS-S
         WHEN "GIANT"
             CALL "EMD-HUMANOID" USING EMM-MODEL WS-ZERO WS-ZERO2
             MOVE 6 TO WS-S
             CALL "EMD-SCALE-ROOT" USING EMM-MODEL WS-S
         WHEN "ZOMBIE_BABY" WHEN "HUSK_BABY" WHEN "DROWNED_BABY"
             CALL "EMD-BABY-ZOMBIE" USING EMM-MODEL WS-ZERO
         WHEN "DROWNED_BABY_OUTER_LAYER"
             CALL "EMD-BABY-ZOMBIE" USING EMM-MODEL WS-G25
         WHEN "DROWNED"
             CALL "EMD-DROWNED" USING EMM-MODEL WS-ZERO
         WHEN "DROWNED_OUTER_LAYER"
             CALL "EMD-DROWNED" USING EMM-MODEL WS-G25
         WHEN "SKELETON" WHEN "STRAY"
             CALL "EMD-SKELETON" USING EMM-MODEL
         WHEN "WITHER_SKELETON"
             CALL "EMD-SKELETON" USING EMM-MODEL
             MOVE 1.2 TO WS-S
             CALL "EMD-SCALE-ROOT" USING EMM-MODEL WS-S
         WHEN "BOGGED"
             CALL "EMD-BOGGED" USING EMM-MODEL
         WHEN "PARCHED"
             CALL "EMD-PARCHED" USING EMM-MODEL
         WHEN "STRAY_OUTER_LAYER" WHEN "PARCHED_OUTER_LAYER"
             CALL "EMD-HUMANOID" USING EMM-MODEL WS-G25 WS-ZERO
             MOVE 32 TO MM-TEXH
         WHEN "BOGGED_OUTER_LAYER"
             CALL "EMD-HUMANOID" USING EMM-MODEL WS-G2 WS-ZERO
             MOVE 32 TO MM-TEXH
         WHEN "PIGLIN" WHEN "PIGLIN_BRUTE" WHEN "ZOMBIFIED_PIGLIN"
             CALL "EMD-PIGLIN" USING EMM-MODEL
         WHEN "PIGLIN_BABY" WHEN "ZOMBIFIED_PIGLIN_BABY"
             CALL "EMD-BABY-PIGLIN" USING EMM-MODEL
         WHEN "ARMOR_STAND"
             CALL "EMD-ARMORSTAND" USING EMM-MODEL
         WHEN "ARMOR_STAND_SMALL"
             CALL "EMD-ARMORSTAND" USING EMM-MODEL
             CALL "EMD-BABY" USING EMM-MODEL
         WHEN OTHER
             MOVE 0 TO L-OK
     END-EVALUATE
     GOBACK.
 END PROGRAM EMD-LAYER.
