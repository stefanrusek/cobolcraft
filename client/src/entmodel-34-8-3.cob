 IDENTIFICATION DIVISION.
 PROGRAM-ID. EF8-FISH-ANIM.
*> USING model, state (16 FLOAT-LONG: 1 kind 1 cod, 2 tropical fish, 3 salmon, 4 pufferfish, 2 ageInTicks, 3 in water 1 or 0): reset first, then the
*> setupAnim of 5.1 (cod: tail_fin.yRot = -f x 0.45 x sin(0.6 A)), 5.4 (tropical fish: the same on tail), 5.2 (salmon: body_back.yRot = -a x 0.25 x
*> sin(b x 0.6 A), a 1 and b 1 in water else 1.3 and 1.7) and 5.3 (pufferfish: right fin zRot = -0.2 + 0.4 sin(0.2 A), left fin zRot = 0.2 - 0.4 sin(0.2 A)).
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-NAME                PIC X(24).
 01 WS-P                   BINARY-LONG.
 01 WS-F                   FLOAT-LONG.
 01 WS-B                   FLOAT-LONG.
 LINKAGE SECTION.
 COPY CLEMM.
 01 L-IN.
    05 L-I                 FLOAT-LONG OCCURS 16 TIMES.
 PROCEDURE DIVISION USING EMM-MODEL L-IN.
     CALL "EMM-RESET" USING EMM-MODEL
     IF L-I(3) = 1
         MOVE 1 TO WS-F WS-B
     ELSE
         MOVE 1.5 TO WS-F
         MOVE 1.7 TO WS-B
     END-IF
     EVALUATE L-I(1)
         WHEN 1
             MOVE "tail_fin" TO WS-NAME
             CALL "EMM-FIND" USING EMM-MODEL WS-NAME WS-P
             COMPUTE MM-CYROT(WS-P) = -0.45 * WS-F * FUNCTION SIN(0.6 * L-I(2))
         WHEN 2
             MOVE "tail" TO WS-NAME
             CALL "EMM-FIND" USING EMM-MODEL WS-NAME WS-P
             COMPUTE MM-CYROT(WS-P) = -0.45 * WS-F * FUNCTION SIN(0.6 * L-I(2))
         WHEN 3
             MOVE "body_back" TO WS-NAME
             CALL "EMM-FIND" USING EMM-MODEL WS-NAME WS-P
             IF L-I(3) = 1
                 COMPUTE MM-CYROT(WS-P) = -0.25 * FUNCTION SIN(0.6 * L-I(2))
             ELSE
                 COMPUTE MM-CYROT(WS-P) = -0.325 * FUNCTION SIN(1.7 * 0.6 * L-I(2))
             END-IF
         WHEN OTHER
             MOVE "right_fin" TO WS-NAME
             CALL "EMM-FIND" USING EMM-MODEL WS-NAME WS-P
             IF WS-P = 0
                 MOVE "right_blue_fin" TO WS-NAME
                 CALL "EMM-FIND" USING EMM-MODEL WS-NAME WS-P
             END-IF
             COMPUTE MM-CZROT(WS-P) = -0.2 + 0.4 * FUNCTION SIN(0.2 * L-I(2))
             MOVE "left_fin" TO WS-NAME
             CALL "EMM-FIND" USING EMM-MODEL WS-NAME WS-P
             IF WS-P = 0
                 MOVE "left_blue_fin" TO WS-NAME
                 CALL "EMM-FIND" USING EMM-MODEL WS-NAME WS-P
             END-IF
             COMPUTE MM-CZROT(WS-P) = 0.2 - 0.4 * FUNCTION SIN(0.2 * L-I(2))
     END-EVALUATE
     GOBACK.
 END PROGRAM EF8-FISH-ANIM.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. EF8-DOLPHIN-ANIM.
*> USING model, state (16 FLOAT-LONG: 1 xRot, 2 yRot degrees, 3 isMoving (1 or 0), 4 ageInTicks): reset first, 3.2.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-NAME                PIC X(24).
 01 WS-B                   BINARY-LONG.
 01 WS-T                   BINARY-LONG.
 01 WS-TF                  BINARY-LONG.
 01 WS-C                   FLOAT-LONG.
 LINKAGE SECTION.
 COPY CLEMM.
 01 L-IN.
    05 L-I                 FLOAT-LONG OCCURS 16 TIMES.
 PROCEDURE DIVISION USING EMM-MODEL L-IN.
     CALL "EMM-RESET" USING EMM-MODEL
     MOVE "body" TO WS-NAME
     CALL "EMM-FIND" USING EMM-MODEL WS-NAME WS-B
     MOVE "tail" TO WS-NAME
     CALL "EMM-FIND" USING EMM-MODEL WS-NAME WS-T
     MOVE "tail_fin" TO WS-NAME
     CALL "EMM-FIND" USING EMM-MODEL WS-NAME WS-TF
     COMPUTE MM-CXROT(WS-B) = L-I(1) * 0.017453292
     COMPUTE MM-CYROT(WS-B) = L-I(2) * 0.017453292
     IF L-I(3) = 1
         COMPUTE WS-C = FUNCTION COS(0.3 * L-I(4))
         COMPUTE MM-CXROT(WS-B) = MM-CXROT(WS-B) - 0.05 - 0.05 * WS-C
         COMPUTE MM-CXROT(WS-T) = -0.1 * WS-C
         COMPUTE MM-CXROT(WS-TF) = -0.2 * WS-C
     END-IF
     GOBACK.
 END PROGRAM EF8-DOLPHIN-ANIM.

