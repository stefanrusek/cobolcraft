 01 WS-I                    BINARY-LONG.
 01 WS-OK                   BINARY-LONG.
 01 WS-CACHE.
    05 WS-CE                PIC X(40000) OCCURS 11 TIMES.
 LINKAGE SECTION.
 01 L-ORD                  BINARY-LONG.
 COPY CLEM5.
 01 L-OK                   BINARY-LONG.
 PROCEDURE DIVISION USING L-ORD EM5-DEF L-OK.
     IF WS-LOADED = 0
         PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 11
             CALL "EM3-ANIM-BUILD" USING WS-I EM5-DEF WS-OK
             MOVE EM5-DEF TO WS-CE(WS-I)
         END-PERFORM
         MOVE 1 TO WS-LOADED
     END-IF
     MOVE 0 TO L-OK
     IF L-ORD >= 1 AND L-ORD <= 11
         MOVE WS-CE(L-ORD) TO EM5-DEF
         MOVE 1 TO L-OK
     END-IF
     GOBACK.
 END PROGRAM EM3-ANIM-DEF.

