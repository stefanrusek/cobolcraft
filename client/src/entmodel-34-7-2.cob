    05 FILLER PIC X(100) VALUE "P part11 root 2.269953664 10.614252063 -4.455032027 0 0 0".
    05 FILLER PIC X(100) VALUE "C part11 0 16 0 0 0 2 8 2 0 0".
    05 FILLER PIC X(100) VALUE SPACES OCCURS 54 TIMES.
 01 WS-ROWS-R REDEFINES WS-ROWS.
    05 WS-ROW              PIC X(100) OCCURS 80 TIMES.
 01 WS-N                   BINARY-LONG VALUE 26.
 01 WS-ZERO                FLOAT-LONG VALUE 0.
 LINKAGE SECTION.
 COPY CLEMM.
 PROCEDURE DIVISION USING EMM-MODEL.
     CALL "EMM-INIT" USING EMM-MODEL
     CALL "EM3-ROWS" USING EMM-MODEL WS-ROWS-R WS-N WS-ZERO
     MOVE 64 TO MM-TEXW
     MOVE 32 TO MM-TEXH
     GOBACK.
 END PROGRAM EF7-M-BLAZE.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. EF7-BLAZE-ANIM.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-NAME                PIC X(24).
 01 WS-DIG                 PIC 99.
 01 WS-H                   BINARY-LONG.
 01 WS-P                   BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-K                   BINARY-LONG.
 01 WS-A                   FLOAT-LONG.
 01 WS-R                   FLOAT-LONG.
 01 WS-Y                   FLOAT-LONG.
 01 WS-BASE                FLOAT-LONG.
 LINKAGE SECTION.
 COPY CLEMM.
 01 L-IN.
    05 L-I                 FLOAT-LONG OCCURS 16 TIMES.
 PROCEDURE DIVISION USING EMM-MODEL L-IN.
     CALL "EMM-RESET" USING EMM-MODEL
     MOVE "head" TO WS-NAME
     CALL "EMM-FIND" USING EMM-MODEL WS-NAME WS-H
     COMPUTE MM-CXROT(WS-H) = L-I(1) * 0.017453292
     COMPUTE MM-CYROT(WS-H) = L-I(2) * 0.017453292
     PERFORM VARYING WS-I FROM 0 BY 1 UNTIL WS-I > 11
         MOVE WS-I TO WS-DIG
         MOVE SPACES TO WS-NAME
         IF WS-I < 10
             STRING "part" WS-DIG(2:1) DELIMITED BY SIZE INTO WS-NAME
         ELSE
             STRING "part" WS-DIG DELIMITED BY SIZE INTO WS-NAME
         END-IF
         CALL "EMM-FIND" USING EMM-MODEL WS-NAME WS-P
         EVALUATE TRUE
             WHEN WS-I < 4
                 MOVE WS-I TO WS-K
                 COMPUTE WS-BASE = L-I(3) * 3.141592653589793 * -0.1
                 MOVE 9 TO WS-R
                 COMPUTE WS-Y = -2 + FUNCTION COS((2 * WS-I + L-I(3)) * 0.25)
             WHEN WS-I < 8
                 COMPUTE WS-K = WS-I - 4
                 COMPUTE WS-BASE = 0.7853982 + L-I(3) * 3.141592653589793 * 0.03
                 MOVE 7 TO WS-R
                 COMPUTE WS-Y = 2 + FUNCTION COS((2 * WS-I + L-I(3)) * 0.25)
             WHEN OTHER
                 COMPUTE WS-K = WS-I - 8
                 COMPUTE WS-BASE = 0.47123894 + L-I(3) * 3.141592653589793 * -0.05
                 MOVE 5 TO WS-R
                 COMPUTE WS-Y = 11 + FUNCTION COS((1.5 * WS-I + L-I(3)) * 0.5)
         END-EVALUATE
         COMPUTE WS-A = WS-BASE + WS-K * 1.5707964
         COMPUTE MM-CX(WS-P) = FUNCTION COS(WS-A) * WS-R
         MOVE WS-Y TO MM-CY(WS-P)
         COMPUTE MM-CZ(WS-P) = FUNCTION SIN(WS-A) * WS-R
     END-PERFORM
     GOBACK.
 END PROGRAM EF7-BLAZE-ANIM.

