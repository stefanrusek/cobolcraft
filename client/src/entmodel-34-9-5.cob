 LINKAGE SECTION.
 01 L-IN.
    05 L-I                 FLOAT-LONG OCCURS 32 TIMES.
 01 L-PATH                 PIC X(60).
 01 L-OUT.
    05 L-O                 FLOAT-LONG OCCURS 64 TIMES.
 PROCEDURE DIVISION USING L-IN L-PATH L-OUT.
     MOVE "entity/trident/trident.png" TO L-PATH
     MOVE 1 TO L-O(1)
     IF L-I(1) NOT = 0
         MOVE 2 TO L-O(1)
     END-IF
     GOBACK.
 END PROGRAM EF9-TRIDENT-TEXTURE.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. EF9-SPIN-ANIM.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-NAME                PIC X(24).
 01 WS-P                   BINARY-LONG.
 01 WS-K                   BINARY-LONG.
 01 WS-A                   FLOAT-LONG.
 LINKAGE SECTION.
 COPY CLEMM.
 01 L-IN.
    05 L-I                 FLOAT-LONG OCCURS 16 TIMES.
 PROCEDURE DIVISION USING EMM-MODEL L-IN.
     CALL "EMM-RESET" USING EMM-MODEL
     PERFORM VARYING WS-K FROM 0 BY 1 UNTIL WS-K > 1
         MOVE "box0" TO WS-NAME
         IF WS-K = 1
             MOVE "box1" TO WS-NAME
         END-IF
         CALL "EMM-FIND" USING EMM-MODEL WS-NAME WS-P
         COMPUTE WS-A = L-I(1) * (0 - (45 + (WS-K + 1) * 5))
         COMPUTE WS-A = WS-A - 360 * FUNCTION INTEGER((WS-A + 180) / 360)
         COMPUTE MM-CYROT(WS-P) = WS-A * 0.017453292
     END-PERFORM
     GOBACK.
 END PROGRAM EF9-SPIN-ANIM.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. EF9-WIND-ANIM.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-NAME                PIC X(24).
 01 WS-P                   BINARY-LONG.
 LINKAGE SECTION.
 COPY CLEMM.
 01 L-IN.
    05 L-I                 FLOAT-LONG OCCURS 16 TIMES.
 PROCEDURE DIVISION USING EMM-MODEL L-IN.
     CALL "EMM-RESET" USING EMM-MODEL
     MOVE "wind_charge" TO WS-NAME
     CALL "EMM-FIND" USING EMM-MODEL WS-NAME WS-P
     COMPUTE MM-CYROT(WS-P) = 0 - L-I(1) * 16 * 0.017453292
     MOVE "wind" TO WS-NAME
     CALL "EMM-FIND" USING EMM-MODEL WS-NAME WS-P
     COMPUTE MM-CYROT(WS-P) = L-I(1) * 16 * 0.017453292
     GOBACK.
 END PROGRAM EF9-WIND-ANIM.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. EF9-WIND-SCROLL.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-U                   FLOAT-LONG.
 LINKAGE SECTION.
 01 L-IN.
    05 L-I                 FLOAT-LONG OCCURS 32 TIMES.
 01 L-OUT.
    05 L-O                 FLOAT-LONG OCCURS 64 TIMES.
 PROCEDURE DIVISION USING L-IN L-OUT.
     COMPUTE WS-U = L-I(1) * 0.03
     COMPUTE L-O(1) = WS-U - FUNCTION INTEGER(WS-U)
     GOBACK.
 END PROGRAM EF9-WIND-SCROLL.
