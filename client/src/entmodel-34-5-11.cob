 LINKAGE SECTION.
 COPY CLEMM.
 01 L-IN.
    05 L-I                 FLOAT-LONG OCCURS 16 TIMES.
 PROCEDURE DIVISION USING EMM-MODEL L-IN.
     CALL "EMM-RESET" USING EMM-MODEL
     IF L-I(5) NOT = -2147483648
         MOVE L-I(5) TO WS-START
         MOVE L-I(3) TO WS-AV(1)
         CALL "EM5-STATE" USING WS-OP WS-START WS-A WS-R
         MOVE WS-R TO WS-MS
         MOVE 3 TO WS-ORD
         CALL "EF5G-ANIM-APPLY" USING EMM-MODEL WS-ORD WS-MS WS-ONE WS-OK
     END-IF
     IF L-I(6) NOT = -2147483648
         MOVE L-I(6) TO WS-START
         MOVE L-I(3) TO WS-AV(1)
         CALL "EM5-STATE" USING WS-OP WS-START WS-A WS-R
         MOVE WS-R TO WS-MS
         MOVE 1 TO WS-ORD
         CALL "EF5G-ANIM-APPLY" USING EMM-MODEL WS-ORD WS-MS WS-ONE WS-OK
     END-IF
     IF L-I(7) NOT = -2147483648
         MOVE L-I(7) TO WS-START
         MOVE L-I(3) TO WS-AV(1)
         CALL "EM5-STATE" USING WS-OP WS-START WS-A WS-R
         MOVE WS-R TO WS-MS
         MOVE 4 TO WS-ORD
         CALL "EF5G-ANIM-APPLY" USING EMM-MODEL WS-ORD WS-MS WS-ONE WS-OK
     END-IF
     MOVE L-I(1) TO WS-WP
     MOVE L-I(2) TO WS-WS
     IF L-I(4) NOT = 0
         MOVE 1 TO WS-TF
         MOVE 5 TO WS-ORD
     ELSE
         MOVE 1.5 TO WS-TF
         MOVE 2 TO WS-ORD
     END-IF
     CALL "EM5-WALK-TIME" USING WS-WP WS-WS WS-TF WS-SF WS-MS WS-SCALE
     CALL "EF5G-ANIM-APPLY" USING EMM-MODEL WS-ORD WS-MS WS-SCALE WS-OK
     IF L-I(8) NOT = -2147483648
         MOVE L-I(8) TO WS-START
         MOVE L-I(3) TO WS-AV(1)
         CALL "EM5-STATE" USING WS-OP WS-START WS-A WS-R
         MOVE WS-R TO WS-MS
         MOVE 6 TO WS-ORD
         CALL "EF5G-ANIM-APPLY" USING EMM-MODEL WS-ORD WS-MS WS-ONE WS-OK
     END-IF
     MOVE "croaking_body" TO WS-NAME
     CALL "EMM-FIND" USING EMM-MODEL WS-NAME WS-CB
     MOVE 0 TO MM-VISIBLE(WS-CB)
     IF L-I(6) NOT = -2147483648
         MOVE 1 TO MM-VISIBLE(WS-CB)
     END-IF
     GOBACK.
 END PROGRAM EF5-FROG-ANIM.

