     IF L-OK NOT = 0
         PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > MM-COUNT
             MOVE MH-POSE(WS-I) TO MM-CUR(WS-I)
         END-PERFORM
     END-IF
     GOBACK.
