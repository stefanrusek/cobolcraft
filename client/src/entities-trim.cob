 01 WS-N                   BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-P                   BINARY-LONG.
 01 WS-R                   BINARY-LONG.
 01 WS-G                   BINARY-LONG.
 01 WS-B                   BINARY-LONG.
 01 WS-A                   BINARY-LONG.
 01 WS-IDX                 BINARY-LONG.
 01 WS-RGB                 BINARY-LONG.
 LINKAGE SECTION.
 01 L-IMAGE                PIC X(1048576).
 01 L-W                    BINARY-LONG.
 01 L-H                    BINARY-LONG.
 01 L-PALETTE              BINARY-LONG.
 PROCEDURE DIVISION USING L-IMAGE L-W L-H L-PALETTE.
     IF L-PALETTE < 1 OR L-PALETTE > 16
         GOBACK
     END-IF
     COMPUTE WS-N = L-W * L-H
     PERFORM VARYING WS-I FROM 0 BY 1 UNTIL WS-I >= WS-N
         COMPUTE WS-P = WS-I * 4 + 1
         COMPUTE WS-A = FUNCTION ORD(L-IMAGE(WS-P + 3:1)) - 1
         IF WS-A > 0
             COMPUTE WS-R = FUNCTION ORD(L-IMAGE(WS-P:1)) - 1
             COMPUTE WS-G = FUNCTION ORD(L-IMAGE(WS-P + 1:1)) - 1
             COMPUTE WS-B = FUNCTION ORD(L-IMAGE(WS-P + 2:1)) - 1
             IF WS-R = WS-G AND WS-G = WS-B AND FUNCTION MOD(WS-R, 32) = 0 AND WS-R <= 224
                 COMPUTE WS-IDX = (224 - WS-R) / 32 + 1
                 MOVE WS-COL(L-PALETTE, WS-IDX) TO WS-RGB
                 MOVE FUNCTION CHAR(FUNCTION INTEGER(WS-RGB / 65536) + 1) TO L-IMAGE(WS-P:1)
                 MOVE FUNCTION CHAR(FUNCTION MOD(FUNCTION INTEGER(WS-RGB / 256), 256) + 1) TO L-IMAGE(WS-P + 1:1)
                 MOVE FUNCTION CHAR(FUNCTION MOD(WS-RGB, 256) + 1) TO L-IMAGE(WS-P + 2:1)
             END-IF
         END-IF
     END-PERFORM
     GOBACK.
