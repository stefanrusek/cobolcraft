*> --verify (22 §7.6): the full integrity check of a generated directory against its manifest.txt and index.txt.
*>   EX-VERIFY-NOTE   USING detail (PIC X(1500)): counts one problem and keeps the first detail.
*>   EX-VERIFY-HASH   USING path (PIC X(1100)), length, slot out: h = h * 33 + byte modulo 2147483647 over the bytes,
*>                    then modulo EXV-SLOTS, plus 1.
*>   EX-VERIFY-ADD    USING start, length of a path in EXV-INDEX: enters it in the hash table.
*>   EX-VERIFY-FIND   USING path (PIC X(1100)), length, found out (1 listed in the index, 0 not).
*>   EX-TREE-WALK     USING directory (z-string, PIC X(1101)), path prefix (PIC X(1100)), its length, root flag
*>                    (BINARY-LONG, 1 at the generated directory, where the three tool files are skipped): every file
*>                    below the directory that the index does not list is a problem ("extra file <path>").
*>   EX-VERIFY        USING directory (PIC X(1100)), status out (0 after CCX-102, 60 after CCX-060).
 IDENTIFICATION DIVISION.
 PROGRAM-ID. EX-VERIFY-NOTE.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY EXVERIFY.
 LINKAGE SECTION.
 01 L-DETAIL               PIC X(1500).
 PROCEDURE DIVISION USING L-DETAIL.
     IF EXV-PROBLEMS = 0
         MOVE L-DETAIL TO EXV-FIRST
     END-IF
     ADD 1 TO EXV-PROBLEMS
     GOBACK.
 END PROGRAM EX-VERIFY-NOTE.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. EX-VERIFY-HASH.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY EXVERIFY.
 01 WS-H                   BINARY-DOUBLE.
 01 WS-T                   BINARY-DOUBLE.
 01 WS-Q                   BINARY-DOUBLE.
 01 WS-R                   BINARY-DOUBLE.
 01 WS-I                   BINARY-LONG.
 01 WS-MODULUS             BINARY-DOUBLE VALUE 2147483647.
 LINKAGE SECTION.
 01 L-PATH                 PIC X(1100).
 01 L-LENGTH               BINARY-LONG.
 01 L-SLOT                 BINARY-LONG.
 PROCEDURE DIVISION USING L-PATH L-LENGTH L-SLOT.
     MOVE 0 TO WS-H
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > L-LENGTH
         COMPUTE WS-T = WS-H * 33 + FUNCTION ORD(L-PATH(WS-I:1))
         DIVIDE WS-T BY WS-MODULUS GIVING WS-Q REMAINDER WS-H
     END-PERFORM
     DIVIDE WS-H BY EXV-SLOTS GIVING WS-Q REMAINDER WS-R
     COMPUTE L-SLOT = WS-R + 1
     GOBACK.
 END PROGRAM EX-VERIFY-HASH.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. EX-VERIFY-ADD.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY EXVERIFY.
 01 WS-PATH                PIC X(1100).
 01 WS-SLOT                BINARY-LONG.
 LINKAGE SECTION.
 01 L-START                BINARY-LONG.
 01 L-LENGTH               BINARY-LONG.
 PROCEDURE DIVISION USING L-START L-LENGTH.
     MOVE SPACES TO WS-PATH
     MOVE EXV-INDEX(L-START:L-LENGTH) TO WS-PATH
     CALL "EX-VERIFY-HASH" USING WS-PATH L-LENGTH WS-SLOT
     PERFORM UNTIL EXV-START(WS-SLOT) = 0
         COMPUTE WS-SLOT = FUNCTION MOD(WS-SLOT, EXV-SLOTS) + 1
     END-PERFORM
     MOVE L-START TO EXV-START(WS-SLOT)
     MOVE L-LENGTH TO EXV-PATH-LENGTH(WS-SLOT)
     GOBACK.
 END PROGRAM EX-VERIFY-ADD.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. EX-VERIFY-FIND.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY EXVERIFY.
 01 WS-SLOT                BINARY-LONG.
 01 WS-START               BINARY-LONG.
 01 WS-LENGTH              BINARY-LONG.
 LINKAGE SECTION.
 01 L-PATH                 PIC X(1100).
 01 L-LENGTH               BINARY-LONG.
 01 L-FOUND                BINARY-LONG.
 PROCEDURE DIVISION USING L-PATH L-LENGTH L-FOUND.
     MOVE 0 TO L-FOUND
     CALL "EX-VERIFY-HASH" USING L-PATH L-LENGTH WS-SLOT
     PERFORM UNTIL EXV-START(WS-SLOT) = 0 OR L-FOUND = 1
         MOVE EXV-START(WS-SLOT) TO WS-START
         MOVE EXV-PATH-LENGTH(WS-SLOT) TO WS-LENGTH
         IF WS-LENGTH = L-LENGTH
             IF EXV-INDEX(WS-START:WS-LENGTH) = L-PATH(1:L-LENGTH)
                 MOVE 1 TO L-FOUND
             END-IF
         END-IF
         COMPUTE WS-SLOT = FUNCTION MOD(WS-SLOT, EXV-SLOTS) + 1
     END-PERFORM
     GOBACK.
 END PROGRAM EX-VERIFY-FIND.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. EX-TREE-WALK IS RECURSIVE.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 B-LIST                 PIC X(16777216) BASED.
 LOCAL-STORAGE SECTION.
 01 LS-CAPACITY            BINARY-LONG.
 01 LS-LIST-ADDR           USAGE POINTER.
 01 LS-COUNT               BINARY-LONG.
 01 LS-RC                  BINARY-LONG.
 01 LS-POS                 BINARY-LONG.
 01 LS-END                 BINARY-LONG.
 01 LS-I                   BINARY-LONG.
 01 LS-PATH-LENGTH         BINARY-LONG.
 01 LS-NAME-LENGTH         BINARY-LONG.
 01 LS-NAME                PIC X(256).
 01 LS-CHILD               PIC X(1101).
 01 LS-REL                 PIC X(1100).
 01 LS-REL-LENGTH          BINARY-LONG.
 01 LS-CHILD-PREFIX        PIC X(1100).
 01 LS-CHILD-PREFIX-LENGTH BINARY-LONG.
 01 LS-FOUND               BINARY-LONG.
 01 LS-SKIP                BINARY-LONG.
 01 LS-ZERO                BINARY-LONG.
 01 LS-DETAIL              PIC X(1500).
 LINKAGE SECTION.
 01 L-Z                    PIC X(1101).
 01 L-PREFIX               PIC X(1100).
 01 L-PREFIX-LENGTH        BINARY-LONG.
 01 L-ROOT                 BINARY-LONG.
 PROCEDURE DIVISION USING L-Z L-PREFIX L-PREFIX-LENGTH L-ROOT.
     MOVE 4096 TO LS-CAPACITY
     MOVE 5 TO LS-RC
     PERFORM UNTIL LS-RC NOT = 5
         ALLOCATE LS-CAPACITY CHARACTERS RETURNING LS-LIST-ADDR
         SET ADDRESS OF B-LIST TO LS-LIST-ADDR
         MOVE 0 TO LS-COUNT
         CALL STATIC "cc_fs_list" USING BY REFERENCE L-Z BY REFERENCE B-LIST
             BY VALUE LS-CAPACITY BY REFERENCE LS-COUNT RETURNING LS-RC
         IF LS-RC = 5
             FREE LS-LIST-ADDR
             COMPUTE LS-CAPACITY = LS-CAPACITY * 2
         END-IF
     END-PERFORM
     IF LS-RC = 0
         MOVE 0 TO LS-PATH-LENGTH
         INSPECT L-Z TALLYING LS-PATH-LENGTH FOR CHARACTERS BEFORE INITIAL LOW-VALUE
         MOVE 1 TO LS-POS
*>       Entries are "<type><name>" lines: F a file, D a directory.
         PERFORM VARYING LS-I FROM 1 BY 1 UNTIL LS-I > LS-COUNT
             SET ADDRESS OF B-LIST TO LS-LIST-ADDR
             MOVE LS-POS TO LS-END
             PERFORM UNTIL B-LIST(LS-END:1) = X"0A"
                 ADD 1 TO LS-END
             END-PERFORM
             COMPUTE LS-NAME-LENGTH = LS-END - LS-POS - 1
             MOVE SPACES TO LS-NAME
             MOVE B-LIST(LS-POS + 1:LS-NAME-LENGTH) TO LS-NAME(1:LS-NAME-LENGTH)
             MOVE SPACES TO LS-REL
             IF L-PREFIX-LENGTH > 0
                 MOVE L-PREFIX(1:L-PREFIX-LENGTH) TO LS-REL(1:L-PREFIX-LENGTH)
             END-IF
             MOVE LS-NAME(1:LS-NAME-LENGTH) TO LS-REL(L-PREFIX-LENGTH + 1:LS-NAME-LENGTH)
             COMPUTE LS-REL-LENGTH = L-PREFIX-LENGTH + LS-NAME-LENGTH
             IF B-LIST(LS-POS:1) = "D"
                 MOVE LOW-VALUES TO LS-CHILD
                 MOVE L-Z(1:LS-PATH-LENGTH) TO LS-CHILD(1:LS-PATH-LENGTH)
                 MOVE "/" TO LS-CHILD(LS-PATH-LENGTH + 1:1)
                 MOVE LS-NAME(1:LS-NAME-LENGTH) TO LS-CHILD(LS-PATH-LENGTH + 2:LS-NAME-LENGTH)
                 MOVE LS-REL TO LS-CHILD-PREFIX
                 COMPUTE LS-CHILD-PREFIX-LENGTH = LS-REL-LENGTH + 1
                 MOVE "/" TO LS-CHILD-PREFIX(LS-CHILD-PREFIX-LENGTH:1)
                 MOVE 0 TO LS-ZERO
                 CALL "EX-TREE-WALK" USING LS-CHILD LS-CHILD-PREFIX LS-CHILD-PREFIX-LENGTH LS-ZERO
                 SET ADDRESS OF B-LIST TO LS-LIST-ADDR
             ELSE
                 MOVE 0 TO LS-SKIP
                 IF L-ROOT = 1
                     IF LS-NAME = ".cobolcraft-generated" OR LS-NAME = "manifest.txt" OR LS-NAME = "index.txt"
                         MOVE 1 TO LS-SKIP
                     END-IF
                 END-IF
                 IF LS-SKIP = 0
                     CALL "EX-VERIFY-FIND" USING LS-REL LS-REL-LENGTH LS-FOUND
                     IF LS-FOUND = 0
                         MOVE SPACES TO LS-DETAIL
                         STRING "extra file " LS-REL(1:LS-REL-LENGTH) DELIMITED BY SIZE INTO LS-DETAIL
                         CALL "EX-VERIFY-NOTE" USING LS-DETAIL
                     END-IF
                 END-IF
             END-IF
             COMPUTE LS-POS = LS-END + 1
         END-PERFORM
         FREE LS-LIST-ADDR
     END-IF
     GOBACK.
 END PROGRAM EX-TREE-WALK.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. EX-VERIFY.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY EXSTATE.
 COPY EXVERIFY.
 COPY FORMATS.
 01 WS-MANIFEST-NAME       PIC X(1100) VALUE "manifest.txt".
 01 WS-INDEX-NAME          PIC X(1100) VALUE "index.txt".
 01 WS-PATH                PIC X(1100).
 01 WS-PATH-LENGTH         BINARY-LONG.
 01 WS-TEXT                PIC X(4097).
 01 WS-TEXT-LENGTH         BINARY-LONG.
 01 WS-OFFSET              BINARY-DOUBLE VALUE 0.
 01 WS-FILE-STATUS         BINARY-LONG.
 01 WS-PARSE-STATUS        BINARY-LONG.
 01 WS-VALUES.
    05 WS-VALUE            PIC X(80) OCCURS 13 TIMES.
 01 WS-DETAIL              PIC X(1500).
 01 WS-READ-LENGTH         BINARY-LONG.
 01 WS-CAPACITY            BINARY-LONG VALUE EXV-CAPACITY.
 01 WS-STOP                BINARY-LONG.
 01 WS-POS                 BINARY-LONG.
 01 WS-LEFT                BINARY-LONG.
 01 WS-LINE-LENGTH         BINARY-LONG.
 01 WS-SPACE               BINARY-LONG.
 01 WS-SIZE-LENGTH         BINARY-LONG.
 01 WS-PATH-START          BINARY-LONG.
 01 WS-REL-LENGTH          BINARY-LONG.
 01 WS-REL                 PIC X(1100).
 01 WS-SIZE-TEXT           PIC X(20).
 01 WS-EXPECTED-SIZE       BINARY-DOUBLE.
 01 WS-EXPECTED-CRC        PIC X(8).
 01 WS-BUFFER              PIC X(1048576).
 01 WS-BUFFER-CAPACITY     BINARY-LONG VALUE 1048576.
 01 WS-BUFFER-LENGTH       BINARY-LONG.
 01 WS-CRC                 BINARY-LONG UNSIGNED.
 01 WS-CRC-TEXT            PIC X(8).
 01 WS-NUMBER              BINARY-DOUBLE.
 01 WS-NUMBER-TEXT         PIC X(20).
 01 WS-LINE-NUMBER         BINARY-LONG.
 01 WS-LINE-NUMBER-TEXT    PIC X(20).
 01 WS-PACK                BINARY-LONG.
 01 WS-FORMAT              PIC X(5).
 01 WS-PACK-FILES.
    05 FILLER              PIC X(40) VALUE "vanilla-resources/pack.mcmeta".
    05 FILLER              PIC X(40) VALUE "vanilla-data/pack.mcmeta".
 01 WS-PACK-FILE-TABLE REDEFINES WS-PACK-FILES.
    05 WS-PACK-FILE        PIC X(40) OCCURS 2 TIMES.
 01 WS-EXPECTED-TEXT       PIC X(512).
 01 WS-EXPECTED-LENGTH     BINARY-LONG.
 01 WS-ACTUAL-TEXT         PIC X(512).
 01 WS-ACTUAL-LENGTH       BINARY-LONG.
 01 WS-PACK-FILE-LENGTH    BINARY-LONG.
 01 WS-TOTAL               BINARY-DOUBLE.
 01 WS-Z                   PIC X(1101).
 01 WS-Z-LENGTH            BINARY-LONG.
 01 WS-ROOT                BINARY-LONG VALUE 1.
 01 WS-EMPTY-PREFIX        PIC X(1100).
 01 WS-ZERO                BINARY-LONG VALUE 0.
 01 WS-CODE                BINARY-LONG.
 LINKAGE SECTION.
 01 L-DIR                  PIC X(1100).
 01 L-STATUS               BINARY-LONG.
 PROCEDURE DIVISION USING L-DIR L-STATUS.
     MOVE 0 TO EXV-LENGTH EXV-LINES EXV-PROBLEMS WS-STOP
     MOVE SPACES TO EXV-FIRST WS-EMPTY-PREFIX
     MOVE LOW-VALUES TO EXV-SLOT-AREA
*>   The manifest: missing or invalid ends the check (22 §7.6).
     CALL "EX-JOIN" USING L-DIR WS-MANIFEST-NAME WS-PATH
     MOVE 4097 TO WS-TEXT-LENGTH
     CALL "FILE-READ-AT" USING WS-PATH WS-OFFSET WS-TEXT WS-TEXT-LENGTH WS-FILE-STATUS
     MOVE 1 TO WS-PARSE-STATUS
     IF WS-FILE-STATUS = FM-OK AND WS-TEXT-LENGTH <= 4096
         CALL "PACKS-MANIFEST-PARSE" USING WS-TEXT WS-TEXT-LENGTH WS-VALUES WS-PARSE-STATUS
     END-IF
     IF WS-PARSE-STATUS NOT = 0
         MOVE "manifest invalid: manifest.txt is missing or not a manifest" TO WS-DETAIL
         CALL "EX-VERIFY-NOTE" USING WS-DETAIL
         MOVE 1 TO WS-STOP
     END-IF
*>   The index, read whole.
     IF WS-STOP = 0
         CALL "EX-JOIN" USING L-DIR WS-INDEX-NAME WS-PATH
         MOVE FUNCTION LENGTH(FUNCTION TRIM(WS-PATH)) TO WS-PATH-LENGTH
         CALL "FILE-READ-ALL" USING WS-PATH WS-PATH-LENGTH EXV-INDEX WS-CAPACITY EXV-LENGTH WS-FILE-STATUS
         IF WS-FILE-STATUS NOT = 0
             MOVE "manifest invalid: index.txt is missing or too large" TO WS-DETAIL
             CALL "EX-VERIFY-NOTE" USING WS-DETAIL
             MOVE 1 TO WS-STOP
         END-IF
     END-IF
*>   Every line: "<crc> <size> <path>" LF; the file must exist with that size and CRC-32.
     MOVE 1 TO WS-POS
     MOVE 0 TO WS-LINE-NUMBER
     PERFORM UNTIL WS-STOP = 1 OR WS-POS > EXV-LENGTH
         ADD 1 TO WS-LINE-NUMBER
         COMPUTE WS-LEFT = EXV-LENGTH - WS-POS + 1
         MOVE 0 TO WS-LINE-LENGTH
         INSPECT EXV-INDEX(WS-POS:WS-LEFT) TALLYING WS-LINE-LENGTH FOR CHARACTERS BEFORE INITIAL X"0A"
         MOVE 0 TO WS-SIZE-LENGTH
         IF WS-LINE-LENGTH > 10
             COMPUTE WS-LEFT = WS-LINE-LENGTH - 9
             INSPECT EXV-INDEX(WS-POS + 9:WS-LEFT) TALLYING WS-SIZE-LENGTH FOR CHARACTERS BEFORE INITIAL " "
         END-IF
         COMPUTE WS-PATH-START = WS-POS + 10 + WS-SIZE-LENGTH
         COMPUTE WS-REL-LENGTH = WS-LINE-LENGTH - 10 - WS-SIZE-LENGTH
         MOVE SPACES TO WS-SIZE-TEXT
         IF WS-SIZE-LENGTH > 0 AND WS-SIZE-LENGTH <= 19
             MOVE EXV-INDEX(WS-POS + 9:WS-SIZE-LENGTH) TO WS-SIZE-TEXT
         END-IF
         IF WS-POS + WS-LINE-LENGTH > EXV-LENGTH OR WS-LINE-LENGTH < 12 OR WS-SIZE-LENGTH = 0 OR WS-SIZE-LENGTH > 19
                 OR WS-REL-LENGTH < 1 OR EXV-INDEX(WS-POS + 8:1) NOT = " " OR WS-SIZE-TEXT(1:WS-SIZE-LENGTH) NOT NUMERIC
             MOVE WS-LINE-NUMBER TO WS-NUMBER
             CALL "EX-NUM" USING WS-NUMBER WS-LINE-NUMBER-TEXT
             MOVE SPACES TO WS-DETAIL
             STRING "manifest invalid: line " FUNCTION TRIM(WS-LINE-NUMBER-TEXT)
                 " of index.txt is not <crc> <size> <path>" DELIMITED BY SIZE INTO WS-DETAIL
             CALL "EX-VERIFY-NOTE" USING WS-DETAIL
             MOVE 1 TO WS-STOP
         ELSE
             ADD 1 TO EXV-LINES
             MOVE EXV-INDEX(WS-POS:8) TO WS-EXPECTED-CRC
             COMPUTE WS-EXPECTED-SIZE = FUNCTION NUMVAL(WS-SIZE-TEXT)
             MOVE SPACES TO WS-REL
             MOVE EXV-INDEX(WS-PATH-START:WS-REL-LENGTH) TO WS-REL
             CALL "EX-VERIFY-ADD" USING WS-PATH-START WS-REL-LENGTH
             CALL "EX-JOIN" USING L-DIR WS-REL WS-PATH
             MOVE FUNCTION LENGTH(FUNCTION TRIM(WS-PATH)) TO WS-PATH-LENGTH
             CALL "FILE-READ-ALL" USING WS-PATH WS-PATH-LENGTH WS-BUFFER WS-BUFFER-CAPACITY WS-BUFFER-LENGTH
                 WS-FILE-STATUS
             MOVE SPACES TO WS-DETAIL
             EVALUATE TRUE
                 WHEN WS-FILE-STATUS = 1
                     STRING "missing " WS-REL(1:WS-REL-LENGTH) DELIMITED BY SIZE INTO WS-DETAIL
                     CALL "EX-VERIFY-NOTE" USING WS-DETAIL
                 WHEN WS-BUFFER-LENGTH NOT = WS-EXPECTED-SIZE OR WS-FILE-STATUS NOT = 0
                     MOVE WS-BUFFER-LENGTH TO WS-NUMBER
                     CALL "EX-NUM" USING WS-NUMBER WS-NUMBER-TEXT
                     STRING "size " FUNCTION TRIM(WS-NUMBER-TEXT) " instead of " FUNCTION TRIM(WS-SIZE-TEXT) " in "
                         WS-REL(1:WS-REL-LENGTH) DELIMITED BY SIZE INTO WS-DETAIL
                     CALL "EX-VERIFY-NOTE" USING WS-DETAIL
                 WHEN OTHER
                     MOVE 0 TO WS-CRC
                     CALL "CRC32" USING WS-BUFFER WS-BUFFER-LENGTH WS-CRC
                     CALL "EX-HEX8" USING WS-CRC WS-CRC-TEXT
                     IF WS-CRC-TEXT NOT = WS-EXPECTED-CRC
                         STRING "CRC-32 " WS-CRC-TEXT " instead of " WS-EXPECTED-CRC " in " WS-REL(1:WS-REL-LENGTH)
                             DELIMITED BY SIZE INTO WS-DETAIL
                         CALL "EX-VERIFY-NOTE" USING WS-DETAIL
                     END-IF
             END-EVALUATE
             COMPUTE WS-POS = WS-POS + WS-LINE-LENGTH + 1
         END-IF
     END-PERFORM
*>   The two pack.mcmeta must be the text of 22 §6.2 for the manifest's formats; files-total must be the index's lines.
     IF WS-STOP = 0
         PERFORM VARYING WS-PACK FROM 1 BY 1 UNTIL WS-PACK > 2
             IF WS-PACK = 1
                 MOVE WS-VALUE(8) TO WS-FORMAT
             ELSE
                 MOVE WS-VALUE(9) TO WS-FORMAT
             END-IF
             CALL "EX-MCMETA-TEXT" USING WS-PACK WS-FORMAT WS-EXPECTED-TEXT WS-EXPECTED-LENGTH
             MOVE FUNCTION LENGTH(FUNCTION TRIM(WS-PACK-FILE(WS-PACK))) TO WS-PACK-FILE-LENGTH
             MOVE SPACES TO WS-REL
             MOVE WS-PACK-FILE(WS-PACK)(1:WS-PACK-FILE-LENGTH) TO WS-REL
             CALL "EX-JOIN" USING L-DIR WS-REL WS-PATH
             MOVE SPACES TO WS-ACTUAL-TEXT
             MOVE 512 TO WS-ACTUAL-LENGTH
             CALL "FILE-READ-AT" USING WS-PATH WS-OFFSET WS-ACTUAL-TEXT WS-ACTUAL-LENGTH WS-FILE-STATUS
             IF WS-FILE-STATUS = FM-OK AND WS-ACTUAL-LENGTH NOT = WS-EXPECTED-LENGTH
                     OR WS-FILE-STATUS = FM-OK AND WS-ACTUAL-TEXT NOT = WS-EXPECTED-TEXT
                 MOVE SPACES TO WS-DETAIL
                 STRING WS-PACK-FILE(WS-PACK)(1:WS-PACK-FILE-LENGTH) " is not the text of 22 section 6.2 for "
                     FUNCTION TRIM(WS-FORMAT) DELIMITED BY SIZE INTO WS-DETAIL
                 CALL "EX-VERIFY-NOTE" USING WS-DETAIL
             END-IF
         END-PERFORM
         COMPUTE WS-TOTAL = FUNCTION NUMVAL(WS-VALUE(13))
         IF WS-TOTAL NOT = EXV-LINES
             MOVE WS-TOTAL TO WS-NUMBER
             CALL "EX-NUM" USING WS-NUMBER WS-NUMBER-TEXT
             MOVE EXV-LINES TO WS-NUMBER
             CALL "EX-NUM" USING WS-NUMBER WS-SIZE-TEXT
             MOVE SPACES TO WS-DETAIL
             STRING "manifest invalid: files-total " FUNCTION TRIM(WS-NUMBER-TEXT) " but the index lists "
                 FUNCTION TRIM(WS-SIZE-TEXT) DELIMITED BY SIZE INTO WS-DETAIL
             CALL "EX-VERIFY-NOTE" USING WS-DETAIL
         END-IF
*>       Every file of the tree must be listed.
         CALL "FILE-PATH-Z" USING L-DIR WS-Z WS-Z-LENGTH WS-FILE-STATUS
         CALL "EX-TREE-WALK" USING WS-Z WS-EMPTY-PREFIX WS-ZERO WS-ROOT
     END-IF
     MOVE SPACES TO EXM-ARG(1) EXM-ARG(2)
     IF EXV-PROBLEMS = 0
         MOVE EXV-LINES TO WS-NUMBER
         CALL "EX-NUM" USING WS-NUMBER WS-NUMBER-TEXT
         MOVE WS-NUMBER-TEXT TO EXM-ARG(1)
         MOVE L-DIR TO EXM-ARG(2)
         MOVE 102 TO WS-CODE
         MOVE 0 TO L-STATUS
     ELSE
         MOVE EXV-PROBLEMS TO WS-NUMBER
         CALL "EX-NUM" USING WS-NUMBER WS-NUMBER-TEXT
         MOVE WS-NUMBER-TEXT TO EXM-ARG(1)
         MOVE EXV-FIRST TO EXM-ARG(2)
         MOVE 60 TO WS-CODE
         MOVE 60 TO L-STATUS
     END-IF
     CALL "EX-SAY" USING WS-CODE
     GOBACK.
 END PROGRAM EX-VERIFY.
