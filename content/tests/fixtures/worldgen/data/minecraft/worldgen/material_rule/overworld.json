{"type": "minecraft:sequence", "rules": [
  {"type": "minecraft:condition",
   "if_true": {"type": "minecraft:vertical_gradient", "random_name": "minecraft:bedrock_floor",
               "true_at_and_below": {"above_bottom": 0}, "false_at_and_above": {"above_bottom": 5}},
   "then_run": {"type": "minecraft:block", "result_state": {"Name": "minecraft:bedrock"}}},
  {"type": "minecraft:condition",
   "if_true": {"type": "minecraft:biome", "biome_is": ["minecraft:swamp", "minecraft:plains"]},
   "then_run": {"type": "minecraft:sequence", "rules": [
     {"type": "minecraft:condition", "if_true": "minecraft:on_floor",
      "then_run": {"type": "minecraft:block", "result_state": {"Name": "minecraft:grass_block", "Properties": {"snowy": "false"}}}}]}},
  {"type": "minecraft:condition",
   "if_true": {"type": "minecraft:not", "invert": {"type": "minecraft:y_above", "anchor": {"absolute": 60}, "surface_depth_multiplier": -1, "add_stone_depth": true}},
   "then_run": {"type": "minecraft:condition", "if_true": {"type": "minecraft:noise_threshold", "noise": "minecraft:surface", "min_threshold": -0.5, "max_threshold": 0.5},
     "then_run": {"type": "minecraft:bandlands"}}},
  {"type": "minecraft:condition", "if_true": {"type": "minecraft:above_preliminary_surface"}, "then_run": "minecraft:overworld_surface"},
  {"type": "minecraft:condition", "if_true": {"type": "minecraft:biome", "biome_is": "minecraft:desert"}, "then_run": {"type": "minecraft:ore_vein"}}]}
