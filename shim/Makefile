# Package shim: thin C glue (constitution Principle I) → build/shim/libccshim.a
# (contracts/test-harness.md §2). Shared rules: tools/package.mk.
#
# Modules (contracts/shim-abi.md): cc_fatal.c (§2), cc_net.c (§3), cc_zlib.c (§5), cc_win.c (§8),
# cc_vk.c (§9). cc_vk.c embeds the SPIR-V of shaders/*.vert|*.frag through the generated header
# $(GEN)/spirv.h (generated code, excluded from coverage).
PKG      := shim
LIBNAME  := libccshim.a
SRC      := src/cc_fatal.c src/cc_net.c src/cc_zlib.c src/cc_win.c src/cc_vk.c
TESTS    := $(wildcard tests/acc_*.c tests/contract_*.c tests/test_*.c)
SHADERS  := shaders/world.vert shaders/world.frag shaders/ui.vert shaders/ui.frag

# Library include directories in "-I <dir>" form (tools/package.mk passes them to the lint).
SHIM_GEN   = $(BUILD)/shim/gen
CFLAGS_DIRS := $(patsubst -I%,%,$(shell pkg-config --cflags-only-I glfw3 vulkan))
INCLUDES  = -I $(CURDIR)/src $(addprefix -I ,$(CFLAGS_DIRS)) -I $(SHIM_GEN)
DEPLIBS  :=
LDLIBS   := $(shell pkg-config --libs glfw3 vulkan zlib)
LINT_FILES = $(SRC) $(TESTS) $(SHADERS)

include ../tools/package.mk

# SPIR-V of the four shaders (the same files `make bootstrap` writes), then the generated header.
SPV := $(patsubst shaders/%,$(REPO)/build/shaders/%.spv,$(SHADERS))

$(REPO)/build/shaders/%.spv: shaders/%
	@mkdir -p $(dir $@)
	glslangValidator -V $< -o $@

# One aligned byte array per shader: spv_<name>_<stage> (SPIR-V words must be 4-byte aligned).
$(SHIM_GEN)/spirv.h: $(SPV)
	@mkdir -p $(dir $@)
	{ echo '/* Generated by shim/Makefile from shim/shaders: do not edit. */'; \
	  for f in $(SPV); do \
	    n=$$(basename $$f .spv | tr . _); \
	    echo "static _Alignas(4) const unsigned char spv_$$n[] = {"; \
	    od -An -v -tx1 $$f | sed -e 's/  */ /g' -e 's/^ //' -e 's/ *$$//' -e 's/\([0-9a-f][0-9a-f]\)/0x\1,/g'; \
	    echo '};'; \
	  done; } > $@.tmp
	mv $@.tmp $@

$(OBJ)/cc_vk.o: $(SHIM_GEN)/spirv.h src/cc_internal.h
$(OBJ)/cc_win.o: src/cc_internal.h
lint: $(SHIM_GEN)/spirv.h
