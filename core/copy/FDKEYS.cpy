*> The member names the feature data compiler (core/src/feat-data.cob) looks up in the JSON of placed features and features, as PIC X(40) items.
 01 FK-TYPE           PIC X(40) VALUE "type".
 01 FK-VALUE          PIC X(40) VALUE "value".
 01 FK-MIN-INC        PIC X(40) VALUE "min_inclusive".
 01 FK-MAX-INC        PIC X(40) VALUE "max_inclusive".
 01 FK-MIN            PIC X(40) VALUE "min".
 01 FK-MAX            PIC X(40) VALUE "max".
 01 FK-PLATEAU        PIC X(40) VALUE "plateau".
 01 FK-INNER          PIC X(40) VALUE "inner".
 01 FK-FEATURE        PIC X(40) VALUE "feature".
 01 FK-PLACEMENT      PIC X(40) VALUE "placement".
 01 FK-COUNT          PIC X(40) VALUE "count".
 01 FK-CHANCE         PIC X(40) VALUE "chance".
 01 FK-HEIGHTMAP      PIC X(40) VALUE "heightmap".
 01 FK-X              PIC X(40) VALUE "x".
 01 FK-Y              PIC X(40) VALUE "y".
 01 FK-Z              PIC X(40) VALUE "z".
 01 FK-HEIGHT         PIC X(40) VALUE "height".
 01 FK-PREDICATE      PIC X(40) VALUE "predicate".
 01 FK-MAX-WATER      PIC X(40) VALUE "max_water_depth".
 01 FK-DIRECTION      PIC X(40) VALUE "direction_of_search".
 01 FK-TARGET         PIC X(40) VALUE "target_condition".
 01 FK-ALLOWED        PIC X(40) VALUE "allowed_search_condition".
 01 FK-MAX-STEPS      PIC X(40) VALUE "max_steps".
 01 FK-OFFSET         PIC X(40) VALUE "offset".
 01 FK-BLOCKS         PIC X(40) VALUE "blocks".
 01 FK-TAG            PIC X(40) VALUE "tag".
 01 FK-FLUIDS         PIC X(40) VALUE "fluids".
 01 FK-PREDICATES     PIC X(40) VALUE "predicates".
 01 FK-MATCH          PIC X(40) VALUE "match".
 01 FK-FEATURES       PIC X(40) VALUE "features".
 01 FK-DEFAULT        PIC X(40) VALUE "default".
 01 FK-FEATURE-TRUE   PIC X(40) VALUE "feature_true".
 01 FK-FEATURE-FALSE  PIC X(40) VALUE "feature_false".
 01 FK-DATA           PIC X(40) VALUE "data".
 01 FK-WEIGHT         PIC X(40) VALUE "weight".
 01 FK-TO-PLACE       PIC X(40) VALUE "to_place".
 01 FK-STATE          PIC X(40) VALUE "state".
 01 FK-NAME           PIC X(40) VALUE "Name".
 01 FK-ID             PIC X(40) VALUE "id".
 01 FK-PROPERTIES     PIC X(40) VALUE "properties".
 01 FK-ENTRIES        PIC X(40) VALUE "entries".
 01 FK-XZ-SIZE        PIC X(40) VALUE "xz_size".
 01 FK-Y-SIZE         PIC X(40) VALUE "y_size".
 01 FK-EDGES          PIC X(40) VALUE "include_edges".
 01 FK-INTERIOR       PIC X(40) VALUE "include_interior".
 01 FK-MIN-INC-X      PIC X(40) VALUE "min_inclusive".
 01 FK-PROPERTIES-UC  PIC X(40) VALUE "Properties".
 01 FK-DISTRIBUTION   PIC X(40) VALUE "distribution".
