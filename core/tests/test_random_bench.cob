*> Benchmark (lane bugsw, T10300; docs/protocol/33 section 2.4): WORLDSIM-RANDOM on a standard world with 11 x 11 chunks loaded around a survival
*> player, at random_tick_speed 3 and 1000. The mean milliseconds of a run are shown (DISPLAY "BENCH ...") and must stay below a generous bound.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-RANDOM-BENCH.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY COREAPI.
 COPY PROTO.
 COPY BRWORLD.
 01 WS-CAPACITY            BINARY-LONG VALUE 65536.
 01 WS-NAME                PIC X(16) VALUE "Stefan".
 01 WS-NAME-LENGTH         BINARY-LONG VALUE 6.
 01 WS-CONN                BINARY-LONG.
 01 WS-PLAYER              BINARY-LONG.
 01 WS-DIM                 BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-CX                  BINARY-LONG.
 01 WS-CZ                  BINARY-LONG.
 01 WS-CROW                BINARY-LONG.
 01 WS-RULE-NAME           PIC X(40).
 01 WS-RULE-VALUE          BINARY-DOUBLE.
 01 WS-RULE-INDEX          BINARY-LONG.
 01 WS-DATE                PIC X(21).
 01 WS-T0                  BINARY-DOUBLE.
 01 WS-HUNDREDTHS          BINARY-DOUBLE.
 01 WS-MS                  FLOAT-LONG.
 01 WS-MS-TEXT             PIC -(5)9.99.
 01 WS-SPEED               BINARY-LONG.
 01 WS-RUNS                BINARY-LONG VALUE 10.
 PROCEDURE DIVISION.
     MOVE "N" TO TL-MODE
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     MOVE 5 TO CS-VIEW-DISTANCE
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     CALL "TEST-STANDARD-TABLES"
     CALL "BR-WORLD-READY"
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     CALL "TEST-JOIN" USING WS-NAME WS-NAME-LENGTH WS-CONN
     MOVE CN-PLAYER(WS-CONN) TO WS-PLAYER
     MOVE PL-DIM(WS-PLAYER) TO WS-DIM
     MOVE 0 TO PL-MODE(WS-PLAYER)
     PERFORM VARYING WS-CX FROM -5 BY 1 UNTIL WS-CX > 5
         PERFORM VARYING WS-CZ FROM -5 BY 1 UNTIL WS-CZ > 5
             CALL "WORLD-CHUNK" USING WS-DIM WS-CX WS-CZ WS-CROW
         END-PERFORM
     END-PERFORM
     MOVE "random_tick_speed" TO WS-RULE-NAME
     CALL "BR-RULE-FIND" USING WS-RULE-NAME WS-RULE-INDEX
     PERFORM VARYING WS-SPEED FROM 3 BY 997 UNTIL WS-SPEED > 1000
         MOVE WS-SPEED TO WS-RULE-VALUE
         CALL "BR-RULE-SET" USING WS-RULE-INDEX WS-RULE-VALUE
         CALL "WORLDSIM-RANDOM" USING WS-DIM
         PERFORM NOW
         MOVE WS-HUNDREDTHS TO WS-T0
         PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-RUNS
             CALL "WORLDSIM-RANDOM" USING WS-DIM
         END-PERFORM
         PERFORM NOW
         COMPUTE WS-MS = (WS-HUNDREDTHS - WS-T0) * 10 / WS-RUNS
         MOVE WS-MS TO WS-MS-TEXT
         DISPLAY "BENCH worldsim-random ms per tick at speed " WS-SPEED ": " WS-MS-TEXT
     END-PERFORM
     STOP RUN.
 NOW.
     MOVE FUNCTION CURRENT-DATE TO WS-DATE
     COMPUTE WS-HUNDREDTHS = FUNCTION NUMVAL(WS-DATE(9:2)) * 360000 + FUNCTION NUMVAL(WS-DATE(11:2)) * 6000
         + FUNCTION NUMVAL(WS-DATE(13:2)) * 100 + FUNCTION NUMVAL(WS-DATE(15:2)).
 END PROGRAM TEST-RANDOM-BENCH.
 COPY CORETEST.
