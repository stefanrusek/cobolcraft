*> Implementation test (wrap I2, T2450 and T2506; 20 sections 4.4 and 18.3, 19 section 3.6): the loot of the mount rows. A camel husk and a zombie horse drop rotten flesh U(2..3), a skeleton horse
*> bones U(0..2) (the real tables of the generated vanilla data, as test_mob_nautilus_loot opens them).
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-MOB-MOUNT-LOOT.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY COREAPI.
 COPY PROTO.
 01 WS-KEY                 PIC X(112).
 01 WS-ENTITY-ROW          PIC X(66).
 01 WS-X                   FLOAT-LONG.
 01 WS-Y                   FLOAT-LONG.
 01 WS-Z                   FLOAT-LONG.
 01 WS-NO-SHEEP            BINARY-LONG VALUE -1.
 01 WS-CAPACITY            BINARY-LONG VALUE 65536.
 01 WS-NAME                PIC X(16) VALUE "Alice".
 01 WS-NAME-LENGTH         BINARY-LONG VALUE 5.
 01 WS-ENV                 PIC X(1024).
 01 WS-DIR                 PIC X(1024).
 01 WS-FILE                PIC X(1100).
 01 WS-FILE-INFO           PIC X(16).
 01 WS-CONN                BINARY-LONG.
 01 WS-PLAYER              BINARY-LONG.
 01 WS-DIM                 BINARY-LONG.
 01 WS-STATUS              BINARY-LONG.
 01 WS-ITEM-TYPE           BINARY-LONG.
 01 WS-HUSK                BINARY-LONG.
 01 WS-ZOMBIE              BINARY-LONG.
 01 WS-SKELETON            BINARY-LONG.
 01 WS-FLESH               BINARY-LONG.
 01 WS-BONE                BINARY-LONG.
 01 WS-WHICH               BINARY-LONG.
 01 WS-PN                  BINARY-LONG.
 01 WS-K                   BINARY-LONG.
 01 WS-T                   BINARY-LONG.
 01 WS-TOTAL               BINARY-LONG.
 01 WS-LARGEST             BINARY-LONG.
 01 WS-LEAST               BINARY-LONG.
 PROCEDURE DIVISION.
     MOVE "N" TO TL-MODE
     MOVE SPACES TO WS-ENV
     ACCEPT WS-ENV FROM ENVIRONMENT "CC_GENERATED_DIR"
     IF WS-ENV = SPACES
         MOVE "/tmp/cc-test/generated" TO WS-DIR
     ELSE
         MOVE WS-ENV TO WS-DIR
     END-IF
     MOVE SPACES TO WS-FILE
     STRING FUNCTION TRIM(WS-DIR TRAILING) "/vanilla-data/pack.mcmeta" X"00" DELIMITED BY SIZE INTO WS-FILE
     CALL "CBL_CHECK_FILE_EXIST" USING WS-FILE WS-FILE-INFO
     IF RETURN-CODE NOT = 0
         MOVE "implementation 21 4.10 no generated packs here, skipped" TO TL-CASE
         MOVE 1 TO TL-EXPECTED-N
         MOVE 1 TO TL-OBSERVED-N
         CALL "TEST-ASSERT" USING TESTLIB-ASSERT
         STOP RUN
     END-IF
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     MOVE "standard" TO CS-WORLD-TYPE
     MOVE WS-DIR TO CS-GENERATED-DIR
     MOVE 2 TO CS-VIEW-DISTANCE
     MOVE 0 TO CS-HOSTILE-MOBS
     MOVE "12345" TO CS-SEED-TEXT
     MOVE "MountLoot" TO CS-NEW-WORLD-NAME
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     CALL "TEST-JOIN" USING WS-NAME WS-NAME-LENGTH WS-CONN
     MOVE CN-PLAYER(WS-CONN) TO WS-PLAYER
     MOVE 0 TO PL-MODE(WS-PLAYER)
     MOVE PL-DIM(WS-PLAYER) TO WS-DIM
     MOVE "item" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-ITEM-TYPE WS-ENTITY-ROW WS-STATUS
     MOVE "camel_husk" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-HUSK WS-ENTITY-ROW WS-STATUS
     MOVE "zombie_horse" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-ZOMBIE WS-ENTITY-ROW WS-STATUS
     MOVE "skeleton_horse" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-SKELETON WS-ENTITY-ROW WS-STATUS
     MOVE "rotten_flesh" TO WS-KEY
     CALL "TEST-ITEM-ID" USING WS-KEY WS-FLESH
     MOVE "bone" TO WS-KEY
     CALL "TEST-ITEM-ID" USING WS-KEY WS-BONE
     MOVE PL-Y(WS-PLAYER) TO WS-Y
     MOVE PL-Z(WS-PLAYER) TO WS-Z
     MOVE 0 TO WS-TOTAL WS-LARGEST WS-LEAST
     MOVE 99 TO WS-LEAST
     MOVE WS-FLESH TO WS-WHICH
     PERFORM VARYING WS-T FROM 1 BY 1 UNTIL WS-T > 60
         COMPUTE WS-X = PL-X(WS-PLAYER) + WS-T * 0.37
         CALL "STDMOB-DROPS" USING WS-DIM WS-X WS-Y WS-Z WS-HUSK WS-PLAYER WS-NO-SHEEP
         PERFORM SUM-AND-CLEAR
         ADD WS-PN TO WS-TOTAL
         PERFORM TRACK-RANGE
     END-PERFORM
     MOVE "acceptance US15 minecraft:camel_husk 20 4.4 drops rotten flesh U(2..3): 60 kills give 2 or 3 each" TO TL-CASE
     MOVE 23 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF WS-LEAST >= 2
         ADD 20 TO TL-OBSERVED-N
     END-IF
     IF WS-LARGEST <= 3
         ADD 3 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 0 TO WS-TOTAL WS-LARGEST
     MOVE 99 TO WS-LEAST
     PERFORM VARYING WS-T FROM 1 BY 1 UNTIL WS-T > 60
         COMPUTE WS-X = PL-X(WS-PLAYER) + WS-T * 0.37
         CALL "STDMOB-DROPS" USING WS-DIM WS-X WS-Y WS-Z WS-ZOMBIE WS-PLAYER WS-NO-SHEEP
         PERFORM SUM-AND-CLEAR
         PERFORM TRACK-RANGE
     END-PERFORM
     MOVE "acceptance US15 minecraft:zombie_horse 19 3.6 drops rotten flesh U(2..3): 60 kills give 2 or 3 each" TO TL-CASE
     MOVE 23 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF WS-LEAST >= 2
         ADD 20 TO TL-OBSERVED-N
     END-IF
     IF WS-LARGEST <= 3
         ADD 3 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 0 TO WS-TOTAL WS-LARGEST
     MOVE 99 TO WS-LEAST
     MOVE WS-BONE TO WS-WHICH
     PERFORM VARYING WS-T FROM 1 BY 1 UNTIL WS-T > 60
         COMPUTE WS-X = PL-X(WS-PLAYER) + WS-T * 0.37
         CALL "STDMOB-DROPS" USING WS-DIM WS-X WS-Y WS-Z WS-SKELETON WS-PLAYER WS-NO-SHEEP
         PERFORM SUM-AND-CLEAR
         ADD WS-PN TO WS-TOTAL
         PERFORM TRACK-RANGE
     END-PERFORM
     MOVE "acceptance US15 minecraft:skeleton_horse 19 3.6 drops bones U(0..2): at most 2 each, some over 60 kills" TO TL-CASE
     MOVE 12 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF WS-TOTAL > 20
         ADD 10 TO TL-OBSERVED-N
     END-IF
     IF WS-LARGEST <= 2
         ADD 2 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.
 TRACK-RANGE.
     IF WS-PN > WS-LARGEST
         MOVE WS-PN TO WS-LARGEST
     END-IF
     IF WS-PN < WS-LEAST
         MOVE WS-PN TO WS-LEAST
     END-IF.
 SUM-AND-CLEAR.
     MOVE 0 TO WS-PN
     PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > EN-COUNT
         IF EN-USED(WS-K) = 1 AND EN-TYPE(WS-K) = WS-ITEM-TYPE
             IF EN-ITEM(WS-K) = WS-WHICH
                 ADD EN-ITEM-COUNT(WS-K) TO WS-PN
             END-IF
             CALL "ENTITY-REMOVE" USING WS-K
         END-IF
     END-PERFORM.
 END PROGRAM TEST-MOB-MOUNT-LOOT.
 COPY CORETEST.
 COPY BETEST.
