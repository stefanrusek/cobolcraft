*> Test of 29 section 1, Update flags and limits (core/src/blockupd-29.cob; T0455): the ten flag bits and the four
*> combined constants (BLOCKUPD.cpy), the recursion budget 512, the build-height and chunk-coordinate bounds of
*> isInValidBounds (BU-VALID-BOUNDS, BU-CHUNK-VALID, BU-MAX-CHUNK-COORD) and isInWorldBounds (BU-WORLD-BOUNDS).
*> Expected values come from 29 section 1 (the derivation of 2,097,061 included), independently of the core.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-BLOCKUPD-29-1.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY BLOCKUPD.
 01 WS-MIN-Y               BINARY-LONG VALUE -64.
 01 WS-HEIGHT              BINARY-LONG VALUE 384.
 01 WS-X                   BINARY-LONG.
 01 WS-Y                   BINARY-LONG.
 01 WS-Z                   BINARY-LONG.
 01 WS-HIT                 BINARY-LONG.
 01 WS-VALUE               BINARY-LONG.
 01 WS-BITS                BINARY-LONG.
 01 WS-SHAPE               BINARY-LONG.
 01 WS-EXPECT              BINARY-LONG.
 PROCEDURE DIVISION.
     MOVE "N" TO TL-MODE
     MOVE "acceptance US12 29§1 Update flags and limits: bit values 1 2 4 8 16 32 64 128 256 512 in order"
         TO TL-CASE
     COMPUTE TL-OBSERVED-N = BU-UPDATE-NEIGHBORS + BU-UPDATE-CLIENTS * 10 + BU-UPDATE-INVISIBLE * 100
         + BU-UPDATE-IMMEDIATE * 1000
     COMPUTE TL-EXPECTED-N = 1 + 2 * 10 + 4 * 100 + 8 * 1000
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29§1 Update flags and limits: bits 4 to 9 are 16 32 64 128 256 512" TO TL-CASE
     COMPUTE TL-OBSERVED-N = BU-UPDATE-KNOWN-SHAPE * 1000000000000 / 1 + BU-UPDATE-SUPPRESS-DROPS
         + BU-UPDATE-MOVE-BY-PISTON + BU-UPDATE-SKIP-SHAPE-ON-WIRE + BU-UPDATE-SKIP-BLOCK-ENTITY-SIDEEFFECTS
         + BU-UPDATE-SKIP-ON-PLACE
     COMPUTE TL-EXPECTED-N = 16 * 1000000000000 + 32 + 64 + 128 + 256 + 512
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29§1 Update flags and limits: UPDATE_NONE is 260 (4 + 256)" TO TL-CASE
     MOVE BU-UPDATE-NONE TO TL-OBSERVED-N
     MOVE 260 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29§1 Update flags and limits: UPDATE_ALL 3, UPDATE_ALL_IMMEDIATE 11" TO TL-CASE
     COMPUTE TL-OBSERVED-N = BU-UPDATE-ALL * 100 + BU-UPDATE-ALL-IMMEDIATE
     MOVE 311 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29§1 Update flags and limits: UPDATE_SKIP_ALL_SIDEEFFECTS is 816 (512 + 256 + 32 + 16)"
         TO TL-CASE
     MOVE BU-UPDATE-SKIP-ALL-SIDEEFFECTS TO TL-OBSERVED-N
     MOVE 816 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29§1 Update flags and limits: UPDATE_LIMIT, the recursion budget, is 512" TO TL-CASE
     MOVE BU-UPDATE-LIMIT TO TL-OBSERVED-N
     MOVE 512 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29§1 Update flags and limits: the shape-update flags of 2.2 step 7 clear bits 0 and 5 (-34)"
         TO TL-CASE
     MOVE 43 TO WS-EXPECT
     CALL "BU-SHAPE-FLAGS" USING WS-EXPECT WS-VALUE
     MOVE WS-VALUE TO TL-OBSERVED-N
     MOVE 10 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "acceptance US12 29§1 Update flags and limits: the shape-update chain is 512 levels deep: budget 512 runs "
         & "the update, budget 0 does not" TO TL-CASE
     MOVE 512 TO WS-VALUE
     CALL "BU-BUDGET-OPEN" USING WS-VALUE WS-HIT
     COMPUTE TL-OBSERVED-N = WS-HIT * 10
     MOVE 0 TO WS-VALUE
     CALL "BU-BUDGET-OPEN" USING WS-VALUE WS-HIT
     ADD WS-HIT TO TL-OBSERVED-N
     MOVE 10 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "acceptance US12 29§1 Update flags and limits: inside build height is minY to minY + height - 1" TO TL-CASE
     MOVE 0 TO WS-X WS-Z
     MOVE -64 TO WS-Y
     CALL "BU-VALID-BOUNDS" USING WS-MIN-Y WS-HEIGHT WS-X WS-Y WS-Z WS-HIT
     MOVE WS-HIT TO TL-OBSERVED-N
     MOVE 319 TO WS-Y
     CALL "BU-VALID-BOUNDS" USING WS-MIN-Y WS-HEIGHT WS-X WS-Y WS-Z WS-HIT
     COMPUTE TL-OBSERVED-N = TL-OBSERVED-N * 10 + WS-HIT
     MOVE -65 TO WS-Y
     CALL "BU-VALID-BOUNDS" USING WS-MIN-Y WS-HEIGHT WS-X WS-Y WS-Z WS-HIT
     COMPUTE TL-OBSERVED-N = TL-OBSERVED-N * 10 + WS-HIT
     MOVE 320 TO WS-Y
     CALL "BU-VALID-BOUNDS" USING WS-MIN-Y WS-HEIGHT WS-X WS-Y WS-Z WS-HIT
     COMPUTE TL-OBSERVED-N = TL-OBSERVED-N * 10 + WS-HIT
     MOVE 1100 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "acceptance US12 29§1 Update flags and limits: PACKED_HORIZONTAL_LENGTH 26 gives maximum coordinate "
         & "33554431 and section 2097151" TO TL-CASE
     CALL "BU-PACKED-LENGTH" USING WS-BITS WS-VALUE WS-SHAPE
     COMPUTE TL-OBSERVED-N = WS-BITS * 1000000000000 + WS-VALUE * 1000 + WS-SHAPE / 1000
     COMPUTE TL-EXPECTED-N = 26 * 1000000000000 + 33554431 * 1000 + 2097
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29§1 Update flags and limits: that section coordinate itself is 2097151" TO TL-CASE
     MOVE WS-SHAPE TO TL-OBSERVED-N
     MOVE 2097151 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "acceptance US12 29§1 Update flags and limits: the pyramid has 12 accumulated dependencies, margin 90, "
         & "maximum chunk coordinate 2097061" TO TL-CASE
     CALL "BU-MAX-CHUNK-COORD" USING WS-VALUE
     MOVE WS-VALUE TO TL-OBSERVED-N
     MOVE 2097061 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29§1 Update flags and limits: the pyramid margin is (32 + 12 + 1) * 2 = 90" TO TL-CASE
     CALL "BU-SAFETY-MARGIN" USING WS-VALUE
     MOVE WS-VALUE TO TL-OBSERVED-N
     MOVE 90 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "acceptance US12 29§1 Update flags and limits: ChunkPos.isValid uses the larger absolute coordinate, "
         & "2097061 valid and 2097062 not, negative too" TO TL-CASE
     MOVE 2097061 TO WS-X
     MOVE 0 TO WS-Z
     CALL "BU-CHUNK-VALID" USING WS-X WS-Z WS-HIT
     MOVE WS-HIT TO TL-OBSERVED-N
     MOVE 2097062 TO WS-X
     CALL "BU-CHUNK-VALID" USING WS-X WS-Z WS-HIT
     COMPUTE TL-OBSERVED-N = TL-OBSERVED-N * 10 + WS-HIT
     MOVE 5 TO WS-X
     MOVE -2097061 TO WS-Z
     CALL "BU-CHUNK-VALID" USING WS-X WS-Z WS-HIT
     COMPUTE TL-OBSERVED-N = TL-OBSERVED-N * 10 + WS-HIT
     MOVE -2097062 TO WS-Z
     CALL "BU-CHUNK-VALID" USING WS-X WS-Z WS-HIT
     COMPUTE TL-OBSERVED-N = TL-OBSERVED-N * 10 + WS-HIT
     MOVE 1010 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "acceptance US12 29§1 Update flags and limits: a block position is chunk-valid up to x 33552991 "
         & "(2097061 * 16 + 15)" TO TL-CASE
     MOVE 0 TO WS-Y WS-Z
     MOVE 33552991 TO WS-X
     CALL "BU-VALID-BOUNDS" USING WS-MIN-Y WS-HEIGHT WS-X WS-Y WS-Z WS-HIT
     MOVE WS-HIT TO TL-OBSERVED-N
     MOVE 33552992 TO WS-X
     CALL "BU-VALID-BOUNDS" USING WS-MIN-Y WS-HEIGHT WS-X WS-Y WS-Z WS-HIT
     COMPUTE TL-OBSERVED-N = TL-OBSERVED-N * 10 + WS-HIT
     MOVE 10 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "acceptance US12 29§1 Update flags and limits: isInWorldBounds takes -30000000 and 29999999, refuses "
         & "30000000 and -30000001 (the upper test is strict)" TO TL-CASE
     MOVE -30000000 TO WS-X
     MOVE 29999999 TO WS-Z
     CALL "BU-WORLD-BOUNDS" USING WS-X WS-Z WS-HIT
     MOVE WS-HIT TO TL-OBSERVED-N
     MOVE 30000000 TO WS-X
     CALL "BU-WORLD-BOUNDS" USING WS-X WS-Z WS-HIT
     COMPUTE TL-OBSERVED-N = TL-OBSERVED-N * 10 + WS-HIT
     MOVE -30000001 TO WS-X
     CALL "BU-WORLD-BOUNDS" USING WS-X WS-Z WS-HIT
     COMPUTE TL-OBSERVED-N = TL-OBSERVED-N * 10 + WS-HIT
     MOVE 0 TO WS-X
     MOVE 30000000 TO WS-Z
     CALL "BU-WORLD-BOUNDS" USING WS-X WS-Z WS-HIT
     COMPUTE TL-OBSERVED-N = TL-OBSERVED-N * 10 + WS-HIT
     MOVE 1000 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "acceptance US12 29§1 Update flags and limits: the world bounds bind before the chunk bounds "
         & "(30000000 is chunk-valid)" TO TL-CASE
     MOVE 30000000 TO WS-X
     MOVE 0 TO WS-Z
     MOVE 0 TO WS-Y
     CALL "BU-VALID-BOUNDS" USING WS-MIN-Y WS-HEIGHT WS-X WS-Y WS-Z WS-HIT
     MOVE WS-HIT TO TL-OBSERVED-N
     MOVE 1 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.
