*> Implementation test of the improved, octave and normal noise (core/src/noise.cob; T0411;
*> docs/protocol/10 section 3, worked examples of 13.1): the permutation table and offsets of a perlin octave, its
*> values, a normal noise's layers (amplitudes, frequencies, skipped octaves), its values bit for bit
*> through the cc_f64 functions, far coordinates (wrap), normalisation disabled. The expected values of
*> the cases without a number in 13.1 come from an independent reference implementation of the section.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-NOISE.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY XORO.
 COPY NOISE.
 01 WS-FACTORY.
    05 WS-FLO               BINARY-DOUBLE UNSIGNED.
    05 WS-FHI               BINARY-DOUBLE UNSIGNED.
 01 WS-A.
    05 WS-ALO               BINARY-DOUBLE UNSIGNED.
    05 WS-AHI               BINARY-DOUBLE UNSIGNED.
 01 WS-SEED                BINARY-DOUBLE UNSIGNED.
 01 WS-NAME                PIC X(64).
 01 WS-LEN                 BINARY-LONG.
 01 WS-BASE                BINARY-LONG.
 01 WS-COUNT               BINARY-LONG.
 01 WS-AMP                 FLOAT-LONG.
 01 WS-MODS.
    05 WS-MOD              FLOAT-LONG OCCURS 32 TIMES.
 01 WS-MOD-COUNT           BINARY-LONG.
 01 WS-NORMALIZE           BINARY-LONG.
 01 WS-HANDLE              BINARY-LONG.
 01 WS-X                   FLOAT-LONG.
 01 WS-Y                   FLOAT-LONG.
 01 WS-Z                   FLOAT-LONG.
 01 WS-R                   FLOAT-LONG.
 01 WS-BITS                BINARY-DOUBLE.
 01 WS-EDIT-S              PIC -(19)9.
 01 WS-TXT                 PIC X(32).
 01 WS-INT                 BINARY-LONG.
 01 WS-TEXT                PIC X(240).
 01 WS-PTR                 BINARY-LONG.
 01 WS-T2                 PIC X(240).
 01 WS-PERLIN              BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 PROCEDURE DIVISION.
     MOVE "T" TO TL-MODE
     CALL "NOISE-RESET"
     MOVE 0 TO WS-SEED
     CALL "XORO-SEED" USING WS-SEED XR-STATE
     CALL "XORO-FORK-POSITIONAL" USING XR-STATE WS-FACTORY

*>   The perlin octave -9 of noise A of continentalness (13.1).
     MOVE "minecraft:continentalness" TO WS-NAME
     MOVE 25 TO WS-LEN
     CALL "XORO-FROM-HASH" USING WS-FACTORY WS-NAME WS-LEN XR-STATE
     CALL "XORO-FORK-POSITIONAL" USING XR-STATE WS-A
     MOVE "octave_-9" TO WS-NAME
     MOVE 9 TO WS-LEN
     CALL "XORO-FROM-HASH" USING WS-A WS-NAME WS-LEN XR-STATE
     MOVE 0 TO WS-AMP
     CALL "PERLIN-CREATE" USING XR-STATE WS-AMP WS-PERLIN

     MOVE "test noise perlin offsetX of the worked example is bit exact (13.1)" TO TL-CASE
     CALL STATIC "cc_f64_f64_bits" USING BY REFERENCE NZ-OX(WS-PERLIN) WS-BITS
     PERFORM SHOW-BITS
     MOVE "4637288643442230508" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test noise perlin first eight permutation entries (13.1)" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 8
         MOVE NZ-PERM(WS-PERLIN, WS-I) TO WS-EDIT-S
         STRING FUNCTION TRIM(WS-EDIT-S) " " DELIMITED BY SIZE INTO WS-TEXT POINTER WS-PTR
     END-PERFORM
     MOVE WS-TEXT TO TL-OBSERVED
     MOVE "254 118 111 215 206 135 96 9" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test noise perlin get(0.5, 0.5, 0.5) = -0.06469294428825378 (13.1)" TO TL-CASE
     MOVE 0.5 TO WS-X WS-Y WS-Z
     CALL "PERLIN-GET" USING WS-PERLIN WS-X WS-Y WS-Z WS-R
     CALL STATIC "cc_f64_f64_bits" USING BY REFERENCE WS-R WS-BITS
     PERFORM SHOW-BITS
     MOVE "-4634045998274969600" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test noise perlin get(3.2, -1.7, 10.9) = -0.24498175084590912 (13.1)" TO TL-CASE
     MOVE "3.2" TO WS-TXT(1:3) MOVE X"00" TO WS-TXT(4:1)
     CALL STATIC "cc_f64_from_text" USING BY REFERENCE WS-TXT WS-X
     MOVE "-1.7" TO WS-TXT(1:4) MOVE X"00" TO WS-TXT(5:1)
     CALL STATIC "cc_f64_from_text" USING BY REFERENCE WS-TXT WS-Y
     MOVE "10.9" TO WS-TXT(1:4) MOVE X"00" TO WS-TXT(5:1)
     CALL STATIC "cc_f64_from_text" USING BY REFERENCE WS-TXT WS-Z
     CALL "PERLIN-GET" USING WS-PERLIN WS-X WS-Y WS-Z WS-R
     CALL STATIC "cc_f64_f64_bits" USING BY REFERENCE WS-R WS-BITS
     PERFORM SHOW-BITS
     MOVE "-4625377618789662720" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

*>   Continentalness: 9 slots, modifiers 1 1 2 2 2 1 1 1 1.
     MOVE -9 TO WS-BASE
     MOVE 9 TO WS-COUNT
     MOVE "0.8880832896205223" TO WS-TXT(1:18) MOVE X"00" TO WS-TXT(19:1)
     CALL STATIC "cc_f64_from_text" USING BY REFERENCE WS-TXT WS-AMP
     MOVE 1 TO WS-MOD(1) WS-MOD(2) WS-MOD(6) WS-MOD(7) WS-MOD(8) WS-MOD(9)
     MOVE 2 TO WS-MOD(3) WS-MOD(4) WS-MOD(5)
     MOVE 9 TO WS-MOD-COUNT
     MOVE 0 TO WS-NORMALIZE
     MOVE "minecraft:continentalness" TO WS-NAME
     MOVE 25 TO WS-LEN
     CALL "NOISE-CREATE" USING WS-FACTORY WS-NAME WS-LEN WS-BASE WS-COUNT WS-AMP WS-MODS
         WS-MOD-COUNT WS-NORMALIZE WS-HANDLE

     MOVE "test noise continentalness has 18 layers, two per octave" TO TL-CASE
     MOVE "N" TO TL-MODE
     MOVE NZ-LAYER-N(WS-HANDLE) TO TL-OBSERVED-N
     MOVE 18 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "T" TO TL-MODE

     MOVE "test noise continentalness first layer amplitude 0.7514677 as a float (13.1)" TO TL-CASE
     MOVE NZ-FIRST(WS-HANDLE) TO WS-I
     CALL STATIC "cc_f64_f64_bits" USING BY REFERENCE NZ-L-AMP(WS-I) WS-BITS
     PERFORM SHOW-BITS
     MOVE "4604943838895669248" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test noise continentalness last layer amplitude 0.0029354 (13.1)" TO TL-CASE
     COMPUTE WS-I = NZ-FIRST(WS-HANDLE) + 17
     CALL STATIC "cc_f64_f64_bits" USING BY REFERENCE NZ-L-AMP(WS-I) WS-BITS
     PERFORM SHOW-BITS
     MOVE "4568915041876705280" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test noise continentalness last frequency is 2^-1 times 1.0181268882175227" TO TL-CASE
     CALL STATIC "cc_f64_f64_bits" USING BY REFERENCE NZ-L-FREQ(WS-I) WS-BITS
     PERFORM SHOW-BITS
     MOVE "4602760455419668734" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test noise continentalness at (0, 0, 0) = -0.027066009119153023 (13.1)" TO TL-CASE
     MOVE 0 TO WS-X WS-Y WS-Z
     CALL "NOISE-GET" USING WS-HANDLE WS-X WS-Y WS-Z WS-R
     CALL STATIC "cc_f64_f64_bits" USING BY REFERENCE WS-R WS-BITS
     PERFORM SHOW-BITS
     MOVE "-4639913569457012736" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test noise continentalness at (100, 0, -200) = 0.015725092962384224 (13.1)" TO TL-CASE
     MOVE 100 TO WS-X
     MOVE -200 TO WS-Z
     CALL "NOISE-GET" USING WS-HANDLE WS-X WS-Y WS-Z WS-R
     CALL STATIC "cc_f64_f64_bits" USING BY REFERENCE WS-R WS-BITS
     PERFORM SHOW-BITS
     MOVE "4580189670867992576" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test noise far coordinates wrap before the offsets (3 to 6 units beyond 2^24)" TO TL-CASE
     MOVE "30000000.5" TO WS-TXT(1:10) MOVE X"00" TO WS-TXT(11:1)
     CALL STATIC "cc_f64_from_text" USING BY REFERENCE WS-TXT WS-X
     MOVE "12.25" TO WS-TXT(1:5) MOVE X"00" TO WS-TXT(6:1)
     CALL STATIC "cc_f64_from_text" USING BY REFERENCE WS-TXT WS-Y
     MOVE "-33554433.75" TO WS-TXT(1:12) MOVE X"00" TO WS-TXT(13:1)
     CALL STATIC "cc_f64_from_text" USING BY REFERENCE WS-TXT WS-Z
     CALL "NOISE-GET" USING WS-HANDLE WS-X WS-Y WS-Z WS-R
     CALL STATIC "cc_f64_f64_bits" USING BY REFERENCE WS-R WS-BITS
     PERFORM SHOW-BITS
     MOVE "4599426061124501504" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

*>   Erosion: a zero modifier skips an octave and consumes no random numbers.
     MOVE -9 TO WS-BASE
     MOVE 5 TO WS-COUNT
     MOVE "1.063180125160734" TO WS-TXT(1:17) MOVE X"00" TO WS-TXT(18:1)
     CALL STATIC "cc_f64_from_text" USING BY REFERENCE WS-TXT WS-AMP
     MOVE 1 TO WS-MOD(1) WS-MOD(2) WS-MOD(4) WS-MOD(5)
     MOVE 0 TO WS-MOD(3)
     MOVE 5 TO WS-MOD-COUNT
     MOVE "minecraft:erosion" TO WS-NAME
     MOVE 17 TO WS-LEN
     CALL "NOISE-CREATE" USING WS-FACTORY WS-NAME WS-LEN WS-BASE WS-COUNT WS-AMP WS-MODS
         WS-MOD-COUNT WS-NORMALIZE WS-HANDLE
     MOVE "test noise erosion skips the zero modifier octave: 8 layers, value as reference" TO TL-CASE
     MOVE "1.5" TO WS-TXT(1:3) MOVE X"00" TO WS-TXT(4:1)
     CALL STATIC "cc_f64_from_text" USING BY REFERENCE WS-TXT WS-X
     MOVE "2.5" TO WS-TXT(1:3) CALL STATIC "cc_f64_from_text" USING BY REFERENCE WS-TXT WS-Y
     MOVE "3.5" TO WS-TXT(1:3) CALL STATIC "cc_f64_from_text" USING BY REFERENCE WS-TXT WS-Z
     CALL "NOISE-GET" USING WS-HANDLE WS-X WS-Y WS-Z WS-R
     CALL STATIC "cc_f64_f64_bits" USING BY REFERENCE WS-R WS-BITS
     MOVE SPACES TO WS-TEXT
     MOVE NZ-LAYER-N(WS-HANDLE) TO WS-EDIT-S
     MOVE FUNCTION TRIM(WS-EDIT-S) TO WS-TEXT
     PERFORM SHOW-BITS
     PERFORM JOIN-RESULT
     MOVE "8 -4632078624617398272" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

*>   One octave: amplitude 5/6; no modifier list.
     MOVE -3 TO WS-BASE
     MOVE 1 TO WS-COUNT
     MOVE "0.955388882960065" TO WS-TXT(1:17) MOVE X"00" TO WS-TXT(18:1)
     CALL STATIC "cc_f64_from_text" USING BY REFERENCE WS-TXT WS-AMP
     MOVE 0 TO WS-MOD-COUNT
     MOVE "minecraft:aquifer_barrier" TO WS-NAME
     MOVE 25 TO WS-LEN
     CALL "NOISE-CREATE" USING WS-FACTORY WS-NAME WS-LEN WS-BASE WS-COUNT WS-AMP WS-MODS
         WS-MOD-COUNT WS-NORMALIZE WS-HANDLE
     MOVE "test noise one octave without a modifier list: amplitude 5/6 and value" TO TL-CASE
     MOVE NZ-FIRST(WS-HANDLE) TO WS-I
     CALL STATIC "cc_f64_f64_bits" USING BY REFERENCE NZ-L-AMP(WS-I) WS-BITS
     PERFORM SHOW-BITS
     MOVE FUNCTION TRIM(TL-OBSERVED) TO WS-TEXT
     MOVE "10.5" TO WS-TXT(1:4) MOVE X"00" TO WS-TXT(5:1)
     CALL STATIC "cc_f64_from_text" USING BY REFERENCE WS-TXT WS-X
     MOVE "-20.25" TO WS-TXT(1:6) MOVE X"00" TO WS-TXT(7:1)
     CALL STATIC "cc_f64_from_text" USING BY REFERENCE WS-TXT WS-Y
     MOVE "3.75" TO WS-TXT(1:4) MOVE X"00" TO WS-TXT(5:1)
     CALL STATIC "cc_f64_from_text" USING BY REFERENCE WS-TXT WS-Z
     CALL "NOISE-GET" USING WS-HANDLE WS-X WS-Y WS-Z WS-R
     CALL STATIC "cc_f64_f64_bits" USING BY REFERENCE WS-R WS-BITS
     PERFORM SHOW-BITS
     PERFORM JOIN-RESULT
     MOVE "4605681218745270272 4590934189762674688" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

*>   Normalisation disabled: sixteen octaves of jagged.
     MOVE -16 TO WS-BASE
     MOVE 16 TO WS-COUNT
     MOVE "1.0383104856073737" TO WS-TXT(1:18) MOVE X"00" TO WS-TXT(19:1)
     CALL STATIC "cc_f64_from_text" USING BY REFERENCE WS-TXT WS-AMP
     MOVE 1 TO WS-NORMALIZE
     MOVE "minecraft:jagged" TO WS-NAME
     MOVE 16 TO WS-LEN
     CALL "NOISE-CREATE" USING WS-FACTORY WS-NAME WS-LEN WS-BASE WS-COUNT WS-AMP WS-MODS
         WS-MOD-COUNT WS-NORMALIZE WS-HANDLE
     MOVE "test noise normalisation disabled keeps the nominal amplitudes" TO TL-CASE
     MOVE 100 TO WS-X
     MOVE 0 TO WS-Y
     MOVE -100 TO WS-Z
     CALL "NOISE-GET" USING WS-HANDLE WS-X WS-Y WS-Z WS-R
     CALL STATIC "cc_f64_f64_bits" USING BY REFERENCE WS-R WS-BITS
     MOVE NZ-LAYER-N(WS-HANDLE) TO WS-EDIT-S
     MOVE FUNCTION TRIM(WS-EDIT-S) TO WS-TEXT
     PERFORM SHOW-BITS
     PERFORM JOIN-RESULT
     MOVE "32 -4622479533235240960" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   A smeared octave (10 section 3.4) of minecraft:terrain, scale 4.277575: base = y when 0 <= y < yFrac.
     MOVE "minecraft:terrain" TO WS-NAME
     MOVE 17 TO WS-LEN
     CALL "XORO-FROM-HASH" USING WS-FACTORY WS-NAME WS-LEN XR-STATE
     MOVE "4.277575" TO WS-TXT(1:8) MOVE X"00" TO WS-TXT(9:1)
     CALL STATIC "cc_f64_from_text" USING BY REFERENCE WS-TXT WS-AMP
     CALL "PERLIN-CREATE" USING XR-STATE WS-AMP WS-PERLIN
     MOVE "test noise smeared octave at y = 0 takes base = y and at y = 0.3 base = yFrac, and far y" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE "1.25" TO WS-TXT(1:4) MOVE X"00" TO WS-TXT(5:1)
     CALL STATIC "cc_f64_from_text" USING BY REFERENCE WS-TXT WS-X
     MOVE "-2.5" TO WS-TXT(1:4) CALL STATIC "cc_f64_from_text" USING BY REFERENCE WS-TXT WS-Z
     MOVE 0 TO WS-Y
     CALL "PERLIN-GET" USING WS-PERLIN WS-X WS-Y WS-Z WS-R
     CALL STATIC "cc_f64_f64_bits" USING BY REFERENCE WS-R WS-BITS
     PERFORM SHOW-BITS
     MOVE FUNCTION TRIM(TL-OBSERVED) TO WS-TEXT
     MOVE "0.3" TO WS-TXT(1:3) MOVE X"00" TO WS-TXT(4:1)
     CALL STATIC "cc_f64_from_text" USING BY REFERENCE WS-TXT WS-Y
     CALL "PERLIN-GET" USING WS-PERLIN WS-X WS-Y WS-Z WS-R
     CALL STATIC "cc_f64_f64_bits" USING BY REFERENCE WS-R WS-BITS
     PERFORM SHOW-BITS
     PERFORM JOIN-RESULT
     MOVE FUNCTION TRIM(TL-OBSERVED) TO WS-TEXT
     MOVE "7.5" TO WS-TXT(1:3) MOVE X"00" TO WS-TXT(4:1)
     CALL STATIC "cc_f64_from_text" USING BY REFERENCE WS-TXT WS-X
     MOVE "12.75" TO WS-TXT(1:5) MOVE X"00" TO WS-TXT(6:1)
     CALL STATIC "cc_f64_from_text" USING BY REFERENCE WS-TXT WS-Y
     MOVE "3.125" TO WS-TXT(1:5) MOVE X"00" TO WS-TXT(6:1)
     CALL STATIC "cc_f64_from_text" USING BY REFERENCE WS-TXT WS-Z
     CALL "PERLIN-GET" USING WS-PERLIN WS-X WS-Y WS-Z WS-R
     CALL STATIC "cc_f64_f64_bits" USING BY REFERENCE WS-R WS-BITS
     PERFORM SHOW-BITS
     PERFORM JOIN-RESULT
     MOVE "-4620709988455677952 -4621213693630218240 -4641928824483741696" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

*>   A positive base octave: frequency 2^2 for the first octave.
     MOVE 2 TO WS-BASE
     MOVE 2 TO WS-COUNT
     MOVE 1.5 TO WS-AMP
     MOVE 1 TO WS-MOD(1)
     MOVE 0.5 TO WS-MOD(2)
     MOVE 2 TO WS-MOD-COUNT
     MOVE 0 TO WS-NORMALIZE
     MOVE "minecraft:high_base" TO WS-NAME
     MOVE 19 TO WS-LEN
     CALL "NOISE-CREATE" USING WS-FACTORY WS-NAME WS-LEN WS-BASE WS-COUNT WS-AMP WS-MODS
         WS-MOD-COUNT WS-NORMALIZE WS-HANDLE
     MOVE "test noise a positive base octave has frequency 4 and the value as reference" TO TL-CASE
     MOVE NZ-FIRST(WS-HANDLE) TO WS-I
     CALL STATIC "cc_f64_f64_bits" USING BY REFERENCE NZ-L-FREQ(WS-I) WS-BITS
     PERFORM SHOW-BITS
     MOVE FUNCTION TRIM(TL-OBSERVED) TO WS-TEXT
     MOVE "0.0625" TO WS-TXT(1:6) MOVE X"00" TO WS-TXT(7:1)
     CALL STATIC "cc_f64_from_text" USING BY REFERENCE WS-TXT WS-X
     MOVE "0.125" TO WS-TXT(1:5) MOVE X"00" TO WS-TXT(6:1)
     CALL STATIC "cc_f64_from_text" USING BY REFERENCE WS-TXT WS-Y
     MOVE "-0.25" TO WS-TXT(1:5) MOVE X"00" TO WS-TXT(6:1)
     CALL STATIC "cc_f64_from_text" USING BY REFERENCE WS-TXT WS-Z
     CALL "NOISE-GET" USING WS-HANDLE WS-X WS-Y WS-Z WS-R
     CALL STATIC "cc_f64_f64_bits" USING BY REFERENCE WS-R WS-BITS
     PERFORM SHOW-BITS
     PERFORM JOIN-RESULT
     MOVE "4616189618054758400 -4631836712731934720" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     STOP RUN.

 JOIN-RESULT.
     MOVE FUNCTION TRIM(TL-OBSERVED) TO WS-T2
     MOVE SPACES TO TL-OBSERVED
     STRING FUNCTION TRIM(WS-TEXT) " " FUNCTION TRIM(WS-T2) DELIMITED BY SIZE INTO TL-OBSERVED.

 SHOW-BITS.
     MOVE WS-BITS TO WS-EDIT-S
     MOVE FUNCTION TRIM(WS-EDIT-S) TO TL-OBSERVED.
 END PROGRAM TEST-NOISE.
