     MOVE "acceptance US12 40-2§8 Packet summary for this part: Container Set Data (8, 1.4): property and value are 16-bit shorts, an out-of-range value wraps modulo 65536 (32768 arrives as -32768)" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN2-DATA-WIRE" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1200" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN2-DATA-WIRE" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "32767" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN2-DATA-WIRE" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "32768" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN2-DATA-WIRE" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "65535" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN2-DATA-WIRE" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "65536" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN2-DATA-WIRE" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
