     CALL "MN2-PART-PACKET" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "3" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN2-PART-PACKET" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "4" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN2-PART-PACKET" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
