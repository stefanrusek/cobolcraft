     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "-32768" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN2-DATA-WIRE" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "-32769" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN2-DATA-WIRE" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "70000" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN2-DATA-WIRE" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 1200 32767 -32768 -1 0 -1 -32768 32767 4464" TO TL-EXPECTED
