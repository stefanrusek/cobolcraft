*> Entity NBT, part 1: the Entity base keys (docs/protocol/45-entity-nbt-1-shared-model-and-entity-base.md section 5; lane 002-lane-p49c, T15560): a saved entity
*> compound holds, after id, Pos, Motion and Rotation, the always-written keys fall_distance (Double), Fire (Short), Air (Short, 300 less the air lost), OnGround (Byte),
*> Invulnerable (Byte), PortalCooldown (Int) and UUID (Int array of 4) in that order; reading it back restores the on-ground flag, the fire ticks, the air lost and the UUID.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-ENTITY-NBT-1.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY COREAPI.
 COPY DIMENSIONS.
 COPY ETIDS.
 COPY PROTO.
 01 WS-CAPACITY            BINARY-LONG VALUE 65536.
 01 WS-NAME                PIC X(16) VALUE "Alice".
 01 WS-NAME-LENGTH         BINARY-LONG VALUE 5.
 01 WS-ALICE               BINARY-LONG.
 01 WS-DIM                 BINARY-LONG.
 01 WS-CX                  BINARY-LONG VALUE 1.
 01 WS-CZ                  BINARY-LONG VALUE 2.
 01 WS-TYPE                BINARY-LONG.
 01 WS-MOB                 BINARY-LONG.
 01 WS-ROW                 BINARY-LONG.
 01 WS-X                   FLOAT-LONG.
 01 WS-Y                   FLOAT-LONG.
 01 WS-Z                   FLOAT-LONG.
 01 WS-YAW                 FLOAT-SHORT.
 01 WS-ROOT                BINARY-LONG.
 01 WS-FRAMING             BINARY-LONG VALUE 1.
 01 WS-ROOT-TYPE           BINARY-LONG.
 01 WS-OUTCOME             BINARY-LONG.
 01 WS-PATH                PIC X(128).
 01 WS-TEXT                PIC X(8192).
 01 WS-UUID                PIC X(16).
 01 WS-AT                  BINARY-LONG.
 01 WS-POINTER             BINARY-LONG.
 01 WS-HEAD                PIC X(8192).
 01 WS-TAIL                PIC X(8192).
 01 WS-TAIL-A              PIC X(8192).
 01 WS-TAIL-B              PIC X(8192).
 01 WS-NAME-Z              PIC X(32).
 01 WS-NAME-LEN            BINARY-LONG.
 01 WS-ID                  PIC X(32).
 01 WS-ID-LEN              BINARY-LONG.
 01 WS-ONE                 BINARY-LONG VALUE 1.
 01 WS-TWO                 BINARY-LONG VALUE 2.
 01 WS-THREE               BINARY-LONG VALUE 3.
 01 WS-MINUS-ONE           BINARY-LONG VALUE -1.
 01 WS-T-FLOAT             BINARY-LONG VALUE 5.
 01 WS-T-DOUBLE            BINARY-LONG VALUE 6.
 01 WS-T-COMPOUND          BINARY-LONG VALUE 10.
 01 WS-PX                  FLOAT-LONG.
 01 WS-PX-B                REDEFINES WS-PX PIC X(8).
 01 WS-PY                  FLOAT-LONG.
 01 WS-PY-B                REDEFINES WS-PY PIC X(8).
 01 WS-PZ                  FLOAT-LONG.
 01 WS-MX                  FLOAT-LONG.
 01 WS-MY                  FLOAT-LONG.
 01 WS-MZ                  FLOAT-LONG.
 01 WS-ZERO-F              FLOAT-SHORT VALUE 0.
 01 WS-INF-F               FLOAT-SHORT.
 01 WS-INF-B               REDEFINES WS-INF-F PIC X(4).
 01 WS-BAD-YAW             BINARY-LONG VALUE 0.
 PROCEDURE DIVISION.
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     MOVE 0 TO CS-HOSTILE-MOBS
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     CALL "TEST-JOIN" USING WS-NAME WS-NAME-LENGTH WS-ALICE
     MOVE DIM-MAIN TO WS-DIM
     MOVE ET-SODGRAZER TO WS-TYPE
     MOVE 20.5 TO WS-X MOVE 55 TO WS-Y MOVE 37.25 TO WS-Z
     MOVE 90 TO WS-YAW
     CALL "MOB-SPAWN" USING WS-DIM WS-TYPE WS-X WS-Y WS-Z WS-YAW WS-MOB
     MOVE 1 TO EN-ON-GROUND(WS-MOB)
     MOVE 40 TO EN-BURN(WS-MOB)
     MOVE 60 TO EN-AIR-LOST(WS-MOB)
*>   A UUID with high bytes: the first and the fifth byte 0xFF, so two of the ints are negative.
     MOVE FUNCTION CHAR(256) TO EN-UUID(WS-MOB)(1:1)
     MOVE FUNCTION CHAR(256) TO EN-UUID(WS-MOB)(5:1)
     MOVE EN-UUID(WS-MOB) TO WS-UUID
     CALL "PB-RESET" USING PB-BUFFER
     CALL "ENTITY-NBT-WRITE" USING WS-DIM WS-CX WS-CZ PB-BUFFER
     MOVE 0 TO PB-POS
     CALL "NBT-READ-ROOT" USING PB-BUFFER WS-FRAMING WS-ROOT-TYPE
     MOVE PB-POS TO WS-ROOT
     MOVE "T" TO TL-MODE
     MOVE "Entities" TO WS-PATH
     CALL "TEST-NBT-GET" USING PB-BUFFER WS-ROOT WS-PATH WS-TEXT
     MOVE "acceptance US15 45-1§5 the base keys follow Rotation in the table order, the six always-written ones at their values" TO TL-CASE
     MOVE "[{id:cobolcraft:sodgrazer,Pos:[20.500,55.000,37.250],Motion:[0.000,0.000,0.000],Rotation:[90.000,0.000],fall_distance:0.000,Fire:40,Air:240,OnGround:1,Invulnerable:0,PortalCooldown:0,UUID:I[" TO TL-EXPECTED
     MOVE WS-TEXT(1:FUNCTION LENGTH(FUNCTION TRIM(TL-EXPECTED))) TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   Reading it back restores on-ground, fire, air lost and the UUID.
     MOVE EN-ID(WS-MOB) TO WS-ROW
     CALL "ENTITY-REMOVE" USING WS-MOB
     MOVE 0 TO PB-POS
     CALL "ENTITY-NBT-READ" USING WS-DIM PB-BUFFER WS-OUTCOME
     MOVE 0 TO WS-MOB
     PERFORM VARYING WS-ROW FROM 1 BY 1 UNTIL WS-ROW > EN-COUNT
         IF EN-USED(WS-ROW) = 1 AND EN-PLAYER(WS-ROW) = 0 AND EN-TYPE(WS-ROW) = WS-TYPE
             MOVE WS-ROW TO WS-MOB
         END-IF
     END-PERFORM
     MOVE "N" TO TL-MODE
     MOVE "acceptance US15 45-1§5 read back: on ground 1, burning 40, air lost 60" TO TL-CASE
     MOVE 1400060 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = EN-ON-GROUND(WS-MOB) * 1000000 + EN-BURN(WS-MOB) * 10000 + EN-AIR-LOST(WS-MOB)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "T" TO TL-MODE
     MOVE "acceptance US15 45-1§5 read back: the saved UUID" TO TL-CASE
     MOVE FUNCTION HEX-OF(WS-UUID) TO TL-EXPECTED
     MOVE FUNCTION HEX-OF(EN-UUID(WS-MOB)) TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   The conditional keys (45-1 section 5): set every one of them, save, read the text and load it back.
     MOVE 1 TO EN-INVULN(WS-MOB) EN-SILENT(WS-MOB) EN-NOGRAV(WS-MOB) EN-GLOW(WS-MOB)
     MOVE 1 TO EN-VISFIRE(WS-MOB) EN-NAME-VIS(WS-MOB)
     MOVE 40 TO EN-PORTAL-CD(WS-MOB)
     MOVE 10 TO EN-INVTIME(WS-MOB)
     MOVE 30 TO EN-FROZEN(WS-MOB)
     MOVE 2.5 TO EN-FALL(WS-MOB)
     CALL "PB-RESET" USING PB-BUFFER
     CALL "ENTITY-NBT-WRITE" USING WS-DIM WS-CX WS-CZ PB-BUFFER
     MOVE 0 TO PB-POS
     CALL "NBT-READ-ROOT" USING PB-BUFFER WS-FRAMING WS-ROOT-TYPE
     MOVE PB-POS TO WS-ROOT
     MOVE "T" TO TL-MODE
     MOVE "Entities" TO WS-PATH
     CALL "TEST-NBT-GET" USING PB-BUFFER WS-ROOT WS-PATH WS-TEXT
     UNSTRING WS-TEXT DELIMITED BY "UUID:I[" INTO WS-HEAD WS-TAIL
     MOVE SPACES TO TL-EXPECTED
     STRING "[{id:cobolcraft:sodgrazer,Pos:[20.500,55.000,37.250],Motion:[0.000,0.000,0.000],Rotation:[90.000,0.000],"
         "fall_distance:2.500,Fire:40,Air:240,OnGround:1,Invulnerable:1,PortalCooldown:40,invulnerable_time:10,"
         DELIMITED BY SIZE INTO TL-EXPECTED
     MOVE "acceptance US15 45-1§5 the conditional keys follow PortalCooldown (invulnerable_time before UUID)" TO TL-CASE
     MOVE WS-HEAD TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     UNSTRING WS-TAIL DELIMITED BY "]," INTO WS-TAIL-A WS-TAIL-B
     MOVE "acceptance US15 45-1§5 after the UUID: CustomNameVisible, Silent, NoGravity, Glowing, TicksFrozen, HasVisualFire in the table order" TO TL-CASE
     MOVE "CustomNameVisible:1,Silent:1,NoGravity:1,Glowing:1,TicksFrozen:30,HasVisualFire:1" TO TL-EXPECTED
     MOVE WS-TAIL-B(1:FUNCTION LENGTH(FUNCTION TRIM(TL-EXPECTED))) TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 0 TO PB-POS
     CALL "ENTITY-REMOVE" USING WS-MOB
     CALL "ENTITY-NBT-READ" USING WS-DIM PB-BUFFER WS-OUTCOME
     PERFORM FIND-MOB
     MOVE "N" TO TL-MODE
     MOVE "acceptance US15 45-1§5 read back: Invulnerable, PortalCooldown, invulnerable_time, TicksFrozen" TO TL-CASE
     MOVE 1400100030 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = EN-INVULN(WS-MOB) * 1000000000 + EN-PORTAL-CD(WS-MOB) * 10000000
         + EN-INVTIME(WS-MOB) * 10000 + EN-FROZEN(WS-MOB)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US15 45-1§5 read back: Silent, NoGravity, Glowing, HasVisualFire, CustomNameVisible" TO TL-CASE
     MOVE 11111 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = EN-SILENT(WS-MOB) * 10000 + EN-NOGRAV(WS-MOB) * 1000 + EN-GLOW(WS-MOB) * 100
         + EN-VISFIRE(WS-MOB) * 10 + EN-NAME-VIS(WS-MOB)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US15 45-1§5 read back: fall_distance 2.5 (in thousandths)" TO TL-CASE
     MOVE 2500 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = EN-FALL(WS-MOB) * 1000
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   Validation on load (45-1 sections 5 and 6, worked cases of 14.3).
     MOVE 90000000 TO WS-PX
     MOVE 0 TO WS-PY WS-PZ
     MOVE 0 TO WS-MX
     MOVE 25 TO WS-MY
     MOVE 3 TO WS-MZ
     PERFORM BUILD-ONE
     CALL "ENTITY-REMOVE" USING WS-MOB
     MOVE 0 TO PB-POS
     CALL "ENTITY-NBT-READ" USING WS-DIM PB-BUFFER WS-OUTCOME
     PERFORM FIND-MOB
     MOVE "acceptance US15 45-1§5 Pos x 9e7 clamps to 30000512" TO TL-CASE
     MOVE 30000512 TO TL-EXPECTED-N
     MOVE EN-X(WS-MOB) TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US15 45-1§5 Motion (0, 25, 3) loads as (0, 0, 3)" TO TL-CASE
     MOVE 3 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = EN-VX(WS-MOB) + EN-VY(WS-MOB) + EN-VZ(WS-MOB)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     COMPUTE TL-OBSERVED-N = EN-VY(WS-MOB)
     MOVE 0 TO TL-EXPECTED-N
     MOVE "acceptance US15 45-1§5 the over-limit Motion component alone is zeroed (y)" TO TL-CASE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   +Infinity and -Infinity clamp, y is held to 20000000.
     MOVE LOW-VALUES TO WS-PX-B
     MOVE FUNCTION CHAR(241) TO WS-PX-B(7:1)
     MOVE X"7F" TO WS-PX-B(8:1)
     MOVE WS-PX-B TO WS-PY-B
     MOVE FUNCTION CHAR(256) TO WS-PY-B(8:1)
     MOVE 5 TO WS-PZ
     MOVE 0 TO WS-MY
     MOVE 0 TO WS-MZ
     PERFORM BUILD-ONE
     CALL "ENTITY-REMOVE" USING WS-MOB
     MOVE 0 TO PB-POS
     CALL "ENTITY-NBT-READ" USING WS-DIM PB-BUFFER WS-OUTCOME
     PERFORM FIND-MOB
     MOVE "acceptance US15 45-1§5 Pos [+Infinity, -Infinity, 5] loads at (30000512, -20000000, 5)" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     IF EN-X(WS-MOB) = 30000512 AND EN-Y(WS-MOB) = -20000000 AND EN-Z(WS-MOB) = 5
         MOVE 1 TO TL-OBSERVED-N
     ELSE
         MOVE 0 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   A NaN position component skips the entity (14.3); so does an infinite yaw.
     MOVE LOW-VALUES TO WS-PX-B
     MOVE FUNCTION CHAR(249) TO WS-PX-B(7:1)
     MOVE X"7F" TO WS-PX-B(8:1)
     MOVE 0 TO WS-PY
     MOVE 0 TO WS-PZ
     PERFORM BUILD-ONE
     CALL "ENTITY-REMOVE" USING WS-MOB
     MOVE 0 TO PB-POS
     CALL "ENTITY-NBT-READ" USING WS-DIM PB-BUFFER WS-OUTCOME
     PERFORM FIND-MOB
     MOVE "acceptance US15 45-1§5 a NaN Pos component skips the entity (none of the type is loaded)" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-MOB TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 1 TO WS-BAD-YAW
     MOVE LOW-VALUES TO WS-INF-B
     MOVE FUNCTION CHAR(129) TO WS-INF-B(3:1)
     MOVE X"7F" TO WS-INF-B(4:1)
     MOVE 0 TO WS-PX
     PERFORM BUILD-ONE
     MOVE 0 TO WS-BAD-YAW
     MOVE 0 TO PB-POS
     CALL "ENTITY-NBT-READ" USING WS-DIM PB-BUFFER WS-OUTCOME
     PERFORM FIND-MOB
     MOVE "acceptance US15 45-1§5 an infinite Rotation yaw skips the entity" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-MOB TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.
 FIND-MOB.
     MOVE 0 TO WS-MOB
     PERFORM VARYING WS-ROW FROM 1 BY 1 UNTIL WS-ROW > EN-COUNT
         IF EN-USED(WS-ROW) = 1 AND EN-PLAYER(WS-ROW) = 0 AND EN-TYPE(WS-ROW) = WS-TYPE
             MOVE WS-ROW TO WS-MOB
         END-IF
     END-PERFORM.
*> One entity compound by hand: Pos (WS-PX..PZ, the bytes forms when WS-PX-BYTES is used), Motion, Rotation, UUID.
 BUILD-ONE.
     CALL "PB-RESET" USING PB-BUFFER
     MOVE SPACES TO WS-NAME-Z
     MOVE 0 TO WS-NAME-LEN
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WS-NAME-Z WS-NAME-LEN
     MOVE "Entities" TO WS-NAME-Z
     MOVE 8 TO WS-NAME-LEN
     CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WS-NAME-Z WS-NAME-LEN WS-T-COMPOUND WS-ONE
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WS-NAME-Z WS-MINUS-ONE
     MOVE "id" TO WS-NAME-Z MOVE 2 TO WS-NAME-LEN
     MOVE "cobolcraft:sodgrazer" TO WS-ID
     MOVE 20 TO WS-ID-LEN
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WS-NAME-Z WS-NAME-LEN WS-ID WS-ID-LEN
     MOVE "Pos" TO WS-NAME-Z MOVE 3 TO WS-NAME-LEN
     CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WS-NAME-Z WS-NAME-LEN WS-T-DOUBLE WS-THREE
     CALL "NBT-WRITE-DOUBLE" USING PB-BUFFER WS-NAME-Z WS-MINUS-ONE WS-PX
     CALL "NBT-WRITE-DOUBLE" USING PB-BUFFER WS-NAME-Z WS-MINUS-ONE WS-PY
     CALL "NBT-WRITE-DOUBLE" USING PB-BUFFER WS-NAME-Z WS-MINUS-ONE WS-PZ
     MOVE "Motion" TO WS-NAME-Z MOVE 6 TO WS-NAME-LEN
     CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WS-NAME-Z WS-NAME-LEN WS-T-DOUBLE WS-THREE
     CALL "NBT-WRITE-DOUBLE" USING PB-BUFFER WS-NAME-Z WS-MINUS-ONE WS-MX
     CALL "NBT-WRITE-DOUBLE" USING PB-BUFFER WS-NAME-Z WS-MINUS-ONE WS-MY
     CALL "NBT-WRITE-DOUBLE" USING PB-BUFFER WS-NAME-Z WS-MINUS-ONE WS-MZ
     MOVE "Rotation" TO WS-NAME-Z MOVE 8 TO WS-NAME-LEN
     CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WS-NAME-Z WS-NAME-LEN WS-T-FLOAT WS-TWO
     IF WS-BAD-YAW = 1
         CALL "NBT-WRITE-FLOAT" USING PB-BUFFER WS-NAME-Z WS-MINUS-ONE WS-INF-F
     ELSE
         CALL "NBT-WRITE-FLOAT" USING PB-BUFFER WS-NAME-Z WS-MINUS-ONE WS-ZERO-F
     END-IF
     CALL "NBT-WRITE-FLOAT" USING PB-BUFFER WS-NAME-Z WS-MINUS-ONE WS-ZERO-F
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "NBT-WRITE-LIST-END" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER.
 END PROGRAM TEST-ENTITY-NBT-1.
 COPY CORETEST.
