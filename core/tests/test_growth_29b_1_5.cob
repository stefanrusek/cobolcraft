     MOVE WS-I9 TO WS-OR(1)
     MOVE WS-I10 TO WS-OR(2)
     MOVE WS-I11 TO WS-OR(3)
     MOVE WS-I12 TO WS-OR(4)
     CALL "GB-BUSH-SPREAD" USING WS-ISG WS-ORD WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 1 1 1 1 1 1 4 3 2 1" TO WS-IN
     PERFORM LOAD-IN
     MOVE WS-I9 TO WS-OR(1)
     MOVE WS-I10 TO WS-OR(2)
     MOVE WS-I11 TO WS-OR(3)
     MOVE WS-I12 TO WS-OR(4)
     CALL "GB-BUSH-SPREAD" USING WS-ISG WS-ORD WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 1 0 0 1 0 1 1 2 3 4" TO WS-IN
     PERFORM LOAD-IN
     MOVE WS-I9 TO WS-OR(1)
     MOVE WS-I10 TO WS-OR(2)
     MOVE WS-I11 TO WS-OR(3)
     MOVE WS-I12 TO WS-OR(4)
