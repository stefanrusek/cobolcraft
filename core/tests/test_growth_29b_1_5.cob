     MOVE "1/1 0/0 1/3 1/2 0/0 1/4 0/0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29b-1§5 The bone meal framework: bee growth goal (5.5): false at 10 or more crops or when nextFloat < 0.3, else true with nectar and a hive; the goal ticks on a nextInt(30) draw" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0 0.5 1 1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GB-BEE-GATE" USING WS-I1 WS-FX2 WS-I3 WS-I4 WS-I5 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "9 0.5 1 1 5" TO WS-IN
     PERFORM LOAD-IN
