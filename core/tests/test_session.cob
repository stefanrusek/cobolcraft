*> Implementation test of the connection table (core/src/session.cob; core-host-api §3): allocation,
*> a full table, id reuse only after CORE-CONN-CLOSED or a close-flag hand-back, and calls with ids
*> that are not open.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-SESSION.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY COREAPI.
 COPY CORESTATE.
 COPY PROTO.
 COPY TESTLIB.
 01 WS-KIND                BINARY-LONG.
 01 WS-ID                  BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-LAST                BINARY-LONG.
 01 WS-CLOSE               BINARY-LONG.
 01 WS-AREA                PIC X(64).
 01 WS-N                   BINARY-LONG.
 PROCEDURE DIVISION.
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     MOVE CORE-CONN-MEMORY TO WS-KIND
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 64
         CALL "CORE-CONN-OPEN" USING WS-KIND WS-ID
         MOVE WS-ID TO WS-LAST
     END-PERFORM
     MOVE "N" TO TL-MODE
     MOVE "test session 64 connections take ids 1 to 64" TO TL-CASE
     MOVE 64 TO TL-EXPECTED-N
     MOVE WS-LAST TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "CORE-CONN-OPEN" USING WS-KIND WS-ID
     MOVE "test session a 65th connection gets id 0 (table full)" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-ID TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE 10 TO WS-N
     CALL "CORE-CONN-CLOSED" USING WS-N
     CALL "CORE-CONN-OPEN" USING WS-KIND WS-ID
     MOVE "test session the id of a closed connection is reused" TO TL-CASE
     MOVE 10 TO TL-EXPECTED-N
     MOVE WS-ID TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE 20 TO WS-N
     CALL "CORE-DISCONNECT" USING WS-N
     CALL "CORE-CONN-OPEN" USING WS-KIND WS-ID
     MOVE "test session a raised close flag alone does not free the id" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-ID TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     SET CB-ADDR TO ADDRESS OF WS-AREA
     MOVE 64 TO CB-CAPACITY
     MOVE 20 TO WS-N
     CALL "CORE-CONN-OUTPUT" USING WS-N CORE-BUFFER WS-CLOSE
     CALL "CORE-CONN-OPEN" USING WS-KIND WS-ID
     MOVE "test session the close-flag hand-back frees the id for reuse" TO TL-CASE
     MOVE 120 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-CLOSE * 100 + WS-ID
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE 1 TO CB-LENGTH
     MOVE 0 TO WS-N
     CALL "CORE-CONN-OUTPUT" USING WS-N CORE-BUFFER WS-CLOSE
     MOVE 65 TO WS-N
     CALL "CORE-CONN-INPUT" USING WS-N CORE-BUFFER
     MOVE -1 TO WS-N
     CALL "CORE-CONN-CLOSED" USING WS-N
     MOVE "test session ids outside 1 to 64 are ignored" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = CB-LENGTH * 10 + WS-CLOSE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE 30 TO WS-N
     CALL "CORE-CONN-CLOSED" USING WS-N
     MOVE 1 TO CB-LENGTH
     MOVE 30 TO WS-N
     CALL "CORE-CONN-OUTPUT" USING WS-N CORE-BUFFER WS-CLOSE
     MOVE 30 TO WS-N
     CALL "CORE-CONN-CLOSED" USING WS-N
     MOVE "test session calls on an id that is not open do nothing" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = CB-LENGTH * 100 + WS-CLOSE * 10 + CN-USED(30)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     CALL "CORE-CONN-OPEN" USING WS-KIND WS-ID
     MOVE "test session reopening the world empties the connection table" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE WS-ID TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.
 END PROGRAM TEST-SESSION.

 COPY CORETEST.
