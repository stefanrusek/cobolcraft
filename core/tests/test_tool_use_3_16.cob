*> Test of special use 3.16 (17 section 3.16; core/src/tools-use.cob): the loot conditions that read the tool.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-TOOL-USE-3-16.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 01 WS-I1 BINARY-LONG.
 01 WS-I2 BINARY-LONG.
 01 WS-I3 BINARY-LONG.
 01 WS-I4 BINARY-LONG.
 01 WS-I5 BINARY-LONG.
 01 WS-I6 BINARY-LONG.
 01 WS-I7 BINARY-LONG.
 01 WS-I8 BINARY-LONG.
 01 WS-T1 PIC X(48).
 01 WS-T2 PIC X(48).
 01 WS-T3 PIC X(48).
 01 WS-O1 BINARY-LONG.
 01 WS-O2 BINARY-LONG.
 01 WS-O3 BINARY-LONG.
 01 WS-O4 BINARY-LONG.
 01 WS-O5 BINARY-LONG.
 01 WS-O6 BINARY-LONG.
 01 WS-X1 PIC X(48).
 01 WS-X2 PIC X(48).
 01 WS-X3 PIC X(48).
 01 WS-OBS PIC X(240).
 01 WS-E1 PIC -(9)9.
 01 WS-E2 PIC -(9)9.
 01 WS-E3 PIC -(9)9.
 01 WS-E4 PIC -(9)9.
 01 WS-E5 PIC -(9)9.
 01 WS-E6 PIC -(9)9.
 PROCEDURE DIVISION.
     MOVE "acceptance US14 silk touch condition: enchantment level 1 or more; shears or silk touch make leaves drop themselves" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE 0 TO WS-I1
     CALL "TOOL-LOOT-SILK" USING WS-I1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 1 TO WS-I1
     CALL "TOOL-LOOT-SILK" USING WS-I1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 1 TO WS-I1
     MOVE 0 TO WS-I2
     CALL "TOOL-LOOT-LEAVES" USING WS-I1 WS-I2 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 0 TO WS-I1
     MOVE 1 TO WS-I2
     CALL "TOOL-LOOT-LEAVES" USING WS-I1 WS-I2 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 0 TO WS-I1
     MOVE 0 TO WS-I2
     CALL "TOOL-LOOT-LEAVES" USING WS-I1 WS-I2 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "0 1 1 1 0" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 cobweb drops string with a sword or shears, itself with silk touch, nothing otherwise" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE SPACES TO WS-T1
     MOVE "sword" TO WS-T1
     MOVE 0 TO WS-I1
     CALL "TOOL-LOOT-COBWEB" USING WS-T1 WS-I1 WS-X1
     MOVE SPACES TO WS-OBS
     STRING FUNCTION TRIM(WS-X1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "shears" TO WS-T1
     MOVE 0 TO WS-I1
     CALL "TOOL-LOOT-COBWEB" USING WS-T1 WS-I1 WS-X1
     MOVE SPACES TO WS-OBS
     STRING FUNCTION TRIM(WS-X1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "pickaxe" TO WS-T1
     MOVE 1 TO WS-I1
     CALL "TOOL-LOOT-COBWEB" USING WS-T1 WS-I1 WS-X1
     MOVE SPACES TO WS-OBS
     STRING FUNCTION TRIM(WS-X1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "pickaxe" TO WS-T1
     MOVE 0 TO WS-I1
     CALL "TOOL-LOOT-COBWEB" USING WS-T1 WS-I1 WS-X1
     MOVE SPACES TO WS-OBS
     STRING FUNCTION TRIM(WS-X1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "string string cobweb -" TO TL-EXPECTED
     PERFORM CHECK-DONE

     STOP RUN.

 ADD-OBS.
     IF TL-OBSERVED = SPACES
         MOVE FUNCTION TRIM(WS-OBS) TO TL-OBSERVED
     ELSE
         STRING FUNCTION TRIM(TL-OBSERVED) " " FUNCTION TRIM(WS-OBS) DELIMITED BY SIZE INTO TL-OBSERVED
     END-IF.

 CHECK-DONE.
     MOVE "T" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-TOOL-USE-3-16.
