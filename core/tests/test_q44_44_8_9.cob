*> Acceptance test of docs/protocol/44-residual-mob-questions-8-vehicles-and-projectiles.md sections 6.4, 6.5, 9 and 10.3 (lane 002-lane-p49j-b, T24200 range): the velocity series of a
*> default fireball (V14, 12.6: 0.19, 0.2755, 0.356725, position 0.822 after 3 ticks), the water inertia 0.8 of a fireball (limit 0.4) and the water drag 0.8 of a snowball
*> (6.4, 6.5), and the llama spit that is discarded in water (10.3).
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-Q44-44-8-9.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 01 WS-CASE                PIC X(160).
 01 WS-EXP                 BINARY-LONG.
 01 WS-OBS                 BINARY-LONG.
 01 WS-PLAYER              BINARY-LONG.
 01 WS-DIM                 BINARY-LONG.
 01 WS-KEY                 PIC X(112).
 01 WS-ROW                 BINARY-LONG.
 01 WS-KIND                BINARY-LONG.
 01 WS-POWER               BINARY-LONG VALUE 1.
 01 WS-OWNER               BINARY-LONG VALUE 0.
 01 WS-X                   FLOAT-LONG.
 01 WS-Y                   FLOAT-LONG.
 01 WS-Z                   FLOAT-LONG.
 01 WS-X0                  FLOAT-LONG.
 01 WS-DX                  FLOAT-LONG.
 01 WS-DY                  FLOAT-LONG.
 01 WS-DZ                  FLOAT-LONG.
 01 WS-SIZE                BINARY-LONG VALUE 40.
 01 WS-FX                  BINARY-LONG.
 01 WS-FZ                  BINARY-LONG.
 01 WS-FY                  BINARY-LONG.
 01 WS-FKIND               BINARY-LONG VALUE 1.
 01 WS-WATER               BINARY-LONG.
 01 WS-AIR                 BINARY-LONG VALUE 0.
 01 WS-BX                  BINARY-LONG.
 01 WS-BY                  BINARY-LONG.
 01 WS-BZ                  BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 PROCEDURE DIVISION.
     CALL "MS-TEST-OPEN" USING WS-PLAYER
     MOVE PL-DIM(WS-PLAYER) TO WS-DIM
     COMPUTE WS-FX = FUNCTION INTEGER(PL-X(WS-PLAYER)) - 20
     COMPUTE WS-FZ = FUNCTION INTEGER(PL-Z(WS-PLAYER)) - 20
     COMPUTE WS-FY = FUNCTION INTEGER(PL-Y(WS-PLAYER)) - 1
     CALL "MS-TEST-FLOOR" USING WS-DIM WS-FX WS-FZ WS-SIZE WS-FY WS-FKIND
     MOVE "minecraft:water" TO WS-KEY
     CALL "MS-TEST-STATE" USING WS-KEY WS-WATER
     COMPUTE WS-BX = FUNCTION INTEGER(PL-X(WS-PLAYER)) + 4
     COMPUTE WS-BY = WS-FY + 6
     COMPUTE WS-BZ = FUNCTION INTEGER(PL-Z(WS-PLAYER)) + 4
     COMPUTE WS-X0 = WS-BX + 0.2
     COMPUTE WS-Y = WS-BY + 0.5
     COMPUTE WS-Z = WS-BZ + 0.5
     MOVE 1 TO WS-DX
     MOVE 0 TO WS-DY WS-DZ

*>   V14 / 12.6 in air.
     MOVE 1 TO WS-KIND
     CALL "PROJ-SPAWN" USING WS-KIND WS-DIM WS-X0 WS-Y WS-Z WS-DX WS-DY WS-DZ WS-POWER WS-OWNER WS-ROW
     CALL "PROJ-STEP" USING WS-ROW
     MOVE "acceptance US15 44-8§9 V14 tick 1: 0.19 (millionths)" TO WS-CASE
     MOVE 190000 TO WS-EXP
     COMPUTE WS-OBS = FUNCTION INTEGER(EN-VX(WS-ROW) * 1000000 + 0.5)
     CALL "TEST-CHK" USING WS-CASE WS-EXP WS-OBS
     CALL "PROJ-STEP" USING WS-ROW
     MOVE "acceptance US15 44-8§9 V14 tick 2: 0.2755 (millionths)" TO WS-CASE
     MOVE 275500 TO WS-EXP
     COMPUTE WS-OBS = FUNCTION INTEGER(EN-VX(WS-ROW) * 1000000 + 0.5)
     CALL "TEST-CHK" USING WS-CASE WS-EXP WS-OBS
     CALL "PROJ-STEP" USING WS-ROW
     MOVE "acceptance US15 44-8§9 V14 tick 3: 0.356725 (millionths)" TO WS-CASE
     MOVE 356725 TO WS-EXP
     COMPUTE WS-OBS = FUNCTION INTEGER(EN-VX(WS-ROW) * 1000000 + 0.5)
     CALL "TEST-CHK" USING WS-CASE WS-EXP WS-OBS
     MOVE "acceptance US15 44-8§12.6 the position after tick 3 is 0.19 + 0.2755 + 0.356725 = 0.822225 along (millionths)" TO WS-CASE
     MOVE 822225 TO WS-EXP
     COMPUTE WS-OBS = FUNCTION INTEGER((EN-X(WS-ROW) - WS-X0) * 1000000 + 0.5)
     CALL "TEST-CHK" USING WS-CASE WS-EXP WS-OBS
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 3
         CALL "PROJ-STEP" USING WS-ROW
         IF EN-USED(WS-ROW) = 1 AND EN-X(WS-ROW) > WS-X0 + 10
             MOVE 0 TO WS-I
         END-IF
     END-PERFORM
     CALL "ENTITY-REMOVE" USING WS-ROW

*>   In water the inertia is 0.8: (0.1 + 0.1) x 0.8 = 0.16, then (0.16 + 0.1) x 0.8 = 0.208; the limit is 0.4.
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-BX WS-BY WS-BZ WS-WATER
     CALL "PROJ-SPAWN" USING WS-KIND WS-DIM WS-X0 WS-Y WS-Z WS-DX WS-DY WS-DZ WS-POWER WS-OWNER WS-ROW
     CALL "PROJ-STEP" USING WS-ROW
     MOVE "acceptance US15 44-8§6.4 12.6 water tick 1: 0.16 (millionths)" TO WS-CASE
     MOVE 160000 TO WS-EXP
     COMPUTE WS-OBS = FUNCTION INTEGER(EN-VX(WS-ROW) * 1000000 + 0.5)
     CALL "TEST-CHK" USING WS-CASE WS-EXP WS-OBS
     CALL "PROJ-STEP" USING WS-ROW
     MOVE "acceptance US15 44-8§6.4 water tick 2: 0.208 (millionths)" TO WS-CASE
     MOVE 208000 TO WS-EXP
     COMPUTE WS-OBS = FUNCTION INTEGER(EN-VX(WS-ROW) * 1000000 + 0.5)
     CALL "TEST-CHK" USING WS-CASE WS-EXP WS-OBS
     CALL "ENTITY-REMOVE" USING WS-ROW

*>   A snowball (speed 1.6): air drag 0.99 and gravity 0.03; in water 0.8.
     MOVE 3 TO WS-KIND
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-BX WS-BY WS-BZ WS-AIR
     CALL "PROJ-SPAWN" USING WS-KIND WS-DIM WS-X0 WS-Y WS-Z WS-DX WS-DY WS-DZ WS-POWER WS-OWNER WS-ROW
     CALL "PROJ-STEP" USING WS-ROW
     MOVE "acceptance US15 44-8§6.5 snowball in air: vx 1.6 x 0.99 = 1.584 (thousandths)" TO WS-CASE
     MOVE 1584 TO WS-EXP
     COMPUTE WS-OBS = FUNCTION INTEGER(EN-VX(WS-ROW) * 1000 + 0.5)
     CALL "TEST-CHK" USING WS-CASE WS-EXP WS-OBS
     MOVE "acceptance US15 44-8§6.5 snowball in air: vy (0 - 0.03) x 0.99 = -0.0297 (ten-thousandths)" TO WS-CASE
     MOVE -297 TO WS-EXP
     COMPUTE WS-OBS ROUNDED = EN-VY(WS-ROW) * 10000
     CALL "TEST-CHK" USING WS-CASE WS-EXP WS-OBS
     CALL "ENTITY-REMOVE" USING WS-ROW
     COMPUTE WS-X0 = WS-BX + 0.1
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-BX WS-BY WS-BZ WS-WATER
     CALL "PROJ-SPAWN" USING WS-KIND WS-DIM WS-X0 WS-Y WS-Z WS-DX WS-DY WS-DZ WS-POWER WS-OWNER WS-ROW
     CALL "PROJ-STEP" USING WS-ROW
     MOVE "acceptance US15 44-8§6.5 snowball in water: vx 1.6 x 0.8 = 1.28 (thousandths)" TO WS-CASE
     MOVE 1280 TO WS-EXP
     COMPUTE WS-OBS = FUNCTION INTEGER(EN-VX(WS-ROW) * 1000 + 0.5)
     CALL "TEST-CHK" USING WS-CASE WS-EXP WS-OBS
     MOVE "acceptance US15 44-8§6.5 snowball in water: vy -0.03 x 0.8 = -0.024 (thousandths)" TO WS-CASE
     MOVE -24 TO WS-EXP
     COMPUTE WS-OBS ROUNDED = EN-VY(WS-ROW) * 1000
     CALL "TEST-CHK" USING WS-CASE WS-EXP WS-OBS
     CALL "ENTITY-REMOVE" USING WS-ROW

*>   10.3 a llama spit in water is discarded, in air it flies on.
     MOVE 5 TO WS-KIND
     CALL "PROJ-SPAWN" USING WS-KIND WS-DIM WS-X0 WS-Y WS-Z WS-DX WS-DY WS-DZ WS-POWER WS-OWNER WS-ROW
     CALL "PROJ-STEP" USING WS-ROW
     MOVE "acceptance US15 44-8§10.3 a llama spit in water is discarded" TO WS-CASE
     MOVE 0 TO WS-EXP
     MOVE EN-USED(WS-ROW) TO WS-OBS
     CALL "TEST-CHK" USING WS-CASE WS-EXP WS-OBS
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-BX WS-BY WS-BZ WS-AIR
     CALL "PROJ-SPAWN" USING WS-KIND WS-DIM WS-X0 WS-Y WS-Z WS-DX WS-DY WS-DZ WS-POWER WS-OWNER WS-ROW
     CALL "PROJ-STEP" USING WS-ROW
     MOVE "acceptance US15 44-8§10.3 a llama spit in air flies on" TO WS-CASE
     MOVE 1 TO WS-EXP
     MOVE EN-USED(WS-ROW) TO WS-OBS
     CALL "TEST-CHK" USING WS-CASE WS-EXP WS-OBS
     STOP RUN.
 END PROGRAM TEST-Q44-44-8-9.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-CHK.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 LINKAGE SECTION.
 01 L-CASE                 PIC X(160).
 01 L-EXPECTED             BINARY-LONG.
 01 L-OBSERVED             BINARY-LONG.
 PROCEDURE DIVISION USING L-CASE L-EXPECTED L-OBSERVED.
     MOVE "N" TO TL-MODE
     MOVE L-CASE TO TL-CASE
     MOVE L-EXPECTED TO TL-EXPECTED-N
     MOVE L-OBSERVED TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     GOBACK.
 END PROGRAM TEST-CHK.
 COPY CORETEST.
 COPY MOBSPTEST.
