*> Test of 31-2 section 6 (Dispenser and dropper; T0877): the data of the dispenser and dropper entities (size 9, names, saved keys) and insertItem. The triggering, dispenseFrom, the dispense behaviours and getRandomSlot (6.2 first method, 6.3 to 6.6) are Phase 43.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-BE-31-2-6.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY BESTATE.
 COPY PROTO.
 COPY COREAPI.
 COPY CITEMS.
 01 WS-TEXT                PIC X(8192).
 01 WS-OUT                 PIC X(8192).
 01 WS-EDIT                PIC -(9)9.
 01 WS-EDIT2               PIC -(9)9.
 01 WS-EDIT3               PIC -(9)9.
 01 WS-I                   BINARY-LONG.
 01 WS-K                   BINARY-LONG.
 01 WS-LEN                 BINARY-LONG.
 01 WS-IDX                 BINARY-LONG.
 01 WS-PTR                 BINARY-LONG.
 01 WS-CAPACITY            BINARY-LONG VALUE 4096.
 01 WS-TYPE10              BINARY-LONG VALUE 10.
 01 WS-FORM                BINARY-LONG VALUE 2.
 01 WS-D                   BINARY-LONG VALUE 1.
 01 WS-X                   BINARY-LONG VALUE 5.
 01 WS-Y                   BINARY-LONG VALUE 70.
 01 WS-Z                   BINARY-LONG VALUE 5.
 01 WS-T                   BINARY-LONG.
 01 WS-KEY                 PIC X(48).
 01 WS-KEY24               PIC X(24).
 01 WS-KEY32               PIC X(32).
 01 WS-NAME                PIC X(32).
 01 WS-ITEM                BINARY-LONG.
 01 WS-COUNT               BINARY-LONG.
 01 WS-VAR                 BINARY-LONG.
 01 WS-A                   BINARY-LONG.
 01 WS-B                   BINARY-LONG.
 01 WS-C                   BINARY-LONG.
 01 WS-HOPPER              BINARY-LONG.
 01 WS-DISPENSER           BINARY-LONG.
 01 WS-DROPPER             BINARY-LONG.
 01 WS-SRC                BINARY-LONG.
 01 WS-FLAG                BINARY-LONG.
 PROCEDURE DIVISION.
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     MOVE "minecraft:hopper" TO WS-KEY
     MOVE 16 TO WS-LEN
     MOVE 18 TO WS-T
     CALL "BE-CREATE" USING WS-D WS-X WS-Y WS-Z WS-T WS-KEY WS-LEN WS-HOPPER
     ADD 1 TO WS-X
     MOVE "minecraft:dispenser" TO WS-KEY
     MOVE 19 TO WS-LEN
     MOVE 5 TO WS-T
     CALL "BE-CREATE" USING WS-D WS-X WS-Y WS-Z WS-T WS-KEY WS-LEN WS-DISPENSER
     ADD 1 TO WS-X
     MOVE "minecraft:dropper" TO WS-KEY
     MOVE 17 TO WS-LEN
     MOVE 6 TO WS-T
     CALL "BE-CREATE" USING WS-D WS-X WS-Y WS-Z WS-T WS-KEY WS-LEN WS-DROPPER
     MOVE "T" TO TL-MODE
     MOVE "minecraft:chest" TO WS-KEY
     MOVE 15 TO WS-LEN
     MOVE 1 TO WS-T
     CALL "BE-CREATE" USING WS-D WS-X WS-Y WS-Z WS-T WS-KEY WS-LEN WS-SRC
     MOVE "acceptance US12 31-2§6 Dispenser and dropper: container size 9 and the names container.dispenser and container.dropper" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     MOVE 5 TO WS-T
     CALL "BE-CONTAINER-SIZE" USING WS-T WS-A
     CALL "BE-DEFAULT-NAME" USING WS-T WS-KEY32 WS-LEN
     MOVE WS-A TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) " " WS-KEY32(1:WS-LEN) " " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 6 TO WS-T
     CALL "BE-CONTAINER-SIZE" USING WS-T WS-A
     CALL "BE-DEFAULT-NAME" USING WS-T WS-KEY32 WS-LEN
     MOVE WS-A TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) " " WS-KEY32(1:WS-LEN) DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE "9 container.dispenser 9 container.dropper" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 31-2§6 Dispenser and dropper: the saved keys are Items, CustomName and lock (no TransferCooldown), written for the dropper like the dispenser" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     MOVE "Chute" TO BE-NAME(WS-DROPPER)
     MOVE 5 TO BE-NAME-LENGTH(WS-DROPPER)
     MOVE 2 TO BE-SLOT-ITEM(WS-DROPPER, 9)
     MOVE 1 TO BE-SLOT-COUNT(WS-DROPPER, 9)
     MOVE WS-DROPPER TO WS-IDX
     PERFORM SAVE-RENDER
     MOVE SPACES TO WS-KEY
     MOVE IT-KEY(3) TO WS-KEY
     MOVE SPACES TO TL-EXPECTED
     STRING "{CustomName:Chute,Items:[{Slot:8,id:" FUNCTION TRIM(WS-KEY) ",count:1}]} " DELIMITED BY SIZE INTO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 31-2§6 Dispenser and dropper: insertItem tops up the first slot with the same item and components (60 + 10 of 64 leaves 6), the rest goes to the next empty slot, a slot of other components is skipped" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     MOVE 2 TO BE-SLOT-ITEM(WS-DISPENSER, 1)
     MOVE 60 TO BE-SLOT-COUNT(WS-DISPENSER, 1)
     MOVE 0 TO BE-SLOT-VAR(WS-DISPENSER, 1)
     MOVE 2 TO BE-SLOT-ITEM(WS-DISPENSER, 2)
     MOVE 5 TO BE-SLOT-COUNT(WS-DISPENSER, 2)
     MOVE 1 TO BE-SLOT-VAR(WS-DISPENSER, 2)
     MOVE 2 TO WS-ITEM
     MOVE 10 TO WS-COUNT
     MOVE 0 TO WS-VAR
     MOVE 64 TO WS-A
     CALL "BE2-INSERT-ITEM" USING WS-DISPENSER WS-ITEM WS-COUNT WS-VAR WS-A
     MOVE BE-SLOT-COUNT(WS-DISPENSER, 1) TO WS-EDIT
     MOVE BE-SLOT-COUNT(WS-DISPENSER, 2) TO WS-EDIT2
     MOVE BE-SLOT-COUNT(WS-DISPENSER, 3) TO WS-EDIT3
     STRING FUNCTION TRIM(WS-EDIT) " " FUNCTION TRIM(WS-EDIT2) " " FUNCTION TRIM(WS-EDIT3) " left " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE WS-COUNT TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE "64 5 6 left 0" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 31-2§6 Dispenser and dropper: insertItem into a full dispenser returns the whole stack as the remainder" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 9
         MOVE 3 TO BE-SLOT-ITEM(WS-DISPENSER, WS-I)
         MOVE 64 TO BE-SLOT-COUNT(WS-DISPENSER, WS-I)
         MOVE 0 TO BE-SLOT-VAR(WS-DISPENSER, WS-I)
     END-PERFORM
     MOVE 2 TO WS-ITEM
     MOVE 10 TO WS-COUNT
     MOVE 0 TO WS-VAR
     MOVE 64 TO WS-A
     CALL "BE2-INSERT-ITEM" USING WS-DISPENSER WS-ITEM WS-COUNT WS-VAR WS-A
     MOVE WS-COUNT TO WS-EDIT
     STRING "left " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE "left 10" TO TL-EXPECTED
     PERFORM CHECK

     GOBACK.

 CHECK.
     MOVE WS-TEXT TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 ROUNDTRIP.
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     CALL "BE-SAVE" USING WS-SRC WS-FORM PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE 0 TO PB-POS
     CALL "BE-LOAD" USING WS-IDX PB-BUFFER
     CALL "PB-FREE" USING PB-BUFFER.

*> Saves entity WS-IDX in form WS-FORM and appends the rendered compound to WS-TEXT.
 SAVE-RENDER.
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     CALL "BE-SAVE" USING WS-IDX WS-FORM PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE 0 TO PB-POS
     MOVE 0 TO WS-LEN
     MOVE SPACES TO WS-OUT
     CALL "TEST-NBT-RENDER" USING PB-BUFFER WS-TYPE10 WS-OUT WS-LEN
     CALL "PB-FREE" USING PB-BUFFER
     STRING WS-OUT(1:WS-LEN) " " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR.
 END PROGRAM TEST-BE-31-2-6.

 COPY CORETEST.
