 PROCEDURE DIVISION.
     MOVE "T" TO TL-MODE
     MOVE "acceptance US12 40-3§1 Identity and shared facts: M1: anvil type 8 with 3 + 36 = 39 slots and 1 data slot, grindstone 15 with 39 and none, smithing 21 with 4 + 36 = 40 and 1 (type id, own slots," TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-IDENT" USING WS-I1 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "2" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-IDENT" USING WS-I1 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "3" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-IDENT" USING WS-I1 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "8/3/39/1 15/3/39/0 21/4/40/1" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 40-3§1 Identity and shared facts: M1: default title key and English text" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-TITLE" USING WS-I1 WS-T1 WS-T2
     PERFORM ADD-TEXT
     MOVE "2" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-TITLE" USING WS-I1 WS-T1 WS-T2
     PERFORM ADD-TEXT
     MOVE "3" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-TITLE" USING WS-I1 WS-T1 WS-T2
     PERFORM ADD-TEXT
     MOVE "container.repair|Repair & Name container.grindstone_title|Repair & Disenchant container.upgrade|Upgrade Gear" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 40-3§1 Identity and shared facts: M1: bound block (the anvil by block tag) and the interaction statistic" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-BOUND" USING WS-I1 WS-T1 WS-T2
     PERFORM ADD-TEXT
     MOVE "2" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-BOUND" USING WS-I1 WS-T1 WS-T2
     PERFORM ADD-TEXT
     MOVE "3" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-BOUND" USING WS-I1 WS-T1 WS-T2
     PERFORM ADD-TEXT
     MOVE "tag anvil|interact_with_anvil grindstone|interact_with_grindstone smithing_table|interact_with_smithing_table" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 40-3§1 Identity and shared facts: level events (1): 1029 anvil.destroy, 1030 anvil.use, 1031 anvil.land at volume 0.3, 1042 grindstone.use, 1044 smithing_table.use, volume x 100;" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1029" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-LEVEL-EVENT" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1030" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-LEVEL-EVENT" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1031" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-LEVEL-EVENT" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1042" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-LEVEL-EVENT" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1044" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-LEVEL-EVENT" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1000" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-LEVEL-EVENT" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-LEVEL-EVENT" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1/100 2/100 3/30 4/100 5/100 0/0 0/0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 40-3§1 Identity and shared facts: stillValid (1): true with the NULL access; otherwise the block must be the right one and the player within interaction range + 4.0 (null access," TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0 0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-VALID" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-VALID" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-VALID" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-VALID" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-VALID" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-VALID" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-VALID" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-VALID" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 0 1 1 1 1 1" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 BEGIN-CASE.
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR
     .

 LOAD-IN.
     MOVE 1 TO WS-P
     PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 16
         MOVE SPACES TO WS-TOK
         IF WS-P <= 160
             UNSTRING WS-IN DELIMITED BY ALL SPACE INTO WS-TOK WITH POINTER WS-P
         END-IF
         COMPUTE WS-FX(WS-K) = FUNCTION NUMVAL(WS-TOK)
         COMPUTE WS-I(WS-K) = FUNCTION NUMVAL(WS-TOK)
     END-PERFORM
     .

 ADD-N.
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N
         MOVE WS-R(WS-J) TO WS-SHOW
         IF WS-J > 1
             STRING "/" DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
         END-IF
         STRING FUNCTION TRIM(WS-SHOW) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-PERFORM
     STRING " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .

 ADD-TEXT.
     STRING FUNCTION TRIM(WS-T1) "|" FUNCTION TRIM(WS-T2) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .
 END PROGRAM TEST-MENU-40-3-1.
