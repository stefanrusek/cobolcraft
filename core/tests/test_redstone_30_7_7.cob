     CALL "RS3-BULB-ANALOG" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 5" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-BULB-ANALOG" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 3 2" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-BULB-ANALOG" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 3 5" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-BULB-ANALOG" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 2" TO WS-IN
