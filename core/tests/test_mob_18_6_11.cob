*> Acceptance test (US15, FR-036, SC-008; docs/protocol/18-mob-framework.md section 6.11, with doc 44 part 2 section 10): persistence and despawn.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-MOB-18-6-11.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY XORO.
 COPY MOBSPAWN.
 COPY BRWORLD.
 01 WS-CASE               PIC X(240).
 01 WS-E                  BINARY-DOUBLE.
 01 WS-O                  BINARY-DOUBLE.
 01 WS-SEED               BINARY-DOUBLE UNSIGNED.
 01 WS-MIRROR.
    05 WS-M-LO            BINARY-DOUBLE UNSIGNED.
    05 WS-M-HI            BINARY-DOUBLE UNSIGNED.
 01 WS-CAT               BINARY-LONG.
 01 WS-PERSIST           BINARY-LONG.
 01 WS-REMOVABLE         BINARY-LONG.
 01 WS-PEACEFUL          BINARY-LONG.
 01 WS-HAVE              BINARY-LONG.
 01 WS-D2                BINARY-DOUBLE.
 01 WS-IDLE              BINARY-LONG.
 01 WS-DRAW              BINARY-LONG.
 01 WS-RESULT            BINARY-LONG.
 01 WS-PLAYER            BINARY-LONG.
 01 WS-DIM               BINARY-LONG.
 01 WS-KEY               PIC X(112).
 01 WS-TYPE              BINARY-LONG.
 01 WS-ENTITY-ROW        PIC X(66).
 01 WS-STATUS            BINARY-LONG.
 01 WS-X                 FLOAT-LONG.
 01 WS-Y                 FLOAT-LONG.
 01 WS-Z                 FLOAT-LONG.
 01 WS-YAW               FLOAT-SHORT VALUE 0.
 01 WS-ZOMBIE-FAR        BINARY-LONG.
 01 WS-ZOMBIE-NEAR       BINARY-LONG.
 01 WS-ROW               BINARY-LONG.
 01 WS-PIG-FAR           BINARY-LONG.
 PROCEDURE DIVISION.
     MOVE 1 TO WS-CAT
     MOVE 0 TO WS-PERSIST
     MOVE 1 TO WS-REMOVABLE
     MOVE 1 TO WS-PEACEFUL
     MOVE 1 TO WS-HAVE
     MOVE 100 TO WS-D2
     MOVE 0 TO WS-IDLE
     MOVE 5 TO WS-DRAW
     CALL "MS6-DESPAWN" USING WS-CAT WS-PERSIST WS-REMOVABLE WS-PEACEFUL WS-HAVE WS-D2 WS-IDLE WS-DRAW WS-RESULT
     MOVE "acceptance US15 18§6.11 Persistence and despawn: Peaceful discards a hostile mob" TO WS-CASE
     COMPUTE WS-E = 1
     COMPUTE WS-O = WS-RESULT
     PERFORM CHECK-N
     MOVE 1 TO WS-CAT
     MOVE 0 TO WS-PERSIST
     MOVE 1 TO WS-REMOVABLE
     MOVE 0 TO WS-PEACEFUL
     MOVE 0 TO WS-HAVE
     MOVE 999999 TO WS-D2
     MOVE 0 TO WS-IDLE
     MOVE 0 TO WS-DRAW
     CALL "MS6-DESPAWN" USING WS-CAT WS-PERSIST WS-REMOVABLE WS-PEACEFUL WS-HAVE WS-D2 WS-IDLE WS-DRAW WS-RESULT
     MOVE "acceptance US15 18§6.11 Persistence and despawn: no player at any distance: nothing happens" TO WS-CASE
     COMPUTE WS-E = 0
     COMPUTE WS-O = WS-RESULT
     PERFORM CHECK-N
     MOVE 1 TO WS-CAT
     MOVE 0 TO WS-PERSIST
     MOVE 1 TO WS-REMOVABLE
     MOVE 0 TO WS-PEACEFUL
     MOVE 1 TO WS-HAVE
     MOVE 16385 TO WS-D2
     MOVE 0 TO WS-IDLE
     MOVE 5 TO WS-DRAW
     CALL "MS6-DESPAWN" USING WS-CAT WS-PERSIST WS-REMOVABLE WS-PEACEFUL WS-HAVE WS-D2 WS-IDLE WS-DRAW WS-RESULT
     MOVE "acceptance US15 18§6.11 Persistence and despawn: beyond 128 blocks (16385) a monster is removed" TO WS-CASE
     COMPUTE WS-E = 1
     COMPUTE WS-O = WS-RESULT
     PERFORM CHECK-N
     MOVE 1 TO WS-CAT
     MOVE 0 TO WS-PERSIST
     MOVE 1 TO WS-REMOVABLE
     MOVE 0 TO WS-PEACEFUL
     MOVE 1 TO WS-HAVE
     MOVE 16384 TO WS-D2
     MOVE 0 TO WS-IDLE
     MOVE 5 TO WS-DRAW
     CALL "MS6-DESPAWN" USING WS-CAT WS-PERSIST WS-REMOVABLE WS-PEACEFUL WS-HAVE WS-D2 WS-IDLE WS-DRAW WS-RESULT
     MOVE "acceptance US15 18§6.11 Persistence and despawn: exactly 128 blocks (16384) is not beyond" TO WS-CASE
     COMPUTE WS-E = 0
     COMPUTE WS-O = WS-RESULT
     PERFORM CHECK-N
     MOVE 7 TO WS-CAT
     MOVE 0 TO WS-PERSIST
     MOVE 1 TO WS-REMOVABLE
     MOVE 0 TO WS-PEACEFUL
     MOVE 1 TO WS-HAVE
     MOVE 4097 TO WS-D2
     MOVE 0 TO WS-IDLE
     MOVE 5 TO WS-DRAW
     CALL "MS6-DESPAWN" USING WS-CAT WS-PERSIST WS-REMOVABLE WS-PEACEFUL WS-HAVE WS-D2 WS-IDLE WS-DRAW WS-RESULT
     MOVE "acceptance US15 18§6.11 Persistence and despawn: water ambient despawns beyond 64 blocks (4097)" TO WS-CASE
     COMPUTE WS-E = 1
     COMPUTE WS-O = WS-RESULT
     PERFORM CHECK-N
     MOVE 1 TO WS-CAT
     MOVE 0 TO WS-PERSIST
     MOVE 1 TO WS-REMOVABLE
     MOVE 0 TO WS-PEACEFUL
     MOVE 1 TO WS-HAVE
     MOVE 4097 TO WS-D2
     MOVE 0 TO WS-IDLE
     MOVE 5 TO WS-DRAW
     CALL "MS6-DESPAWN" USING WS-CAT WS-PERSIST WS-REMOVABLE WS-PEACEFUL WS-HAVE WS-D2 WS-IDLE WS-DRAW WS-RESULT
     MOVE "acceptance US15 18§6.11 Persistence and despawn: a category with distance 128 keeps a mob at 4097" TO WS-CASE
     COMPUTE WS-E = 0
     COMPUTE WS-O = WS-RESULT
     PERFORM CHECK-N
     MOVE 1 TO WS-CAT
     MOVE 1 TO WS-PERSIST
     MOVE 1 TO WS-REMOVABLE
     MOVE 0 TO WS-PEACEFUL
     MOVE 1 TO WS-HAVE
     MOVE 999999 TO WS-D2
     MOVE 9999 TO WS-IDLE
     MOVE 0 TO WS-DRAW
     CALL "MS6-DESPAWN" USING WS-CAT WS-PERSIST WS-REMOVABLE WS-PEACEFUL WS-HAVE WS-D2 WS-IDLE WS-DRAW WS-RESULT
     MOVE "acceptance US15 18§6.11 Persistence and despawn: a persistent mob is never removed" TO WS-CASE
     COMPUTE WS-E = 0
     COMPUTE WS-O = WS-RESULT
     PERFORM CHECK-N
     MOVE 2 TO WS-CAT
     MOVE 0 TO WS-PERSIST
     MOVE 0 TO WS-REMOVABLE
     MOVE 0 TO WS-PEACEFUL
     MOVE 1 TO WS-HAVE
     MOVE 999999 TO WS-D2
     MOVE 9999 TO WS-IDLE
     MOVE 0 TO WS-DRAW
     CALL "MS6-DESPAWN" USING WS-CAT WS-PERSIST WS-REMOVABLE WS-PEACEFUL WS-HAVE WS-D2 WS-IDLE WS-DRAW WS-RESULT
     MOVE "acceptance US15 18§6.11 Persistence and despawn: removeWhenFarAway false (animals) never despawns" TO WS-CASE
     COMPUTE WS-E = 0
     COMPUTE WS-O = WS-RESULT
     PERFORM CHECK-N
     MOVE 1 TO WS-CAT
     MOVE 0 TO WS-PERSIST
     MOVE 1 TO WS-REMOVABLE
     MOVE 0 TO WS-PEACEFUL
     MOVE 1 TO WS-HAVE
     MOVE 2000 TO WS-D2
     MOVE 601 TO WS-IDLE
     MOVE 0 TO WS-DRAW
     CALL "MS6-DESPAWN" USING WS-CAT WS-PERSIST WS-REMOVABLE WS-PEACEFUL WS-HAVE WS-D2 WS-IDLE WS-DRAW WS-RESULT
     MOVE "acceptance US15 18§6.11 Persistence and despawn: random despawn: noActionTime 601, nextInt(800) = 0, beyond 32 blocks" TO WS-CASE
     COMPUTE WS-E = 1
     COMPUTE WS-O = WS-RESULT
     PERFORM CHECK-N
     MOVE 1 TO WS-CAT
     MOVE 0 TO WS-PERSIST
     MOVE 1 TO WS-REMOVABLE
     MOVE 0 TO WS-PEACEFUL
     MOVE 1 TO WS-HAVE
     MOVE 2000 TO WS-D2
     MOVE 600 TO WS-IDLE
     MOVE 0 TO WS-DRAW
     CALL "MS6-DESPAWN" USING WS-CAT WS-PERSIST WS-REMOVABLE WS-PEACEFUL WS-HAVE WS-D2 WS-IDLE WS-DRAW WS-RESULT
     MOVE "acceptance US15 18§6.11 Persistence and despawn: random despawn needs noActionTime above 600" TO WS-CASE
     COMPUTE WS-E = 0
     COMPUTE WS-O = WS-RESULT
     PERFORM CHECK-N
     MOVE 1 TO WS-CAT
     MOVE 0 TO WS-PERSIST
     MOVE 1 TO WS-REMOVABLE
     MOVE 0 TO WS-PEACEFUL
     MOVE 1 TO WS-HAVE
     MOVE 2000 TO WS-D2
     MOVE 601 TO WS-IDLE
     MOVE 1 TO WS-DRAW
     CALL "MS6-DESPAWN" USING WS-CAT WS-PERSIST WS-REMOVABLE WS-PEACEFUL WS-HAVE WS-D2 WS-IDLE WS-DRAW WS-RESULT
     MOVE "acceptance US15 18§6.11 Persistence and despawn: random despawn needs the draw to be 0" TO WS-CASE
     COMPUTE WS-E = 0
     COMPUTE WS-O = WS-RESULT
     PERFORM CHECK-N
     MOVE 1 TO WS-CAT
     MOVE 0 TO WS-PERSIST
     MOVE 1 TO WS-REMOVABLE
     MOVE 0 TO WS-PEACEFUL
     MOVE 1 TO WS-HAVE
     MOVE 1024 TO WS-D2
     MOVE 601 TO WS-IDLE
     MOVE 0 TO WS-DRAW
     CALL "MS6-DESPAWN" USING WS-CAT WS-PERSIST WS-REMOVABLE WS-PEACEFUL WS-HAVE WS-D2 WS-IDLE WS-DRAW WS-RESULT
     MOVE "acceptance US15 18§6.11 Persistence and despawn: random despawn needs more than 32 blocks (1024)" TO WS-CASE
     COMPUTE WS-E = 0
     COMPUTE WS-O = WS-RESULT
     PERFORM CHECK-N
     MOVE "acceptance US15 18§6.11 Persistence and despawn: random despawn needs more than 32 blocks (1024) (noActionTime)" TO WS-CASE
     COMPUTE WS-E = 601
     COMPUTE WS-O = WS-IDLE
     PERFORM CHECK-N
     MOVE 1 TO WS-CAT
     MOVE 0 TO WS-PERSIST
     MOVE 1 TO WS-REMOVABLE
     MOVE 0 TO WS-PEACEFUL
     MOVE 1 TO WS-HAVE
     MOVE 100 TO WS-D2
     MOVE 500 TO WS-IDLE
     MOVE 3 TO WS-DRAW
     CALL "MS6-DESPAWN" USING WS-CAT WS-PERSIST WS-REMOVABLE WS-PEACEFUL WS-HAVE WS-D2 WS-IDLE WS-DRAW WS-RESULT
     MOVE "acceptance US15 18§6.11 Persistence and despawn: within 32 blocks noActionTime is reset" TO WS-CASE
     COMPUTE WS-E = 0
     COMPUTE WS-O = WS-RESULT
     PERFORM CHECK-N
     MOVE "acceptance US15 18§6.11 Persistence and despawn: within 32 blocks noActionTime is reset (noActionTime)" TO WS-CASE
     COMPUTE WS-E = 0
     COMPUTE WS-O = WS-IDLE
     PERFORM CHECK-N
     MOVE 1 TO WS-CAT
     MOVE 1 TO WS-PERSIST
     MOVE 1 TO WS-REMOVABLE
     MOVE 0 TO WS-PEACEFUL
     MOVE 1 TO WS-HAVE
     MOVE 2000 TO WS-D2
     MOVE 601 TO WS-IDLE
     MOVE 0 TO WS-DRAW
     CALL "MS6-DESPAWN" USING WS-CAT WS-PERSIST WS-REMOVABLE WS-PEACEFUL WS-HAVE WS-D2 WS-IDLE WS-DRAW WS-RESULT
     MOVE "acceptance US15 18§6.11 Persistence and despawn: a persistent mob at 2000 does not despawn at random" TO WS-CASE
     COMPUTE WS-E = 0
     COMPUTE WS-O = WS-RESULT
     PERFORM CHECK-N
     CALL "MS-TEST-OPEN" USING WS-PLAYER
     MOVE PL-DIM(WS-PLAYER) TO WS-DIM
     MOVE SPACES TO WS-KEY
     MOVE "minecraft:zombie" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-TYPE WS-ENTITY-ROW WS-STATUS
     MOVE PL-Y(WS-PLAYER) TO WS-Y
     MOVE PL-Z(WS-PLAYER) TO WS-Z
     COMPUTE WS-X = PL-X(WS-PLAYER) + 200
     CALL "MOB-SPAWN" USING WS-DIM WS-TYPE WS-X WS-Y WS-Z WS-YAW WS-ZOMBIE-FAR
     COMPUTE WS-X = PL-X(WS-PLAYER) + 10
     CALL "MOB-SPAWN" USING WS-DIM WS-TYPE WS-X WS-Y WS-Z WS-YAW WS-ZOMBIE-NEAR
     MOVE "minecraft:pig" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-TYPE WS-ENTITY-ROW WS-STATUS
     COMPUTE WS-X = PL-X(WS-PLAYER) + 200
     CALL "MOB-SPAWN" USING WS-DIM WS-TYPE WS-X WS-Y WS-Z WS-YAW WS-PIG-FAR
     CALL "MS6-DESPAWN-TICK" USING WS-ZOMBIE-NEAR
     CALL "MS6-DESPAWN-TICK" USING WS-PIG-FAR
     MOVE "acceptance US15 18§6.11 Persistence and despawn: a zombie 10 blocks from the player stays" TO WS-CASE
     COMPUTE WS-E = 1
     COMPUTE WS-O = EN-USED(WS-ZOMBIE-NEAR)
     PERFORM CHECK-N
     MOVE "acceptance US15 18§6.11 Persistence and despawn: a pig 200 blocks away stays (animals never despawn by distance)" TO WS-CASE
     COMPUTE WS-E = 1
     COMPUTE WS-O = EN-USED(WS-PIG-FAR)
     PERFORM CHECK-N
     CALL "MS6-DESPAWN-TICK" USING WS-ZOMBIE-FAR
     MOVE "acceptance US15 18§6.11 Persistence and despawn: a zombie 200 blocks from the player is removed on its tick" TO WS-CASE
     COMPUTE WS-E = 0
     COMPUTE WS-O = EN-USED(WS-ZOMBIE-FAR)
     PERFORM CHECK-N
     MOVE 0 TO BW-DIFFICULTY
     CALL "MS6-DESPAWN-TICK" USING WS-ZOMBIE-NEAR
     MOVE "acceptance US15 18§6.11 Persistence and despawn: Peaceful removes a nearby zombie" TO WS-CASE
     COMPUTE WS-E = 0
     COMPUTE WS-O = EN-USED(WS-ZOMBIE-NEAR)
     PERFORM CHECK-N
     CALL "MS6-DESPAWN-TICK" USING WS-PIG-FAR
     MOVE "acceptance US15 44-2§10 a creature stays on Peaceful (allowed in Peaceful)" TO WS-CASE
     COMPUTE WS-E = 1
     COMPUTE WS-O = EN-USED(WS-PIG-FAR)
     PERFORM CHECK-N
     MOVE 2 TO BW-DIFFICULTY
     CALL "MS6-DESPAWN-TICK" USING WS-ZOMBIE-NEAR
     MOVE "acceptance US15 18§6.11 Persistence and despawn: a freed row is ignored" TO WS-CASE
     COMPUTE WS-E = 0
     COMPUTE WS-O = EN-USED(WS-ZOMBIE-NEAR)
     PERFORM CHECK-N

     MOVE PL-ENTITY-ROW(WS-PLAYER) TO WS-ROW
     CALL "MS6-DESPAWN-TICK" USING WS-ROW
     MOVE "acceptance US15 18§6.11 Persistence and despawn: a row that is not a standard mob (the player) is left alone" TO WS-CASE
     MOVE 1 TO WS-E
     MOVE EN-USED(WS-ROW) TO WS-O
     PERFORM CHECK-N
     MOVE "minecraft:zombie" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-TYPE WS-ENTITY-ROW WS-STATUS
     MOVE PL-X(WS-PLAYER) TO WS-X
     CALL "MOB-SPAWN" USING WS-DIM WS-TYPE WS-X WS-Y WS-Z WS-YAW WS-ROW
     MOVE 5 TO EN-HURT(WS-ROW)
     CALL "MS6-DESPAWN-TICK" USING WS-ROW
     MOVE "acceptance US15 18§6.11 Persistence and despawn: a hurt zombie standing at the player stays" TO WS-CASE
     MOVE 1 TO WS-E
     MOVE EN-USED(WS-ROW) TO WS-O
     PERFORM CHECK-N
     STOP RUN.
 CHECK-N.
     MOVE "N" TO TL-MODE
     MOVE WS-CASE TO TL-CASE
     MOVE WS-E TO TL-EXPECTED-N
     MOVE WS-O TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-MOB-18-6-11.
 COPY CORETEST.
 COPY MOBSPTEST.
