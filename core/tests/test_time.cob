*> Implementation test of the time of day (core/src/world.cob WORLD-TIME-TICK through CORE-TICK; tasks
*> T425; US3-6; standin-content §4.8: Time 0..23999, +1 per tick, wrapping to 0; 09 §3.2 Set Time
*> row: sent every 20 ticks).
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-TIME.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY COREAPI.
 COPY PROTO.
 COPY PROTO REPLACING LEADING ==PB-== BY ==PK-==.
 01 WS-CAPACITY            BINARY-LONG VALUE 65536.
 01 WS-NAME                PIC X(16) VALUE "Alice".
 01 WS-NAME-LENGTH         BINARY-LONG VALUE 5.
 01 WS-CONN                BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-CLOSE               BINARY-LONG.
 01 WS-THRESHOLD           BINARY-LONG VALUE -1.
 01 WS-PACKET-ID           BINARY-LONG.
 01 WS-OUTCOME             BINARY-LONG.
 01 WS-COUNT               BINARY-LONG.
 01 WS-LONG                BINARY-DOUBLE.
 01 WS-LAST                BINARY-DOUBLE.
 01 WS-EDIT                PIC -(9)9.
 01 WS-EDIT2               PIC -(9)9.
 01 WS-EDIT3               PIC -(9)9.
 PROCEDURE DIVISION.
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     MOVE 2 TO CS-VIEW-DISTANCE
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     CALL "PB-INIT" USING PK-BUFFER WS-CAPACITY

     MOVE "test time (US3-6): a new world's time of day is 0 and advances by 1 per tick"
         TO TL-CASE
     MOVE CW-TIME TO WS-EDIT
     PERFORM 5 TIMES
         CALL "CORE-TICK"
     END-PERFORM
     MOVE CW-TIME TO WS-EDIT2
     MOVE "T" TO TL-MODE
     MOVE SPACES TO TL-OBSERVED
     STRING FUNCTION TRIM(WS-EDIT) " " FUNCTION TRIM(WS-EDIT2) DELIMITED BY SIZE
         INTO TL-OBSERVED
     MOVE "0 5" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test time (US3-6): the time wraps from 23999 to 0 (day length 24000 ticks)" TO TL-CASE
     MOVE 23998 TO CW-TIME
     CALL "CORE-TICK"
     MOVE CW-TIME TO WS-EDIT
     CALL "CORE-TICK"
     MOVE CW-TIME TO WS-EDIT2
     MOVE SPACES TO TL-OBSERVED
     STRING FUNCTION TRIM(WS-EDIT) " " FUNCTION TRIM(WS-EDIT2) DELIMITED BY SIZE
         INTO TL-OBSERVED
     MOVE "23999 0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test time (US3-6): a player in the world is sent Set Time once a second: 2 in 40 ticks, "
         & "the last carrying the time of day when it was sent" TO TL-CASE
     CALL "TEST-JOIN" USING WS-NAME WS-NAME-LENGTH WS-CONN
     MOVE 0 TO WS-COUNT
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 40
         CALL "CORE-TICK"
         IF FUNCTION MOD(CW-TICKS, 20) = 0
             MOVE CW-TIME TO WS-LAST
         END-IF
     END-PERFORM
     CALL "PB-RESET" USING PB-BUFFER
     CALL "TEST-DRAIN" USING WS-CONN PB-BUFFER WS-CLOSE
     MOVE 0 TO WS-OUTCOME
     MOVE -1 TO WS-LONG
     PERFORM UNTIL WS-OUTCOME NOT = 0
         CALL "PB-RESET" USING PK-BUFFER
         CALL "TEST-NEXT-PACKET" USING PB-BUFFER PK-BUFFER WS-THRESHOLD WS-PACKET-ID WS-OUTCOME
         IF WS-OUTCOME = 0 AND WS-PACKET-ID = 115
             ADD 1 TO WS-COUNT
             CALL "PB-GET-LONG" USING PK-BUFFER WS-LONG
         END-IF
     END-PERFORM
     MOVE WS-COUNT TO WS-EDIT
     COMPUTE WS-EDIT2 = WS-LONG - WS-LAST
     MOVE SPACES TO TL-OBSERVED
     STRING FUNCTION TRIM(WS-EDIT) " " FUNCTION TRIM(WS-EDIT2) DELIMITED BY SIZE
         INTO TL-OBSERVED
     MOVE "2 0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.
 END PROGRAM TEST-TIME.

 COPY CORETEST.
