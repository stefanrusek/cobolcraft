*> Test of 31 section 6 (Interplay with chunk storage; T0851): the chunk entry of a live entity (key order, keepPacked false), the round
*> trip of a chest and of a loot chest (validation 2 and 3), relocation of a tag from another chunk, keepPacked true stays pending, an
*> invalid id is dropped, and setBlockEntity refuses a state that does not allow it and marks a replaced entity removed.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-BE-31-1-6.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY BESTATE.
 COPY PROTO.
 01 WS-TEXT                PIC X(8192).
 01 WS-EDIT                PIC -(9)9.
 01 WS-EDIT2               PIC -(9)9.
 01 WS-EDIT3               PIC -(9)9.
 01 WS-EDIT4               PIC -(9)9.
 01 WS-I                   BINARY-LONG.
 01 WS-LEN                 BINARY-LONG.
 01 WS-IDX                 BINARY-LONG.
 01 WS-CAPACITY            BINARY-LONG VALUE 4096.
 01 WS-ZERO                BINARY-LONG VALUE 0.
 01 WS-TYPE10              BINARY-LONG VALUE 10.
 COPY COREAPI.
     COPY CITEMS.
 01 WS-D                   BINARY-LONG VALUE 1.
 01 WS-X                   BINARY-LONG VALUE 35.
 01 WS-Y                   BINARY-LONG VALUE 64.
 01 WS-Z                   BINARY-LONG VALUE -3.
 01 WS-T                   BINARY-LONG.
 01 WS-KEY                 PIC X(48).
 01 WS-CHEST               BINARY-LONG.
 01 WS-OUT                 PIC X(8192).
 01 WS-TEXT2               PIC X(8192).
 01 WS-CX                  BINARY-LONG.
 01 WS-CZ                  BINARY-LONG.
 01 WS-RESULT              BINARY-LONG.
 01 WS-NEW                 BINARY-LONG.
 01 WS-NAME                PIC X(32).
 01 WS-ZERO-B              BINARY-LONG VALUE 0.
 01 WS-ONE                 BINARY-LONG VALUE 1.
 01 WS-ITEM-KEY            PIC X(48).
 01 WS-SAVED               PIC X(2048).
 01 WS-SAVED-LEN           BINARY-LONG.
 01 WS-KEEP                BINARY-LONG.
 01 WS-LOADED              BINARY-LONG.
 01 WS-KLEN                BINARY-LONG.
 PROCEDURE DIVISION.
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     MOVE "minecraft:chest" TO WS-KEY
     MOVE 15 TO WS-LEN
     MOVE 1 TO WS-T
     CALL "BE-CREATE" USING WS-D WS-X WS-Y WS-Z WS-T WS-KEY WS-LEN WS-CHEST
     MOVE 1 TO BE-SLOT-ITEM(WS-CHEST, 1)
     MOVE 10 TO BE-SLOT-COUNT(WS-CHEST, 1)

     MOVE "acceptance US12 31-1§6 chunk storage: a live chest is stored with Items, components, id, x, y, z and keepPacked 0" TO TL-CASE
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     CALL "BE-SAVE-CHUNK" USING WS-CHEST PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE PB-LENGTH TO WS-SAVED-LEN
     MOVE 0 TO PB-POS
     CALL "PB-GET-BYTES" USING PB-BUFFER WS-SAVED WS-SAVED-LEN
     MOVE 0 TO PB-POS
     MOVE 0 TO WS-LEN
     MOVE SPACES TO WS-OUT
     CALL "TEST-NBT-RENDER" USING PB-BUFFER WS-TYPE10 WS-OUT WS-LEN
     CALL "PB-FREE" USING PB-BUFFER
     MOVE SPACES TO WS-TEXT2
     STRING "{Items:[{Slot:0,id:" FUNCTION TRIM(IT-KEY(2)) ",count:10}],components:{},id:minecraft:chest,x:35,y:64,z:-3,keepPacked:0}"
         DELIMITED BY SIZE INTO WS-TEXT2
     MOVE WS-OUT(1:WS-LEN) TO WS-TEXT
     MOVE WS-TEXT2 TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 31-1§6 chunk storage: loading that entry creates an identical chest at the tag position (round trip)" TO TL-CASE
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     CALL "PB-APPEND-BYTES" USING PB-BUFFER WS-SAVED WS-SAVED-LEN
     MOVE 0 TO PB-POS
     MOVE 2 TO WS-CX
     MOVE -1 TO WS-CZ
     MOVE 1 TO WS-ONE
     MOVE "minecraft:chest" TO WS-KEY
     MOVE 15 TO WS-KLEN
     CALL "BE-LOAD-CHUNK-ENTRY" USING PB-BUFFER WS-D WS-CX WS-CZ WS-KEY WS-KLEN WS-RESULT WS-NEW
     CALL "PB-FREE" USING PB-BUFFER
     MOVE WS-RESULT TO WS-EDIT
     MOVE BE-SLOT-COUNT(WS-NEW, 1) TO WS-EDIT2
     MOVE BE-TYPE(WS-NEW) TO WS-EDIT3
     MOVE BE-X(WS-NEW) TO WS-EDIT4
     MOVE SPACES TO WS-TEXT
     STRING FUNCTION TRIM(WS-EDIT) " " FUNCTION TRIM(WS-EDIT2) " type " FUNCTION TRIM(WS-EDIT3) " x " FUNCTION TRIM(WS-EDIT4)
         DELIMITED BY SIZE INTO WS-TEXT
     MOVE "0 10 type 1 x 35" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 31-1§6 chunk storage: a tag from another chunk is relocated (35 read for chunk 0 becomes 3)" TO TL-CASE
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     CALL "PB-APPEND-BYTES" USING PB-BUFFER WS-SAVED WS-SAVED-LEN
     MOVE 0 TO PB-POS
     MOVE 0 TO WS-CX
     CALL "BE-LOAD-CHUNK-ENTRY" USING PB-BUFFER WS-D WS-CX WS-CZ WS-KEY WS-KLEN WS-RESULT WS-NEW
     CALL "PB-FREE" USING PB-BUFFER
     MOVE BE-X(WS-NEW) TO WS-EDIT
     MOVE BE-Z(WS-NEW) TO WS-EDIT2
     MOVE SPACES TO WS-TEXT
     STRING FUNCTION TRIM(WS-EDIT) " " FUNCTION TRIM(WS-EDIT2) DELIMITED BY SIZE INTO WS-TEXT
     MOVE "3 -3" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 31-1§6 chunk storage: a loot chest keeps LootTable and LootTableSeed and no Items through save and load" TO TL-CASE
     MOVE 0 TO BE-SLOT-COUNT(WS-CHEST, 1)
     MOVE "minecraft:chests/simple_dungeon" TO BE-LOOT(WS-CHEST)
     MOVE 31 TO BE-LOOT-LENGTH(WS-CHEST)
     MOVE 777 TO BE-SEED(WS-CHEST)
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     CALL "BE-SAVE-CHUNK" USING WS-CHEST PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE 0 TO PB-POS
     MOVE 2 TO WS-CX
     CALL "BE-LOAD-CHUNK-ENTRY" USING PB-BUFFER WS-D WS-CX WS-CZ WS-KEY WS-KLEN WS-RESULT WS-NEW
     CALL "PB-FREE" USING PB-BUFFER
     MOVE BE-SEED(WS-NEW) TO WS-EDIT
     MOVE SPACES TO WS-TEXT
     STRING FUNCTION TRIM(BE-LOOT(WS-NEW)) " " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO WS-TEXT
     MOVE "minecraft:chests/simple_dungeon 777" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 31-1§6 chunk storage: keepPacked true stays pending (result 1), an unknown id is dropped (2)" TO TL-CASE
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     MOVE "id" TO WS-NAME
     MOVE 2 TO WS-LEN
     MOVE "minecraft:chest" TO WS-ITEM-KEY
     MOVE 15 TO WS-I
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WS-NAME WS-LEN WS-ITEM-KEY WS-I
     MOVE "keepPacked" TO WS-NAME
     MOVE 10 TO WS-LEN
     MOVE 1 TO WS-KEEP
     CALL "NBT-WRITE-BYTE" USING PB-BUFFER WS-NAME WS-LEN WS-KEEP
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE 0 TO PB-POS
     CALL "BE-LOAD-CHUNK-ENTRY" USING PB-BUFFER WS-D WS-CX WS-CZ WS-KEY WS-KLEN WS-RESULT WS-NEW
     CALL "PB-FREE" USING PB-BUFFER
     MOVE WS-RESULT TO WS-EDIT
     MOVE WS-NEW TO WS-EDIT3
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     MOVE "id" TO WS-NAME
     MOVE 2 TO WS-LEN
     MOVE "minecraft:nonsense" TO WS-ITEM-KEY
     MOVE 18 TO WS-I
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WS-NAME WS-LEN WS-ITEM-KEY WS-I
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE 0 TO PB-POS
     CALL "BE-LOAD-CHUNK-ENTRY" USING PB-BUFFER WS-D WS-CX WS-CZ WS-KEY WS-KLEN WS-RESULT WS-NEW
     CALL "PB-FREE" USING PB-BUFFER
     MOVE WS-RESULT TO WS-EDIT2
     MOVE SPACES TO WS-TEXT
     STRING FUNCTION TRIM(WS-EDIT) " " FUNCTION TRIM(WS-EDIT3) " " FUNCTION TRIM(WS-EDIT2) DELIMITED BY SIZE INTO WS-TEXT
     MOVE "1 0 2" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 31-1§6 chunk storage: setBlockEntity refuses a state that does not allow the entity and marks the entity it replaces removed" TO TL-CASE
     MOVE 1 TO WS-ONE
     MOVE 0 TO WS-ZERO-B
     CALL "BE-SET-BLOCK-ENTITY" USING WS-CHEST WS-ZERO-B WS-RESULT
     MOVE WS-RESULT TO WS-EDIT
     MOVE "minecraft:chest" TO WS-KEY
     MOVE 15 TO WS-LEN
     MOVE 1 TO WS-T
     CALL "BE-CREATE" USING WS-D WS-X WS-Y WS-Z WS-T WS-KEY WS-LEN WS-NEW
     MOVE 1 TO BE-REMOVED(WS-NEW)
     CALL "BE-SET-BLOCK-ENTITY" USING WS-NEW WS-ONE WS-RESULT
     MOVE WS-RESULT TO WS-EDIT2
     MOVE BE-REMOVED(WS-NEW) TO WS-EDIT3
     MOVE BE-REMOVED(WS-CHEST) TO WS-EDIT4
     MOVE SPACES TO WS-TEXT
     STRING FUNCTION TRIM(WS-EDIT) " " FUNCTION TRIM(WS-EDIT2) " new " FUNCTION TRIM(WS-EDIT3) " old " FUNCTION TRIM(WS-EDIT4)
         DELIMITED BY SIZE INTO WS-TEXT
     MOVE "0 1 new 0 old 1" TO TL-EXPECTED
     PERFORM CHECK
     GOBACK.

 CHECK.
     MOVE "T" TO TL-MODE
     MOVE WS-TEXT TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-BE-31-1-6.

 COPY CORETEST.
