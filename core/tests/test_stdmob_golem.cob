*> Probe (lane buggolem): an iron golem in a standard world on a stone floor. Measures what it does over 600 ticks of MOBS-TICK alone and near a zombie,
*> and whether a survival player's attacks (fist, iron sword) reduce its health and kill it.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-STDMOB-GOLEM.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY COREAPI.
 COPY CONTENT.
 COPY CITEMS.
 COPY BRWORLD.
 01 WS-NAME                PIC X(16) VALUE "Stefan".
 01 WS-NAME-LENGTH         BINARY-LONG VALUE 6.
 01 WS-CONN                BINARY-LONG.
 01 WS-PLAYER              BINARY-LONG.
 01 WS-DIM                 BINARY-LONG.
 01 WS-KEY                 PIC X(112).
 01 WS-ENTITY-ROW          PIC X(66).
 01 WS-ITEM-ROW            PIC X(270).
 01 WS-BLOCK-ROW           PIC X(819).
 01 WS-BLOCK               BINARY-LONG.
 01 WS-STATUS              BINARY-LONG.
 01 WS-STATE-TEXT          PIC X(5).
 01 WS-STONE               BINARY-LONG.
 01 WS-AIR                 BINARY-LONG VALUE 0.
 01 WS-TYPE                BINARY-LONG.
 01 WS-GOLEM               BINARY-LONG.
 01 WS-ZOMBIE              BINARY-LONG.
 01 WS-CX                  BINARY-LONG.
 01 WS-CZ                  BINARY-LONG.
 01 WS-FLOOR               BINARY-LONG.
 01 WS-X                   BINARY-LONG.
 01 WS-Z                   BINARY-LONG.
 01 WS-Y                   BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-K                   BINARY-LONG.
 01 WS-FX                  FLOAT-LONG.
 01 WS-FY                  FLOAT-LONG.
 01 WS-FZ                  FLOAT-LONG.
 01 WS-YAW                 FLOAT-SHORT VALUE 0.
 01 WS-ID                  BINARY-LONG.
 01 WS-ITEM-ID             BINARY-LONG.
 01 WS-MOVED               PIC -(5)9.999.
 01 WS-E1                  PIC -(9)9.
 01 WS-E2                  PIC -(9)9.
 01 WS-E3                  PIC -(9)9.
 01 WS-START-X             FLOAT-LONG.
 01 WS-START-Z             FLOAT-LONG.
 01 WS-D                   FLOAT-LONG.
 01 WS-MOBKEY              PIC X(24) VALUE "minecraft:iron_golem".
 01 WS-ONE                 BINARY-LONG VALUE 1.
 PROCEDURE DIVISION.
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     MOVE 2 TO CS-VIEW-DISTANCE
     MOVE 0 TO CS-HOSTILE-MOBS
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     CALL "TEST-STANDARD-TABLES"
     CALL "BR-WORLD-READY"
     MOVE 2 TO BW-DIFFICULTY
     CALL "TEST-JOIN" USING WS-NAME WS-NAME-LENGTH WS-CONN
     MOVE CN-PLAYER(WS-CONN) TO WS-PLAYER
     MOVE 1 TO PL-MODE(WS-PLAYER)
     MOVE PL-DIM(WS-PLAYER) TO WS-DIM
     MOVE "minecraft:stone" TO WS-KEY
     CALL "CONTENT-BLOCK-BY-KEY" USING WS-KEY WS-BLOCK WS-BLOCK-ROW WS-STATUS
     MOVE WS-BLOCK-ROW(1 + 4 + 35 + 32 + 288 + 4 + 5:5) TO WS-STATE-TEXT
     COMPUTE WS-STONE = FUNCTION NUMVAL(WS-STATE-TEXT)
     COMPUTE WS-CX = FUNCTION INTEGER(PL-X(WS-PLAYER))
     COMPUTE WS-CZ = FUNCTION INTEGER(PL-Z(WS-PLAYER))
     COMPUTE WS-FLOOR = FUNCTION INTEGER(PL-Y(WS-PLAYER)) + 40
     PERFORM VARYING WS-X FROM -24 BY 1 UNTIL WS-X > 24
         PERFORM VARYING WS-Z FROM -24 BY 1 UNTIL WS-Z > 24
             COMPUTE WS-K = WS-CX + WS-X
             COMPUTE WS-I = WS-CZ + WS-Z
             CALL "WORLD-SET-BLOCK" USING WS-DIM WS-K WS-FLOOR WS-I WS-STONE
             PERFORM VARYING WS-Y FROM 1 BY 1 UNTIL WS-Y > 4
                 COMPUTE WS-ID = WS-FLOOR + WS-Y
                 CALL "WORLD-SET-BLOCK" USING WS-DIM WS-K WS-ID WS-I WS-AIR
             END-PERFORM
         END-PERFORM
     END-PERFORM
     COMPUTE PL-X(WS-PLAYER) = WS-CX + 20.5
     COMPUTE PL-Y(WS-PLAYER) = WS-FLOOR + 1
     COMPUTE PL-Z(WS-PLAYER) = WS-CZ + 20.5
     MOVE 0 TO PL-MODE(WS-PLAYER)
     PERFORM PROBE-PLAYER-ATTACK
     MOVE "minecraft:cow" TO WS-MOBKEY
     PERFORM PROBE-PLAYER-ATTACK
     MOVE "minecraft:iron_golem" TO WS-MOBKEY
     MOVE 1 TO PL-MODE(WS-PLAYER)
     PERFORM PROBE-IDLE
     PERFORM PROBE-ZOMBIE
     STOP RUN.

 SPAWN-GOLEM.
     MOVE WS-MOBKEY TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-TYPE WS-ENTITY-ROW WS-STATUS
     COMPUTE WS-FX = WS-CX + 0.5
     COMPUTE WS-FY = WS-FLOOR + 1
     COMPUTE WS-FZ = WS-CZ + 0.5
     CALL "MOB-SPAWN" USING WS-DIM WS-TYPE WS-FX WS-FY WS-FZ WS-YAW WS-GOLEM.

 PROBE-IDLE.
     PERFORM SPAWN-GOLEM
     MOVE 6000 TO CW-TIME
     CALL "TEST-TICKS" USING WS-ONE
     MOVE EN-X(WS-GOLEM) TO WS-START-X
     MOVE EN-Z(WS-GOLEM) TO WS-START-Z
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 600
         CALL "TEST-TICKS" USING WS-ONE
     END-PERFORM
     COMPUTE WS-D = FUNCTION SQRT((EN-X(WS-GOLEM) - WS-START-X) ** 2 + (EN-Z(WS-GOLEM) - WS-START-Z) ** 2)
     MOVE WS-D TO WS-MOVED
     DISPLAY "PROBE idle golem moved " WS-MOVED " health " EN-HEALTH(WS-GOLEM)
     CALL "ENTITY-REMOVE" USING WS-GOLEM.

 PROBE-ZOMBIE.
     PERFORM SPAWN-GOLEM
     MOVE "minecraft:zombie" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-TYPE WS-ENTITY-ROW WS-STATUS
     COMPUTE WS-FX = WS-CX + 10.5
     COMPUTE WS-FY = WS-FLOOR + 1
     COMPUTE WS-FZ = WS-CZ + 0.5
     CALL "MOB-SPAWN" USING WS-DIM WS-TYPE WS-FX WS-FY WS-FZ WS-YAW WS-ZOMBIE
     MOVE EN-ID(WS-ZOMBIE) TO WS-ID
     MOVE 6000 TO CW-TIME
     MOVE EN-X(WS-GOLEM) TO WS-START-X
     MOVE EN-Z(WS-GOLEM) TO WS-START-Z
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 600
         CALL "TEST-TICKS" USING WS-ONE
     END-PERFORM
     COMPUTE WS-D = FUNCTION SQRT((EN-X(WS-GOLEM) - WS-START-X) ** 2 + (EN-Z(WS-GOLEM) - WS-START-Z) ** 2)
     MOVE WS-D TO WS-MOVED
     DISPLAY "PROBE zombie: golem moved " WS-MOVED " golem health " EN-HEALTH(WS-GOLEM)
     DISPLAY "PROBE zombie row used " EN-USED(WS-ZOMBIE) " id " EN-ID(WS-ZOMBIE) " (was " WS-ID ") health " EN-HEALTH(WS-ZOMBIE)
     CALL "ENTITY-REMOVE" USING WS-GOLEM.

 PROBE-PLAYER-ATTACK.
     PERFORM SPAWN-GOLEM
     MOVE 0 TO PL-MODE(WS-PLAYER)
     MOVE 0 TO PL-HELD(WS-PLAYER)
     MOVE "minecraft:iron_sword" TO WS-KEY
     CALL "CONTENT-ITEM-BY-KEY" USING WS-KEY WS-ITEM-ID WS-ITEM-ROW WS-STATUS
     MOVE WS-ITEM-ID TO PL-SLOT-ITEM(WS-PLAYER, 1)
     MOVE 1 TO PL-SLOT-COUNT(WS-PLAYER, 1)
     MOVE 0 TO PL-SLOT-VAR(WS-PLAYER, 1)
     COMPUTE PL-X(WS-PLAYER) = EN-X(WS-GOLEM) + 1.5
     MOVE EN-Z(WS-GOLEM) TO PL-Z(WS-PLAYER)
     MOVE EN-Y(WS-GOLEM) TO PL-Y(WS-PLAYER)
     MOVE EN-ID(WS-GOLEM) TO WS-ID
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 30
         MOVE 20 TO PL-HEALTH(WS-PLAYER)
         COMPUTE PL-X(WS-PLAYER) = EN-X(WS-GOLEM) + 1.5
         MOVE EN-Z(WS-GOLEM) TO PL-Z(WS-PLAYER)
         CALL "TEST-ATTACK" USING WS-CONN WS-ID
         MOVE EN-HEALTH(WS-GOLEM) TO WS-E1
         MOVE EN-USED(WS-GOLEM) TO WS-E2
         DISPLAY "PROBE state " PL-STATE(WS-PLAYER) " plx " PL-X(WS-PLAYER) " ply " PL-Y(WS-PLAYER) " enx " EN-X(WS-GOLEM) " eny " EN-Y(WS-GOLEM) " held " PL-HELD(WS-PLAYER) " slotitem " PL-SLOT-ITEM(WS-PLAYER, 1)
         DISPLAY "PROBE attack " WS-MOBKEY WS-I " health " WS-E1 " used " WS-E2
         PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 12
             CALL "TEST-TICKS" USING WS-ONE
         END-PERFORM
     END-PERFORM.
 END PROGRAM TEST-STDMOB-GOLEM.
 COPY CORETEST.
