    05 FILLER PIC X(512) VALUE "f 1.2.3$".
    05 FILLER PIC X(160) VALUE "err parsing.float.invalid|1.2.3@2".
    05 FILLER PIC X(512) VALUE "d x$".
    05 FILLER PIC X(160) VALUE "err parsing.double.expected@2".
    05 FILLER PIC X(512) VALUE "i 12345678901$".
    05 FILLER PIC X(160) VALUE "err parsing.int.invalid|12345678901@2".
    05 FILLER PIC X(512) VALUE "i ----------------------------------------------------------------------$".
    05 FILLER PIC X(160) VALUE "err parsing.int.invalid|----------------------------------------------------------------@2".
    05 FILLER PIC X(512) VALUE "b xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx$".
    05 FILLER PIC X(160) VALUE "err parsing.bool.invalid|xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@2".
    05 FILLER PIC X(512) VALUE "f 1.5$".
    05 FILLER PIC X(160) VALUE "ok 6 f[0,1] v[2,5] v=1.5".
    05 FILLER PIC X(512) VALUE "f -0.25$".
    05 FILLER PIC X(160) VALUE "ok 6 f[0,1] v[2,7] v=-0.25".
    05 FILLER PIC X(512) VALUE "f 0.000001$".
    05 FILLER PIC X(160) VALUE "ok 6 f[0,1] v[2,10] v=1.0E-6".
    05 FILLER PIC X(512) VALUE "d 123456.789$".
    05 FILLER PIC X(160) VALUE "ok 5 d[0,1] v[2,12] v=123456.789".
    05 FILLER PIC X(512) VALUE "d 1.5E$".
    05 FILLER PIC X(160) VALUE "err command.expected.separator@5".
