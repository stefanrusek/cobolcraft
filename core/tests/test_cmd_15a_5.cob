    05 FILLER PIC X(512) VALUE "f 1000000000000000000000000000000000000000$".
    05 FILLER PIC X(160) VALUE "err argument.float.big|3.4028235E38|Infinity@2".
    05 FILLER PIC X(512) VALUE "f -1000000000000000000000000000000000000000$".
    05 FILLER PIC X(160) VALUE "err argument.float.low|-3.4028235E38|-Infinity@2".
    05 FILLER PIC X(512) VALUE "f 0.1$".
