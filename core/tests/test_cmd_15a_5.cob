    05 FILLER PIC X(160) VALUE "ok 7 b[0,1] v[2,7] v=0".
    05 FILLER PIC X(512) VALUE "w abc$".
    05 FILLER PIC X(160) VALUE "ok 8 w[0,1] v[2,5]".
    05 FILLER PIC X(512) VALUE 'w "q"$'.
    05 FILLER PIC X(160) VALUE "err command.expected.separator@2".
    05 FILLER PIC X(512) VALUE "p 'it\'s'$".
    05 FILLER PIC X(160) VALUE "ok 9 p[0,1] v[2,9]".
    05 FILLER PIC X(512) VALUE 'p "a\\b"$'.
    05 FILLER PIC X(160) VALUE "ok 9 p[0,1] v[2,8]".
    05 FILLER PIC X(512) VALUE 'p ''a"b'' x$'.
    05 FILLER PIC X(160) VALUE "err command.unknown.argument@8".
    05 FILLER PIC X(512) VALUE "g bob$".
    05 FILLER PIC X(160) VALUE "ok 10 g[0,1] v[2,5]".
