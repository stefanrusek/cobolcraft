 01 WS-SHOW                PIC -(9)9.
 01 WS-TEXTS.
    05 WS-T1               PIC X(96).
    05 WS-T2               PIC X(96).
 01 WS-BD1 BINARY-DOUBLE.
 01 WS-BD2 BINARY-DOUBLE.
 PROCEDURE DIVISION.
     MOVE "T" TO TL-MODE
     MOVE "acceptance US12 29b-1§2 The shared model: trigger codes of 2.2: RT, ST, PL, NU, SU, EV, ET; only ST is a scheduled tick" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1" TO WS-IN
     PERFORM LOAD-IN
     MOVE SPACES TO WS-T1
     CALL "GB-TRIGGER" USING WS-I1 WS-T1 WS-R1
     COMPUTE WS-R2 = FUNCTION ORD(WS-T1(1:1))
     COMPUTE WS-R3 = FUNCTION ORD(WS-T1(2:1))
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "2" TO WS-IN
     PERFORM LOAD-IN
     MOVE SPACES TO WS-T1
     CALL "GB-TRIGGER" USING WS-I1 WS-T1 WS-R1
     COMPUTE WS-R2 = FUNCTION ORD(WS-T1(1:1))
     COMPUTE WS-R3 = FUNCTION ORD(WS-T1(2:1))
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "3" TO WS-IN
     PERFORM LOAD-IN
     MOVE SPACES TO WS-T1
     CALL "GB-TRIGGER" USING WS-I1 WS-T1 WS-R1
     COMPUTE WS-R2 = FUNCTION ORD(WS-T1(1:1))
     COMPUTE WS-R3 = FUNCTION ORD(WS-T1(2:1))
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "4" TO WS-IN
     PERFORM LOAD-IN
     MOVE SPACES TO WS-T1
     CALL "GB-TRIGGER" USING WS-I1 WS-T1 WS-R1
     COMPUTE WS-R2 = FUNCTION ORD(WS-T1(1:1))
     COMPUTE WS-R3 = FUNCTION ORD(WS-T1(2:1))
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "5" TO WS-IN
     PERFORM LOAD-IN
     MOVE SPACES TO WS-T1
     CALL "GB-TRIGGER" USING WS-I1 WS-T1 WS-R1
     COMPUTE WS-R2 = FUNCTION ORD(WS-T1(1:1))
     COMPUTE WS-R3 = FUNCTION ORD(WS-T1(2:1))
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "6" TO WS-IN
     PERFORM LOAD-IN
     MOVE SPACES TO WS-T1
     CALL "GB-TRIGGER" USING WS-I1 WS-T1 WS-R1
     COMPUTE WS-R2 = FUNCTION ORD(WS-T1(1:1))
     COMPUTE WS-R3 = FUNCTION ORD(WS-T1(2:1))
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "7" TO WS-IN
     PERFORM LOAD-IN
     MOVE SPACES TO WS-T1
     CALL "GB-TRIGGER" USING WS-I1 WS-T1 WS-R1
     COMPUTE WS-R2 = FUNCTION ORD(WS-T1(1:1))
     COMPUTE WS-R3 = FUNCTION ORD(WS-T1(2:1))
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "0/83/85 1/84/85 0/81/77 0/79/86 0/84/86 0/70/87 0/70/85" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29b-1§2 The shared model: probability notation 2.4: 1/N is true on a draw of 0; P(p) on a float draw below p; U(a, b) is a when a >= b without a draw, else the draw plus a" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1 7 0 0.0 0 0.0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GB-PROBABILITY" USING WS-I1 WS-I2 WS-I3 WS-FX4 WS-I5 WS-FX6 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1 7 0 0.0 3 0.0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GB-PROBABILITY" USING WS-I1 WS-I2 WS-I3 WS-FX4 WS-I5 WS-FX6 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 0 0.0 0 0.0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GB-PROBABILITY" USING WS-I1 WS-I2 WS-I3 WS-FX4 WS-I5 WS-FX6 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "2 0 0 0.45 0 0.449" TO WS-IN
     PERFORM LOAD-IN
     CALL "GB-PROBABILITY" USING WS-I1 WS-I2 WS-I3 WS-FX4 WS-I5 WS-FX6 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "2 0 0 0.45 0 0.451" TO WS-IN
     PERFORM LOAD-IN
     CALL "GB-PROBABILITY" USING WS-I1 WS-I2 WS-I3 WS-FX4 WS-I5 WS-FX6 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "2 0 0 0.1 0 0.0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GB-PROBABILITY" USING WS-I1 WS-I2 WS-I3 WS-FX4 WS-I5 WS-FX6 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "3 2 5 0.0 3 0.0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GB-PROBABILITY" USING WS-I1 WS-I2 WS-I3 WS-FX4 WS-I5 WS-FX6 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "3 2 5 0.0 0 0.0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GB-PROBABILITY" USING WS-I1 WS-I2 WS-I3 WS-FX4 WS-I5 WS-FX6 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "3 5 2 0.0 0 0.0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GB-PROBABILITY" USING WS-I1 WS-I2 WS-I3 WS-FX4 WS-I5 WS-FX6 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "3 2 2 0.0 0 0.0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GB-PROBABILITY" USING WS-I1 WS-I2 WS-I3 WS-FX4 WS-I5 WS-FX6 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1/1 0/1 1/1 1/1 0/1 1/1 5/1 2/1 5/0 2/0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29b-1§2 The shared model: random tick rate 2.4: speed / 4096 random ticks per game tick, and speed / (4096 N) for a 1/N effect (per random tick x 10^6, per game tick x 10^9)" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "3 7" TO WS-IN
     PERFORM LOAD-IN
     CALL "GB-RATE" USING WS-I1 WS-I2 WS-BD1 WS-BD2
     MOVE WS-BD1 TO WS-R1
     MOVE WS-BD2 TO WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "3 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "GB-RATE" USING WS-I1 WS-I2 WS-BD1 WS-BD2
     MOVE WS-BD1 TO WS-R1
     MOVE WS-BD2 TO WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "0 5" TO WS-IN
     PERFORM LOAD-IN
     CALL "GB-RATE" USING WS-I1 WS-I2 WS-BD1 WS-BD2
     MOVE WS-BD1 TO WS-R1
     MOVE WS-BD2 TO WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "GB-RATE" USING WS-I1 WS-I2 WS-BD1 WS-BD2
     MOVE WS-BD1 TO WS-R1
     MOVE WS-BD2 TO WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "3 4096" TO WS-IN
     PERFORM LOAD-IN
     CALL "GB-RATE" USING WS-I1 WS-I2 WS-BD1 WS-BD2
     MOVE WS-BD1 TO WS-R1
     MOVE WS-BD2 TO WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "20 3" TO WS-IN
     PERFORM LOAD-IN
     CALL "GB-RATE" USING WS-I1 WS-I2 WS-BD1 WS-BD2
     MOVE WS-BD1 TO WS-R1
     MOVE WS-BD2 TO WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "732/104632 732/732422 0/0 244/244141 732/179 4883/1627604" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 BEGIN-CASE.
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR
     .

 LOAD-IN.
     MOVE 1 TO WS-P
     PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 16
         MOVE SPACES TO WS-TOK
         IF WS-P <= 160
             UNSTRING WS-IN DELIMITED BY ALL SPACE INTO WS-TOK WITH POINTER WS-P
         END-IF
         COMPUTE WS-FX(WS-K) = FUNCTION NUMVAL(WS-TOK)
         COMPUTE WS-I(WS-K) = FUNCTION NUMVAL(WS-TOK)
     END-PERFORM
     .

 ADD-N.
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N
         MOVE WS-R(WS-J) TO WS-SHOW
         IF WS-J > 1
             STRING "/" DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
         END-IF
         STRING FUNCTION TRIM(WS-SHOW) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-PERFORM
     STRING " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .

 ADD-TEXT.
     STRING FUNCTION TRIM(WS-T1) "|" FUNCTION TRIM(WS-T2) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .
 END PROGRAM TEST-GROWTH-29B-1-2.
