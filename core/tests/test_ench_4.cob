*> Test of level-based values (28 section 4; core/src/ench-4.cob): the expression evaluator over the prefix form. Results in ten-thousandths.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-ENCH-4.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 01 WS-I1 BINARY-LONG.
 01 WS-I2 BINARY-LONG.
 01 WS-I3 BINARY-LONG.
 01 WS-I4 BINARY-LONG.
 01 WS-I5 BINARY-LONG.
 01 WS-I6 BINARY-LONG.
 01 WS-I7 BINARY-LONG.
 01 WS-I8 BINARY-LONG.
 01 WS-I9 BINARY-LONG.
 01 WS-I10 BINARY-LONG.
 01 WS-I11 BINARY-LONG.
 01 WS-I12 BINARY-LONG.
 01 WS-I13 BINARY-LONG.
 01 WS-I14 BINARY-LONG.
 01 WS-I15 BINARY-LONG.
 01 WS-I16 BINARY-LONG.
 01 WS-T1 PIC X(200).
 01 WS-T2 PIC X(200).
 01 WS-T3 PIC X(200).
 01 WS-O1 BINARY-LONG.
 01 WS-O2 BINARY-LONG.
 01 WS-O3 BINARY-LONG.
 01 WS-O4 BINARY-LONG.
 01 WS-O5 BINARY-LONG.
 01 WS-O6 BINARY-LONG.
 01 WS-O7 BINARY-LONG.
 01 WS-O8 BINARY-LONG.
 01 WS-O9 BINARY-LONG.
 01 WS-O10 BINARY-LONG.
 01 WS-O11 BINARY-LONG.
 01 WS-O12 BINARY-LONG.
 01 WS-X1 PIC X(48).
 01 WS-X2 PIC X(48).
 01 WS-X3 PIC X(48).
 01 WS-OBS PIC X(240).
 01 WS-E1 PIC -(9)9.
 01 WS-E2 PIC -(9)9.
 01 WS-E3 PIC -(9)9.
 01 WS-E4 PIC -(9)9.
 01 WS-E5 PIC -(9)9.
 01 WS-E6 PIC -(9)9.
 01 WS-E7 PIC -(9)9.
 01 WS-E8 PIC -(9)9.
 01 WS-E9 PIC -(9)9.
 01 WS-E10 PIC -(9)9.
 01 WS-E11 PIC -(9)9.
 01 WS-E12 PIC -(9)9.
 PROCEDURE DIVISION.
     MOVE "acceptance US14 28.4 bare number and linear: Sharpness linear 1.0 + 0.5 per level above the first gives 1.0, 2.0, 3.0 at levels 1, 3, 5" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE SPACES TO WS-T1
     MOVE "2.5" TO WS-T1
     MOVE 1 TO WS-I1
     CALL "TOOL-LBV-EVAL" USING WS-T1 WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "linear 1.0 0.5" TO WS-T1
     MOVE 1 TO WS-I1
     CALL "TOOL-LBV-EVAL" USING WS-T1 WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "linear 1.0 0.5" TO WS-T1
     MOVE 3 TO WS-I1
     CALL "TOOL-LBV-EVAL" USING WS-T1 WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "linear 1.0 0.5" TO WS-T1
     MOVE 5 TO WS-I1
     CALL "TOOL-LBV-EVAL" USING WS-T1 WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "25000/0 10000/0 20000/0 30000/0" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 28.4 levels_squared added 1 at level 3 is 10.0" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE SPACES TO WS-T1
     MOVE "squared 1" TO WS-T1
     MOVE 3 TO WS-I1
     CALL "TOOL-LBV-EVAL" USING WS-T1 WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "100000/0" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 28.4 lookup values 1.2, 1.75, 2.2 with fallback linear 1.5 + 0.35: levels 2, 3, 4 give 1.75, 2.2, 2.55" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE SPACES TO WS-T1
     MOVE "lookup 3 1.2 1.75 2.2 linear 1.5 0.35" TO WS-T1
     MOVE 2 TO WS-I1
     CALL "TOOL-LBV-EVAL" USING WS-T1 WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "lookup 3 1.2 1.75 2.2 linear 1.5 0.35" TO WS-T1
     MOVE 3 TO WS-I1
     CALL "TOOL-LBV-EVAL" USING WS-T1 WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "lookup 3 1.2 1.75 2.2 linear 1.5 0.35" TO WS-T1
     MOVE 4 TO WS-I1
     CALL "TOOL-LBV-EVAL" USING WS-T1 WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "17500/0 22000/0 25500/0" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 28.4 fraction (Unbreaking armor entry linear 2 + 2 over linear 10 + 5) at levels 1, 2, 3 gives 0.2, 0.26667, 0.3; the other entry 0.5, 0.66667, 0.75" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE SPACES TO WS-T1
     MOVE "fraction linear 2 2 linear 10 5" TO WS-T1
     MOVE 1 TO WS-I1
     CALL "TOOL-LBV-EVAL" USING WS-T1 WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "fraction linear 2 2 linear 10 5" TO WS-T1
     MOVE 2 TO WS-I1
     CALL "TOOL-LBV-EVAL" USING WS-T1 WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "fraction linear 2 2 linear 10 5" TO WS-T1
     MOVE 3 TO WS-I1
     CALL "TOOL-LBV-EVAL" USING WS-T1 WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "fraction linear 1 1 linear 2 1" TO WS-T1
     MOVE 1 TO WS-I1
     CALL "TOOL-LBV-EVAL" USING WS-T1 WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "fraction linear 1 1 linear 2 1" TO WS-T1
     MOVE 2 TO WS-I1
     CALL "TOOL-LBV-EVAL" USING WS-T1 WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "fraction linear 1 1 linear 2 1" TO WS-T1
     MOVE 3 TO WS-I1
     CALL "TOOL-LBV-EVAL" USING WS-T1 WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "2000/0 2667/0 3000/0 5000/0 6667/0 7500/0" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 28.4 exponent base 2.0 power 3.0 is 8.0; a fraction with denominator 0 is 0.0" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE SPACES TO WS-T1
     MOVE "exponent 2.0 3.0" TO WS-T1
     MOVE 1 TO WS-I1
     CALL "TOOL-LBV-EVAL" USING WS-T1 WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "exponent 2.0 3.0" TO WS-T1
     MOVE 9 TO WS-I1
     CALL "TOOL-LBV-EVAL" USING WS-T1 WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "fraction 1 0" TO WS-T1
     MOVE 3 TO WS-I1
     CALL "TOOL-LBV-EVAL" USING WS-T1 WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "fraction linear 1 1 0" TO WS-T1
     MOVE 3 TO WS-I1
     CALL "TOOL-LBV-EVAL" USING WS-T1 WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "80000/0 80000/0 0/0 0/0" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 28.4 clamped linear 3 + 1 with min 0 max 4 at level 4 is 6.0 clamped to 4.0; below the range it is not changed" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE SPACES TO WS-T1
     MOVE "clamped 0 4 linear 3 1" TO WS-T1
     MOVE 4 TO WS-I1
     CALL "TOOL-LBV-EVAL" USING WS-T1 WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "clamped 0 4 linear 3 1" TO WS-T1
     MOVE 1 TO WS-I1
     CALL "TOOL-LBV-EVAL" USING WS-T1 WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "clamped 0 4 linear 0 1" TO WS-T1
     MOVE 1 TO WS-I1
     CALL "TOOL-LBV-EVAL" USING WS-T1 WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "40000/0 30000/0 0/0" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 28.4 clamped with max not larger than min is rejected (Max must be larger than min), a truncated expression is a syntax error" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE SPACES TO WS-T1
     MOVE "clamped 4 4 5" TO WS-T1
     MOVE 1 TO WS-I1
     CALL "TOOL-LBV-EVAL" USING WS-T1 WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "clamped 5 4 5" TO WS-T1
     MOVE 1 TO WS-I1
     CALL "TOOL-LBV-EVAL" USING WS-T1 WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "linear 1" TO WS-T1
     MOVE 1 TO WS-I1
     CALL "TOOL-LBV-EVAL" USING WS-T1 WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "bogus 1 2" TO WS-T1
     MOVE 1 TO WS-I1
     CALL "TOOL-LBV-EVAL" USING WS-T1 WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "0/1 0/1 0/2 0/2" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 28.4 nesting is unbounded: fraction of linear of lookup" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE SPACES TO WS-T1
     MOVE "fraction linear 1 1 lookup 2 2 4 5" TO WS-T1
     MOVE 2 TO WS-I1
     CALL "TOOL-LBV-EVAL" USING WS-T1 WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "exponent fraction 1 2 linear 2 1" TO WS-T1
     MOVE 3 TO WS-I1
     CALL "TOOL-LBV-EVAL" USING WS-T1 WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "5000/0 625/0" TO TL-EXPECTED
     PERFORM CHECK-DONE

     STOP RUN.

 ADD-OBS.
     IF TL-OBSERVED = SPACES
         MOVE FUNCTION TRIM(WS-OBS) TO TL-OBSERVED
     ELSE
         STRING FUNCTION TRIM(TL-OBSERVED) " " FUNCTION TRIM(WS-OBS) DELIMITED BY SIZE INTO TL-OBSERVED
     END-IF.

 CHECK-DONE.
     MOVE "T" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-ENCH-4.
