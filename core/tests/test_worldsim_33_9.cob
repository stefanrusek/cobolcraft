 PROCEDURE DIVISION.
     MOVE "T" TO TL-MODE
     MOVE "acceptance US12 33§9 Difficulty: setDifficulty: ignored unless forced or not locked; a hardcore world always stores HARD" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1 0 0 0" TO WS-IN
     PERFORM LOAD-IN
     MOVE -1 TO WS-R1
     CALL "DF-SET" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 1 0" TO WS-IN
     PERFORM LOAD-IN
     MOVE -1 TO WS-R1
     CALL "DF-SET" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 1 0" TO WS-IN
     PERFORM LOAD-IN
     MOVE -1 TO WS-R1
     CALL "DF-SET" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "2 0 0 1" TO WS-IN
     PERFORM LOAD-IN
     MOVE -1 TO WS-R1
     CALL "DF-SET" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 0 1" TO WS-IN
     PERFORM LOAD-IN
     MOVE -1 TO WS-R1
     CALL "DF-SET" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "0 1 1 1" TO WS-IN
     PERFORM LOAD-IN
     MOVE -1 TO WS-R1
     CALL "DF-SET" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "3 0 1 1" TO WS-IN
     PERFORM LOAD-IN
     MOVE -1 TO WS-R1
     CALL "DF-SET" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1/1 -1/0 1/1 3/1 3/1 3/1 -1/0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 33§9 Difficulty: damage scaling of attacks on a player: Peaceful 0, Easy min(d / 2 + 1, d), Normal d, Hard d x 3 / 2" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0 6" TO WS-IN
     PERFORM LOAD-IN
     CALL "DF-SCALE" USING WS-I1 WS-FX2 WS-RF1
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000000
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 6" TO WS-IN
     PERFORM LOAD-IN
     CALL "DF-SCALE" USING WS-I1 WS-FX2 WS-RF1
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000000
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "DF-SCALE" USING WS-I1 WS-FX2 WS-RF1
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000000
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 0.5" TO WS-IN
     PERFORM LOAD-IN
     CALL "DF-SCALE" USING WS-I1 WS-FX2 WS-RF1
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000000
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "2 6" TO WS-IN
     PERFORM LOAD-IN
     CALL "DF-SCALE" USING WS-I1 WS-FX2 WS-RF1
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000000
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "3 6" TO WS-IN
     PERFORM LOAD-IN
     CALL "DF-SCALE" USING WS-I1 WS-FX2 WS-RF1
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000000
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "3 3" TO WS-IN
     PERFORM LOAD-IN
     CALL "DF-SCALE" USING WS-I1 WS-FX2 WS-RF1
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000000
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 2" TO WS-IN
     PERFORM LOAD-IN
     CALL "DF-SCALE" USING WS-I1 WS-FX2 WS-RF1
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000000
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 4000000 1000000 500000 6000000 9000000 4500000 2000000" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 33§9 Difficulty: difficulty sites: a portal piglin needs spawning, not Peaceful, the attribute, nextInt(2000) < difficulty id and a close player (1/2000, 1/1000, 3/2000); a main" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1 0 1 1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "DF-SITES" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 1 1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "DF-SITES" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "2 1 1 1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "DF-SITES" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "3 2 1 1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "DF-SITES" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "3 3 1 1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "DF-SITES" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 1 1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "DF-SITES" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "2 0 0 1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "DF-SITES" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "2 0 1 0 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "DF-SITES" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "2 0 1 1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "DF-SITES" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "1/0/7/1 0/0/7/1 1/4/14/1 1/4/21/1 0/4/21/1 0/0/0/0 0/4/14/1 0/4/14/1 0/4/14/1" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 33§9 Difficulty: local difficulty inputs: an unloaded chunk uses inhabited time 0 and moon 0; the time input is the overworld clock total, not the game time" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1 5000 0.75 100 24000" TO WS-IN
     PERFORM LOAD-IN
     COMPUTE WS-BD1 = WS-FX4
     COMPUTE WS-BD2 = WS-FX5
     CALL "DF-INSTANCE" USING WS-I1 WS-I2 WS-FX3 WS-BD1 WS-BD2 WS-R1 WS-RF1 WS-BD3
     COMPUTE WS-R2 ROUNDED = WS-RF1 * 1000
     MOVE WS-BD3 TO WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "0 5000 0.75 100 24000" TO WS-IN
     PERFORM LOAD-IN
     COMPUTE WS-BD1 = WS-FX4
     COMPUTE WS-BD2 = WS-FX5
     CALL "DF-INSTANCE" USING WS-I1 WS-I2 WS-FX3 WS-BD1 WS-BD2 WS-R1 WS-RF1 WS-BD3
     COMPUTE WS-R2 ROUNDED = WS-RF1 * 1000
     MOVE WS-BD3 TO WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 0.0 7 7" TO WS-IN
     PERFORM LOAD-IN
     COMPUTE WS-BD1 = WS-FX4
     COMPUTE WS-BD2 = WS-FX5
     CALL "DF-INSTANCE" USING WS-I1 WS-I2 WS-FX3 WS-BD1 WS-BD2 WS-R1 WS-RF1 WS-BD3
     COMPUTE WS-R2 ROUNDED = WS-RF1 * 1000
     MOVE WS-BD3 TO WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "0 9 1.0 24000 100" TO WS-IN
     PERFORM LOAD-IN
     COMPUTE WS-BD1 = WS-FX4
     COMPUTE WS-BD2 = WS-FX5
     CALL "DF-INSTANCE" USING WS-I1 WS-I2 WS-FX3 WS-BD1 WS-BD2 WS-R1 WS-RF1 WS-BD3
     COMPUTE WS-R2 ROUNDED = WS-RF1 * 1000
     MOVE WS-BD3 TO WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "5000/750/24000 0/0/24000 0/0/7 0/0/100" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 BEGIN-CASE.
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR
     .

 LOAD-IN.
     MOVE 1 TO WS-P
     PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 16
         MOVE SPACES TO WS-TOK
         IF WS-P <= 160
             UNSTRING WS-IN DELIMITED BY ALL SPACE INTO WS-TOK WITH POINTER WS-P
         END-IF
         COMPUTE WS-FX(WS-K) = FUNCTION NUMVAL(WS-TOK)
         COMPUTE WS-I(WS-K) = FUNCTION NUMVAL(WS-TOK)
     END-PERFORM
     .

 ADD-N.
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N
         MOVE WS-R(WS-J) TO WS-SHOW
         IF WS-J > 1
             STRING "/" DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
         END-IF
         STRING FUNCTION TRIM(WS-SHOW) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-PERFORM
     STRING " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .

 ADD-TEXT.
     STRING FUNCTION TRIM(WS-T1) "|" FUNCTION TRIM(WS-T2) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .
 END PROGRAM TEST-WORLDSIM-33-9.
