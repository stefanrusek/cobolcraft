*> Test of 31-2 section 5 (Hopper; T0875): the data of the hopper block entity (size 5, name, TransferCooldown with default -1, cooldown predicates, MOVE_ITEM_SPEED and the suck box). The transfer tick, pushing, pulling and the container lookup (5.3 to 5.9) are Phase 43.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-BE-31-2-5.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY BESTATE.
 COPY PROTO.
 COPY COREAPI.
 COPY CITEMS.
 01 WS-TEXT                PIC X(8192).
 01 WS-OUT                 PIC X(8192).
 01 WS-EDIT                PIC -(9)9.
 01 WS-EDIT2               PIC -(9)9.
 01 WS-EDIT3               PIC -(9)9.
 01 WS-I                   BINARY-LONG.
 01 WS-K                   BINARY-LONG.
 01 WS-LEN                 BINARY-LONG.
 01 WS-IDX                 BINARY-LONG.
 01 WS-PTR                 BINARY-LONG.
 01 WS-CAPACITY            BINARY-LONG VALUE 4096.
 01 WS-TYPE10              BINARY-LONG VALUE 10.
 01 WS-FORM                BINARY-LONG VALUE 2.
 01 WS-D                   BINARY-LONG VALUE 1.
 01 WS-X                   BINARY-LONG VALUE 5.
 01 WS-Y                   BINARY-LONG VALUE 70.
 01 WS-Z                   BINARY-LONG VALUE 5.
 01 WS-T                   BINARY-LONG.
 01 WS-KEY                 PIC X(48).
 01 WS-KEY24               PIC X(24).
 01 WS-KEY32               PIC X(32).
 01 WS-NAME                PIC X(32).
 01 WS-ITEM                BINARY-LONG.
 01 WS-COUNT               BINARY-LONG.
 01 WS-VAR                 BINARY-LONG.
 01 WS-A                   BINARY-LONG.
 01 WS-B                   BINARY-LONG.
 01 WS-C                   BINARY-LONG.
 01 WS-HOPPER              BINARY-LONG.
 01 WS-DISPENSER           BINARY-LONG.
 01 WS-DROPPER             BINARY-LONG.
 01 WS-SRC                BINARY-LONG.
 01 WS-FLAG                BINARY-LONG.
 01 WS-SUCK.
    05 WS-SUCK-VALUE       BINARY-LONG OCCURS 6 TIMES.
 01 WS-COOLS.
    05 WS-COOL             BINARY-LONG OCCURS 5 TIMES.
 PROCEDURE DIVISION.
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     MOVE "minecraft:hopper" TO WS-KEY
     MOVE 16 TO WS-LEN
     MOVE 18 TO WS-T
     CALL "BE-CREATE" USING WS-D WS-X WS-Y WS-Z WS-T WS-KEY WS-LEN WS-HOPPER
     ADD 1 TO WS-X
     MOVE "minecraft:dispenser" TO WS-KEY
     MOVE 19 TO WS-LEN
     MOVE 5 TO WS-T
     CALL "BE-CREATE" USING WS-D WS-X WS-Y WS-Z WS-T WS-KEY WS-LEN WS-DISPENSER
     ADD 1 TO WS-X
     MOVE "minecraft:dropper" TO WS-KEY
     MOVE 17 TO WS-LEN
     MOVE 6 TO WS-T
     CALL "BE-CREATE" USING WS-D WS-X WS-Y WS-Z WS-T WS-KEY WS-LEN WS-DROPPER
     MOVE "T" TO TL-MODE
     MOVE "minecraft:chest" TO WS-KEY
     MOVE 15 TO WS-LEN
     MOVE 1 TO WS-T
     CALL "BE-CREATE" USING WS-D WS-X WS-Y WS-Z WS-T WS-KEY WS-LEN WS-SRC
     MOVE "acceptance US12 31-2§5 Hopper: container size 5, default name container.hopper, and MOVE_ITEM_SPEED 8 with the suck box x 0 to 16, y 11 to 32, z 0 to 16 sixteenths" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     MOVE 18 TO WS-T
     CALL "BE-CONTAINER-SIZE" USING WS-T WS-A
     CALL "BE-DEFAULT-NAME" USING WS-T WS-KEY32 WS-LEN
     MOVE WS-A TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) " " WS-KEY32(1:WS-LEN) " " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     CALL "BE2-HOPPER-CONSTANTS" USING WS-A WS-SUCK
     MOVE WS-A TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 6
         MOVE WS-SUCK-VALUE(WS-I) TO WS-EDIT
         STRING " " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     END-PERFORM
     MOVE "5 container.hopper 8 0 11 0 16 32 16" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 31-2§5 Hopper: a fresh hopper writes TransferCooldown -1 and no Items; with a cooldown of 8 and a stack it writes Items then TransferCooldown 8" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     MOVE WS-HOPPER TO WS-IDX
     PERFORM SAVE-RENDER
     MOVE 8 TO BE-COOLDOWN(WS-HOPPER)
     MOVE 2 TO BE-SLOT-ITEM(WS-HOPPER, 2)
     MOVE 5 TO BE-SLOT-COUNT(WS-HOPPER, 2)
     PERFORM SAVE-RENDER
     MOVE SPACES TO WS-KEY
     MOVE IT-KEY(3) TO WS-KEY
     MOVE SPACES TO TL-EXPECTED
     STRING "{TransferCooldown:-1} {Items:[{Slot:1,id:" FUNCTION TRIM(WS-KEY) ",count:5}],TransferCooldown:8} " DELIMITED BY SIZE INTO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 31-2§5 Hopper: loading restores TransferCooldown and the slots 0 to 4 and ignores slot 7; a tag without TransferCooldown reads -1" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     MOVE 7 TO BE-COOLDOWN(WS-HOPPER)
     MOVE 2 TO BE-SLOT-ITEM(WS-SRC, 2)
     MOVE 6 TO BE-SLOT-COUNT(WS-SRC, 2)
     MOVE 2 TO BE-SLOT-ITEM(WS-SRC, 8)
     MOVE 9 TO BE-SLOT-COUNT(WS-SRC, 8)
     MOVE WS-HOPPER TO WS-IDX
     MOVE 0 TO BE-SLOT-COUNT(WS-HOPPER, 2)
     PERFORM ROUNDTRIP
     MOVE BE-COOLDOWN(WS-HOPPER) TO WS-EDIT
     MOVE BE-SLOT-COUNT(WS-HOPPER, 2) TO WS-EDIT2
     MOVE BE-SLOT-COUNT(WS-HOPPER, 8) TO WS-EDIT3
     STRING FUNCTION TRIM(WS-EDIT) " " FUNCTION TRIM(WS-EDIT2) " " FUNCTION TRIM(WS-EDIT3) DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE "-1 6 0" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 31-2§5 Hopper: on cooldown is cooldownTime above 0 and on custom cooldown above 8: -1 and 0 neither, 1 and 8 cooling, 9 custom" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     MOVE -1 TO WS-COOL(1)
     MOVE 0 TO WS-COOL(2)
     MOVE 1 TO WS-COOL(3)
     MOVE 8 TO WS-COOL(4)
     MOVE 9 TO WS-COOL(5)
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 5
         MOVE WS-COOL(WS-I) TO WS-A
         CALL "BE2-HOPPER-COOLDOWN" USING WS-A WS-B WS-C
         MOVE WS-B TO WS-EDIT
         MOVE WS-C TO WS-EDIT2
         STRING FUNCTION TRIM(WS-EDIT) FUNCTION TRIM(WS-EDIT2) " " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     END-PERFORM
     MOVE "00 00 10 10 11 " TO TL-EXPECTED
     PERFORM CHECK

     GOBACK.

 CHECK.
     MOVE WS-TEXT TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 ROUNDTRIP.
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     CALL "BE-SAVE" USING WS-SRC WS-FORM PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE 0 TO PB-POS
     CALL "BE-LOAD" USING WS-IDX PB-BUFFER
     CALL "PB-FREE" USING PB-BUFFER.

*> Saves entity WS-IDX in form WS-FORM and appends the rendered compound to WS-TEXT.
 SAVE-RENDER.
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     CALL "BE-SAVE" USING WS-IDX WS-FORM PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE 0 TO PB-POS
     MOVE 0 TO WS-LEN
     MOVE SPACES TO WS-OUT
     CALL "TEST-NBT-RENDER" USING PB-BUFFER WS-TYPE10 WS-OUT WS-LEN
     CALL "PB-FREE" USING PB-BUFFER
     STRING WS-OUT(1:WS-LEN) " " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR.
 END PROGRAM TEST-BE-31-2-5.

 COPY CORETEST.
