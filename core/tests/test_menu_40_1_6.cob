*> Test of 40-1 section 6 (The table schema for the other parts; T0999): the menu slot count (own slots + 36) and the MenuType id of every menu of this part (M1, M2).)
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-MENU-40-1-6.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY BESTATE.
 COPY PROTO.
 01 WS-TEXT                PIC X(8192).
 01 WS-EDIT                PIC -(9)9.
 01 WS-EDIT2               PIC -(9)9.
 01 WS-EDIT3               PIC -(9)9.
 01 WS-EDIT4               PIC -(9)9.
 01 WS-I                   BINARY-LONG.
 01 WS-LEN                 BINARY-LONG.
 01 WS-IDX                 BINARY-LONG.
 01 WS-CAPACITY            BINARY-LONG VALUE 4096.
 01 WS-ZERO                BINARY-LONG VALUE 0.
 01 WS-TYPE10              BINARY-LONG VALUE 10.
 01 WS-E1 PIC -(9)9.
 01 WS-E2 PIC -(9)9.
 01 WS-E3 PIC -(9)9.
 01 WS-E4 PIC -(9)9.
 01 WS-E5 PIC -(9)9.
 01 WS-E6 PIC -(9)9.
 01 WS-E7 PIC -(9)9.
 01 WS-E8 PIC -(9)9.
 01 WS-E9 PIC -(9)9.
 01 WS-E10 PIC -(9)9.
 01 WS-E11 PIC -(9)9.
 01 WS-E12 PIC -(9)9.
 01 WS-A BINARY-LONG.
 01 WS-B BINARY-LONG.
 01 WS-C BINARY-LONG.
 01 WS-D BINARY-LONG.
 01 WS-F BINARY-LONG.
 01 WS-G BINARY-LONG.
 01 WS-H BINARY-LONG.
 01 WS-J BINARY-LONG.
 01 WS-K BINARY-LONG.
 01 WS-K32 PIC X(32).
 01 WS-KEY2 PIC X(32).
 01 WS-L BINARY-LONG.
 01 WS-PTR BINARY-LONG.
 PROCEDURE DIVISION.
     MOVE "acceptance US12 40-1§6 table schema: slot counts: chest rows 1 to 6 give 45 54 63 72 81 90; shulker 63; hopper 41; dispenser 45" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     MOVE 1 TO WS-A
     MOVE 1 TO WS-B
     CALL "MENU-OWN-SLOTS" USING WS-A WS-B WS-D WS-F
     MOVE WS-F TO WS-E1
     STRING FUNCTION TRIM(WS-E1) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 1 TO WS-A
     MOVE 2 TO WS-B
     CALL "MENU-OWN-SLOTS" USING WS-A WS-B WS-D WS-F
     MOVE WS-F TO WS-E1
     STRING FUNCTION TRIM(WS-E1) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 1 TO WS-A
     MOVE 3 TO WS-B
     CALL "MENU-OWN-SLOTS" USING WS-A WS-B WS-D WS-F
     MOVE WS-F TO WS-E1
     STRING FUNCTION TRIM(WS-E1) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 1 TO WS-A
     MOVE 4 TO WS-B
     CALL "MENU-OWN-SLOTS" USING WS-A WS-B WS-D WS-F
     MOVE WS-F TO WS-E1
     STRING FUNCTION TRIM(WS-E1) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 1 TO WS-A
     MOVE 5 TO WS-B
     CALL "MENU-OWN-SLOTS" USING WS-A WS-B WS-D WS-F
     MOVE WS-F TO WS-E1
     STRING FUNCTION TRIM(WS-E1) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 1 TO WS-A
     MOVE 6 TO WS-B
     CALL "MENU-OWN-SLOTS" USING WS-A WS-B WS-D WS-F
     MOVE WS-F TO WS-E1
     STRING FUNCTION TRIM(WS-E1) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 2 TO WS-A
     MOVE 0 TO WS-B
     CALL "MENU-OWN-SLOTS" USING WS-A WS-B WS-D WS-F
     MOVE WS-F TO WS-E1
     STRING FUNCTION TRIM(WS-E1) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 3 TO WS-A
     MOVE 0 TO WS-B
     CALL "MENU-OWN-SLOTS" USING WS-A WS-B WS-D WS-F
     MOVE WS-F TO WS-E1
     STRING FUNCTION TRIM(WS-E1) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 4 TO WS-A
     MOVE 0 TO WS-B
     CALL "MENU-OWN-SLOTS" USING WS-A WS-B WS-D WS-F
     MOVE WS-F TO WS-E1
     STRING FUNCTION TRIM(WS-E1) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE '45 | 54 | 63 | 72 | 81 | 90 | 63 | 41 | 45 |' TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 40-1§6 table schema: menu type ids: chest rows 1, 3, 6 give 0, 2, 5; shulker 20; hopper 16; dispenser 6" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     MOVE 1 TO WS-A
     MOVE 1 TO WS-B
     CALL "MENU-TYPE-OF" USING WS-A WS-B WS-D
     MOVE WS-D TO WS-E1
     STRING FUNCTION TRIM(WS-E1) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 1 TO WS-A
     MOVE 3 TO WS-B
     CALL "MENU-TYPE-OF" USING WS-A WS-B WS-D
     MOVE WS-D TO WS-E1
     STRING FUNCTION TRIM(WS-E1) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 1 TO WS-A
     MOVE 6 TO WS-B
     CALL "MENU-TYPE-OF" USING WS-A WS-B WS-D
     MOVE WS-D TO WS-E1
     STRING FUNCTION TRIM(WS-E1) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 2 TO WS-A
     MOVE 0 TO WS-B
     CALL "MENU-TYPE-OF" USING WS-A WS-B WS-D
     MOVE WS-D TO WS-E1
     STRING FUNCTION TRIM(WS-E1) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 3 TO WS-A
     MOVE 0 TO WS-B
     CALL "MENU-TYPE-OF" USING WS-A WS-B WS-D
     MOVE WS-D TO WS-E1
     STRING FUNCTION TRIM(WS-E1) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 4 TO WS-A
     MOVE 0 TO WS-B
     CALL "MENU-TYPE-OF" USING WS-A WS-B WS-D
     MOVE WS-D TO WS-E1
     STRING FUNCTION TRIM(WS-E1) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE '0 | 2 | 5 | 20 | 16 | 6 |' TO TL-EXPECTED
     PERFORM CHECK

     GOBACK.

 CHECK.
     MOVE "T" TO TL-MODE
     MOVE WS-TEXT TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-MENU-40-1-6.

 COPY CORETEST.
