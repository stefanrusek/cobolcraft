*> Implementation test (002-lane-mobsa3; 44 part 4 section 12): brushing an armadillo. A brush on an adult that is not rolled up drops one scute; a scared or baby armadillo fails.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-MOB-19-13-BRUSH.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY CONTENT.
 COPY BRWORLD.
 COPY STDMOBS.
 COPY RULES.
 01 WS-PLAYER              BINARY-LONG.
 01 WS-KEY                 PIC X(112).
 01 WS-ENTITY-ROW          PIC X(66).
 01 WS-ITEM-ROW            PIC X(270).
 01 WS-STATUS              BINARY-LONG.
 01 WS-TYPE                BINARY-LONG.
 01 WS-ZTYPE               BINARY-LONG.
 01 WS-A                   BINARY-LONG.
 01 WS-Z                   BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-N                   BINARY-LONG.
 01 WS-N0                  BINARY-LONG.
 01 WS-J                   BINARY-LONG.
 01 WS-DIM                 BINARY-LONG.
 01 WS-X0                  BINARY-LONG.
 01 WS-Z0                  BINARY-LONG.
 01 WS-FLOOR               BINARY-LONG VALUE 40.
 01 WS-SIZE                BINARY-LONG VALUE 48.
 01 WS-STONE               BINARY-LONG VALUE 1.
 01 WS-PX                  FLOAT-LONG.
 01 WS-PZ                  FLOAT-LONG.
 01 WS-Y                   FLOAT-LONG.
 01 WS-X                   FLOAT-LONG.
 01 WS-YAW                 FLOAT-SHORT VALUE 0.
 01 WS-SCUTE               BINARY-LONG.
 01 WS-AMOUNT              BINARY-LONG.
 01 WS-CAUSE               BINARY-LONG.
 01 WS-NO                  BINARY-LONG VALUE 0.
 01 WS-BABY                BINARY-LONG.
 01 WS-WOOL                BINARY-LONG.
 01 WS-NEEDED              BINARY-LONG.
 01 WS-BRUSH               BINARY-LONG.
 01 WS-BRUSH-ROW           PIC X(270).
 PROCEDURE DIVISION.
     CALL "MS-TEST-OPEN" USING WS-PLAYER
     MOVE PL-DIM(WS-PLAYER) TO WS-DIM
     COMPUTE WS-X0 = FUNCTION INTEGER(PL-X(WS-PLAYER)) - 24
     COMPUTE WS-Z0 = FUNCTION INTEGER(PL-Z(WS-PLAYER)) - 24
     CALL "MS-TEST-FLOOR" USING WS-DIM WS-X0 WS-Z0 WS-SIZE WS-FLOOR WS-STONE
     COMPUTE PL-X(WS-PLAYER) = WS-X0 + 24.5
     COMPUTE PL-Y(WS-PLAYER) = WS-FLOOR + 1
     COMPUTE PL-Z(WS-PLAYER) = WS-Z0 + 24.5
     MOVE PL-X(WS-PLAYER) TO WS-PX
     MOVE PL-Z(WS-PLAYER) TO WS-PZ
     COMPUTE WS-Y = WS-FLOOR + 1
     MOVE 6000 TO CW-TIME
     MOVE 2 TO BW-DIFFICULTY
     MOVE "minecraft:armadillo" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-TYPE WS-ENTITY-ROW WS-STATUS
     MOVE "minecraft:zombie" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-ZTYPE WS-ENTITY-ROW WS-STATUS
     MOVE "minecraft:armadillo_scute" TO WS-KEY
     CALL "CONTENT-ITEM-BY-KEY" USING WS-KEY WS-SCUTE WS-ITEM-ROW WS-STATUS
     MOVE "N" TO TL-MODE
     MOVE 0 TO PL-SPRINTING(WS-PLAYER)

     MOVE "minecraft:brush" TO WS-KEY
     CALL "CONTENT-ITEM-BY-KEY" USING WS-KEY WS-BRUSH WS-BRUSH-ROW WS-STATUS
     MOVE WS-BRUSH TO PL-SLOT-ITEM(WS-PLAYER, PL-HELD(WS-PLAYER) + 1)
     MOVE 1 TO PL-SLOT-COUNT(WS-PLAYER, PL-HELD(WS-PLAYER) + 1)
     COMPUTE WS-X = WS-PX + 4
     CALL "MOB-SPAWN" USING WS-DIM WS-TYPE WS-X WS-Y WS-PZ WS-YAW WS-A
     PERFORM COUNT-SCUTES
     MOVE WS-N TO WS-N0
     CALL "MOB-ARMADILLO-BRUSH" USING WS-PLAYER WS-A
     PERFORM COUNT-SCUTES
     MOVE "acceptance US15 44-4§12 Armadillo: a brush on an idle adult drops one scute" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-N - WS-N0
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 2 TO EN-ARMA(WS-A)
     MOVE WS-N TO WS-N0
     CALL "MOB-ARMADILLO-BRUSH" USING WS-PLAYER WS-A
     PERFORM COUNT-SCUTES
     MOVE "acceptance US15 44-4§12 Armadillo: a scared armadillo fails to be brushed" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-N - WS-N0
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 0 TO EN-ARMA(WS-A)
     MOVE 1 TO EN-VARIANT(WS-A)
     MOVE -24000 TO EN-MOBAGE(WS-A)
     MOVE WS-N TO WS-N0
     CALL "MOB-ARMADILLO-BRUSH" USING WS-PLAYER WS-A
     PERFORM COUNT-SCUTES
     MOVE "acceptance US15 44-4§12 Armadillo: a baby is not brushed" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-N - WS-N0
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 COUNT-SCUTES.
     MOVE 0 TO WS-N
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > EN-COUNT
         IF EN-USED(WS-J) = 1 AND EN-ITEM(WS-J) = WS-SCUTE AND EN-ITEM-COUNT(WS-J) > 0
             ADD EN-ITEM-COUNT(WS-J) TO WS-N
         END-IF
     END-PERFORM.
 END PROGRAM TEST-MOB-19-13-BRUSH.
 COPY CORETEST.
 COPY MOBSPTEST.
