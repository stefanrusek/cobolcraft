*> Acceptance test (002-lane-p49b; docs/protocol/20 sections 13.3 to 13.6): illager and ravager rules the older tests do not hold. Evoker: avoids a survival player (8.0, speeds
*> 0.6 / 1.0, 1.0 within 7 blocks) and a creaking (same numbers); drops a totem of undying always (fixtures entities/evoker.json). Illusioner: avoids a creaking (1.0 / 1.2) and holds a
*> bow. Vex: holds an iron sword and copies the target of its owner. Ravager: takes an iron golem as a foe (must see, follow range 32), its speed lerps by 0.1 towards 0.35 with a
*> target (0.3 without), it drops a saddle (fixtures entities/ravager.json). Not here (named in the lane report): the vex's flight and random-move goal (no flying speed in the documents),
*> the owner-less magic bite, leaf destruction (no collision flag), the evoker's wololo gating, the illusioner copies on the client.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-MOB-20-13-ILLAGERS.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY CONTENT.
 COPY STDMOBS.
 COPY BRWORLD.
 COPY XORO.
 COPY EVKSTATE.
 01 WS-PLAYER              BINARY-LONG.
 01 WS-KEY                 PIC X(112).
 01 WS-ENTITY-ROW          PIC X(66).
 01 WS-ITEM-ROW            PIC X(270).
 01 WS-STATUS              BINARY-LONG.
 01 WS-EVOKER-TYPE         BINARY-LONG.
 01 WS-ILLUSIONER-TYPE     BINARY-LONG.
 01 WS-VEX-TYPE            BINARY-LONG.
 01 WS-RAVAGER-TYPE        BINARY-LONG.
 01 WS-CREAKING-TYPE       BINARY-LONG.
 01 WS-GOLEM-TYPE          BINARY-LONG.
 01 WS-TOTEM               BINARY-LONG.
 01 WS-SADDLE              BINARY-LONG.
 01 WS-EVOKER              BINARY-LONG.
 01 WS-ILLUSIONER          BINARY-LONG.
 01 WS-VEX                 BINARY-LONG.
 01 WS-RAVAGER             BINARY-LONG.
 01 WS-CREAKING            BINARY-LONG.
 01 WS-GOLEM               BINARY-LONG.
 01 WS-M                   BINARY-LONG.
 01 WS-DIM                 BINARY-LONG.
 01 WS-X                   FLOAT-LONG.
 01 WS-Y                   FLOAT-LONG.
 01 WS-Z                   FLOAT-LONG.
 01 WS-X0                  FLOAT-LONG.
 01 WS-YAW                 FLOAT-SHORT VALUE 0.
 01 WS-I                   BINARY-LONG.
 01 WS-E                   BINARY-LONG.
 01 WS-FX                  BINARY-LONG.
 01 WS-FZ                  BINARY-LONG.
 01 WS-FY                  BINARY-LONG.
 01 WS-FSIZE               BINARY-LONG VALUE 40.
 01 WS-FKIND               BINARY-LONG VALUE 1.
 01 WS-SEED                BINARY-DOUBLE UNSIGNED VALUE 5.
 01 WS-LOOT-DIR            PIC X(1100) VALUE "core/tests/fixtures/stdmob-loot".
 01 WS-AMOUNT              BINARY-LONG VALUE 1000.
 01 WS-CAUSE-FALL          BINARY-LONG VALUE 1.
 01 WS-NO-PLAYER           BINARY-LONG VALUE 0.
 01 WS-HX                  FLOAT-LONG.
 01 WS-HZ                  FLOAT-LONG.
 01 WS-AVOID               BINARY-LONG.
 01 WS-MILLI               BINARY-LONG.
 01 WS-WALK                FLOAT-LONG.
 01 WS-SPEED               FLOAT-LONG.
 01 WS-COUNT               BINARY-LONG.
 01 WS-HEALTH              BINARY-LONG.
 01 WS-KEY40               PIC X(40).
 01 WS-SLOT                BINARY-LONG.
 01 WS-ONE                 BINARY-LONG VALUE 1.
 01 WS-W                   BINARY-LONG.
 PROCEDURE DIVISION.
     CALL "MS-TEST-OPEN" USING WS-PLAYER
     CALL "LOOT-LOAD" USING WS-LOOT-DIR WS-STATUS
     MOVE PL-DIM(WS-PLAYER) TO WS-DIM
     MOVE "N" TO TL-MODE
     MOVE "minecraft:evoker" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-EVOKER-TYPE WS-ENTITY-ROW WS-STATUS
     MOVE "minecraft:illusioner" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-ILLUSIONER-TYPE WS-ENTITY-ROW WS-STATUS
     MOVE "minecraft:vex" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-VEX-TYPE WS-ENTITY-ROW WS-STATUS
     MOVE "minecraft:ravager" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-RAVAGER-TYPE WS-ENTITY-ROW WS-STATUS
     MOVE "minecraft:creaking" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-CREAKING-TYPE WS-ENTITY-ROW WS-STATUS
     MOVE "minecraft:iron_golem" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-GOLEM-TYPE WS-ENTITY-ROW WS-STATUS
     MOVE "minecraft:totem_of_undying" TO WS-KEY
     CALL "CONTENT-ITEM-BY-KEY" USING WS-KEY WS-TOTEM WS-ITEM-ROW WS-STATUS
     MOVE "minecraft:saddle" TO WS-KEY
     CALL "CONTENT-ITEM-BY-KEY" USING WS-KEY WS-SADDLE WS-ITEM-ROW WS-STATUS
     MOVE PL-X(WS-PLAYER) TO WS-X
     MOVE PL-Y(WS-PLAYER) TO WS-Y
     MOVE PL-Z(WS-PLAYER) TO WS-Z
     COMPUTE WS-FX = FUNCTION INTEGER(WS-X) - 20
     COMPUTE WS-FZ = FUNCTION INTEGER(WS-Z) - 20
     COMPUTE WS-FY = FUNCTION INTEGER(WS-Y) - 1
     CALL "MS-TEST-FLOOR" USING WS-DIM WS-FX WS-FZ WS-FSIZE WS-FY WS-FKIND

*>   Evoker avoids a survival player within 8 blocks: 1.0 of its speed within 7 blocks, 0.6 beyond; a creative player is no threat.
     COMPUTE WS-X0 = WS-X - 5
     CALL "MOB-SPAWN" USING WS-DIM WS-EVOKER-TYPE WS-X0 WS-Y WS-Z WS-YAW WS-EVOKER
     CALL "STDMOB-INDEX" USING WS-EVOKER-TYPE WS-M
     COMPUTE WS-WALK = SM-WALK-MILLI(WS-M) / 1000
     CALL "STDMOB-ILLAGER-AVOID" USING WS-EVOKER WS-M WS-HX WS-HZ WS-AVOID
     MOVE "acceptance US15 20§13.3 Evoker flees a player 5 blocks away at 1.0" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF WS-AVOID = 1 AND WS-HX < 0
         COMPUTE WS-MILLI ROUNDED = WS-HX * -1000 / WS-WALK
         IF WS-MILLI = 1000
             MOVE 1 TO TL-OBSERVED-N
         END-IF
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     COMPUTE EN-X(WS-EVOKER) = WS-X - 7.5
     CALL "STDMOB-ILLAGER-AVOID" USING WS-EVOKER WS-M WS-HX WS-HZ WS-AVOID
     MOVE "acceptance US15 20§13.3 Evoker flees a player 7.5 blocks away at 0.6" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF WS-AVOID = 1
         COMPUTE WS-MILLI ROUNDED = WS-HX * -1000 / WS-WALK
         IF WS-MILLI = 600
             MOVE 1 TO TL-OBSERVED-N
         END-IF
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     COMPUTE EN-X(WS-EVOKER) = WS-X - 9
     CALL "STDMOB-ILLAGER-AVOID" USING WS-EVOKER WS-M WS-HX WS-HZ WS-AVOID
     MOVE "acceptance US15 20§13.3 Evoker does not flee a player 9 blocks away" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-AVOID TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     COMPUTE EN-X(WS-EVOKER) = WS-X - 5
     MOVE 1 TO PL-MODE(WS-PLAYER)
     CALL "STDMOB-ILLAGER-AVOID" USING WS-EVOKER WS-M WS-HX WS-HZ WS-AVOID
     MOVE "acceptance US15 20§13.3 Evoker does not flee a creative player" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-AVOID TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   A creaking 5 blocks east of it: it flees west at 1.0.
     COMPUTE WS-X0 = WS-X - 5 + 5
     CALL "MOB-SPAWN" USING WS-DIM WS-CREAKING-TYPE WS-X0 WS-Y WS-Z WS-YAW WS-CREAKING
     CALL "STDMOB-ILLAGER-AVOID" USING WS-EVOKER WS-M WS-HX WS-HZ WS-AVOID
     MOVE "acceptance US15 20§13.3 Evoker flees a creaking away from it at 1.0 within 7 blocks" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF WS-AVOID = 1 AND WS-HX < 0
         COMPUTE WS-MILLI ROUNDED = WS-HX * -1000 / WS-WALK
         IF WS-MILLI = 1000
             MOVE 1 TO TL-OBSERVED-N
         END-IF
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 0 TO PL-MODE(WS-PLAYER)
     CALL "ENTITY-REMOVE" USING WS-EVOKER

*>   Illusioner: bow in hand, avoids a creaking at 1.2 within 7 blocks and 1.0 beyond.
     COMPUTE WS-X0 = WS-X - 10
     CALL "MOB-SPAWN" USING WS-DIM WS-ILLUSIONER-TYPE WS-X0 WS-Y WS-Z WS-YAW WS-ILLUSIONER
     CALL "XORO-SEED" USING WS-SEED XR-STATE
     CALL "STDMOB-FINALIZE" USING XR-STATE WS-ILLUSIONER
     MOVE "acceptance US15 20§13.5 Illusioner holds a bow" TO TL-CASE
     MOVE 4 TO TL-EXPECTED-N
     MOVE EN-HAND(WS-ILLUSIONER) TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "STDMOB-INDEX" USING WS-ILLUSIONER-TYPE WS-M
     COMPUTE WS-WALK = SM-WALK-MILLI(WS-M) / 1000
     COMPUTE EN-X(WS-CREAKING) = WS-X0 + 5
     CALL "STDMOB-ILLAGER-AVOID" USING WS-ILLUSIONER WS-M WS-HX WS-HZ WS-AVOID
     MOVE "acceptance US15 20§13.5 Illusioner flees a creaking 5 blocks away at 1.2" TO TL-CASE
     MOVE 1200 TO TL-EXPECTED-N
     COMPUTE WS-MILLI ROUNDED = WS-HX * -1000 / WS-WALK
     MOVE WS-MILLI TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     COMPUTE EN-X(WS-CREAKING) = WS-X0 + 7.5
     CALL "STDMOB-ILLAGER-AVOID" USING WS-ILLUSIONER WS-M WS-HX WS-HZ WS-AVOID
     MOVE "acceptance US15 20§13.5 Illusioner flees a creaking 7.5 blocks away at 1.0" TO TL-CASE
     MOVE 1000 TO TL-EXPECTED-N
     COMPUTE WS-MILLI ROUNDED = WS-HX * -1000 / WS-WALK
     MOVE WS-MILLI TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "ENTITY-REMOVE" USING WS-CREAKING
     CALL "ENTITY-REMOVE" USING WS-ILLUSIONER

*>   Vex: iron sword in hand; it copies the target of its owner.
     COMPUTE WS-X0 = WS-X - 10
     CALL "MOB-SPAWN" USING WS-DIM WS-EVOKER-TYPE WS-X0 WS-Y WS-Z WS-YAW WS-EVOKER
     CALL "MOB-SPAWN" USING WS-DIM WS-VEX-TYPE WS-X0 WS-Y WS-Z WS-YAW WS-VEX
     CALL "XORO-SEED" USING WS-SEED XR-STATE
     CALL "STDMOB-FINALIZE" USING XR-STATE WS-VEX
     MOVE "acceptance US15 20§13.4 Vex holds an iron sword" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE EN-HAND(WS-VEX) TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > VX-MAX
         IF VX-ID(WS-I) = 0 AND WS-SLOT = 0
             MOVE WS-I TO WS-SLOT
         END-IF
     END-PERFORM
     MOVE EN-ID(WS-VEX) TO VX-ID(WS-SLOT)
     MOVE EN-ID(WS-EVOKER) TO VX-OWNER(WS-SLOT)
     MOVE 600 TO VX-LIFE(WS-SLOT)
     MOVE 0 TO VX-CHARGING(WS-SLOT)
     MOVE WS-PLAYER TO EN-TARGET(WS-EVOKER)
     MOVE PL-ENTITY-ID(WS-PLAYER) TO EN-TARGET-ID(WS-EVOKER)
     MOVE 0 TO EN-TARGET(WS-VEX) EN-TARGET-ID(WS-VEX)
     CALL "VEX-STEP" USING WS-VEX
     MOVE "acceptance US15 20§13.4 Vex copies its owner's target" TO TL-CASE
     MOVE WS-PLAYER TO TL-EXPECTED-N
     MOVE EN-TARGET(WS-VEX) TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 0 TO VX-ID(WS-SLOT)
     CALL "ENTITY-REMOVE" USING WS-VEX

*>   Evoker drops a totem of undying always, killed by a player or not.
     MOVE 0 TO WS-COUNT
     CALL "HEALTH-MOB-DAMAGE" USING WS-EVOKER WS-AMOUNT WS-CAUSE-FALL WS-NO-PLAYER
     PERFORM VARYING WS-E FROM 1 BY 1 UNTIL WS-E > EN-COUNT
         IF EN-USED(WS-E) = 1 AND EN-ITEM(WS-E) = WS-TOTEM
             ADD EN-ITEM-COUNT(WS-E) TO WS-COUNT
         END-IF
     END-PERFORM
     MOVE "acceptance US15 20§13.3 Evoker drops one totem of undying" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE WS-COUNT TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

*>   Ravager: an iron golem within 32 blocks in sight is a foe, walked to and hit.
     COMPUTE WS-X0 = WS-X - 10
     CALL "MOB-SPAWN" USING WS-DIM WS-RAVAGER-TYPE WS-X0 WS-Y WS-Z WS-YAW WS-RAVAGER
     CALL "STDMOB-INDEX" USING WS-RAVAGER-TYPE WS-M
     MOVE 1 TO PL-MODE(WS-PLAYER)
     COMPUTE WS-X0 = WS-X - 10 + 8
     CALL "MOB-SPAWN" USING WS-DIM WS-GOLEM-TYPE WS-X0 WS-Y WS-Z WS-YAW WS-GOLEM
     MOVE EN-HEALTH(WS-GOLEM) TO WS-HEALTH
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 100
         COMPUTE EN-X(WS-GOLEM) = WS-X0
         MOVE 0 TO EN-VX(WS-GOLEM) EN-VZ(WS-GOLEM)
         CALL "MOB-STEP" USING WS-RAVAGER
     END-PERFORM
     MOVE "acceptance US15 20§13.6 Ravager walks to an iron golem and hits it" TO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE "hit" TO TL-EXPECTED
     MOVE "no" TO TL-OBSERVED
     IF EN-HEALTH(WS-GOLEM) < WS-HEALTH
         MOVE "hit" TO TL-OBSERVED
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "N" TO TL-MODE
     CALL "ENTITY-REMOVE" USING WS-GOLEM

*>   Speed: lerps 0.1 towards 0.35 with a target, 0.3 without. A fresh ravager has 0.3 (squared / 0.454 = 198).
     CALL "ENTITY-REMOVE" USING WS-RAVAGER
     CALL "MOB-SPAWN" USING WS-DIM WS-RAVAGER-TYPE WS-X0 WS-Y WS-Z WS-YAW WS-RAVAGER
     MOVE 0 TO EN-TARGET(WS-RAVAGER) EN-TARGET-ID(WS-RAVAGER)
     CALL "RAVAGER-STEP" USING WS-RAVAGER WS-AVOID
     CALL "STDMOB-SPEED" USING WS-RAVAGER WS-M WS-SPEED
     COMPUTE WS-MILLI ROUNDED = WS-SPEED * 1000
     MOVE "acceptance US15 20§13.6 Ravager without a target keeps speed 0.3" TO TL-CASE
     MOVE 198 TO TL-EXPECTED-N
     MOVE WS-MILLI TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 1 TO PL-MODE(WS-PLAYER)
     MOVE WS-PLAYER TO EN-TARGET(WS-RAVAGER)
     CALL "RAVAGER-STEP" USING WS-RAVAGER WS-AVOID
     CALL "STDMOB-SPEED" USING WS-RAVAGER WS-M WS-SPEED
     COMPUTE WS-MILLI ROUNDED = WS-SPEED * 1000
     MOVE "acceptance US15 20§13.6 Ravager speed after 1 tick with a target is 0.305" TO TL-CASE
     MOVE 205 TO TL-EXPECTED-N
     MOVE WS-MILLI TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 29
         CALL "RAVAGER-STEP" USING WS-RAVAGER WS-AVOID
     END-PERFORM
     CALL "STDMOB-SPEED" USING WS-RAVAGER WS-M WS-SPEED
     COMPUTE WS-MILLI ROUNDED = WS-SPEED * 1000
     MOVE "acceptance US15 20§13.6 Ravager speed after 30 ticks approaches 0.35" TO TL-CASE
     MOVE 267 TO TL-EXPECTED-N
     MOVE WS-MILLI TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 0 TO EN-TARGET(WS-RAVAGER)
     CALL "RAVAGER-STEP" USING WS-RAVAGER WS-AVOID
     CALL "STDMOB-SPEED" USING WS-RAVAGER WS-M WS-SPEED
     COMPUTE WS-MILLI ROUNDED = WS-SPEED * 1000
     MOVE "acceptance US15 20§13.6 Ravager speed falls back towards 0.3 without a target" TO TL-CASE
     MOVE 259 TO TL-EXPECTED-N
     MOVE WS-MILLI TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

*>   Ravager drops one saddle.
     MOVE 0 TO WS-COUNT
     CALL "HEALTH-MOB-DAMAGE" USING WS-RAVAGER WS-AMOUNT WS-CAUSE-FALL WS-NO-PLAYER
     PERFORM VARYING WS-E FROM 1 BY 1 UNTIL WS-E > EN-COUNT
         IF EN-USED(WS-E) = 1 AND EN-ITEM(WS-E) = WS-SADDLE
             ADD EN-ITEM-COUNT(WS-E) TO WS-COUNT
         END-IF
     END-PERFORM
     MOVE "acceptance US15 20§13.6 Ravager drops one saddle" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE WS-COUNT TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.
 END PROGRAM TEST-MOB-20-13-ILLAGERS.
 COPY CORETEST.
 COPY MOBSPTEST.
