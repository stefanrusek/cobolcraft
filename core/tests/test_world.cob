*> Implementation test of the per-dimension chunk cache and block access (core/src/world.cob;
*> data-model §2, §3): a chunk is generated on first access and lit when asked for whole, blocks are
*> read and written by world position (negative coordinates included), positions outside the
*> dimension's height range read as void and are not written, a change sets the changed flag and keeps
*> the per-section light source counts, the hash index chains colliding chunks, rows above the
*> high-water mark are reused, and reopening the world frees the cache.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-WORLD.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY COREAPI.
 COPY DIMENSIONS.
 01 WS-DIM                 BINARY-LONG VALUE 1.
 01 WS-CX                  BINARY-LONG.
 01 WS-CZ                  BINARY-LONG.
 01 WS-X                   BINARY-LONG.
 01 WS-Y                   BINARY-LONG.
 01 WS-Z                   BINARY-LONG.
 01 WS-STATE               BINARY-LONG.
 01 WS-ROW                 BINARY-LONG.
 01 WS-ROW2                BINARY-LONG.
 01 WS-COUNT               BINARY-LONG.
 01 WS-NUM                 BINARY-LONG.
 01 WS-EDIT                PIC -(9)9.
 01 WS-TEXT                PIC X(1024).
 01 WS-PTR                 BINARY-LONG.
 PROCEDURE DIVISION.
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS

     MOVE "test world chunk cache generates and lights a chunk on first access, generating its 8 neighbours"
         TO TL-CASE
     MOVE 0 TO WS-CX WS-CZ
     CALL "WORLD-CHUNK" USING WS-DIM WS-CX WS-CZ WS-ROW
     PERFORM START-ROW
     MOVE WS-ROW TO WS-NUM PERFORM ADD-NUM
     MOVE CK-COUNT TO WS-NUM PERFORM ADD-NUM
     MOVE CK-USED(WS-ROW) TO WS-NUM PERFORM ADD-NUM
     MOVE CK-LIT(WS-ROW) TO WS-NUM PERFORM ADD-NUM
     MOVE CK-DIM(WS-ROW) TO WS-NUM PERFORM ADD-NUM
     MOVE CK-X(WS-ROW) TO WS-NUM PERFORM ADD-NUM
     MOVE CK-Z(WS-ROW) TO WS-NUM PERFORM ADD-NUM
     MOVE CK-CHANGED(WS-ROW) TO WS-NUM PERFORM ADD-NUM
     MOVE "1 9 1 1 1 0 0 0" TO TL-EXPECTED
     PERFORM ASSERT-ROW

     MOVE "test world chunk cache returns the cached row on the next access" TO TL-CASE
     COMPUTE WS-COUNT = CK-COUNT
     CALL "WORLD-CHUNK" USING WS-DIM WS-CX WS-CZ WS-ROW
     PERFORM START-ROW
     MOVE WS-ROW TO WS-NUM PERFORM ADD-NUM
     COMPUTE WS-NUM = CK-COUNT - WS-COUNT PERFORM ADD-NUM
     MOVE "1 0" TO TL-EXPECTED
     PERFORM ASSERT-ROW

     MOVE "test world get block by position, negative coordinates included" TO TL-CASE
     PERFORM START-ROW
     MOVE 8 TO WS-X MOVE 59 TO WS-Y MOVE 8 TO WS-Z PERFORM GET-NUM
     MOVE 4 TO WS-X MOVE 53 TO WS-Y MOVE 8 TO WS-Z PERFORM GET-NUM
     MOVE -36 TO WS-X MOVE 46 TO WS-Y MOVE 0 TO WS-Z PERFORM GET-NUM
     MOVE -36 TO WS-X MOVE 47 TO WS-Y MOVE -1 TO WS-Z PERFORM GET-NUM
     MOVE -1 TO WS-X MOVE 0 TO WS-Y MOVE -16 TO WS-Z PERFORM GET-NUM
     MOVE "13 4 5 0 1" TO TL-EXPECTED
     PERFORM ASSERT-ROW

     MOVE "test world get block loads a chunk without lighting it" TO TL-CASE
     MOVE -3 TO WS-CX
     MOVE 0 TO WS-CZ
     CALL "WORLD-FIND" USING WS-DIM WS-CX WS-CZ WS-ROW
     PERFORM START-ROW
     MOVE CK-USED(WS-ROW) TO WS-NUM PERFORM ADD-NUM
     MOVE CK-LIT(WS-ROW) TO WS-NUM PERFORM ADD-NUM
     MOVE "1 0" TO TL-EXPECTED
     PERFORM ASSERT-ROW

     MOVE "test world height range: y -1 and 256 read as void and are not written" TO TL-CASE
     COMPUTE WS-COUNT = CK-COUNT
     PERFORM START-ROW
     MOVE 300 TO WS-X MOVE -1 TO WS-Y MOVE 300 TO WS-Z PERFORM GET-NUM
     MOVE 256 TO WS-Y PERFORM GET-NUM
     MOVE 12 TO WS-STATE
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-X WS-Y WS-Z WS-STATE
     MOVE -1 TO WS-Y
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-X WS-Y WS-Z WS-STATE
     COMPUTE WS-NUM = CK-COUNT - WS-COUNT PERFORM ADD-NUM
     MOVE 255 TO WS-Y PERFORM GET-NUM
     MOVE 0 TO WS-Y PERFORM GET-NUM
     MOVE "0 0 0 0 1" TO TL-EXPECTED
     PERFORM ASSERT-ROW

     MOVE "test world set block by position sets the changed flag" TO TL-CASE
     MOVE 0 TO WS-CX WS-CZ
     CALL "WORLD-FIND" USING WS-DIM WS-CX WS-CZ WS-ROW
     PERFORM START-ROW
     MOVE CK-CHANGED(WS-ROW) TO WS-NUM PERFORM ADD-NUM
     MOVE 3 TO WS-X MOVE 70 TO WS-Y MOVE 3 TO WS-Z
     MOVE 15 TO WS-STATE
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-X WS-Y WS-Z WS-STATE
     PERFORM GET-NUM
     MOVE CK-CHANGED(WS-ROW) TO WS-NUM PERFORM ADD-NUM
     MOVE -1 TO WS-X MOVE 60 TO WS-Y MOVE -1 TO WS-Z
     MOVE 11 TO WS-STATE
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-X WS-Y WS-Z WS-STATE
     PERFORM GET-NUM
     MOVE -1 TO WS-CX WS-CZ
     CALL "WORLD-FIND" USING WS-DIM WS-CX WS-CZ WS-ROW2
     MOVE CK-CHANGED(WS-ROW2) TO WS-NUM PERFORM ADD-NUM
     MOVE CK-LIT(WS-ROW2) TO WS-NUM PERFORM ADD-NUM
     MOVE "0 15 1 11 1 1" TO TL-EXPECTED
     PERFORM ASSERT-ROW

     MOVE "test world setting a block to its own state changes nothing" TO TL-CASE
     MOVE 80 TO WS-X MOVE 10 TO WS-Y MOVE 80 TO WS-Z
     MOVE 2 TO WS-STATE
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-X WS-Y WS-Z WS-STATE
     MOVE 5 TO WS-CX WS-CZ
     CALL "WORLD-FIND" USING WS-DIM WS-CX WS-CZ WS-ROW2
     PERFORM START-ROW
     MOVE CK-CHANGED(WS-ROW2) TO WS-NUM PERFORM ADD-NUM
     MOVE CK-LIT(WS-ROW2) TO WS-NUM PERFORM ADD-NUM
     MOVE "0 1" TO TL-EXPECTED
     PERFORM ASSERT-ROW

     MOVE "test world light source counts per section follow block changes" TO TL-CASE
     PERFORM START-ROW
     MOVE CK-SOURCES(WS-ROW, 4) TO WS-NUM PERFORM ADD-NUM
     MOVE CK-SOURCES(WS-ROW, 5) TO WS-NUM PERFORM ADD-NUM
     MOVE 3 TO WS-X MOVE 70 TO WS-Y MOVE 3 TO WS-Z
     MOVE 13 TO WS-STATE
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-X WS-Y WS-Z WS-STATE
     MOVE CK-SOURCES(WS-ROW, 5) TO WS-NUM PERFORM ADD-NUM
     MOVE 16 TO WS-STATE
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-X WS-Y WS-Z WS-STATE
     MOVE CK-SOURCES(WS-ROW, 5) TO WS-NUM PERFORM ADD-NUM
     MOVE 14 TO WS-STATE
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-X WS-Y WS-Z WS-STATE
     MOVE CK-SOURCES(WS-ROW, 5) TO WS-NUM PERFORM ADD-NUM
     MOVE "1 0 1 1 0" TO TL-EXPECTED
     PERFORM ASSERT-ROW

     MOVE "test world hash index chains chunks of the same bucket" TO TL-CASE
     MOVE 4096 TO WS-CX
     MOVE 0 TO WS-CZ
     CALL "WORLD-CHUNK-LOAD" USING WS-DIM WS-CX WS-CZ WS-ROW2
     MOVE 0 TO WS-CX
     CALL "WORLD-FIND" USING WS-DIM WS-CX WS-CZ WS-NUM
     PERFORM START-ROW
     COMPUTE WS-NUM = WS-NUM - WS-ROW PERFORM ADD-NUM
     MOVE 4096 TO WS-CX
     CALL "WORLD-FIND" USING WS-DIM WS-CX WS-CZ WS-NUM
     COMPUTE WS-NUM = WS-NUM - WS-ROW2 PERFORM ADD-NUM
     MOVE 8192 TO WS-CX
     CALL "WORLD-FIND" USING WS-DIM WS-CX WS-CZ WS-NUM
     PERFORM ADD-NUM
     MOVE 77 TO WS-CX WS-CZ
     CALL "WORLD-FIND" USING WS-DIM WS-CX WS-CZ WS-NUM
     PERFORM ADD-NUM
     MOVE "0 0 0 0" TO TL-EXPECTED
     PERFORM ASSERT-ROW

     MOVE "test world reuses a free row once the high-water mark is at the maximum" TO TL-CASE
     COMPUTE WS-COUNT = CK-COUNT
     MOVE CORE-MAX-CHUNKS TO CK-COUNT
     MOVE 50 TO WS-CX WS-CZ
     CALL "WORLD-CHUNK-LOAD" USING WS-DIM WS-CX WS-CZ WS-ROW2
     MOVE WS-ROW2 TO CK-COUNT
     PERFORM START-ROW
     COMPUTE WS-NUM = WS-ROW2 - WS-COUNT PERFORM ADD-NUM
     MOVE CK-X(WS-ROW2) TO WS-NUM PERFORM ADD-NUM
     MOVE "1 50" TO TL-EXPECTED
     PERFORM ASSERT-ROW

     MOVE "test world reopening the world frees and empties the chunk cache" TO TL-CASE
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     PERFORM START-ROW
     MOVE CK-COUNT TO WS-NUM PERFORM ADD-NUM
     MOVE 3 TO WS-X MOVE 70 TO WS-Y MOVE 3 TO WS-Z PERFORM GET-NUM
     MOVE CK-COUNT TO WS-NUM PERFORM ADD-NUM
     MOVE "0 0 1" TO TL-EXPECTED
     PERFORM ASSERT-ROW
     STOP RUN.

 GET-NUM.
     CALL "WORLD-GET-BLOCK" USING WS-DIM WS-X WS-Y WS-Z WS-STATE
     MOVE WS-STATE TO WS-NUM
     PERFORM ADD-NUM.

 START-ROW.
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR.

 ADD-NUM.
     MOVE WS-NUM TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) " " DELIMITED BY SIZE INTO WS-TEXT POINTER WS-PTR.

 ASSERT-ROW.
     MOVE "T" TO TL-MODE
     MOVE WS-TEXT TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-WORLD.

 COPY CORETEST.
