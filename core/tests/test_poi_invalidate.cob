*> Implementation test (vanfmt lane; docs/protocol/07 section 10.6): the core does not track points of interest, so when it saves a
*> chunk of a world in the 26.3 layout (CW-LAYOUT 1) the chunk's poi/ payload is rewritten with every section marked not valid
*> (`Valid` 0, the records kept as they are): the game then rescans those sections from the blocks when it loads them. In the
*> CobolCraft layout the poi/ file is not touched.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-POI-INVALIDATE.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY COREAPI.
 COPY DIMENSIONS.
 COPY PROTO.
 01 WS-CAPACITY            BINARY-LONG VALUE 65536.
 01 WS-DIM                 BINARY-LONG.
 01 WS-CX                  BINARY-LONG VALUE 4.
 01 WS-CZ                  BINARY-LONG VALUE 5.
 01 WS-ROW                 BINARY-LONG.
 01 WS-POI                 PIC X(8) VALUE "poi".
 01 WS-DIR                 PIC X(1024).
 01 WS-LENGTH              BINARY-LONG.
 01 WS-OUTCOME             BINARY-LONG.
 01 WS-FRAMING             BINARY-LONG VALUE 1.
 01 WS-TYPE                BINARY-LONG.
 01 WS-ROOT                BINARY-LONG.
 01 WS-PATH                PIC X(128).
 01 WS-OBSERVED            PIC X(8192).
 01 WS-ONE                 PIC X(8192).
 01 WN                     PIC X(32).
 01 WL                     BINARY-LONG.
 01 WS-ELEMENT             BINARY-LONG VALUE -1.
 01 WS-COMPOUND            BINARY-LONG VALUE 10.
 01 WS-ONE-COUNT           BINARY-LONG VALUE 1.
 01 WS-THREE-COUNT         BINARY-LONG VALUE 3.
 01 WS-DATA-VERSION        BINARY-LONG VALUE 5023.
 01 WS-VALID               BINARY-LONG VALUE 1.
 01 WS-TICKETS             BINARY-LONG VALUE 1.
 01 WS-TEXT                PIC X(16) VALUE "minecraft:bed".
 01 WS-TEXT-LENGTH         BINARY-LONG VALUE 13.
 01 WS-POS.
    05 WS-POS-INT          BINARY-LONG OCCURS 3 TIMES.
 01 WS-COMMAND             PIC X(200).
 PROCEDURE DIVISION.
     MOVE "T" TO TL-MODE
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     MOVE DIM-MAIN TO WS-DIM
     MOVE 1 TO WS-POS-INT(1)
     MOVE 2 TO WS-POS-INT(2)
     MOVE 3 TO WS-POS-INT(3)
     CALL "WORLD-CHUNK" USING WS-DIM WS-CX WS-CZ WS-ROW
     CALL "PERSIST-DIRS"
     CALL "PERSIST-DIM-DIR" USING WS-DIM WS-POI WS-DIR WS-LENGTH
     MOVE SPACES TO WS-COMMAND
     STRING "mkdir -p " WS-DIR(1:WS-LENGTH) DELIMITED BY SIZE INTO WS-COMMAND
     CALL "SYSTEM" USING WS-COMMAND
     PERFORM WRITE-POI
*>   Layout 0: untouched.
     MOVE 0 TO CW-LAYOUT
     CALL "PERSIST-CHUNK-SAVE" USING WS-ROW
     PERFORM READ-BACK
     MOVE SPACES TO WS-OBSERVED
     MOVE "Sections.3.Valid" TO WS-PATH PERFORM ADD-GET
     MOVE "test poi invalidate in the CobolCraft layout the poi file is not touched" TO TL-CASE
     MOVE "1" TO TL-EXPECTED
     PERFORM CHECK
*>   Layout 1: every section not valid, records kept.
     MOVE 1 TO CW-LAYOUT
     CALL "PERSIST-CHUNK-SAVE" USING WS-ROW
     PERFORM READ-BACK
     MOVE SPACES TO WS-OBSERVED
     MOVE "Sections.3.Valid" TO WS-PATH PERFORM ADD-GET
     MOVE "Sections.3.Records" TO WS-PATH PERFORM ADD-GET
     MOVE "Sections.4.Valid" TO WS-PATH PERFORM ADD-GET
     MOVE "DataVersion" TO WS-PATH PERFORM ADD-GET
     MOVE "test poi invalidate in the 26.3 layout a saved chunk's poi sections are not valid and keep their records" TO TL-CASE
     MOVE "0 [{pos:I[1,2,3],type:minecraft:bed,free_tickets:1}] 0 5023" TO TL-EXPECTED
     PERFORM CHECK
*>   A chunk with no poi payload: nothing is created.
     MOVE 6 TO WS-CX
     CALL "WORLD-CHUNK" USING WS-DIM WS-CX WS-CZ WS-ROW
     CALL "PERSIST-CHUNK-SAVE" USING WS-ROW
     PERFORM READ-BACK
     MOVE "test poi invalidate a chunk with no poi payload gets none" TO TL-CASE
     MOVE "1" TO TL-EXPECTED
     MOVE WS-OUTCOME TO TL-OBSERVED-N
     MOVE SPACES TO TL-OBSERVED
     IF WS-OUTCOME = 1
         MOVE "1" TO TL-OBSERVED
     ELSE
         MOVE "0" TO TL-OBSERVED
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

*> The poi chunk (4, 5): sections 3 and 4, both valid, section 3 with one record.
 WRITE-POI.
     CALL "PB-RESET" USING PB-BUFFER
     MOVE SPACES TO WN
     MOVE 0 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     MOVE "DataVersion" TO WN MOVE 11 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL WS-DATA-VERSION
     MOVE "Sections" TO WN MOVE 8 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     MOVE "3" TO WN MOVE 1 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     MOVE "Valid" TO WN MOVE 5 TO WL
     CALL "NBT-WRITE-BYTE" USING PB-BUFFER WN WL WS-VALID
     MOVE "Records" TO WN MOVE 7 TO WL
     CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WN WL WS-COMPOUND WS-ONE-COUNT
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WS-ELEMENT
     MOVE "pos" TO WN MOVE 3 TO WL
     CALL "NBT-WRITE-INT-ARRAY" USING PB-BUFFER WN WL WS-THREE-COUNT WS-POS
     MOVE "type" TO WN MOVE 4 TO WL
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WN WL WS-TEXT WS-TEXT-LENGTH
     MOVE "free_tickets" TO WN MOVE 12 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL WS-TICKETS
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "NBT-WRITE-LIST-END" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE "4" TO WN MOVE 1 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     MOVE "Valid" TO WN MOVE 5 TO WL
     CALL "NBT-WRITE-BYTE" USING PB-BUFFER WN WL WS-VALID
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE "junk" TO WN MOVE 4 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL WS-TICKETS
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "REGION-WRITE" USING WS-DIR WS-LENGTH WS-CX WS-CZ PB-BUFFER WS-OUTCOME.

 READ-BACK.
     CALL "PERSIST-DIM-DIR" USING WS-DIM WS-POI WS-DIR WS-LENGTH
     CALL "REGION-READ" USING WS-DIR WS-LENGTH WS-CX WS-CZ PB-BUFFER WS-OUTCOME
     MOVE -1 TO WS-ROOT
     IF WS-OUTCOME = 0
         CALL "NBT-READ-ROOT" USING PB-BUFFER WS-FRAMING WS-TYPE
         MOVE PB-POS TO WS-ROOT
     END-IF.

 ADD-GET.
     CALL "TEST-NBT-GET" USING PB-BUFFER WS-ROOT WS-PATH WS-ONE
     STRING FUNCTION TRIM(WS-OBSERVED) " " FUNCTION TRIM(WS-ONE) DELIMITED BY SIZE INTO WS-OBSERVED.

 CHECK.
     MOVE FUNCTION TRIM(WS-OBSERVED) TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-POI-INVALIDATE.

 COPY CORETEST.
