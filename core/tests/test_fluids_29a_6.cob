 01 WS-TEXTS.
    05 WS-T1               PIC X(96).
    05 WS-T2               PIC X(96).
 PROCEDURE DIVISION.
     MOVE "T" TO TL-MODE
     MOVE "acceptance US12 29a§6 Bubble columns: a full water source schedules a block tick after 20 ticks when magma block or soul sand is below; flowing water, a partial level or another block below" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "2 8 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-SCHEDULE" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "2 8 2" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-SCHEDULE" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "2 8 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-SCHEDULE" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 8 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-SCHEDULE" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "2 7 2" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-SCHEDULE" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "4 8 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-SCHEDULE" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "20 20 0 0 0 0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29a§6 Bubble columns: column state: soul sand pushes up, magma block drags, a column below copies its state, anything else is plain water" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-COLUMN" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "2" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-COLUMN" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "3" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-COLUMN" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "4" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-COLUMN" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-COLUMN" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1/0 1/1 1/0 1/1 0/0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29a§6 Bubble columns: an entity is at the surface when the cell above has an empty collision shape and no fluid" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-SURFACE" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-SURFACE" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-SURFACE" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-SURFACE" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 0 0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29a§6 Bubble columns: velocity: above the column drag floors at -0.9 and push caps at 1.8, inside the column the floor is -0.3 and the cap 0.7; projectiles have no cap; a flying" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1 1 0 0 1 1 -0.5" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-VELOCITY" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-FX7 WS-RF1 WS-R2 WS-R3
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000000
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 0 0 1 1 -0.89" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-VELOCITY" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-FX7 WS-RF1 WS-R2 WS-R3
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000000
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 0 0 1 1 0.0" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-VELOCITY" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-FX7 WS-RF1 WS-R2 WS-R3
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000000
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 0 0 1 1 1.75" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-VELOCITY" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-FX7 WS-RF1 WS-R2 WS-R3
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000000
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "2 1 0 0 1 0 -0.28" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-VELOCITY" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-FX7 WS-RF1 WS-R2 WS-R3
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000000
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "2 1 0 0 1 0 0.0" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-VELOCITY" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-FX7 WS-RF1 WS-R2 WS-R3
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000000
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "2 0 0 0 1 0 0.0" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-VELOCITY" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-FX7 WS-RF1 WS-R2 WS-R3
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000000
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "2 0 0 0 1 0 0.68" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-VELOCITY" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-FX7 WS-RF1 WS-R2 WS-R3
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000000
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 1 1 1 1 -0.5" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-VELOCITY" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-FX7 WS-RF1 WS-R2 WS-R3
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000000
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "2 0 1 1 1 0 0.2" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-VELOCITY" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-FX7 WS-RF1 WS-R2 WS-R3
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000000
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 1 0 1 1 0.3" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-VELOCITY" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-FX7 WS-RF1 WS-R2 WS-R3
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000000
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 2 0 1 1 -1.5" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-VELOCITY" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-FX7 WS-RF1 WS-R2 WS-R3
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000000
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 2 0 1 1 1.9" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-VELOCITY" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-FX7 WS-RF1 WS-R2 WS-R3
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000000
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "2 1 2 0 1 0 -1.0" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-VELOCITY" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-FX7 WS-RF1 WS-R2 WS-R3
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000000
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "2 0 2 0 1 0 0.9" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-VELOCITY" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-FX7 WS-RF1 WS-R2 WS-R3
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000000
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "2 0 0 0 0 0 0.2" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-VELOCITY" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-FX7 WS-RF1 WS-R2 WS-R3
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000000
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 0 0 0 1 0.3" TO WS-IN
     PERFORM LOAD-IN
     CALL "BB-VELOCITY" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-FX7 WS-RF1 WS-R2 WS-R3
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000000
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "-530000/0/2 -900000/0/2 100000/0/2 1800000/0/2 -300000/1/0 -30000/1/0 60000/1/0 700000/1/0 -500000/0/0 200000/0/0 400000/0/2 -1530000/0/2 2000000/0/2 -1030000/1/0 960000/1/0 200000/1/0 300000/0/2" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 BEGIN-CASE.
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR
     .

 LOAD-IN.
     MOVE 1 TO WS-P
     PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 16
         MOVE SPACES TO WS-TOK
         IF WS-P <= 160
             UNSTRING WS-IN DELIMITED BY ALL SPACE INTO WS-TOK WITH POINTER WS-P
         END-IF
         COMPUTE WS-FX(WS-K) = FUNCTION NUMVAL(WS-TOK)
         COMPUTE WS-I(WS-K) = FUNCTION NUMVAL(WS-TOK)
     END-PERFORM
     .

 ADD-N.
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N
         MOVE WS-R(WS-J) TO WS-SHOW
         IF WS-J > 1
             STRING "/" DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
         END-IF
         STRING FUNCTION TRIM(WS-SHOW) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-PERFORM
     STRING " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .

 ADD-TEXT.
     STRING FUNCTION TRIM(WS-T1) "|" FUNCTION TRIM(WS-T2) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .
 END PROGRAM TEST-FLUIDS-29A-6.
