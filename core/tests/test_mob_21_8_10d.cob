*> Spawn eggs of the mobs lane p49f built (docs/protocol/18 section 6.12, 25-6 spawn egg items; lane p49o, T36060): the bat and the happy ghast spawn eggs, used on a block (TOOLUSE-ON), create the mob of the
*> species in the cell beside the face with its full health, send it to the player who stands there, and are used up in survival; the item key `<species>_spawn_egg` names the entity type `minecraft:<species>`.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-MOB-21-8-10D.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CORESTATE.
 COPY CONTENT.
 COPY BESTATE.
 COPY PLAYPKT.
 COPY PROTO.
 01 WS-PLAYER              BINARY-LONG.
 01 WS-CONN                BINARY-LONG.
 01 WS-DIM                 BINARY-LONG.
 01 WS-KEY                 PIC X(112).
 01 WS-ENTITY-ROW          PIC X(66).
 01 WS-ITEM-ROW            PIC X(270).
 01 WS-STATUS              BINARY-LONG.
 01 WS-ITEM                BINARY-LONG.
 01 WS-TYPE                BINARY-LONG.
 01 WS-K                   BINARY-LONG.
 01 WS-NAMES.
    05 FILLER              PIC X(32) VALUE "bat".
    05 FILLER              PIC X(32) VALUE "happy_ghast".
 01 WS-NAME-TABLE REDEFINES WS-NAMES.
    05 WS-NAME             PIC X(32) OCCURS 2 TIMES.
 01 WS-SPECIES             PIC X(32).
 01 WS-LEN                 BINARY-LONG.
 01 WS-DONE                BINARY-LONG.
 01 WS-COUNT               BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-J                   BINARY-LONG.
 01 WS-FOUND               BINARY-LONG.
 01 WS-X                   FLOAT-LONG.
 01 WS-Y                   FLOAT-LONG.
 01 WS-Z                   FLOAT-LONG.
 01 WS-BX                  BINARY-LONG.
 01 WS-BY                  BINARY-LONG.
 01 WS-BZ                  BINARY-LONG.
 01 WS-CASE                PIC X(100).
 01 WS-EXP                 BINARY-LONG.
 01 WS-OBS                 BINARY-LONG.
 01 WS-SIZE                BINARY-LONG VALUE 40.
 01 WS-FX                  BINARY-LONG.
 01 WS-FZ                  BINARY-LONG.
 01 WS-FY                  BINARY-LONG.
 01 WS-STONE-KIND          BINARY-LONG VALUE 1.
 01 WS-BE                 BINARY-LONG.
 01 WS-SPAWNER-STATE       BINARY-LONG.
 01 WS-HELD                BINARY-LONG.
 PROCEDURE DIVISION.
     CALL "MS-TEST-OPEN" USING WS-PLAYER
     MOVE PL-DIM(WS-PLAYER) TO WS-DIM
     MOVE PL-X(WS-PLAYER) TO WS-X
     MOVE PL-Y(WS-PLAYER) TO WS-Y
     MOVE PL-Z(WS-PLAYER) TO WS-Z
     COMPUTE WS-FX = FUNCTION INTEGER(WS-X) - 20
     COMPUTE WS-FZ = FUNCTION INTEGER(WS-Z) - 20
     COMPUTE WS-FY = FUNCTION INTEGER(WS-Y) - 1
     CALL "MS-TEST-FLOOR" USING WS-DIM WS-FX WS-FZ WS-SIZE WS-FY WS-STONE-KIND
     MOVE 0 TO WS-CONN
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > CORE-MAX-CONNS
         IF CN-PLAYER(WS-I) = WS-PLAYER
             MOVE WS-I TO WS-CONN
         END-IF
     END-PERFORM
     MOVE PL-HELD(WS-PLAYER) TO WS-HELD
     COMPUTE WS-BX = FUNCTION INTEGER(WS-X) + 3
     MOVE WS-FY TO WS-BY
     MOVE FUNCTION INTEGER(WS-Z) TO WS-BZ
     MOVE 0 TO PSB-HAND
     MOVE WS-BX TO PSB-BX
     MOVE WS-BY TO PSB-BY
     MOVE WS-BZ TO PSB-BZ
     MOVE 1 TO PSB-FACE
     MOVE 0 TO PL-MODE(WS-PLAYER)
     PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 2
         MOVE WS-NAME(WS-K) TO WS-SPECIES
         COMPUTE WS-LEN = FUNCTION LENGTH(FUNCTION TRIM(WS-SPECIES))
         MOVE SPACES TO WS-KEY
         STRING "minecraft:" WS-SPECIES(1:WS-LEN) DELIMITED BY SIZE INTO WS-KEY
         CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-TYPE WS-ENTITY-ROW WS-STATUS
         MOVE SPACES TO WS-KEY
         STRING "minecraft:" WS-SPECIES(1:WS-LEN) "_spawn_egg" DELIMITED BY SIZE INTO WS-KEY
         CALL "CONTENT-ITEM-BY-KEY" USING WS-KEY WS-ITEM WS-ITEM-ROW WS-STATUS
         MOVE WS-ITEM TO PL-SLOT-ITEM(WS-PLAYER, WS-HELD + 1)
         MOVE 2 TO PL-SLOT-COUNT(WS-PLAYER, WS-HELD + 1)
         CALL "TOOLUSE-ON" USING WS-CONN PLAY-SERVERBOUND WS-DONE
         PERFORM FIND-MOB
         MOVE SPACES TO WS-CASE
         STRING "acceptance US15 18§6.12 the " WS-SPECIES(1:WS-LEN) " spawn egg creates the mob" DELIMITED BY SIZE INTO WS-CASE
         MOVE 1 TO WS-EXP
         MOVE WS-COUNT TO WS-OBS
         CALL "TEST-CHK" USING WS-CASE WS-EXP WS-OBS
         MOVE SPACES TO WS-CASE
         STRING "acceptance US15 18§6.12 the " WS-SPECIES(1:WS-LEN) " egg use is handled" DELIMITED BY SIZE INTO WS-CASE
         MOVE 1 TO WS-EXP
         MOVE WS-DONE TO WS-OBS
         CALL "TEST-CHK" USING WS-CASE WS-EXP WS-OBS
         MOVE SPACES TO WS-CASE
         STRING "acceptance US15 18§6.12 the " WS-SPECIES(1:WS-LEN) " stands at the cell centre (x, tenths)" DELIMITED BY SIZE INTO WS-CASE
         COMPUTE WS-EXP = WS-BX * 10 + 5
         COMPUTE WS-OBS = FUNCTION INTEGER(EN-X(WS-FOUND) * 10 + 0.5)
         CALL "TEST-CHK" USING WS-CASE WS-EXP WS-OBS
         MOVE SPACES TO WS-CASE
         STRING "acceptance US15 18§6.12 the " WS-SPECIES(1:WS-LEN) " is sent to the player" DELIMITED BY SIZE INTO WS-CASE
         MOVE 1 TO WS-EXP
         MOVE 0 TO WS-OBS
         IF VW-SEEN(WS-PLAYER)(WS-FOUND:1) = "1"
             MOVE 1 TO WS-OBS
         END-IF
         CALL "TEST-CHK" USING WS-CASE WS-EXP WS-OBS
         MOVE SPACES TO WS-CASE
         STRING "acceptance US15 18§6.12 the " WS-SPECIES(1:WS-LEN) " egg is used up in survival" DELIMITED BY SIZE INTO WS-CASE
         MOVE 1 TO WS-EXP
         MOVE PL-SLOT-COUNT(WS-PLAYER, WS-HELD + 1) TO WS-OBS
         CALL "TEST-CHK" USING WS-CASE WS-EXP WS-OBS
         CALL "ENTITY-REMOVE" USING WS-FOUND
     END-PERFORM
     STOP RUN.
 FIND-MOB.
     MOVE 0 TO WS-COUNT WS-FOUND
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > EN-COUNT
         IF EN-USED(WS-I) = 1 AND EN-TYPE(WS-I) = WS-TYPE
             ADD 1 TO WS-COUNT
             MOVE WS-I TO WS-FOUND
         END-IF
     END-PERFORM.
 END PROGRAM TEST-MOB-21-8-10D.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-CHK.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 LINKAGE SECTION.
 01 L-CASE                 PIC X(100).
 01 L-EXPECTED             BINARY-LONG.
 01 L-OBSERVED             BINARY-LONG.
 PROCEDURE DIVISION USING L-CASE L-EXPECTED L-OBSERVED.
     MOVE "N" TO TL-MODE
     MOVE L-CASE TO TL-CASE
     MOVE L-EXPECTED TO TL-EXPECTED-N
     MOVE L-OBSERVED TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     GOBACK.
 END PROGRAM TEST-CHK.
 COPY CORETEST.
 COPY MOBSPTEST.
