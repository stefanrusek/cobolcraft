*> Implementation test (lane 002-lane-mobsb3, T8105): the POI index of villagers. The scan of a loaded chunk finds a bed, a bell and a workstation in 24 section steps; the nearest free
*> point of a kind within range is found, a claimed bed is skipped and a bell takes 32 tickets; a point whose block was removed is dropped when it is looked up.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-MOB-VIL-INDEX.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY VILPOIX.
 01 WS-PLAYER              BINARY-LONG.
 01 WS-PAIRS               PIC X(160) VALUE SPACES.
 01 WS-QX                  BINARY-LONG.
 01 WS-QY                  BINARY-LONG.
 01 WS-QZ                  BINARY-LONG.
 01 WS-KEY                 PIC X(112).
 01 WS-STATE               BINARY-LONG.
 01 WS-AIR                 BINARY-LONG VALUE 0.
 01 WS-BX                  BINARY-LONG.
 01 WS-BY                  BINARY-LONG.
 01 WS-BZ                  BINARY-LONG.
 01 WS-CX                  BINARY-LONG.
 01 WS-CZ                  BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-DIM                 BINARY-LONG.
 01 WS-OX                  BINARY-LONG.
 01 WS-OY                  BINARY-LONG.
 01 WS-OZ                  BINARY-LONG.
 01 WS-FOUND               BINARY-LONG.
 01 WS-KIND                BINARY-LONG.
 01 WS-RANGE               BINARY-LONG VALUE 48.
 01 WS-K1                  BINARY-LONG VALUE 1.
 01 WS-K2                  BINARY-LONG VALUE 2.
 01 WS-K3                  BINARY-LONG VALUE 3.
 01 WS-K23                 BINARY-LONG VALUE 3.
 01 WS-HOME                BINARY-LONG VALUE 2.
 01 WS-MEET                BINARY-LONG VALUE 3.
 01 WS-OWNER               BINARY-LONG.
 01 WS-N                   BINARY-LONG.
 PROCEDURE DIVISION.
     CALL "MS-TEST-OPEN" USING WS-PLAYER
     MOVE "N" TO TL-MODE
     MOVE PL-DIM(WS-PLAYER) TO WS-DIM
     COMPUTE WS-BX = FUNCTION INTEGER(PL-X(WS-PLAYER)) + 2
     COMPUTE WS-BY = FUNCTION INTEGER(PL-Y(WS-PLAYER))
     COMPUTE WS-BZ = FUNCTION INTEGER(PL-Z(WS-PLAYER))
     MOVE "minecraft:red_bed" TO WS-KEY
     MOVE "facing=north,occupied=false,part=head" TO WS-PAIRS
     CALL "BLOCKS-STATE-OF" USING WS-KEY WS-PAIRS WS-STATE
     MOVE SPACES TO WS-PAIRS
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-BX WS-BY WS-BZ WS-STATE
     CALL "PXI-KIND-OF" USING WS-DIM WS-BX WS-BY WS-BZ WS-KIND
     MOVE "acceptance US15 19§22.3 a bed block is of kind 1" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE WS-KIND TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     ADD 2 TO WS-BY
     MOVE "minecraft:bell" TO WS-KEY
     CALL "BLOCKS-STATE-OF" USING WS-KEY WS-PAIRS WS-STATE
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-BX WS-BY WS-BZ WS-STATE
     CALL "PXI-KIND-OF" USING WS-DIM WS-BX WS-BY WS-BZ WS-KIND
     MOVE "acceptance US15 19§22.3 a bell block is of kind 2" TO TL-CASE
     MOVE 2 TO TL-EXPECTED-N
     MOVE WS-KIND TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     ADD 2 TO WS-BY
     MOVE "minecraft:lectern" TO WS-KEY
     CALL "BLOCKS-STATE-OF" USING WS-KEY WS-PAIRS WS-STATE
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-BX WS-BY WS-BZ WS-STATE
     CALL "PXI-KIND-OF" USING WS-DIM WS-BX WS-BY WS-BZ WS-KIND
     MOVE "acceptance US15 19§22.7 a lectern is of kind 3" TO TL-CASE
     MOVE 3 TO TL-EXPECTED-N
     MOVE WS-KIND TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     *>   Scan the chunk of the player: 24 section steps.
     COMPUTE WS-CX = FUNCTION INTEGER(PL-X(WS-PLAYER) / 16)
     COMPUTE WS-CZ = FUNCTION INTEGER(PL-Z(WS-PLAYER) / 16)
     MOVE 0 TO PX-DONE-N
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 23
         CALL "PXI-SCAN" USING WS-DIM WS-CX WS-CZ
     END-PERFORM
     MOVE "acceptance US15 19§22.7 the chunk is not done after 23 section steps" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE PX-DONE-N TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "PXI-SCAN" USING WS-DIM WS-CX WS-CZ
     MOVE "acceptance US15 19§22.7 the chunk is done after 24" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE PX-DONE-N TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "PXI-SCAN" USING WS-DIM WS-CX WS-CZ
     MOVE "acceptance US15 19§22.7 a done chunk is not scanned again" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE PX-DONE-N TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   Lookups.
     COMPUTE WS-OX = FUNCTION INTEGER(PL-X(WS-PLAYER))
     COMPUTE WS-OY = FUNCTION INTEGER(PL-Y(WS-PLAYER))
     COMPUTE WS-OZ = FUNCTION INTEGER(PL-Z(WS-PLAYER))
     CALL "PXI-NEAREST" USING WS-DIM WS-OX WS-OY WS-OZ WS-K1 WS-RANGE WS-BX WS-BY WS-BZ WS-FOUND
     MOVE "acceptance US15 19§22.7 the bed is found within 48 blocks" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE WS-FOUND TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 501 TO WS-OWNER
     CALL "VPX-CLAIM" USING WS-OWNER WS-HOME WS-DIM WS-BX WS-BY WS-BZ
     CALL "PXI-NEAREST" USING WS-DIM WS-OX WS-OY WS-OZ WS-K1 WS-RANGE WS-BX WS-BY WS-BZ WS-FOUND
     MOVE "acceptance US15 19§22.8 a claimed bed is skipped (one ticket)" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-FOUND TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "PXI-NEAREST" USING WS-DIM WS-OX WS-OY WS-OZ WS-K2 WS-RANGE WS-BX WS-BY WS-BZ WS-FOUND
     MOVE "acceptance US15 19§22.3 the bell is found" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE WS-FOUND TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     PERFORM VARYING WS-OWNER FROM 601 BY 1 UNTIL WS-OWNER > 631
         CALL "VPX-CLAIM" USING WS-OWNER WS-MEET WS-DIM WS-BX WS-BY WS-BZ
     END-PERFORM
     CALL "PXI-NEAREST" USING WS-DIM WS-OX WS-OY WS-OZ WS-K2 WS-RANGE WS-BX WS-BY WS-BZ WS-FOUND
     MOVE "acceptance US15 19§22.7 a bell with 31 claims still has a ticket" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE WS-FOUND TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 632 TO WS-OWNER
     CALL "VPX-CLAIM" USING WS-OWNER WS-MEET WS-DIM WS-BX WS-BY WS-BZ
     CALL "PXI-NEAREST" USING WS-DIM WS-OX WS-OY WS-OZ WS-K2 WS-RANGE WS-BX WS-BY WS-BZ WS-FOUND
     MOVE "acceptance US15 19§22.7 a bell with 32 claims is full" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-FOUND TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 501 TO WS-OWNER
     CALL "VPX-OF" USING WS-OWNER WS-HOME WS-DIM WS-QX WS-QY WS-QZ WS-FOUND
     MOVE "acceptance US15 19§22.8 the home claim of the villager is found" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE WS-FOUND TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "VP-RELEASE" USING WS-OWNER
     CALL "VPX-OF" USING WS-OWNER WS-HOME WS-DIM WS-QX WS-QY WS-QZ WS-FOUND
     MOVE "acceptance US15 22.5 the claims go with the villager" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-FOUND TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   A broken lectern is dropped from the index when it is looked up.
     COMPUTE WS-BX = FUNCTION INTEGER(PL-X(WS-PLAYER)) + 2
     COMPUTE WS-BZ = FUNCTION INTEGER(PL-Z(WS-PLAYER))
     COMPUTE WS-BY = FUNCTION INTEGER(PL-Y(WS-PLAYER)) + 4
     CALL "PXI-NEAREST" USING WS-DIM WS-OX WS-OY WS-OZ WS-K3 WS-RANGE WS-QX WS-QY WS-QZ WS-FOUND
     MOVE "acceptance US15 19§22.7 the workstation is found" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE WS-FOUND TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-BX WS-BY WS-BZ WS-AIR
     COMPUTE WS-OX = FUNCTION INTEGER(PL-X(WS-PLAYER))
     COMPUTE WS-OY = FUNCTION INTEGER(PL-Y(WS-PLAYER))
     COMPUTE WS-OZ = FUNCTION INTEGER(PL-Z(WS-PLAYER))
     CALL "PXI-NEAREST" USING WS-DIM WS-OX WS-OY WS-OZ WS-K3 WS-RANGE WS-BX WS-BY WS-BZ WS-FOUND
     MOVE "acceptance US15 19§22.7 a removed workstation is no longer found (validated)" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-FOUND TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.
 END PROGRAM TEST-MOB-VIL-INDEX.
 COPY CORETEST.
 COPY MOBSPTEST.
