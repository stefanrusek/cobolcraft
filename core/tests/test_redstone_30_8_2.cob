 PROCEDURE DIVISION.
     MOVE "T" TO TL-MODE
     MOVE "acceptance US12 30-8§2 The game-event dispatch these blocks use: section range (2.1 item 3): per axis from blockToSectionCoord(B - r) to blockToSectionCoord(B + r), an arithmetic shift right by" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0 16" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-SECTION-RANGE" USING WS-I1 WS-I2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-SECTION-RANGE" USING WS-I1 WS-I2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "15 16" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-SECTION-RANGE" USING WS-I1 WS-I2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "16 16" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-SECTION-RANGE" USING WS-I1 WS-I2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "17 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-SECTION-RANGE" USING WS-I1 WS-I2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "-1 16" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-SECTION-RANGE" USING WS-I1 WS-I2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "-17 16" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-SECTION-RANGE" USING WS-I1 WS-I2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "100 32" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-SECTION-RANGE" USING WS-I1 WS-I2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "-100 10" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-SECTION-RANGE" USING WS-I1 WS-I2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "-1/1 0/0 -1/1 0/2 1/1 -2/0 -3/-1 4/8 -7/-6" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 30-8§2 The game-event dispatch these blocks use: notification radius (2.1): 16 for every event except jukebox_play and jukebox_stop_play (10) and shriek (32)" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     MOVE "step" TO WS-NM
     CALL "RS3-EVENT-RADIUS" USING WS-NM WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     MOVE "block_activate" TO WS-NM
     CALL "RS3-EVENT-RADIUS" USING WS-NM WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     MOVE "jukebox_play" TO WS-NM
     CALL "RS3-EVENT-RADIUS" USING WS-NM WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     MOVE "jukebox_stop_play" TO WS-NM
     CALL "RS3-EVENT-RADIUS" USING WS-NM WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     MOVE "shriek" TO WS-NM
     CALL "RS3-EVENT-RADIUS" USING WS-NM WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     MOVE "explode" TO WS-NM
     CALL "RS3-EVENT-RADIUS" USING WS-NM WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "16 16 10 10 32 16" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 30-8§2 The game-event dispatch these blocks use: in range (2.1 item 4): the block distance squared between the listener and the event is at most the listener radius squared; the" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "8 0 0 8" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-LISTENER-IN-RANGE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "9 0 0 8" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-LISTENER-IN-RANGE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "5 5 5 8" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-LISTENER-IN-RANGE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "6 6 0 8" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-LISTENER-IN-RANGE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "6 6 3 8" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-LISTENER-IN-RANGE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 16 0 16" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-LISTENER-IN-RANGE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 17 16" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-LISTENER-IN-RANGE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "11 11 0 16" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-LISTENER-IN-RANGE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 0 0 0 1 0 1" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 30-8§2 The game-event dispatch these blocks use: delivery (2.1 item 5): a BY_DISTANCE listener is queued and sorted by squared distance, every other listener is called at once;" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-DELIVERY" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-DELIVERY" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 1" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 30-8§2 The game-event dispatch these blocks use: registration (2.2): a block entity listener sits in the registry of its chunk section, floor(coordinate / 16), and its position" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-LISTENER-SECTION" USING WS-I1 WS-R1
     CALL "RS3-LISTENER-CENTER" USING WS-I1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "15" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-LISTENER-SECTION" USING WS-I1 WS-R1
     CALL "RS3-LISTENER-CENTER" USING WS-I1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "16" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-LISTENER-SECTION" USING WS-I1 WS-R1
     CALL "RS3-LISTENER-CENTER" USING WS-I1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "-1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-LISTENER-SECTION" USING WS-I1 WS-R1
     CALL "RS3-LISTENER-CENTER" USING WS-I1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "-16" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-LISTENER-SECTION" USING WS-I1 WS-R1
     CALL "RS3-LISTENER-CENTER" USING WS-I1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "-17" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-LISTENER-SECTION" USING WS-I1 WS-R1
     CALL "RS3-LISTENER-CENTER" USING WS-I1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "100" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-LISTENER-SECTION" USING WS-I1 WS-R1
     CALL "RS3-LISTENER-CENTER" USING WS-I1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "0/500 0/15500 1/16500 -1/-500 -1/-15500 -2/-16500 6/100500" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 30-8§2 The game-event dispatch these blocks use: events emitted by the blocks (2.3): hook activate 10, deactivate 9, attach 10, detach 9 with no source; shear 6 with the player;" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-EMIT-ROW" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-EMIT-ROW" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "2" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-EMIT-ROW" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "3" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-EMIT-ROW" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "4" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-EMIT-ROW" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "5" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-EMIT-ROW" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "6" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-EMIT-ROW" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "7" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-EMIT-ROW" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "8" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-EMIT-ROW" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "9" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-EMIT-ROW" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "10" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-EMIT-ROW" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "11" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-EMIT-ROW" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "-1/-1 10/0 9/0 10/0 9/0 6/1 0/1 0/1 11/1 11/0 10/2 -1/-1" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 BEGIN-CASE.
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR
     .

 LOAD-IN.
     MOVE 1 TO WS-P
     PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 16
         MOVE SPACES TO WS-TOK
         IF WS-P <= 160
             UNSTRING WS-IN DELIMITED BY ALL SPACE INTO WS-TOK WITH POINTER WS-P
         END-IF
         COMPUTE WS-FX(WS-K) = FUNCTION NUMVAL(WS-TOK)
         COMPUTE WS-I(WS-K) = FUNCTION NUMVAL(WS-TOK)
     END-PERFORM
     .

 ADD-N.
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N
         MOVE WS-R(WS-J) TO WS-SHOW
         IF WS-J > 1
             STRING "/" DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
         END-IF
         STRING FUNCTION TRIM(WS-SHOW) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-PERFORM
     STRING " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .

 ADD-TEXT.
     STRING FUNCTION TRIM(WS-T1) "|" FUNCTION TRIM(WS-T2) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .
 END PROGRAM TEST-REDSTONE-30-8-2.
