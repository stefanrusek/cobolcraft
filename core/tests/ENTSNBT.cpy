*> Test helper of the entity NBT tests (test infrastructure, excluded from coverage): COPY after the test program.
*>   ENT-SNBT-V USING text (PIC X(1024)), data version (BINARY-LONG, 0 = no DataVersion key), PB-BUFFER: as ENT-SNBT with that DataVersion first.
*>   ENT-SNBT USING text (PIC X(1024)), PB-BUFFER: a chunk payload {Entities:[the entity]} whose entity compound is the SNBT text (id, Pos, ... as the
*>   NBT value tree builder reads them), ready for ENTITY-NBT-READ at PB-POS 0.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. ENT-SNBT.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-ZERO                BINARY-LONG VALUE 0.
 LINKAGE SECTION.
 01 L-TEXT                 PIC X(1024).
 COPY PROTO.
 PROCEDURE DIVISION USING L-TEXT PB-BUFFER.
     CALL "ENT-SNBT-V" USING L-TEXT WS-ZERO PB-BUFFER
     GOBACK.
 END PROGRAM ENT-SNBT.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. ENT-SNBT-V.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-START               BINARY-LONG VALUE 0.
 01 WS-END                 BINARY-LONG.
 01 WS-NODE                BINARY-LONG.
 01 WS-NAME                PIC X(32).
 01 WS-LENGTH              BINARY-LONG.
 01 WS-T-COMPOUND          BINARY-LONG VALUE 10.
 01 WS-ONE                 BINARY-LONG VALUE 1.
 LINKAGE SECTION.
 01 L-TEXT                 PIC X(1024).
 01 L-VERSION              BINARY-LONG.
 COPY PROTO.
 PROCEDURE DIVISION USING L-TEXT L-VERSION PB-BUFFER.
     COMPUTE WS-END = FUNCTION LENGTH(FUNCTION TRIM(L-TEXT TRAILING))
     CALL "NBX-PARSE" USING L-TEXT WS-START WS-END WS-NODE
     CALL "PB-RESET" USING PB-BUFFER
     MOVE SPACES TO WS-NAME
     MOVE 0 TO WS-LENGTH
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WS-NAME WS-LENGTH
     IF L-VERSION NOT = 0
         MOVE "DataVersion" TO WS-NAME
         MOVE 11 TO WS-LENGTH
         CALL "NBT-WRITE-INT" USING PB-BUFFER WS-NAME WS-LENGTH L-VERSION
     END-IF
     MOVE "Entities" TO WS-NAME
     MOVE 8 TO WS-LENGTH
     CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WS-NAME WS-LENGTH WS-T-COMPOUND WS-ONE
     CALL "NBX-TO-BUFFER" USING PB-BUFFER WS-NODE
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "NBT-WRITE-LIST-END" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "NBX-FREE" USING WS-NODE
     GOBACK.
 END PROGRAM ENT-SNBT-V.

*> PLAYER-SNBT USING text (PIC X(1024)), PB-BUFFER: a root compound whose entries are the SNBT text's entries (a player file), ready for PERSIST-WRITE-FILE.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. PLAYER-SNBT.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-START               BINARY-LONG VALUE 0.
 01 WS-END                 BINARY-LONG.
 01 WS-NODE                BINARY-LONG.
 01 WS-NAME                PIC X(32).
 01 WS-LENGTH              BINARY-LONG.
 LINKAGE SECTION.
 01 L-TEXT                 PIC X(1024).
 COPY PROTO.
 PROCEDURE DIVISION USING L-TEXT PB-BUFFER.
     COMPUTE WS-END = FUNCTION LENGTH(FUNCTION TRIM(L-TEXT TRAILING))
     CALL "NBX-PARSE" USING L-TEXT WS-START WS-END WS-NODE
     CALL "PB-RESET" USING PB-BUFFER
     MOVE SPACES TO WS-NAME
     MOVE 0 TO WS-LENGTH
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WS-NAME WS-LENGTH
     CALL "NBX-TO-BUFFER" USING PB-BUFFER WS-NODE
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "NBX-FREE" USING WS-NODE
     GOBACK.
 END PROGRAM PLAYER-SNBT.
