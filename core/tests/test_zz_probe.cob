 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-ZZ-PROBE.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY COREAPI.
 COPY CITEMPHYS.
 01 WS-NAME PIC X(16) VALUE "Alice".
 01 WS-NL BINARY-LONG VALUE 5.
 01 WS-A BINARY-LONG.
 01 WS-DIM BINARY-LONG VALUE 1.
 01 WS-X FLOAT-LONG VALUE 20.5.
 01 WS-Y FLOAT-LONG VALUE 100.
 01 WS-Z FLOAT-LONG VALUE 20.5.
 01 WS-V FLOAT-LONG VALUE 0.
 01 WS-ITEM BINARY-LONG VALUE 2.
 01 WS-COUNT BINARY-LONG VALUE 1.
 01 WS-DELAY BINARY-LONG VALUE 0.
 01 WS-ROW BINARY-LONG.
 01 WS-I BINARY-LONG.
 01 WS-ONE BINARY-LONG VALUE 1.
 01 WS-BX BINARY-LONG VALUE 20.
 01 WS-BY BINARY-LONG VALUE 98.
 01 WS-BZ BINARY-LONG VALUE 20.
 01 WS-ST BINARY-LONG VALUE 2.
 PROCEDURE DIVISION.
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     CALL "TEST-JOIN" USING WS-NAME WS-NL WS-A
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-BX WS-BY WS-BZ WS-ST
     CALL "GI-SPAWN" USING WS-DIM WS-X WS-Y WS-Z WS-V WS-V WS-V WS-ITEM WS-COUNT WS-DELAY WS-ROW
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 20
         CALL "TEST-TICKS" USING WS-ONE
     END-PERFORM
     MOVE 0 TO WS-ST
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-BX WS-BY WS-BZ WS-ST
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 8
         CALL "TEST-TICKS" USING WS-ONE
         DISPLAY WS-I " y " EN-Y(WS-ROW) " vy " EN-VY(WS-ROW) " g " EN-ON-GROUND(WS-ROW) " t " IP-I-TICKS(WS-ROW) " id " EN-ID(WS-ROW)
     END-PERFORM
     STOP RUN.
 END PROGRAM TEST-ZZ-PROBE.
 COPY CORETEST.
