*> Test of the stack patch pool (core/src/stack-patch.cob, core/copy/CSTACK.cpy; docs/protocol/00 section 12.1 and 12.2, 17 section
*> 1.1 and 1.2; T3650 to T3652): a wire stack's patch interns to a handle (equal patches share one, in any order), exports back
*> to the same wire bytes, damage, max_damage, custom_name and enchantments are read and written as their components, the
*> defaults come from the content item components, and the pool frees the entries no slot refers to when it is full.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-STACK-PATCH.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY CMENU.
 COPY CSTACK.
 COPY CONTENT.
 COPY COREAPI.
 COPY PROTO.
 COPY PROTO REPLACING LEADING ==PB-== BY ==QX-==.
 01 WS-CAPACITY            BINARY-LONG VALUE 1024.
 01 WS-PATH                PIC X(256).
 01 WS-H1                  BINARY-LONG.
 01 WS-H2                  BINARY-LONG.
 01 WS-H3                  BINARY-LONG.
 01 WS-DAMAGE              BINARY-LONG.
 01 WS-MAX                 BINARY-LONG.
 01 WS-ITEM                BINARY-LONG.
 01 WS-STONE               BINARY-LONG VALUE 1.
 01 WS-KEY                 PIC X(112).
 01 WS-ROWTEXT             PIC X(270).
 01 WS-STATUS              BINARY-LONG.
 01 WS-NAME                PIC X(64).
 01 WS-NAME-LENGTH         BINARY-LONG.
 01 WS-VALUE               PIC X(64).
 01 WS-LENGTH              BINARY-LONG.
 01 WS-FOUND               BINARY-LONG.
 01 WS-LEVEL               BINARY-LONG.
 01 WS-ID                  BINARY-LONG.
 01 WS-ONE                 BINARY-LONG VALUE 1.
 01 WS-SIXTY-FOUR          BINARY-LONG VALUE 64.
 01 WS-A1                  BINARY-LONG.
 01 WS-A2                  BINARY-LONG.
 01 WS-A3                  BINARY-LONG.
 01 WS-A4                  BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-J                   BINARY-LONG.
 01 WS-K                   BINARY-LONG.
 01 WS-LIVE                BINARY-LONG.
 01 WS-POS                 BINARY-LONG.
 01 WS-NUMBER              BINARY-LONG.
 01 WS-EDIT                PIC -(9)9.
 01 WS-EDIT2               PIC -(9)9.
 01 WS-EDIT3               PIC -(9)9.
 01 WS-EDIT4               PIC -(9)9.
 01 WS-EDIT5               PIC -(9)9.
 01 WS-TEXT                PIC X(1024).
 PROCEDURE DIVISION.
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     PERFORM CLEAR-POOL

     MOVE "test stack patch an empty patch is handle 0 and exports as the stack without components" TO TL-CASE
     MOVE 3 TO PB-ISX-COUNT
     MOVE 1 TO PB-ISX-ITEM
     MOVE 0 TO PB-ISX-ADDED-COUNT PB-ISX-REMOVED-COUNT
     CALL "SP-INTERN" USING PB-ITEMSTACK-X WS-H1
     CALL "SP-EXPORT" USING WS-STONE WS-ONE WS-H1 QX-ITEMSTACK-X
     MOVE WS-H1 TO WS-EDIT
     MOVE QX-ISX-COUNT TO WS-EDIT2
     MOVE QX-ISX-ADDED-COUNT TO WS-EDIT3
     MOVE QX-ISX-REMOVED-COUNT TO WS-EDIT4
     MOVE SPACES TO TL-OBSERVED
     STRING "handle " FUNCTION TRIM(WS-EDIT) " count " FUNCTION TRIM(WS-EDIT2) " added "
         FUNCTION TRIM(WS-EDIT3) " removed " FUNCTION TRIM(WS-EDIT4) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "handle 0 count 1 added 0 removed 0" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack patch the damaged named stone of the Container Set Slot fixture (damage 5, custom_name Hi, "
         & "max_stack_size removed) interns, reads back and exports as the same wire stack" TO TL-CASE
     MOVE "contract/fixtures/wire/play-s2c-14-container-set-slot-components.hex" TO WS-PATH
     CALL "TEST-LOAD-HEX" USING WS-PATH PB-BUFFER
     CALL "PB-GET-VARINT" USING PB-BUFFER WS-A1
     CALL "PB-GET-VARINT" USING PB-BUFFER WS-A2
     CALL "PB-GET-VARINT" USING PB-BUFFER WS-A3
     CALL "PB-GET-SHORT" USING PB-BUFFER WS-A4
     CALL "PB-GET-ITEM-STACK" USING PB-BUFFER PB-ITEMSTACK-X
     CALL "SP-INTERN" USING PB-ITEMSTACK-X WS-H1
     CALL "SP-GET-DAMAGE" USING WS-STONE WS-H1 WS-DAMAGE
     CALL "SP-GET-NAME" USING WS-H1 WS-NAME WS-NAME-LENGTH
     CALL "SP-EXPORT" USING PB-ISX-ITEM PB-ISX-COUNT WS-H1 QX-ITEMSTACK-X
     CALL "PB-RESET" USING PB-BUFFER
     CALL "PB-PUT-ITEM-STACK" USING PB-BUFFER QX-ITEMSTACK-X
     MOVE "contract/fixtures/wire/play-s2c-14-container-set-slot-components.hex" TO WS-PATH
     MOVE WS-DAMAGE TO WS-EDIT
     MOVE WS-NAME-LENGTH TO WS-EDIT2
     MOVE PB-ERROR TO WS-EDIT3
     MOVE PB-LENGTH TO WS-EDIT4
     MOVE SPACES TO TL-OBSERVED
     STRING "damage " FUNCTION TRIM(WS-EDIT) " name " WS-NAME(1:WS-NAME-LENGTH) " length "
         FUNCTION TRIM(WS-EDIT2) " error " FUNCTION TRIM(WS-EDIT3) " bytes " FUNCTION TRIM(WS-EDIT4)
         DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "damage 5 name Hi length 2 error 0 bytes 13" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack patch decoding the same stack again gives the same handle (interned)" TO TL-CASE
     MOVE 0 TO PB-POS
     CALL "PB-GET-ITEM-STACK" USING PB-BUFFER PB-ITEMSTACK-X
     CALL "SP-INTERN" USING PB-ITEMSTACK-X WS-H2
     MOVE WS-H1 TO WS-EDIT
     MOVE WS-H2 TO WS-EDIT2
     MOVE SPACES TO TL-OBSERVED
     IF WS-H1 > 0 AND WS-H1 = WS-H2
         MOVE "same" TO TL-OBSERVED
     ELSE
         STRING "first " FUNCTION TRIM(WS-EDIT) " second " FUNCTION TRIM(WS-EDIT2)
             DELIMITED BY SIZE INTO TL-OBSERVED
     END-IF
     MOVE "same" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack patch damage is stored as the damage component, 0 is no component, equal damages share a "
         & "handle and the default is 0" TO TL-CASE
     MOVE 0 TO WS-H1 WS-DAMAGE
     CALL "SP-SET-DAMAGE" USING WS-H1 WS-DAMAGE
     MOVE WS-H1 TO WS-A1
     MOVE 300 TO WS-DAMAGE
     CALL "SP-SET-DAMAGE" USING WS-H1 WS-DAMAGE
     MOVE WS-H1 TO WS-H3
     CALL "SP-GET-DAMAGE" USING WS-STONE WS-H1 WS-DAMAGE
     MOVE WS-DAMAGE TO WS-A2
     MOVE 0 TO WS-H2
     MOVE 300 TO WS-DAMAGE
     CALL "SP-SET-DAMAGE" USING WS-H2 WS-DAMAGE
     MOVE 301 TO WS-DAMAGE
     CALL "SP-SET-DAMAGE" USING WS-H1 WS-DAMAGE
     MOVE 0 TO WS-DAMAGE
     CALL "SP-SET-DAMAGE" USING WS-H1 WS-DAMAGE
     CALL "SP-GET-DAMAGE" USING WS-STONE WS-H1 WS-A4
     MOVE WS-A1 TO WS-EDIT
     MOVE WS-A2 TO WS-EDIT2
     MOVE WS-A4 TO WS-EDIT3
     MOVE SPACES TO TL-OBSERVED
     IF WS-H3 = WS-H2 AND WS-H3 > 0
         MOVE "shared" TO TL-OBSERVED
     ELSE
         MOVE "separate" TO TL-OBSERVED
     END-IF
     MOVE SPACES TO WS-TEXT
     STRING FUNCTION TRIM(TL-OBSERVED) " first " FUNCTION TRIM(WS-EDIT) " read " FUNCTION TRIM(WS-EDIT2)
         " none " FUNCTION TRIM(WS-EDIT3) DELIMITED BY SIZE INTO WS-TEXT
     MOVE WS-TEXT TO TL-OBSERVED
     MOVE "shared first 0 read 300 none 0" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack patch max_damage comes from the patch, else from the item's content components, else 0" TO TL-CASE
*>   The standard set's generated item rows give the durability (the world of this test is the cobolcraft set).
     MOVE CT-TYPE-STANDARD TO CT-SET-TYPE
     MOVE SPACES TO WS-KEY
     MOVE "minecraft:diamond_pickaxe" TO WS-KEY
     CALL "CONTENT-ITEM-BY-KEY" USING WS-KEY WS-ITEM WS-ROWTEXT WS-STATUS
     MOVE 0 TO WS-H1
     CALL "SP-GET-MAX-DAMAGE" USING WS-ITEM WS-H1 WS-A1
     MOVE SPACES TO WS-VALUE
     MOVE FUNCTION CHAR(101) TO WS-VALUE(1:1)
     MOVE 1 TO WS-LENGTH
     MOVE 2 TO WS-ID
     CALL "SP-SET-COMPONENT" USING WS-H1 WS-ID WS-VALUE WS-LENGTH
     CALL "SP-GET-MAX-DAMAGE" USING WS-ITEM WS-H1 WS-A2
     MOVE 0 TO WS-H2
     CALL "SP-GET-MAX-DAMAGE" USING WS-STONE WS-H2 WS-A3
     MOVE CT-TYPE-COBOLCRAFT TO CT-SET-TYPE
     MOVE WS-A1 TO WS-EDIT
     MOVE WS-A2 TO WS-EDIT2
     MOVE WS-A3 TO WS-EDIT3
     MOVE SPACES TO TL-OBSERVED
     STRING "default " FUNCTION TRIM(WS-EDIT) " patch " FUNCTION TRIM(WS-EDIT2) " none "
         FUNCTION TRIM(WS-EDIT3) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "default 1561 patch 100 none 0" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack patch a custom name is the network NBT string tag, an absent one reads length 0" TO TL-CASE
     MOVE 0 TO WS-H1
     MOVE SPACES TO WS-NAME
     MOVE "Sword of Tests" TO WS-NAME
     MOVE 14 TO WS-NAME-LENGTH
     CALL "SP-SET-NAME" USING WS-H1 WS-NAME WS-NAME-LENGTH
     MOVE 6 TO WS-A1
     CALL "SP-GET-COMPONENT" USING WS-H1 WS-A1 WS-VALUE WS-LENGTH WS-FOUND
     CALL "SP-GET-NAME" USING WS-H1 WS-NAME WS-NAME-LENGTH
     MOVE WS-LENGTH TO WS-EDIT
     MOVE WS-NAME-LENGTH TO WS-EDIT2
     COMPUTE WS-A2 = FUNCTION ORD(WS-VALUE(1:1)) - 1
     COMPUTE WS-A3 = FUNCTION ORD(WS-VALUE(3:1)) - 1
     MOVE WS-A2 TO WS-EDIT3
     MOVE WS-A3 TO WS-EDIT4
     MOVE SPACES TO TL-OBSERVED
     STRING "found " FUNCTION TRIM(WS-EDIT) " bytes tag " FUNCTION TRIM(WS-EDIT3) " length "
         FUNCTION TRIM(WS-EDIT4) " name " WS-NAME(1:WS-NAME-LENGTH) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "found 17 bytes tag 8 length 14 name Sword of Tests" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack patch no name, or a name component that is not a plain string tag, reads length 0" TO TL-CASE
     MOVE 0 TO WS-H1
     CALL "SP-GET-NAME" USING WS-H1 WS-NAME WS-NAME-LENGTH
     MOVE WS-NAME-LENGTH TO WS-A1
     MOVE SPACES TO WS-VALUE
     MOVE FUNCTION CHAR(11) TO WS-VALUE(1:1)
     MOVE 5 TO WS-LENGTH
     MOVE 6 TO WS-ID
     CALL "SP-SET-COMPONENT" USING WS-H1 WS-ID WS-VALUE WS-LENGTH
     CALL "SP-GET-NAME" USING WS-H1 WS-NAME WS-NAME-LENGTH
     MOVE WS-NAME-LENGTH TO WS-A2
     MOVE SPACES TO WS-VALUE
     MOVE FUNCTION CHAR(9) TO WS-VALUE(1:1)
     MOVE FUNCTION CHAR(1) TO WS-VALUE(2:1)
     MOVE FUNCTION CHAR(10) TO WS-VALUE(3:1)
     MOVE 6 TO WS-LENGTH
     CALL "SP-SET-COMPONENT" USING WS-H1 WS-ID WS-VALUE WS-LENGTH
     CALL "SP-GET-NAME" USING WS-H1 WS-NAME WS-NAME-LENGTH
     MOVE WS-A1 TO WS-EDIT
     MOVE WS-A2 TO WS-EDIT2
     MOVE WS-NAME-LENGTH TO WS-EDIT3
     MOVE SPACES TO TL-OBSERVED
     STRING "none " FUNCTION TRIM(WS-EDIT) " other tag " FUNCTION TRIM(WS-EDIT2) " too long "
         FUNCTION TRIM(WS-EDIT3) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "none 0 other tag 0 too long 0" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack patch enchantments are added, raised and read by id; the component lists the pairs by ascending id" TO TL-CASE
     MOVE 0 TO WS-H1
     MOVE 5 TO WS-ID
     MOVE 3 TO WS-LEVEL
     CALL "SP-ADD-ENCHANT" USING WS-H1 WS-ID WS-LEVEL
     MOVE 2 TO WS-ID
     MOVE 1 TO WS-LEVEL
     CALL "SP-ADD-ENCHANT" USING WS-H1 WS-ID WS-LEVEL
     MOVE 5 TO WS-ID
     MOVE 4 TO WS-LEVEL
     CALL "SP-ADD-ENCHANT" USING WS-H1 WS-ID WS-LEVEL
     MOVE 5 TO WS-ID
     CALL "SP-ENCHANT-LEVEL" USING WS-H1 WS-ID WS-A1
     MOVE 2 TO WS-ID
     CALL "SP-ENCHANT-LEVEL" USING WS-H1 WS-ID WS-A2
     MOVE 9 TO WS-ID
     CALL "SP-ENCHANT-LEVEL" USING WS-H1 WS-ID WS-A3
     MOVE 0 TO WS-H2
     CALL "SP-ENCHANT-LEVEL" USING WS-H2 WS-ID WS-A4
     MOVE 13 TO WS-ID
     CALL "SP-GET-COMPONENT" USING WS-H1 WS-ID WS-VALUE WS-LENGTH WS-FOUND
     MOVE WS-A1 TO WS-EDIT
     MOVE WS-A2 TO WS-EDIT2
     MOVE WS-A3 TO WS-EDIT3
     MOVE WS-A4 TO WS-EDIT4
     MOVE SPACES TO TL-OBSERVED
     STRING "5=" FUNCTION TRIM(WS-EDIT) " 2=" FUNCTION TRIM(WS-EDIT2) " 9=" FUNCTION TRIM(WS-EDIT3)
         " none=" FUNCTION TRIM(WS-EDIT4) DELIMITED BY SIZE INTO TL-OBSERVED
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-LENGTH
         COMPUTE WS-NUMBER = FUNCTION ORD(WS-VALUE(WS-I:1)) - 1
         MOVE WS-NUMBER TO WS-EDIT
         MOVE SPACES TO WS-TEXT
         STRING FUNCTION TRIM(TL-OBSERVED) " " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO WS-TEXT
         MOVE WS-TEXT TO TL-OBSERVED
     END-PERFORM
     MOVE "5=4 2=1 9=0 none=0 2 2 1 5 4" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack patch an enchanted stack survives the wire: export, PB-PUT-ITEM-STACK, PB-GET-ITEM-STACK, intern is "
         & "the same handle" TO TL-CASE
     CALL "SP-EXPORT" USING WS-STONE WS-SIXTY-FOUR WS-H1 PB-ITEMSTACK-X
     CALL "PB-RESET" USING PB-BUFFER
     CALL "PB-PUT-ITEM-STACK" USING PB-BUFFER PB-ITEMSTACK-X
     MOVE PB-ERROR TO WS-A1
     MOVE 0 TO PB-POS
     CALL "PB-GET-ITEM-STACK" USING PB-BUFFER QX-ITEMSTACK-X
     CALL "SP-INTERN" USING QX-ITEMSTACK-X WS-H2
     MOVE WS-A1 TO WS-EDIT
     MOVE PB-ERROR TO WS-EDIT2
     MOVE QX-ISX-COUNT TO WS-EDIT3
     MOVE SPACES TO TL-OBSERVED
     IF WS-H2 = WS-H1
         MOVE "same" TO TL-OBSERVED
     ELSE
         MOVE "different" TO TL-OBSERVED
     END-IF
     MOVE SPACES TO WS-TEXT
     STRING FUNCTION TRIM(TL-OBSERVED) " put error " FUNCTION TRIM(WS-EDIT) " get error "
         FUNCTION TRIM(WS-EDIT2) " count " FUNCTION TRIM(WS-EDIT3) DELIMITED BY SIZE INTO WS-TEXT
     MOVE WS-TEXT TO TL-OBSERVED
     MOVE "same put error 0 get error 0 count 64" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack patch the patch is canonical: components in any order, repeated, a damage of 0, an oversized value (2049 bytes) "
         & "and more than eight of each give the handle of the sorted, trimmed patch" TO TL-CASE
     PERFORM CLEAR-POOL
     MOVE 1 TO PB-ISX-COUNT
     MOVE 1 TO PB-ISX-ITEM
     MOVE 0 TO PB-ISX-ADDED-COUNT PB-ISX-REMOVED-COUNT
     MOVE 0 TO WS-J
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 3
         ADD 1 TO PB-ISX-ADDED-COUNT
         MOVE 4 TO PB-ISX-TYPE(PB-ISX-ADDED-COUNT)
         MOVE 0 TO PB-ISX-VALUE-LENGTH(PB-ISX-ADDED-COUNT)
         ADD 1 TO PB-ISX-ADDED-COUNT
         MOVE 22 TO PB-ISX-TYPE(PB-ISX-ADDED-COUNT)
         MOVE 0 TO PB-ISX-VALUE-LENGTH(PB-ISX-ADDED-COUNT)
         ADD 1 TO PB-ISX-ADDED-COUNT
         MOVE 3 TO PB-ISX-TYPE(PB-ISX-ADDED-COUNT)
         MOVE 1 TO PB-ISX-VALUE-LENGTH(PB-ISX-ADDED-COUNT)
         MOVE X"00" TO PB-ISX-VALUE(PB-ISX-ADDED-COUNT)(1:1)
     END-PERFORM
     ADD 1 TO PB-ISX-ADDED-COUNT
     MOVE 6 TO PB-ISX-TYPE(PB-ISX-ADDED-COUNT)
     MOVE 2049 TO PB-ISX-VALUE-LENGTH(PB-ISX-ADDED-COUNT)
     MOVE 3 TO PB-ISX-REMOVED-COUNT
     MOVE 9 TO PB-ISX-REMOVED(1)
     MOVE 1 TO PB-ISX-REMOVED(2)
     MOVE 9 TO PB-ISX-REMOVED(3)
     CALL "SP-INTERN" USING PB-ITEMSTACK-X WS-H1
     MOVE 2 TO PB-ISX-ADDED-COUNT
     MOVE 22 TO PB-ISX-TYPE(1)
     MOVE 4 TO PB-ISX-TYPE(2)
     MOVE 0 TO PB-ISX-VALUE-LENGTH(1) PB-ISX-VALUE-LENGTH(2)
     MOVE 2 TO PB-ISX-REMOVED-COUNT
     MOVE 1 TO PB-ISX-REMOVED(1)
     MOVE 9 TO PB-ISX-REMOVED(2)
     CALL "SP-INTERN" USING PB-ITEMSTACK-X WS-H2
     MOVE 12 TO PB-ISX-ADDED-COUNT
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 12
         COMPUTE PB-ISX-TYPE(WS-I) = 40 - WS-I
         MOVE 0 TO PB-ISX-VALUE-LENGTH(WS-I)
     END-PERFORM
     MOVE 10 TO PB-ISX-REMOVED-COUNT
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 10
         COMPUTE PB-ISX-REMOVED(WS-I) = 80 - WS-I
     END-PERFORM
     CALL "SP-INTERN" USING PB-ITEMSTACK-X WS-H3
     CALL "SP-EXPORT" USING WS-STONE WS-ONE WS-H3 QX-ITEMSTACK-X
     MOVE WS-H1 TO WS-EDIT
     MOVE WS-H2 TO WS-EDIT2
     MOVE QX-ISX-ADDED-COUNT TO WS-EDIT3
     MOVE QX-ISX-REMOVED-COUNT TO WS-EDIT4
     MOVE QX-ISX-TYPE(1) TO WS-A1
     MOVE WS-A1 TO WS-EDIT
     MOVE SPACES TO TL-OBSERVED
     IF WS-H1 > 0 AND WS-H1 = WS-H2
         MOVE "equal" TO TL-OBSERVED
     ELSE
         MOVE "unequal" TO TL-OBSERVED
     END-IF
     MOVE SPACES TO WS-TEXT
     STRING FUNCTION TRIM(TL-OBSERVED) " big added " FUNCTION TRIM(WS-EDIT3) " removed "
         FUNCTION TRIM(WS-EDIT4) " lowest " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO WS-TEXT
     MOVE WS-TEXT TO TL-OBSERVED
     MOVE "equal big added 8 removed 8 lowest 32" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack patch patches that differ only in a removed component are two handles; setting a component keeps the "
         & "removed components of other types and drops the one it sets" TO TL-CASE
     PERFORM CLEAR-POOL
     MOVE 1 TO PB-ISX-COUNT
     MOVE 1 TO PB-ISX-ITEM
     MOVE 0 TO PB-ISX-ADDED-COUNT
     MOVE 1 TO PB-ISX-REMOVED-COUNT
     MOVE 1 TO PB-ISX-REMOVED(1)
     CALL "SP-INTERN" USING PB-ITEMSTACK-X WS-H1
     MOVE 2 TO PB-ISX-REMOVED(1)
     CALL "SP-INTERN" USING PB-ITEMSTACK-X WS-H2
     MOVE 1 TO PB-ISX-REMOVED-COUNT
     MOVE 1 TO PB-ISX-REMOVED(1)
     MOVE WS-H1 TO WS-H3
     MOVE SPACES TO WS-VALUE
     MOVE FUNCTION CHAR(2) TO WS-VALUE(1:1)
     MOVE 1 TO WS-LENGTH
     MOVE 19 TO WS-ID
     CALL "SP-SET-COMPONENT" USING WS-H3 WS-ID WS-VALUE WS-LENGTH
     CALL "SP-EXPORT" USING WS-STONE WS-ONE WS-H3 QX-ITEMSTACK-X
     MOVE 1 TO WS-ID
     MOVE WS-H1 TO WS-A1
     CALL "SP-SET-COMPONENT" USING WS-A1 WS-ID WS-VALUE WS-LENGTH
     CALL "SP-EXPORT" USING WS-STONE WS-ONE WS-A1 PB-ITEMSTACK-X
     MOVE SPACES TO TL-OBSERVED
     IF WS-H1 NOT = WS-H2
         MOVE "two" TO TL-OBSERVED
     ELSE
         MOVE "one" TO TL-OBSERVED
     END-IF
     MOVE QX-ISX-ADDED-COUNT TO WS-EDIT
     MOVE QX-ISX-REMOVED-COUNT TO WS-EDIT2
     MOVE QX-ISX-REMOVED(1) TO WS-EDIT3
     MOVE PB-ISX-REMOVED-COUNT TO WS-EDIT4
     MOVE SPACES TO WS-TEXT
     STRING FUNCTION TRIM(TL-OBSERVED) " kept " FUNCTION TRIM(WS-EDIT) "+" FUNCTION TRIM(WS-EDIT2) " removed "
         FUNCTION TRIM(WS-EDIT3) " other " FUNCTION TRIM(WS-EDIT4) DELIMITED BY SIZE INTO WS-TEXT
     MOVE WS-TEXT TO TL-OBSERVED
     MOVE "two kept 1+1 removed 1 other 0" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack patch SP-EXPORT of a count of 0, and of a handle that is 0, out of range or not in use, has "
         & "no components" TO TL-CASE
     MOVE 0 TO WS-A1
     CALL "SP-EXPORT" USING WS-STONE WS-A1 WS-H1 QX-ITEMSTACK-X
     MOVE QX-ISX-COUNT TO WS-EDIT
     MOVE 9999 TO WS-A2
     CALL "SP-EXPORT" USING WS-STONE WS-ONE WS-A2 QX-ITEMSTACK-X
     MOVE QX-ISX-ADDED-COUNT TO WS-EDIT2
     MOVE 512 TO WS-A3
     CALL "SP-EXPORT" USING WS-STONE WS-ONE WS-A3 QX-ITEMSTACK-X
     MOVE QX-ISX-ADDED-COUNT TO WS-EDIT3
     MOVE WS-A2 TO WS-A4
     CALL "SP-GET-COMPONENT" USING WS-A4 WS-ONE WS-VALUE WS-LENGTH WS-FOUND
     MOVE WS-FOUND TO WS-EDIT4
     MOVE SPACES TO TL-OBSERVED
     STRING "count " FUNCTION TRIM(WS-EDIT) " range " FUNCTION TRIM(WS-EDIT2) " unused "
         FUNCTION TRIM(WS-EDIT3) " found " FUNCTION TRIM(WS-EDIT4) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "count 0 range 0 unused 0 found 0" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack patch a VarInt of several bytes round trips and reading stops at the end of the value or after four bytes" TO TL-CASE
     MOVE SPACES TO WS-VALUE
     MOVE 1 TO WS-POS
     MOVE 1561 TO WS-NUMBER
     CALL "SP-VARINT-PUT" USING WS-VALUE WS-POS WS-NUMBER
     MOVE WS-POS TO WS-A1
     MOVE 1 TO WS-POS
     CALL "SP-VARINT-GET" USING WS-VALUE WS-POS WS-A2
     MOVE ALL X"FF" TO WS-VALUE
     MOVE 62 TO WS-POS
     CALL "SP-VARINT-GET" USING WS-VALUE WS-POS WS-A3
     MOVE 1 TO WS-POS
     CALL "SP-VARINT-GET" USING WS-VALUE WS-POS WS-A4
     MOVE WS-A1 TO WS-EDIT
     MOVE WS-A2 TO WS-EDIT2
     MOVE WS-A3 TO WS-EDIT3
     MOVE WS-A4 TO WS-EDIT5
     MOVE WS-POS TO WS-EDIT4
     MOVE SPACES TO TL-OBSERVED
     STRING "next " FUNCTION TRIM(WS-EDIT) " value " FUNCTION TRIM(WS-EDIT2) " end " FUNCTION TRIM(WS-EDIT3)
         " four " FUNCTION TRIM(WS-EDIT5) " stop " FUNCTION TRIM(WS-EDIT4) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "next 3 value 1561 end 2097151 four 268435455 stop 5" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack patch an enchantments component that claims more pairs than it holds is read up to its end" TO TL-CASE
     MOVE 0 TO WS-H1
     MOVE SPACES TO WS-VALUE
     MOVE FUNCTION CHAR(100) TO WS-VALUE(1:1)
     MOVE 64 TO WS-LENGTH
     MOVE 13 TO WS-ID
     MOVE ALL X"01" TO WS-VALUE(2:63)
     CALL "SP-SET-COMPONENT" USING WS-H1 WS-ID WS-VALUE WS-LENGTH
     MOVE 1 TO WS-ID
     CALL "SP-ENCHANT-LEVEL" USING WS-H1 WS-ID WS-A1
     MOVE 40 TO WS-ID
     MOVE 2 TO WS-LEVEL
     CALL "SP-ADD-ENCHANT" USING WS-H1 WS-ID WS-LEVEL
     CALL "SP-ENCHANT-LEVEL" USING WS-H1 WS-ID WS-A2
     MOVE WS-A1 TO WS-EDIT
     MOVE WS-A2 TO WS-EDIT2
     MOVE SPACES TO TL-OBSERVED
     STRING "level " FUNCTION TRIM(WS-EDIT) " added " FUNCTION TRIM(WS-EDIT2) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "level 1 added 2" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack patch SP-SWEEP frees the entries no player slot, grid, result or cursor refers to and keeps the "
         & "referenced ones" TO TL-CASE
     PERFORM CLEAR-POOL
     INITIALIZE PL-ENTRY(1) MN-ENTRY(1)
     MOVE 1 TO PL-USED(1)
     MOVE 0 TO WS-H1
     MOVE 11 TO WS-DAMAGE
     CALL "SP-SET-DAMAGE" USING WS-H1 WS-DAMAGE
     MOVE WS-H1 TO PL-SLOT-VAR(1, 3)
     MOVE 0 TO WS-H2
     MOVE 12 TO WS-DAMAGE
     CALL "SP-SET-DAMAGE" USING WS-H2 WS-DAMAGE
     MOVE WS-H2 TO MN-EQUIP-VAR(1, 2)
     MOVE 0 TO WS-H3
     MOVE 13 TO WS-DAMAGE
     CALL "SP-SET-DAMAGE" USING WS-H3 WS-DAMAGE
     MOVE WS-H3 TO MN-IGRID-VAR(1, 4)
     MOVE 0 TO WS-A1
     MOVE 14 TO WS-DAMAGE
     CALL "SP-SET-DAMAGE" USING WS-A1 WS-DAMAGE
     MOVE WS-A1 TO MN-BGRID-VAR(1, 9)
     MOVE 0 TO WS-A2
     MOVE 15 TO WS-DAMAGE
     CALL "SP-SET-DAMAGE" USING WS-A2 WS-DAMAGE
     MOVE WS-A2 TO PL-CARRIED-VAR(1)
     MOVE 0 TO WS-A3
     MOVE 16 TO WS-DAMAGE
     CALL "SP-SET-DAMAGE" USING WS-A3 WS-DAMAGE
     CALL "SP-SWEEP"
     MOVE 0 TO WS-LIVE
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 512
         ADD SP-LIVE(WS-I) TO WS-LIVE
     END-PERFORM
     MOVE WS-LIVE TO WS-EDIT
     MOVE SP-LIVE(WS-A3) TO WS-EDIT2
     MOVE SPACES TO TL-OBSERVED
     STRING "live " FUNCTION TRIM(WS-EDIT) " unreferenced " FUNCTION TRIM(WS-EDIT2) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "live 5 unreferenced 0" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack patch a full pool is swept and reused when nothing refers to its entries" TO TL-CASE
     PERFORM CLEAR-POOL
     MOVE 0 TO WS-A1
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 520
         MOVE 0 TO WS-H1
         COMPUTE WS-DAMAGE = 100 + WS-I
         CALL "SP-SET-DAMAGE" USING WS-H1 WS-DAMAGE
         IF WS-H1 = 0
             ADD 1 TO WS-A1
         END-IF
     END-PERFORM
     MOVE WS-A1 TO WS-EDIT
     MOVE SPACES TO TL-OBSERVED
     STRING "refused " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "refused 0" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack patch a pool full of entries the players hold refuses one more patch with handle 0" TO TL-CASE
     PERFORM CLEAR-POOL
     MOVE 0 TO WS-K
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 15
         INITIALIZE PL-ENTRY(WS-I) MN-ENTRY(WS-I)
         MOVE 1 TO PL-USED(WS-I)
     END-PERFORM
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 512
         MOVE 0 TO WS-H1
         COMPUTE WS-DAMAGE = 100 + WS-I
         CALL "SP-SET-DAMAGE" USING WS-H1 WS-DAMAGE
         COMPUTE WS-J = (WS-I - 1) / 36 + 1
         COMPUTE WS-K = WS-I - (WS-J - 1) * 36
         MOVE WS-H1 TO PL-SLOT-VAR(WS-J, WS-K)
     END-PERFORM
     MOVE 0 TO WS-H2
     MOVE 9999 TO WS-DAMAGE
     CALL "SP-SET-DAMAGE" USING WS-H2 WS-DAMAGE
     MOVE WS-H2 TO WS-EDIT
     MOVE SPACES TO TL-OBSERVED
     STRING "handle " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "handle 0" TO TL-EXPECTED
     PERFORM CHECK
     GOBACK.

 CLEAR-POOL.
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 512
         MOVE 0 TO SP-LIVE(WS-I)
     END-PERFORM
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 64
         MOVE 0 TO PL-USED(WS-I)
     END-PERFORM.

 CHECK.
     MOVE "T" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-STACK-PATCH.
 COPY CORETEST.
