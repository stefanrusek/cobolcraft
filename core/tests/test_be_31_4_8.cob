     MOVE WS-E TO WS-SHOW
     PERFORM ADD-N
     MOVE 1 TO WS-A
     MOVE 1 TO WS-B
     MOVE 0 TO WS-C
     CALL "BE4-HIVE-ALLOWED" USING WS-A WS-B WS-C WS-E
     MOVE WS-E TO WS-SHOW
     PERFORM ADD-N
     MOVE 1 TO WS-A
     MOVE 2 TO WS-B
     MOVE 0 TO WS-C
     CALL "BE4-HIVE-ALLOWED" USING WS-A WS-B WS-C WS-E
     MOVE WS-E TO WS-SHOW
     PERFORM ADD-N
     MOVE 0 TO WS-A
     MOVE 0 TO WS-B
     MOVE 0 TO WS-C
     CALL "BE4-HIVE-ALLOWED" USING WS-A WS-B WS-C WS-E
     MOVE WS-E TO WS-SHOW
     PERFORM ADD-N
     MOVE 0 TO WS-A
     MOVE 1 TO WS-B
     MOVE 1 TO WS-C
     CALL "BE4-HIVE-ALLOWED" USING WS-A WS-B WS-C WS-E
     MOVE WS-E TO WS-SHOW
