     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     MOVE "minecraft:overworld" TO WS-T1
     CALL "FT-WATER-EVAPORATES" USING WS-T1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     MOVE "cobolcraft:main" TO WS-T1
     CALL "FT-WATER-EVAPORATES" USING WS-T1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 0 " TO TL-EXPECTED
