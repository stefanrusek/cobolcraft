 PROCEDURE DIVISION.
     MOVE "T" TO TL-MODE
     MOVE "acceptance US12 33§1 Server tick order: pause when empty: P = seconds * 20; the counter counts empty ticks, the tick pauses at P with one autosave on the first such tick; 0 or less disables it;" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0 0 60 1198" TO WS-IN
     PERFORM LOAD-IN
     MOVE WS-I4 TO WS-R1
     CALL "WT-PAUSE" USING WS-I1 WS-I2 WS-I3 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 60 1199" TO WS-IN
     PERFORM LOAD-IN
     MOVE WS-I4 TO WS-R1
     CALL "WT-PAUSE" USING WS-I1 WS-I2 WS-I3 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 60 1200" TO WS-IN
     PERFORM LOAD-IN
     MOVE WS-I4 TO WS-R1
     CALL "WT-PAUSE" USING WS-I1 WS-I2 WS-I3 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 60 1500" TO WS-IN
     PERFORM LOAD-IN
     MOVE WS-I4 TO WS-R1
     CALL "WT-PAUSE" USING WS-I1 WS-I2 WS-I3 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 60 1500" TO WS-IN
     PERFORM LOAD-IN
     MOVE WS-I4 TO WS-R1
     CALL "WT-PAUSE" USING WS-I1 WS-I2 WS-I3 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "0 1 60 100" TO WS-IN
     PERFORM LOAD-IN
     MOVE WS-I4 TO WS-R1
     CALL "WT-PAUSE" USING WS-I1 WS-I2 WS-I3 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 0 5000" TO WS-IN
     PERFORM LOAD-IN
     MOVE WS-I4 TO WS-R1
     CALL "WT-PAUSE" USING WS-I1 WS-I2 WS-I3 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 -3 5000" TO WS-IN
     PERFORM LOAD-IN
     MOVE WS-I4 TO WS-R1
     CALL "WT-PAUSE" USING WS-I1 WS-I2 WS-I3 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 1 19" TO WS-IN
     PERFORM LOAD-IN
     MOVE WS-I4 TO WS-R1
     CALL "WT-PAUSE" USING WS-I1 WS-I2 WS-I3 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 1 20" TO WS-IN
     PERFORM LOAD-IN
     MOVE WS-I4 TO WS-R1
     CALL "WT-PAUSE" USING WS-I1 WS-I2 WS-I3 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1199/0/0 1200/1/1 1201/1/0 1501/1/0 0/0/0 0/0/0 5000/0/0 5000/0/0 20/1/1 21/1/0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 33§1 Server tick order: the Set Time heartbeat is sent when the tick count is a multiple of 20" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1" TO WS-IN
     PERFORM LOAD-IN
     CALL "WT-HEARTBEAT" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "19" TO WS-IN
     PERFORM LOAD-IN
     CALL "WT-HEARTBEAT" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "20" TO WS-IN
     PERFORM LOAD-IN
     CALL "WT-HEARTBEAT" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "21" TO WS-IN
     PERFORM LOAD-IN
     CALL "WT-HEARTBEAT" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "40" TO WS-IN
     PERFORM LOAD-IN
     CALL "WT-HEARTBEAT" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "100" TO WS-IN
     PERFORM LOAD-IN
     CALL "WT-HEARTBEAT" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 1 0 1 1" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 33§1 Server tick order: autosave: the countdown falls by 1; at 0 or below the world is saved and the countdown restarts at max(100, (int)(rate * 300))" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "5 20.0" TO WS-IN
     PERFORM LOAD-IN
     MOVE WS-I1 TO WS-R1
     CALL "WT-AUTOSAVE" USING WS-R1 WS-FX2 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1 20.0" TO WS-IN
     PERFORM LOAD-IN
     MOVE WS-I1 TO WS-R1
     CALL "WT-AUTOSAVE" USING WS-R1 WS-FX2 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "0 20.0" TO WS-IN
     PERFORM LOAD-IN
     MOVE WS-I1 TO WS-R1
     CALL "WT-AUTOSAVE" USING WS-R1 WS-FX2 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1 0.1" TO WS-IN
     PERFORM LOAD-IN
     MOVE WS-I1 TO WS-R1
     CALL "WT-AUTOSAVE" USING WS-R1 WS-FX2 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1 1000.0" TO WS-IN
     PERFORM LOAD-IN
     MOVE WS-I1 TO WS-R1
     CALL "WT-AUTOSAVE" USING WS-R1 WS-FX2 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "2 20.0" TO WS-IN
     PERFORM LOAD-IN
     MOVE WS-I1 TO WS-R1
     CALL "WT-AUTOSAVE" USING WS-R1 WS-FX2 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "4/0 6000/1 6000/1 100/1 300000/1 1/0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 33§1 Server tick order: the latency update is broadcast when the counter exceeds 600, and the counter resets" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     MOVE WS-I1 TO WS-R1
     CALL "WT-LATENCY" USING WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "599" TO WS-IN
     PERFORM LOAD-IN
     MOVE WS-I1 TO WS-R1
     CALL "WT-LATENCY" USING WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "600" TO WS-IN
     PERFORM LOAD-IN
     MOVE WS-I1 TO WS-R1
     CALL "WT-LATENCY" USING WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "601" TO WS-IN
     PERFORM LOAD-IN
     MOVE WS-I1 TO WS-R1
     CALL "WT-LATENCY" USING WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1/0 600/0 0/1 0/1" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 33§1 Server tick order: the cached status is rebuilt after at least 5 seconds" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "4999999999" TO WS-IN
     PERFORM LOAD-IN
     COMPUTE WS-BD1 = WS-FX1
     CALL "WT-STATUS" USING WS-BD1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "5000000000" TO WS-IN
     PERFORM LOAD-IN
     COMPUTE WS-BD1 = WS-FX1
     CALL "WT-STATUS" USING WS-BD1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "6000000000" TO WS-IN
     PERFORM LOAD-IN
     COMPUTE WS-BD1 = WS-FX1
     CALL "WT-STATUS" USING WS-BD1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     COMPUTE WS-BD1 = WS-FX1
     CALL "WT-STATUS" USING WS-BD1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 1 1 0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 33§1 Server tick order: while the game is frozen only the clock tick (step 3) and the game tests (step 9) stand still; every other step of tickChildren runs" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "WT-CHILD-RUNS" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "2 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "WT-CHILD-RUNS" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "3 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "WT-CHILD-RUNS" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "4 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "WT-CHILD-RUNS" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "5 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "WT-CHILD-RUNS" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "6 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "WT-CHILD-RUNS" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "7 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "WT-CHILD-RUNS" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "8 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "WT-CHILD-RUNS" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "9 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "WT-CHILD-RUNS" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "10 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "WT-CHILD-RUNS" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "11 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "WT-CHILD-RUNS" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "12 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "WT-CHILD-RUNS" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "3 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "WT-CHILD-RUNS" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "9 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "WT-CHILD-RUNS" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 0 1 1 1 1 1 0 1 1 1 1 1" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 33§1 Server tick order: levels tick in the order overworld, Nether, End" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1" TO WS-IN
     PERFORM LOAD-IN
     CALL "WT-LEVEL-ORDER" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "2" TO WS-IN
     PERFORM LOAD-IN
     CALL "WT-LEVEL-ORDER" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "3" TO WS-IN
     PERFORM LOAD-IN
     CALL "WT-LEVEL-ORDER" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 2 3" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 BEGIN-CASE.
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR
     .

 LOAD-IN.
     MOVE 1 TO WS-P
     PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 16
         MOVE SPACES TO WS-TOK
         IF WS-P <= 160
             UNSTRING WS-IN DELIMITED BY ALL SPACE INTO WS-TOK WITH POINTER WS-P
         END-IF
         COMPUTE WS-FX(WS-K) = FUNCTION NUMVAL(WS-TOK)
         COMPUTE WS-I(WS-K) = FUNCTION NUMVAL(WS-TOK)
     END-PERFORM
     .

 ADD-N.
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N
         MOVE WS-R(WS-J) TO WS-SHOW
         IF WS-J > 1
             STRING "/" DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
         END-IF
         STRING FUNCTION TRIM(WS-SHOW) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-PERFORM
     STRING " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .

 ADD-TEXT.
     STRING FUNCTION TRIM(WS-T1) "|" FUNCTION TRIM(WS-T2) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .
 END PROGRAM TEST-WORLDSIM-33-1.
