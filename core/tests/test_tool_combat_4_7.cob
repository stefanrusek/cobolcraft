 01 WS-O11 BINARY-LONG.
 01 WS-O12 BINARY-LONG.
 01 WS-X1 PIC X(48).
 01 WS-X2 PIC X(48).
 01 WS-X3 PIC X(48).
 01 WS-OBS PIC X(240).
 01 WS-E1 PIC -(9)9.
 01 WS-E2 PIC -(9)9.
 01 WS-E3 PIC -(9)9.
 01 WS-E4 PIC -(9)9.
 01 WS-E5 PIC -(9)9.
 01 WS-E6 PIC -(9)9.
 01 WS-E7 PIC -(9)9.
 01 WS-E8 PIC -(9)9.
 01 WS-E9 PIC -(9)9.
 01 WS-E10 PIC -(9)9.
 01 WS-E11 PIC -(9)9.
 01 WS-E12 PIC -(9)9.
 PROCEDURE DIVISION.
     MOVE "acceptance US14 a hit with no window starts one: lastHurt = amount, window 20" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE 0 TO WS-I1
     MOVE 0 TO WS-I2
     MOVE 5000 TO WS-I3
     MOVE 0 TO WS-I4
     CALL "TOOL-HURT-WINDOW" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-O1 WS-O2 WS-O3 WS-O4
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     MOVE WS-O3 TO WS-E3
     MOVE WS-O4 TO WS-E4
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) "/" FUNCTION TRIM(WS-E3) "/" FUNCTION TRIM(WS-E4) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "1/5000/5000/20" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 within the first 10 ticks (window above 10) a weaker or equal hit is ignored, a stronger one adds only the excess and starts no new window" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE 15 TO WS-I1
     MOVE 5000 TO WS-I2
     MOVE 4000 TO WS-I3
     MOVE 0 TO WS-I4
     CALL "TOOL-HURT-WINDOW" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-O1 WS-O2 WS-O3 WS-O4
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     MOVE WS-O3 TO WS-E3
     MOVE WS-O4 TO WS-E4
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) "/" FUNCTION TRIM(WS-E3) "/" FUNCTION TRIM(WS-E4) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 15 TO WS-I1
     MOVE 5000 TO WS-I2
     MOVE 5000 TO WS-I3
     MOVE 0 TO WS-I4
     CALL "TOOL-HURT-WINDOW" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-O1 WS-O2 WS-O3 WS-O4
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     MOVE WS-O3 TO WS-E3
     MOVE WS-O4 TO WS-E4
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) "/" FUNCTION TRIM(WS-E3) "/" FUNCTION TRIM(WS-E4) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 15 TO WS-I1
     MOVE 5000 TO WS-I2
     MOVE 7000 TO WS-I3
     MOVE 0 TO WS-I4
     CALL "TOOL-HURT-WINDOW" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-O1 WS-O2 WS-O3 WS-O4
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     MOVE WS-O3 TO WS-E3
     MOVE WS-O4 TO WS-E4
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) "/" FUNCTION TRIM(WS-E3) "/" FUNCTION TRIM(WS-E4) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "0/0/5000/15 0/0/5000/15 2/2000/7000/15" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 at window 10 or less a new full hit is accepted; bypasses_cooldown always opens a new window" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE 10 TO WS-I1
     MOVE 5000 TO WS-I2
     MOVE 3000 TO WS-I3
     MOVE 0 TO WS-I4
     CALL "TOOL-HURT-WINDOW" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-O1 WS-O2 WS-O3 WS-O4
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     MOVE WS-O3 TO WS-E3
     MOVE WS-O4 TO WS-E4
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) "/" FUNCTION TRIM(WS-E3) "/" FUNCTION TRIM(WS-E4) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 15 TO WS-I1
     MOVE 5000 TO WS-I2
     MOVE 1000 TO WS-I3
     MOVE 1 TO WS-I4
     CALL "TOOL-HURT-WINDOW" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-O1 WS-O2 WS-O3 WS-O4
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     MOVE WS-O3 TO WS-E3
     MOVE WS-O4 TO WS-E4
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) "/" FUNCTION TRIM(WS-E3) "/" FUNCTION TRIM(WS-E4) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "1/3000/3000/20 1/1000/1000/20" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 the window counts down by 1 per tick to 0" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE 20 TO WS-I1
     CALL "TOOL-HURT-TICK" USING WS-I1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 1 TO WS-I1
     CALL "TOOL-HURT-TICK" USING WS-I1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 0 TO WS-I1
     CALL "TOOL-HURT-TICK" USING WS-I1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "19 0 0" TO TL-EXPECTED
     PERFORM CHECK-DONE

     STOP RUN.

 ADD-OBS.
     IF TL-OBSERVED = SPACES
         MOVE FUNCTION TRIM(WS-OBS) TO TL-OBSERVED
     ELSE
         STRING FUNCTION TRIM(TL-OBSERVED) " " FUNCTION TRIM(WS-OBS) DELIMITED BY SIZE INTO TL-OBSERVED
     END-IF.

 CHECK-DONE.
     MOVE "T" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-TOOL-COMBAT-4-7.
