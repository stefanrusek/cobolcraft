*> Implementation test (T0452; docs/design/debug-world.md section 7 item 3, 06 section 5): the chunks of the debug
*> grid round-trip through the chunk packet the core builds (CHUNK-PACKET-BUILD, PB-PUT-CHUNK-24) and PB-GET-CHUNK-24
*> with every 16-bit state identical; a section of more than 256 distinct states is written with the direct form
*> (global bits) and read back the same.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-DEBUG-CODEC.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY COREAPI.
 COPY CELLS.
 COPY PROTO.
 COPY CHUNK24TAB.
 01 WS-CAPACITY            BINARY-LONG VALUE 262144.
 01 WS-BYTE                BINARY-LONG.
 01 WS-DIM                 BINARY-LONG VALUE 3.
 01 WS-CX                  BINARY-LONG.
 01 WS-CZ                  BINARY-LONG.
 01 WS-ROW                 BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-BAD                 BINARY-LONG.
 01 WS-DISTINCT            BINARY-LONG.
 01 WS-SEEN-TABLE.
    05 WS-SEEN             BINARY-CHAR UNSIGNED OCCURS 65536 TIMES.
 PROCEDURE DIVISION.
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     MOVE "debug" TO CS-WORLD-TYPE
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     MOVE "N" TO TL-MODE

     MOVE 1 TO WS-CX
     MOVE 23 TO WS-CZ
     PERFORM ROUND-TRIP
     MOVE "test debug codec chunk (1, 23) decodes with no error and every state identical" TO TL-CASE
     COMPUTE TL-OBSERVED-N = PB-ERROR * 100000 + WS-BAD
     MOVE 0 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "test debug codec chunk (1, 23) holds state 35722 at local (4, 70, 4)" TO TL-CASE
     MOVE CH-STATE((70 + 64) * 256 + 4 * 16 + 4 + 1) TO TL-OBSERVED-N
     MOVE 35722 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE 0 TO WS-CX
     MOVE 0 TO WS-CZ
     PERFORM ROUND-TRIP
     MOVE "test debug codec chunk (0, 0) round trip" TO TL-CASE
     COMPUTE TL-OBSERVED-N = PB-ERROR * 100000 + WS-BAD
     MOVE 0 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE 12 TO WS-CX
     MOVE 12 TO WS-CZ
     PERFORM ROUND-TRIP
     MOVE "test debug codec chunk (12, 12) round trip" TO TL-CASE
     COMPUTE TL-OBSERVED-N = PB-ERROR * 100000 + WS-BAD
     MOVE 0 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

*>   A section of 4096 distinct states: a palette above 256 values is direct.
     MOVE 60 TO WS-CX
     MOVE 60 TO WS-CZ
     CALL "WORLD-CHUNK" USING WS-DIM WS-CX WS-CZ WS-ROW
     SET ADDRESS OF CE-CHUNK TO CK-ADDR(WS-ROW)
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 4096
         COMPUTE CE-STATE(8 * 4096 + WS-I) = 17000 + WS-I * 3
     END-PERFORM
     MOVE 1 TO CK-LIT(WS-ROW)
     PERFORM ROUND-TRIP
     MOVE "test debug codec a section of 4096 distinct states uses the direct form and reads back" TO TL-CASE
     MOVE 0 TO WS-DISTINCT
     INITIALIZE WS-SEEN-TABLE
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 4096
         IF WS-SEEN(CH-STATE(8 * 4096 + WS-I) + 1) = 0
             MOVE 1 TO WS-SEEN(CH-STATE(8 * 4096 + WS-I) + 1)
             ADD 1 TO WS-DISTINCT
         END-IF
     END-PERFORM
     COMPUTE TL-OBSERVED-N = PB-ERROR * 10000000 + WS-BAD * 10000 + WS-DISTINCT
     MOVE 4096 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 ROUND-TRIP.
     CALL "WORLD-CHUNK" USING WS-DIM WS-CX WS-CZ WS-ROW
     SET ADDRESS OF CE-CHUNK TO CK-ADDR(WS-ROW)
     CALL "PB-RESET" USING PB-BUFFER
     CALL "CHUNK-PACKET-BUILD" USING WS-DIM WS-CX WS-CZ PB-BUFFER
     MOVE 0 TO PB-POS
     CALL "PB-GET-UBYTE" USING PB-BUFFER WS-BYTE
     CALL "PB-GET-CHUNK-24" USING PB-BUFFER CH-X CH-Z CH-SECTIONS CH-HM-BITS CH-HM-MASK CH-HM-VALUES
         CH-COUNTS CH-STATES CH-BIOMES CH-BLOCK-GBITS CH-BIOME-GBITS CH-BE-MAX CH-BE-DATA-MAX
         CH-BE-COUNT CH-BE-HEADS CH-BE-DATA CH-SKY-STATES CH-SKY-ARRAYS CH-BLK-STATES
         CH-BLK-ARRAYS
     MOVE 0 TO WS-BAD
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 98304
         IF CH-STATE(WS-I) NOT = CE-STATE(WS-I)
             ADD 1 TO WS-BAD
         END-IF
     END-PERFORM.
 END PROGRAM TEST-DEBUG-CODEC.

 COPY CORETEST.
