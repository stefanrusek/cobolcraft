     MOVE "4 4 1 1 9" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-REP-LOCK-SIDE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "15 0 0 0 9" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 30-2§3 Repeater: isLocked (3.4): getAlternateSignal above 0" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-REP-IS-LOCKED" USING WS-I1 WS-R1
