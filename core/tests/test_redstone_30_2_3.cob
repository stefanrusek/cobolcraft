     MOVE "5 2" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-REP-WIRE" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "4 5" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-REP-WIRE" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "2 5" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-REP-WIRE" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
