     PERFORM LOAD-IN
     CALL "RS1-REP-USE" USING WS-I1 WS-I2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1 2" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-REP-USE" USING WS-I1 WS-I2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1 3" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-REP-USE" USING WS-I1 WS-I2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1 4" TO WS-IN
