     MOVE "1 1 0 0 1 0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 30-2§3 Repeater: animateTick (3.6): x + 0.5 + (r1 - 0.5) * 0.2, y + 0.4 + (r2 - 0.5) * 0.2, z + 0.5 + (r3 - 0.5) * 0.2, then the offset -5 pixels, or delay * 2 - 1 when" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "5 64 3 2 1 0 0.1 0.2 0.3" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-REP-PARTICLE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-FX7 WS-FX8 WS-FX9 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "5 64 3 2 4 1 0.1 0.2 0.3" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-REP-PARTICLE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-FX7 WS-FX8 WS-FX9 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
