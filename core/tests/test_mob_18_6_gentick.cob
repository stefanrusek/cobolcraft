*> Implementation test (002-lane-mobsfull-h22; docs/protocol/18-mob-framework.md section 6.10): chunk-generation spawns run on the main thread.
*> A chunk generated by WORLD-CHUNK-LOAD is marked fresh (CK-FRESH); MS6-CHUNK-GEN-TICK (called by STDMOB-SPAWN-TICK) gives each fresh chunk of a standard
*> world one MS6-CHUNK-GEN-BIOME pass and clears the mark, so a chunk is processed once; spawn_mobs false spawns nothing but still clears the marks.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-MOB-18-6-GENTICK.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY CONTENT.
 01 WS-CASE                PIC X(120).
 01 WS-E                   BINARY-DOUBLE.
 01 WS-O                   BINARY-DOUBLE.
 01 WS-PLAYER              BINARY-LONG.
 01 WS-DIM                 BINARY-LONG.
 01 WS-CX                  BINARY-LONG.
 01 WS-CZ                  BINARY-LONG.
 01 WS-ROW                 BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-FRESH               BINARY-LONG.
 01 WS-N                   BINARY-LONG.
 01 WS-MOBS                BINARY-LONG.
 01 WS-BEFORE              BINARY-LONG.
 01 WS-X0                 BINARY-LONG VALUE 640.
 01 WS-Z0                 BINARY-LONG VALUE 640.
 01 WS-SIZE                BINARY-LONG VALUE 96.
 01 WS-FY                  BINARY-LONG VALUE 63.
 01 WS-KIND                BINARY-LONG VALUE 2.
 01 WS-TYPE                BINARY-LONG.
 01 WS-RULE-NAME           PIC X(40) VALUE "spawn_mobs".
 01 WS-RULE-INDEX          BINARY-LONG.
 01 WS-RULE-VALUE          BINARY-DOUBLE.
 LINKAGE SECTION.
 COPY COREAPI.
 PROCEDURE DIVISION.
     CALL "MS-TEST-OPEN" USING WS-PLAYER
     MOVE PL-DIM(WS-PLAYER) TO WS-DIM
     PERFORM COUNT-FRESH
     MOVE "implementation 18§6.10 gen tick: the chunks of the join are fresh" TO WS-CASE
     MOVE 1 TO WS-E
     MOVE 0 TO WS-O
     IF WS-FRESH > 0
         MOVE 1 TO WS-O
     END-IF
     PERFORM CHECK-N
     PERFORM VARYING WS-CX FROM 40 BY 1 UNTIL WS-CX > 45
         PERFORM VARYING WS-CZ FROM 40 BY 1 UNTIL WS-CZ > 45
             CALL "WORLD-CHUNK-LOAD" USING WS-DIM WS-CX WS-CZ WS-ROW
         END-PERFORM
     END-PERFORM
     CALL "MS-TEST-FLOOR" USING WS-DIM WS-X0 WS-Z0 WS-SIZE WS-FY WS-KIND
     CALL "MS6-CHUNK-GEN-TICK" USING WS-N
     MOVE 0 TO WS-MOBS
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > EN-COUNT
         IF EN-USED(WS-I) = 1 AND EN-PLAYER(WS-I) = 0
             ADD 1 TO WS-MOBS
         END-IF
     END-PERFORM
     MOVE "implementation 18§6.10 gen tick: animals appeared (0.1 packs per chunk of 36 chunks)" TO WS-CASE
     MOVE 1 TO WS-E
     MOVE 0 TO WS-O
     IF WS-N > 0
         MOVE 1 TO WS-O
     END-IF
     PERFORM CHECK-N
     MOVE "implementation 18§6.10 gen tick: the count equals the new entity rows" TO WS-CASE
     MOVE WS-N TO WS-E
     MOVE WS-MOBS TO WS-O
     PERFORM CHECK-N
     PERFORM COUNT-FRESH
     MOVE "implementation 18§6.10 gen tick: no chunk stays fresh" TO WS-CASE
     MOVE 0 TO WS-E
     MOVE WS-FRESH TO WS-O
     PERFORM CHECK-N
     MOVE WS-MOBS TO WS-BEFORE
     CALL "MS6-CHUNK-GEN-TICK" USING WS-N
     MOVE "implementation 18§6.10 gen tick: a second pass finds nothing fresh" TO WS-CASE
     MOVE 0 TO WS-E
     MOVE WS-N TO WS-O
     PERFORM CHECK-N
     CALL "BR-RULE-FIND" USING WS-RULE-NAME WS-RULE-INDEX
     MOVE 0 TO WS-RULE-VALUE
     CALL "BR-RULE-SET" USING WS-RULE-INDEX WS-RULE-VALUE
     PERFORM VARYING WS-CX FROM 50 BY 1 UNTIL WS-CX > 59
         PERFORM VARYING WS-CZ FROM 50 BY 1 UNTIL WS-CZ > 59
             CALL "WORLD-CHUNK-LOAD" USING WS-DIM WS-CX WS-CZ WS-ROW
         END-PERFORM
     END-PERFORM
     CALL "MS6-CHUNK-GEN-TICK" USING WS-N
     MOVE "implementation 18§6.10 gen tick: spawn_mobs false spawns nothing" TO WS-CASE
     MOVE 0 TO WS-E
     MOVE WS-N TO WS-O
     PERFORM CHECK-N
     PERFORM COUNT-FRESH
     MOVE "implementation 18§6.10 gen tick: spawn_mobs false still clears the marks" TO WS-CASE
     MOVE 0 TO WS-E
     MOVE WS-FRESH TO WS-O
     PERFORM CHECK-N
     SET ADDRESS OF CORE-SETTINGS TO ADDRESS OF CW-SETTINGS
     MOVE CT-SET-TYPE TO WS-TYPE
     COMPUTE CT-SET-TYPE = CT-TYPE-STANDARD + 1
     CALL "WORLD-CHUNK-LOAD" USING WS-DIM WS-CX WS-CZ WS-ROW
     MOVE 70 TO WS-CX
     CALL "WORLD-CHUNK-LOAD" USING WS-DIM WS-CX WS-CZ WS-ROW
     CALL "MS6-CHUNK-GEN-TICK" USING WS-N
     MOVE WS-TYPE TO CT-SET-TYPE
     PERFORM COUNT-FRESH
     MOVE "implementation 18§6.10 gen tick: another world type does nothing and keeps the marks" TO WS-CASE
     MOVE 1 TO WS-E
     MOVE 0 TO WS-O
     IF WS-N = 0 AND WS-FRESH > 0
         MOVE 1 TO WS-O
     END-IF
     PERFORM CHECK-N
     STOP RUN.
 COUNT-FRESH.
     MOVE 0 TO WS-FRESH
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > CK-COUNT
         IF CK-USED(WS-I) = 1 AND CK-FRESH(WS-I) = 1
             ADD 1 TO WS-FRESH
         END-IF
     END-PERFORM.
 CHECK-N.
     MOVE "N" TO TL-MODE
     MOVE WS-CASE TO TL-CASE
     MOVE WS-E TO TL-EXPECTED-N
     MOVE WS-O TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-MOB-18-6-GENTICK.
 COPY CORETEST.
 COPY MOBSPTEST.
