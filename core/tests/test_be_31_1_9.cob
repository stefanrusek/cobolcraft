*> Test of 31 section 9 (The container family; T0857): Container defaults (max stack 99, clamping, removeItem splitting), the lock and loot
*> rules of canOpen, unpackLootTable's state change, default names and sizes, and the comparator signal formula (9.5, worked example 3).
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-BE-31-1-9.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY BESTATE.
 COPY PROTO.
 01 WS-TEXT                PIC X(8192).
 01 WS-EDIT                PIC -(9)9.
 01 WS-EDIT2               PIC -(9)9.
 01 WS-EDIT3               PIC -(9)9.
 01 WS-EDIT4               PIC -(9)9.
 01 WS-I                   BINARY-LONG.
 01 WS-LEN                 BINARY-LONG.
 01 WS-IDX                 BINARY-LONG.
 01 WS-CAPACITY            BINARY-LONG VALUE 4096.
 01 WS-ZERO                BINARY-LONG VALUE 0.
 01 WS-TYPE10              BINARY-LONG VALUE 10.
 COPY COREAPI.
     COPY CITEMS.
 01 WS-D                   BINARY-LONG VALUE 1.
 01 WS-X                   BINARY-LONG VALUE 5.
 01 WS-Y                   BINARY-LONG VALUE 70.
 01 WS-Z                   BINARY-LONG VALUE 5.
 01 WS-T                   BINARY-LONG.
 01 WS-KEY                 PIC X(48).
 01 WS-CHEST               BINARY-LONG.
 01 WS-CHEST2              BINARY-LONG.
 01 WS-A                   BINARY-LONG.
 01 WS-B                   BINARY-LONG.
 01 WS-C                   BINARY-LONG.
 01 WS-N                   BINARY-LONG.
 01 WS-SLOT                BINARY-LONG.
 01 WS-ITEM                BINARY-LONG.
 01 WS-COUNT               BINARY-LONG.
 01 WS-VAR                 BINARY-LONG VALUE 0.
 01 WS-MAX                 BINARY-LONG.
 01 WS-SPEC                BINARY-LONG.
 01 WS-HOLD                PIC X(48).
 01 WS-HLEN                BINARY-LONG.
 01 WS-CAN                 BINARY-LONG.
 01 WS-NOTIFY              BINARY-LONG.
 01 WS-TABLE               PIC X(64).
 01 WS-TLEN                BINARY-LONG.
 01 WS-SEED                BINARY-DOUBLE.
 01 WS-RESULT              BINARY-LONG.
 01 WS-SIGNAL              BINARY-LONG.
 01 WS-K32                 PIC X(32).
 01 WS-SIZE                BINARY-LONG.
 01 WS-PTR                 BINARY-LONG.
 01 WS-BIG                 BINARY-LONG.
 01 WS-ZERO0               BINARY-LONG VALUE 0.
 01 WS-EDIT5               PIC -(9)9.
 01 WS-EDIT6               PIC -(9)9.
 01 WS-EDIT7               PIC -(9)9.
 01 WS-EDIT8               PIC -(9)9.
 01 WS-EDIT9               PIC -(9)9.
 01 WS-EDIT10              PIC -(9)9.
 01 WS-TEXT2               PIC X(8192).
 PROCEDURE DIVISION.
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     MOVE "minecraft:chest" TO WS-KEY
     MOVE 15 TO WS-LEN
     MOVE 1 TO WS-T
     CALL "BE-CREATE" USING WS-D WS-X WS-Y WS-Z WS-T WS-KEY WS-LEN WS-CHEST
     ADD 1 TO WS-X
     CALL "BE-CREATE" USING WS-D WS-X WS-Y WS-Z WS-T WS-KEY WS-LEN WS-CHEST2
     MOVE 0 TO WS-BIG
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > IT-COUNT
         IF IT-MAX-STACK(WS-I) = 64 AND WS-BIG = 0
             COMPUTE WS-BIG = WS-I - 1
         END-IF
     END-PERFORM

     MOVE "acceptance US12 31-1§9 container: getMaxStackSize(stack) is min(99, the item's own maximum)" TO TL-CASE
     MOVE 64 TO WS-A
     CALL "BE-MAX-STACK" USING WS-A WS-B
     MOVE 120 TO WS-A
     CALL "BE-MAX-STACK" USING WS-A WS-C
     MOVE 16 TO WS-A
     CALL "BE-MAX-STACK" USING WS-A WS-N
     MOVE WS-B TO WS-EDIT
     MOVE WS-C TO WS-EDIT2
     MOVE WS-N TO WS-EDIT3
     MOVE SPACES TO WS-TEXT
     STRING FUNCTION TRIM(WS-EDIT) " " FUNCTION TRIM(WS-EDIT2) " " FUNCTION TRIM(WS-EDIT3) DELIMITED BY SIZE INTO WS-TEXT
     MOVE "64 99 16" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 31-1§9 container: setItem clamps the stack to the maximum and calls setChanged" TO TL-CASE
     MOVE 0 TO WS-SLOT
     MOVE 5 TO WS-ITEM
     MOVE 120 TO WS-COUNT
     MOVE 64 TO WS-MAX
     CALL "BE-SET-ITEM" USING WS-CHEST WS-SLOT WS-ITEM WS-COUNT WS-VAR WS-MAX
     MOVE BE-SLOT-COUNT(WS-CHEST, 1) TO WS-EDIT
     MOVE BE-CHANGED(WS-CHEST) TO WS-EDIT2
     MOVE 1 TO WS-SLOT
     MOVE 1000 TO WS-MAX
     CALL "BE-SET-ITEM" USING WS-CHEST WS-SLOT WS-ITEM WS-COUNT WS-VAR WS-MAX
     MOVE BE-SLOT-COUNT(WS-CHEST, 2) TO WS-EDIT3
     MOVE SPACES TO WS-TEXT
     STRING FUNCTION TRIM(WS-EDIT) " " FUNCTION TRIM(WS-EDIT2) " " FUNCTION TRIM(WS-EDIT3) DELIMITED BY SIZE INTO WS-TEXT
     MOVE "64 1 99" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 31-1§9 container: removeItem splits up to n, does nothing for an empty or invalid slot or n <= 0; removeItemNoUpdate takes the slot without setChanged" TO TL-CASE
     MOVE 0 TO BE-CHANGED(WS-CHEST)
     MOVE 0 TO WS-SLOT
     MOVE 10 TO WS-N
     CALL "BE-REMOVE-ITEM" USING WS-CHEST WS-SLOT WS-N WS-ITEM WS-COUNT
     MOVE WS-COUNT TO WS-EDIT
     MOVE BE-SLOT-COUNT(WS-CHEST, 1) TO WS-EDIT2
     MOVE BE-CHANGED(WS-CHEST) TO WS-EDIT3
     MOVE 0 TO BE-CHANGED(WS-CHEST)
     MOVE 5 TO WS-SLOT
     CALL "BE-REMOVE-ITEM" USING WS-CHEST WS-SLOT WS-N WS-ITEM WS-COUNT
     MOVE WS-COUNT TO WS-EDIT4
     MOVE 27 TO WS-SLOT
     CALL "BE-REMOVE-ITEM" USING WS-CHEST WS-SLOT WS-N WS-ITEM WS-COUNT
     MOVE WS-COUNT TO WS-A
     MOVE 0 TO WS-SLOT
     MOVE 0 TO WS-N
     CALL "BE-REMOVE-ITEM" USING WS-CHEST WS-SLOT WS-N WS-ITEM WS-COUNT
     MOVE WS-COUNT TO WS-B
     MOVE 100 TO WS-N
     CALL "BE-REMOVE-ITEM" USING WS-CHEST WS-SLOT WS-N WS-ITEM WS-COUNT
     MOVE WS-COUNT TO WS-C
     MOVE BE-SLOT-COUNT(WS-CHEST, 1) TO WS-N
     MOVE 0 TO BE-CHANGED(WS-CHEST)
     MOVE 1 TO WS-SLOT
     CALL "BE-REMOVE-NO-UPDATE" USING WS-CHEST WS-SLOT WS-ITEM WS-COUNT
     MOVE SPACES TO WS-TEXT
     MOVE WS-COUNT TO WS-EDIT5
     MOVE BE-CHANGED(WS-CHEST) TO WS-EDIT6
     MOVE WS-A TO WS-EDIT7
     MOVE WS-B TO WS-EDIT8
     MOVE WS-C TO WS-EDIT9
     MOVE WS-N TO WS-EDIT10
     STRING FUNCTION TRIM(WS-EDIT) " " FUNCTION TRIM(WS-EDIT2) " " FUNCTION TRIM(WS-EDIT3) " | "
         FUNCTION TRIM(WS-EDIT4) " " FUNCTION TRIM(WS-EDIT7) " " FUNCTION TRIM(WS-EDIT8) " " FUNCTION TRIM(WS-EDIT9) " "
         FUNCTION TRIM(WS-EDIT10) " | " FUNCTION TRIM(WS-EDIT5) " " FUNCTION TRIM(WS-EDIT6) DELIMITED BY SIZE INTO WS-TEXT
     MOVE "10 54 1 | 0 0 0 54 0 | 99 0" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 31-1§9 container: isEmpty and countItem over the slots" TO TL-CASE
     MOVE 5 TO BE-SLOT-ITEM(WS-CHEST, 3)
     MOVE 7 TO BE-SLOT-COUNT(WS-CHEST, 3)
     MOVE 9 TO BE-SLOT-ITEM(WS-CHEST, 4)
     MOVE 2 TO BE-SLOT-COUNT(WS-CHEST, 4)
     CALL "BE-IS-EMPTY" USING WS-CHEST WS-A
     CALL "BE-IS-EMPTY" USING WS-CHEST2 WS-B
     MOVE 5 TO WS-ITEM
     CALL "BE-COUNT-ITEM" USING WS-CHEST WS-ITEM WS-COUNT
     MOVE WS-A TO WS-EDIT
     MOVE WS-B TO WS-EDIT2
     MOVE WS-COUNT TO WS-EDIT3
     MOVE SPACES TO WS-TEXT
     STRING FUNCTION TRIM(WS-EDIT) " " FUNCTION TRIM(WS-EDIT2) " " FUNCTION TRIM(WS-EDIT3) DELIMITED BY SIZE INTO WS-TEXT
     MOVE "0 1 7" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 31-1§9 container: canOpen: unlocked opens; a lock needs the key in hand or a spectator; a loot table shuts spectators out silently; a refusal notifies only non-spectators" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     MOVE SPACES TO WS-HOLD
     MOVE 0 TO WS-HLEN
     MOVE 0 TO WS-SPEC
     CALL "BE-CAN-OPEN" USING WS-CHEST2 WS-SPEC WS-HOLD WS-HLEN WS-CAN WS-NOTIFY
     PERFORM CAN-TEXT
     MOVE "minecraft:tripwire_hook" TO BE-LOCK(WS-CHEST2)
     MOVE 23 TO BE-LOCK-LENGTH(WS-CHEST2)
     MOVE "minecraft:tripwire_hook" TO WS-HOLD
     MOVE 23 TO WS-HLEN
     CALL "BE-CAN-OPEN" USING WS-CHEST2 WS-SPEC WS-HOLD WS-HLEN WS-CAN WS-NOTIFY
     PERFORM CAN-TEXT
     MOVE "minecraft:stick" TO WS-HOLD
     MOVE 15 TO WS-HLEN
     CALL "BE-CAN-OPEN" USING WS-CHEST2 WS-SPEC WS-HOLD WS-HLEN WS-CAN WS-NOTIFY
     PERFORM CAN-TEXT
     MOVE 1 TO WS-SPEC
     CALL "BE-CAN-OPEN" USING WS-CHEST2 WS-SPEC WS-HOLD WS-HLEN WS-CAN WS-NOTIFY
     PERFORM CAN-TEXT
     MOVE SPACES TO BE-LOCK(WS-CHEST2)
     MOVE 0 TO BE-LOCK-LENGTH(WS-CHEST2)
     MOVE "minecraft:chests/x" TO BE-LOOT(WS-CHEST2)
     MOVE 18 TO BE-LOOT-LENGTH(WS-CHEST2)
     CALL "BE-CAN-OPEN" USING WS-CHEST2 WS-SPEC WS-HOLD WS-HLEN WS-CAN WS-NOTIFY
     PERFORM CAN-TEXT
     MOVE 0 TO WS-SPEC
     CALL "BE-CAN-OPEN" USING WS-CHEST2 WS-SPEC WS-HOLD WS-HLEN WS-CAN WS-NOTIFY
     PERFORM CAN-TEXT
     MOVE "1 0 | 1 0 | 0 1 | 1 0 | 0 0 | 1 0 |" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 31-1§9 container: unpackLootTable hands over the table and the seed, clears the table key and keeps the seed; a second call does nothing" TO TL-CASE
     MOVE 4242 TO BE-SEED(WS-CHEST2)
     CALL "BE-LOOT-UNPACK" USING WS-CHEST2 WS-TABLE WS-TLEN WS-SEED WS-RESULT
     MOVE WS-RESULT TO WS-EDIT
     MOVE WS-SEED TO WS-EDIT2
     MOVE BE-LOOT-LENGTH(WS-CHEST2) TO WS-EDIT3
     MOVE BE-SEED(WS-CHEST2) TO WS-EDIT4
     MOVE SPACES TO WS-TEXT
     STRING FUNCTION TRIM(WS-EDIT) " " WS-TABLE(1:WS-TLEN) " " FUNCTION TRIM(WS-EDIT2) " " FUNCTION TRIM(WS-EDIT3) " "
         FUNCTION TRIM(WS-EDIT4) DELIMITED BY SIZE INTO WS-TEXT
     CALL "BE-LOOT-UNPACK" USING WS-CHEST2 WS-TABLE WS-TLEN WS-SEED WS-RESULT
     MOVE WS-RESULT TO WS-EDIT
     MOVE SPACES TO WS-TEXT2
     STRING FUNCTION TRIM(WS-TEXT) " then " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO WS-TEXT2
     MOVE WS-TEXT2 TO WS-TEXT
     MOVE "1 minecraft:chests/x 4242 0 4242 then 0" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 31-1§9 container: default names and sizes: chest and trapped chest container.chest, barrel container.barrel, shulker box container.shulkerBox, ender chest container.enderchest, 27 slots" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     PERFORM VARYING WS-T FROM 1 BY 1 UNTIL WS-T > 26
         IF WS-T = 1 OR WS-T = 2 OR WS-T = 3 OR WS-T = 24 OR WS-T = 26
             CALL "BE-DEFAULT-NAME" USING WS-T WS-K32 WS-LEN
             CALL "BE-CONTAINER-SIZE" USING WS-T WS-SIZE
             MOVE WS-SIZE TO WS-EDIT
             STRING WS-K32(1:WS-LEN) "=" FUNCTION TRIM(WS-EDIT) " " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
         END-IF
     END-PERFORM
     MOVE 4 TO WS-T
     CALL "BE-CONTAINER-SIZE" USING WS-T WS-SIZE
     MOVE WS-SIZE TO WS-EDIT
     STRING "jukebox=" FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE "container.chest=27 container.chest=27 container.enderchest=27 container.shulkerBox=27 container.barrel=27 jukebox=0" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 31-1§9 container: comparator signal: empty 0, one item 1, 14 of 27 slots full 8, all full 15; a double chest reads 54 slots" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     MOVE 0 TO WS-N
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 27
         MOVE 0 TO BE-SLOT-ITEM(WS-CHEST, WS-I) BE-SLOT-COUNT(WS-CHEST, WS-I)
         MOVE 0 TO BE-SLOT-ITEM(WS-CHEST2, WS-I) BE-SLOT-COUNT(WS-CHEST2, WS-I)
     END-PERFORM
     CALL "BE-SIGNAL" USING WS-CHEST WS-ZERO0 WS-SIGNAL
     PERFORM SIGNAL-TEXT
     MOVE WS-BIG TO BE-SLOT-ITEM(WS-CHEST, 1)
     MOVE 1 TO BE-SLOT-COUNT(WS-CHEST, 1)
     CALL "BE-SIGNAL" USING WS-CHEST WS-ZERO0 WS-SIGNAL
     PERFORM SIGNAL-TEXT
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 14
         MOVE WS-BIG TO BE-SLOT-ITEM(WS-CHEST, WS-I)
         MOVE 64 TO BE-SLOT-COUNT(WS-CHEST, WS-I)
     END-PERFORM
     CALL "BE-SIGNAL" USING WS-CHEST WS-ZERO0 WS-SIGNAL
     PERFORM SIGNAL-TEXT
     CALL "BE-SIGNAL" USING WS-CHEST WS-CHEST2 WS-SIGNAL
     PERFORM SIGNAL-TEXT
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 27
         MOVE WS-BIG TO BE-SLOT-ITEM(WS-CHEST, WS-I)
         MOVE 64 TO BE-SLOT-COUNT(WS-CHEST, WS-I)
     END-PERFORM
     CALL "BE-SIGNAL" USING WS-CHEST WS-ZERO0 WS-SIGNAL
     PERFORM SIGNAL-TEXT
     MOVE "0 1 8 4 15" TO TL-EXPECTED
     PERFORM CHECK
     GOBACK.

 CAN-TEXT.
     MOVE WS-CAN TO WS-EDIT
     MOVE WS-NOTIFY TO WS-EDIT2
     STRING FUNCTION TRIM(WS-EDIT) " " FUNCTION TRIM(WS-EDIT2) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR.

 SIGNAL-TEXT.
     MOVE WS-SIGNAL TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) " " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR.

 CHECK.
     MOVE "T" TO TL-MODE
     MOVE WS-TEXT TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-BE-31-1-9.

 COPY CORETEST.
