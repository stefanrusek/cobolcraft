*> Acceptance test, drinking a potion (docs/protocol/25 section 9.1 and 9.2; lane itemcomp, T9606): Use Item with a potion in the main hand starts drinking; after 32 ticks the effects of its
*> potion_contents apply (the table rows then the custom effects; instant effects at once) and the stack becomes a glass bottle; releasing, changing slot or item cancels; a water bottle only gives the bottle.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. ACC-ITEMCOMP-DRINK.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY PLAYPKT.
 01 WS-PLAYER              BINARY-LONG.
 01 WS-CONN                BINARY-LONG.
 01 WS-KEY                 PIC X(112).
 01 WS-ITEM-ROW            PIC X(270).
 01 WS-STATUS              BINARY-LONG.
 01 WS-POTION-ITEM         BINARY-LONG.
 01 WS-BOTTLE-ITEM         BINARY-LONG.
 01 WS-STICK-ITEM          BINARY-LONG.
 01 WS-DONE                BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-SLOT                BINARY-LONG.
 01 WS-HANDLE              BINARY-LONG.
 01 WS-POTION              BINARY-LONG.
 01 WS-EFFECT              BINARY-LONG.
 01 WS-AMP                 BINARY-LONG.
 01 WS-DUR                 BINARY-LONG.
 01 WS-LEVEL               BINARY-LONG.
 01 WS-TICKS               BINARY-LONG.
 01 WS-E1                  PIC -(9)9.
 01 WS-E2                  PIC -(9)9.
 01 WS-E3                  PIC -(9)9.
 01 WS-E4                  PIC -(9)9.
 PROCEDURE DIVISION.
     CALL "MS-TEST-OPEN" USING WS-PLAYER
     MOVE "T" TO TL-MODE
     MOVE 0 TO WS-CONN
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > CORE-MAX-CONNS
         IF CN-PLAYER(WS-I) = WS-PLAYER
             MOVE WS-I TO WS-CONN
         END-IF
     END-PERFORM
     MOVE "minecraft:potion" TO WS-KEY
     CALL "CONTENT-ITEM-BY-KEY" USING WS-KEY WS-POTION-ITEM WS-ITEM-ROW WS-STATUS
     MOVE "minecraft:glass_bottle" TO WS-KEY
     CALL "CONTENT-ITEM-BY-KEY" USING WS-KEY WS-BOTTLE-ITEM WS-ITEM-ROW WS-STATUS
     MOVE "minecraft:stick" TO WS-KEY
     CALL "CONTENT-ITEM-BY-KEY" USING WS-KEY WS-STICK-ITEM WS-ITEM-ROW WS-STATUS
     COMPUTE WS-SLOT = PL-HELD(WS-PLAYER) + 1
     MOVE 0 TO PSB-HAND

     MOVE "acceptance itemcomp 25-9 a swiftness potion with a custom jump boost applies both after 32 ticks and leaves a glass bottle" TO TL-CASE
     MOVE 0 TO WS-HANDLE
     MOVE 13 TO WS-POTION
     CALL "SC-POTION-SET" USING WS-HANDLE WS-POTION
     MOVE 7 TO WS-EFFECT
     MOVE 1 TO WS-AMP
     MOVE 200 TO WS-DUR
     CALL "SC-POTION-ADD-EFFECT" USING WS-HANDLE WS-EFFECT WS-AMP WS-DUR
     PERFORM GIVE-POTION
     CALL "POTION-DRINK-USE" USING WS-CONN PLAY-SERVERBOUND WS-DONE
     PERFORM 31 TIMES
         ADD 1 TO CW-TICKS
         CALL "POTION-DRINK-TICK" USING WS-PLAYER
     END-PERFORM
     MOVE 0 TO WS-POTION
     CALL "EFFECT-LEVEL" USING WS-PLAYER WS-POTION WS-LEVEL WS-TICKS
     MOVE WS-DONE TO WS-E1
     MOVE WS-LEVEL TO WS-E2
     ADD 1 TO CW-TICKS
     CALL "POTION-DRINK-TICK" USING WS-PLAYER
     MOVE 0 TO WS-POTION
     CALL "EFFECT-LEVEL" USING WS-PLAYER WS-POTION WS-LEVEL WS-TICKS
     MOVE WS-LEVEL TO WS-E3
     MOVE 7 TO WS-EFFECT
     CALL "EFFECT-LEVEL" USING WS-PLAYER WS-EFFECT WS-LEVEL WS-TICKS
     MOVE WS-LEVEL TO WS-E4
     MOVE SPACES TO TL-OBSERVED
     STRING "started=" FUNCTION TRIM(WS-E1) " early speed=" FUNCTION TRIM(WS-E2) " speed=" FUNCTION TRIM(WS-E3) " jump=" FUNCTION TRIM(WS-E4)
         DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "started=1 early speed=0 speed=1 jump=2" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance itemcomp 25-9 the drunk stack is a glass bottle without a patch" TO TL-CASE
     IF PL-SLOT-ITEM(WS-PLAYER, WS-SLOT) = WS-BOTTLE-ITEM AND PL-SLOT-COUNT(WS-PLAYER, WS-SLOT) = 1 AND PL-SLOT-VAR(WS-PLAYER, WS-SLOT) = 0
         MOVE "bottle" TO TL-OBSERVED
     ELSE
         MOVE "other" TO TL-OBSERVED
     END-IF
     MOVE "bottle" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance itemcomp 25-9 a healing potion heals at once on completion, a water bottle gives only the bottle" TO TL-CASE
     MOVE 6 TO PL-HEALTH(WS-PLAYER)
     MOVE 0 TO WS-HANDLE
     MOVE 24 TO WS-POTION
     CALL "SC-POTION-SET" USING WS-HANDLE WS-POTION
     PERFORM GIVE-POTION
     PERFORM DRINK-ALL
     MOVE PL-HEALTH(WS-PLAYER) TO WS-E1
     MOVE 0 TO WS-HANDLE
     MOVE 0 TO WS-POTION
     CALL "SC-POTION-SET" USING WS-HANDLE WS-POTION
     PERFORM GIVE-POTION
     PERFORM DRINK-ALL
     IF PL-SLOT-ITEM(WS-PLAYER, WS-SLOT) = WS-BOTTLE-ITEM
         MOVE "bottle" TO WS-KEY
     ELSE
         MOVE "other" TO WS-KEY
     END-IF
     MOVE SPACES TO TL-OBSERVED
     STRING "health=" FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-KEY) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "health=10 bottle" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance itemcomp 25-9 releasing the item cancels the drink and the potion stays" TO TL-CASE
     MOVE 0 TO WS-HANDLE
     MOVE 11 TO WS-POTION
     CALL "SC-POTION-SET" USING WS-HANDLE WS-POTION
     PERFORM GIVE-POTION
     CALL "POTION-DRINK-USE" USING WS-CONN PLAY-SERVERBOUND WS-DONE
     CALL "HUNGER-CANCEL" USING WS-PLAYER
     PERFORM 40 TIMES
         ADD 1 TO CW-TICKS
         CALL "POTION-DRINK-TICK" USING WS-PLAYER
     END-PERFORM
     IF PL-SLOT-ITEM(WS-PLAYER, WS-SLOT) = WS-POTION-ITEM
         MOVE "kept" TO TL-OBSERVED
     ELSE
         MOVE "drunk" TO TL-OBSERVED
     END-IF
     MOVE "kept" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance itemcomp 25-9 changing the held item during the drink cancels it; a stick or a dead player does not start one" TO TL-CASE
     CALL "POTION-DRINK-USE" USING WS-CONN PLAY-SERVERBOUND WS-DONE
     MOVE WS-STICK-ITEM TO PL-SLOT-ITEM(WS-PLAYER, WS-SLOT)
     PERFORM 40 TIMES
         ADD 1 TO CW-TICKS
         CALL "POTION-DRINK-TICK" USING WS-PLAYER
     END-PERFORM
     MOVE PL-SLOT-ITEM(WS-PLAYER, WS-SLOT) TO WS-E1
     MOVE WS-STICK-ITEM TO WS-E2
     CALL "POTION-DRINK-USE" USING WS-CONN PLAY-SERVERBOUND WS-DONE
     MOVE WS-DONE TO WS-E3
     PERFORM GIVE-POTION
     MOVE 1 TO PSB-HAND
     CALL "POTION-DRINK-USE" USING WS-CONN PLAY-SERVERBOUND WS-DONE
     MOVE WS-DONE TO WS-E4
     MOVE 0 TO PSB-HAND
     MOVE SPACES TO TL-OBSERVED
     IF WS-E1 = WS-E2
         MOVE "stick" TO WS-KEY
     ELSE
         MOVE "changed" TO WS-KEY
     END-IF
     STRING FUNCTION TRIM(WS-KEY) " stickuse=" FUNCTION TRIM(WS-E3) " offhand=" FUNCTION TRIM(WS-E4) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "stick stickuse=0 offhand=0" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance itemcomp 25-9 a creative player drinks and keeps the stack; a drink for a row that changed player is dropped" TO TL-CASE
     MOVE 1 TO PL-MODE(WS-PLAYER)
     MOVE 0 TO WS-HANDLE
     MOVE 13 TO WS-POTION
     CALL "SC-POTION-SET" USING WS-HANDLE WS-POTION
     PERFORM GIVE-POTION
     PERFORM DRINK-ALL
     IF PL-SLOT-ITEM(WS-PLAYER, WS-SLOT) = WS-POTION-ITEM
         MOVE "kept" TO WS-KEY
     ELSE
         MOVE "gone" TO WS-KEY
     END-IF
     MOVE 0 TO PL-MODE(WS-PLAYER)
     CALL "POTION-DRINK-USE" USING WS-CONN PLAY-SERVERBOUND WS-DONE
     ADD 1 TO PL-ENTITY-ID(WS-PLAYER)
     PERFORM 40 TIMES
         ADD 1 TO CW-TICKS
         CALL "POTION-DRINK-TICK" USING WS-PLAYER
     END-PERFORM
     SUBTRACT 1 FROM PL-ENTITY-ID(WS-PLAYER)
     IF PL-SLOT-ITEM(WS-PLAYER, WS-SLOT) = WS-POTION-ITEM
         MOVE "kept" TO TL-OBSERVED
     ELSE
         MOVE "drunk" TO TL-OBSERVED
     END-IF
     STRING " " FUNCTION TRIM(WS-KEY) DELIMITED BY SIZE INTO WS-ITEM-ROW
     MOVE SPACES TO WS-ITEM-ROW
     STRING FUNCTION TRIM(WS-KEY) " " FUNCTION TRIM(TL-OBSERVED) DELIMITED BY SIZE INTO WS-ITEM-ROW
     MOVE WS-ITEM-ROW TO TL-OBSERVED
     MOVE "kept kept" TO TL-EXPECTED
     PERFORM CHECK
     STOP RUN.

 GIVE-POTION.
     MOVE WS-POTION-ITEM TO PL-SLOT-ITEM(WS-PLAYER, WS-SLOT)
     MOVE 1 TO PL-SLOT-COUNT(WS-PLAYER, WS-SLOT)
     MOVE WS-HANDLE TO PL-SLOT-VAR(WS-PLAYER, WS-SLOT).

 DRINK-ALL.
     CALL "POTION-DRINK-USE" USING WS-CONN PLAY-SERVERBOUND WS-DONE
     PERFORM 32 TIMES
         ADD 1 TO CW-TICKS
         CALL "POTION-DRINK-TICK" USING WS-PLAYER
     END-PERFORM.

 CHECK.
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM ACC-ITEMCOMP-DRINK.
 COPY MOBSPTEST.
 COPY CORETEST.
