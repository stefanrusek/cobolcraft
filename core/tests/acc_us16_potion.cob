*> Acceptance test, the thrown splash and lingering potion (docs/protocol/44 part 8 sections 6.5 and 10.2, 17 section 3.15; lane 002-lane-mobsb6, T9001): gravity 0.05 and drag 0.99,
*> the splash intensity t = 1 - sqrt(d2) / 4 with the duration (int)(d t s + 0.5) applied only above 20 ticks, instant effects scaled by t, the lingering cloud (radius 3.0,
*> radius on use -0.5, duration 600, wait 10, radius per tick -0.005), the burst on a block and on an entity, the effect list handed to the generic potion entity.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. ACC-US16-POTION.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY PROJSTATE.
 01 WS-PLAYER              BINARY-LONG.
 01 WS-KEY                 PIC X(112).
 01 WS-ENTITY-ROW          PIC X(66).
 01 WS-STATUS              BINARY-LONG.
 01 WS-PIG-TYPE            BINARY-LONG.
 01 WS-DIM                 BINARY-LONG.
 01 WS-X0                  BINARY-LONG.
 01 WS-Y0                  BINARY-LONG.
 01 WS-Z0                  BINARY-LONG.
 01 WS-FX                  BINARY-LONG.
 01 WS-FZ                  BINARY-LONG.
 01 WS-GY                  BINARY-LONG.
 01 WS-SIZE                BINARY-LONG VALUE 96.
 01 WS-KIND                BINARY-LONG VALUE 1.
 01 WS-X                   FLOAT-LONG.
 01 WS-Y                   FLOAT-LONG.
 01 WS-Z                   FLOAT-LONG.
 01 WS-VX                  FLOAT-LONG.
 01 WS-VY                  FLOAT-LONG.
 01 WS-VZ                  FLOAT-LONG.
 01 WS-YAW                 FLOAT-SHORT VALUE 0.
 01 WS-PIG1                BINARY-LONG.
 01 WS-PIG2                BINARY-LONG.
 01 WS-POTION              BINARY-LONG.
 01 WS-SLOT                BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-LEVEL               BINARY-LONG.
 01 WS-TICKS               BINARY-LONG.
 01 WS-OWNER               BINARY-LONG VALUE 0.
 01 WS-NO                  BINARY-LONG VALUE 0.
 01 WS-SLOW                BINARY-LONG VALUE 1.
 01 WS-FATIGUE             BINARY-LONG VALUE 3.
 01 WS-HARM                BINARY-LONG VALUE 6.
 01 WS-AMP0                BINARY-LONG VALUE 0.
 01 WS-D1800               BINARY-LONG VALUE 1800.
 01 WS-D600                BINARY-LONG VALUE 600.
 01 WS-D1                  BINARY-LONG VALUE 1.
 01 WS-CLOUDS              BINARY-LONG.
 01 WS-CLOUD-TYPE          BINARY-LONG.
 01 WS-HEALTH              BINARY-LONG.
 01 WS-GONE                BINARY-LONG.
 PROCEDURE DIVISION.
     CALL "MS-TEST-OPEN" USING WS-PLAYER
     MOVE "N" TO TL-MODE
     MOVE PL-DIM(WS-PLAYER) TO WS-DIM
     COMPUTE WS-X0 = FUNCTION INTEGER(PL-X(WS-PLAYER))
     COMPUTE WS-Y0 = FUNCTION INTEGER(PL-Y(WS-PLAYER))
     COMPUTE WS-Z0 = FUNCTION INTEGER(PL-Z(WS-PLAYER)) + 40
     COMPUTE WS-FX = WS-X0 - 48
     COMPUTE WS-FZ = WS-Z0 - 48
     COMPUTE WS-GY = WS-Y0 - 1
     CALL "MS-TEST-FLOOR" USING WS-DIM WS-FX WS-FZ WS-SIZE WS-GY WS-KIND
     MOVE "minecraft:pig" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-PIG-TYPE WS-ENTITY-ROW WS-STATUS
     MOVE "minecraft:area_effect_cloud" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-CLOUD-TYPE WS-ENTITY-ROW WS-STATUS
*>   Gravity and drag.
     COMPUTE WS-X = WS-X0 + 0.5
     COMPUTE WS-Y = WS-Y0 + 10
     COMPUTE WS-Z = WS-Z0 + 0.5
     MOVE 0 TO WS-VX WS-VY WS-VZ
     CALL "POTION-SPAWN" USING WS-NO WS-DIM WS-X WS-Y WS-Z WS-VX WS-VY WS-VZ WS-OWNER WS-POTION
     CALL "PJ-FIND" USING EN-ID(WS-POTION) WS-SLOT
     MOVE "acceptance US16 44-8 10.2 a splash potion has kind 1" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE PJ-KIND(WS-SLOT) TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "POTION-STEP" USING WS-POTION
     MOVE "acceptance US16 44-8 6.5 one tick: vy = (0 - 0.05) x 0.99 = -0.0495" TO TL-CASE
     MOVE -495 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N ROUNDED = EN-VY(WS-POTION) * 10000
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   A burst with two pigs: gap 2.0 (t = 0.5) and gap 3.9 (t = 0.025).
     CALL "PJ-DROP" USING WS-POTION
     COMPUTE WS-Y = WS-Y0 + 1
     COMPUTE WS-X = WS-X0 + 0.5
     CALL "POTION-SPAWN" USING WS-NO WS-DIM WS-X WS-Y WS-Z WS-VX WS-VY WS-VZ WS-OWNER WS-POTION
     CALL "PJ-FIND" USING EN-ID(WS-POTION) WS-SLOT
     CALL "POTION-FX" USING WS-POTION WS-SLOW WS-AMP0 WS-D1800
     COMPUTE WS-X = WS-X0 + 0.5 + 2.575
     CALL "MOB-SPAWN" USING WS-DIM WS-PIG-TYPE WS-X WS-Y WS-Z WS-YAW WS-PIG1
     COMPUTE WS-X = WS-X0 + 0.5 - 4.475
     CALL "MOB-SPAWN" USING WS-DIM WS-PIG-TYPE WS-X WS-Y WS-Z WS-YAW WS-PIG2
     CALL "POTION-BURST" USING WS-POTION WS-NO
     CALL "MEF-LEVEL" USING EN-ID(WS-PIG1) WS-SLOW WS-LEVEL WS-TICKS
     MOVE "acceptance US16 44-8 10.2 a pig 2.0 blocks away gets (int)(1800 x 0.5 + 0.5) = 900 ticks" TO TL-CASE
     MOVE 1900 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-LEVEL * 1000 + WS-TICKS
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "MEF-LEVEL" USING EN-ID(WS-PIG2) WS-SLOW WS-LEVEL WS-TICKS
     MOVE "acceptance US16 44-8 10.2 a pig 3.9 blocks away gets (int)(1800 x 0.025 + 0.5) = 45 ticks" TO TL-CASE
     MOVE 1045 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-LEVEL * 1000 + WS-TICKS
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US16 44-8 10.2 the burst discards the potion" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE EN-USED(WS-POTION) TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   A 600 tick effect at gap 3.9 ends within 20 ticks: not applied.
     CALL "MEF-REMOVE" USING EN-ID(WS-PIG2) WS-SLOW
     COMPUTE WS-X = WS-X0 + 0.5
     CALL "POTION-SPAWN" USING WS-NO WS-DIM WS-X WS-Y WS-Z WS-VX WS-VY WS-VZ WS-OWNER WS-POTION
     CALL "POTION-FX" USING WS-POTION WS-FATIGUE WS-AMP0 WS-D600
     CALL "POTION-BURST" USING WS-POTION WS-NO
     CALL "MEF-LEVEL" USING EN-ID(WS-PIG2) WS-FATIGUE WS-LEVEL WS-TICKS
     MOVE "acceptance US16 44-8 10.2 600 x 0.025 + 0.5 = 15 ticks ends within 20: not applied" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-LEVEL TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   Instant damage at full intensity on a pig inside the potion's own box: 6.
     CALL "POTION-SPAWN" USING WS-NO WS-DIM WS-X WS-Y WS-Z WS-VX WS-VY WS-VZ WS-OWNER WS-POTION
     COMPUTE WS-X = WS-X0 + 0.5
     CALL "MOB-SPAWN" USING WS-DIM WS-PIG-TYPE WS-X WS-Y WS-Z WS-YAW WS-I
     CALL "POTION-FX" USING WS-POTION WS-HARM WS-AMP0 WS-D1
     MOVE EN-HEALTH(WS-I) TO WS-HEALTH
     CALL "POTION-BURST" USING WS-POTION WS-NO
     MOVE "acceptance US16 44-8 10.2 instant damage at intensity 1 hurts a touching pig by 6" TO TL-CASE
     MOVE 6 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-HEALTH - EN-HEALTH(WS-I)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   The thrower's own player is hit as any other entity: instant damage on a player.
     CALL "POTION-SPAWN" USING WS-NO WS-DIM PL-X(WS-PLAYER) PL-Y(WS-PLAYER) PL-Z(WS-PLAYER) WS-VX WS-VY WS-VZ WS-OWNER WS-POTION
     CALL "POTION-FX" USING WS-POTION WS-HARM WS-AMP0 WS-D1
     MOVE PL-HEALTH(WS-PLAYER) TO WS-HEALTH
     CALL "POTION-BURST" USING WS-POTION WS-NO
     MOVE "acceptance US16 44-8 10.2 a player in the burst loses 6 health points" TO TL-CASE
     MOVE 6 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-HEALTH - PL-HEALTH(WS-PLAYER)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   A lingering potion bursting on the ground makes a cloud.
     COMPUTE WS-X = WS-X0 + 0.5
     COMPUTE WS-Y = WS-Y0 + 4
     COMPUTE WS-Z = WS-Z0 + 20.5
     MOVE 0 TO WS-VX WS-VY WS-VZ
     MOVE 1 TO WS-KIND
     CALL "POTION-SPAWN" USING WS-KIND WS-DIM WS-X WS-Y WS-Z WS-VX WS-VY WS-VZ WS-OWNER WS-POTION
     CALL "POTION-FX" USING WS-POTION WS-SLOW WS-AMP0 WS-D1800
     MOVE 0 TO WS-I
     PERFORM UNTIL WS-I >= 40 OR EN-USED(WS-POTION) = 0
         CALL "POTION-STEP" USING WS-POTION
         ADD 1 TO WS-I
     END-PERFORM
     MOVE "acceptance US16 44-8 6.5 a lingering potion dropped 4 blocks lands within 20 ticks" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     IF WS-I < 20
         MOVE 1 TO TL-OBSERVED-N
     ELSE
         MOVE 0 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 0 TO WS-CLOUDS
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > EN-COUNT
         IF EN-USED(WS-I) = 1 AND EN-TYPE(WS-I) = WS-CLOUD-TYPE AND EN-Z(WS-I) > WS-Z0 + 19
             ADD 1 TO WS-CLOUDS
             CALL "PJ-FIND" USING EN-ID(WS-I) WS-SLOT
         END-IF
     END-PERFORM
     MOVE "acceptance US16 44-8 10 a lingering burst makes one cloud there" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE WS-CLOUDS TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US16 44-8 10 the cloud has radius 3" TO TL-CASE
     MOVE 3 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER(PJ-RADIUS(WS-SLOT))
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US16 44-8 10 the cloud lasts 600 after a wait of 10 with reapplication 20" TO TL-CASE
     MOVE 600010020 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PJ-DUR(WS-SLOT) * 1000000 + PJ-WAIT(WS-SLOT) * 1000 + PJ-REAPP(WS-SLOT)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US16 44-8 10 the cloud shrinks by 0.005 per tick" TO TL-CASE
     MOVE -5 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N ROUNDED = PJ-RPT(WS-SLOT) * 1000
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US16 44-8 10 the cloud shrinks by 0.5 per use" TO TL-CASE
     MOVE -500 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N ROUNDED = PJ-ROU(WS-SLOT) * 1000
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US16 44-8 10 the effect list (slowness 1800) is copied into the cloud" TO TL-CASE
     MOVE 1001800 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PJ-FXN(WS-SLOT) * 1000000 + PJ-FX-ID(WS-SLOT, 1) * 100000 / 100 + PJ-FX-DUR(WS-SLOT, 1) - PJ-FX-ID(WS-SLOT, 1) * 1000
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   A lingering potion hitting a pig makes the cloud at the pig.
     COMPUTE WS-X = WS-X0 - 10
     COMPUTE WS-Z = WS-Z0 + 0.5
     MOVE WS-Y0 TO WS-Y
     CALL "MOB-SPAWN" USING WS-DIM WS-PIG-TYPE WS-X WS-Y WS-Z WS-YAW WS-PIG1
     COMPUTE WS-Y = WS-Y0 + 0.5
     COMPUTE WS-X = WS-X0 - 12
     MOVE 0.5 TO WS-VX
     CALL "POTION-SPAWN" USING WS-KIND WS-DIM WS-X WS-Y WS-Z WS-VX WS-VY WS-VZ WS-OWNER WS-POTION
     CALL "POTION-FX" USING WS-POTION WS-SLOW WS-AMP0 WS-D1800
     MOVE 0 TO WS-I
     PERFORM UNTIL WS-I >= 20 OR EN-USED(WS-POTION) = 0
         CALL "POTION-STEP" USING WS-POTION
         ADD 1 TO WS-I
     END-PERFORM
     MOVE 0 TO WS-CLOUDS
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > EN-COUNT
         IF EN-USED(WS-I) = 1 AND EN-TYPE(WS-I) = WS-CLOUD-TYPE AND EN-X(WS-I) < WS-X0 - 5
             ADD 1 TO WS-CLOUDS
         END-IF
     END-PERFORM
     MOVE "acceptance US16 44-8 10 a potion that hits a pig bursts at the pig (a cloud near it)" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE WS-CLOUDS TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   A potion flying into a player bursts there, with an infinite effect kept infinite.
     MOVE PL-X(WS-PLAYER) TO WS-X
     COMPUTE WS-X = WS-X - 3
     COMPUTE WS-Y = PL-Y(WS-PLAYER) + 1.0
     MOVE PL-Z(WS-PLAYER) TO WS-Z
     MOVE 0.5 TO WS-VX
     MOVE 0 TO WS-VY WS-VZ
     MOVE 0 TO WS-KIND
     CALL "POTION-SPAWN" USING WS-KIND WS-DIM WS-X WS-Y WS-Z WS-VX WS-VY WS-VZ WS-OWNER WS-POTION
     MOVE -1 TO WS-GONE
     CALL "POTION-FX" USING WS-POTION WS-SLOW WS-AMP0 WS-GONE
     MOVE 0 TO WS-I
     PERFORM UNTIL WS-I >= 20 OR EN-USED(WS-POTION) = 0
         CALL "POTION-STEP" USING WS-POTION
         ADD 1 TO WS-I
     END-PERFORM
     CALL "EFFECT-LEVEL" USING WS-PLAYER WS-SLOW WS-LEVEL WS-TICKS
     MOVE "acceptance US16 44-8 10.2 a potion that hits a player gives it the infinite effect" TO TL-CASE
     MOVE 999 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-LEVEL * 1000 + WS-TICKS
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   Splash with all four effect places used: a fifth is ignored.
     CALL "POTION-SPAWN" USING WS-KIND WS-DIM WS-X WS-Y WS-Z WS-VX WS-VY WS-VZ WS-OWNER WS-POTION
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 5
         CALL "POTION-FX" USING WS-POTION WS-SLOW WS-AMP0 WS-D600
     END-PERFORM
     CALL "PJ-FIND" USING EN-ID(WS-POTION) WS-SLOT
     MOVE "acceptance US16 44-8 10.2 a potion holds at most 4 effects" TO TL-CASE
     MOVE 4 TO TL-EXPECTED-N
     MOVE PJ-FXN(WS-SLOT) TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.
 END PROGRAM ACC-US16-POTION.
 COPY CORETEST.
 COPY MOBSPTEST.
