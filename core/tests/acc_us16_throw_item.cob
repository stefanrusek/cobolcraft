*> Acceptance test, throwing items (docs/protocol/17 section 3.15, 44 part 8 section 6.1; lane 002-lane-mobsb6, T9001 and the later projectile items): Use Item with a splash or
*> lingering potion in the main hand makes the thrown potion at (x, eye - 0.1, z) with speed 0.5 and the -20 degree pitch offset, the stack loses one in survival, other items and
*> the off hand are left alone, and the real play path (PLAY-PACKET Use Item) and CORE-TICK move it.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. ACC-US16-THROW-ITEM.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY PLAYPKT.
 COPY PROJSTATE.
 01 WS-PLAYER              BINARY-LONG.
 01 WS-CONN                BINARY-LONG.
 01 WS-KEY                 PIC X(112).
 01 WS-ITEM-ROW            PIC X(270).
 01 WS-ENTITY-ROW          PIC X(66).
 01 WS-STATUS              BINARY-LONG.
 01 WS-SPLASH-ITEM         BINARY-LONG.
 01 WS-LINGER-ITEM         BINARY-LONG.
 01 WS-STICK-ITEM          BINARY-LONG.
 01 WS-SPLASH-TYPE         BINARY-LONG.
 01 WS-LINGER-TYPE         BINARY-LONG.
 01 WS-DONE                BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-SLOT                BINARY-LONG.
 01 WS-FOUND               BINARY-LONG.
 01 WS-ROW                 BINARY-LONG.
 01 WS-TICKS               BINARY-LONG VALUE 1.
 PROCEDURE DIVISION.
     CALL "MS-TEST-OPEN" USING WS-PLAYER
     MOVE "N" TO TL-MODE
     MOVE 0 TO WS-CONN
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > CORE-MAX-CONNS
         IF CN-PLAYER(WS-I) = WS-PLAYER
             MOVE WS-I TO WS-CONN
         END-IF
     END-PERFORM
     MOVE "minecraft:splash_potion" TO WS-KEY
     CALL "CONTENT-ITEM-BY-KEY" USING WS-KEY WS-SPLASH-ITEM WS-ITEM-ROW WS-STATUS
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-SPLASH-TYPE WS-ENTITY-ROW WS-STATUS
     MOVE "minecraft:lingering_potion" TO WS-KEY
     CALL "CONTENT-ITEM-BY-KEY" USING WS-KEY WS-LINGER-ITEM WS-ITEM-ROW WS-STATUS
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-LINGER-TYPE WS-ENTITY-ROW WS-STATUS
     MOVE "minecraft:stick" TO WS-KEY
     CALL "CONTENT-ITEM-BY-KEY" USING WS-KEY WS-STICK-ITEM WS-ITEM-ROW WS-STATUS
     COMPUTE WS-SLOT = PL-HELD(WS-PLAYER) + 1
     MOVE WS-SPLASH-ITEM TO PL-SLOT-ITEM(WS-PLAYER, WS-SLOT)
     MOVE 2 TO PL-SLOT-COUNT(WS-PLAYER, WS-SLOT)
     MOVE 0 TO PSB-HAND PSB-YAW PSB-PITCH
     CALL "THROWN-ITEM-USE" USING WS-CONN PLAY-SERVERBOUND WS-DONE
     MOVE 0 TO WS-FOUND
     MOVE 0 TO WS-ROW
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > EN-COUNT
         IF EN-USED(WS-I) = 1 AND EN-TYPE(WS-I) = WS-SPLASH-TYPE
             ADD 1 TO WS-FOUND
             MOVE WS-I TO WS-ROW
         END-IF
     END-PERFORM
     MOVE "acceptance US16 17 3.15 a splash potion item is handled and one potion entity appears" TO TL-CASE
     MOVE 11 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-DONE * 10 + WS-FOUND
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US16 17 3.15 the survival stack loses one" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE PL-SLOT-COUNT(WS-PLAYER, WS-SLOT) TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US16 17 3.15 it starts 1.52 above the feet (eye 1.62 - 0.1), in millimetres" TO TL-CASE
     COMPUTE TL-EXPECTED-N = FUNCTION INTEGER(PL-Y(WS-PLAYER) * 1000 + 1520.5)
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER(EN-Y(WS-ROW) * 1000 + 0.5)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US16 17 3.15 yaw 0, pitch 0: vz = 0.5 / sqrt(1 + sin(20)^2) = 0.4731 (ten-thousandths)" TO TL-CASE
     MOVE 4731 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER(EN-VZ(WS-ROW) * 10000 + 0.5)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US16 17 3.15 the -20 degree offset lifts it: vy = 0.1618" TO TL-CASE
     MOVE 1618 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER(EN-VY(WS-ROW) * 10000 + 0.5)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US16 17 3.15 the owner is the thrower" TO TL-CASE
     MOVE PL-ENTITY-ID(WS-PLAYER) TO TL-EXPECTED-N
     MOVE EN-TARGET-ID(WS-ROW) TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   Creative keeps the stack.
     MOVE 1 TO PL-MODE(WS-PLAYER)
     CALL "THROWN-ITEM-USE" USING WS-CONN PLAY-SERVERBOUND WS-DONE
     MOVE "acceptance US16 17 3.15 a creative player keeps the stack" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE PL-SLOT-COUNT(WS-PLAYER, WS-SLOT) TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 0 TO PL-MODE(WS-PLAYER)
*>   Lingering through the real play path, then one tick.
     MOVE WS-LINGER-ITEM TO PL-SLOT-ITEM(WS-PLAYER, WS-SLOT)
     MOVE 1 TO PL-SLOT-COUNT(WS-PLAYER, WS-SLOT)
     CALL "TEST-USE-ITEM" USING WS-CONN
     MOVE 0 TO WS-ROW
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > EN-COUNT
         IF EN-USED(WS-I) = 1 AND EN-TYPE(WS-I) = WS-LINGER-TYPE
             MOVE WS-I TO WS-ROW
         END-IF
     END-PERFORM
     MOVE "acceptance US16 17 3.15 Use Item through PLAY-PACKET throws a lingering potion (kind 2)" TO TL-CASE
     MOVE 2 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF WS-ROW > 0
         CALL "PJ-FIND" USING EN-ID(WS-ROW) WS-FOUND
         MOVE PJ-KIND(WS-FOUND) TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "TEST-TICKS" USING WS-TICKS
     MOVE "acceptance US16 17 3.15 CORE-TICK moves the thrown potion on (THROWN-TICK)" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF WS-ROW > 0 AND EN-USED(WS-ROW) = 1 AND EN-COOLDOWN(WS-ROW) > 0
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   Other items, the off hand and an empty hand are not handled.
     MOVE WS-STICK-ITEM TO PL-SLOT-ITEM(WS-PLAYER, WS-SLOT)
     CALL "THROWN-ITEM-USE" USING WS-CONN PLAY-SERVERBOUND WS-DONE
     MOVE "acceptance US16 17 3.15 a stick is not a throwable" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-DONE TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE WS-SPLASH-ITEM TO PL-SLOT-ITEM(WS-PLAYER, WS-SLOT)
     MOVE 1 TO PSB-HAND
     CALL "THROWN-ITEM-USE" USING WS-CONN PLAY-SERVERBOUND WS-DONE
     MOVE "acceptance US16 17 3.15 the off hand is not handled" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-DONE TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 0 TO PSB-HAND
     MOVE 0 TO PL-SLOT-COUNT(WS-PLAYER, WS-SLOT)
     CALL "THROWN-ITEM-USE" USING WS-CONN PLAY-SERVERBOUND WS-DONE
     MOVE "acceptance US16 17 3.15 an empty hand is not handled" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-DONE TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.
 END PROGRAM ACC-US16-THROW-ITEM.
 COPY CORETEST.
 COPY MOBSPTEST.
