*> Integration test (integrator, batch 11; docs/protocol/18-mob-framework.md sections 2.10, 9.3 and 9.4): a no-AI or left-handed mob that comes into a player's range is
*> paired with Add Entity, then its mob flags (Set Entity Data, slot 15) and its health (slot 9), both 0x65.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-GAP-PAIR-FLAGS.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY PROTO.
 COPY COREAPI.
 01 WS-CAPACITY            BINARY-LONG VALUE 65536.
 01 WS-NAME                PIC X(16) VALUE "Stefan".
 01 WS-NAME-LENGTH         BINARY-LONG VALUE 6.
 01 WS-CONN                BINARY-LONG.
 01 WS-PLAYER              BINARY-LONG.
 01 WS-KEY                 PIC X(112).
 01 WS-ENTITY-ROW          PIC X(66).
 01 WS-STATUS              BINARY-LONG.
 01 WS-PIG-TYPE            BINARY-LONG.
 01 WS-PIG                 BINARY-LONG.
 01 WS-DIM                 BINARY-LONG.
 01 WS-X                   FLOAT-LONG.
 01 WS-Y                   FLOAT-LONG.
 01 WS-Z                   FLOAT-LONG.
 01 WS-YAW                 FLOAT-SHORT VALUE 0.
 01 WS-TEXT                PIC X(1024).
 01 WS-ONE                 BINARY-LONG VALUE 1.
 01 WS-PITCH               FLOAT-SHORT VALUE 0.
 PROCEDURE DIVISION.
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     MOVE 2 TO CS-VIEW-DISTANCE
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     CALL "TEST-STANDARD-TABLES"
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     CALL "TEST-JOIN" USING WS-NAME WS-NAME-LENGTH WS-CONN
     MOVE CN-PLAYER(WS-CONN) TO WS-PLAYER
     MOVE PL-DIM(WS-PLAYER) TO WS-DIM
     MOVE "minecraft:pig" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-PIG-TYPE WS-ENTITY-ROW WS-STATUS
     MOVE PL-Y(WS-PLAYER) TO WS-Y
     MOVE PL-Z(WS-PLAYER) TO WS-Z
*>   A no-AI pig far away, then moved into range.
     COMPUTE WS-X = PL-X(WS-PLAYER) + 200
     CALL "MOB-SPAWN" USING WS-DIM WS-PIG-TYPE WS-X WS-Y WS-Z WS-YAW WS-PIG
     MOVE 1 TO EN-NO-AI(WS-PIG)
     CALL "TEST-DRAIN-IDS" USING WS-CONN WS-TEXT
     COMPUTE WS-X = PL-X(WS-PLAYER) + 10
     CALL "ENTITY-MOVE" USING WS-PIG WS-X WS-Y WS-Z WS-YAW WS-PITCH WS-ONE
     CALL "TEST-DRAIN-IDS" USING WS-CONN WS-TEXT
     MOVE "integration US15 18§2.10 pairing a no-AI pig: Add Entity, the mob flags and the health" TO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE "1 101x2" TO TL-EXPECTED
     MOVE FUNCTION TRIM(WS-TEXT) TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   A left-handed pig the same way.
     MOVE 0 TO EN-NO-AI(WS-PIG)
     MOVE 1 TO EN-LEFTY(WS-PIG)
     COMPUTE WS-X = PL-X(WS-PLAYER) + 200
     CALL "ENTITY-MOVE" USING WS-PIG WS-X WS-Y WS-Z WS-YAW WS-PITCH WS-ONE
     CALL "TEST-DRAIN-IDS" USING WS-CONN WS-TEXT
     COMPUTE WS-X = PL-X(WS-PLAYER) + 10
     CALL "ENTITY-MOVE" USING WS-PIG WS-X WS-Y WS-Z WS-YAW WS-PITCH WS-ONE
     CALL "TEST-DRAIN-IDS" USING WS-CONN WS-TEXT
     MOVE "integration US15 18§2.10 pairing a left-handed pig: Add Entity, the mob flags and the health" TO TL-CASE
     MOVE "1 101x2" TO TL-EXPECTED
     MOVE FUNCTION TRIM(WS-TEXT) TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.
 END PROGRAM TEST-GAP-PAIR-FLAGS.
 COPY CORETEST.
