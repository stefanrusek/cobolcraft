     PERFORM LOAD-IN
     CALL "RS3-SENSOR-CAN-RECEIVE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 0 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-SENSOR-CAN-RECEIVE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 1 1 0 1 0 0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 30-8§4 Sculk sensor block: onReceiveVibration (4.5): when the state can still activate: store the frequency, strength by 3.2 from the block distance squared and the radius," TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1 1 9 8" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-SENSOR-RECEIVE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1 5 0 8" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-SENSOR-RECEIVE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "0 5 9 8" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-SENSOR-RECEIVE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1 15 64 8" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-SENSOR-RECEIVE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1 6 16 16" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-SENSOR-RECEIVE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1/1/10 1/5/15 0/0/0 1/15/1 1/6/12" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 30-8§4 Sculk sensor block: signals (4.6): weak power toward every neighbour, strong power only when asked with UP (power, direction data value, query 0 getSignal 1" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "10 1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-SENSOR-SIGNAL" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "10 1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-SENSOR-SIGNAL" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "10 2 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-SENSOR-SIGNAL" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "10 2 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-SENSOR-SIGNAL" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "10 0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-SENSOR-SIGNAL" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "10 0 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-SENSOR-SIGNAL" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "10 10 10 0 10 0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 30-8§4 Sculk sensor block: comparator (4.7): while the phase is active and the block entity exists the last vibration frequency, else 0 (V1) (phase, block entity, last frequency)" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1 1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-SENSOR-ANALOG" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-SENSOR-ANALOG" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 1 9" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-SENSOR-ANALOG" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "2 1 9" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS3-SENSOR-ANALOG" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
