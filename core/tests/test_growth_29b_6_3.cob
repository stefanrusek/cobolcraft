     CALL "GC6-CLUSTER-ROTATE" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "6 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-CLUSTER-ROTATE" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "3 2" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-CLUSTER-ROTATE" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "4 3" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-CLUSTER-ROTATE" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "5 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-CLUSTER-ROTATE" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 2 6 5 3 4 4 6 5" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29b-6§3 Amethyst: mirror (3.2): facing through Mirror.getRotation: left-right turns a north or south facing by 180, front-back an east or west facing; up and down never change" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-CLUSTER-MIRROR" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 2" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-CLUSTER-MIRROR" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "2 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-CLUSTER-MIRROR" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "2 2" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-CLUSTER-MIRROR" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "3 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-CLUSTER-MIRROR" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "3 2" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-CLUSTER-MIRROR" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "4 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-CLUSTER-MIRROR" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "4 2" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-CLUSTER-MIRROR" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "5 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-CLUSTER-MIRROR" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "5 2" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-CLUSTER-MIRROR" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "6 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-CLUSTER-MIRROR" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "6 2" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-CLUSTER-MIRROR" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "3 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-CLUSTER-MIRROR" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 2 2 4 3 3 4 5 6 6 5 3" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29b-6§3 Amethyst: budding amethyst random tick (3.3, E1): nextInt(5) not 0 stops; nextInt(6) picks the direction (0 down, 1 up, 2 north, 3 south, 4 west, 5 east); air or a full" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "3 0 1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-BUD-TICK" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "0 3 1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-BUD-TICK" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "0 1 2 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-BUD-TICK" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "0 2 3 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-BUD-TICK" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "0 4 4 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-BUD-TICK" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "0 5 5 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-BUD-TICK" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 6 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-BUD-TICK" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-BUD-TICK" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "1 2 1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-BUD-TICK" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "0 3 1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-BUD-TICK" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "0 2 3 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-BUD-TICK" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "0 1 0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-BUD-TICK" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "1/0/0/0 2/4/1/0 2/2/1/1 2/3/2/0 2/5/3/0 2/6/4/1 2/1/0/0 2/1/0/0 1/0/0/0 2/4/1/1 2/3/2/1 2/2/0/0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29b-6§3 Amethyst: rate (3.3): one face advances with 1/30 per random tick (x 1e6), four stages 120 ticks, about 163840 game ticks at random_tick_speed 3 (3/4096 per game tick);" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-BUD-RATE" USING WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "33333/120/163840/5" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29b-6§3 Amethyst: push reaction (3.1, 3.3): amethyst_block keeps the default PUSH_PULL (1), budding_amethyst is POPPED (2)" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-AMETHYST-PUSH" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "2" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-AMETHYST-PUSH" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 2" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 BEGIN-CASE.
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR
     .

 LOAD-IN.
     MOVE 1 TO WS-P
     PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 16
         MOVE SPACES TO WS-TOK
         IF WS-P <= 160
             UNSTRING WS-IN DELIMITED BY ALL SPACE INTO WS-TOK WITH POINTER WS-P
         END-IF
         COMPUTE WS-FX(WS-K) = FUNCTION NUMVAL(WS-TOK)
         COMPUTE WS-I(WS-K) = FUNCTION NUMVAL(WS-TOK)
     END-PERFORM
     .

 ADD-N.
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N
         MOVE WS-R(WS-J) TO WS-SHOW
         IF WS-J > 1
             STRING "/" DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
         END-IF
         STRING FUNCTION TRIM(WS-SHOW) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-PERFORM
     STRING " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .

 ADD-TEXT.
     STRING FUNCTION TRIM(WS-T1) "|" FUNCTION TRIM(WS-T2) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .
 END PROGRAM TEST-GROWTH-29B-6-3.
