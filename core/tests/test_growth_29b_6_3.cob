 PROCEDURE DIVISION.
     MOVE "T" TO TL-MODE
     MOVE "acceptance US12 29b-6§3 Amethyst: projectile chime (3.1): server level only; pitch = 0.5 + nextFloat x 1.2 (x 1e6), range [0.5, 1.7)" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-AMETHYST-HIT" USING WS-I1 WS-FX2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1 0.5" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-AMETHYST-HIT" USING WS-I1 WS-FX2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1 0.99999" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-AMETHYST-HIT" USING WS-I1 WS-FX2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "0 0.5" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC6-AMETHYST-HIT" USING WS-I1 WS-FX2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1/500000 1/1100000 1/1699988 0/0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29b-6§3 Amethyst: cluster survival (3.2): the block opposite to facing is sturdy towards facing" TO TL-CASE
