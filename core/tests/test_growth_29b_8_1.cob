     CALL "GC8-OWNER" USING WS-I1 WS-DOC
     MOVE WS-DOC TO WS-T1
     MOVE SPACES TO WS-T2
     PERFORM ADD-TEXT
     MOVE "11" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC8-OWNER" USING WS-I1 WS-DOC
     MOVE WS-DOC TO WS-T1
     MOVE SPACES TO WS-T2
     PERFORM ADD-TEXT
     MOVE "12" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC8-OWNER" USING WS-I1 WS-DOC
     MOVE WS-DOC TO WS-T1
     MOVE SPACES TO WS-T2
     PERFORM ADD-TEXT
     MOVE "29a; 44-1| 41; 18 s2.5| 42 p6 (FIRE_AMBIENT); 12| 31 p4 s5| 24 p7 s11.3| |" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29b-8§1 Scope, and what other documents already hold: hand-off to the owners of neighbour documents (1): 17 section 3.3a step 7 and 30 part 7 section 8" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC8-HANDOFF" USING WS-I1 WS-DOC
     MOVE WS-DOC TO WS-T1
     MOVE SPACES TO WS-T2
     PERFORM ADD-TEXT
     MOVE "2" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC8-HANDOFF" USING WS-I1 WS-DOC
     MOVE WS-DOC TO WS-T1
     MOVE SPACES TO WS-T2
     PERFORM ADD-TEXT
     MOVE "3" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC8-HANDOFF" USING WS-I1 WS-DOC
     MOVE WS-DOC TO WS-T1
     MOVE SPACES TO WS-T2
     PERFORM ADD-TEXT
     MOVE "17 s3.3a step 7: attribute at the fire position (biome data)| 30 p7 s8.1, s8.3: table is 17 s3.3a, burn-out step is 2.7| |" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29b-8§1 Scope, and what other documents already hold: fire ambience (1, client): nextInt(24) = 0 plays fire.ambient at the block centre, volume 1 + nextFloat, pitch 0.3 +" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0 0.0 0.0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC8-FIRE-AMBIENT" USING WS-I1 WS-FX2 WS-FX3 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "0 0.5 0.5" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC8-FIRE-AMBIENT" USING WS-I1 WS-FX2 WS-FX3 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "0 0.25 1.0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC8-FIRE-AMBIENT" USING WS-I1 WS-FX2 WS-FX3 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1 0.5 0.5" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC8-FIRE-AMBIENT" USING WS-I1 WS-FX2 WS-FX3 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "23 0.1 0.1" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC8-FIRE-AMBIENT" USING WS-I1 WS-FX2 WS-FX3 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1/1000000/300000 1/1500000/650000 1/1250000/1000000 0/0/0 0/0/0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 BEGIN-CASE.
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR
     .

 LOAD-IN.
     MOVE 1 TO WS-P
     PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 16
         MOVE SPACES TO WS-TOK
         IF WS-P <= 160
             UNSTRING WS-IN DELIMITED BY ALL SPACE INTO WS-TOK WITH POINTER WS-P
         END-IF
         COMPUTE WS-FX(WS-K) = FUNCTION NUMVAL(WS-TOK)
         COMPUTE WS-I(WS-K) = FUNCTION NUMVAL(WS-TOK)
     END-PERFORM
     .

 ADD-N.
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N
         MOVE WS-R(WS-J) TO WS-SHOW
         IF WS-J > 1
             STRING "/" DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
         END-IF
         STRING FUNCTION TRIM(WS-SHOW) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-PERFORM
     STRING " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .

 ADD-TEXT.
     STRING FUNCTION TRIM(WS-T1) "|" FUNCTION TRIM(WS-T2) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .
 END PROGRAM TEST-GROWTH-29B-8-1.
