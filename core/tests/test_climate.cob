 01 WS-F                   FLOAT-LONG.
 01 WS-Q                   BINARY-DOUBLE.
 01 WS-PRESET              BINARY-LONG VALUE 1.
 01 WS-COUNT               BINARY-LONG.
 01 WS-EDIT                PIC -(9)9.
 01 WS-TEXT                PIC X(240).
 01 WS-PTR                 BINARY-LONG.
 PROCEDURE DIVISION.
     CALL "WORLDGEN-FREE"
     CALL "NOISES-LOAD" USING WS-DIR WS-STATUS
     CALL "DENSITY-FUNCTIONS-LOAD" USING WS-DIR WS-STATUS
     CALL "DENSITY-SETUP" USING WS-SEED
     MOVE "T" TO TL-MODE

     MOVE "test climate quantize is a float multiply by 10000 truncated toward zero (13.4)" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     MOVE -0.78 TO WS-F
     CALL "CLIMATE-F32-QUANTIZE" USING WS-F WS-Q
     PERFORM ADD-Q
     MOVE -0.2225 TO WS-F
     CALL "CLIMATE-F32-QUANTIZE" USING WS-F WS-Q
     PERFORM ADD-Q
     MOVE 0.05 TO WS-F
     CALL "CLIMATE-F32-QUANTIZE" USING WS-F WS-Q
     PERFORM ADD-Q
     MOVE 0.93333334 TO WS-F
     CALL "CLIMATE-F32-QUANTIZE" USING WS-F WS-Q
     PERFORM ADD-Q
     MOVE WS-TEXT TO TL-OBSERVED
     MOVE "-7799 -2225 500 9333" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 4
         CALL "CLIMATE-SAMPLE" USING WS-QX(WS-I) WS-QY(WS-I) WS-QZ(WS-I) WS-TARGET
         MOVE SPACES TO WS-TEXT
         MOVE 1 TO WS-PTR
         MOVE SPACES TO TL-CASE
         MOVE WS-I TO WS-EDIT
         STRING "test climate target at quart cell " FUNCTION TRIM(WS-EDIT) " as reference (13.2)"
             DELIMITED BY SIZE INTO TL-CASE
         PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 6
             MOVE WS-TV(WS-K) TO WS-EDIT
             STRING FUNCTION TRIM(WS-EDIT) " " DELIMITED BY SIZE INTO WS-TEXT POINTER WS-PTR
         END-PERFORM
         MOVE WS-TEXT TO TL-OBSERVED
         MOVE SPACES TO TL-EXPECTED
         MOVE 1 TO WS-PTR
         PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 6
             MOVE WS-T-VALUE(WS-I, WS-K) TO WS-EDIT
             STRING FUNCTION TRIM(WS-EDIT) " " DELIMITED BY SIZE INTO TL-EXPECTED POINTER WS-PTR
         END-PERFORM
         CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     END-PERFORM

*>   The lookup over the table of five points.
     CALL "CLIMATE-POINTS-RESET"
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 5
         PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 6
             MOVE WS-P-MIN(WS-I, WS-K) TO WS-MIN(WS-K)
             MOVE WS-P-MAX(WS-I, WS-K) TO WS-MAX(WS-K)
         END-PERFORM
         MOVE WS-P-OFFSET(WS-I) TO WS-OFFSET
         CALL "CLIMATE-POINT-ADD" USING WS-P-BIOME(WS-I) WS-MINS WS-MAXS WS-OFFSET
     END-PERFORM
     MOVE 0 TO WS-BAD
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 7
         PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 6
             MOVE WS-T-VALUE(WS-I, WS-K) TO WS-TV(WS-K)
         END-PERFORM
         CALL "CLIMATE-FIND" USING WS-TARGET WS-INDEX WS-BIOME WS-FITNESS
         IF WS-INDEX NOT = WS-B-INDEX(WS-I) OR WS-FITNESS NOT = WS-B-FITNESS(WS-I)
             OR WS-BIOME NOT = WS-P-BIOME(WS-B-INDEX(WS-I))
             ADD 1 TO WS-BAD
         END-IF
     END-PERFORM
     MOVE "test climate find returns the smallest fitness and the earlier point on a tie, offset counted" TO TL-CASE
     MOVE "N" TO TL-MODE
     MOVE WS-BAD TO TL-OBSERVED-N
     MOVE 0 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

*>   The Nether preset of the content library: five points (point intervals), each found at its own values.
     CALL "CLIMATE-POINTS-LOAD" USING WS-PRESET WS-COUNT
     MOVE "test climate the Nether preset loads its five points" TO TL-CASE
     MOVE WS-COUNT TO TL-OBSERVED-N
     MOVE 5 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "test climate the Nether preset: the target (4000, 0, 0, 0, 0, 0) is crimson_forest, 0 is nether_wastes"
         TO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE 4000 TO WS-TV(1)
     MOVE 0 TO WS-TV(2) WS-TV(3) WS-TV(4) WS-TV(5) WS-TV(6)
     CALL "CLIMATE-FIND" USING WS-TARGET WS-INDEX WS-BIOME WS-FITNESS
     MOVE SPACES TO TL-OBSERVED
     MOVE WS-INDEX TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) " " FUNCTION TRIM(WS-BIOME) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE 0 TO WS-TV(1)
     CALL "CLIMATE-FIND" USING WS-TARGET WS-INDEX WS-BIOME WS-FITNESS
     MOVE FUNCTION TRIM(TL-OBSERVED) TO WS-TEXT
     MOVE WS-INDEX TO WS-EDIT
     MOVE SPACES TO TL-OBSERVED
     STRING FUNCTION TRIM(WS-TEXT) " " FUNCTION TRIM(WS-EDIT) " " FUNCTION TRIM(WS-BIOME)
         DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "3 minecraft:crimson_forest 1 minecraft:nether_wastes" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test climate biome at a quart cell samples and looks up (nether table, quart (0, 16, 0))" TO TL-CASE
     CALL "CLIMATE-BIOME-AT" USING WS-QX(1) WS-QY(1) WS-QZ(1) WS-INDEX WS-BIOME
     MOVE "T" TO TL-MODE
     MOVE SPACES TO TL-OBSERVED
     MOVE WS-INDEX TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) " " FUNCTION TRIM(WS-BIOME) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "1 minecraft:nether_wastes" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test climate an empty table finds nothing" TO TL-CASE
     CALL "CLIMATE-POINTS-RESET"
     CALL "CLIMATE-FIND" USING WS-TARGET WS-INDEX WS-BIOME WS-FITNESS
     MOVE "N" TO TL-MODE
     MOVE WS-INDEX TO TL-OBSERVED-N
     MOVE 0 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 ADD-Q.
     MOVE WS-Q TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) " " DELIMITED BY SIZE INTO WS-TEXT POINTER WS-PTR.
 END PROGRAM TEST-CLIMATE.
