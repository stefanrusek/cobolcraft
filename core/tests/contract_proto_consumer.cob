*> Contract test, the core's consumer side of the protocol codec (contracts/proto-api.md §1, §2, §5):
*> PB-BUFFER and every PROTO.cpy record the core uses have the lengths and field layout of the
*> contract, and each PB-*/NBT-*/CHUNK-*/LIGHT-* program the core calls links and returns on a
*> minimal valid call.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. CORE-CONTRACT-PROTO-CONSUMER.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY PROTO.
 COPY TESTLIB.
 01 WS-RAW                 PIC X(21).
 01 WS-RAW-LONG            BINARY-LONG.
 01 WS-CAPACITY            BINARY-LONG VALUE 64.
 01 WS-INT                 BINARY-LONG.
 01 WS-LONG                BINARY-DOUBLE.
 01 WS-FLOAT               FLOAT-SHORT.
 01 WS-DOUBLE              FLOAT-LONG.
 01 WS-TEXT                PIC X(64).
 01 WS-TEXT-LENGTH         BINARY-LONG.
 01 WS-MAX                 BINARY-LONG VALUE 64.
 01 WS-UUID                PIC X(16).
 01 WS-X                   BINARY-LONG.
 01 WS-Y                   BINARY-LONG.
 01 WS-Z                   BINARY-LONG.
 01 WS-NAME                PIC X(8) VALUE "name".
 01 WS-NAME-LENGTH         BINARY-LONG VALUE 4.
 01 WS-ROOT                BINARY-LONG VALUE -2.
 01 WS-TYPE                BINARY-LONG.
 01 WS-COUNT               BINARY-LONG.
 01 WS-THRESHOLD           BINARY-LONG VALUE -1.
 01 WS-STATES              BINARY-LONG OCCURS 4096 TIMES.
 01 WS-BIOMES              BINARY-LONG OCCURS 64 TIMES.
 01 WS-BLOCK-BITS          BINARY-LONG VALUE 5.
 01 WS-BIOME-BITS          BINARY-LONG VALUE 2.
 01 WS-ZERO                BINARY-LONG VALUE 0.
 01 WS-ZERO2               BINARY-LONG VALUE 0.
 01 WS-CAP2                BINARY-LONG VALUE 64.
 01 WS-LIGHT-COUNT         BINARY-LONG VALUE 1.
 01 WS-SKY-STATES          BINARY-LONG OCCURS 1 TIMES.
 01 WS-SKY-ARRAYS          PIC X(2048) OCCURS 1 TIMES.
 01 WS-BLOCK-STATES        BINARY-LONG OCCURS 1 TIMES.
 01 WS-BLOCK-ARRAYS        PIC X(2048) OCCURS 1 TIMES.
 01 WS-EDIT                PIC -(9)9.
 PROCEDURE DIVISION.
     MOVE "N" TO TL-MODE
     MOVE "contract core proto consumer PB-BUFFER is 21 bytes (pointer, capacity, length, pos, error)"
         TO TL-CASE
     MOVE 21 TO TL-EXPECTED-N
     MOVE LENGTH OF PB-BUFFER TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "contract core proto consumer PB-BUFFER field offsets 8, 12, 16, 20" TO TL-CASE
     MOVE LOW-VALUES TO PB-BUFFER
     MOVE 1 TO PB-CAPACITY
     MOVE 2 TO PB-LENGTH
     MOVE 3 TO PB-POS
     MOVE 4 TO PB-ERROR
     MOVE PB-BUFFER TO WS-RAW
     MOVE 12344 TO TL-EXPECTED-N
     MOVE WS-RAW(9:4) TO WS-RAW-LONG(1:4)
     COMPUTE TL-OBSERVED-N = WS-RAW-LONG * 10000
     MOVE WS-RAW(13:4) TO WS-RAW-LONG(1:4)
     COMPUTE TL-OBSERVED-N = TL-OBSERVED-N + WS-RAW-LONG * 1000
     MOVE WS-RAW(17:4) TO WS-RAW-LONG(1:4)
     COMPUTE TL-OBSERVED-N = TL-OBSERVED-N + WS-RAW-LONG * 100 + 40
     IF WS-RAW(21:1) = "4"
         ADD 4 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "contract core proto consumer PB-TEXT 9257 bytes, PB-ITEMSTACK 8 bytes (proto-api §2)"
         TO TL-CASE
     MOVE 9257008 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = LENGTH OF PB-TEXT * 1000 + LENGTH OF PB-ITEMSTACK
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "contract core proto consumer PB-TEXT kinds plain 0 literal 1 translate 2, 8 arguments"
         TO TL-CASE
     MOVE 128 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PB-TEXT-PLAIN * 1000 + PB-TEXT-LITERAL * 100 + PB-TEXT-TRANSLATE * 10
         + PB-TEXT-MAX-ARGS
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

*>   Every program the core calls, on a minimal valid call: writers then readers of the same bytes.
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     MOVE 1 TO WS-INT
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-INT
     CALL "PB-PUT-BOOL" USING PB-BUFFER WS-INT
     CALL "PB-PUT-BYTE" USING PB-BUFFER WS-INT
     CALL "PB-PUT-UBYTE" USING PB-BUFFER WS-INT
     CALL "PB-PUT-SHORT" USING PB-BUFFER WS-INT
     CALL "PB-PUT-USHORT" USING PB-BUFFER WS-INT
     CALL "PB-PUT-INT" USING PB-BUFFER WS-INT
     MOVE 1 TO WS-LONG
     CALL "PB-PUT-LONG" USING PB-BUFFER WS-LONG
     CALL "PB-PUT-VARLONG" USING PB-BUFFER WS-LONG
     MOVE 1 TO WS-FLOAT WS-DOUBLE
     CALL "PB-PUT-FLOAT" USING PB-BUFFER WS-FLOAT
     CALL "PB-PUT-DOUBLE" USING PB-BUFFER WS-DOUBLE
     MOVE "cobolcraft" TO WS-TEXT
     MOVE 10 TO WS-TEXT-LENGTH
     CALL "PB-PUT-STRING" USING PB-BUFFER WS-TEXT WS-TEXT-LENGTH WS-MAX
     MOVE "cobolcraft:main" TO WS-TEXT
     MOVE 15 TO WS-TEXT-LENGTH
     CALL "PB-PUT-IDENTIFIER" USING PB-BUFFER WS-TEXT WS-TEXT-LENGTH
     MOVE ALL "u" TO WS-UUID
     CALL "PB-PUT-UUID" USING PB-BUFFER WS-UUID
     MOVE 1 TO WS-X WS-Y WS-Z
     CALL "PB-PUT-POSITION" USING PB-BUFFER WS-X WS-Y WS-Z
     INITIALIZE PB-ITEMSTACK
     CALL "PB-PUT-ITEMSTACK" USING PB-BUFFER PB-ITEMSTACK
     INITIALIZE PB-TEXT
     MOVE "x" TO PB-TX-VALUE
     MOVE 1 TO PB-TX-LENGTH
     CALL "PB-PUT-TEXT" USING PB-BUFFER PB-TEXT
     CALL "PB-GET-VARINT" USING PB-BUFFER WS-INT
     CALL "PB-GET-BOOL" USING PB-BUFFER WS-INT
     CALL "PB-GET-BYTE" USING PB-BUFFER WS-INT
     CALL "PB-GET-UBYTE" USING PB-BUFFER WS-INT
     CALL "PB-GET-SHORT" USING PB-BUFFER WS-INT
     CALL "PB-GET-USHORT" USING PB-BUFFER WS-INT
     CALL "PB-GET-INT" USING PB-BUFFER WS-INT
     CALL "PB-GET-LONG" USING PB-BUFFER WS-LONG
     CALL "PB-GET-VARLONG" USING PB-BUFFER WS-LONG
     CALL "PB-GET-FLOAT" USING PB-BUFFER WS-FLOAT
     CALL "PB-GET-DOUBLE" USING PB-BUFFER WS-DOUBLE
     CALL "PB-GET-STRING" USING PB-BUFFER WS-MAX WS-TEXT WS-CAP2 WS-TEXT-LENGTH
     CALL "PB-GET-IDENTIFIER" USING PB-BUFFER WS-TEXT WS-MAX WS-TEXT-LENGTH
     CALL "PB-GET-UUID" USING PB-BUFFER WS-UUID
     CALL "PB-GET-POSITION" USING PB-BUFFER WS-X WS-Y WS-Z
     CALL "PB-GET-ITEMSTACK" USING PB-BUFFER PB-ITEMSTACK
     CALL "PB-GET-TEXT" USING PB-BUFFER PB-TEXT
     MOVE "contract core proto consumer scalar, string, identifier, uuid, position, itemstack, text round trip"
         TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PB-ERROR + PB-LENGTH - PB-POS
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     CALL "PB-RESET" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WS-NAME WS-ROOT
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WS-NAME WS-NAME-LENGTH WS-TEXT WS-TEXT-LENGTH
     CALL "NBT-WRITE-BYTE" USING PB-BUFFER WS-NAME WS-NAME-LENGTH WS-INT
     CALL "NBT-WRITE-INT" USING PB-BUFFER WS-NAME WS-NAME-LENGTH WS-INT
     CALL "NBT-WRITE-FLOAT" USING PB-BUFFER WS-NAME WS-NAME-LENGTH WS-FLOAT
     CALL "NBT-WRITE-DOUBLE" USING PB-BUFFER WS-NAME WS-NAME-LENGTH WS-DOUBLE
     CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WS-NAME WS-NAME-LENGTH WS-ZERO WS-ZERO2
     CALL "NBT-WRITE-LIST-END" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE 0 TO WS-INT
     CALL "NBT-READ-ROOT" USING PB-BUFFER WS-INT WS-TYPE
     MOVE 10 TO WS-INT
     CALL "NBT-READ-SKIP" USING PB-BUFFER WS-INT
     MOVE "contract core proto consumer NBT writers produce a network compound the reader skips whole"
         TO TL-CASE
     MOVE 10 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-TYPE + PB-ERROR * 100 + (PB-LENGTH - PB-POS) * 1000
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     CALL "PB-RESET" USING PB-BUFFER
     PERFORM VARYING WS-INT FROM 1 BY 1 UNTIL WS-INT > 4096
         MOVE 0 TO WS-STATES(WS-INT)
     END-PERFORM
     PERFORM VARYING WS-INT FROM 1 BY 1 UNTIL WS-INT > 64
         MOVE 0 TO WS-BIOMES(WS-INT)
     END-PERFORM
     CALL "CHUNK-SECTION-ENCODE" USING PB-BUFFER WS-ZERO WS-ZERO2 WS-STATES(1) WS-BIOMES(1)
         WS-BLOCK-BITS WS-BIOME-BITS
     MOVE 0 TO WS-SKY-STATES(1) WS-BLOCK-STATES(1)
     CALL "LIGHT-ENCODE" USING PB-BUFFER WS-LIGHT-COUNT WS-SKY-STATES(1) WS-SKY-ARRAYS(1)
         WS-BLOCK-STATES(1) WS-BLOCK-ARRAYS(1)
     MOVE "contract core proto consumer CHUNK-SECTION-ENCODE and LIGHT-ENCODE of an empty section"
         TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE PB-ERROR TO TL-OBSERVED-N
     IF PB-LENGTH = 0
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.
 END PROGRAM CORE-CONTRACT-PROTO-CONSUMER.
