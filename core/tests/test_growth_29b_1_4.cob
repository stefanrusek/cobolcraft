     MOVE "22.0 2.0 40 1 0 0.0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GB-FALL-DAMAGE" USING WS-FX1 WS-FX2 WS-I3 WS-I4 WS-I5 WS-FX6 WS-R1 WS-RF1 WS-R3 WS-R4
     COMPUTE WS-R2 ROUNDED = WS-RF1 * 1000
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "2.0 2.0 40 0 1 0.0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GB-FALL-DAMAGE" USING WS-FX1 WS-FX2 WS-I3 WS-I4 WS-I5 WS-FX6 WS-R1 WS-RF1 WS-R3 WS-R4
     COMPUTE WS-R2 ROUNDED = WS-RF1 * 1000
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "-1.0 2.0 40 1 1 0.0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GB-FALL-DAMAGE" USING WS-FX1 WS-FX2 WS-I3 WS-I4 WS-I5 WS-FX6 WS-R1 WS-RF1 WS-R3 WS-R4
