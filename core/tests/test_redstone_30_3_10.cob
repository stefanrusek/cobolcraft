 PROCEDURE DIVISION.
     MOVE "T" TO TL-MODE
     MOVE "acceptance US12 30-3§10 Client: client event (10.1): the client skips the power re-check and both cancel rules (client; re-check, cancel rules)" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-CLIENT-EVENT" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-CLIENT-EVENT" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "0/0 1/1" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 30-3§10 Client: lingering (10.1, 7.2): at progressO >= 1 a client entity waits 5 more ticks (step 1) before it removes itself and places the block (2)" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-MBE-LINGER" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-MBE-LINGER" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "2" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-MBE-LINGER" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "3" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-MBE-LINGER" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "4" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-MBE-LINGER" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "5" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-MBE-LINGER" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "6" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-MBE-LINGER" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1/1 1/2 1/3 1/4 1/5 2/5 2/6" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 30-3§10 Client: head state drawn (10.2): a pushed block or extending head draws short = progress <= 0.5; a retracting source head short = progress >= 0.5" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1 0.0" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-RENDER-SHORT" USING WS-I1 WS-FX2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 0.5" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-RENDER-SHORT" USING WS-I1 WS-FX2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 0.5000001" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-RENDER-SHORT" USING WS-I1 WS-FX2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "2 0.4999999" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-RENDER-SHORT" USING WS-I1 WS-FX2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "2 0.5" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-RENDER-SHORT" USING WS-I1 WS-FX2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "2 1.0" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-RENDER-SHORT" USING WS-I1 WS-FX2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 0 0 1 1" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 30-3§10 Client: render view and sampling (10.2): view distance 68; the pushed block or extending head and the retracting head sample the cell behind the movement, the extended" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1 5" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-RENDER-SAMPLE" USING WS-I1 WS-I2 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-RENDER-SAMPLE" USING WS-I1 WS-I2 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "2 5" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-RENDER-SAMPLE" USING WS-I1 WS-I2 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "2 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-RENDER-SAMPLE" USING WS-I1 WS-I2 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "3 5" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-RENDER-SAMPLE" USING WS-I1 WS-I2 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "3 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-RENDER-SAMPLE" USING WS-I1 WS-I2 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "68/-1/0/0 68/0/-1/0 68/-1/0/0 68/0/-1/0 68/1/0/0 68/0/1/0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 30-3§10 Client: draws nothing (10.2): nothing is drawn when the moved state is air" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-RENDER-DRAWS" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-RENDER-DRAWS" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 1" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 BEGIN-CASE.
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR
     .

 LOAD-IN.
     MOVE 1 TO WS-P
     PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 16
         MOVE SPACES TO WS-TOK
         IF WS-P <= 160
             UNSTRING WS-IN DELIMITED BY ALL SPACE INTO WS-TOK WITH POINTER WS-P
         END-IF
         COMPUTE WS-FX(WS-K) = FUNCTION NUMVAL(WS-TOK)
         COMPUTE WS-I(WS-K) = FUNCTION NUMVAL(WS-TOK)
     END-PERFORM
     .

 ADD-N.
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N
         MOVE WS-R(WS-J) TO WS-SHOW
         IF WS-J > 1
             STRING "/" DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
         END-IF
         STRING FUNCTION TRIM(WS-SHOW) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-PERFORM
     STRING " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .

 ADD-TEXT.
     STRING FUNCTION TRIM(WS-T1) "|" FUNCTION TRIM(WS-T2) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .
 END PROGRAM TEST-REDSTONE-30-3-10.
