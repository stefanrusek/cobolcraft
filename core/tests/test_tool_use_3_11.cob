     PERFORM ADD-OBS
     MOVE 2 TO WS-I1
     MOVE 1 TO WS-I2
     CALL "TOOL-FISH-ENTRY" USING WS-I1 WS-I2 WS-X1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-X1) "/" FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 2 TO WS-I1
     MOVE 13 TO WS-I2
     CALL "TOOL-FISH-ENTRY" USING WS-I1 WS-I2 WS-X1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-X1) "/" FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
