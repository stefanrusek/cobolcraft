     MOVE 0 TO WS-I2
     MOVE 1 TO WS-I3
     MOVE 0 TO WS-I4
     CALL "TOOL-FISH-RETRIEVE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
