*> Test of special use 3.5 (17 section 3.5; core/src/tools-use.cob): the brush, 10 brushes, 10 tick cooldown, 40 tick reset, dusted stages, 1 durability per completed block.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-TOOL-USE-3-5.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 01 WS-I1 BINARY-LONG.
 01 WS-I2 BINARY-LONG.
 01 WS-I3 BINARY-LONG.
 01 WS-I4 BINARY-LONG.
 01 WS-I5 BINARY-LONG.
 01 WS-I6 BINARY-LONG.
 01 WS-I7 BINARY-LONG.
 01 WS-I8 BINARY-LONG.
 01 WS-T1 PIC X(48).
 01 WS-T2 PIC X(48).
 01 WS-T3 PIC X(48).
 01 WS-O1 BINARY-LONG.
 01 WS-O2 BINARY-LONG.
 01 WS-O3 BINARY-LONG.
 01 WS-O4 BINARY-LONG.
 01 WS-O5 BINARY-LONG.
 01 WS-O6 BINARY-LONG.
 01 WS-X1 PIC X(48).
 01 WS-X2 PIC X(48).
 01 WS-X3 PIC X(48).
 01 WS-OBS PIC X(240).
 01 WS-E1 PIC -(9)9.
 01 WS-E2 PIC -(9)9.
 01 WS-E3 PIC -(9)9.
 01 WS-E4 PIC -(9)9.
 01 WS-E5 PIC -(9)9.
 01 WS-E6 PIC -(9)9.
 PROCEDURE DIVISION.
     MOVE "acceptance US14 brush constants: use duration 200, 10 brushes to break, cooldown 10, reset 40, durability 64" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     CALL "TOOL-BRUSH-INFO" USING WS-O1 WS-O2 WS-O3 WS-O4 WS-O5
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     MOVE WS-O3 TO WS-E3
     MOVE WS-O4 TO WS-E4
     MOVE WS-O5 TO WS-E5
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) "/" FUNCTION TRIM(WS-E3) "/" FUNCTION TRIM(WS-E4) "/" FUNCTION TRIM(WS-E5) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "200/10/10/40/64" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 brush dusted state follows the brush count: 0 gives 0, 1 to 2 give 1, 3 to 5 give 2, 6 or more give 3" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE 0 TO WS-I1
     CALL "TOOL-BRUSH-DUSTED" USING WS-I1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 1 TO WS-I1
     CALL "TOOL-BRUSH-DUSTED" USING WS-I1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 2 TO WS-I1
     CALL "TOOL-BRUSH-DUSTED" USING WS-I1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 3 TO WS-I1
     CALL "TOOL-BRUSH-DUSTED" USING WS-I1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 5 TO WS-I1
     CALL "TOOL-BRUSH-DUSTED" USING WS-I1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 6 TO WS-I1
     CALL "TOOL-BRUSH-DUSTED" USING WS-I1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 9 TO WS-I1
     CALL "TOOL-BRUSH-DUSTED" USING WS-I1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "0 1 1 2 2 3 3" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 a brush is counted after the 10 tick cooldown only; the 10th counted brush completes the block and costs 1 durability" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE 0 TO WS-I1
     MOVE 10 TO WS-I2
     CALL "TOOL-BRUSH-COUNT" USING WS-I1 WS-I2 WS-O1 WS-O2 WS-O3
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     MOVE WS-O3 TO WS-E3
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) "/" FUNCTION TRIM(WS-E3) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 3 TO WS-I1
     MOVE 9 TO WS-I2
     CALL "TOOL-BRUSH-COUNT" USING WS-I1 WS-I2 WS-O1 WS-O2 WS-O3
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     MOVE WS-O3 TO WS-E3
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) "/" FUNCTION TRIM(WS-E3) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 9 TO WS-I1
     MOVE 10 TO WS-I2
     CALL "TOOL-BRUSH-COUNT" USING WS-I1 WS-I2 WS-O1 WS-O2 WS-O3
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     MOVE WS-O3 TO WS-E3
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) "/" FUNCTION TRIM(WS-E3) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 4 TO WS-I1
     MOVE 25 TO WS-I2
     CALL "TOOL-BRUSH-COUNT" USING WS-I1 WS-I2 WS-O1 WS-O2 WS-O3
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     MOVE WS-O3 TO WS-E3
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) "/" FUNCTION TRIM(WS-E3) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "1/1/0 3/0/0 10/2/1 5/1/0" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 the progress resets after 40 ticks without brushing" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE 39 TO WS-I1
     CALL "TOOL-BRUSH-RESET" USING WS-I1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 40 TO WS-I1
     CALL "TOOL-BRUSH-RESET" USING WS-I1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "0 1" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 onUseTick brushes the block on use ticks 5, 15, 25 (used ticks modulo 10 equal 5)" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE 196 TO WS-I1
     CALL "TOOL-BRUSH-TICK" USING WS-I1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 195 TO WS-I1
     CALL "TOOL-BRUSH-TICK" USING WS-I1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 186 TO WS-I1
     CALL "TOOL-BRUSH-TICK" USING WS-I1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 200 TO WS-I1
     CALL "TOOL-BRUSH-TICK" USING WS-I1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "1 0 1 0" TO TL-EXPECTED
     PERFORM CHECK-DONE

     STOP RUN.

 ADD-OBS.
     IF TL-OBSERVED = SPACES
         MOVE FUNCTION TRIM(WS-OBS) TO TL-OBSERVED
     ELSE
         STRING FUNCTION TRIM(TL-OBSERVED) " " FUNCTION TRIM(WS-OBS) DELIMITED BY SIZE INTO TL-OBSERVED
     END-IF.

 CHECK-DONE.
     MOVE "T" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-TOOL-USE-3-5.
