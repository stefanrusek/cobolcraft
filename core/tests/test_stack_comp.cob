*> Test of the typed component accessors over the stack patch pool (core/src/stack-comp.cob; docs/protocol/17 section 1.2, 46 section 8.1; T9600): enchantments and
*> stored_enchantments are read, written, counted and enumerated by component type; the 13 accessors of stack-patch.cob are the same programs for type 13.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-STACK-COMP.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY CMENU.
 COPY CSTACK.
 COPY CONTENT.
 COPY COREAPI.
 COPY PROTO.
 01 WS-H1                  BINARY-LONG.
 01 WS-H2                  BINARY-LONG.
 01 WS-T13                 BINARY-LONG VALUE 13.
 01 WS-T45                 BINARY-LONG VALUE 45.
 01 WS-ID                  BINARY-LONG.
 01 WS-LEVEL               BINARY-LONG.
 01 WS-N                   BINARY-LONG.
 01 WS-A                   BINARY-LONG.
 01 WS-B                   BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-TYPE53              BINARY-LONG VALUE 53.
 01 WS-VALUE               PIC X(64).
 01 WS-LENGTH              BINARY-LONG.
 01 WS-FOUND               BINARY-LONG.
 01 WS-POTION              BINARY-LONG.
 01 WS-COLOR               BINARY-LONG.
 01 WS-HAS-COLOR           BINARY-LONG.
 01 WS-CUSTOM              BINARY-LONG.
 01 WS-SCALE               BINARY-LONG.
 01 WS-AMP                 BINARY-LONG.
 01 WS-DUR                 BINARY-LONG.
 01 WS-KEY                 PIC X(32).
 01 WS-FX.
    05 WS-FX-E OCCURS 8 TIMES.
       10 WS-FX-ID         BINARY-LONG.
       10 WS-FX-AMP        BINARY-LONG.
       10 WS-FX-DUR        BINARY-LONG.
 01 WS-BIG                 PIC X(2048).
 COPY POTREC.
 01 WS-E5                  PIC -(9)9.
 01 WS-E6                  PIC -(9)9.
 01 WS-E1                  PIC -(9)9.
 01 WS-E2                  PIC -(9)9.
 01 WS-E3                  PIC -(9)9.
 01 WS-E4                  PIC -(9)9.
 PROCEDURE DIVISION.
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     PERFORM CLEAR-POOL

     MOVE "test stack comp stored enchantments are separate from enchantments and listed by ascending id" TO TL-CASE
     MOVE 0 TO WS-H1
     MOVE 40 TO WS-ID
     MOVE 2 TO WS-LEVEL
     CALL "SC-ENCH-ADD" USING WS-H1 WS-T45 WS-ID WS-LEVEL
     MOVE 7 TO WS-ID
     MOVE 3 TO WS-LEVEL
     CALL "SC-ENCH-ADD" USING WS-H1 WS-T45 WS-ID WS-LEVEL
     MOVE 40 TO WS-ID
     MOVE 5 TO WS-LEVEL
     CALL "SC-ENCH-ADD" USING WS-H1 WS-T45 WS-ID WS-LEVEL
     CALL "SC-ENCH-COUNT" USING WS-H1 WS-T45 WS-N
     CALL "SC-ENCH-COUNT" USING WS-H1 WS-T13 WS-A
     MOVE 1 TO WS-I
     CALL "SC-ENCH-NTH" USING WS-H1 WS-T45 WS-I WS-ID WS-LEVEL
     MOVE SPACES TO TL-OBSERVED
     MOVE WS-N TO WS-E1
     MOVE WS-A TO WS-E2
     MOVE WS-ID TO WS-E3
     MOVE WS-LEVEL TO WS-E4
     STRING "n=" FUNCTION TRIM(WS-E1) " plain=" FUNCTION TRIM(WS-E2) " first=" FUNCTION TRIM(WS-E3) "/" FUNCTION TRIM(WS-E4)
         DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "n=2 plain=0 first=7/3" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack comp a potion_contents component holds the potion id as the wire bytes of component 53" TO TL-CASE
     MOVE 0 TO WS-H1
     MOVE 24 TO WS-POTION
     CALL "SC-POTION-SET" USING WS-H1 WS-POTION
     CALL "SP-GET-COMPONENT" USING WS-H1 WS-TYPE53 WS-VALUE WS-LENGTH WS-FOUND
     MOVE 0 TO WS-POTION
     CALL "SC-POTION-GET" USING WS-H1 WS-POTION WS-HAS-COLOR WS-COLOR WS-CUSTOM
     MOVE WS-FOUND TO WS-E1
     MOVE WS-LENGTH TO WS-E2
     MOVE WS-POTION TO WS-E3
     MOVE WS-CUSTOM TO WS-E4
     MOVE FUNCTION ORD(WS-VALUE(2:1)) TO WS-E5
     MOVE WS-HAS-COLOR TO WS-E6
     MOVE SPACES TO TL-OBSERVED
     STRING "found=" FUNCTION TRIM(WS-E1) " len=" FUNCTION TRIM(WS-E2) " potion=" FUNCTION TRIM(WS-E3) " custom=" FUNCTION TRIM(WS-E4)
         " byte2=" FUNCTION TRIM(WS-E5) " color=" FUNCTION TRIM(WS-E6) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "found=1 len=5 potion=24 custom=0 byte2=25 color=0" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack comp equal potions share one handle and a stack without the component has no potion" TO TL-CASE
     MOVE 0 TO WS-H2
     MOVE 24 TO WS-POTION
     CALL "SC-POTION-SET" USING WS-H2 WS-POTION
     MOVE 0 TO WS-A
     CALL "SC-POTION-GET" USING WS-A WS-POTION WS-HAS-COLOR WS-COLOR WS-CUSTOM
     MOVE WS-POTION TO WS-E1
     IF WS-H1 = WS-H2 AND WS-H1 > 0
         MOVE "same" TO WS-KEY
     ELSE
         MOVE "different" TO WS-KEY
     END-IF
     MOVE SPACES TO TL-OBSERVED
     STRING FUNCTION TRIM(WS-KEY) " none=" FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "same none=-1" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack comp a custom effect is kept after the potion and read back by index" TO TL-CASE
     MOVE 11 TO WS-ID
     MOVE 1 TO WS-AMP
     MOVE 200 TO WS-DUR
     CALL "SC-POTION-ADD-EFFECT" USING WS-H1 WS-ID WS-AMP WS-DUR
     MOVE 5 TO WS-ID
     MOVE 0 TO WS-AMP
     MOVE 1 TO WS-DUR
     CALL "SC-POTION-ADD-EFFECT" USING WS-H1 WS-ID WS-AMP WS-DUR
     MOVE 2 TO WS-I
     CALL "SC-POTION-EFFECT" USING WS-H1 WS-I WS-ID WS-AMP WS-DUR
     CALL "SC-POTION-GET" USING WS-H1 WS-POTION WS-HAS-COLOR WS-COLOR WS-CUSTOM
     MOVE WS-POTION TO WS-E1
     MOVE WS-CUSTOM TO WS-E2
     MOVE WS-ID TO WS-E3
     MOVE WS-AMP TO WS-E4
     MOVE WS-DUR TO WS-E5
     MOVE SPACES TO TL-OBSERVED
     STRING "potion=" FUNCTION TRIM(WS-E1) " custom=" FUNCTION TRIM(WS-E2) " second=" FUNCTION TRIM(WS-E3) "/" FUNCTION TRIM(WS-E4)
         "/" FUNCTION TRIM(WS-E5) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "potion=24 custom=2 second=5/0/1" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack comp the effects of a stack are the potion's table rows then the custom effects, scaled" TO TL-CASE
     MOVE 0 TO WS-H2
     MOVE 19 TO WS-POTION
     CALL "SC-POTION-SET" USING WS-H2 WS-POTION
     MOVE 11 TO WS-ID
     MOVE 0 TO WS-AMP
     MOVE 100 TO WS-DUR
     CALL "SC-POTION-ADD-EFFECT" USING WS-H2 WS-ID WS-AMP WS-DUR
     MOVE 250 TO WS-SCALE
     CALL "SC-POTION-RESOLVE" USING WS-H2 WS-SCALE WS-N WS-FX
     MOVE WS-N TO WS-E1
     MOVE WS-FX-ID(1) TO WS-E2
     MOVE WS-FX-AMP(1) TO WS-E3
     MOVE WS-FX-DUR(1) TO WS-E4
     MOVE WS-FX-ID(2) TO WS-E5
     MOVE WS-FX-DUR(3) TO WS-E6
     MOVE SPACES TO TL-OBSERVED
     STRING "n=" FUNCTION TRIM(WS-E1) " first=" FUNCTION TRIM(WS-E2) "/" FUNCTION TRIM(WS-E3) "/" FUNCTION TRIM(WS-E4) " second=" FUNCTION TRIM(WS-E5)
         " third dur=" FUNCTION TRIM(WS-E6) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "n=3 first=1/3/100 second=10 third dur=25" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack comp an instant potion keeps duration 1 when scaled and a water bottle has no effects" TO TL-CASE
     MOVE 0 TO WS-H2
     MOVE 25 TO WS-POTION
     CALL "SC-POTION-SET" USING WS-H2 WS-POTION
     MOVE 250 TO WS-SCALE
     CALL "SC-POTION-RESOLVE" USING WS-H2 WS-SCALE WS-N WS-FX
     MOVE WS-N TO WS-E1
     MOVE WS-FX-ID(1) TO WS-E2
     MOVE WS-FX-AMP(1) TO WS-E3
     MOVE WS-FX-DUR(1) TO WS-E4
     MOVE 0 TO WS-H2
     MOVE 0 TO WS-POTION
     CALL "SC-POTION-SET" USING WS-H2 WS-POTION
     MOVE 1000 TO WS-SCALE
     CALL "SC-POTION-RESOLVE" USING WS-H2 WS-SCALE WS-N WS-FX
     MOVE WS-N TO WS-E5
     MOVE SPACES TO TL-OBSERVED
     STRING "n=" FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) "/" FUNCTION TRIM(WS-E3) "/" FUNCTION TRIM(WS-E4) " water n=" FUNCTION TRIM(WS-E5)
         DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "n=1 5/1/1 water n=0" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack comp the potion key table gives the registry id of a potion and -1 for an unknown key" TO TL-CASE
     MOVE "fire_resistance" TO WS-KEY
     CALL "SC-POTION-ID" USING WS-KEY WS-A
     MOVE WS-A TO WS-E1
     MOVE "minecraft:strong_turtle_master" TO WS-KEY
     CALL "SC-POTION-ID" USING WS-KEY WS-A
     MOVE WS-A TO WS-E2
     MOVE "nope" TO WS-KEY
     CALL "SC-POTION-ID" USING WS-KEY WS-A
     MOVE WS-A TO WS-E3
     MOVE SPACES TO TL-OBSERVED
     STRING FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) " " FUNCTION TRIM(WS-E3) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "11 21 -1" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack comp a colour, an infinite effect and a custom name survive a write and a read" TO TL-CASE
     INITIALIZE PR-REC
     MOVE 3 TO PR-POTION
     MOVE 1 TO PR-HAS-COLOR
     MOVE -16711936 TO PR-COLOR
     MOVE 1 TO PR-N
     MOVE 8 TO PR-FX-ID(1)
     MOVE 2 TO PR-FX-AMP(1)
     MOVE -1 TO PR-FX-DUR(1)
     MOVE 2 TO PR-NAME-LEN
     MOVE "Hi" TO PR-NAME
     MOVE 0 TO WS-H2
     CALL "SC-POTION-WRITE" USING WS-H2 PR-REC
     INITIALIZE PR-REC
     CALL "SC-POTION-READ" USING WS-H2 PR-REC
     MOVE PR-POTION TO WS-E1
     MOVE PR-COLOR TO WS-E2
     MOVE PR-FX-DUR(1) TO WS-E3
     MOVE PR-FX-AMP(1) TO WS-E4
     MOVE PR-NAME-LEN TO WS-E5
     MOVE SPACES TO TL-OBSERVED
     STRING FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) " " FUNCTION TRIM(WS-E3) " " FUNCTION TRIM(WS-E4) " " FUNCTION TRIM(WS-E5) " " PR-NAME(1:2)
         DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "3 -16711936 -1 2 2 Hi" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack comp an effect with a hidden effect stops the list and an over long name is cut to 64 bytes" TO TL-CASE
     MOVE SPACES TO WS-BIG
     MOVE X"00000101000500010101" TO WS-BIG(1:10)
     MOVE 10 TO WS-LENGTH
     MOVE 0 TO WS-H2
     CALL "SP-SET-COMPONENT-X" USING WS-H2 WS-TYPE53 WS-BIG WS-LENGTH
     CALL "SC-POTION-READ" USING WS-H2 PR-REC
     MOVE PR-N TO WS-E1
     MOVE SPACES TO WS-BIG
     MOVE X"000000016400" TO WS-BIG(1:6)
     MOVE ALL "A" TO WS-BIG(6:100)
     MOVE 105 TO WS-LENGTH
     MOVE 0 TO WS-H2
     CALL "SP-SET-COMPONENT-X" USING WS-H2 WS-TYPE53 WS-BIG WS-LENGTH
     CALL "SC-POTION-READ" USING WS-H2 PR-REC
     MOVE PR-NAME-LEN TO WS-E2
     MOVE SPACES TO WS-BIG
     MOVE X"0000808080808080" TO WS-BIG(1:8)
     MOVE 8 TO WS-LENGTH
     MOVE 0 TO WS-H2
     CALL "SP-SET-COMPONENT-X" USING WS-H2 WS-TYPE53 WS-BIG WS-LENGTH
     CALL "SC-POTION-READ" USING WS-H2 PR-REC
     MOVE PR-N TO WS-E3
     MOVE SPACES TO TL-OBSERVED
     STRING "hidden n=" FUNCTION TRIM(WS-E1) " name len=" FUNCTION TRIM(WS-E2) " runaway n=" FUNCTION TRIM(WS-E3) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "hidden n=0 name len=64 runaway n=0" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack comp an index past the list gives id -1 and a count above 20 is cut to 20" TO TL-CASE
     MOVE 5 TO WS-I
     CALL "SC-ENCH-NTH" USING WS-H1 WS-T45 WS-I WS-ID WS-LEVEL
     MOVE WS-ID TO WS-E1
     MOVE SPACES TO WS-BIG
     MOVE X"1E" TO WS-BIG(1:1)
     MOVE 1 TO WS-LENGTH
     MOVE 0 TO WS-H2
     CALL "SP-SET-COMPONENT-X" USING WS-H2 WS-T13 WS-BIG WS-LENGTH
     CALL "SC-ENCH-COUNT" USING WS-H2 WS-T13 WS-N
     MOVE WS-N TO WS-E2
     MOVE 0 TO WS-I
     CALL "SC-ENCH-NTH" USING WS-H2 WS-T13 WS-I WS-ID WS-LEVEL
     MOVE WS-ID TO WS-E3
     MOVE SPACES TO TL-OBSERVED
     STRING FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) " " FUNCTION TRIM(WS-E3) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "-1 20 -1" TO TL-EXPECTED
     PERFORM CHECK
     STOP RUN.

 CLEAR-POOL.
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 512
         MOVE 0 TO SP-LIVE(WS-I)
     END-PERFORM.

 CHECK.
     MOVE "T" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-STACK-COMP.
 COPY CORETEST.
