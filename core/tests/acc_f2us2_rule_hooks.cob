*> Acceptance test, feature 002 (task T4806; docs/protocol/33 section 8.1): limited_crafting, immediate_respawn and reduced_debug_info are in the
*> Login packet (reduced debug info, show death screen = not immediate respawn, limited crafting) and a change sends Game Event 12, Game Event 11
*> and Entity Event 22/23 to every player (RULE-CHANGED; the gamerule command calls it).
 IDENTIFICATION DIVISION.
 PROGRAM-ID. ACC-F2US2-RULE-HOOKS.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY COREAPI.
 COPY PROTO.
 01 WS-NAME                PIC X(16) VALUE "Alice".
 01 WS-NAME-LENGTH         BINARY-LONG VALUE 5.
 01 WS-ALICE               BINARY-LONG.
 01 WS-ROW                 BINARY-LONG.
 01 WS-CAPACITY            BINARY-LONG VALUE 512.
 01 WS-N                   BINARY-LONG.
 01 WS-COUNT               BINARY-LONG.
 01 WS-KEY                 PIC X(64).
 01 WS-KEY-CAPACITY        BINARY-LONG VALUE 64.
 01 WS-KEY-LENGTH          BINARY-LONG.
 01 WS-B1                  BINARY-LONG.
 01 WS-B2                  BINARY-LONG.
 01 WS-B3                  BINARY-LONG.
 01 WS-E1                  PIC 9.
 01 WS-E2                  PIC 9.
 01 WS-E3                  PIC 9.
 01 WS-TEXT                PIC X(4096).
 01 WS-RULE-NAME           PIC X(40).
 01 WS-RULE-INDEX          BINARY-LONG.
 01 WS-RULE-VALUE          BINARY-DOUBLE.
 PROCEDURE DIVISION.
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     MOVE 2 TO CS-VIEW-DISTANCE
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     CALL "TEST-JOIN" USING WS-NAME WS-NAME-LENGTH WS-ALICE
     MOVE CN-PLAYER(WS-ALICE) TO WS-ROW
     PERFORM LOGIN-FLAGS
     MOVE "acceptance 33 8.1 default rules: Login reduced 0, death screen 1, limited 0" TO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE "010" TO TL-EXPECTED
     STRING WS-E1 WS-E2 WS-E3 DELIMITED BY SIZE INTO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 1 TO WS-RULE-VALUE
     MOVE "reduced_debug_info" TO WS-RULE-NAME
     PERFORM SET-RULE
     MOVE "immediate_respawn" TO WS-RULE-NAME
     PERFORM SET-RULE
     MOVE "limited_crafting" TO WS-RULE-NAME
     PERFORM SET-RULE
     PERFORM LOGIN-FLAGS
     MOVE "acceptance 33 8.1 the three rules on: Login reduced 1, death screen 0, limited 1" TO TL-CASE
     MOVE "101" TO TL-EXPECTED
     STRING WS-E1 WS-E2 WS-E3 DELIMITED BY SIZE INTO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     CALL "TEST-DRAIN-IDS" USING WS-ALICE WS-TEXT
     MOVE "limited_crafting" TO WS-RULE-NAME
     PERFORM CHANGED
     MOVE "immediate_respawn" TO WS-RULE-NAME
     PERFORM CHANGED
     MOVE "reduced_debug_info" TO WS-RULE-NAME
     PERFORM CHANGED
     MOVE "pvp" TO WS-RULE-NAME
     PERFORM CHANGED
     CALL "TEST-DRAIN-IDS" USING WS-ALICE WS-TEXT
     MOVE "acceptance 33 8.1 three hooked rules changed: Game Event x2 and Entity Event, none for pvp" TO TL-CASE
     MOVE "39x2 34" TO TL-EXPECTED
     MOVE WS-TEXT TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 CHANGED.
     CALL "BR-RULE-FIND" USING WS-RULE-NAME WS-RULE-INDEX
     CALL "RULE-CHANGED" USING WS-RULE-INDEX.

 SET-RULE.
     CALL "BR-RULE-FIND" USING WS-RULE-NAME WS-RULE-INDEX
     CALL "BR-RULE-SET" USING WS-RULE-INDEX WS-RULE-VALUE.

 LOGIN-FLAGS.
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     CALL "PLAY-LOGIN-BUILD" USING WS-ROW PB-BUFFER
     CALL "PB-GET-VARINT" USING PB-BUFFER WS-N
     CALL "PB-GET-INT" USING PB-BUFFER WS-N
     CALL "PB-GET-BOOL" USING PB-BUFFER WS-N
     CALL "PB-GET-VARINT" USING PB-BUFFER WS-COUNT
     PERFORM WS-COUNT TIMES
         CALL "PB-GET-IDENTIFIER" USING PB-BUFFER WS-KEY WS-KEY-CAPACITY WS-KEY-LENGTH
     END-PERFORM
     CALL "PB-GET-VARINT" USING PB-BUFFER WS-N
     CALL "PB-GET-VARINT" USING PB-BUFFER WS-N
     CALL "PB-GET-VARINT" USING PB-BUFFER WS-N
     CALL "PB-GET-BOOL" USING PB-BUFFER WS-B1
     CALL "PB-GET-BOOL" USING PB-BUFFER WS-B2
     CALL "PB-GET-BOOL" USING PB-BUFFER WS-B3
     CALL "PB-FREE" USING PB-BUFFER
     MOVE WS-B1 TO WS-E1
     MOVE WS-B2 TO WS-E2
     MOVE WS-B3 TO WS-E3
     MOVE SPACES TO TL-OBSERVED.
 END PROGRAM ACC-F2US2-RULE-HOOKS.

 COPY CORETEST.
