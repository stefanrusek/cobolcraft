*> Test of item stacks with data components in the player's menu (core/src/menus.cob, menu-inventory.cob, inventory.cob; docs/protocol/40-menus-1
*> section 3, 17 section 1.1 and 00 section 12; T3650 to T3652): a stack carries its patch handle (the -VAR fields) through
*> PICKUP, SWAP, QUICK_MOVE, PICKUP_ALL and QUICK_CRAFT clicks, the off-hand swap, Container Close and Set Creative Mode Slot;
*> two stacks merge only when item and patch are equal, otherwise the click swaps or the mover looks on; the echo of a changed
*> slot carries the component patch on the wire. Alice (survival) holds stone (item 1); H is the patch "named Hi".
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-STACK-MENU.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY CMENU.
 COPY COREAPI.
 COPY PROTO.
 COPY PLAYPKT.
 01 WS-NAME                PIC X(16).
 01 WS-NAME-LENGTH         BINARY-LONG VALUE 5.
 01 WS-CONN                BINARY-LONG.
 01 WS-ROW                 BINARY-LONG.
 01 WS-H                   BINARY-LONG.
 01 WS-TEXT-NAME           PIC X(64).
 01 WS-TEXT-LENGTH         BINARY-LONG VALUE 2.
 01 WS-SLOT                BINARY-LONG.
 01 WS-BUTTON              BINARY-LONG.
 01 WS-TYPE                BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-STATE               BINARY-LONG.
 01 WS-PTR                 BINARY-LONG.
 01 WS-TEXT                PIC X(1024).
 01 WS-TEXT-2              PIC X(1024).
 01 WS-EDIT                PIC -(9)9.
 01 WS-EDIT2               PIC -(9)9.
 01 WS-EDIT3               PIC -(9)9.
 01 WS-EDIT4               PIC -(9)9.
 01 WS-EDIT5               PIC -(9)9.
 01 WS-EDIT6               PIC -(9)9.
 01 WS-EDIT7               PIC -(9)9.
 01 WS-PACKET-ID           BINARY-LONG VALUE 57.
 01 WS-CAPACITY            BINARY-LONG VALUE 256.
 01 WS-STONE               BINARY-LONG VALUE 1.
 01 WS-ONE                 BINARY-LONG VALUE 1.
 PROCEDURE DIVISION.
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     MOVE 0 TO CS-DEFAULT-MODE
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     MOVE "Alice" TO WS-NAME
     CALL "TEST-JOIN" USING WS-NAME WS-NAME-LENGTH WS-CONN
     MOVE CN-PLAYER(WS-CONN) TO WS-ROW
     MOVE SPACES TO WS-TEXT-NAME
     MOVE "Hi" TO WS-TEXT-NAME
     MOVE 0 TO WS-H
     CALL "SP-SET-NAME" USING WS-H WS-TEXT-NAME WS-TEXT-LENGTH
     PERFORM EMPTY-ALL

     MOVE "test stack menu PICKUP of a named stone and a PICKUP on an empty slot move the patch with the stack, and "
         & "the echo of the placed stack carries the component patch" TO TL-CASE
     MOVE 1 TO PL-SLOT-ITEM(WS-ROW, 10)
     MOVE 1 TO PL-SLOT-COUNT(WS-ROW, 10)
     MOVE WS-H TO PL-SLOT-VAR(WS-ROW, 10)
     CALL "TEST-DRAIN-BLOCKS" USING WS-CONN WS-TEXT
     MOVE 9 TO WS-SLOT
     PERFORM CLICK-PICKUP
     MOVE PL-CARRIED-VAR(WS-ROW) TO WS-EDIT
     MOVE PL-SLOT-VAR(WS-ROW, 10) TO WS-EDIT2
     MOVE SPACES TO WS-TEXT-2
     STRING "carried " FUNCTION TRIM(WS-EDIT) " slot " FUNCTION TRIM(WS-EDIT2) DELIMITED BY SIZE INTO WS-TEXT-2
     MOVE 10 TO WS-SLOT
     PERFORM CLICK-PICKUP
     CALL "TEST-DRAIN-BLOCKS" USING WS-CONN WS-TEXT
     MOVE WS-H TO WS-EDIT
     MOVE PL-CARRIED-VAR(WS-ROW) TO WS-EDIT3
     MOVE PL-SLOT-VAR(WS-ROW, 11) TO WS-EDIT4
     MOVE SPACES TO TL-OBSERVED
     STRING FUNCTION TRIM(WS-TEXT-2) " then carried " FUNCTION TRIM(WS-EDIT3) " slot " FUNCTION TRIM(WS-EDIT4)
         " echo " FUNCTION TRIM(WS-TEXT) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE SPACES TO TL-EXPECTED
     COMPUTE WS-STATE = PL-STATE-ID(WS-ROW) - 1
     MOVE WS-STATE TO WS-EDIT2
     COMPUTE WS-STATE = PL-STATE-ID(WS-ROW)
     MOVE WS-STATE TO WS-EDIT3
     STRING "carried " FUNCTION TRIM(WS-EDIT) " slot 0 then carried 0 slot " FUNCTION TRIM(WS-EDIT)
         " echo 20(" FUNCTION TRIM(WS-EDIT2) ",9=0x0) 18 20(" FUNCTION TRIM(WS-EDIT3) ",10=1x1{a1r0})"
         DELIMITED BY SIZE INTO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack menu a click that puts a stone with one patch on a stone with another patch swaps them, "
         & "the cursor holds the other stack" TO TL-CASE
     PERFORM EMPTY-ALL
     PERFORM SET-STONES-2-H-3-PLAIN
     MOVE 9 TO WS-SLOT
     PERFORM CLICK-PICKUP
     MOVE 10 TO WS-SLOT
     PERFORM CLICK-PICKUP
     PERFORM DESCRIBE
     MOVE WS-H TO WS-EDIT
     MOVE SPACES TO TL-EXPECTED
     STRING "cursor 1x3/0 s9 0x0/0 s10 1x2/" FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack menu stones with the same patch merge on a PICKUP" TO TL-CASE
     PERFORM EMPTY-ALL
     MOVE 1 TO PL-SLOT-ITEM(WS-ROW, 10) PL-SLOT-ITEM(WS-ROW, 11)
     MOVE 2 TO PL-SLOT-COUNT(WS-ROW, 10)
     MOVE 3 TO PL-SLOT-COUNT(WS-ROW, 11)
     MOVE WS-H TO PL-SLOT-VAR(WS-ROW, 10) PL-SLOT-VAR(WS-ROW, 11)
     MOVE 9 TO WS-SLOT
     PERFORM CLICK-PICKUP
     MOVE 10 TO WS-SLOT
     PERFORM CLICK-PICKUP
     PERFORM DESCRIBE
     MOVE WS-H TO WS-EDIT
     MOVE SPACES TO TL-EXPECTED
     STRING "cursor 0x0/0 s9 0x0/0 s10 1x5/" FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack menu QUICK_MOVE moves a named stone to the first empty hotbar slot and not onto a plain stone"
         TO TL-CASE
     PERFORM EMPTY-ALL
     MOVE 1 TO PL-SLOT-ITEM(WS-ROW, 10) PL-SLOT-ITEM(WS-ROW, 1)
     MOVE 2 TO PL-SLOT-COUNT(WS-ROW, 10)
     MOVE 5 TO PL-SLOT-COUNT(WS-ROW, 1)
     MOVE WS-H TO PL-SLOT-VAR(WS-ROW, 10)
     MOVE 9 TO WS-SLOT
     MOVE 0 TO WS-BUTTON
     MOVE 1 TO WS-TYPE
     CALL "TEST-CLICK" USING WS-CONN WS-SLOT WS-BUTTON WS-TYPE
     MOVE PL-SLOT-COUNT(WS-ROW, 1) TO WS-EDIT
     MOVE PL-SLOT-VAR(WS-ROW, 1) TO WS-EDIT2
     MOVE PL-SLOT-COUNT(WS-ROW, 2) TO WS-EDIT3
     MOVE PL-SLOT-VAR(WS-ROW, 2) TO WS-EDIT4
     MOVE PL-SLOT-COUNT(WS-ROW, 10) TO WS-EDIT5
     MOVE SPACES TO TL-OBSERVED
     STRING "hotbar0 " FUNCTION TRIM(WS-EDIT) "/" FUNCTION TRIM(WS-EDIT2) " hotbar1 " FUNCTION TRIM(WS-EDIT3)
         "/" FUNCTION TRIM(WS-EDIT4) " source " FUNCTION TRIM(WS-EDIT5) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE WS-H TO WS-EDIT
     MOVE SPACES TO TL-EXPECTED
     STRING "hotbar0 5/0 hotbar1 2/" FUNCTION TRIM(WS-EDIT) " source 0" DELIMITED BY SIZE INTO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack menu a SWAP click with button 40 puts the patch in the off-hand slot" TO TL-CASE
     PERFORM EMPTY-ALL
     MOVE 1 TO PL-SLOT-ITEM(WS-ROW, 10)
     MOVE 1 TO PL-SLOT-COUNT(WS-ROW, 10)
     MOVE WS-H TO PL-SLOT-VAR(WS-ROW, 10)
     MOVE 9 TO WS-SLOT
     MOVE 40 TO WS-BUTTON
     MOVE 2 TO WS-TYPE
     CALL "TEST-CLICK" USING WS-CONN WS-SLOT WS-BUTTON WS-TYPE
     MOVE MN-EQUIP-VAR(WS-ROW, 5) TO WS-EDIT
     MOVE PL-SLOT-VAR(WS-ROW, 10) TO WS-EDIT2
     MOVE SPACES TO TL-OBSERVED
     STRING "off-hand " FUNCTION TRIM(WS-EDIT) " slot " FUNCTION TRIM(WS-EDIT2) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE WS-H TO WS-EDIT
     MOVE SPACES TO TL-EXPECTED
     STRING "off-hand " FUNCTION TRIM(WS-EDIT) " slot 0" DELIMITED BY SIZE INTO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack menu the off-hand swap of Player Action 7 exchanges the patches of the held and off-hand stacks"
         TO TL-CASE
     PERFORM EMPTY-ALL
     MOVE 0 TO PL-HELD(WS-ROW)
     MOVE 1 TO PL-SLOT-ITEM(WS-ROW, 1)
     MOVE 4 TO PL-SLOT-COUNT(WS-ROW, 1)
     MOVE WS-H TO PL-SLOT-VAR(WS-ROW, 1)
     CALL "MENU-OFFHAND-SWAP" USING WS-CONN
     MOVE MN-EQUIP-VAR(WS-ROW, 5) TO WS-EDIT
     MOVE PL-SLOT-VAR(WS-ROW, 1) TO WS-EDIT2
     MOVE MN-EQUIP-COUNT(WS-ROW, 5) TO WS-EDIT3
     MOVE SPACES TO TL-OBSERVED
     STRING "off-hand " FUNCTION TRIM(WS-EDIT) "x" FUNCTION TRIM(WS-EDIT3) " held " FUNCTION TRIM(WS-EDIT2)
         DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE WS-H TO WS-EDIT
     MOVE SPACES TO TL-EXPECTED
     STRING "off-hand " FUNCTION TRIM(WS-EDIT) "x4 held 0" DELIMITED BY SIZE INTO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack menu PICKUP_ALL (double click) collects only stacks whose patch equals the cursor's" TO TL-CASE
     PERFORM EMPTY-ALL
     MOVE 1 TO PL-CARRIED-ITEM(WS-ROW)
     MOVE 1 TO PL-CARRIED-COUNT(WS-ROW)
     MOVE 1 TO PL-SLOT-ITEM(WS-ROW, 11) PL-SLOT-ITEM(WS-ROW, 12)
     MOVE 3 TO PL-SLOT-COUNT(WS-ROW, 11)
     MOVE 4 TO PL-SLOT-COUNT(WS-ROW, 12)
     MOVE WS-H TO PL-SLOT-VAR(WS-ROW, 11)
     MOVE 20 TO WS-SLOT
     MOVE 0 TO WS-BUTTON
     MOVE 6 TO WS-TYPE
     CALL "TEST-CLICK" USING WS-CONN WS-SLOT WS-BUTTON WS-TYPE
     MOVE PL-CARRIED-COUNT(WS-ROW) TO WS-EDIT
     MOVE PL-SLOT-COUNT(WS-ROW, 11) TO WS-EDIT2
     MOVE PL-SLOT-COUNT(WS-ROW, 12) TO WS-EDIT3
     MOVE SPACES TO TL-OBSERVED
     STRING "cursor " FUNCTION TRIM(WS-EDIT) " named " FUNCTION TRIM(WS-EDIT2) " plain " FUNCTION TRIM(WS-EDIT3)
         DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "cursor 5 named 3 plain 0" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack menu a QUICK_CRAFT drag of named stones puts the patch on every slot of the drag" TO TL-CASE
     PERFORM EMPTY-ALL
     MOVE 1 TO PL-CARRIED-ITEM(WS-ROW)
     MOVE 4 TO PL-CARRIED-COUNT(WS-ROW)
     MOVE WS-H TO PL-CARRIED-VAR(WS-ROW)
     MOVE -999 TO WS-SLOT
     MOVE 0 TO WS-BUTTON
     MOVE 5 TO WS-TYPE
     CALL "TEST-CLICK" USING WS-CONN WS-SLOT WS-BUTTON WS-TYPE
     MOVE 9 TO WS-SLOT
     MOVE 1 TO WS-BUTTON
     CALL "TEST-CLICK" USING WS-CONN WS-SLOT WS-BUTTON WS-TYPE
     MOVE 10 TO WS-SLOT
     CALL "TEST-CLICK" USING WS-CONN WS-SLOT WS-BUTTON WS-TYPE
     MOVE -999 TO WS-SLOT
     MOVE 2 TO WS-BUTTON
     CALL "TEST-CLICK" USING WS-CONN WS-SLOT WS-BUTTON WS-TYPE
     PERFORM DESCRIBE
     MOVE WS-H TO WS-EDIT
     MOVE SPACES TO TL-EXPECTED
     STRING "cursor 0x0/0 s9 1x2/" FUNCTION TRIM(WS-EDIT) " s10 1x2/" FUNCTION TRIM(WS-EDIT)
         DELIMITED BY SIZE INTO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack menu closing the menu returns the carried named stone to the inventory with its patch" TO TL-CASE
     PERFORM EMPTY-ALL
     MOVE 1 TO PL-CARRIED-ITEM(WS-ROW)
     MOVE 2 TO PL-CARRIED-COUNT(WS-ROW)
     MOVE WS-H TO PL-CARRIED-VAR(WS-ROW)
     CALL "MENU-CLOSE" USING WS-CONN
     MOVE PL-SLOT-COUNT(WS-ROW, 1) TO WS-EDIT
     MOVE PL-SLOT-VAR(WS-ROW, 1) TO WS-EDIT2
     MOVE PL-CARRIED-VAR(WS-ROW) TO WS-EDIT3
     MOVE SPACES TO TL-OBSERVED
     STRING "hotbar0 " FUNCTION TRIM(WS-EDIT) "/" FUNCTION TRIM(WS-EDIT2) " cursor " FUNCTION TRIM(WS-EDIT3)
         DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE WS-H TO WS-EDIT
     MOVE SPACES TO TL-EXPECTED
     STRING "hotbar0 2/" FUNCTION TRIM(WS-EDIT) " cursor 0" DELIMITED BY SIZE INTO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack menu INV-ADD merges only onto plain stacks: a named stone stays apart" TO TL-CASE
     PERFORM EMPTY-ALL
     MOVE 1 TO PL-SLOT-ITEM(WS-ROW, 1)
     MOVE 5 TO PL-SLOT-COUNT(WS-ROW, 1)
     MOVE WS-H TO PL-SLOT-VAR(WS-ROW, 1)
     MOVE 3 TO WS-I
     CALL "INV-ADD" USING WS-ROW WS-STONE WS-I WS-STATE
     MOVE PL-SLOT-COUNT(WS-ROW, 1) TO WS-EDIT
     MOVE PL-SLOT-COUNT(WS-ROW, 2) TO WS-EDIT2
     MOVE PL-SLOT-VAR(WS-ROW, 2) TO WS-EDIT3
     MOVE SPACES TO TL-OBSERVED
     STRING "named " FUNCTION TRIM(WS-EDIT) " new " FUNCTION TRIM(WS-EDIT2) "/" FUNCTION TRIM(WS-EDIT3)
         DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "named 5 new 3/0" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack menu INV-MOVE moves and swaps the patch with the stack, a plain stack onto a named one swaps"
         TO TL-CASE
     PERFORM EMPTY-ALL
     PERFORM SET-STONES-2-H-3-PLAIN
     MOVE 9 TO WS-SLOT
     MOVE 9 TO WS-I
     MOVE 10 TO WS-STATE
     CALL "INV-MOVE" USING WS-ROW WS-I WS-STATE
     MOVE PL-SLOT-COUNT(WS-ROW, 10) TO WS-EDIT
     MOVE PL-SLOT-VAR(WS-ROW, 10) TO WS-EDIT2
     MOVE PL-SLOT-COUNT(WS-ROW, 11) TO WS-EDIT3
     MOVE PL-SLOT-VAR(WS-ROW, 11) TO WS-EDIT4
     MOVE SPACES TO TL-OBSERVED
     STRING "from " FUNCTION TRIM(WS-EDIT) "/" FUNCTION TRIM(WS-EDIT2) " to " FUNCTION TRIM(WS-EDIT3) "/"
         FUNCTION TRIM(WS-EDIT4) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE WS-H TO WS-EDIT
     MOVE SPACES TO TL-EXPECTED
     STRING "from 3/0 to 2/" FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack menu Place Recipe returns a named stack from the grid with its patch and does not take a "
         & "named stack from the inventory into the grid" TO TL-CASE
     PERFORM EMPTY-ALL
     MOVE 2 TO PL-SLOT-ITEM(WS-ROW, 1) PL-SLOT-ITEM(WS-ROW, 2)
     MOVE 64 TO PL-SLOT-COUNT(WS-ROW, 1)
     MOVE 4 TO PL-SLOT-COUNT(WS-ROW, 2)
     MOVE WS-H TO PL-SLOT-VAR(WS-ROW, 1)
     MOVE 2 TO MN-IGRID-ITEM(WS-ROW, 4)
     MOVE 1 TO MN-IGRID-COUNT(WS-ROW, 4)
     MOVE WS-H TO MN-IGRID-VAR(WS-ROW, 4)
     MOVE 0 TO PSB-CONTAINER PSB-RECIPE PSB-USE-MAX
     CALL "RECIPE-PLACE" USING WS-CONN PLAY-SERVERBOUND
     MOVE PL-SLOT-COUNT(WS-ROW, 1) TO WS-EDIT
     MOVE PL-SLOT-VAR(WS-ROW, 1) TO WS-EDIT2
     MOVE PL-SLOT-COUNT(WS-ROW, 2) TO WS-EDIT3
     MOVE PL-SLOT-COUNT(WS-ROW, 3) TO WS-EDIT4
     MOVE PL-SLOT-VAR(WS-ROW, 3) TO WS-EDIT5
     MOVE MN-IGRID-COUNT(WS-ROW, 4) TO WS-EDIT6
     MOVE MN-IGRID-VAR(WS-ROW, 4) TO WS-EDIT7
     MOVE SPACES TO TL-OBSERVED
     STRING "s0 " FUNCTION TRIM(WS-EDIT) "/" FUNCTION TRIM(WS-EDIT2) " s1 " FUNCTION TRIM(WS-EDIT3) " s2 "
         FUNCTION TRIM(WS-EDIT4) "/" FUNCTION TRIM(WS-EDIT5) " grid " FUNCTION TRIM(WS-EDIT6) "/" FUNCTION TRIM(WS-EDIT7)
         DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE WS-H TO WS-EDIT
     MOVE SPACES TO TL-EXPECTED
     STRING "s0 64/" FUNCTION TRIM(WS-EDIT) " s1 0 s2 1/" FUNCTION TRIM(WS-EDIT) " grid 1/0" DELIMITED BY SIZE INTO TL-EXPECTED
     PERFORM CHECK

     MOVE "test stack menu a creative player's Set Creative Mode Slot with a named stone puts the patch in the slot "
         & "(the same handle as the same patch from anywhere)" TO TL-CASE
     PERFORM EMPTY-ALL
     MOVE 1 TO PL-MODE(WS-ROW)
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     CALL "PB-PUT-VARINT" USING PB-BUFFER WS-PACKET-ID
     MOVE 36 TO WS-SLOT
     CALL "PB-PUT-SHORT" USING PB-BUFFER WS-SLOT
     MOVE 1 TO WS-I
     CALL "SP-EXPORT" USING WS-STONE WS-I WS-H PB-ITEMSTACK-X
     CALL "PB-PUT-ITEM-STACK" USING PB-BUFFER PB-ITEMSTACK-X
     CALL "TEST-FEED-BUFFER" USING WS-CONN PB-BUFFER
     CALL "PB-FREE" USING PB-BUFFER
     MOVE PL-SLOT-ITEM(WS-ROW, 1) TO WS-EDIT
     MOVE PL-SLOT-COUNT(WS-ROW, 1) TO WS-EDIT2
     MOVE PL-SLOT-VAR(WS-ROW, 1) TO WS-EDIT3
     MOVE SPACES TO TL-OBSERVED
     STRING "slot " FUNCTION TRIM(WS-EDIT) "x" FUNCTION TRIM(WS-EDIT2) "/" FUNCTION TRIM(WS-EDIT3)
         DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE WS-H TO WS-EDIT
     MOVE SPACES TO TL-EXPECTED
     STRING "slot 1x1/" FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-EXPECTED
     PERFORM CHECK
     GOBACK.

 EMPTY-ALL.
     MOVE 0 TO PL-MODE(WS-ROW)
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 36
         MOVE 0 TO PL-SLOT-ITEM(WS-ROW, WS-I) PL-SLOT-COUNT(WS-ROW, WS-I) PL-SLOT-VAR(WS-ROW, WS-I)
     END-PERFORM
     MOVE 0 TO PL-CARRIED-ITEM(WS-ROW) PL-CARRIED-COUNT(WS-ROW) PL-CARRIED-VAR(WS-ROW)
     MOVE 0 TO MN-EQUIP-ITEM(WS-ROW, 5) MN-EQUIP-COUNT(WS-ROW, 5) MN-EQUIP-VAR(WS-ROW, 5).

 SET-STONES-2-H-3-PLAIN.
     MOVE 1 TO PL-SLOT-ITEM(WS-ROW, 10) PL-SLOT-ITEM(WS-ROW, 11)
     MOVE 2 TO PL-SLOT-COUNT(WS-ROW, 10)
     MOVE 3 TO PL-SLOT-COUNT(WS-ROW, 11)
     MOVE WS-H TO PL-SLOT-VAR(WS-ROW, 10)
     MOVE 0 TO PL-SLOT-VAR(WS-ROW, 11).

 CLICK-PICKUP.
     MOVE 0 TO WS-BUTTON WS-TYPE
     CALL "TEST-CLICK" USING WS-CONN WS-SLOT WS-BUTTON WS-TYPE.

*> "cursor <item>x<count>/<var> s9 ... s10 ...": the cursor and the menu slots 9 and 10 (PL-SLOT 10 and 11), TL-OBSERVED.
 DESCRIBE.
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR
     MOVE PL-CARRIED-ITEM(WS-ROW) TO WS-EDIT
     MOVE PL-CARRIED-COUNT(WS-ROW) TO WS-EDIT2
     MOVE PL-CARRIED-VAR(WS-ROW) TO WS-EDIT3
     STRING "cursor " FUNCTION TRIM(WS-EDIT) "x" FUNCTION TRIM(WS-EDIT2) "/" FUNCTION TRIM(WS-EDIT3)
         DELIMITED BY SIZE INTO TL-OBSERVED POINTER WS-PTR
     MOVE PL-SLOT-ITEM(WS-ROW, 10) TO WS-EDIT
     MOVE PL-SLOT-COUNT(WS-ROW, 10) TO WS-EDIT2
     MOVE PL-SLOT-VAR(WS-ROW, 10) TO WS-EDIT3
     STRING " s9 " FUNCTION TRIM(WS-EDIT) "x" FUNCTION TRIM(WS-EDIT2) "/" FUNCTION TRIM(WS-EDIT3)
         DELIMITED BY SIZE INTO TL-OBSERVED POINTER WS-PTR
     MOVE PL-SLOT-ITEM(WS-ROW, 11) TO WS-EDIT
     MOVE PL-SLOT-COUNT(WS-ROW, 11) TO WS-EDIT2
     MOVE PL-SLOT-VAR(WS-ROW, 11) TO WS-EDIT3
     STRING " s10 " FUNCTION TRIM(WS-EDIT) "x" FUNCTION TRIM(WS-EDIT2) "/" FUNCTION TRIM(WS-EDIT3)
         DELIMITED BY SIZE INTO TL-OBSERVED POINTER WS-PTR.

 CHECK.
     MOVE "T" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-STACK-MENU.
 COPY CORETEST.
