 01 WS-CASE-TABLE REDEFINES WS-CASES.
    05 WS-ROW OCCURS 242 TIMES.
       10 WS-FN            BINARY-LONG.
       10 WS-X             BINARY-LONG.
       10 WS-Y             BINARY-LONG.
       10 WS-Z             BINARY-LONG.
       10 WS-BITS          BINARY-DOUBLE.
 01 WS-I                   BINARY-LONG.
 01 WS-R                   FLOAT-LONG.
 01 WS-GOT                 BINARY-DOUBLE.
 01 WS-BAD                 BINARY-LONG.
 01 WS-FN-BAD              BINARY-LONG.
 01 WS-LAST                BINARY-LONG VALUE 0.
 01 WS-EDIT                PIC -(9)9.
 01 WS-KEY                 PIC X(112).
 PROCEDURE DIVISION.
     MOVE "N" TO TL-MODE
     CALL "WORLDGEN-FREE"
     CALL "NOISES-LOAD" USING WS-DIR WS-STATUS
     MOVE "test density the fixture noise definitions load" TO TL-CASE
     MOVE WS-STATUS TO TL-OBSERVED-N
     MOVE 0 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "DENSITY-FUNCTIONS-LOAD" USING WS-DIR WS-STATUS
     MOVE "test density the fixture functions load" TO TL-CASE
     MOVE WS-STATUS TO TL-OBSERVED-N
     MOVE 0 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "DENSITY-SETUP" USING WS-SEED

     MOVE 0 TO WS-FN-BAD
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 242
         MOVE WS-NAME(WS-FN(WS-I)) TO WS-KEY
         CALL "DENSITY-EVAL" USING WS-KEY WS-X(WS-I) WS-Y(WS-I) WS-Z(WS-I) WS-R
         CALL STATIC "cc_f64_f64_bits" USING BY REFERENCE WS-R WS-GOT
         IF WS-GOT NOT = WS-BITS(WS-I)
             MOVE WS-I TO WS-EDIT
             MOVE "N" TO TL-MODE
             MOVE SPACES TO TL-CASE
             STRING "test density " FUNCTION TRIM(WS-KEY) " at row " FUNCTION TRIM(WS-EDIT) " is bit exact"
                 DELIMITED BY SIZE INTO TL-CASE
             MOVE WS-BITS(WS-I) TO TL-EXPECTED-N
             MOVE WS-GOT TO TL-OBSERVED-N
             CALL "TEST-ASSERT" USING TESTLIB-ASSERT
             ADD 1 TO WS-FN-BAD
         END-IF
     END-PERFORM
     MOVE "test density every function of the fixture is bit exact at all eleven positions" TO TL-CASE
     MOVE WS-FN-BAD TO TL-OBSERVED-N
     MOVE 0 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.
 END PROGRAM TEST-DENSITY.
