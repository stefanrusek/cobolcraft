*> Acceptance test of the command tree of docs/protocol/15-commands-framework.md §3 (the tree sent to
*> a player: §3.3 the filtered copy, §3.4 the breadth-first numbering and the flags; §15.3 the worked
*> example; §3.2 children in insertion order). The Commands packet written by BR-TREE-BUILD is read
*> back with PB-GET-COMMAND-NODE-X; each node reads idx:flags:name:children:redirect and, for an
*> argument, :p<parser>/<string kind>/<range flags>/<min>/<max>.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-CMD-15-3.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY BRIGADIER.
 COPY PROTO.
 01 WS-CAPACITY            BINARY-LONG VALUE 8192.
 01 WS-LEVEL               BINARY-LONG.
 01 WS-NODE                BINARY-LONG.
 01 WS-CHILD               BINARY-LONG.
 01 WS-CREATED             BINARY-LONG.
 01 WS-KIND                BINARY-LONG.
 01 WS-TYPE                BINARY-LONG.
 01 WS-NAME                PIC X(32).
 01 WS-NAME-LENGTH         BINARY-LONG.
 01 WS-A                   BINARY-LONG.
 01 WS-B                   BINARY-LONG.
 01 WS-C                   BINARY-LONG.
 01 WS-ID                  BINARY-LONG.
 01 WS-COUNT               BINARY-LONG.
 01 WS-ROOT                BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-K                   BINARY-LONG.
 01 WS-TEXT                PIC X(1024).
 01 WS-POS                 BINARY-LONG.
 01 WS-EDIT                PIC -(9)9.
 01 WS-C-TEXT              PIC X(12).
 01 WS-EDIT-LONG           PIC -(19)9.
 01 WS-EDIT-REAL           PIC -(8)9.99.
 PROCEDURE DIVISION.
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     PERFORM BUILD-TREE-153
     MOVE 2 TO WS-LEVEL
     MOVE "count=5 root=0 0:0:-:1,2:- 1:5:a:-:- 2:33:b:3,4:- 3:6:n:-:-:p3/0/3/1/10 4:9:c:-:0"
         TO TL-EXPECTED
     MOVE "acceptance US13 15§3 The command tree 15.3 example for a level 2 player (five nodes)"
         TO TL-CASE
     PERFORM CHECK
     MOVE 0 TO WS-LEVEL
     MOVE "count=2 root=0 0:0:-:1:- 1:5:a:-:-" TO TL-EXPECTED
     MOVE "acceptance US13 15§3 The command tree 15.3 example for a level 0 player (b filtered out)"
         TO TL-CASE
     PERFORM CHECK
     PERFORM BUILD-TREE-REDIRECTS
     MOVE 0 TO WS-LEVEL
     MOVE "count=6 root=0 0:0:-:1,2,3,4:- 1:5:x:-:- 2:5:y:-:- 3:13:z:-:2 4:1:w:5:- 5:22:s:-:-:p5/1/0/0/0"
         TO TL-EXPECTED
     MOVE "acceptance US13 15§3 The command tree a redirect to a node not copied yet is lost, to a copied "
         & "one kept; the suggestion flag" TO TL-CASE
     PERFORM CHECK
     PERFORM BUILD-TREE-NUMBERS
     MOVE 0 TO WS-LEVEL
     MOVE "count=9 root=0 0:0:-:1,2,3,4:- 1:5:lg:5:- 2:5:fl:6:- 3:5:db:7:- 4:5:ii:8:- "
         & "5:2:v:-:-:p4/0/1/0/0:L-5000000000/0 6:2:v:-:-:p1/0/3/0/0:F0.50/2.50 "
         & "7:2:v:-:-:p2/0/2/0/0:D0.00/7.25 8:2:v:-:-:p3/0/0/0/0"
         TO TL-EXPECTED
     MOVE "acceptance US13 15§3 The command tree argument properties of long, float, double and integer"
         TO TL-CASE
     PERFORM CHECK
     GOBACK.

 ADD-NODE.
     MOVE FUNCTION LENGTH(FUNCTION TRIM(WS-NAME)) TO WS-NAME-LENGTH
     CALL "BR-ADD-NODE" USING WS-NODE WS-KIND WS-NAME WS-NAME-LENGTH WS-TYPE WS-CHILD WS-CREATED.

 LITERAL-NODE.
     MOVE BR-LITERAL TO WS-KIND
     MOVE 0 TO WS-TYPE
     PERFORM ADD-NODE.

 BUILD-TREE-NUMBERS.
     CALL "BR-TREE-RESET"
     MOVE 1 TO WS-NODE
     MOVE "lg" TO WS-NAME
     PERFORM LITERAL-NODE
     MOVE 1 TO BR-N-COMMAND(WS-CHILD)
     MOVE WS-CHILD TO WS-NODE
     MOVE "v" TO WS-NAME
     MOVE BR-ARGUMENT TO WS-KIND
     MOVE BR-P-LONG TO WS-TYPE
     PERFORM ADD-NODE
     MOVE 1 TO BR-N-HAS-MIN(WS-CHILD)
     MOVE -5000000000 TO BR-N-IMIN(WS-CHILD)
     MOVE 1 TO WS-NODE
     MOVE "fl" TO WS-NAME
     PERFORM LITERAL-NODE
     MOVE 1 TO BR-N-COMMAND(WS-CHILD)
     MOVE WS-CHILD TO WS-NODE
     MOVE "v" TO WS-NAME
     MOVE BR-ARGUMENT TO WS-KIND
     MOVE BR-P-FLOAT TO WS-TYPE
     PERFORM ADD-NODE
     MOVE 1 TO BR-N-HAS-MIN(WS-CHILD) BR-N-HAS-MAX(WS-CHILD)
     MOVE 0.5 TO BR-N-DMIN(WS-CHILD)
     MOVE 2.5 TO BR-N-DMAX(WS-CHILD)
     MOVE 1 TO WS-NODE
     MOVE "db" TO WS-NAME
     PERFORM LITERAL-NODE
     MOVE 1 TO BR-N-COMMAND(WS-CHILD)
     MOVE WS-CHILD TO WS-NODE
     MOVE "v" TO WS-NAME
     MOVE BR-ARGUMENT TO WS-KIND
     MOVE BR-P-DOUBLE TO WS-TYPE
     PERFORM ADD-NODE
     MOVE 1 TO BR-N-HAS-MAX(WS-CHILD)
     MOVE 7.25 TO BR-N-DMAX(WS-CHILD)
     MOVE 1 TO WS-NODE
     MOVE "ii" TO WS-NAME
     PERFORM LITERAL-NODE
     MOVE 1 TO BR-N-COMMAND(WS-CHILD)
     MOVE WS-CHILD TO WS-NODE
     MOVE "v" TO WS-NAME
     MOVE BR-ARGUMENT TO WS-KIND
     MOVE BR-P-INTEGER TO WS-TYPE
     PERFORM ADD-NODE.

 BUILD-TREE-153.
     CALL "BR-TREE-RESET"
     MOVE 1 TO WS-NODE
     MOVE "a" TO WS-NAME
     PERFORM LITERAL-NODE
     MOVE 1 TO BR-N-COMMAND(WS-CHILD)
     MOVE "b" TO WS-NAME
     PERFORM LITERAL-NODE
     MOVE WS-CHILD TO WS-B
     MOVE 2 TO BR-N-LEVEL(WS-B)
     MOVE WS-B TO WS-NODE
     MOVE "n" TO WS-NAME
     MOVE BR-ARGUMENT TO WS-KIND
     MOVE BR-P-INTEGER TO WS-TYPE
     PERFORM ADD-NODE
     MOVE 2 TO BR-N-COMMAND(WS-CHILD)
     MOVE 1 TO BR-N-HAS-MIN(WS-CHILD) BR-N-HAS-MAX(WS-CHILD)
     MOVE 1 TO BR-N-IMIN(WS-CHILD)
     MOVE 10 TO BR-N-IMAX(WS-CHILD)
     MOVE "c" TO WS-NAME
     PERFORM LITERAL-NODE
     MOVE 1 TO BR-N-REDIRECT(WS-CHILD).

 BUILD-TREE-REDIRECTS.
     CALL "BR-TREE-RESET"
     MOVE 1 TO WS-NODE
     MOVE "x" TO WS-NAME
     PERFORM LITERAL-NODE
     MOVE WS-CHILD TO WS-A
     MOVE 1 TO BR-N-COMMAND(WS-A)
     MOVE "y" TO WS-NAME
     PERFORM LITERAL-NODE
     MOVE WS-CHILD TO WS-B
     MOVE 2 TO BR-N-COMMAND(WS-B)
     MOVE WS-B TO BR-N-REDIRECT(WS-A)
     MOVE "z" TO WS-NAME
     PERFORM LITERAL-NODE
     MOVE 3 TO BR-N-COMMAND(WS-CHILD)
     MOVE WS-B TO BR-N-REDIRECT(WS-CHILD)
     MOVE "w" TO WS-NAME
     PERFORM LITERAL-NODE
     MOVE WS-CHILD TO WS-NODE
     MOVE "s" TO WS-NAME
     MOVE BR-ARGUMENT TO WS-KIND
     MOVE BR-P-STRING TO WS-TYPE
     PERFORM ADD-NODE
     MOVE 4 TO BR-N-COMMAND(WS-CHILD)
     MOVE BR-S-PHRASE TO BR-N-STRING-KIND(WS-CHILD)
     MOVE 1 TO BR-N-SUGGEST(WS-CHILD).

 CHECK.
     CALL "PB-RESET" USING PB-BUFFER
     CALL "BR-TREE-BUILD" USING WS-LEVEL PB-BUFFER
     MOVE 0 TO PB-POS
     CALL "PB-GET-VARINT" USING PB-BUFFER WS-ID
     CALL "PB-GET-VARINT" USING PB-BUFFER WS-COUNT
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-POS
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-COUNT
         CALL "PB-GET-COMMAND-NODE-X" USING PB-BUFFER PB-COMMAND-NODE-X
         PERFORM DESCRIBE-NODE
     END-PERFORM
     CALL "PB-GET-VARINT" USING PB-BUFFER WS-ROOT
     MOVE WS-COUNT TO WS-EDIT
     MOVE SPACES TO TL-OBSERVED
     MOVE FUNCTION TRIM(WS-EDIT) TO WS-C-TEXT
     MOVE WS-ROOT TO WS-EDIT
     STRING "count=" FUNCTION TRIM(WS-C-TEXT) " root=" FUNCTION TRIM(WS-EDIT) WS-TEXT(1:WS-POS - 1)
         DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "T" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 DESCRIBE-NODE.
     MOVE WS-I TO WS-EDIT
     COMPUTE WS-A = WS-I - 1
     MOVE WS-A TO WS-EDIT
     STRING " " FUNCTION TRIM(WS-EDIT) ":" DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-POS
     MOVE PB-CX-FLAGS TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) ":" DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-POS
     IF PB-CX-NAME-LENGTH = 0
         STRING "-:" DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-POS
     ELSE
         STRING PB-CX-NAME(1:PB-CX-NAME-LENGTH) ":" DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-POS
     END-IF
     IF PB-CX-CHILD-COUNT = 0
         STRING "-:" DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-POS
     ELSE
         PERFORM VARYING WS-C FROM 1 BY 1 UNTIL WS-C > PB-CX-CHILD-COUNT
             MOVE PB-CX-CHILD(WS-C) TO WS-EDIT
             IF WS-C > 1
                 STRING "," DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-POS
             END-IF
             STRING FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-POS
         END-PERFORM
         STRING ":" DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-POS
     END-IF
     IF FUNCTION MOD(PB-CX-FLAGS / 8, 2) >= 1
         MOVE PB-CX-REDIRECT TO WS-EDIT
         STRING FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-POS
     ELSE
         STRING "-" DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-POS
     END-IF
     IF FUNCTION MOD(PB-CX-FLAGS, 4) = 2
         MOVE PB-CX-PARSER TO WS-EDIT
         STRING ":p" FUNCTION TRIM(WS-EDIT) "/" DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-POS
         MOVE PB-CX-STRING-KIND TO WS-EDIT
         STRING FUNCTION TRIM(WS-EDIT) "/" DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-POS
         MOVE PB-CX-RANGE-FLAGS TO WS-EDIT
         STRING FUNCTION TRIM(WS-EDIT) "/" DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-POS
         MOVE PB-CX-MIN-INT TO WS-EDIT
         STRING FUNCTION TRIM(WS-EDIT) "/" DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-POS
         MOVE PB-CX-MAX-INT TO WS-EDIT
         STRING FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-POS
         EVALUATE PB-CX-PARSER
             WHEN PB-PX-LONG
                 MOVE PB-CX-MIN-LONG TO WS-EDIT-LONG
                 STRING ":L" FUNCTION TRIM(WS-EDIT-LONG) "/" DELIMITED BY SIZE
                     INTO WS-TEXT WITH POINTER WS-POS
                 MOVE PB-CX-MAX-LONG TO WS-EDIT-LONG
                 STRING FUNCTION TRIM(WS-EDIT-LONG) DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-POS
             WHEN PB-PX-FLOAT
                 MOVE PB-CX-MIN-FLOAT TO WS-EDIT-REAL
                 STRING ":F" FUNCTION TRIM(WS-EDIT-REAL) "/" DELIMITED BY SIZE
                     INTO WS-TEXT WITH POINTER WS-POS
                 MOVE PB-CX-MAX-FLOAT TO WS-EDIT-REAL
                 STRING FUNCTION TRIM(WS-EDIT-REAL) DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-POS
             WHEN PB-PX-DOUBLE
                 MOVE PB-CX-MIN-DOUBLE TO WS-EDIT-REAL
                 STRING ":D" FUNCTION TRIM(WS-EDIT-REAL) "/" DELIMITED BY SIZE
                     INTO WS-TEXT WITH POINTER WS-POS
                 MOVE PB-CX-MAX-DOUBLE TO WS-EDIT-REAL
                 STRING FUNCTION TRIM(WS-EDIT-REAL) DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-POS
         END-EVALUATE
     END-IF.
 END PROGRAM TEST-CMD-15-3.
