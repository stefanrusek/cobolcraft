*> Test of combat 4.6 (17 section 4.6, 8): knockback. Strengths and velocities in thousandths.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-TOOL-COMBAT-4-6.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 01 WS-I1 BINARY-LONG.
 01 WS-I2 BINARY-LONG.
 01 WS-I3 BINARY-LONG.
 01 WS-I4 BINARY-LONG.
 01 WS-I5 BINARY-LONG.
 01 WS-I6 BINARY-LONG.
 01 WS-I7 BINARY-LONG.
 01 WS-I8 BINARY-LONG.
 01 WS-I9 BINARY-LONG.
 01 WS-I10 BINARY-LONG.
 01 WS-I11 BINARY-LONG.
 01 WS-I12 BINARY-LONG.
 01 WS-I13 BINARY-LONG.
 01 WS-I14 BINARY-LONG.
 01 WS-I15 BINARY-LONG.
 01 WS-I16 BINARY-LONG.
 01 WS-T1 PIC X(200).
 01 WS-T2 PIC X(200).
 01 WS-T3 PIC X(200).
 01 WS-O1 BINARY-LONG.
 01 WS-O2 BINARY-LONG.
 01 WS-O3 BINARY-LONG.
 01 WS-O4 BINARY-LONG.
 01 WS-O5 BINARY-LONG.
 01 WS-O6 BINARY-LONG.
 01 WS-O7 BINARY-LONG.
 01 WS-O8 BINARY-LONG.
 01 WS-O9 BINARY-LONG.
 01 WS-O10 BINARY-LONG.
 01 WS-O11 BINARY-LONG.
 01 WS-O12 BINARY-LONG.
 01 WS-X1 PIC X(48).
 01 WS-X2 PIC X(48).
 01 WS-X3 PIC X(48).
 01 WS-OBS PIC X(240).
 01 WS-E1 PIC -(9)9.
 01 WS-E2 PIC -(9)9.
 01 WS-E3 PIC -(9)9.
 01 WS-E4 PIC -(9)9.
 01 WS-E5 PIC -(9)9.
 01 WS-E6 PIC -(9)9.
 01 WS-E7 PIC -(9)9.
 01 WS-E8 PIC -(9)9.
 01 WS-E9 PIC -(9)9.
 01 WS-E10 PIC -(9)9.
 01 WS-E11 PIC -(9)9.
 01 WS-E12 PIC -(9)9.
 PROCEDURE DIVISION.
     MOVE "acceptance US14 knockback 0.4 from +x on the ground: velocity x -0.4, up min(0.4, m.y / 2 + 0.4) = 0.4" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE 400 TO WS-I1
     MOVE 0 TO WS-I2
     MOVE 1000 TO WS-I3
     MOVE 0 TO WS-I4
     MOVE 0 TO WS-I5
     MOVE 0 TO WS-I6
     MOVE 0 TO WS-I7
     MOVE 1 TO WS-I8
     CALL "TOOL-KNOCKBACK" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-I7 WS-I8 WS-O1 WS-O2 WS-O3 WS-O4
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     MOVE WS-O3 TO WS-E3
     MOVE WS-O4 TO WS-E4
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) "/" FUNCTION TRIM(WS-E3) "/" FUNCTION TRIM(WS-E4) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "-400/400/0/1" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 knockback in the air keeps the vertical velocity and halves the old horizontal one" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE 400 TO WS-I1
     MOVE 0 TO WS-I2
     MOVE 0 TO WS-I3
     MOVE 1000 TO WS-I4
     MOVE 1000 TO WS-I5
     MOVE 200 TO WS-I6
     MOVE 1000 TO WS-I7
     MOVE 0 TO WS-I8
     CALL "TOOL-KNOCKBACK" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-I7 WS-I8 WS-O1 WS-O2 WS-O3 WS-O4
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     MOVE WS-O3 TO WS-E3
     MOVE WS-O4 TO WS-E4
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) "/" FUNCTION TRIM(WS-E3) "/" FUNCTION TRIM(WS-E4) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "500/200/100/1" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 full knockback resistance stops it, half resistance halves the strength (0.2 along (0.6, 0.8))" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE 400 TO WS-I1
     MOVE 1000 TO WS-I2
     MOVE 1000 TO WS-I3
     MOVE 0 TO WS-I4
     MOVE 7 TO WS-I5
     MOVE 8 TO WS-I6
     MOVE 9 TO WS-I7
     MOVE 1 TO WS-I8
     CALL "TOOL-KNOCKBACK" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-I7 WS-I8 WS-O1 WS-O2 WS-O3 WS-O4
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     MOVE WS-O3 TO WS-E3
     MOVE WS-O4 TO WS-E4
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) "/" FUNCTION TRIM(WS-E3) "/" FUNCTION TRIM(WS-E4) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 400 TO WS-I1
     MOVE 500 TO WS-I2
     MOVE 3000 TO WS-I3
     MOVE 4000 TO WS-I4
     MOVE 0 TO WS-I5
     MOVE 0 TO WS-I6
     MOVE 0 TO WS-I7
     MOVE 0 TO WS-I8
     CALL "TOOL-KNOCKBACK" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-I7 WS-I8 WS-O1 WS-O2 WS-O3 WS-O4
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     MOVE WS-O3 TO WS-E3
     MOVE WS-O4 TO WS-E4
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) "/" FUNCTION TRIM(WS-E3) "/" FUNCTION TRIM(WS-E4) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "7/8/9/0 -120/0/-160/1" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 a vanishing direction (squared length under 1.0E-5) needs a random horizontal direction" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE 400 TO WS-I1
     MOVE 0 TO WS-I2
     MOVE 1 TO WS-I3
     MOVE 0 TO WS-I4
     MOVE 0 TO WS-I5
     MOVE 0 TO WS-I6
     MOVE 0 TO WS-I7
     MOVE 1 TO WS-I8
     CALL "TOOL-KNOCKBACK" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-I7 WS-I8 WS-O1 WS-O2 WS-O3 WS-O4
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     MOVE WS-O3 TO WS-E3
     MOVE WS-O4 TO WS-E4
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) "/" FUNCTION TRIM(WS-E3) "/" FUNCTION TRIM(WS-E4) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "0/0/0/2" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 attack knockback K = (attack_knockback + Knockback level) / 2 plus 0.5 when sprinting; arrow Punch pushes level x 0.6 x (1 - resistance)" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE 0 TO WS-I1
     MOVE 0 TO WS-I2
     MOVE 0 TO WS-I3
     CALL "TOOL-ATTACK-KNOCKBACK" USING WS-I1 WS-I2 WS-I3 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 0 TO WS-I1
     MOVE 2 TO WS-I2
     MOVE 0 TO WS-I3
     CALL "TOOL-ATTACK-KNOCKBACK" USING WS-I1 WS-I2 WS-I3 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 0 TO WS-I1
     MOVE 1 TO WS-I2
     MOVE 1 TO WS-I3
     CALL "TOOL-ATTACK-KNOCKBACK" USING WS-I1 WS-I2 WS-I3 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 2 TO WS-I1
     MOVE 0 TO WS-I2
     CALL "TOOL-ARROW-KNOCKBACK" USING WS-I1 WS-I2 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 2 TO WS-I1
     MOVE 500 TO WS-I2
     CALL "TOOL-ARROW-KNOCKBACK" USING WS-I1 WS-I2 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "0 1000 1000 1200 600" TO TL-EXPECTED
     PERFORM CHECK-DONE

     STOP RUN.

 ADD-OBS.
     IF TL-OBSERVED = SPACES
         MOVE FUNCTION TRIM(WS-OBS) TO TL-OBSERVED
     ELSE
         STRING FUNCTION TRIM(TL-OBSERVED) " " FUNCTION TRIM(WS-OBS) DELIMITED BY SIZE INTO TL-OBSERVED
     END-IF.

 CHECK-DONE.
     MOVE "T" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-TOOL-COMBAT-4-6.
