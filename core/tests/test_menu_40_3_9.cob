     MOVE "4 4 1 1 0 0 4 1 0 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-ANVIL-ENCH" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-I7 WS-I8 WS-I9 WS-I10 WS-R1 WS-R2 WS-R3 WS-R4 WS-R5
     MOVE 5 TO WS-N
     PERFORM ADD-N
     MOVE "1/0/3/6/0 1/0/3/6/0 1/0/4/4/0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 40-3§9 Differences from earlier prose: 9.6: the smithing error flag is 1 exactly with all three inputs and an empty result; on a client it is only changed by packets (server, has" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1 1 1 1 0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-SMITH-FLAG" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 1 1 1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-SMITH-FLAG" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 1 1 1 0 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-SMITH-FLAG" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 0 0 0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-SMITH-FLAG" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 1 0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 BEGIN-CASE.
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR
     .

 LOAD-IN.
     MOVE 1 TO WS-P
     PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 16
         MOVE SPACES TO WS-TOK
         IF WS-P <= 160
             UNSTRING WS-IN DELIMITED BY ALL SPACE INTO WS-TOK WITH POINTER WS-P
         END-IF
         COMPUTE WS-FX(WS-K) = FUNCTION NUMVAL(WS-TOK)
         COMPUTE WS-I(WS-K) = FUNCTION NUMVAL(WS-TOK)
     END-PERFORM
     .

 ADD-N.
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N
         MOVE WS-R(WS-J) TO WS-SHOW
         IF WS-J > 1
             STRING "/" DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
         END-IF
         STRING FUNCTION TRIM(WS-SHOW) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-PERFORM
     STRING " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .

 ADD-TEXT.
     STRING FUNCTION TRIM(WS-T1) "|" FUNCTION TRIM(WS-T2) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .
 END PROGRAM TEST-MENU-40-3-9.
