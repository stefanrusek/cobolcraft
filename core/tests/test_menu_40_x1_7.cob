     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 40-x1§7 TestBlockEditScreen: 7 worked example: Shift-click from START goes backwards" &
         " to ACCEPT (index 3); a click from START goes to LOG; Alt has no effect (size, index, delta ->" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     MOVE 4 TO WS-I1
     MOVE 0 TO WS-I2
     MOVE -1 TO WS-I3
     CALL "MNX-CYCLE" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE WS-R1 TO WS-SHOW
     STRING FUNCTION TRIM(WS-SHOW) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     MOVE 4 TO WS-I1
     MOVE 0 TO WS-I2
     MOVE 1 TO WS-I3
     CALL "MNX-CYCLE" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE WS-R1 TO WS-SHOW
     STRING FUNCTION TRIM(WS-SHOW) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     MOVE 4 TO WS-I1
     MOVE 3 TO WS-I2
     MOVE 1 TO WS-I3
     CALL "MNX-CYCLE" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE WS-R1 TO WS-SHOW
     STRING FUNCTION TRIM(WS-SHOW) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     MOVE 4 TO WS-I1
     MOVE 1 TO WS-I2
     MOVE 1 TO WS-I3
     CALL "MNX-CYCLE" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE WS-R1 TO WS-SHOW
     STRING FUNCTION TRIM(WS-SHOW) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE "3 1 0 2" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 40-x1§7 TestBlockEditScreen: 7 worked example: LOG with hello sends mode 1 and hello" &
         "; back to START the hidden box still sends mode 0 with hello" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     MOVE 1 TO WS-I1
     MOVE 2 TO WS-I2
     MOVE 3 TO WS-I3
     MOVE 1 TO WS-I4
     MOVE SPACES TO WS-TA
     MOVE "hello" TO WS-TA(1:5)
     MOVE 5 TO WS-I5
     CALL "MN9-BODY3D" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-TA WS-I5 WS-TH WS-R1
     MOVE WS-TH TO WS-TA
     COMPUTE WS-TL = WS-R1 * 2
     PERFORM SHOW-TA
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     MOVE 1 TO WS-I1
     MOVE 2 TO WS-I2
     MOVE 3 TO WS-I3
     MOVE 0 TO WS-I4
     MOVE SPACES TO WS-TA
     MOVE "hello" TO WS-TA(1:5)
     MOVE 5 TO WS-I5
     CALL "MN9-BODY3D" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-TA WS-I5 WS-TH WS-R1
     MOVE WS-TH TO WS-TA
     COMPUTE WS-TL = WS-R1 * 2
     PERFORM SHOW-TA
     MOVE "0000004000003002010568656c6c6f 0000004000003002000568656c6c6f" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 40-x1§7 TestBlockEditScreen: 7: the message box is visible only when the mode is not" &
         " START (mode -> visible)" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     MOVE 0 TO WS-I1
     CALL "MN9-TBVIS" USING WS-I1 WS-R1
     MOVE WS-R1 TO WS-SHOW
     STRING FUNCTION TRIM(WS-SHOW) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     MOVE 1 TO WS-I1
     CALL "MN9-TBVIS" USING WS-I1 WS-R1
     MOVE WS-R1 TO WS-SHOW
     STRING FUNCTION TRIM(WS-SHOW) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     MOVE 2 TO WS-I1
     CALL "MN9-TBVIS" USING WS-I1 WS-R1
     MOVE WS-R1 TO WS-SHOW
     STRING FUNCTION TRIM(WS-SHOW) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     MOVE 3 TO WS-I1
     CALL "MN9-TBVIS" USING WS-I1 WS-R1
     MOVE WS-R1 TO WS-SHOW
     STRING FUNCTION TRIM(WS-SHOW) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE "0 1 1 1" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 40-x1§7 TestBlockEditScreen: 7: Enter does nothing on the test block screen (screen " &
         "5, done active 1 -> onDone runs)" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     MOVE 5 TO WS-I1
     MOVE 1 TO WS-I2
     CALL "MN9-ENTER" USING WS-I1 WS-I2 WS-R1
     MOVE WS-R1 TO WS-SHOW
     STRING FUNCTION TRIM(WS-SHOW) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     MOVE 5 TO WS-I1
     MOVE 0 TO WS-I2
     CALL "MN9-ENTER" USING WS-I1 WS-I2 WS-R1
     MOVE WS-R1 TO WS-SHOW
     STRING FUNCTION TRIM(WS-SHOW) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     MOVE "0 0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 BEGIN-CASE.
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR
     .

 LOAD-IN.
     MOVE 1 TO WS-P
     PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 16
         MOVE SPACES TO WS-TOK
         IF WS-P <= 160
             UNSTRING WS-IN DELIMITED BY ALL SPACE INTO WS-TOK WITH POINTER WS-P
         END-IF
         COMPUTE WS-FX(WS-K) = FUNCTION NUMVAL(WS-TOK)
         COMPUTE WS-I(WS-K) = FUNCTION NUMVAL(WS-TOK)
     END-PERFORM
     .

 ADD-N.
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N
         MOVE WS-R(WS-J) TO WS-SHOW
         IF WS-J > 1
             STRING "/" DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
         END-IF
         STRING FUNCTION TRIM(WS-SHOW) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-PERFORM
     STRING " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .

 ADD-TEXT.
     STRING FUNCTION TRIM(WS-T1) "|" FUNCTION TRIM(WS-T2) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .
 SHOW-TA.
     MOVE WS-TA TO WS-TV
     IF WS-TL > 0
         INSPECT WS-TV(1:WS-TL) REPLACING ALL " " BY "_"
         INSPECT WS-TV(1:WS-TL) REPLACING ALL X"0A" BY "~"
         INSPECT WS-TV(1:WS-TL) REPLACING ALL X"09" BY "^"
         STRING WS-TV(1:WS-TL) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     ELSE
         STRING "<> " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-IF
     .

  END PROGRAM TEST-MENU-40-X1-7.
