 01 WS-E11 PIC -(9)9.
 01 WS-E12 PIC -(9)9.
 01 WS-A BINARY-LONG.
 01 WS-B BINARY-LONG.
 01 WS-C BINARY-LONG.
 01 WS-D BINARY-LONG.
 01 WS-F BINARY-LONG.
 01 WS-G BINARY-LONG.
 01 WS-H BINARY-LONG.
 01 WS-J BINARY-LONG.
 01 WS-K BINARY-LONG.
 01 WS-K32 PIC X(32).
 01 WS-KEY2 PIC X(32).
 01 WS-L BINARY-LONG.
 01 WS-PTR BINARY-LONG.
 PROCEDURE DIVISION.
     MOVE "acceptance US12 40-1§7 chest: R = 6 slot 0 is container 0 at (8, 18); slot 53 is container 53 at (152, 108) (part 1 = container, 2 = player)" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     MOVE 1 TO WS-A
     MOVE 6 TO WS-B
     MOVE 0 TO WS-C
     CALL "MENU-LAYOUT" USING WS-A WS-B WS-C WS-D WS-F WS-G WS-H
     MOVE WS-D TO WS-E1
     MOVE WS-F TO WS-E2
     MOVE WS-G TO WS-E3
     MOVE WS-H TO WS-E4
     STRING FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) " " FUNCTION TRIM(WS-E3) " " FUNCTION TRIM(WS-E4) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 1 TO WS-A
     MOVE 6 TO WS-B
     MOVE 53 TO WS-C
     CALL "MENU-LAYOUT" USING WS-A WS-B WS-C WS-D WS-F WS-G WS-H
     MOVE WS-D TO WS-E1
     MOVE WS-F TO WS-E2
     MOVE WS-G TO WS-E3
     MOVE WS-H TO WS-E4
     STRING FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) " " FUNCTION TRIM(WS-E3) " " FUNCTION TRIM(WS-E4) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE '1 0 8 18 | 1 53 152 108 |' TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 40-1§7 chest: R = 6 slots 54, 81, 89 are player 9 (8, 139), player 0 (8, 197), player 8 (152, 197); slot 90 does not exist (part 0)" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     MOVE 1 TO WS-A
     MOVE 6 TO WS-B
     MOVE 54 TO WS-C
     CALL "MENU-LAYOUT" USING WS-A WS-B WS-C WS-D WS-F WS-G WS-H
     MOVE WS-D TO WS-E1
     MOVE WS-F TO WS-E2
     MOVE WS-G TO WS-E3
     MOVE WS-H TO WS-E4
     STRING FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) " " FUNCTION TRIM(WS-E3) " " FUNCTION TRIM(WS-E4) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 1 TO WS-A
     MOVE 6 TO WS-B
     MOVE 81 TO WS-C
     CALL "MENU-LAYOUT" USING WS-A WS-B WS-C WS-D WS-F WS-G WS-H
     MOVE WS-D TO WS-E1
     MOVE WS-F TO WS-E2
     MOVE WS-G TO WS-E3
     MOVE WS-H TO WS-E4
     STRING FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) " " FUNCTION TRIM(WS-E3) " " FUNCTION TRIM(WS-E4) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 1 TO WS-A
     MOVE 6 TO WS-B
     MOVE 89 TO WS-C
     CALL "MENU-LAYOUT" USING WS-A WS-B WS-C WS-D WS-F WS-G WS-H
     MOVE WS-D TO WS-E1
     MOVE WS-F TO WS-E2
     MOVE WS-G TO WS-E3
     MOVE WS-H TO WS-E4
     STRING FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) " " FUNCTION TRIM(WS-E3) " " FUNCTION TRIM(WS-E4) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 1 TO WS-A
     MOVE 6 TO WS-B
     MOVE 90 TO WS-C
     CALL "MENU-LAYOUT" USING WS-A WS-B WS-C WS-D WS-F WS-G WS-H
     MOVE WS-D TO WS-E1
     MOVE WS-F TO WS-E2
     MOVE WS-G TO WS-E3
     MOVE WS-H TO WS-E4
     STRING FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) " " FUNCTION TRIM(WS-E3) " " FUNCTION TRIM(WS-E4) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE '2 9 8 139 | 2 0 8 197 | 2 8 152 197 | 0 0 0 0 |' TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 40-1§7 chest: image 114 + 18 R, label y imageHeight - 94 (R 1: 132 / 38, R 3: 168 / 74, R 6: 222 / 128), width 176" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     MOVE 1 TO WS-A
     MOVE 1 TO WS-B
     CALL "MENU-IMAGE" USING WS-A WS-B WS-D WS-F WS-G
     MOVE WS-D TO WS-E1
     MOVE WS-F TO WS-E2
     MOVE WS-G TO WS-E3
     STRING FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) " " FUNCTION TRIM(WS-E3) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 1 TO WS-A
     MOVE 3 TO WS-B
     CALL "MENU-IMAGE" USING WS-A WS-B WS-D WS-F WS-G
     MOVE WS-D TO WS-E1
     MOVE WS-F TO WS-E2
     MOVE WS-G TO WS-E3
     STRING FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) " " FUNCTION TRIM(WS-E3) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 1 TO WS-A
     MOVE 6 TO WS-B
     CALL "MENU-IMAGE" USING WS-A WS-B WS-D WS-F WS-G
     MOVE WS-D TO WS-E1
     MOVE WS-F TO WS-E2
     MOVE WS-G TO WS-E3
     STRING FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) " " FUNCTION TRIM(WS-E3) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE '176 132 38 | 176 168 74 | 176 222 128 |' TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 40-1§7 chest: Y0 = 31 + 18 R: the first main inventory slot of R = 1, 2, 4 is at y 49, 67, 103" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     MOVE 1 TO WS-A
     MOVE 1 TO WS-B
     MOVE 9 TO WS-C
     CALL "MENU-LAYOUT" USING WS-A WS-B WS-C WS-D WS-F WS-G WS-H
     MOVE WS-D TO WS-E1
     MOVE WS-F TO WS-E2
     MOVE WS-G TO WS-E3
     MOVE WS-H TO WS-E4
     STRING FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) " " FUNCTION TRIM(WS-E3) " " FUNCTION TRIM(WS-E4) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 1 TO WS-A
     MOVE 2 TO WS-B
     MOVE 18 TO WS-C
     CALL "MENU-LAYOUT" USING WS-A WS-B WS-C WS-D WS-F WS-G WS-H
     MOVE WS-D TO WS-E1
     MOVE WS-F TO WS-E2
     MOVE WS-G TO WS-E3
     MOVE WS-H TO WS-E4
     STRING FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) " " FUNCTION TRIM(WS-E3) " " FUNCTION TRIM(WS-E4) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 1 TO WS-A
     MOVE 4 TO WS-B
     MOVE 36 TO WS-C
     CALL "MENU-LAYOUT" USING WS-A WS-B WS-C WS-D WS-F WS-G WS-H
     MOVE WS-D TO WS-E1
     MOVE WS-F TO WS-E2
     MOVE WS-G TO WS-E3
     MOVE WS-H TO WS-E4
     STRING FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) " " FUNCTION TRIM(WS-E3) " " FUNCTION TRIM(WS-E4) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE '2 9 8 49 | 2 9 8 67 | 2 9 8 103 |' TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 40-1§7 chest: quick-move R = 1: slot 3 goes to [9, 45) reversed, slot 20 to [0, 9) forward; no progress test (last value 0 = none)" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     MOVE 1 TO WS-A
     MOVE 1 TO WS-B
     MOVE 3 TO WS-C
     CALL "MENU-QUICK-RANGE" USING WS-A WS-B WS-C WS-D WS-F WS-G WS-H
     MOVE WS-D TO WS-E1
     MOVE WS-F TO WS-E2
     MOVE WS-G TO WS-E3
     MOVE WS-H TO WS-E4
     STRING FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) " " FUNCTION TRIM(WS-E3) " " FUNCTION TRIM(WS-E4) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 1 TO WS-A
     MOVE 1 TO WS-B
     MOVE 20 TO WS-C
     CALL "MENU-QUICK-RANGE" USING WS-A WS-B WS-C WS-D WS-F WS-G WS-H
     MOVE WS-D TO WS-E1
     MOVE WS-F TO WS-E2
     MOVE WS-G TO WS-E3
     MOVE WS-H TO WS-E4
     STRING FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) " " FUNCTION TRIM(WS-E3) " " FUNCTION TRIM(WS-E4) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE '9 45 1 0 | 0 9 0 0 |' TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 40-1§7 chest: every item may be placed in every slot of a chest menu" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     MOVE 1 TO WS-A
     MOVE 5 TO WS-B
     MOVE 1 TO WS-C
     CALL "MENU-MAY-PLACE-K" USING WS-A WS-B WS-C WS-D
     MOVE WS-D TO WS-E1
     STRING FUNCTION TRIM(WS-E1) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 1 TO WS-A
     MOVE 50 TO WS-B
     MOVE 0 TO WS-C
     CALL "MENU-MAY-PLACE-K" USING WS-A WS-B WS-C WS-D
     MOVE WS-D TO WS-E1
     STRING FUNCTION TRIM(WS-E1) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE '1 | 1 |' TO TL-EXPECTED
     PERFORM CHECK

     GOBACK.

 CHECK.
     MOVE "T" TO TL-MODE
     MOVE WS-TEXT TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-MENU-40-1-7.

 COPY CORETEST.
