     MOVE SPACES TO WS-TB
     CALL "MN8-CLIPGET" USING WS-TA WS-TL WS-TB WS-R1
     MOVE WS-R1 TO WS-R2
     MOVE 2 TO WS-N
     MOVE WS-TL TO WS-R1
     PERFORM ADD-N
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     MOVE SPACES TO WS-TA
     MOVE 0 TO WS-TL
     MOVE SPACES TO WS-TB
     CALL "MN8-CLIPGET" USING WS-TA WS-TL WS-TB WS-R1
     MOVE WS-R1 TO WS-R2
     MOVE 2 TO WS-N
     MOVE WS-TL TO WS-R1
     PERFORM ADD-N
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     MOVE SPACES TO WS-TA
     MOVE FUNCTION CHAR(168) TO WS-TA(1:1)
     MOVE FUNCTION CHAR(168) TO WS-TA(2:1)
     MOVE "a" TO WS-TA(3:1)
     MOVE 3 TO WS-TL
     MOVE SPACES TO WS-TB
     CALL "MN8-CLIPGET" USING WS-TA WS-TL WS-TB WS-R1
     MOVE WS-R1 TO WS-R2
     MOVE 2 TO WS-N
     MOVE WS-TL TO WS-R1
     PERFORM ADD-N
     MOVE "6/4 7/5 3/1 3/3 1/1 11/3 8/8 3/1 0/0 3/1 " TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 BEGIN-CASE.
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR
     .

 LOAD-IN.
     MOVE 1 TO WS-P
     PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 16
         MOVE SPACES TO WS-TOK
         IF WS-P <= 160
             UNSTRING WS-IN DELIMITED BY ALL SPACE INTO WS-TOK WITH POINTER WS-P
         END-IF
         COMPUTE WS-FX(WS-K) = FUNCTION NUMVAL(WS-TOK)
         COMPUTE WS-I(WS-K) = FUNCTION NUMVAL(WS-TOK)
     END-PERFORM
     .

 ADD-N.
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N
         MOVE WS-R(WS-J) TO WS-SHOW
         IF WS-J > 1
             STRING "/" DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
         END-IF
         STRING FUNCTION TRIM(WS-SHOW) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-PERFORM
     STRING " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .

 ADD-TEXT.
     STRING FUNCTION TRIM(WS-T1) "|" FUNCTION TRIM(WS-T2) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .
 SHOW-TA.
     MOVE WS-TA TO WS-TV
     IF WS-TL > 0
         INSPECT WS-TV(1:WS-TL) REPLACING ALL " " BY "_"
         INSPECT WS-TV(1:WS-TL) REPLACING ALL X"0A" BY "~"
         INSPECT WS-TV(1:WS-TL) REPLACING ALL X"09" BY "^"
         STRING WS-TV(1:WS-TL) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     ELSE
         STRING "<> " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-IF
     .

  SHOW-FLD.
     MOVE SPACES TO WS-TA
     MOVE MN8-FTEXT TO WS-TA(1:256)
     MOVE MN8-FLEN TO WS-TL
     PERFORM SHOW-TA
     .

 SHOW-FCLIP.
     MOVE SPACES TO WS-TA
     MOVE MN8-FCLIP TO WS-TA(1:256)
     MOVE MN8-FCLIPLEN TO WS-TL
     PERFORM SHOW-TA
     .

 END PROGRAM TEST-MENU-40-8-5.
