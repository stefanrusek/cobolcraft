*> Acceptance test (lane fixa, A4; 33 sections 5.1 and 5.2): a right-click on a bed sets the respawn point of the player (also by day, when it cannot
*> sleep), and a respawn after death goes to the bed while it is still there, else to the world spawn.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. ACC-BED-SPAWN.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY COREAPI.
 COPY CONTENT.
 COPY CITEMS.
 COPY BRWORLD.
 01 WS-NAME                PIC X(16) VALUE "Stefan".
 01 WS-NAME-LENGTH         BINARY-LONG VALUE 6.
 01 WS-CONN                BINARY-LONG.
 01 WS-PLAYER              BINARY-LONG.
 01 WS-DIM                 BINARY-LONG.
 01 WS-KEY                 PIC X(112).
 01 WS-BLOCK-ROW           PIC X(819).
 01 WS-BLOCK               BINARY-LONG.
 01 WS-STATUS              BINARY-LONG.
 01 WS-STATE-TEXT          PIC X(5).
 01 WS-BED                 BINARY-LONG.
 01 WS-AIR                 BINARY-LONG VALUE 0.
 01 WS-BX                  BINARY-LONG.
 01 WS-BY                  BINARY-LONG.
 01 WS-BZ                  BINARY-LONG.
 01 WS-FACE                BINARY-LONG VALUE 1.
 01 WS-SEQ                 BINARY-LONG VALUE 1.
 01 WS-ACTION              BINARY-LONG VALUE 0.
 01 WS-EXPECT              FLOAT-LONG.
 01 WS-OBSERVE             FLOAT-LONG.
 PROCEDURE DIVISION.
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     MOVE 2 TO CS-VIEW-DISTANCE
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     CALL "TEST-STANDARD-TABLES"
     CALL "BR-WORLD-READY"
     CALL "TEST-JOIN" USING WS-NAME WS-NAME-LENGTH WS-CONN
     MOVE CN-PLAYER(WS-CONN) TO WS-PLAYER
     MOVE 0 TO PL-MODE(WS-PLAYER)
     MOVE PL-DIM(WS-PLAYER) TO WS-DIM
     MOVE SPACES TO WS-KEY
     MOVE "minecraft:red_bed" TO WS-KEY
     CALL "CONTENT-BLOCK-BY-KEY" USING WS-KEY WS-BLOCK WS-BLOCK-ROW WS-STATUS
     MOVE WS-BLOCK-ROW(1 + 4 + 35 + 32 + 288 + 4 + 5:5) TO WS-STATE-TEXT
     COMPUTE WS-BED = FUNCTION NUMVAL(WS-STATE-TEXT)
     COMPUTE WS-BX = FUNCTION INTEGER(PL-X(WS-PLAYER)) + 1
     COMPUTE WS-BY = FUNCTION INTEGER(PL-Y(WS-PLAYER))
     COMPUTE WS-BZ = FUNCTION INTEGER(PL-Z(WS-PLAYER))
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-BX WS-BY WS-BZ WS-BED
     MOVE 6000 TO CW-TIME
     MOVE "N" TO TL-MODE
     MOVE 0 TO PL-HELD(WS-PLAYER)
     CALL "TEST-USE-ON" USING WS-CONN WS-BX WS-BY WS-BZ WS-FACE WS-SEQ
     MOVE "acceptance bed: a click on a bed by day sets the respawn point" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE BW-SPAWN-SET(WS-PLAYER) TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     COMPUTE WS-EXPECT = WS-BX + 0.5
     MOVE BW-SPAWN-X(WS-PLAYER) TO WS-OBSERVE
     MOVE "acceptance bed: the respawn point is the bed" TO TL-CASE
     MOVE WS-BX TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER(WS-OBSERVE)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   Dead, respawn: at the bed.
     MOVE PS-DEAD TO PL-STATE(WS-PLAYER)
     CALL "TEST-CLIENT-COMMAND" USING WS-CONN WS-ACTION
     MOVE "acceptance bed: the respawn after death is at the bed" TO TL-CASE
     MOVE WS-BX TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER(PL-X(WS-PLAYER))
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   The bed is gone: the world spawn.
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-BX WS-BY WS-BZ WS-AIR
     MOVE PS-DEAD TO PL-STATE(WS-PLAYER)
     CALL "TEST-CLIENT-COMMAND" USING WS-CONN WS-ACTION
     MOVE "acceptance bed: without the bed the respawn is at the world spawn" TO TL-CASE
     COMPUTE TL-EXPECTED-N = FUNCTION INTEGER(CW-SPAWN-X)
     COMPUTE TL-OBSERVED-N = FUNCTION INTEGER(PL-X(WS-PLAYER))
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.
 END PROGRAM ACC-BED-SPAWN.
 COPY CORETEST.
