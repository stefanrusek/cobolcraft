 01 WS-IN                  PIC X(160).
 01 WS-TOK                 PIC X(24).
 01 WS-P                   BINARY-LONG.
 01 WS-K                   BINARY-LONG.
 01 WS-N                   BINARY-LONG.
 01 WS-J                   BINARY-LONG.
 01 WS-PTR                 BINARY-LONG.
 01 WS-SHOW                PIC -(9)9.
 01 WS-TEXTS.
    05 WS-T1               PIC X(96).
    05 WS-T2               PIC X(96).
 PROCEDURE DIVISION.
     MOVE "T" TO TL-MODE
     MOVE "acceptance US12 30-1§3 Tick conventions: redstone tick (3): one redstone tick is 2 game ticks; the torch delay 2 and the repeater minimum are both one" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-GAME-TICKS" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-GAME-TICKS" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "2" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-GAME-TICKS" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "4" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-GAME-TICKS" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 2 4 8" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 30-1§3 Tick conventions: due time (3): a tick scheduled at T with delay d runs in the drain of game tick T + d" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "100 2" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-DUE-TICK" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "100 160" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-DUE-TICK" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "5 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-DUE-TICK" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-DUE-TICK" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "102 260 5 1" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 30-1§3 Tick conventions: identity (3): a pending tick for the same block at the same position is not added again (1 added, 0 ignored)" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-SCHEDULE-NEW" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-SCHEDULE-NEW" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 30-1§3 Tick conventions: priorities (3): EXTREMELY_HIGH -3, VERY_HIGH -2, HIGH -1, NORMAL 0, LOW 1, VERY_LOW 2, EXTREMELY_LOW 3; the blocks of part 1 use NORMAL" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-PRIORITY-VALUE" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "2" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-PRIORITY-VALUE" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "3" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-PRIORITY-VALUE" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "4" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-PRIORITY-VALUE" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "5" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-PRIORITY-VALUE" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "6" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-PRIORITY-VALUE" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "7" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-PRIORITY-VALUE" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "-3 -2 -1 0 1 2 3" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 30-1§3 Tick conventions: order within one game tick (3): lower priority first, then the sub-tick order (the order scheduled); 1 when the first runs first" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0 5 0 6" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-TICK-BEFORE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 6 0 5" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-TICK-BEFORE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "-3 9 0 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-TICK-BEFORE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 1 -1 9" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-TICK-BEFORE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "2 3 2 3" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-TICK-BEFORE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 1 0 0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 30-1§3 Tick conventions: torch queue guard (3, 8.3): the torch queues at most one tick, tested with willTickThisTick (1 queue, 0 not)" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-SCHEDULE-NEW" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-SCHEDULE-NEW" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 1" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 BEGIN-CASE.
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR
     .

 LOAD-IN.
     MOVE 1 TO WS-P
     PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 16
         MOVE SPACES TO WS-TOK
         IF WS-P <= 160
             UNSTRING WS-IN DELIMITED BY ALL SPACE INTO WS-TOK WITH POINTER WS-P
         END-IF
         COMPUTE WS-FX(WS-K) = FUNCTION NUMVAL(WS-TOK)
         COMPUTE WS-I(WS-K) = FUNCTION NUMVAL(WS-TOK)
     END-PERFORM
     .

 ADD-N.
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N
         MOVE WS-R(WS-J) TO WS-SHOW
         IF WS-J > 1
             STRING "/" DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
         END-IF
         STRING FUNCTION TRIM(WS-SHOW) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-PERFORM
     STRING " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .

 ADD-TEXT.
     STRING FUNCTION TRIM(WS-T1) "|" FUNCTION TRIM(WS-T2) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .
 END PROGRAM TEST-REDSTONE-30-1-3.
