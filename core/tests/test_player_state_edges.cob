*> Implementation test of the readers of the stored player state on files other writers could produce (core/src/
*> player-nbt.cob, player-state.cob; docs/protocol/45-entity-nbt-3-player-and-player-data.md section 3.5, 4.1): a slot outside
*> 0 to 35, with count 0 or with an unknown item is dropped; unknown keys are skipped at every level; a component patch with
*> an added and a removed component survives a read, a write and a read; an equipment entry of count 0 or of another
*> tag type is dropped; a recipeBook without both lists is ignored, an unknown recipe key is dropped; a full patch pool
*> keeps no copy.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-PLAYER-STATE-EDGES.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY COREAPI.
 COPY KNSTATE.
 COPY CTRECIPE.
 COPY PROTO.
 01 WN                     PIC X(32).
 01 WL                     BINARY-LONG.
 01 WS-ELEMENT             BINARY-LONG VALUE -1.
 01 WS-ONE                 BINARY-LONG VALUE 1.
 01 WS-TWO                 BINARY-LONG VALUE 2.
 01 WS-THREE               BINARY-LONG VALUE 3.
 01 WS-FIVE                BINARY-LONG VALUE 5.
 01 WS-T-COMPOUND          BINARY-LONG VALUE 10.
 01 WS-T-STRING            BINARY-LONG VALUE 8.
 01 WS-ZERO                BINARY-LONG VALUE 0.
 01 WS-REMOVED             BINARY-LONG VALUE 7.
 01 WS-SLOT                BINARY-LONG.
 01 WS-SATURATION          FLOAT-SHORT VALUE 3.
 01 WS-BYTES               PIC X(8) VALUE "AB".
 01 WS-TEXT                PIC X(64).
 01 WS-TEXT-LENGTH         BINARY-LONG.
 01 WS-NAME                PIC X(16).
 01 WS-NAME-LENGTH         BINARY-LONG.
 01 WS-UUID                PIC X(16).
 01 WS-UUID-TEXT           PIC X(36).
 01 WS-PATH                PIC X(256).
 01 WS-PATH-LENGTH         BINARY-LONG.
 01 WS-OUTCOME             BINARY-LONG.
 01 WS-KNOWN               BINARY-LONG.
 01 WS-KNOWN2              BINARY-LONG.
 01 WS-HANDLE              BINARY-LONG.
 01 WS-DAMAGE              BINARY-LONG.
 01 WS-KP                  BINARY-LONG.
 01 WS-RECIPE              BINARY-LONG.
 01 WS-CAPACITY            BINARY-LONG VALUE 65536.
 01 WS-I                   BINARY-LONG.
 01 WS-INVENTORY.
    05 WS-INV-SLOT OCCURS 36 TIMES.
       10 WS-INV-ITEM      BINARY-LONG.
       10 WS-INV-COUNT     BINARY-LONG.
 PROCEDURE DIVISION.
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     MOVE 0 TO WS-RECIPE
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > RC-COUNT OR WS-RECIPE > 0
         IF RR-SPECIAL(WS-I) = 0
             MOVE WS-I TO WS-RECIPE
         END-IF
     END-PERFORM

*>   A file with every kind of entry a reader must handle.
     MOVE "Cy" TO WS-NAME MOVE 2 TO WS-NAME-LENGTH
     PERFORM OPEN-FILE
     MOVE "extra" TO WN MOVE 5 TO WL
     CALL "NBT-WRITE-BYTE" USING PB-BUFFER WN WL WS-ONE
     MOVE "foodSaturationLevel" TO WN MOVE 19 TO WL
     CALL "NBT-WRITE-FLOAT" USING PB-BUFFER WN WL WS-SATURATION
     MOVE "Inventory" TO WN MOVE 9 TO WL
     CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WN WL WS-T-COMPOUND WS-FIVE
     MOVE 36 TO WS-SLOT PERFORM WRITE-SLOT-PATCHED
     MOVE 1 TO WS-SLOT PERFORM WRITE-SLOT-PATCHED
     MOVE 3 TO WS-SLOT
     PERFORM WRITE-SLOT-EMPTY
     MOVE 4 TO WS-SLOT PERFORM WRITE-SLOT-UNKNOWN
     MOVE 5 TO WS-SLOT PERFORM WRITE-SLOT-NO-COUNT
     MOVE "equipment" TO WN MOVE 9 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     MOVE "feet" TO WN MOVE 4 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     PERFORM WRITE-STACK-PATCHED
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE "head" TO WN MOVE 4 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     PERFORM WRITE-STACK-EMPTY
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE "legs" TO WN MOVE 4 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL WS-ONE
     MOVE "body" TO WN MOVE 4 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE "recipeBook" TO WN MOVE 10 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     MOVE "isGuiOpen" TO WN MOVE 9 TO WL
     CALL "NBT-WRITE-BYTE" USING PB-BUFFER WN WL WS-ONE
     MOVE "isSmokerFilteringCraftable" TO WN MOVE 26 TO WL
     CALL "NBT-WRITE-BYTE" USING PB-BUFFER WN WL WS-ONE
     MOVE "odd" TO WN MOVE 3 TO WL
     CALL "NBT-WRITE-BYTE" USING PB-BUFFER WN WL WS-ONE
     MOVE "zzz" TO WN MOVE 3 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL WS-ONE
     MOVE "recipes" TO WN MOVE 7 TO WL
     CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WN WL WS-T-STRING WS-TWO
     PERFORM WRITE-RECIPE-KEY
     MOVE "bogus:none" TO WS-TEXT MOVE 10 TO WS-TEXT-LENGTH
     MOVE -1 TO WL
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WN WL WS-TEXT WS-TEXT-LENGTH
     MOVE "toBeDisplayed" TO WN MOVE 13 TO WL
     CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WN WL WS-T-STRING WS-ONE
     PERFORM WRITE-RECIPE-KEY
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     PERFORM CLOSE-FILE
     CALL "PLAYER-DAT-READ" USING WS-UUID WS-KNOWN

     MOVE "test player state edges slot 1 is read with its item and count; slots 36, 3 and 4 are dropped"
         TO TL-CASE
     MOVE KN-INVENTORY(WS-KNOWN) TO WS-INVENTORY
     MOVE "N" TO TL-MODE
     COMPUTE TL-EXPECTED-N = 3 * 1000 + 2
     COMPUTE TL-OBSERVED-N = WS-INV-ITEM(2) * 1000 + WS-INV-COUNT(2)
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 36
         IF WS-I NOT = 2 AND WS-INV-COUNT(WS-I) NOT = 0
             MOVE -1 TO TL-OBSERVED-N
         END-IF
     END-PERFORM
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test player state edges the patch of slot 1 keeps its added damage 5" TO TL-CASE
     CALL "KX-PATCH-TAKE" USING KX-SLOT-KP(WS-KNOWN, 2) WS-HANDLE
     CALL "SP-GET-DAMAGE" USING WS-INV-ITEM(2) WS-HANDLE WS-DAMAGE
     MOVE 5 TO TL-EXPECTED-N
     MOVE WS-DAMAGE TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test player state edges the patch keeps its removed component and the equipment its boots; "
         & "head, legs and body are dropped" TO TL-CASE
     MOVE KX-SLOT-KP(WS-KNOWN, 2) TO WS-KP
     COMPUTE TL-EXPECTED-N = 1 * 100 + 2 * 10 + 0
     COMPUTE TL-OBSERVED-N = KP-REMOVED-COUNT(WS-KP) * 100 + KX-EQUIP-COUNT(WS-KNOWN, 1) * 10
         + KX-EQUIP-COUNT(WS-KNOWN, 4) + KX-EQUIP-COUNT(WS-KNOWN, 2) + KX-EQUIP-COUNT(WS-KNOWN, 3)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test player state edges the saturation 3.0 is read; the recipe book has the first recipe "
         & "highlighted, the unknown key dropped and the settings" TO TL-CASE
     COMPUTE TL-EXPECTED-N = 3000 * 1000 + 2 * 100 + 1 * 10 + 1
     COMPUTE TL-OBSERVED-N = KX-SATURATION(WS-KNOWN) * 1000 * 1000 + KX-FLAG(WS-KNOWN, WS-RECIPE) * 100
         + KX-BOOK-OPEN(WS-KNOWN, 1) * 10 + KX-BOOK-FILTER(WS-KNOWN, 4)
     IF KX-BOOK-SET(WS-KNOWN) NOT = 1
         MOVE -1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test player state edges a file written from that state and read again keeps the removed component"
         TO TL-CASE
     CALL "PLAYER-DAT-WRITE" USING WS-KNOWN
     CALL "PLAYER-DAT-READ" USING WS-UUID WS-KNOWN2
     MOVE KX-SLOT-KP(WS-KNOWN2, 2) TO WS-KP
     COMPUTE TL-EXPECTED-N = 1 * 10 + 7
     COMPUTE TL-OBSERVED-N = KP-REMOVED-COUNT(WS-KP) * 10 + KP-REMOVED(WS-KP, 1)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

*>   A book with one list only is ignored.
     MOVE "Di" TO WS-NAME MOVE 2 TO WS-NAME-LENGTH
     PERFORM OPEN-FILE
     MOVE "recipeBook" TO WN MOVE 10 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     MOVE "recipes" TO WN MOVE 7 TO WL
     CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WN WL WS-T-STRING WS-ONE
     PERFORM WRITE-RECIPE-KEY
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     PERFORM CLOSE-FILE
     CALL "PLAYER-DAT-READ" USING WS-UUID WS-KNOWN
     MOVE "test player state edges a recipeBook without toBeDisplayed is ignored as a whole" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = KX-BOOK-SET(WS-KNOWN) + KX-FLAG(WS-KNOWN, WS-RECIPE)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test player state edges a full patch pool keeps no copy of a patch" TO TL-CASE
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > KX-MAX-PATCHES
         MOVE 1 TO KP-LIVE(WS-I)
     END-PERFORM
     MOVE 0 TO WS-HANDLE
     MOVE 4 TO WS-DAMAGE
     CALL "SP-SET-DAMAGE" USING WS-HANDLE WS-DAMAGE
     MOVE 99 TO WS-KP
     CALL "KX-PATCH-KEEP" USING WS-HANDLE WS-KP
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-KP TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 OPEN-FILE.
     CALL "LOGIN-OFFLINE-UUID" USING WS-NAME WS-NAME-LENGTH WS-UUID
     CALL "PB-RESET" USING PB-BUFFER
     MOVE SPACES TO WN
     MOVE 0 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL.

 CLOSE-FILE.
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "PERSIST-UUID-TEXT" USING WS-UUID WS-UUID-TEXT
     MOVE SPACES TO WS-PATH
     STRING "build/core-test-world/players/" WS-UUID-TEXT ".dat" DELIMITED BY SIZE INTO WS-PATH
     MOVE FUNCTION LENGTH(FUNCTION TRIM(WS-PATH)) TO WS-PATH-LENGTH
     CALL "NBT-FILE-WRITE" USING WS-PATH WS-PATH-LENGTH PB-BUFFER WS-OUTCOME.

 WRITE-RECIPE-KEY.
     MOVE FUNCTION LENGTH(FUNCTION TRIM(RR-KEY(WS-RECIPE) TRAILING)) TO WS-TEXT-LENGTH
     MOVE RR-KEY(WS-RECIPE) TO WS-TEXT
     MOVE -1 TO WL
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WN WL WS-TEXT WS-TEXT-LENGTH.

 WRITE-ITEM-KEY.
     MOVE "id" TO WN MOVE 2 TO WL
     MOVE "cobolcraft:loam" TO WS-TEXT MOVE 15 TO WS-TEXT-LENGTH
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WN WL WS-TEXT WS-TEXT-LENGTH.

 WRITE-STACK-PATCHED.
     PERFORM WRITE-ITEM-KEY
     MOVE "count" TO WN MOVE 5 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL WS-TWO
     MOVE "components" TO WN MOVE 10 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     MOVE "added" TO WN MOVE 5 TO WL
     CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WN WL WS-T-COMPOUND WS-TWO
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WS-ELEMENT
     MOVE "type" TO WN MOVE 4 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL WS-THREE
     MOVE "value" TO WN MOVE 5 TO WL
     MOVE X"05" TO WS-BYTES(1:1)
     CALL "NBT-WRITE-BYTE-ARRAY" USING PB-BUFFER WN WL WS-ONE WS-BYTES
     MOVE "extra" TO WN MOVE 5 TO WL
     CALL "NBT-WRITE-BYTE" USING PB-BUFFER WN WL WS-ONE
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WS-ELEMENT
     MOVE "value" TO WN MOVE 5 TO WL
     CALL "NBT-WRITE-BYTE-ARRAY" USING PB-BUFFER WN WL WS-ONE WS-BYTES
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE "removed" TO WN MOVE 7 TO WL
     CALL "NBT-WRITE-INT-ARRAY" USING PB-BUFFER WN WL WS-ONE WS-REMOVED
     MOVE "odd" TO WN MOVE 3 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL WS-ONE
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER.

 WRITE-STACK-EMPTY.
     PERFORM WRITE-ITEM-KEY
     MOVE "count" TO WN MOVE 5 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL WS-ZERO
     MOVE "components" TO WN MOVE 10 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     MOVE "removed" TO WN MOVE 7 TO WL
     CALL "NBT-WRITE-INT-ARRAY" USING PB-BUFFER WN WL WS-ONE WS-REMOVED
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER.

 WRITE-SLOT-HEAD.
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WS-ELEMENT
     MOVE "Slot" TO WN MOVE 4 TO WL
     CALL "NBT-WRITE-BYTE" USING PB-BUFFER WN WL WS-SLOT.

 WRITE-SLOT-PATCHED.
     PERFORM WRITE-SLOT-HEAD
     PERFORM WRITE-STACK-PATCHED
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER.

 WRITE-SLOT-EMPTY.
     MOVE -1 TO WS-ELEMENT
     PERFORM WRITE-SLOT-HEAD
     PERFORM WRITE-STACK-EMPTY
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER.

 WRITE-SLOT-UNKNOWN.
     PERFORM WRITE-SLOT-HEAD
     MOVE "id" TO WN MOVE 2 TO WL
     MOVE "nowhere:nothing" TO WS-TEXT MOVE 15 TO WS-TEXT-LENGTH
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WN WL WS-TEXT WS-TEXT-LENGTH
     MOVE "count" TO WN MOVE 5 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL WS-TWO
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER.

 WRITE-SLOT-NO-COUNT.
     PERFORM WRITE-SLOT-HEAD
     PERFORM WRITE-ITEM-KEY
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER.
 END PROGRAM TEST-PLAYER-STATE-EDGES.

 COPY CORETEST.
