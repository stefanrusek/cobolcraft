     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-I1
     MOVE 0 TO WS-I2
     MOVE 0 TO WS-I3
     CALL "TOOL-BUCKET-PLACE" USING WS-I1 WS-I2 WS-I3 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 0 TO WS-I1
     MOVE 1 TO WS-I2
     MOVE 0 TO WS-I3
     CALL "TOOL-BUCKET-PLACE" USING WS-I1 WS-I2 WS-I3 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
