*> Test of 31-5 section 4, End portal and end gateway (core/src/be-31-5.cob; T0927): the portal faces, the gateway counters and cooldown, the block event, the beam fractions, the use rule and the saved keys.
*> Each case runs its statements and shows the items joined by single spaces ("n" integers, "f" floats x 1e6, "t" text up to a stored length).
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-BE-31-5-4.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY BESTATE.
 COPY PROTO.
 COPY COREAPI.
 COPY CITEMS.
 01 WS-SHOW                PIC -(10)9.
 01 WS-PTR                 BINARY-LONG.
 01 WS-K                   BINARY-LONG.
 01 WS-J                   BINARY-LONG.
 01 WS-IDX                 BINARY-LONG.
 01 WS-LEN                 BINARY-LONG.
 01 WS-OUT                 PIC X(8192).
 01 WS-CAPACITY            BINARY-LONG VALUE 8192.
 01 WS-T10                 BINARY-LONG VALUE 10.
 01 WS-FORM                BINARY-LONG VALUE 1.
 01 WS-D                   BINARY-LONG VALUE 1.
 01 WS-KEY                 PIC X(48).
 01 WS-NM                  PIC X(32).
 01 WS-NML                 BINARY-LONG.
 01 WS-SV                  PIC X(256).
 01 WS-SVL                 BINARY-LONG.
 01 WS-NV                  BINARY-LONG.
 01 WS-LV                  BINARY-DOUBLE.
 01 WS-IA.
    05 WS-IAV              BINARY-LONG OCCURS 8 TIMES.
 01 WS-LT                  BINARY-LONG.
 01 WS-LC                  BINARY-LONG.
 01 WS-X                   BINARY-LONG.
 01 WS-ITEM                BINARY-LONG.
 01 WS-KP                  BINARY-LONG VALUE 0.
 01 WS-Y                   BINARY-LONG.
 01 WS-Z                   BINARY-LONG.
 01 WS-A                 BINARY-LONG.
 01 WS-B                 BINARY-LONG.
 01 WS-C                 BINARY-LONG.
 01 WS-E                 BINARY-LONG.
 01 WS-F                 BINARY-LONG.
 01 WS-G                 BINARY-LONG.
 01 WS-H                 BINARY-LONG.
 01 WS-EV                BINARY-LONG.
 01 WS-O1                 BINARY-LONG.
 01 WS-O2                 BINARY-LONG.
 01 WS-O3                 BINARY-LONG.
 01 WS-O4                 BINARY-LONG.
 01 WS-O5                 BINARY-LONG.
 01 WS-O6                 BINARY-LONG.
 01 WS-O7                 BINARY-LONG.
 01 WS-FA                FLOAT-LONG.
 01 WS-FB                FLOAT-LONG.
 01 WS-FC                FLOAT-LONG.
 01 WS-FD                FLOAT-LONG.
 01 WS-FE                FLOAT-LONG.
 01 WS-FF                FLOAT-LONG.
 01 WS-N24                PIC X(24).
 01 WS-N32                PIC X(32).
 01 WS-PK                 PIC X(32).
 01 WS-SK                 PIC X(32).
 01 WS-PASSES.
    05 WS-PASS            BINARY-LONG OCCURS 4 TIMES.
 01 WS-OFFS.
    05 WS-OFF             OCCURS 64 TIMES.
       10 WS-OX           BINARY-LONG.
       10 WS-OY           BINARY-LONG.
       10 WS-OZ           BINARY-LONG.
 01 WS-TX                 PIC X(64).
 PROCEDURE DIVISION.
     MOVE "T" TO TL-MODE
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     MOVE "acceptance US12 31-5§4 End portal and end gateway: end portal faces (4.1): the entity has no data; only faces on the Y axis (down 0, up 1) are rendered" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE 0 TO WS-A
     CALL "BE5-PORTAL-FACE" USING WS-A WS-B
     MOVE WS-B TO WS-SHOW
     PERFORM ADD-N
     MOVE 1 TO WS-A
     CALL "BE5-PORTAL-FACE" USING WS-A WS-B
     MOVE WS-B TO WS-SHOW
     PERFORM ADD-N
     MOVE 2 TO WS-A
     CALL "BE5-PORTAL-FACE" USING WS-A WS-B
     MOVE WS-B TO WS-SHOW
     PERFORM ADD-N
     MOVE 3 TO WS-A
     CALL "BE5-PORTAL-FACE" USING WS-A WS-B
     MOVE WS-B TO WS-SHOW
     PERFORM ADD-N
     MOVE 4 TO WS-A
     CALL "BE5-PORTAL-FACE" USING WS-A WS-B
     MOVE WS-B TO WS-SHOW
     PERFORM ADD-N
     MOVE 5 TO WS-A
     CALL "BE5-PORTAL-FACE" USING WS-A WS-B
     MOVE WS-B TO WS-SHOW
     PERFORM ADD-N
     MOVE "1 1 0 0 0 0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "acceptance US12 31-5§4 End portal and end gateway: gateway state (4.2): Age is always written (0), exit_portal only when set, ExactTeleport only when true" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE 22 TO WS-A
     MOVE "minecraft:end_gateway" TO WS-KEY
     MOVE 21 TO WS-SVL
     MOVE 5 TO WS-X
     MOVE 70 TO WS-Y
     MOVE 5 TO WS-Z
     CALL "BE-CREATE" USING WS-D WS-X WS-Y WS-Z WS-A WS-KEY WS-SVL WS-IDX
     MOVE 2 TO WS-FORM
     PERFORM SAVE-RENDER
     MOVE "{Age:0}" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "acceptance US12 31-5§4 End portal and end gateway: server tick (4.3): age rises each tick; the tick that ends the 200-tick spawning is a state change (changed 1); at age 2400 the cooldown starts (40, block event 1) and counts" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE 22 TO WS-A
     MOVE "minecraft:end_gateway" TO WS-KEY
     MOVE 21 TO WS-SVL
     MOVE 5 TO WS-X
     MOVE 70 TO WS-Y
     MOVE 5 TO WS-Z
     CALL "BE-CREATE" USING WS-D WS-X WS-Y WS-Z WS-A WS-KEY WS-SVL WS-IDX
     MOVE 198 TO BE-XI(WS-IDX, 1)
     MOVE 0 TO WS-A
     CALL "BE5-GATEWAY-TICK" USING WS-IDX WS-A WS-B WS-C
     MOVE BE-XI(WS-IDX, 1) TO WS-SHOW
     PERFORM ADD-N
     MOVE WS-B TO WS-SHOW
     PERFORM ADD-N
     MOVE WS-C TO WS-SHOW
     PERFORM ADD-N
     CALL "BE5-GATEWAY-TICK" USING WS-IDX WS-A WS-B WS-C
     MOVE BE-XI(WS-IDX, 1) TO WS-SHOW
     PERFORM ADD-N
     MOVE WS-B TO WS-SHOW
     PERFORM ADD-N
     MOVE WS-C TO WS-SHOW
     PERFORM ADD-N
     CALL "BE5-GATEWAY-TICK" USING WS-IDX WS-A WS-B WS-C
     MOVE BE-XI(WS-IDX, 1) TO WS-SHOW
     PERFORM ADD-N
     MOVE WS-B TO WS-SHOW
     PERFORM ADD-N
     MOVE WS-C TO WS-SHOW
     PERFORM ADD-N
     MOVE 2398 TO BE-XI(WS-IDX, 1)
     CALL "BE5-GATEWAY-TICK" USING WS-IDX WS-A WS-B WS-C
     MOVE BE-XI(WS-IDX, 1) TO WS-SHOW
     PERFORM ADD-N
     MOVE BE-XI(WS-IDX, 7) TO WS-SHOW
     PERFORM ADD-N
     MOVE WS-B TO WS-SHOW
     PERFORM ADD-N
     MOVE WS-C TO WS-SHOW
     PERFORM ADD-N
     CALL "BE5-GATEWAY-TICK" USING WS-IDX WS-A WS-B WS-C
     MOVE BE-XI(WS-IDX, 1) TO WS-SHOW
     PERFORM ADD-N
     MOVE BE-XI(WS-IDX, 7) TO WS-SHOW
     PERFORM ADD-N
     MOVE WS-B TO WS-SHOW
     PERFORM ADD-N
     MOVE WS-C TO WS-SHOW
     PERFORM ADD-N
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > 39
     CALL "BE5-GATEWAY-TICK" USING WS-IDX WS-A WS-B WS-C
     END-PERFORM
     MOVE BE-XI(WS-IDX, 7) TO WS-SHOW
     PERFORM ADD-N
     MOVE WS-C TO WS-SHOW
     PERFORM ADD-N
     CALL "BE5-GATEWAY-TICK" USING WS-IDX WS-A WS-B WS-C
     MOVE BE-XI(WS-IDX, 7) TO WS-SHOW
     PERFORM ADD-N
     MOVE WS-B TO WS-SHOW
     PERFORM ADD-N
     MOVE WS-C TO WS-SHOW
     PERFORM ADD-N
     MOVE "199 0 0 200 0 1 201 0 0 2399 0 0 0 2400 40 1 1 1 0 0 0 1" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "acceptance US12 31-5§4 End portal and end gateway: client tick (4.3): age rises and a running cooldown counts down; the client never starts a cooldown itself (only the block event does)" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE 22 TO WS-A
     MOVE "minecraft:end_gateway" TO WS-KEY
     MOVE 21 TO WS-SVL
     MOVE 5 TO WS-X
     MOVE 70 TO WS-Y
     MOVE 5 TO WS-Z
     CALL "BE-CREATE" USING WS-D WS-X WS-Y WS-Z WS-A WS-KEY WS-SVL WS-IDX
     MOVE 1 TO WS-A
     MOVE 5 TO BE-XI(WS-IDX, 7)
     CALL "BE5-GATEWAY-TICK" USING WS-IDX WS-A WS-B WS-C
     CALL "BE5-GATEWAY-TICK" USING WS-IDX WS-A WS-B WS-C
     MOVE BE-XI(WS-IDX, 1) TO WS-SHOW
     PERFORM ADD-N
     MOVE BE-XI(WS-IDX, 7) TO WS-SHOW
     PERFORM ADD-N
     MOVE WS-B TO WS-SHOW
     PERFORM ADD-N
     MOVE 2399 TO BE-XI(WS-IDX, 1)
     MOVE 0 TO BE-XI(WS-IDX, 7)
     CALL "BE5-GATEWAY-TICK" USING WS-IDX WS-A WS-B WS-C
     MOVE BE-XI(WS-IDX, 1) TO WS-SHOW
     PERFORM ADD-N
     MOVE BE-XI(WS-IDX, 7) TO WS-SHOW
     PERFORM ADD-N
     MOVE "2 3 0 2400 0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "acceptance US12 31-5§4 End portal and end gateway: block event (4.3): event 1 sets the cooldown to 40 on the client (handled); any other event goes to the base class" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE 22 TO WS-A
     MOVE "minecraft:end_gateway" TO WS-KEY
     MOVE 21 TO WS-SVL
     MOVE 5 TO WS-X
     MOVE 70 TO WS-Y
     MOVE 5 TO WS-Z
     CALL "BE-CREATE" USING WS-D WS-X WS-Y WS-Z WS-A WS-KEY WS-SVL WS-IDX
     MOVE 1 TO WS-A
     CALL "BE5-GATEWAY-EVENT" USING WS-IDX WS-A WS-C
     MOVE WS-C TO WS-SHOW
     PERFORM ADD-N
     MOVE BE-XI(WS-IDX, 7) TO WS-SHOW
     PERFORM ADD-N
     MOVE 7 TO WS-A
     MOVE 0 TO BE-XI(WS-IDX, 7)
     CALL "BE5-GATEWAY-EVENT" USING WS-IDX WS-A WS-C
     MOVE WS-C TO WS-SHOW
     PERFORM ADD-N
     MOVE BE-XI(WS-IDX, 7) TO WS-SHOW
     PERFORM ADD-N
     MOVE "1 40 0 0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "acceptance US12 31-5§4 End portal and end gateway: beam fractions (4.2): spawn percent clamp((age + partial) / 200, 0, 1) and cooldown percent 1 - clamp((cooldown - partial) / 40, 0, 1)" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE 0 TO WS-A
     MOVE 0 TO WS-B
     COMPUTE WS-FA = 0.0
     CALL "BE5-GATEWAY-PERCENT" USING WS-A WS-B WS-FA WS-FB WS-FC
     COMPUTE WS-SHOW ROUNDED = (WS-FB) * 10000
     PERFORM ADD-N
     COMPUTE WS-SHOW ROUNDED = (WS-FC) * 10000
     PERFORM ADD-N
     MOVE 100 TO WS-A
     MOVE 0 TO WS-B
     COMPUTE WS-FA = 0.5
     CALL "BE5-GATEWAY-PERCENT" USING WS-A WS-B WS-FA WS-FB WS-FC
     COMPUTE WS-SHOW ROUNDED = (WS-FB) * 10000
     PERFORM ADD-N
     COMPUTE WS-SHOW ROUNDED = (WS-FC) * 10000
     PERFORM ADD-N
     MOVE 200 TO WS-A
     MOVE 0 TO WS-B
     COMPUTE WS-FA = 0.0
     CALL "BE5-GATEWAY-PERCENT" USING WS-A WS-B WS-FA WS-FB WS-FC
     COMPUTE WS-SHOW ROUNDED = (WS-FB) * 10000
     PERFORM ADD-N
     COMPUTE WS-SHOW ROUNDED = (WS-FC) * 10000
     PERFORM ADD-N
     MOVE 300 TO WS-A
     MOVE 0 TO WS-B
     COMPUTE WS-FA = 0.0
     CALL "BE5-GATEWAY-PERCENT" USING WS-A WS-B WS-FA WS-FB WS-FC
     COMPUTE WS-SHOW ROUNDED = (WS-FB) * 10000
     PERFORM ADD-N
     COMPUTE WS-SHOW ROUNDED = (WS-FC) * 10000
     PERFORM ADD-N
     MOVE 250 TO WS-A
     MOVE 40 TO WS-B
     COMPUTE WS-FA = 0.5
     CALL "BE5-GATEWAY-PERCENT" USING WS-A WS-B WS-FA WS-FB WS-FC
     COMPUTE WS-SHOW ROUNDED = (WS-FB) * 10000
     PERFORM ADD-N
     COMPUTE WS-SHOW ROUNDED = (WS-FC) * 10000
     PERFORM ADD-N
     MOVE 250 TO WS-A
     MOVE 20 TO WS-B
     COMPUTE WS-FA = 0.5
     CALL "BE5-GATEWAY-PERCENT" USING WS-A WS-B WS-FA WS-FB WS-FC
     COMPUTE WS-SHOW ROUNDED = (WS-FB) * 10000
     PERFORM ADD-N
     COMPUTE WS-SHOW ROUNDED = (WS-FC) * 10000
     PERFORM ADD-N
     MOVE 250 TO WS-A
     MOVE 1 TO WS-B
     COMPUTE WS-FA = 0.3
     CALL "BE5-GATEWAY-PERCENT" USING WS-A WS-B WS-FA WS-FB WS-FC
     COMPUTE WS-SHOW ROUNDED = (WS-FB) * 10000
     PERFORM ADD-N
     COMPUTE WS-SHOW ROUNDED = (WS-FC) * 10000
     PERFORM ADD-N
     MOVE 250 TO WS-A
     MOVE 0 TO WS-B
     COMPUTE WS-FA = 0.0
     CALL "BE5-GATEWAY-PERCENT" USING WS-A WS-B WS-FA WS-FB WS-FC
     COMPUTE WS-SHOW ROUNDED = (WS-FB) * 10000
     PERFORM ADD-N
     COMPUTE WS-SHOW ROUNDED = (WS-FC) * 10000
     PERFORM ADD-N
     MOVE 0 TO WS-A
     MOVE 0 TO WS-B
     COMPUTE WS-FA = -0.5
     CALL "BE5-GATEWAY-PERCENT" USING WS-A WS-B WS-FA WS-FB WS-FC
     COMPUTE WS-SHOW ROUNDED = (WS-FB) * 10000
     PERFORM ADD-N
     COMPUTE WS-SHOW ROUNDED = (WS-FC) * 10000
     PERFORM ADD-N
     MOVE 250 TO WS-A
     MOVE 0 TO WS-B
     COMPUTE WS-FA = 0.5
     CALL "BE5-GATEWAY-PERCENT" USING WS-A WS-B WS-FA WS-FB WS-FC
     COMPUTE WS-SHOW ROUNDED = (WS-FB) * 10000
     PERFORM ADD-N
     COMPUTE WS-SHOW ROUNDED = (WS-FC) * 10000
     PERFORM ADD-N
     MOVE 250 TO WS-A
     MOVE 60 TO WS-B
     COMPUTE WS-FA = 0.0
     CALL "BE5-GATEWAY-PERCENT" USING WS-A WS-B WS-FA WS-FB WS-FC
     COMPUTE WS-SHOW ROUNDED = (WS-FB) * 10000
     PERFORM ADD-N
     COMPUTE WS-SHOW ROUNDED = (WS-FC) * 10000
     PERFORM ADD-N
     MOVE "0 10000 5025 10000 10000 10000 10000 10000 10000 125 10000 5125 10000 9825 10000 10000 0 9875 10000 " &
         "10000 10000 0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "acceptance US12 31-5§4 End portal and end gateway: entityInside (4.3): an entity that can use portals, on the server, with the block entity present and not cooling down enters the portal and starts the cooldown (1)" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE 1 TO WS-A
     MOVE 1 TO WS-B
     MOVE 1 TO WS-C
     MOVE 0 TO WS-E
     CALL "BE5-GATEWAY-USE" USING WS-A WS-B WS-C WS-E WS-F
     MOVE WS-F TO WS-SHOW
     PERFORM ADD-N
     MOVE 1 TO WS-A
     MOVE 1 TO WS-B
     MOVE 1 TO WS-C
     MOVE 1 TO WS-E
     CALL "BE5-GATEWAY-USE" USING WS-A WS-B WS-C WS-E WS-F
     MOVE WS-F TO WS-SHOW
     PERFORM ADD-N
     MOVE 0 TO WS-A
     MOVE 1 TO WS-B
     MOVE 1 TO WS-C
     MOVE 0 TO WS-E
     CALL "BE5-GATEWAY-USE" USING WS-A WS-B WS-C WS-E WS-F
     MOVE WS-F TO WS-SHOW
     PERFORM ADD-N
     MOVE 1 TO WS-A
     MOVE 0 TO WS-B
     MOVE 1 TO WS-C
     MOVE 0 TO WS-E
     CALL "BE5-GATEWAY-USE" USING WS-A WS-B WS-C WS-E WS-F
     MOVE WS-F TO WS-SHOW
     PERFORM ADD-N
     MOVE 1 TO WS-A
     MOVE 1 TO WS-B
     MOVE 0 TO WS-C
     MOVE 0 TO WS-E
     CALL "BE5-GATEWAY-USE" USING WS-A WS-B WS-C WS-E WS-F
     MOVE WS-F TO WS-SHOW
     PERFORM ADD-N
     MOVE "1 0 0 0 0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "acceptance US12 31-5§4 End portal and end gateway: save and load (4.2): Age, exit_portal (an int array of 3) and ExactTeleport round trip (saved in the order Age, exit_portal, ExactTeleport); ExactTeleport false is not written" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE 22 TO WS-A
     MOVE "minecraft:end_gateway" TO WS-KEY
     MOVE 21 TO WS-SVL
     MOVE 5 TO WS-X
     MOVE 70 TO WS-Y
     MOVE 5 TO WS-Z
     CALL "BE-CREATE" USING WS-D WS-X WS-Y WS-Z WS-A WS-KEY WS-SVL WS-IDX
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     MOVE "Age" TO WS-NM
     MOVE 3 TO WS-NML
     MOVE 2000 TO WS-LV
     PERFORM NB-LONG
     MOVE "exit_portal" TO WS-NM
     MOVE 11 TO WS-NML
     MOVE 100 TO WS-IAV(1)
     MOVE 50 TO WS-IAV(2)
     MOVE 0 TO WS-IAV(3)
     MOVE 3 TO WS-LC
     PERFORM NB-IA
     MOVE "ExactTeleport" TO WS-NM
     MOVE 13 TO WS-NML
     MOVE 1 TO WS-NV
     PERFORM NB-B
     PERFORM LOAD-BUFFER
     MOVE 2 TO WS-FORM
     PERFORM SAVE-RENDER
     MOVE BE-XI(WS-IDX, 1) TO WS-SHOW
     PERFORM ADD-N
     MOVE 22 TO WS-A
     MOVE "minecraft:end_gateway" TO WS-KEY
     MOVE 21 TO WS-SVL
     MOVE 5 TO WS-X
     MOVE 70 TO WS-Y
     MOVE 5 TO WS-Z
     CALL "BE-CREATE" USING WS-D WS-X WS-Y WS-Z WS-A WS-KEY WS-SVL WS-IDX
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     MOVE "Age" TO WS-NM
     MOVE 3 TO WS-NML
     MOVE 7 TO WS-LV
     PERFORM NB-LONG
     MOVE "ExactTeleport" TO WS-NM
     MOVE 13 TO WS-NML
     MOVE 0 TO WS-NV
     PERFORM NB-B
     PERFORM LOAD-BUFFER
     PERFORM SAVE-RENDER
     MOVE "{Age:2000,exit_portal:I[100,50,0],ExactTeleport:1} 2000 {Age:7}" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     STOP RUN.

 BEGIN-CASE.
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR
     .

 ADD-N.
     STRING FUNCTION TRIM(WS-SHOW) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .

*> Saves entity WS-IDX in form WS-FORM, renders the compound and appends it to TL-OBSERVED.
 SAVE-RENDER.
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     CALL "BE-SAVE" USING WS-IDX WS-FORM PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE 0 TO PB-POS
     MOVE 0 TO WS-LEN
     MOVE SPACES TO WS-OUT
     CALL "TEST-NBT-RENDER" USING PB-BUFFER WS-T10 WS-OUT WS-LEN
     CALL "PB-FREE" USING PB-BUFFER
     STRING WS-OUT(1:WS-LEN) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .

*> The NBT builders of the cases (name WS-NM and length WS-NML, text WS-SV and length WS-SVL, number WS-NV, list type WS-LT and count WS-LC).
 NB-S.
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WS-NM WS-NML WS-SV WS-SVL
     .
 NB-I.
     CALL "NBT-WRITE-INT" USING PB-BUFFER WS-NM WS-NML WS-NV
     .
 NB-LONG.
     CALL "NBT-WRITE-LONG" USING PB-BUFFER WS-NM WS-NML WS-LV
     .
 NB-IA.
     CALL "NBT-WRITE-INT-ARRAY" USING PB-BUFFER WS-NM WS-NML WS-LC WS-IA
     .
 NB-B.
     CALL "NBT-WRITE-BYTE" USING PB-BUFFER WS-NM WS-NML WS-NV
     .
 NB-C.
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WS-NM WS-NML
     .
 NB-E.
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     .
 NB-STACK.
     MOVE 0 TO WS-KP
     CALL "PNBT-STACK-WRITE" USING PB-BUFFER WS-ITEM WS-NV WS-KP
     .
 NB-L.
     CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WS-NM WS-NML WS-LT WS-LC
     .

*> Loads entity WS-IDX from the compound the case built in PB-BUFFER (the closing End tag is written here).
 LOAD-BUFFER.
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE 0 TO PB-POS
     CALL "BE-LOAD" USING WS-IDX PB-BUFFER
     CALL "PB-FREE" USING PB-BUFFER
     .
 END PROGRAM TEST-BE-31-5-4.

 COPY CORETEST.
