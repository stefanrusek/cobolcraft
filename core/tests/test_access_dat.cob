*> Implementation test of the access lists and access.dat (core/src/access.cob; core/src/persistence.cob
*> ACCESS-DAT-WRITE and ACCESS-DAT-READ; docs/protocol/07-nbt-and-anvil.md §9.2; operator decision
*> A2): the operator, ban and allow lists hold offline identities (name and offline UUID); adding an
*> identity already listed, removing one not listed and adding to a full list are reported; the
*> file holds DataVersion, Operators, Bans and AllowList as {Name, UUID: Int Array of 4, most
*> significant first} and AllowListEnforced; reading it back restores the lists and the flag. A new
*> dedicated-server world seeds the flag from CS-ALLOW-LIST-ENFORCED, a new world with host kind 1
*> seeds 0, and an existing world keeps its stored flag whatever the setting says.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-ACCESS-DAT.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY COREAPI.
 COPY PROTO.
 01 WS-CAPACITY            BINARY-LONG VALUE 65536.
 01 WS-FILE                PIC X(256) VALUE "build/core-test-world/access.dat".
 01 WS-WORLD               PIC X(64) VALUE Z"build/core-test-world".
 01 WS-CREATED             BINARY-LONG.
 01 WS-ROOT                BINARY-LONG.
 01 WS-PATH                PIC X(128).
 01 WS-TEXT                PIC X(8192).
 01 WS-OBSERVED            PIC X(8192).
 01 WS-EXPECTED            PIC X(1024).
 01 WS-EDIT                PIC -(10)9.
 01 WS-LIST                BINARY-LONG.
 01 WS-OUTCOME             BINARY-LONG.
 01 WS-ROW                 BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-K                   BINARY-LONG.
 01 WS-VALUE               BINARY-DOUBLE.
 01 WS-NAMES.
    05 FILLER              PIC X(16) VALUE "Alice".
    05 FILLER              PIC X(16) VALUE "Bob".
    05 FILLER              PIC X(16) VALUE "Carol".
 01 WS-NAME-TABLE REDEFINES WS-NAMES.
    05 WS-NAME             PIC X(16) OCCURS 3 TIMES.
 01 WS-LENGTHS.
    05 FILLER              BINARY-LONG VALUE 5.
    05 FILLER              BINARY-LONG VALUE 3.
    05 FILLER              BINARY-LONG VALUE 5.
 01 WS-LENGTH-TABLE REDEFINES WS-LENGTHS.
    05 WS-LENGTH           BINARY-LONG OCCURS 3 TIMES.
 01 WS-UUIDS.
    05 WS-UUID             PIC X(16) OCCURS 3 TIMES.
 01 WS-OTHER-NAME          PIC X(16).
 01 WS-OTHER-LENGTH        BINARY-LONG.
 01 WS-OTHER-UUID          PIC X(16).
 PROCEDURE DIVISION.
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 3
         CALL "LOGIN-OFFLINE-UUID" USING WS-NAME(WS-I) WS-LENGTH(WS-I) WS-UUID(WS-I)
     END-PERFORM
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY

     MOVE "test access dat a new world seeds the enforcement flag: dedicated server with the "
         & "allow-list setting on 1, off 0; host kind 1 with the setting on 0; lists empty"
         TO TL-CASE
     MOVE SPACES TO WS-OBSERVED
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     MOVE 1 TO CS-ALLOW-LIST-ENFORCED
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     MOVE AC-ENFORCED TO WS-EDIT PERFORM ADD-EDIT
     MOVE 0 TO CS-ALLOW-LIST-ENFORCED
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     MOVE AC-ENFORCED TO WS-EDIT PERFORM ADD-EDIT
     MOVE 1 TO CS-ALLOW-LIST-ENFORCED CS-HOST-KIND
     MOVE "Alice" TO CS-HOST-NAME
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     MOVE AC-ENFORCED TO WS-EDIT PERFORM ADD-EDIT
     COMPUTE WS-EDIT = AC-COUNT(1) + AC-COUNT(2) + AC-COUNT(3) PERFORM ADD-EDIT
     MOVE "1 0 0 0" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test access dat add, add again (already listed), find, remove, remove again (not "
         & "listed)" TO TL-CASE
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     MOVE 1 TO CS-ALLOW-LIST-ENFORCED
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     MOVE SPACES TO WS-OBSERVED
     MOVE ACCESS-OPERATORS TO WS-LIST
     MOVE 1 TO WS-I PERFORM ADD-ONE
     MOVE 1 TO WS-I PERFORM ADD-ONE
     MOVE ACCESS-BANS TO WS-LIST
     MOVE 2 TO WS-I PERFORM ADD-ONE
     MOVE ACCESS-ALLOW TO WS-LIST
     MOVE 3 TO WS-I PERFORM ADD-ONE
     MOVE 1 TO WS-I PERFORM ADD-ONE
     CALL "ACCESS-FIND" USING WS-LIST WS-UUID(1) WS-ROW
     MOVE WS-ROW TO WS-EDIT PERFORM ADD-EDIT
     CALL "ACCESS-FIND" USING WS-LIST WS-UUID(2) WS-ROW
     MOVE WS-ROW TO WS-EDIT PERFORM ADD-EDIT
     CALL "ACCESS-REMOVE" USING WS-LIST WS-UUID(3) WS-OUTCOME
     MOVE WS-OUTCOME TO WS-EDIT PERFORM ADD-EDIT
     CALL "ACCESS-REMOVE" USING WS-LIST WS-UUID(3) WS-OUTCOME
     MOVE WS-OUTCOME TO WS-EDIT PERFORM ADD-EDIT
     CALL "ACCESS-FIND" USING WS-LIST WS-UUID(1) WS-ROW
     MOVE WS-ROW TO WS-EDIT PERFORM ADD-EDIT
     MOVE "0 1 0 0 0 2 0 0 1 1" TO TL-EXPECTED
     PERFORM CHECK

     CALL "ACCESS-DAT-WRITE"
     CALL "TEST-NBT-FILE" USING WS-FILE PB-BUFFER WS-ROOT
     MOVE "test access dat keys: DataVersion 5023, Operators [Alice], Bans [Bob], AllowList "
         & "[Alice], AllowListEnforced 1; UUIDs as 4 Ints, most significant first" TO TL-CASE
     MOVE SPACES TO WS-OBSERVED
     MOVE "DataVersion" TO WS-PATH PERFORM ADD-GET
     MOVE "Operators" TO WS-PATH PERFORM ADD-GET
     MOVE "Bans" TO WS-PATH PERFORM ADD-GET
     MOVE "AllowList" TO WS-PATH PERFORM ADD-GET
     MOVE "AllowListEnforced" TO WS-PATH PERFORM ADD-GET
     MOVE SPACES TO WS-EXPECTED
     MOVE 1 TO WS-I PERFORM IDENTITY-TEXT
     STRING "5023 [" FUNCTION TRIM(WS-TEXT) "]" DELIMITED BY SIZE INTO WS-EXPECTED
     MOVE 2 TO WS-I PERFORM IDENTITY-TEXT
     STRING FUNCTION TRIM(WS-EXPECTED) " [" FUNCTION TRIM(WS-TEXT) "]" DELIMITED BY SIZE
         INTO WS-EXPECTED
     MOVE 1 TO WS-I PERFORM IDENTITY-TEXT
     STRING FUNCTION TRIM(WS-EXPECTED) " [" FUNCTION TRIM(WS-TEXT) "] 1" DELIMITED BY SIZE
         INTO WS-EXPECTED
     MOVE WS-EXPECTED TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test access dat read back restores the three lists and the flag" TO TL-CASE
     INITIALIZE CORE-ACCESS
     CALL "ACCESS-DAT-READ"
     MOVE SPACES TO WS-OBSERVED
     PERFORM DESCRIBE-LISTS
     MOVE "1 ops Alice bans Bob allow Alice" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test access dat an existing world keeps its stored flag: saved with 1, reopened with the "
         & "allow-list setting off, still 1; saved with 0, reopened with it on, still 0" TO TL-CASE
     MOVE SPACES TO WS-OBSERVED
     CALL "CORE-SAVE"
     MOVE 0 TO CS-ALLOW-LIST-ENFORCED
     CALL "CORE-WORLD-OPEN" USING WS-WORLD CORE-SETTINGS WS-CREATED
     MOVE WS-CREATED TO WS-EDIT PERFORM ADD-EDIT
     MOVE AC-ENFORCED TO WS-EDIT PERFORM ADD-EDIT
     MOVE 0 TO AC-ENFORCED
     CALL "CORE-SAVE"
     MOVE 1 TO CS-ALLOW-LIST-ENFORCED
     CALL "CORE-WORLD-OPEN" USING WS-WORLD CORE-SETTINGS WS-CREATED
     MOVE AC-ENFORCED TO WS-EDIT PERFORM ADD-EDIT
     PERFORM DESCRIBE-LISTS
     MOVE "0 1 0 0 ops Alice bans Bob allow Alice" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test access dat a full list (256 identities) refuses another (outcome 2)" TO TL-CASE
     MOVE ACCESS-BANS TO WS-LIST
     PERFORM VARYING WS-K FROM AC-COUNT(ACCESS-BANS) BY 1 UNTIL WS-K >= CORE-MAX-ACCESS
         MOVE WS-K TO WS-EDIT
         MOVE SPACES TO WS-OTHER-NAME
         STRING "P" FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO WS-OTHER-NAME
         MOVE FUNCTION LENGTH(FUNCTION TRIM(WS-OTHER-NAME)) TO WS-OTHER-LENGTH
         CALL "LOGIN-OFFLINE-UUID" USING WS-OTHER-NAME WS-OTHER-LENGTH WS-OTHER-UUID
         CALL "ACCESS-ADD" USING WS-LIST WS-OTHER-NAME WS-OTHER-LENGTH WS-OTHER-UUID WS-OUTCOME
     END-PERFORM
     MOVE 3 TO WS-I
     CALL "ACCESS-ADD" USING WS-LIST WS-NAME(WS-I) WS-LENGTH(WS-I) WS-UUID(WS-I) WS-OUTCOME
     MOVE "N" TO TL-MODE
     MOVE 2256 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-OUTCOME * 1000 + AC-COUNT(ACCESS-BANS)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 ADD-ONE.
     CALL "ACCESS-ADD" USING WS-LIST WS-NAME(WS-I) WS-LENGTH(WS-I) WS-UUID(WS-I) WS-OUTCOME
     MOVE WS-OUTCOME TO WS-EDIT
     PERFORM ADD-EDIT.

*> "{Name:<name>,UUID:I[a,b,c,d]}" of identity WS-I in WS-TEXT, the Ints computed from the UUID
*> bytes here (big-endian, signed).
 IDENTITY-TEXT.
     MOVE SPACES TO WS-TEXT
     STRING "{Name:" WS-NAME(WS-I)(1:WS-LENGTH(WS-I)) ",UUID:I[" DELIMITED BY SIZE INTO WS-TEXT
     PERFORM VARYING WS-K FROM 0 BY 1 UNTIL WS-K > 3
         MOVE 0 TO WS-VALUE
         PERFORM VARYING WS-ROW FROM 1 BY 1 UNTIL WS-ROW > 4
             COMPUTE WS-VALUE = WS-VALUE * 256
                 + FUNCTION ORD(WS-UUID(WS-I)(WS-K * 4 + WS-ROW:1)) - 1
         END-PERFORM
         IF WS-VALUE >= 2147483648
             SUBTRACT 4294967296 FROM WS-VALUE
         END-IF
         MOVE WS-VALUE TO WS-EDIT
         IF WS-K < 3
             STRING FUNCTION TRIM(WS-TEXT) FUNCTION TRIM(WS-EDIT) "," DELIMITED BY SIZE
                 INTO WS-TEXT
         ELSE
             STRING FUNCTION TRIM(WS-TEXT) FUNCTION TRIM(WS-EDIT) "]}" DELIMITED BY SIZE
                 INTO WS-TEXT
         END-IF
     END-PERFORM.

 DESCRIBE-LISTS.
     MOVE AC-ENFORCED TO WS-EDIT
     PERFORM ADD-EDIT
     STRING FUNCTION TRIM(WS-OBSERVED) " ops" DELIMITED BY SIZE INTO WS-OBSERVED
     MOVE ACCESS-OPERATORS TO WS-LIST PERFORM ADD-NAMES
     STRING FUNCTION TRIM(WS-OBSERVED) " bans" DELIMITED BY SIZE INTO WS-OBSERVED
     MOVE ACCESS-BANS TO WS-LIST PERFORM ADD-NAMES
     STRING FUNCTION TRIM(WS-OBSERVED) " allow" DELIMITED BY SIZE INTO WS-OBSERVED
     MOVE ACCESS-ALLOW TO WS-LIST PERFORM ADD-NAMES.

*> The names of list WS-LIST, each checked against its offline UUID.
 ADD-NAMES.
     PERFORM VARYING WS-ROW FROM 1 BY 1 UNTIL WS-ROW > AC-COUNT(WS-LIST)
         MOVE AC-NAME(WS-LIST, WS-ROW) TO WS-OTHER-NAME
         MOVE AC-NAME-LENGTH(WS-LIST, WS-ROW) TO WS-OTHER-LENGTH
         CALL "LOGIN-OFFLINE-UUID" USING WS-OTHER-NAME WS-OTHER-LENGTH WS-OTHER-UUID
         IF WS-OTHER-UUID = AC-UUID(WS-LIST, WS-ROW)
             STRING FUNCTION TRIM(WS-OBSERVED) " " WS-OTHER-NAME(1:WS-OTHER-LENGTH)
                 DELIMITED BY SIZE INTO WS-OBSERVED
         ELSE
             STRING FUNCTION TRIM(WS-OBSERVED) " bad-uuid" DELIMITED BY SIZE INTO WS-OBSERVED
         END-IF
     END-PERFORM.

 ADD-EDIT.
     STRING FUNCTION TRIM(WS-OBSERVED) " " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE
         INTO WS-OBSERVED.

 ADD-GET.
     CALL "TEST-NBT-GET" USING PB-BUFFER WS-ROOT WS-PATH WS-TEXT
     STRING FUNCTION TRIM(WS-OBSERVED) " " FUNCTION TRIM(WS-TEXT) DELIMITED BY SIZE
         INTO WS-OBSERVED.

 CHECK.
     MOVE "T" TO TL-MODE
     MOVE FUNCTION TRIM(WS-OBSERVED) TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-ACCESS-DAT.

 COPY CORETEST.
