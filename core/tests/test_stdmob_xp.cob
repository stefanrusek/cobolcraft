*> Implementation test (002-lane-mobs2, T4101; docs/protocol/18 section 7.5 dropExperience, 19 section 2.1 (Animal 1 to 3), 20 section 3.1 (Monster 5),
*> 18 section 7.6 looting): a standard mob that a player kills gives experience orbs at its position (an animal 1 to 3 points, a zombie or
*> spider 5), one nobody killed gives none; the looting level of the killer's held item reaches the loot table (enchanted_count_increase).
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-STDMOB-XP.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY COREAPI.
 COPY CONTENT.
 COPY PROTO.
 01 WS-CAPACITY            BINARY-LONG VALUE 65536.
 01 WS-NAME                PIC X(16) VALUE "Stefan".
 01 WS-NAME-LENGTH         BINARY-LONG VALUE 6.
 01 WS-CONN                BINARY-LONG.
 01 WS-PLAYER              BINARY-LONG.
 01 WS-DIM                 BINARY-LONG.
 01 WS-STATUS              BINARY-LONG.
 01 WS-KEY                 PIC X(112).
 01 WS-ENTITY-ROW          PIC X(66).
 01 WS-ITEM-ROW            PIC X(270).
 01 WS-LOOT-DIR            PIC X(1100) VALUE "core/tests/fixtures/xp-loot".
 01 WS-REG-DIR             PIC X(1100) VALUE "core/tests/fixtures/mobs2-registry".
 01 WS-ORB-TYPE            BINARY-LONG.
 01 WS-PIG-TYPE            BINARY-LONG.
 01 WS-ZOMBIE-TYPE         BINARY-LONG.
 01 WS-SPIDER-TYPE         BINARY-LONG.
 01 WS-FLESH               BINARY-LONG.
 01 WS-SWORD               BINARY-LONG.
 01 WS-MOB                 BINARY-LONG.
 01 WS-X                   FLOAT-LONG.
 01 WS-Y                   FLOAT-LONG.
 01 WS-Z                   FLOAT-LONG.
 01 WS-YAW                 FLOAT-SHORT VALUE 0.
 01 WS-AMOUNT              BINARY-LONG VALUE 100.
 01 WS-CAUSE               BINARY-LONG VALUE 1.
 01 WS-NO-PLAYER           BINARY-LONG VALUE 0.
 01 WS-I                   BINARY-LONG.
 01 WS-SUM                 BINARY-LONG.
 01 WS-COUNT               BINARY-LONG.
 01 WS-HANDLE              BINARY-LONG.
 01 WS-ENCH                BINARY-LONG.
 01 WS-LEVEL               BINARY-LONG VALUE 3.
 01 WS-HELD-SLOT           BINARY-LONG.
 PROCEDURE DIVISION.
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     MOVE 2 TO CS-VIEW-DISTANCE
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     CALL "TEST-STANDARD-TABLES"
     CALL "REGISTRY-LOAD-ALL" USING WS-REG-DIR WS-STATUS
     CALL "LOOT-LOAD" USING WS-LOOT-DIR WS-STATUS
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     CALL "TEST-JOIN" USING WS-NAME WS-NAME-LENGTH WS-CONN
     MOVE CN-PLAYER(WS-CONN) TO WS-PLAYER
     MOVE PL-DIM(WS-PLAYER) TO WS-DIM
     MOVE "minecraft:experience_orb" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-ORB-TYPE WS-ENTITY-ROW WS-STATUS
     MOVE "minecraft:pig" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-PIG-TYPE WS-ENTITY-ROW WS-STATUS
     MOVE "minecraft:zombie" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-ZOMBIE-TYPE WS-ENTITY-ROW WS-STATUS
     MOVE "minecraft:spider" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-SPIDER-TYPE WS-ENTITY-ROW WS-STATUS
     MOVE "minecraft:rotten_flesh" TO WS-KEY
     CALL "CONTENT-ITEM-BY-KEY" USING WS-KEY WS-FLESH WS-ITEM-ROW WS-STATUS
     MOVE "minecraft:iron_sword" TO WS-KEY
     CALL "CONTENT-ITEM-BY-KEY" USING WS-KEY WS-SWORD WS-ITEM-ROW WS-STATUS
     COMPUTE WS-X = PL-X(WS-PLAYER) + 3
     MOVE PL-Y(WS-PLAYER) TO WS-Y
     MOVE PL-Z(WS-PLAYER) TO WS-Z
     MOVE "N" TO TL-MODE

*>   A pig killed by a player: 1 to 3 points; killed by nobody: none.
     CALL "MOB-SPAWN" USING WS-DIM WS-PIG-TYPE WS-X WS-Y WS-Z WS-YAW WS-MOB
     CALL "HEALTH-MOB-DAMAGE" USING WS-MOB WS-AMOUNT WS-CAUSE WS-NO-PLAYER
     PERFORM ORB-SUM
     MOVE "test stdmob xp: a pig that no player killed gives no experience" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-SUM TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "MOB-SPAWN" USING WS-DIM WS-PIG-TYPE WS-X WS-Y WS-Z WS-YAW WS-MOB
     CALL "HEALTH-MOB-DAMAGE" USING WS-MOB WS-AMOUNT WS-CAUSE WS-PLAYER
     PERFORM ORB-SUM
     MOVE "test stdmob xp: a pig killed by a player gives 1 to 3 points" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF WS-SUM >= 1 AND WS-SUM <= 3
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     PERFORM CLEAR-ORBS

*>   A zombie and a spider give 5 points.
     CALL "MOB-SPAWN" USING WS-DIM WS-ZOMBIE-TYPE WS-X WS-Y WS-Z WS-YAW WS-MOB
     CALL "HEALTH-MOB-DAMAGE" USING WS-MOB WS-AMOUNT WS-CAUSE WS-PLAYER
     PERFORM ORB-SUM
     MOVE "test stdmob xp: a zombie killed by a player gives 5 points" TO TL-CASE
     MOVE 5 TO TL-EXPECTED-N
     MOVE WS-SUM TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     PERFORM CLEAR-ORBS
     CALL "MOB-SPAWN" USING WS-DIM WS-SPIDER-TYPE WS-X WS-Y WS-Z WS-YAW WS-MOB
     CALL "HEALTH-MOB-DAMAGE" USING WS-MOB WS-AMOUNT WS-CAUSE WS-PLAYER
     PERFORM ORB-SUM
     MOVE "test stdmob xp: a spider killed by a player gives 5 points" TO TL-CASE
     MOVE 5 TO TL-EXPECTED-N
     MOVE WS-SUM TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     PERFORM CLEAR-ORBS
     PERFORM CLEAR-FLESH

*>   Looting: no enchantment gives the base 1 rotten flesh, looting 3 on the held item gives 1 + 3.
     CALL "MOB-SPAWN" USING WS-DIM WS-ZOMBIE-TYPE WS-X WS-Y WS-Z WS-YAW WS-MOB
     CALL "HEALTH-MOB-DAMAGE" USING WS-MOB WS-AMOUNT WS-CAUSE WS-PLAYER
     PERFORM FLESH-SUM
     MOVE "test stdmob xp: a zombie killed with a plain weapon drops 1 rotten flesh" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE WS-COUNT TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     PERFORM CLEAR-FLESH
     COMPUTE WS-HELD-SLOT = PL-HELD(WS-PLAYER) + 1
     MOVE WS-SWORD TO PL-SLOT-ITEM(WS-PLAYER, WS-HELD-SLOT)
     MOVE 1 TO PL-SLOT-COUNT(WS-PLAYER, WS-HELD-SLOT)
     MOVE 0 TO WS-HANDLE
     MOVE "minecraft:looting" TO WS-KEY
     CALL "LOOT-ENCH-ID" USING WS-KEY WS-ENCH
     CALL "SP-ADD-ENCHANT" USING WS-HANDLE WS-ENCH WS-LEVEL
     MOVE WS-HANDLE TO PL-SLOT-VAR(WS-PLAYER, WS-HELD-SLOT)
     CALL "MOB-SPAWN" USING WS-DIM WS-ZOMBIE-TYPE WS-X WS-Y WS-Z WS-YAW WS-MOB
     CALL "HEALTH-MOB-DAMAGE" USING WS-MOB WS-AMOUNT WS-CAUSE WS-PLAYER
     PERFORM FLESH-SUM
     MOVE "test stdmob xp: looting 3 on the held weapon adds 3 rotten flesh" TO TL-CASE
     MOVE 4 TO TL-EXPECTED-N
     MOVE WS-COUNT TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "PB-FREE" USING PB-BUFFER
     STOP RUN.
 ORB-SUM.
     MOVE 0 TO WS-SUM
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > EN-COUNT
         IF EN-USED(WS-I) = 1 AND EN-TYPE(WS-I) = WS-ORB-TYPE
             COMPUTE WS-SUM = WS-SUM + EN-ITEM(WS-I) * EN-ITEM-COUNT(WS-I)
         END-IF
     END-PERFORM.
 CLEAR-ORBS.
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > EN-COUNT
         IF EN-USED(WS-I) = 1 AND EN-TYPE(WS-I) = WS-ORB-TYPE
             CALL "ENTITY-REMOVE" USING WS-I
         END-IF
     END-PERFORM.
 FLESH-SUM.
     MOVE 0 TO WS-COUNT
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > EN-COUNT
         IF EN-USED(WS-I) = 1 AND EN-ITEM(WS-I) = WS-FLESH AND EN-TYPE(WS-I) NOT = WS-ORB-TYPE
             ADD EN-ITEM-COUNT(WS-I) TO WS-COUNT
         END-IF
     END-PERFORM.
 CLEAR-FLESH.
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > EN-COUNT
         IF EN-USED(WS-I) = 1 AND EN-ITEM(WS-I) = WS-FLESH AND EN-TYPE(WS-I) NOT = WS-ORB-TYPE AND EN-ITEM-COUNT(WS-I) > 0
             CALL "ENTITY-REMOVE" USING WS-I
         END-IF
     END-PERFORM.
 END PROGRAM TEST-STDMOB-XP.
 COPY CORETEST.
