*> Test of 31-2 section 10 (Chiseled bookshelf; T0885): slots, saved keys (Items always, last_interacted_slot), the hit slot of a click on the face and the analog output. The block's occupancy properties and the use of the block are in acc_us12_bookshelf.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-BE-31-2-10.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY BESTATE.
 COPY PROTO.
 COPY COREAPI.
 COPY CITEMS.
 01 WS-TEXT                PIC X(8192).
 01 WS-OUT                 PIC X(8192).
 01 WS-EDIT                PIC -(9)9.
 01 WS-EDIT2               PIC -(9)9.
 01 WS-EDIT3               PIC -(9)9.
 01 WS-I                   BINARY-LONG.
 01 WS-K                   BINARY-LONG.
 01 WS-LEN                 BINARY-LONG.
 01 WS-IDX                 BINARY-LONG.
 01 WS-PTR                 BINARY-LONG.
 01 WS-CAPACITY            BINARY-LONG VALUE 4096.
 01 WS-TYPE10              BINARY-LONG VALUE 10.
 01 WS-FORM                BINARY-LONG VALUE 2.
 01 WS-D                   BINARY-LONG VALUE 1.
 01 WS-X                   BINARY-LONG VALUE 5.
 01 WS-Y                   BINARY-LONG VALUE 70.
 01 WS-Z                   BINARY-LONG VALUE 5.
 01 WS-T                   BINARY-LONG.
 01 WS-KEY                 PIC X(48).
 01 WS-KEY24               PIC X(24).
 01 WS-KEY32               PIC X(32).
 01 WS-NAME                PIC X(32).
 01 WS-ITEM                BINARY-LONG.
 01 WS-COUNT               BINARY-LONG.
 01 WS-VAR                 BINARY-LONG.
 01 WS-A                   BINARY-LONG.
 01 WS-B                   BINARY-LONG.
 01 WS-C                   BINARY-LONG.
 01 WS-HOPPER              BINARY-LONG.
 01 WS-DISPENSER           BINARY-LONG.
 01 WS-DROPPER             BINARY-LONG.
 01 WS-SRC                BINARY-LONG.
 01 WS-FLAG                BINARY-LONG.
 01 WS-SHELF               BINARY-LONG.
 01 WS-COMP                BINARY-LONG.
 01 WS-FL1                 FLOAT-LONG.
 01 WS-FL2                 FLOAT-LONG.
 01 WS-FL3                 FLOAT-LONG.
 PROCEDURE DIVISION.
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     MOVE "minecraft:hopper" TO WS-KEY
     MOVE 16 TO WS-LEN
     MOVE 18 TO WS-T
     CALL "BE-CREATE" USING WS-D WS-X WS-Y WS-Z WS-T WS-KEY WS-LEN WS-HOPPER
     ADD 1 TO WS-X
     MOVE "minecraft:dispenser" TO WS-KEY
     MOVE 19 TO WS-LEN
     MOVE 5 TO WS-T
     CALL "BE-CREATE" USING WS-D WS-X WS-Y WS-Z WS-T WS-KEY WS-LEN WS-DISPENSER
     ADD 1 TO WS-X
     MOVE "minecraft:dropper" TO WS-KEY
     MOVE 17 TO WS-LEN
     MOVE 6 TO WS-T
     CALL "BE-CREATE" USING WS-D WS-X WS-Y WS-Z WS-T WS-KEY WS-LEN WS-DROPPER
     MOVE "T" TO TL-MODE
     MOVE "minecraft:comparator" TO WS-KEY
     MOVE 20 TO WS-LEN
     MOVE 19 TO WS-T
     ADD 1 TO WS-X
     CALL "BE-CREATE" USING WS-D WS-X WS-Y WS-Z WS-T WS-KEY WS-LEN WS-COMP
     MOVE "minecraft:chiseled_bookshelf" TO WS-KEY
     MOVE 28 TO WS-LEN
     MOVE 38 TO WS-T
     ADD 1 TO WS-X
     CALL "BE-CREATE" USING WS-D WS-X WS-Y WS-Z WS-T WS-KEY WS-LEN WS-SHELF
     MOVE "minecraft:comparator" TO WS-KEY
     MOVE 20 TO WS-LEN
     MOVE 19 TO WS-T
     ADD 1 TO WS-X
     CALL "BE-CREATE" USING WS-D WS-X WS-Y WS-Z WS-T WS-KEY WS-LEN WS-SRC
     MOVE "acceptance US12 31-2§10 Chiseled bookshelf: size 6, a fresh shelf writes Items (empty) and last_interacted_slot -1; max stack 1" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     MOVE WS-SHELF TO WS-IDX
     PERFORM SAVE-RENDER
     MOVE 38 TO WS-T
     CALL "BE-CONTAINER-SIZE" USING WS-T WS-A
     CALL "BE2-SHELF-MAX" USING WS-B
     MOVE WS-A TO WS-EDIT
     MOVE WS-B TO WS-EDIT2
     STRING "size " FUNCTION TRIM(WS-EDIT) " max " FUNCTION TRIM(WS-EDIT2) DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE "{Items:[],last_interacted_slot:-1} size 6 max 1" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 31-2§10 Chiseled bookshelf: a book in slot 3 and the last interacted slot 3 are saved, and read back; a slot above 5 is ignored" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     MOVE 2 TO BE-SLOT-ITEM(WS-SHELF, 4)
     MOVE 1 TO BE-SLOT-COUNT(WS-SHELF, 4)
     MOVE 3 TO BE-COOLDOWN(WS-SHELF)
     MOVE WS-SHELF TO WS-IDX
     PERFORM SAVE-RENDER
     MOVE SPACES TO WS-KEY
     MOVE IT-KEY(3) TO WS-KEY
     MOVE 2 TO BE-SLOT-ITEM(WS-SHELF, 7)
     MOVE 1 TO BE-SLOT-COUNT(WS-SHELF, 7)
     MOVE SPACES TO TL-EXPECTED
     STRING "{Items:[{Slot:3,id:" FUNCTION TRIM(WS-KEY) ",count:1}],last_interacted_slot:3} " DELIMITED BY SIZE INTO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 31-2§10 Chiseled bookshelf: the hit slot is column + 3 row from the point on the face (north: u = 1 - x): (0.9, 0.9) is slot 0, (0.1, 0.1) is slot 5, (0.5, 0.5) slot 4, another face gives none" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     MOVE 0.9 TO WS-FL1
     MOVE 0.9 TO WS-FL2
     MOVE 0.5 TO WS-FL3
     MOVE 2 TO WS-A
     MOVE 0 TO WS-B
     CALL "BE2-SHELF-SLOT" USING WS-A WS-B WS-FL1 WS-FL2 WS-FL3 WS-C
     MOVE WS-C TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) " " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 0.1 TO WS-FL1
     MOVE 0.1 TO WS-FL2
     CALL "BE2-SHELF-SLOT" USING WS-A WS-B WS-FL1 WS-FL2 WS-FL3 WS-C
     MOVE WS-C TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) " " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 0.5 TO WS-FL1
     MOVE 0.5 TO WS-FL2
     CALL "BE2-SHELF-SLOT" USING WS-A WS-B WS-FL1 WS-FL2 WS-FL3 WS-C
     MOVE WS-C TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) " " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 3 TO WS-A
     CALL "BE2-SHELF-SLOT" USING WS-A WS-B WS-FL1 WS-FL2 WS-FL3 WS-C
     MOVE WS-C TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE "0 5 4 -1" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 31-2§10 Chiseled bookshelf: the other faces: south u = x, west u = z, east u = 1 - z, top and bottom none" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     MOVE 0.9 TO WS-FL1
     MOVE 0.9 TO WS-FL2
     MOVE 0.2 TO WS-FL3
     MOVE 3 TO WS-A
     MOVE 2 TO WS-B
     CALL "BE2-SHELF-SLOT" USING WS-A WS-B WS-FL1 WS-FL2 WS-FL3 WS-C
     MOVE WS-C TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) " " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 4 TO WS-A
     MOVE 3 TO WS-B
     CALL "BE2-SHELF-SLOT" USING WS-A WS-B WS-FL1 WS-FL2 WS-FL3 WS-C
     MOVE WS-C TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) " " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 5 TO WS-A
     MOVE 1 TO WS-B
     CALL "BE2-SHELF-SLOT" USING WS-A WS-B WS-FL1 WS-FL2 WS-FL3 WS-C
     MOVE WS-C TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) " " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 1 TO WS-A
     CALL "BE2-SHELF-SLOT" USING WS-A WS-B WS-FL1 WS-FL2 WS-FL3 WS-C
     MOVE WS-C TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE "2 0 2 -1" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 31-2§10 Chiseled bookshelf: the analog output is lastInteractedSlot + 1 (0 untouched, 6 for slot 5)" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     MOVE -1 TO BE-COOLDOWN(WS-SHELF)
     CALL "BE2-SHELF-SIGNAL" USING WS-SHELF WS-A
     MOVE WS-A TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) " " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 5 TO BE-COOLDOWN(WS-SHELF)
     CALL "BE2-SHELF-SIGNAL" USING WS-SHELF WS-A
     MOVE WS-A TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE "0 6" TO TL-EXPECTED
     PERFORM CHECK

     GOBACK.

 CHECK.
     MOVE WS-TEXT TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 ROUNDTRIP.
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     CALL "BE-SAVE" USING WS-SRC WS-FORM PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE 0 TO PB-POS
     CALL "BE-LOAD" USING WS-IDX PB-BUFFER
     CALL "PB-FREE" USING PB-BUFFER.

*> Saves entity WS-IDX in form WS-FORM and appends the rendered compound to WS-TEXT.
 SAVE-RENDER.
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     CALL "BE-SAVE" USING WS-IDX WS-FORM PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE 0 TO PB-POS
     MOVE 0 TO WS-LEN
     MOVE SPACES TO WS-OUT
     CALL "TEST-NBT-RENDER" USING PB-BUFFER WS-TYPE10 WS-OUT WS-LEN
     CALL "PB-FREE" USING PB-BUFFER
     STRING WS-OUT(1:WS-LEN) " " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR.
 END PROGRAM TEST-BE-31-2-10.

 COPY CORETEST.
