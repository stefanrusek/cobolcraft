*> Test of 40-1 section 8 (The shulker box; T1003): 63 slots, positions, image 176 x 167 with label y 73, the quick-move ranges, and ShulkerBoxSlot.mayPlace refusing shulker boxes in the box slots only.)
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-MENU-40-1-8.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY BESTATE.
 COPY PROTO.
 01 WS-TEXT                PIC X(8192).
 01 WS-EDIT                PIC -(9)9.
 01 WS-EDIT2               PIC -(9)9.
 01 WS-EDIT3               PIC -(9)9.
 01 WS-EDIT4               PIC -(9)9.
 01 WS-I                   BINARY-LONG.
 01 WS-LEN                 BINARY-LONG.
 01 WS-IDX                 BINARY-LONG.
 01 WS-CAPACITY            BINARY-LONG VALUE 4096.
 01 WS-ZERO                BINARY-LONG VALUE 0.
 01 WS-TYPE10              BINARY-LONG VALUE 10.
 01 WS-E1 PIC -(9)9.
 01 WS-E2 PIC -(9)9.
 01 WS-E3 PIC -(9)9.
 01 WS-E4 PIC -(9)9.
 01 WS-E5 PIC -(9)9.
 01 WS-E6 PIC -(9)9.
 01 WS-E7 PIC -(9)9.
 01 WS-E8 PIC -(9)9.
 01 WS-E9 PIC -(9)9.
 01 WS-E10 PIC -(9)9.
 01 WS-E11 PIC -(9)9.
 01 WS-E12 PIC -(9)9.
 01 WS-A BINARY-LONG.
 01 WS-B BINARY-LONG.
 01 WS-C BINARY-LONG.
 01 WS-D BINARY-LONG.
 01 WS-F BINARY-LONG.
 01 WS-G BINARY-LONG.
 01 WS-H BINARY-LONG.
 01 WS-J BINARY-LONG.
 01 WS-K BINARY-LONG.
 01 WS-K32 PIC X(32).
 01 WS-KEY2 PIC X(32).
 01 WS-L BINARY-LONG.
 01 WS-PTR BINARY-LONG.
 PROCEDURE DIVISION.
     MOVE "acceptance US12 40-1§8 shulker: slot 0 is container 0 at (8, 18), slot 26 container 26 at (152, 54), slot 27 player 9 at (8, 84), slot 54 player 0 at (8, 142)" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     MOVE 2 TO WS-A
     MOVE 0 TO WS-B
     MOVE 0 TO WS-C
     CALL "MENU-LAYOUT" USING WS-A WS-B WS-C WS-D WS-F WS-G WS-H
     MOVE WS-D TO WS-E1
     MOVE WS-F TO WS-E2
     MOVE WS-G TO WS-E3
     MOVE WS-H TO WS-E4
     STRING FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) " " FUNCTION TRIM(WS-E3) " " FUNCTION TRIM(WS-E4) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 2 TO WS-A
     MOVE 0 TO WS-B
     MOVE 26 TO WS-C
     CALL "MENU-LAYOUT" USING WS-A WS-B WS-C WS-D WS-F WS-G WS-H
     MOVE WS-D TO WS-E1
     MOVE WS-F TO WS-E2
     MOVE WS-G TO WS-E3
     MOVE WS-H TO WS-E4
     STRING FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) " " FUNCTION TRIM(WS-E3) " " FUNCTION TRIM(WS-E4) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 2 TO WS-A
     MOVE 0 TO WS-B
     MOVE 27 TO WS-C
     CALL "MENU-LAYOUT" USING WS-A WS-B WS-C WS-D WS-F WS-G WS-H
     MOVE WS-D TO WS-E1
     MOVE WS-F TO WS-E2
     MOVE WS-G TO WS-E3
     MOVE WS-H TO WS-E4
     STRING FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) " " FUNCTION TRIM(WS-E3) " " FUNCTION TRIM(WS-E4) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 2 TO WS-A
     MOVE 0 TO WS-B
     MOVE 54 TO WS-C
     CALL "MENU-LAYOUT" USING WS-A WS-B WS-C WS-D WS-F WS-G WS-H
     MOVE WS-D TO WS-E1
     MOVE WS-F TO WS-E2
     MOVE WS-G TO WS-E3
     MOVE WS-H TO WS-E4
     STRING FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) " " FUNCTION TRIM(WS-E3) " " FUNCTION TRIM(WS-E4) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE '1 0 8 18 | 1 26 152 54 | 2 9 8 84 | 2 0 8 142 |' TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 40-1§8 shulker: image 176 x 167, label y 73; quick-move [27, 63) reversed from a box slot, [0, 27) forward from a player slot" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     MOVE 2 TO WS-A
     MOVE 0 TO WS-B
     CALL "MENU-IMAGE" USING WS-A WS-B WS-D WS-F WS-G
     MOVE WS-D TO WS-E1
     MOVE WS-F TO WS-E2
     MOVE WS-G TO WS-E3
     STRING FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) " " FUNCTION TRIM(WS-E3) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 2 TO WS-A
     MOVE 0 TO WS-B
     MOVE 5 TO WS-C
     CALL "MENU-QUICK-RANGE" USING WS-A WS-B WS-C WS-D WS-F WS-G WS-H
     MOVE WS-D TO WS-E1
     MOVE WS-F TO WS-E2
     MOVE WS-G TO WS-E3
     MOVE WS-H TO WS-E4
     STRING FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) " " FUNCTION TRIM(WS-E3) " " FUNCTION TRIM(WS-E4) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 2 TO WS-A
     MOVE 0 TO WS-B
     MOVE 40 TO WS-C
     CALL "MENU-QUICK-RANGE" USING WS-A WS-B WS-C WS-D WS-F WS-G WS-H
     MOVE WS-D TO WS-E1
     MOVE WS-F TO WS-E2
     MOVE WS-G TO WS-E3
     MOVE WS-H TO WS-E4
     STRING FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) " " FUNCTION TRIM(WS-E3) " " FUNCTION TRIM(WS-E4) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE '176 167 73 | 27 63 1 0 | 0 27 0 0 |' TO TL-EXPECTED
     PERFORM CHECK

     MOVE "acceptance US12 40-1§8 shulker: a shulker box item is refused by the box slots (0 to 26) and accepted in the player slots; other items are accepted everywhere" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     MOVE 2 TO WS-A
     MOVE 0 TO WS-B
     MOVE 1 TO WS-C
     CALL "MENU-MAY-PLACE-K" USING WS-A WS-B WS-C WS-D
     MOVE WS-D TO WS-E1
     STRING FUNCTION TRIM(WS-E1) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 2 TO WS-A
     MOVE 26 TO WS-B
     MOVE 1 TO WS-C
     CALL "MENU-MAY-PLACE-K" USING WS-A WS-B WS-C WS-D
     MOVE WS-D TO WS-E1
     STRING FUNCTION TRIM(WS-E1) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 2 TO WS-A
     MOVE 27 TO WS-B
     MOVE 1 TO WS-C
     CALL "MENU-MAY-PLACE-K" USING WS-A WS-B WS-C WS-D
     MOVE WS-D TO WS-E1
     STRING FUNCTION TRIM(WS-E1) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE 2 TO WS-A
     MOVE 0 TO WS-B
     MOVE 0 TO WS-C
     CALL "MENU-MAY-PLACE-K" USING WS-A WS-B WS-C WS-D
     MOVE WS-D TO WS-E1
     STRING FUNCTION TRIM(WS-E1) " | " DELIMITED BY SIZE INTO WS-TEXT WITH POINTER WS-PTR
     MOVE '0 | 0 | 1 | 1 |' TO TL-EXPECTED
     PERFORM CHECK

     GOBACK.

 CHECK.
     MOVE "T" TO TL-MODE
     MOVE WS-TEXT TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-MENU-40-1-8.

 COPY CORETEST.
