     PERFORM BEGIN-CASE
     MOVE "1 1 10 64 10 0.1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-LEVER-PARTICLE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-FX6 WS-I7 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 10 64 10 0.25 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-LEVER-PARTICLE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-FX6 WS-I7 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 10 64 10 0.2499 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-LEVER-PARTICLE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-FX6 WS-I7 WS-R1 WS-R2 WS-R3 WS-R4
     MOVE 4 TO WS-N
