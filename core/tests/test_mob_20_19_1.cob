 01 WS-BIOME-TABLE REDEFINES WS-BIOMES.
    05 WS-B OCCURS 57 TIMES.
       10 WS-B-NAME         PIC X(32).
       10 WS-B-LIST         PIC 99.
 PROCEDURE DIVISION.
     MOVE "N" TO TL-MODE
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 57
         MOVE SPACES TO WS-KEY
         STRING "minecraft:" DELIMITED BY SIZE WS-B-NAME(WS-I) DELIMITED BY SPACE INTO WS-KEY
         CALL "MS6-BIOME-FIND" USING WS-KEY WS-INDEX
         MOVE WS-B-LIST(WS-I) TO WS-LIST-NO
         MOVE 0 TO WS-BAD
         MOVE 0 TO WS-MONSTERS
         IF WS-INDEX = 0
             MOVE 1 TO WS-BAD
         ELSE
             COMPUTE WS-LAST = SPB-FIRST(WS-INDEX) + SPB-COUNT(WS-INDEX)
             PERFORM VARYING WS-J FROM SPB-FIRST(WS-INDEX) BY 1 UNTIL WS-J >= WS-LAST
                 IF SPE-CAT(WS-J + 1) = 1
                     ADD 1 TO WS-MONSTERS
                 END-IF
             END-PERFORM
             IF WS-MONSTERS NOT = WS-L-COUNT(WS-LIST-NO)
                 MOVE 1 TO WS-BAD
             END-IF
             PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-L-COUNT(WS-LIST-NO)
                 MOVE 0 TO WS-FOUND
                 PERFORM VARYING WS-J FROM SPB-FIRST(WS-INDEX) BY 1 UNTIL WS-J >= WS-LAST
                     MOVE SPE-KEY(WS-J + 1) TO WS-LK
                     IF SPE-CAT(WS-J + 1) = 1 AND WS-LK = WS-L-KEY(WS-LIST-NO, WS-K)
                             AND SPE-WEIGHT(WS-J + 1) = WS-L-WEIGHT(WS-LIST-NO, WS-K)
                             AND SPE-MIN(WS-J + 1) = WS-L-MIN(WS-LIST-NO, WS-K)
                             AND SPE-MAX(WS-J + 1) = WS-L-MAX(WS-LIST-NO, WS-K)
                         ADD 1 TO WS-FOUND
                     END-IF
                 END-PERFORM
                 IF WS-FOUND = 0
                     MOVE 1 TO WS-BAD
                 END-IF
             END-PERFORM
         END-IF
         MOVE SPACES TO TL-CASE
         STRING "acceptance US15 20§19.1 monster list of " DELIMITED BY SIZE WS-B-NAME(WS-I) DELIMITED BY SPACE INTO TL-CASE
         MOVE 0 TO TL-EXPECTED-N
         MOVE WS-BAD TO TL-OBSERVED-N
         CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     END-PERFORM
     STOP RUN.
 END PROGRAM TEST-MOB-20-19-1.
 COPY CORETEST.
