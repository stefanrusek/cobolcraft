     CALL "WS-USE-BED" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 0 0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "WS-USE-BED" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 1 0 0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "WS-USE-BED" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 1 1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "WS-USE-BED" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 1 2 3 4 4 1" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 33§5 Sleeping: night skip: the clock moves only with advance_time and a default clock, everybody wakes, the weather resets only with advance_weather and rain" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1 1 1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "WS-NIGHT-SKIP" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "WS-NIGHT-SKIP" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "0 1 1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "WS-NIGHT-SKIP" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "WS-NIGHT-SKIP" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 0 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "WS-NIGHT-SKIP" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
