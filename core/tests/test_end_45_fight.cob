*> Implementation test of the saved state of the ender dragon fight (core/src/end-38f.cob; docs/protocol/45-entity-nbt-9 section 3.1 and the example of 14.2; T1743 saved-data part):
*> the default object, the write and read of the mid-respawn file of 14.2 (no dragon_uuid key), a record with a dragon uuid, a file that holds only dragon_killed (every other key at
*> its default, needs_state_scanning true), a file with a malformed exit portal, and the gateway order of a new End (0 to 19 shuffled with the Java LCG seeded with the level seed; an
*> existing list keeps its order).
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-END-45-FIGHT.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY PROTO.
 COPY ENDFIGHT.
 COPY ENDFIGHT REPLACING ==END-FIGHT== BY ==WS-B== LEADING ==EF-== BY ==RB-==.
 01 WS-CAPACITY            BINARY-LONG VALUE 4096.
 01 WS-SEED                BINARY-DOUBLE SIGNED.
 01 WN                     PIC X(32).
 01 WL                     BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-TYPE                BINARY-LONG.
 01 WS-ONE                 BINARY-LONG VALUE 1.
 01 WS-TWO-INTS.
    05 WS-TWO-INT          BINARY-LONG OCCURS 2 TIMES.
 01 WS-SUM                 BINARY-LONG.
 01 WS-ED                  PIC -(5)9.
 PROCEDURE DIVISION.
     MOVE "N" TO TL-MODE
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     CALL "END-FIGHT-DEFAULT" USING END-FIGHT
     MOVE "acceptance US12 38§12 saved fight default needs_state_scanning true" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE EF-SCAN TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 38§12 saved fight default has nothing else set" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = EF-KILLED + EF-PREVIOUS + EF-STAGE + EF-TIME + EF-HAS-UUID + EF-HAS-PORTAL + EF-GATEWAY-COUNT + EF-CRYSTAL-COUNT
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   the file of 14.2
     MOVE 0 TO EF-SCAN
     MOVE 1 TO EF-KILLED EF-PREVIOUS
     MOVE 3 TO EF-STAGE
     MOVE 120 TO EF-TIME
     MOVE 1 TO EF-HAS-PORTAL
     MOVE 0 TO EF-PORTAL(1)
     MOVE 63 TO EF-PORTAL(2)
     MOVE 0 TO EF-PORTAL(3)
     MOVE 3 TO EF-GATEWAY-COUNT
     MOVE 7 TO EF-GATEWAY(1)
     MOVE 2 TO EF-GATEWAY(2)
     MOVE 15 TO EF-GATEWAY(3)
     MOVE 2 TO EF-CRYSTAL-COUNT
     MOVE 11 TO EF-CRYSTAL-UUID(1, 1)
     MOVE 12 TO EF-CRYSTAL-UUID(1, 2)
     MOVE 13 TO EF-CRYSTAL-UUID(1, 3)
     MOVE 14 TO EF-CRYSTAL-UUID(1, 4)
     MOVE -21 TO EF-CRYSTAL-UUID(2, 1)
     MOVE -22 TO EF-CRYSTAL-UUID(2, 2)
     MOVE -23 TO EF-CRYSTAL-UUID(2, 3)
     MOVE -24 TO EF-CRYSTAL-UUID(2, 4)
     CALL "END-FIGHT-WRITE" USING PB-BUFFER END-FIGHT
     CALL "END-FIGHT-READ" USING PB-BUFFER WS-B
     PERFORM COMPARE-ALL
     MOVE "acceptance US12 38§12 saved fight mid-respawn file has no dragon_uuid" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE RB-HAS-UUID TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   with a dragon uuid and no sequence: respawn_stage is omitted and reads back as 0
     MOVE 0 TO EF-STAGE EF-TIME EF-CRYSTAL-COUNT
     MOVE 1 TO EF-HAS-UUID
     MOVE 1 TO EF-UUID(1)
     MOVE 2 TO EF-UUID(2)
     MOVE -3 TO EF-UUID(3)
     MOVE 2147483647 TO EF-UUID(4)
     CALL "END-FIGHT-WRITE" USING PB-BUFFER END-FIGHT
     CALL "END-FIGHT-READ" USING PB-BUFFER WS-B
     PERFORM COMPARE-ALL
*>   a file with only dragon_killed
     CALL "PB-RESET" USING PB-BUFFER
     MOVE SPACES TO WN
     MOVE 0 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     MOVE "data" TO WN
     MOVE 4 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     MOVE "dragon_killed" TO WN
     MOVE 13 TO WL
     CALL "NBT-WRITE-BYTE" USING PB-BUFFER WN WL WS-ONE
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "END-FIGHT-READ" USING PB-BUFFER WS-B
     MOVE "acceptance US12 38§12 saved fight only dragon_killed: killed" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE RB-KILLED TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 38§12 saved fight only dragon_killed: needs_state_scanning defaults to true" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE RB-SCAN TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 38§12 saved fight only dragon_killed: no gateways, portal or stage" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = RB-GATEWAY-COUNT + RB-HAS-PORTAL + RB-STAGE + RB-CRYSTAL-COUNT
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   a malformed exit portal (two ints) is treated as absent
     CALL "PB-RESET" USING PB-BUFFER
     MOVE SPACES TO WN
     MOVE 0 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     MOVE "data" TO WN
     MOVE 4 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     MOVE "exit_portal_location" TO WN
     MOVE 20 TO WL
     MOVE 5 TO WS-TWO-INT(1)
     MOVE 6 TO WS-TWO-INT(2)
     MOVE 2 TO WS-I
     CALL "NBT-WRITE-INT-ARRAY" USING PB-BUFFER WN WL WS-I WS-TWO-INTS
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "END-FIGHT-READ" USING PB-BUFFER WS-B
     MOVE "acceptance US12 38§12 saved fight a malformed exit portal is absent" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE RB-HAS-PORTAL TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   every respawn stage round trips, with empty gateway and crystal lists
     CALL "END-FIGHT-DEFAULT" USING END-FIGHT
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 5
         MOVE WS-I TO EF-STAGE
         CALL "END-FIGHT-WRITE" USING PB-BUFFER END-FIGHT
         CALL "END-FIGHT-READ" USING PB-BUFFER WS-B
         MOVE "acceptance US12 38§12 saved fight respawn stage round trip" TO TL-CASE
         MOVE WS-I TO TL-EXPECTED-N
         MOVE RB-STAGE TO TL-OBSERVED-N
         CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     END-PERFORM
*>   unknown keys and lists of another element type are skipped
     CALL "PB-RESET" USING PB-BUFFER
     MOVE SPACES TO WN
     MOVE 0 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     MOVE "Other" TO WN
     MOVE 5 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL WS-ONE
     MOVE "data" TO WN
     MOVE 4 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     MOVE "mystery" TO WN
     MOVE 7 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL WS-ONE
     MOVE "gateways" TO WN
     MOVE 8 TO WL
     MOVE 1 TO WS-TYPE
     MOVE 2 TO WS-I
     CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WN WL WS-TYPE WS-I
     MOVE -1 TO WL
     CALL "NBT-WRITE-BYTE" USING PB-BUFFER WN WL WS-ONE
     CALL "NBT-WRITE-BYTE" USING PB-BUFFER WN WL WS-ONE
     MOVE "respawn_crystals" TO WN
     MOVE 16 TO WL
     MOVE 3 TO WS-TYPE
     MOVE 1 TO WS-I
     CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WN WL WS-TYPE WS-I
     MOVE -1 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL WS-ONE
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "END-FIGHT-READ" USING PB-BUFFER WS-B
     MOVE "acceptance US12 38§12 saved fight unknown keys and foreign lists are skipped" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = RB-GATEWAY-COUNT + RB-CRYSTAL-COUNT + PB-ERROR
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   the gateway order of a new End
     MOVE 0 TO WS-SEED
     CALL "END-FIGHT-DEFAULT" USING END-FIGHT
     CALL "END-FIGHT-INIT" USING WS-SEED END-FIGHT
     MOVE "acceptance US12 38§12 saved fight new End holds 20 gateways" TO TL-CASE
     MOVE 20 TO TL-EXPECTED-N
     MOVE EF-GATEWAY-COUNT TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 0 TO WS-SUM
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 20
         COMPUTE WS-SUM = WS-SUM + EF-GATEWAY(WS-I) * EF-GATEWAY(WS-I)
     END-PERFORM
     MOVE "acceptance US12 38§12 saved fight seed 0 order is the Java shuffle (sum of squares 2470 for a permutation)" TO TL-CASE
     MOVE 2470 TO TL-EXPECTED-N
     MOVE WS-SUM TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 38§12 saved fight seed 0 gateway order starts 6 1 15 17 4" TO TL-CASE
     MOVE 6115174 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = EF-GATEWAY(1) * 1000000 + EF-GATEWAY(2) * 100000 + EF-GATEWAY(3) * 1000 + EF-GATEWAY(4) * 10 + EF-GATEWAY(5)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 38§12 saved fight seed 0 gateway order ends 13 5 0" TO TL-CASE
     MOVE 13050 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = EF-GATEWAY(18) * 1000 + EF-GATEWAY(19) * 10 + EF-GATEWAY(20)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 12345 TO WS-SEED
     CALL "END-FIGHT-DEFAULT" USING END-FIGHT
     CALL "END-FIGHT-INIT" USING WS-SEED END-FIGHT
     MOVE "acceptance US12 38§12 saved fight seed 12345 gateway order starts 12 5 19" TO TL-CASE
     MOVE 12005019 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = EF-GATEWAY(1) * 1000000 + EF-GATEWAY(2) * 1000 + EF-GATEWAY(3)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE -1 TO WS-SEED
     MOVE "acceptance US12 38§12 saved fight an existing list keeps its order" TO TL-CASE
     MOVE 12 TO TL-EXPECTED-N
     CALL "END-FIGHT-INIT" USING WS-SEED END-FIGHT
     MOVE EF-GATEWAY(1) TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE -1 TO WS-SEED
     CALL "END-FIGHT-DEFAULT" USING END-FIGHT
     CALL "END-FIGHT-INIT" USING WS-SEED END-FIGHT
     MOVE "acceptance US12 38§12 saved fight a negative seed still fills 20 gateways" TO TL-CASE
     MOVE 20 TO TL-EXPECTED-N
     MOVE EF-GATEWAY-COUNT TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.
 COMPARE-ALL.
     MOVE "acceptance US12 38§12 saved fight round trip: scan, killed, previous, stage, time" TO TL-CASE
     COMPUTE TL-EXPECTED-N = EF-SCAN * 100000 + EF-KILLED * 10000 + EF-PREVIOUS * 1000 + EF-STAGE * 100 + EF-TIME
     COMPUTE TL-OBSERVED-N = RB-SCAN * 100000 + RB-KILLED * 10000 + RB-PREVIOUS * 1000 + RB-STAGE * 100 + RB-TIME
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 38§12 saved fight round trip: uuid and portal" TO TL-CASE
     COMPUTE TL-EXPECTED-N = EF-HAS-UUID * 10 + EF-HAS-PORTAL + EF-UUID(1) + EF-UUID(2) + EF-UUID(3) + EF-PORTAL(1) + EF-PORTAL(2) + EF-PORTAL(3)
     COMPUTE TL-OBSERVED-N = RB-HAS-UUID * 10 + RB-HAS-PORTAL + RB-UUID(1) + RB-UUID(2) + RB-UUID(3)
         + RB-PORTAL(1) + RB-PORTAL(2) + RB-PORTAL(3)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 38§12 saved fight round trip: last uuid int" TO TL-CASE
     MOVE EF-UUID(4) TO TL-EXPECTED-N
     IF EF-HAS-UUID = 0
         MOVE 0 TO TL-EXPECTED-N
     END-IF
     MOVE RB-UUID(4) TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 38§12 saved fight round trip: gateways in pop order" TO TL-CASE
     COMPUTE TL-EXPECTED-N = EF-GATEWAY-COUNT * 10000 + EF-GATEWAY(1) * 100 + EF-GATEWAY(2) * 10 + EF-GATEWAY(3)
     COMPUTE TL-OBSERVED-N = RB-GATEWAY-COUNT * 10000 + RB-GATEWAY(1) * 100 + RB-GATEWAY(2) * 10 + RB-GATEWAY(3)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 38§12 saved fight round trip: respawn crystals" TO TL-CASE
     COMPUTE TL-EXPECTED-N = EF-CRYSTAL-COUNT * 1000 + EF-CRYSTAL-UUID(1, 1) + EF-CRYSTAL-UUID(2, 4)
     IF EF-CRYSTAL-COUNT = 0
         MOVE 0 TO TL-EXPECTED-N
     END-IF
     COMPUTE TL-OBSERVED-N = RB-CRYSTAL-COUNT * 1000 + RB-CRYSTAL-UUID(1, 1) + RB-CRYSTAL-UUID(2, 4)
     IF RB-CRYSTAL-COUNT = 0
         MOVE 0 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-END-45-FIGHT.
