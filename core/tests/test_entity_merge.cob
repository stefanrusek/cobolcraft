*> Implementation test (vanfmt lane; docs/protocol/07 section 10.6, 10.7): in a world of the 26.3 layout (CW-LAYOUT 1) the
*> entities/ chunks are saved without losing the entities the core cannot hold: an entity whose id the core does not
*> know stays in its chunk exactly as it was, a chunk of the file that holds only such entities is not deleted, and the
*> entities of the core are written beside them. In the CobolCraft layout the files are replaced as before.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-ENTITY-MERGE.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY COREAPI.
 COPY DIMENSIONS.
 COPY CITEMS.
 COPY PROTO.
 01 WS-CAPACITY            BINARY-LONG VALUE 65536.
 01 WS-DIM                 BINARY-LONG.
 01 WS-CX                  BINARY-LONG VALUE 6.
 01 WS-CZ                  BINARY-LONG VALUE 7.
 01 WS-ENTITIES            PIC X(8) VALUE "entities".
 01 WS-DIR                 PIC X(1024).
 01 WS-LENGTH              BINARY-LONG.
 01 WS-OUTCOME             BINARY-LONG.
 01 WS-FRAMING             BINARY-LONG VALUE 1.
 01 WS-TYPE                BINARY-LONG.
 01 WS-ROOT                BINARY-LONG.
 01 WS-PATH                PIC X(128).
 01 WS-OBSERVED            PIC X(8192).
 01 WS-ONE                 PIC X(8192).
 01 WN                     PIC X(32).
 01 WL                     BINARY-LONG.
 01 WS-ELEMENT             BINARY-LONG VALUE -1.
 01 WS-ONE-COUNT           BINARY-LONG VALUE 1.
 01 WS-TWO-COUNT           BINARY-LONG VALUE 2.
 01 WS-DATA-VERSION        BINARY-LONG VALUE 5023.
 01 WS-KIND                BINARY-LONG.
 01 WS-T-DOUBLE            BINARY-LONG VALUE 6.
 01 WS-THREE-COUNT         BINARY-LONG VALUE 3.
 01 WS-FOUR-COUNT          BINARY-LONG VALUE 4.
 01 WS-DOUBLE              FLOAT-LONG.
 01 WS-FIVE                BINARY-LONG VALUE 5.
 01 WS-SEVEN               BINARY-LONG VALUE 7.
 01 WS-UUID.
    05 WS-UUID-INT         BINARY-LONG OCCURS 4 TIMES.
 01 WS-KEY                 PIC X(32) VALUE "minecraft:armor_stand".
 01 WS-KEY-LENGTH          BINARY-LONG VALUE 21.
 01 WS-NAME-TEXT           PIC X(8) VALUE "keep".
 01 WS-NAME-LENGTH         BINARY-LONG VALUE 4.
 01 WS-COMPOUND            BINARY-LONG VALUE 10.
 PROCEDURE DIVISION.
     MOVE "T" TO TL-MODE
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     MOVE DIM-MAIN TO WS-DIM
     MOVE 1 TO WS-UUID-INT(1)
     MOVE 2 TO WS-UUID-INT(2)
     MOVE 3 TO WS-UUID-INT(3)
     MOVE 4 TO WS-UUID-INT(4)
     CALL "PERSIST-DIRS"
     PERFORM WRITE-OLD
     MOVE 1 TO CW-LAYOUT
     CALL "PERSIST-ENTITIES-SAVE" USING WS-DIM
     PERFORM READ-BACK
     MOVE SPACES TO WS-OBSERVED
     MOVE "Entities" TO WS-PATH PERFORM ADD-GET
     MOVE "test entity merge in the 26.3 layout an entity of an unknown id stays in its chunk as it was" TO TL-CASE
     MOVE "[{id:minecraft:armor_stand,CustomName:keep}]" TO TL-EXPECTED
     PERFORM CHECK
*>   Layout 0: the file is replaced, the chunk is gone.
     PERFORM WRITE-OLD
     MOVE 0 TO CW-LAYOUT
     CALL "PERSIST-ENTITIES-SAVE" USING WS-DIM
     PERFORM READ-BACK
     MOVE "test entity merge in the CobolCraft layout the old file is replaced (the chunk reads as absent)" TO TL-CASE
     MOVE "absent (no file)" TO TL-EXPECTED
     MOVE WS-OUTCOME TO TL-OBSERVED-N
     MOVE SPACES TO WS-OBSERVED
     IF WS-OUTCOME = 1
         MOVE "absent (no file)" TO WS-OBSERVED
     ELSE
         MOVE "present" TO WS-OBSERVED
     END-IF
     PERFORM CHECK

*>   A ground item of the core's own kind keeps the keys of the file that the core does not model (UUID, a custom key):
*>   they come back in its compound after the save (07 §10.7).
     PERFORM WRITE-OLD-ITEM
     MOVE 1 TO CW-LAYOUT
     CALL "ENTITY-NBT-READ" USING WS-DIM PB-BUFFER WS-OUTCOME
     CALL "PERSIST-ENTITIES-SAVE" USING WS-DIM
     PERFORM READ-BACK
     MOVE SPACES TO WS-OBSERVED
     MOVE "Entities[0].UUID" TO WS-PATH PERFORM ADD-GET
     MOVE "Entities[0].future_key" TO WS-PATH PERFORM ADD-GET
     MOVE "Entities[0].Item.count" TO WS-PATH PERFORM ADD-GET
     MOVE "Entities[0].Age" TO WS-PATH PERFORM ADD-GET
     MOVE "test entity merge in the 26.3 layout a ground item keeps its UUID and unmodelled keys, and is not written twice" TO TL-CASE
     MOVE "I[1,2,3,4] 7 3 5" TO TL-EXPECTED
     PERFORM CHECK
     MOVE "Entities[1]" TO WS-PATH
     MOVE SPACES TO WS-OBSERVED
     PERFORM ADD-GET
     MOVE "test entity merge the chunk holds exactly one entity after the save" TO TL-CASE
     MOVE "absent" TO TL-EXPECTED
     PERFORM CHECK
     STOP RUN.

*> The chunk (6, 7) of entities/ holds one armor_stand {CustomName: keep}.
 WRITE-OLD.
     CALL "PB-RESET" USING PB-BUFFER
     MOVE SPACES TO WN
     MOVE 0 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     MOVE "DataVersion" TO WN MOVE 11 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL WS-DATA-VERSION
     MOVE "Entities" TO WN MOVE 8 TO WL
     CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WN WL WS-COMPOUND WS-TWO-COUNT
*>   An entity of a type the core holds (the ground item): not kept, the core writes what it holds.
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WS-ELEMENT
     MOVE "id" TO WN MOVE 2 TO WL
     COMPUTE WS-KIND = CR-LOOSE-ITEM + 1
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WN WL ET-KEY(WS-KIND) ET-KEY-LENGTH(WS-KIND)
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WS-ELEMENT
     MOVE "id" TO WN MOVE 2 TO WL
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WN WL WS-KEY WS-KEY-LENGTH
     MOVE "CustomName" TO WN MOVE 10 TO WL
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WN WL WS-NAME-TEXT WS-NAME-LENGTH
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "NBT-WRITE-LIST-END" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "PERSIST-DIM-DIR" USING WS-DIM WS-ENTITIES WS-DIR WS-LENGTH
     CALL "REGION-WRITE" USING WS-DIR WS-LENGTH WS-CX WS-CZ PB-BUFFER WS-OUTCOME.


*> The chunk (6, 7) of entities/ holds one ground item with UUID [1,2,3,4], a key future_key = 7 and Age 5.
 WRITE-OLD-ITEM.
     CALL "PB-RESET" USING PB-BUFFER
     MOVE SPACES TO WN
     MOVE 0 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     MOVE "Entities" TO WN MOVE 8 TO WL
     CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WN WL WS-COMPOUND WS-ONE-COUNT
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WS-ELEMENT
     MOVE "id" TO WN MOVE 2 TO WL
     COMPUTE WS-KIND = CR-LOOSE-ITEM + 1
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WN WL ET-KEY(WS-KIND) ET-KEY-LENGTH(WS-KIND)
     MOVE "Pos" TO WN MOVE 3 TO WL
     CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WN WL WS-T-DOUBLE WS-THREE-COUNT
     MOVE 100 TO WS-DOUBLE
     CALL "NBT-WRITE-DOUBLE" USING PB-BUFFER WN WS-ELEMENT WS-DOUBLE
     MOVE 70 TO WS-DOUBLE
     CALL "NBT-WRITE-DOUBLE" USING PB-BUFFER WN WS-ELEMENT WS-DOUBLE
     MOVE 120 TO WS-DOUBLE
     CALL "NBT-WRITE-DOUBLE" USING PB-BUFFER WN WS-ELEMENT WS-DOUBLE
     CALL "NBT-WRITE-LIST-END" USING PB-BUFFER
     MOVE "Item" TO WN MOVE 4 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     MOVE "id" TO WN MOVE 2 TO WL
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WN WL IT-KEY(2) IT-KEY-LENGTH(2)
     MOVE "count" TO WN MOVE 5 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL WS-THREE-COUNT
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE "Age" TO WN MOVE 3 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL WS-FIVE
     MOVE "UUID" TO WN MOVE 4 TO WL
     CALL "NBT-WRITE-INT-ARRAY" USING PB-BUFFER WN WL WS-FOUR-COUNT WS-UUID
     MOVE "future_key" TO WN MOVE 10 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL WS-SEVEN
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "NBT-WRITE-LIST-END" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "PERSIST-DIM-DIR" USING WS-DIM WS-ENTITIES WS-DIR WS-LENGTH
     CALL "REGION-WRITE" USING WS-DIR WS-LENGTH WS-CX WS-CZ PB-BUFFER WS-OUTCOME
     MOVE 0 TO PB-POS.

 READ-BACK.
     CALL "PERSIST-DIM-DIR" USING WS-DIM WS-ENTITIES WS-DIR WS-LENGTH
     CALL "REGION-READ" USING WS-DIR WS-LENGTH WS-CX WS-CZ PB-BUFFER WS-OUTCOME
     MOVE 0 TO PB-POS
     IF WS-OUTCOME = 0
         CALL "NBT-READ-ROOT" USING PB-BUFFER WS-FRAMING WS-TYPE
         MOVE PB-POS TO WS-ROOT
     ELSE
         MOVE -1 TO WS-ROOT
     END-IF.

 ADD-GET.
     CALL "TEST-NBT-GET" USING PB-BUFFER WS-ROOT WS-PATH WS-ONE
     STRING FUNCTION TRIM(WS-OBSERVED) " " FUNCTION TRIM(WS-ONE) DELIMITED BY SIZE INTO WS-OBSERVED.

 CHECK.
     MOVE FUNCTION TRIM(WS-OBSERVED) TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-ENTITY-MERGE.

 COPY CORETEST.
