    05 WS-T1               PIC X(96).
    05 WS-T2               PIC X(96).
 01 WS-NM                PIC X(32).
 PROCEDURE DIVISION.
     MOVE "T" TO TL-MODE
     MOVE "acceptance US12 40-4§1 Common rules used by all four menus: rule 1, 3, 8: type ids enchantment 13, loom 18, cartography_table 23, stonecutter 24; own slots, totals, data slots and the title" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN4-IDENT" USING WS-I1 WS-R1 WS-R2 WS-R3 WS-R4 WS-R5
     MOVE 5 TO WS-N
     PERFORM ADD-N
     MOVE "2" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN4-IDENT" USING WS-I1 WS-R1 WS-R2 WS-R3 WS-R4 WS-R5
     MOVE 5 TO WS-N
     PERFORM ADD-N
     MOVE "3" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN4-IDENT" USING WS-I1 WS-R1 WS-R2 WS-R3 WS-R4 WS-R5
     MOVE 5 TO WS-N
     PERFORM ADD-N
     MOVE "4" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN4-IDENT" USING WS-I1 WS-R1 WS-R2 WS-R3 WS-R4 WS-R5
     MOVE 5 TO WS-N
     PERFORM ADD-N
     MOVE "13/2/38/10/0 18/4/40/1/2 23/3/39/0/2 24/2/38/1/1" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 40-4§1 Common rules used by all four menus: rule 2, 3: the bound block and the default title key" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN4-BLOCK" USING WS-I1 WS-T1 WS-T2
     PERFORM ADD-TEXT
     MOVE "2" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN4-BLOCK" USING WS-I1 WS-T1 WS-T2
     PERFORM ADD-TEXT
     MOVE "3" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN4-BLOCK" USING WS-I1 WS-T1 WS-T2
     PERFORM ADD-TEXT
     MOVE "4" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN4-BLOCK" USING WS-I1 WS-T1 WS-T2
     PERFORM ADD-TEXT
     MOVE "enchanting_table|container.enchant loom|container.loom cartography_table|container.cartography_table stonecutter|container.stonecutter" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 40-4§1 Common rules used by all four menus: rule 3: title key and English text" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN4-TITLE" USING WS-I1 WS-T1 WS-T2
     PERFORM ADD-TEXT
     MOVE "2" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN4-TITLE" USING WS-I1 WS-T1 WS-T2
     PERFORM ADD-TEXT
     MOVE "3" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN4-TITLE" USING WS-I1 WS-T1 WS-T2
     PERFORM ADD-TEXT
     MOVE "4" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN4-TITLE" USING WS-I1 WS-T1 WS-T2
     PERFORM ADD-TEXT
     MOVE "container.enchant|Enchant container.loom|Loom container.cartography_table|Cartography Table container.stonecutter|Stonecutter" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 40-4§1 Common rules used by all four menus: rule 2: stillValid is the block-bound helper: true with the NULL access, otherwise block and range (null access, block ok, in range)" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0 0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-VALID" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-VALID" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-VALID" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-VALID" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-VALID" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-VALID" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-VALID" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN3-VALID" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 0 1 1 1 1 1" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 40-4§1 Common rules used by all four menus: rule 4: close returns the input slots (enchanting 2, loom 3, cartography 2, stonecutter 1) and removes the result item silently for" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN4-CLOSE" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "2" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN4-CLOSE" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "3" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN4-CLOSE" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "4" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN4-CLOSE" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "2/0 3/0 2/1 1/1" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 40-4§1 Common rules used by all four menus: rule 5: a take sound plays only when the game time differs from the remembered one, which then becomes the current time (game time," TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "100 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN4-SOUND" USING WS-I1 WS-I2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "100 100" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN4-SOUND" USING WS-I1 WS-I2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "101 100" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN4-SOUND" USING WS-I1 WS-I2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN4-SOUND" USING WS-I1 WS-I2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "5 4" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN4-SOUND" USING WS-I1 WS-I2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "5 5" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN4-SOUND" USING WS-I1 WS-I2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1/100 0/100 1/101 0/0 1/5 0/5" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 40-4§1 Common rules used by all four menus: rule 6: a data slot value is a signed 16-bit short on the wire; the enchantment seed 0x12345678 arrives as 22136, 0x0001ABCD as" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "305419896" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN2-DATA-WIRE" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "109517" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN2-DATA-WIRE" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "98304" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN2-DATA-WIRE" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "-1" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN2-DATA-WIRE" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "32767" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN2-DATA-WIRE" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "32768" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN2-DATA-WIRE" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "30" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN2-DATA-WIRE" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "22136 -21555 -32768 -1 32767 -32768 30" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 BEGIN-CASE.
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR
     .

 LOAD-IN.
     MOVE 1 TO WS-P
     PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 16
         MOVE SPACES TO WS-TOK
         IF WS-P <= 160
             UNSTRING WS-IN DELIMITED BY ALL SPACE INTO WS-TOK WITH POINTER WS-P
         END-IF
         COMPUTE WS-FX(WS-K) = FUNCTION NUMVAL(WS-TOK)
         COMPUTE WS-I(WS-K) = FUNCTION NUMVAL(WS-TOK)
     END-PERFORM
     .

 ADD-N.
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N
         MOVE WS-R(WS-J) TO WS-SHOW
         IF WS-J > 1
             STRING "/" DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
         END-IF
         STRING FUNCTION TRIM(WS-SHOW) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-PERFORM
     STRING " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .

 ADD-TEXT.
     STRING FUNCTION TRIM(WS-T1) "|" FUNCTION TRIM(WS-T2) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .
 END PROGRAM TEST-MENU-40-4-1.
