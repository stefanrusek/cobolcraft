     MOVE WS-C TO WS-SHOW
     PERFORM ADD-N
     MOVE 2 TO WS-A
     MOVE 3 TO WS-B
     CALL "BE5-BEACON-SOUND" USING WS-A WS-B WS-C
     MOVE WS-C TO WS-SHOW
     PERFORM ADD-N
     MOVE 0 TO WS-A
     MOVE 0 TO WS-B
     CALL "BE5-BEACON-SOUND" USING WS-A WS-B WS-C
     MOVE WS-C TO WS-SHOW
     PERFORM ADD-N
     MOVE 1 TO WS-A
     MOVE 1 TO WS-B
