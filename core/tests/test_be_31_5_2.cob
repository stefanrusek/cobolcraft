     MOVE WS-F TO WS-SHOW
     PERFORM ADD-N
     MOVE 0 TO WS-A
     MOVE 1 TO WS-B
     MOVE 0 TO WS-C
     CALL "BE5-BEACON-PULSE" USING WS-A WS-B WS-C WS-E WS-F
     MOVE WS-E TO WS-SHOW
     PERFORM ADD-N
     MOVE WS-F TO WS-SHOW
     PERFORM ADD-N
     MOVE 80 TO WS-A
     MOVE 0 TO WS-B
     MOVE 0 TO WS-C
     CALL "BE5-BEACON-PULSE" USING WS-A WS-B WS-C WS-E WS-F
     MOVE WS-E TO WS-SHOW
