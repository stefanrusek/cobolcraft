     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "1/3150 3/1600" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 crossbow release: loaded only when use ticks reach the charge duration" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE 24 TO WS-I1
     MOVE 25 TO WS-I2
     CALL "TOOL-CROSSBOW-READY" USING WS-I1 WS-I2 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 25 TO WS-I1
     MOVE 25 TO WS-I2
     CALL "TOOL-CROSSBOW-READY" USING WS-I1 WS-I2 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "0 1" TO TL-EXPECTED
     PERFORM CHECK-DONE

     STOP RUN.

 ADD-OBS.
     IF TL-OBSERVED = SPACES
         MOVE FUNCTION TRIM(WS-OBS) TO TL-OBSERVED
     ELSE
         STRING FUNCTION TRIM(TL-OBSERVED) " " FUNCTION TRIM(WS-OBS) DELIMITED BY SIZE INTO TL-OBSERVED
     END-IF.

 CHECK-DONE.
     MOVE "T" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-TOOL-USE-3-9.
