     PERFORM LOAD-IN
     CALL "GC5-CHEST-LEAST" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 0 1 1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC5-CHEST-LEAST" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 1 1 3 2" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC5-CHEST-LEAST" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 1 1 1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC5-CHEST-LEAST" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 0 0 2 2" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC5-CHEST-LEAST" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
