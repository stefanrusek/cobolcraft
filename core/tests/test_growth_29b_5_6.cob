     MOVE 5 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 1 0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC5-STATUE-USE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-R1 WS-R2 WS-R3 WS-R4 WS-R5
     MOVE 5 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 0 0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC5-STATUE-USE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-R1 WS-R2 WS-R3 WS-R4 WS-R5
     MOVE 5 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 0 1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC5-STATUE-USE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-R1 WS-R2 WS-R3 WS-R4 WS-R5
     MOVE 5 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 0 0 0" TO WS-IN
