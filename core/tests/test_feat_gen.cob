*> End to end test of the feature stage in the chunk generation (core/src/gen-job.cob stage GJ-STAGE-FEATURES): the chunk (2, 3) of the fixture terrain (core/tests/fixtures/gen) is
*> generated by the atomic reference with the feature lists of core/tests/fixtures/feat loaded: the stage ran its eleven steps, the generated chunk contains the flowers the lists
*> place (and none without the lists), every flower stands on a block that is not air, and the stepped generation gives the same bytes as the atomic one.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-FEAT-GEN.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY COREAPI.
 COPY GENSTAGE.
 COPY GENSTEPS.
 COPY CLIMATE.
 COPY CBLOCKS.
 COPY CELLS.
 01 WS-DIR                 PIC X(1100) VALUE "core/tests/fixtures/gen".
 01 WS-FEAT-DIR            PIC X(1100) VALUE "core/tests/fixtures/feat".
 01 WS-STATUS              BINARY-LONG.
 01 WS-DIM                 BINARY-LONG VALUE 3.
 01 WS-CX                  BINARY-LONG VALUE 2.
 01 WS-CZ                  BINARY-LONG VALUE 3.
 01 WS-I                   BINARY-LONG.
 01 WS-REF                 PIC X(304640).
 01 WS-REF2                PIC X(304640).
 01 WS-REF3                PIC X(304640).
 01 WS-REF-Y               BINARY-LONG.
 01 WS-A                   PIC X(304640) BASED.
 01 WS-JOB.
    COPY GENJOB REPLACING LEADING ==GJ-== BY ==T-==.
 01 WS-MINS.
    05 WS-MIN              BINARY-DOUBLE OCCURS 6 TIMES.
 01 WS-MAXS.
    05 WS-MAX              BINARY-DOUBLE OCCURS 6 TIMES.
 01 WS-OFFSET              BINARY-DOUBLE VALUE 0.
 01 WS-NAME                PIC X(40).
 01 WS-FLOWERS             BINARY-LONG.
 01 WS-FLOWERS-2           BINARY-LONG.
 01 WS-BAD                 BINARY-LONG.
 01 WS-STATE               BINARY-LONG.
 01 WS-K                   BINARY-LONG.
 01 WS-ABOVE               BINARY-LONG.
 01 WS-BELOW               BINARY-LONG.
 PROCEDURE DIVISION.
     MOVE "N" TO TL-MODE
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     MOVE "standard" TO CS-WORLD-TYPE
     MOVE "12345" TO CS-SEED-TEXT
     MOVE 12345 TO CW-SEED
     MOVE CORE-SETTINGS TO CW-SETTINGS
     MOVE 6 TO CB-BLOCK-COUNT
     MOVE 300 TO CB-STATE-COUNT
     MOVE 9 TO CB-EPOCH
     MOVE "minecraft:air" TO CB-KEY(1)
     MOVE 13 TO CB-KEY-LENGTH(1)
     MOVE 0 TO CB-DEFAULT-STATE(1)
     MOVE 0 TO CB-SOLID(1)
     MOVE "minecraft:stone" TO CB-KEY(2)
     MOVE 15 TO CB-KEY-LENGTH(2)
     MOVE 1 TO CB-DEFAULT-STATE(2)
     MOVE 1 TO CB-SOLID(2)
     MOVE "minecraft:water" TO CB-KEY(3)
     MOVE 15 TO CB-KEY-LENGTH(3)
     MOVE 86 TO CB-DEFAULT-STATE(3)
     MOVE 0 TO CB-SOLID(3)
     MOVE "minecraft:lava" TO CB-KEY(4)
     MOVE 14 TO CB-KEY-LENGTH(4)
     MOVE 102 TO CB-DEFAULT-STATE(4)
     MOVE 0 TO CB-SOLID(4)
     MOVE "minecraft:dandelion" TO CB-KEY(5)
     MOVE 19 TO CB-KEY-LENGTH(5)
     MOVE 200 TO CB-DEFAULT-STATE(5)
     MOVE 0 TO CB-SOLID(5)
     MOVE "minecraft:poppy" TO CB-KEY(6)
     MOVE 15 TO CB-KEY-LENGTH(6)
     MOVE 201 TO CB-DEFAULT-STATE(6)
     MOVE 0 TO CB-SOLID(6)
     MOVE 0 TO CB-S-BLOCK(1)
     MOVE 1 TO CB-S-BLOCK(2)
     MOVE 2 TO CB-S-BLOCK(87)
     MOVE 3 TO CB-S-BLOCK(103)
     MOVE 4 TO CB-S-BLOCK(201)
     MOVE 5 TO CB-S-BLOCK(202)
     MOVE 2 TO CBI-COUNT
     MOVE "minecraft:plains" TO CBI-KEY(1)
     MOVE 16 TO CBI-KEY-LENGTH(1)
     MOVE "minecraft:desert" TO CBI-KEY(2)
     MOVE 16 TO CBI-KEY-LENGTH(2)
     CALL "CLIMATE-POINTS-RESET"
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 6
         MOVE -10000 TO WS-MIN(WS-I)
         MOVE 10000 TO WS-MAX(WS-I)
     END-PERFORM
     MOVE 1399 TO WS-MAX(6)
     MOVE "minecraft:plains" TO WS-NAME
     CALL "CLIMATE-POINT-ADD" USING WS-NAME WS-MINS WS-MAXS WS-OFFSET
     MOVE 10000 TO WS-MAX(6)
     MOVE 1400 TO WS-MIN(6)
     MOVE "minecraft:desert" TO WS-NAME
     CALL "CLIMATE-POINT-ADD" USING WS-NAME WS-MINS WS-MAXS WS-OFFSET

*>   without feature lists
     CALL "WORLDGEN-FREE"
     CALL "NOISES-LOAD" USING WS-DIR WS-STATUS
     CALL "DENSITY-FUNCTIONS-LOAD" USING WS-DIR WS-STATUS
     CALL "GEN-QUEUE-RESET"
     INITIALIZE GEN-STAGES
     CALL "GEN-JOB-RUN-ALL" USING WS-DIM WS-CX WS-CZ WS-REF WS-REF-Y
     SET ADDRESS OF CE-CHUNK TO ADDRESS OF WS-REF
     MOVE 0 TO WS-FLOWERS
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > CE-STATE-CELLS
         IF CE-STATE(WS-I) = 200 OR CE-STATE(WS-I) = 201
             ADD 1 TO WS-FLOWERS
         END-IF
     END-PERFORM
     MOVE "acceptance feature generation: without feature lists the generated chunk has no flower" TO TL-CASE
     MOVE WS-FLOWERS TO TL-OBSERVED-N
     MOVE 0 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance feature generation: the feature stage still counts its eleven steps" TO TL-CASE
     MOVE GS-FEATURE TO TL-OBSERVED-N
     MOVE 11 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

*>   with the lists of core/tests/fixtures/feat
     CALL "BIOMES-LOAD" USING WS-FEAT-DIR WS-STATUS
     MOVE "acceptance feature generation: the feature lists load beside the terrain data" TO TL-CASE
     MOVE WS-STATUS TO TL-OBSERVED-N
     MOVE 0 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "FD-SET-DIR" USING WS-FEAT-DIR
     CALL "GEN-QUEUE-RESET"
     INITIALIZE GEN-STAGES
     CALL "GEN-JOB-RUN-ALL" USING WS-DIM WS-CX WS-CZ WS-REF2 WS-REF-Y
     SET ADDRESS OF CE-CHUNK TO ADDRESS OF WS-REF2
     MOVE 0 TO WS-FLOWERS WS-BAD
     PERFORM VARYING WS-K FROM 0 BY 1 UNTIL WS-K >= 98304 - 256
         COMPUTE WS-I = WS-K + 1
         IF CE-STATE(WS-I) = 200 OR CE-STATE(WS-I) = 201
             ADD 1 TO WS-FLOWERS
             COMPUTE WS-BELOW = CE-STATE(WS-I - 256)
             COMPUTE WS-ABOVE = CE-STATE(WS-I + 256)
             IF WS-K < 256 OR WS-BELOW = 0 OR WS-ABOVE NOT = 0
                 ADD 1 TO WS-BAD
             END-IF
         END-IF
     END-PERFORM
     MOVE "acceptance feature generation: the generated chunk contains flowers" TO TL-CASE
     IF WS-FLOWERS > 0
         MOVE 1 TO TL-OBSERVED-N
     ELSE
         MOVE 0 TO TL-OBSERVED-N
     END-IF
     MOVE 1 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance feature generation: every flower stands on a block that is not air with air above it" TO TL-CASE
     MOVE WS-BAD TO TL-OBSERVED-N
     MOVE 0 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance feature generation: the stage ran its eleven steps" TO TL-CASE
     MOVE GS-FEATURE TO TL-OBSERVED-N
     MOVE 11 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance feature generation: the terrain is the one without lists apart from the flowers (stone count unchanged)" TO TL-CASE
     MOVE 0 TO WS-FLOWERS-2
     SET ADDRESS OF CE-CHUNK TO ADDRESS OF WS-REF
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > CE-STATE-CELLS
         IF CE-STATE(WS-I) = 1
             ADD 1 TO WS-FLOWERS-2
         END-IF
     END-PERFORM
     MOVE 0 TO WS-BAD
     SET ADDRESS OF CE-CHUNK TO ADDRESS OF WS-REF2
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > CE-STATE-CELLS
         IF CE-STATE(WS-I) = 1
             ADD 1 TO WS-BAD
         END-IF
     END-PERFORM
     COMPUTE TL-OBSERVED-N = WS-FLOWERS-2 - WS-BAD
     MOVE 0 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

*>   the stepped generation equals the atomic one
     CALL "GEN-QUEUE-RESET"
     CALL "GEN-JOB-START" USING WS-JOB WS-DIM WS-CX WS-CZ
     PERFORM UNTIL T-ACTIVE NOT = 1
         CALL "GEN-JOB-STEP" USING WS-JOB
     END-PERFORM
     CALL "GEN-JOB-INSTALL" USING WS-JOB WS-REF3 WS-REF-Y
     CALL "GEN-JOB-FREE" USING WS-JOB
     MOVE "acceptance feature generation: the stepped generation gives the bytes of the atomic one" TO TL-CASE
     MOVE 0 TO TL-OBSERVED-N
     IF WS-REF2 = WS-REF3
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     MOVE 1 TO TL-EXPECTED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     GOBACK.
 END PROGRAM TEST-FEAT-GEN.
 COPY CORETEST.
