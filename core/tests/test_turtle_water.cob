*> Implementation test (lane 002-lane-p49s, T38590 to T38595; docs/protocol/44-residual-mob-questions-4-land-animals.md section 11.1 and 35-7 section 2.3): Turtle.getWalkTargetValue (10 for water
*> unless it goes home, 10 over sand, else the light cost: 0.5 at brightness 15), PanicGoal.lookForWater (the ordered box (7, 1, 7) by Manhattan distance, the x then y then +z before -z order inside a
*> depth, nothing inside a solid block, y reach 1) and the turtle's panic walk to that water.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-TURTLE-WATER.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY CONTENT.
 01 WS-PLAYER              BINARY-LONG.
 01 WS-DIM                 BINARY-LONG.
 01 WS-X0                  FLOAT-LONG.
 01 WS-Y                   FLOAT-LONG.
 01 WS-Z0                  FLOAT-LONG.
 01 WS-GX                  FLOAT-LONG.
 01 WS-GZ                  FLOAT-LONG.
 01 WS-BX                  BINARY-LONG.
 01 WS-BY                  BINARY-LONG.
 01 WS-BZ                  BINARY-LONG.
 01 WS-PX                  BINARY-LONG.
 01 WS-PY                  BINARY-LONG.
 01 WS-PZ                  BINARY-LONG.
 01 WS-KEY                 PIC X(112).
 01 WS-ENTITY-ROW          PIC X(66).
 01 WS-STATUS              BINARY-LONG.
 01 WS-TYPE                BINARY-LONG.
 01 WS-YAW                 FLOAT-SHORT VALUE 0.
 01 WS-ROW                 BINARY-LONG.
 01 WS-WATER               BINARY-LONG.
 01 WS-SAND                BINARY-LONG.
 01 WS-GLOW                BINARY-LONG.
 01 WS-STONE               BINARY-LONG.
 01 WS-AIR                 BINARY-LONG VALUE 0.
 01 WS-VALUE               FLOAT-LONG.
 01 WS-HOME                BINARY-LONG VALUE 0.
 01 WS-HOME1               BINARY-LONG VALUE 1.
 01 WS-FOUND               BINARY-LONG.
 01 WS-RX                  BINARY-LONG.
 01 WS-RY                  BINARY-LONG.
 01 WS-RZ                  BINARY-LONG.
 01 WS-RANGE               BINARY-LONG VALUE 7.
 01 WS-HX                  FLOAT-LONG.
 01 WS-HZ                  FLOAT-LONG.
 01 WS-WALK                BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-CX                  BINARY-LONG.
 01 WS-CY                  BINARY-LONG.
 01 WS-CZ                  BINARY-LONG.
 PROCEDURE DIVISION.
     CALL "MS-TEST-OPEN" USING WS-PLAYER
     MOVE "N" TO TL-MODE
     MOVE PL-DIM(WS-PLAYER) TO WS-DIM
     MOVE PL-X(WS-PLAYER) TO WS-X0
     MOVE PL-Y(WS-PLAYER) TO WS-Y
     MOVE PL-Z(WS-PLAYER) TO WS-Z0
     COMPUTE WS-BX = FUNCTION INTEGER(WS-X0) - 20
     COMPUTE WS-BY = FUNCTION INTEGER(WS-Y) - 1
     COMPUTE WS-BZ = FUNCTION INTEGER(WS-Z0) - 20
     CALL "MS-TEST-FLOOR" USING WS-DIM WS-BX WS-BZ 40 WS-BY 1
     MOVE 6000 TO CW-TIME
     MOVE "minecraft:water" TO WS-KEY
     CALL "MS-TEST-STATE" USING WS-KEY WS-WATER
     MOVE "minecraft:sand" TO WS-KEY
     CALL "MS-TEST-STATE" USING WS-KEY WS-SAND
     MOVE "minecraft:glowstone" TO WS-KEY
     CALL "MS-TEST-STATE" USING WS-KEY WS-GLOW
     MOVE "minecraft:stone" TO WS-KEY
     CALL "MS-TEST-STATE" USING WS-KEY WS-STONE
     MOVE "minecraft:turtle" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-TYPE WS-ENTITY-ROW WS-STATUS
     COMPUTE WS-PX = FUNCTION INTEGER(WS-X0)
     COMPUTE WS-PY = FUNCTION INTEGER(WS-Y)
     COMPUTE WS-PZ = FUNCTION INTEGER(WS-Z0)
     COMPUTE WS-GX = WS-PX + 0.5
     COMPUTE WS-GZ = WS-PZ + 0.5
     CALL "MOB-SPAWN" USING WS-DIM WS-TYPE WS-GX WS-Y WS-GZ WS-YAW WS-ROW

*>   getWalkTargetValue: water 10 (unless going home), sand below 10, light 15 gives 0.5.
     COMPUTE WS-CX = WS-PX + 3
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-CX WS-PY WS-PZ WS-WATER
     CALL "TURTLE-WALK-VALUE" USING WS-ROW WS-CX WS-PY WS-PZ WS-HOME WS-VALUE
     MOVE "acceptance US15 44-4§11.1 a water block scores 10" TO TL-CASE
     MOVE 10 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N ROUNDED = WS-VALUE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "TURTLE-WALK-VALUE" USING WS-ROW WS-CX WS-PY WS-PZ WS-HOME1 WS-VALUE
     MOVE "acceptance US15 44-4§11.1 a turtle going home does not prefer water (the light cost, below 1)" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF WS-VALUE < 1
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     COMPUTE WS-CX = WS-PX + 5
     COMPUTE WS-CY = WS-PY - 1
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-CX WS-CY WS-PZ WS-SAND
     CALL "TURTLE-WALK-VALUE" USING WS-ROW WS-CX WS-PY WS-PZ WS-HOME1 WS-VALUE
     MOVE "acceptance US15 44-4§11.1 a cell over sand scores 10, also going home" TO TL-CASE
     MOVE 10 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N ROUNDED = WS-VALUE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     COMPUTE WS-CX = WS-PX + 6
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-CX WS-PY WS-PZ WS-GLOW
     CALL "TURTLE-WALK-VALUE" USING WS-ROW WS-CX WS-PY WS-PZ WS-HOME WS-VALUE
     MOVE "acceptance US15 44-4§11.1 brightness 15 costs +0.5 (the light cost of a glowstone cell)" TO TL-CASE
     MOVE 500 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N ROUNDED = WS-VALUE * 1000
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-CX WS-PY WS-PZ WS-AIR
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-CX WS-CY WS-PZ WS-AIR
     COMPUTE WS-CX = WS-PX + 5
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-CX WS-CY WS-PZ WS-AIR
     COMPUTE WS-CX = WS-PX + 3
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-CX WS-PY WS-PZ WS-AIR

*>   lookForWater: the nearest water first; inside a depth x ascending, then y, then +z before -z.
     COMPUTE WS-CX = WS-PX + 3
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-CX WS-PY WS-PZ WS-WATER
     COMPUTE WS-CZ = WS-PZ - 2
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-PX WS-PY WS-CZ WS-WATER
     CALL "TURTLE-LOOK-FOR-WATER" USING WS-ROW WS-RANGE WS-FOUND WS-RX WS-RY WS-RZ
     MOVE "acceptance US15 44-4§11.1 the nearer water (0, 0, -2) is found before (3, 0, 0)" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF WS-FOUND = 1 AND WS-RX = WS-PX AND WS-RY = WS-PY AND WS-RZ = WS-PZ - 2
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-PX WS-PY WS-CZ WS-AIR
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-CX WS-PY WS-PZ WS-AIR
*>   Four water blocks at depth 2: (-2,0,0) comes first, then (0,0,+2), then (0,0,-2), then (+2,0,0).
     COMPUTE WS-CX = WS-PX - 2
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-CX WS-PY WS-PZ WS-WATER
     COMPUTE WS-CX = WS-PX + 2
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-CX WS-PY WS-PZ WS-WATER
     COMPUTE WS-CZ = WS-PZ + 2
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-PX WS-PY WS-CZ WS-WATER
     COMPUTE WS-CZ = WS-PZ - 2
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-PX WS-PY WS-CZ WS-WATER
     CALL "TURTLE-LOOK-FOR-WATER" USING WS-ROW WS-RANGE WS-FOUND WS-RX WS-RY WS-RZ
     MOVE "acceptance US15 44-4§11.1 depth 2: x ascending, so (-2, 0, 0) first" TO TL-CASE
     MOVE 0 TO TL-OBSERVED-N
     IF WS-FOUND = 1 AND WS-RX = WS-PX - 2 AND WS-RZ = WS-PZ
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     COMPUTE WS-CX = WS-PX - 2
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-CX WS-PY WS-PZ WS-AIR
     CALL "TURTLE-LOOK-FOR-WATER" USING WS-ROW WS-RANGE WS-FOUND WS-RX WS-RY WS-RZ
     MOVE "acceptance US15 44-4§11.1 then (0, 0, +2) before (0, 0, -2)" TO TL-CASE
     MOVE 0 TO TL-OBSERVED-N
     IF WS-FOUND = 1 AND WS-RX = WS-PX AND WS-RZ = WS-PZ + 2
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     COMPUTE WS-CZ = WS-PZ + 2
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-PX WS-PY WS-CZ WS-AIR
     CALL "TURTLE-LOOK-FOR-WATER" USING WS-ROW WS-RANGE WS-FOUND WS-RX WS-RY WS-RZ
     MOVE "acceptance US15 44-4§11.1 then (0, 0, -2)" TO TL-CASE
     MOVE 0 TO TL-OBSERVED-N
     IF WS-FOUND = 1 AND WS-RX = WS-PX AND WS-RZ = WS-PZ - 2
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     COMPUTE WS-CZ = WS-PZ - 2
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-PX WS-PY WS-CZ WS-AIR
     CALL "TURTLE-LOOK-FOR-WATER" USING WS-ROW WS-RANGE WS-FOUND WS-RX WS-RY WS-RZ
     MOVE "acceptance US15 44-4§11.1 then (2, 0, 0)" TO TL-CASE
     MOVE 0 TO TL-OBSERVED-N
     IF WS-FOUND = 1 AND WS-RX = WS-PX + 2 AND WS-RZ = WS-PZ
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     COMPUTE WS-CX = WS-PX + 2
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-CX WS-PY WS-PZ WS-AIR
*>   The vertical reach is 1: water 2 up is not seen, 1 up is; the horizontal reach 7: 8 away is not seen, 7 away is.
     COMPUTE WS-CY = WS-PY + 2
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-PX WS-CY WS-PZ WS-WATER
     CALL "TURTLE-LOOK-FOR-WATER" USING WS-ROW WS-RANGE WS-FOUND WS-RX WS-RY WS-RZ
     MOVE "acceptance US15 44-4§11.1 water 2 blocks up is out of the vertical reach" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-FOUND TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-PX WS-CY WS-PZ WS-AIR
     COMPUTE WS-CY = WS-PY + 1
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-PX WS-CY WS-PZ WS-WATER
     CALL "TURTLE-LOOK-FOR-WATER" USING WS-ROW WS-RANGE WS-FOUND WS-RX WS-RY WS-RZ
     MOVE "acceptance US15 44-4§11.1 water 1 block up is found" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE WS-FOUND TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-PX WS-CY WS-PZ WS-AIR
     COMPUTE WS-CX = WS-PX + 8
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-CX WS-PY WS-PZ WS-WATER
     CALL "TURTLE-LOOK-FOR-WATER" USING WS-ROW WS-RANGE WS-FOUND WS-RX WS-RY WS-RZ
     MOVE "acceptance US15 44-4§11.1 water 8 blocks away is out of the horizontal reach of 7" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-FOUND TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-CX WS-PY WS-PZ WS-AIR
     COMPUTE WS-CX = WS-PX + 7
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-CX WS-PY WS-PZ WS-WATER
     CALL "TURTLE-LOOK-FOR-WATER" USING WS-ROW WS-RANGE WS-FOUND WS-RX WS-RY WS-RZ
     MOVE "acceptance US15 44-4§11.1 water 7 blocks away is found" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE WS-FOUND TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   Panic: with water at 7 east the flee point is mirrored (the flee walk then leads east); the player is dropped from the flee.
     MOVE 20 TO EN-FLEE(WS-ROW)
     MOVE WS-PLAYER TO EN-FLEE-PLAYER(WS-ROW)
     MOVE PL-ENTITY-ID(WS-PLAYER) TO EN-FLEE-ID(WS-ROW)
     CALL "TURTLE-TICK" USING WS-ROW WS-HX WS-HZ WS-WALK
     MOVE "acceptance US15 44-4§11 a panicking turtle with water near flees toward it (the flee point is west)" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF EN-FLEE-X(WS-ROW) < EN-X(WS-ROW) - 5.9 AND EN-FLEE-ID(WS-ROW) = 0
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-CX WS-PY WS-PZ WS-AIR
     MOVE PL-ENTITY-ID(WS-PLAYER) TO EN-FLEE-ID(WS-ROW)
     CALL "TURTLE-TICK" USING WS-ROW WS-HX WS-HZ WS-WALK
     MOVE "acceptance US15 44-4§11 without water near the flee from the attacker goes on" TO TL-CASE
     MOVE PL-ENTITY-ID(WS-PLAYER) TO TL-EXPECTED-N
     MOVE EN-FLEE-ID(WS-ROW) TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   Inside a block with a collision shape the turtle looks for nothing.
     COMPUTE WS-CX = WS-PX + 2
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-CX WS-PY WS-PZ WS-WATER
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-PX WS-PY WS-PZ WS-STONE
     CALL "TURTLE-LOOK-FOR-WATER" USING WS-ROW WS-RANGE WS-FOUND WS-RX WS-RY WS-RZ
     MOVE "acceptance US15 44-4§11.1 inside a solid block nothing is looked for" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-FOUND TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.
 END PROGRAM TEST-TURTLE-WATER.

 COPY CORETEST.
 COPY MOBSPTEST.
