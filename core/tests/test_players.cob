*> Implementation test of the player table (core/src/players.cob; data-model §6): a new player record
*> has the offline identity, the configured default game mode (FR-007, FR-009), the world spawn point
*> facing east, full health and food (standin-content §5.2, §10.1, §11.1); lookup by name, leaving,
*> the online count, and the host and guest rules of single-player and opened worlds (FR-016, FR-017).
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-PLAYERS.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY COREAPI.
 COPY CORESTATE.
 COPY TESTLIB.
 01 WS-KIND                BINARY-LONG.
 01 WS-ID                  BINARY-LONG.
 01 WS-ROW                 BINARY-LONG.
 01 WS-ROW2                BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-COUNT               BINARY-LONG.
 01 WS-NAME                PIC X(16).
 01 WS-NAME-LENGTH         BINARY-LONG.
 01 WS-UUID                PIC X(16) VALUE "0123456789abcdef".
 01 WS-EDIT                PIC -(9)9.
 PROCEDURE DIVISION.
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     MOVE 0 TO CS-DEFAULT-MODE
     MOVE 12 TO CS-VIEW-DISTANCE
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     MOVE CORE-CONN-MEMORY TO WS-KIND
     CALL "CORE-CONN-OPEN" USING WS-KIND WS-ID
     MOVE "Alice" TO WS-NAME
     MOVE 5 TO WS-NAME-LENGTH
     CALL "PLAYER-CREATE" USING WS-ID WS-NAME WS-NAME-LENGTH WS-UUID WS-ROW
     MOVE "test players a new player has the offline identity and is joining on its connection"
         TO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE "1 Alice 5 0123456789abcdef 1 1 0 1" TO TL-EXPECTED
     MOVE SPACES TO TL-OBSERVED
     STRING "1 " PL-NAME(WS-ROW)(1:PL-NAME-LENGTH(WS-ROW)) " " DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE PL-NAME-LENGTH(WS-ROW) TO WS-EDIT
     PERFORM APPEND-EDIT
     STRING FUNCTION TRIM(TL-OBSERVED) " " PL-UUID(WS-ROW) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE CN-PLAYER(WS-ID) TO WS-EDIT
     PERFORM APPEND-EDIT
     MOVE PL-CONN(WS-ROW) TO WS-EDIT
     PERFORM APPEND-EDIT
     MOVE PL-STATE(WS-ROW) TO WS-EDIT
     PERFORM APPEND-EDIT
     MOVE PL-ENTITY-ID(WS-ROW) TO WS-EDIT
     PERFORM APPEND-EDIT
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test players a new player gets the configured default game mode (survival)" TO TL-CASE
     MOVE "N" TO TL-MODE
     MOVE 0 TO TL-EXPECTED-N
     MOVE PL-MODE(WS-ROW) TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test players a new player stands at the spawn (4.5 54 8.5) facing east (yaw -90, pitch 0) in main"
         TO TL-CASE
     MOVE "T" TO TL-MODE
     MOVE "45 540 85 -90 0 1 1 0 0" TO TL-EXPECTED
     MOVE SPACES TO TL-OBSERVED
     COMPUTE WS-EDIT = PL-X(WS-ROW) * 10
     PERFORM APPEND-EDIT
     COMPUTE WS-EDIT = PL-Y(WS-ROW) * 10
     PERFORM APPEND-EDIT
     COMPUTE WS-EDIT = PL-Z(WS-ROW) * 10
     PERFORM APPEND-EDIT
     MOVE PL-YAW(WS-ROW) TO WS-EDIT
     PERFORM APPEND-EDIT
     MOVE PL-PITCH(WS-ROW) TO WS-EDIT
     PERFORM APPEND-EDIT
     MOVE PL-DIM(WS-ROW) TO WS-EDIT
     PERFORM APPEND-EDIT
     MOVE PL-ON-GROUND(WS-ROW) TO WS-EDIT
     PERFORM APPEND-EDIT
     MOVE PL-CENTER-X(WS-ROW) TO WS-EDIT
     PERFORM APPEND-EDIT
     MOVE PL-CENTER-Z(WS-ROW) TO WS-EDIT
     PERFORM APPEND-EDIT
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test players a new player has full health 30 and food 24, held slot 0, empty inventory, view 12"
         TO TL-CASE
     MOVE "30 24 0 0 0 12 0" TO TL-EXPECTED
     MOVE SPACES TO TL-OBSERVED
     MOVE PL-HEALTH(WS-ROW) TO WS-EDIT
     PERFORM APPEND-EDIT
     MOVE PL-FOOD(WS-ROW) TO WS-EDIT
     PERFORM APPEND-EDIT
     MOVE PL-HELD(WS-ROW) TO WS-EDIT
     PERFORM APPEND-EDIT
     MOVE 0 TO WS-COUNT
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 36
         ADD PL-SLOT-COUNT(WS-ROW, WS-I) TO WS-COUNT
     END-PERFORM
     MOVE WS-COUNT TO WS-EDIT
     PERFORM APPEND-EDIT
     MOVE PL-FLYING(WS-ROW) TO WS-EDIT
     PERFORM APPEND-EDIT
     MOVE PL-VIEW-DISTANCE(WS-ROW) TO WS-EDIT
     PERFORM APPEND-EDIT
     MOVE PL-OPERATOR(WS-ROW) TO WS-EDIT
     PERFORM APPEND-EDIT
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     CALL "CORE-CONN-OPEN" USING WS-KIND WS-ID
     MOVE "Bob" TO WS-NAME
     MOVE 3 TO WS-NAME-LENGTH
     CALL "PLAYER-CREATE" USING WS-ID WS-NAME WS-NAME-LENGTH WS-UUID WS-ROW2
     MOVE "Alice" TO WS-NAME
     MOVE 5 TO WS-NAME-LENGTH
     CALL "PLAYER-FIND-NAME" USING WS-NAME WS-NAME-LENGTH WS-I
     MOVE "test players find by name; a second player gets the next row and entity id" TO TL-CASE
     MOVE "1 2 2" TO TL-EXPECTED
     MOVE SPACES TO TL-OBSERVED
     MOVE WS-I TO WS-EDIT
     PERFORM APPEND-EDIT
     MOVE WS-ROW2 TO WS-EDIT
     PERFORM APPEND-EDIT
     MOVE PL-ENTITY-ID(WS-ROW2) TO WS-EDIT
     PERFORM APPEND-EDIT
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "Alicf" TO WS-NAME
     CALL "PLAYER-FIND-NAME" USING WS-NAME WS-NAME-LENGTH WS-I
     MOVE "test players an unknown name is not found" TO TL-CASE
     MOVE "N" TO TL-MODE
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-I TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE PH-PLAY TO CN-PHASE(PL-CONN(WS-ROW2))
     CALL "PLAYERS-ONLINE" USING WS-COUNT
     MOVE "test players only players whose connection is in play are online" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE WS-COUNT TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     CALL "PLAYER-LEAVE" USING WS-ROW2
     CALL "PLAYERS-ONLINE" USING WS-COUNT
     MOVE "test players a player who leaves frees the row and the connection's player" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-COUNT * 100 + PL-USED(WS-ROW2) * 10 + CN-PLAYER(WS-ID)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 0 TO PL-CONN(WS-ROW)
     CALL "PLAYER-LEAVE" USING WS-ROW
     MOVE "test players a row without a connection can leave" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE PL-USED(WS-ROW) TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

*>   World opened to others (host kind 2): the host is operator with the default mode; guests get
*>   the guest mode and the guest-operator flag.
     MOVE 2 TO CS-HOST-KIND
     MOVE "Host" TO CS-HOST-NAME
     MOVE 1 TO CS-DEFAULT-MODE
     MOVE 0 TO CS-GUEST-MODE
     MOVE 1 TO CS-GUEST-OPERATOR
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     CALL "CORE-CONN-OPEN" USING WS-KIND WS-ID
     MOVE "Host" TO WS-NAME
     MOVE 4 TO WS-NAME-LENGTH
     CALL "PLAYER-CREATE" USING WS-ID WS-NAME WS-NAME-LENGTH WS-UUID WS-ROW
     CALL "CORE-CONN-OPEN" USING WS-KIND WS-ID
     MOVE "Guest" TO WS-NAME
     MOVE 5 TO WS-NAME-LENGTH
     CALL "PLAYER-CREATE" USING WS-ID WS-NAME WS-NAME-LENGTH WS-UUID WS-ROW2
     MOVE "test players opened world: host mode 1 operator, guest mode 0 operator per setting" TO TL-CASE
     MOVE 1101 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = PL-MODE(WS-ROW) * 1000 + PL-OPERATOR(WS-ROW) * 100
         + PL-MODE(WS-ROW2) * 10 + PL-OPERATOR(WS-ROW2)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     PERFORM VARYING WS-I FROM 3 BY 1 UNTIL WS-I > 64
         CALL "PLAYER-CREATE" USING WS-ID WS-NAME WS-NAME-LENGTH WS-UUID WS-ROW
     END-PERFORM
     CALL "PLAYER-CREATE" USING WS-ID WS-NAME WS-NAME-LENGTH WS-UUID WS-ROW
     MOVE "test players a full player table gives row 0" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-ROW TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 APPEND-EDIT.
     STRING FUNCTION TRIM(TL-OBSERVED) " " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE
         INTO TL-OBSERVED.
 END PROGRAM TEST-PLAYERS.

 COPY CORETEST.
