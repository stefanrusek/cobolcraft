*> Test of the player effect store (core/src/effects.cob): Update Mob Effect and Remove Mob Effect packets, the replace rule
*> of a second application, duration ticking, infinite duration, removal, clearing, a reused row, and TOOL-BREAK-MODS reading
*> haste and mining fatigue (49 section 2.4 ids: haste 2, mining_fatigue 3; 05b 0x4F and 0x87).
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-EFFECTS.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY COREAPI.
 COPY CORESTATE.
 COPY PROTO.
 01 WS-NAME                PIC X(16) VALUE "Alice".
 01 WS-NAME-LENGTH         BINARY-LONG VALUE 5.
 01 WS-CONN                BINARY-LONG.
 01 WS-ROW                 BINARY-LONG.
 01 WS-EFFECT              BINARY-LONG.
 01 WS-AMP                 BINARY-LONG.
 01 WS-DUR                 BINARY-LONG.
 01 WS-FLAGS               BINARY-LONG.
 01 WS-LEVEL               BINARY-LONG.
 01 WS-REMAIN              BINARY-LONG.
 01 WS-PACKET              BINARY-LONG.
 01 WS-FOUND               BINARY-LONG.
 01 WS-A                   BINARY-LONG.
 01 WS-B                   BINARY-LONG.
 01 WS-C                   BINARY-LONG.
 01 WS-D                   BINARY-LONG.
 01 WS-E1                  PIC -(9)9.
 01 WS-E2                  PIC -(9)9.
 01 WS-E3                  PIC -(9)9.
 01 WS-E4                  PIC -(9)9.
 01 WS-EFFICIENCY          BINARY-LONG.
 01 WS-HASTE               BINARY-LONG.
 01 WS-FATIGUE             BINARY-LONG.
 01 WS-WATER               BINARY-LONG.
 01 WS-COUNT               BINARY-LONG.
 01 WS-TEXT                PIC X(1024).
 PROCEDURE DIVISION.
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     CALL "TEST-JOIN" USING WS-NAME WS-NAME-LENGTH WS-CONN
     MOVE CN-PLAYER(WS-CONN) TO WS-ROW

     MOVE "acceptance US14 effects: a new haste II of 5 ticks sends Update Mob Effect (entity, effect 2, amplifier 1, duration 5, flags 6)" TO TL-CASE
     MOVE 2 TO WS-EFFECT
     MOVE 1 TO WS-AMP
     MOVE 5 TO WS-DUR
     MOVE 6 TO WS-FLAGS
     CALL "EFFECT-ADD" USING WS-ROW WS-EFFECT WS-AMP WS-DUR WS-FLAGS
     MOVE 135 TO WS-PACKET
     PERFORM UPDATE-BODY
     MOVE SPACES TO TL-OBSERVED
     STRING "found " FUNCTION TRIM(WS-E1) " effect " FUNCTION TRIM(WS-E2) " amp " FUNCTION TRIM(WS-E3)
         " duration " FUNCTION TRIM(WS-E4) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "found 1 effect 2 amp 1 duration 5" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 effects: the level of haste is amplifier + 1 (2), of an absent effect 0, the remaining ticks 5" TO TL-CASE
     CALL "EFFECT-LEVEL" USING WS-ROW WS-EFFECT WS-LEVEL WS-REMAIN
     MOVE WS-LEVEL TO WS-E1
     MOVE WS-REMAIN TO WS-E2
     MOVE 3 TO WS-A
     CALL "EFFECT-LEVEL" USING WS-ROW WS-A WS-LEVEL WS-DUR
     MOVE WS-LEVEL TO WS-E3
     MOVE SPACES TO TL-OBSERVED
     STRING FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) " " FUNCTION TRIM(WS-E3) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "2 5 0" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 effects: TOOL-BREAK-MODS reads haste 2 and fatigue 0" TO TL-CASE
     CALL "TOOL-BREAK-MODS" USING WS-ROW WS-EFFICIENCY WS-HASTE WS-FATIGUE WS-WATER
     MOVE WS-HASTE TO WS-E1
     MOVE WS-FATIGUE TO WS-E2
     MOVE SPACES TO TL-OBSERVED
     STRING FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "2 0" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 effects: a weaker amplifier does not replace a stronger one, an equal amplifier with a longer duration does" TO TL-CASE
     MOVE 0 TO WS-AMP
     MOVE 100 TO WS-DUR
     CALL "EFFECT-ADD" USING WS-ROW WS-EFFECT WS-AMP WS-DUR WS-FLAGS
     CALL "EFFECT-LEVEL" USING WS-ROW WS-EFFECT WS-LEVEL WS-REMAIN
     MOVE WS-LEVEL TO WS-E1
     MOVE WS-REMAIN TO WS-E2
     MOVE 1 TO WS-AMP
     MOVE 50 TO WS-DUR
     CALL "EFFECT-ADD" USING WS-ROW WS-EFFECT WS-AMP WS-DUR WS-FLAGS
     CALL "EFFECT-LEVEL" USING WS-ROW WS-EFFECT WS-LEVEL WS-REMAIN
     MOVE 10 TO WS-DUR
     CALL "EFFECT-ADD" USING WS-ROW WS-EFFECT WS-AMP WS-DUR WS-FLAGS
     CALL "EFFECT-LEVEL" USING WS-ROW WS-EFFECT WS-LEVEL WS-REMAIN
     MOVE WS-LEVEL TO WS-E3
     MOVE WS-REMAIN TO WS-E4
     MOVE SPACES TO TL-OBSERVED
     STRING FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) " " FUNCTION TRIM(WS-E3) " " FUNCTION TRIM(WS-E4)
         DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "2 5 2 50" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 effects: a stronger amplifier replaces (haste III, 10 ticks)" TO TL-CASE
     MOVE 2 TO WS-AMP
     MOVE 10 TO WS-DUR
     CALL "EFFECT-ADD" USING WS-ROW WS-EFFECT WS-AMP WS-DUR WS-FLAGS
     CALL "EFFECT-LEVEL" USING WS-ROW WS-EFFECT WS-LEVEL WS-REMAIN
     MOVE WS-LEVEL TO WS-E1
     MOVE WS-REMAIN TO WS-E2
     MOVE SPACES TO TL-OBSERVED
     STRING FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "3 10" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 effects: an effect of 3 ticks runs out after 3 ticks and Remove Mob Effect (0x4F) is sent" TO TL-CASE
     MOVE 3 TO WS-EFFECT
     MOVE 0 TO WS-AMP
     MOVE 3 TO WS-DUR
     CALL "EFFECT-ADD" USING WS-ROW WS-EFFECT WS-AMP WS-DUR WS-FLAGS
     CALL "TEST-DRAIN-IDS" USING WS-CONN WS-TEXT
     MOVE 3 TO WS-COUNT
     CALL "EFFECTS-TICK"
     CALL "EFFECTS-TICK"
     CALL "EFFECT-LEVEL" USING WS-ROW WS-EFFECT WS-LEVEL WS-REMAIN
     MOVE WS-LEVEL TO WS-E1
     MOVE WS-REMAIN TO WS-E2
     CALL "EFFECTS-TICK"
     CALL "EFFECT-LEVEL" USING WS-ROW WS-EFFECT WS-LEVEL WS-REMAIN
     MOVE WS-LEVEL TO WS-E3
     MOVE 79 TO WS-PACKET
     PERFORM REMOVE-BODY
     MOVE SPACES TO TL-OBSERVED
     STRING "after2 " FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) " after3 " FUNCTION TRIM(WS-E3)
         " removed " FUNCTION TRIM(WS-E4) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "after2 1 1 after3 0 removed 3" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 effects: an infinite effect (duration -1) does not tick down; EFFECT-REMOVE ends it and sends the packet" TO TL-CASE
     MOVE 3 TO WS-EFFECT
     MOVE 4 TO WS-AMP
     MOVE -1 TO WS-DUR
     CALL "EFFECT-ADD" USING WS-ROW WS-EFFECT WS-AMP WS-DUR WS-FLAGS
     MOVE 5 TO WS-DUR
     CALL "EFFECT-ADD" USING WS-ROW WS-EFFECT WS-AMP WS-DUR WS-FLAGS
     MOVE 100 TO WS-COUNT
     PERFORM UNTIL WS-COUNT = 0
         CALL "EFFECTS-TICK"
         SUBTRACT 1 FROM WS-COUNT
     END-PERFORM
     CALL "TOOL-BREAK-MODS" USING WS-ROW WS-EFFICIENCY WS-HASTE WS-FATIGUE WS-WATER
     MOVE WS-FATIGUE TO WS-E1
     CALL "EFFECT-REMOVE" USING WS-ROW WS-EFFECT
     CALL "EFFECT-REMOVE" USING WS-ROW WS-EFFECT
     CALL "EFFECT-LEVEL" USING WS-ROW WS-EFFECT WS-LEVEL WS-REMAIN
     MOVE WS-LEVEL TO WS-E2
     MOVE SPACES TO TL-OBSERVED
     STRING "fatigue " FUNCTION TRIM(WS-E1) " after " FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "fatigue 5 after 0" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 effects: EFFECT-CLEAR-ALL removes every effect of the player (milk bucket, death) with a packet each" TO TL-CASE
     MOVE 2 TO WS-EFFECT
     MOVE 0 TO WS-AMP
     MOVE 500 TO WS-DUR
     CALL "EFFECT-ADD" USING WS-ROW WS-EFFECT WS-AMP WS-DUR WS-FLAGS
     MOVE 3 TO WS-EFFECT
     CALL "EFFECT-ADD" USING WS-ROW WS-EFFECT WS-AMP WS-DUR WS-FLAGS
     CALL "EFFECT-CLEAR-ALL" USING WS-ROW
     CALL "TOOL-BREAK-MODS" USING WS-ROW WS-EFFICIENCY WS-HASTE WS-FATIGUE WS-WATER
     MOVE WS-HASTE TO WS-E1
     MOVE WS-FATIGUE TO WS-E2
     MOVE SPACES TO TL-OBSERVED
     STRING FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "0 0" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 effects: an effect id outside 0 to 39 is refused (no state, level 0)" TO TL-CASE
     MOVE 40 TO WS-EFFECT
     CALL "EFFECT-ADD" USING WS-ROW WS-EFFECT WS-AMP WS-DUR WS-FLAGS
     CALL "EFFECT-LEVEL" USING WS-ROW WS-EFFECT WS-LEVEL WS-REMAIN
     MOVE WS-LEVEL TO WS-E1
     CALL "EFFECT-REMOVE" USING WS-ROW WS-EFFECT
     MOVE SPACES TO TL-OBSERVED
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "0" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 effects: an effect left on a row that another player takes over is not seen by the new player" TO TL-CASE
     MOVE 2 TO WS-EFFECT
     CALL "EFFECT-ADD" USING WS-ROW WS-EFFECT WS-AMP WS-DUR WS-FLAGS
     MOVE 3 TO WS-A
     CALL "EFFECT-ADD" USING WS-ROW WS-A WS-AMP WS-DUR WS-FLAGS
     ADD 1000 TO PL-ENTITY-ID(WS-ROW)
     CALL "EFFECT-REMOVE" USING WS-ROW WS-A
     CALL "EFFECT-LEVEL" USING WS-ROW WS-EFFECT WS-LEVEL WS-REMAIN
     MOVE WS-LEVEL TO WS-E1
     CALL "EFFECTS-TICK"
     MOVE SPACES TO TL-OBSERVED
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "0" TO TL-EXPECTED
     PERFORM CHECK-DONE
     STOP RUN.

 UPDATE-BODY.
     CALL "TEST-DRAIN-PACKET" USING WS-CONN WS-PACKET PB-BUFFER WS-FOUND
     CALL "PB-GET-VARINT" USING PB-BUFFER WS-PACKET
     CALL "PB-GET-VARINT" USING PB-BUFFER WS-A
     CALL "PB-GET-VARINT" USING PB-BUFFER WS-B
     CALL "PB-GET-VARINT" USING PB-BUFFER WS-C
     CALL "PB-GET-VARINT" USING PB-BUFFER WS-D
     MOVE WS-FOUND TO WS-E1
     MOVE WS-B TO WS-E2
     MOVE WS-C TO WS-E3
     MOVE WS-D TO WS-E4.

 REMOVE-BODY.
     CALL "TEST-DRAIN-PACKET" USING WS-CONN WS-PACKET PB-BUFFER WS-FOUND
     CALL "PB-GET-VARINT" USING PB-BUFFER WS-PACKET
     CALL "PB-GET-VARINT" USING PB-BUFFER WS-A
     CALL "PB-GET-VARINT" USING PB-BUFFER WS-B
     MOVE WS-B TO WS-E4.

 CHECK-DONE.
     MOVE "T" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-EFFECTS.

 COPY CORETEST.
