     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 40-7§6 The screen: 6.6 wheel: after the generic handler, when it did not consume and" &
         " the screen can scroll the wheel scrolls and consumes (generic consumed, can scroll -> scroll" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN7-WHEEL" USING WS-I1 WS-I2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN7-WHEEL" USING WS-I1 WS-I2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN7-WHEEL" USING WS-I1 WS-I2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN7-WHEEL" USING WS-I1 WS-I2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1/1 0/1 0/0 0/1" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 40-7§6 The screen: 6.2, 6.6 screen canScroll: the tab flag and the menu's canScroll " &
         "(tab flag, menu can scroll -> can scroll)" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN7-CANSC" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN7-CANSC" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN7-CANSC" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN7-CANSC" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 0 1" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 40-7§6 The screen: 6.2 step 4 scrollbar cursor: in the box, resize north-south while" &
         " dragging and able to scroll (1), the hand when able to scroll (2), not allowed when it cannot" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0 0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN7-CURSORBAR" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN7-CURSORBAR" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN7-CURSORBAR" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN7-CURSORBAR" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN7-CURSORBAR" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 1 2 3 3" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 40-7§6 The screen: 6.2 survival tab delete slot tooltip inventory.binSlot (Destroy I" &
         "tem): shown when the survival tab is selected and the pointer is over the 16 x 16 delete slot" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "2 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN7-DELTIP" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "2 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN7-DELTIP" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN7-DELTIP" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "4 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "MN7-DELTIP" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
