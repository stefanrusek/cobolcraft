*> Implementation test of the Nether's legacy random sources (core/src/nether-37-2.cob; T1641, T1642; docs/protocol/37-nether-2
*> section 4 and its worked values 12.1 and 12.2): Java String.hashCode of the noise names, the legacy generator's reference
*> draws (seed 0), the master factory seed F = -4962768465676381896, the named noises built with the legacy factory
*> (netherrack, nether_state_selector, nether_wart) and the legacy Nether-biome temperature and vegetation noises
*> (quantised values at seeds 0 and 12345). Float values are compared at 1e-8 (the document prints 8 digits).
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-NETHER-37-2-4.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY NOISE.
 COPY NETHER.
 01 WS-TMP                 PIC X(240).
 01 WS-NAME                PIC X(64).
 01 WS-LEN                 BINARY-LONG.
 01 WS-HASH                BINARY-LONG.
 01 WS-STATE               BINARY-DOUBLE UNSIGNED.
 01 WS-SEED                BINARY-DOUBLE SIGNED.
 01 WS-U64                 BINARY-DOUBLE UNSIGNED.
 01 WS-A                   BINARY-DOUBLE.
 01 WS-B                   BINARY-DOUBLE.
 01 WS-F                   FLOAT-LONG.
 01 WS-X                   FLOAT-LONG.
 01 WS-Y                   FLOAT-LONG.
 01 WS-Z                   FLOAT-LONG.
 01 WS-V                   FLOAT-LONG.
 01 WS-SCALED              FLOAT-LONG.
 01 WS-BITS                BINARY-LONG VALUE 32.
 01 WS-Q                   BINARY-DOUBLE.
 01 WS-HANDLE              BINARY-LONG.
 01 WS-WHICH               BINARY-LONG.
 01 WS-WANT                BINARY-DOUBLE.
 01 WS-DIFF                BINARY-DOUBLE.
 PROCEDURE DIVISION.
     MOVE "N" TO TL-MODE

     PERFORM CHECK-HASHES
     PERFORM CHECK-LCG
     PERFORM CHECK-NAMED
     PERFORM CHECK-CLIMATE
     GOBACK.

 CHECK-HASHES.
     MOVE "acceptance US12 37-2§4 hash minecraft:terrain = 1657813608" TO TL-CASE
     MOVE "minecraft:terrain" TO WS-NAME
     MOVE 17 TO WS-LEN
     CALL "NETHER-JHASH" USING WS-NAME WS-LEN WS-HASH
     MOVE 1657813608 TO TL-EXPECTED-N
     MOVE WS-HASH TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 37-2§4 hash minecraft:bedrock_floor = 2042456806" TO TL-CASE
     MOVE "minecraft:bedrock_floor" TO WS-NAME
     MOVE 23 TO WS-LEN
     CALL "NETHER-JHASH" USING WS-NAME WS-LEN WS-HASH
     MOVE 2042456806 TO TL-EXPECTED-N
     MOVE WS-HASH TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 37-2§4 hash minecraft:bedrock_roof = 343340730" TO TL-CASE
     MOVE "minecraft:bedrock_roof" TO WS-NAME
     MOVE 22 TO WS-LEN
     CALL "NETHER-JHASH" USING WS-NAME WS-LEN WS-HASH
     MOVE 343340730 TO TL-EXPECTED-N
     MOVE WS-HASH TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 37-2§4 hash minecraft:patch = -1137280965 (negative)" TO TL-CASE
     MOVE "minecraft:patch" TO WS-NAME
     MOVE 15 TO WS-LEN
     CALL "NETHER-JHASH" USING WS-NAME WS-LEN WS-HASH
     MOVE -1137280965 TO TL-EXPECTED-N
     MOVE WS-HASH TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 37-2§4 hash minecraft:netherrack = 303935260" TO TL-CASE
     MOVE "minecraft:netherrack" TO WS-NAME
     MOVE 20 TO WS-LEN
     CALL "NETHER-JHASH" USING WS-NAME WS-LEN WS-HASH
     MOVE 303935260 TO TL-EXPECTED-N
     MOVE WS-HASH TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 CHECK-LCG.
     MOVE 0 TO WS-U64
     CALL "JRAND-SET-SEED" USING WS-STATE WS-U64
     CALL "JRAND-NEXT" USING WS-STATE WS-BITS WS-A
     CALL "JRAND-NEXT" USING WS-STATE WS-BITS WS-B
     MOVE "acceptance US12 37-2§4 legacy seed 0 nextInt = -1155484576" TO TL-CASE
     MOVE -1155484576 TO TL-EXPECTED-N
     MOVE WS-A TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 37-2§4 legacy seed 0 second nextInt = -723955400" TO TL-CASE
     MOVE -723955400 TO TL-EXPECTED-N
     MOVE WS-B TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "JRAND-NEXT-LONG" USING WS-STATE WS-U64
     MOVE "acceptance US12 37-2§4 legacy seed 0 then nextLong = 4437113781045784766" TO TL-CASE
     MOVE 4437113781045784766 TO TL-EXPECTED-N
     MOVE WS-U64 TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "NETHER-RAND-DOUBLE" USING WS-STATE WS-F
     MOVE "acceptance US12 37-2§4 legacy then nextDouble = 0.6374174253501083 (1e-15)" TO TL-CASE
     MOVE 637417425350108 TO TL-EXPECTED-N
     COMPUTE WS-SCALED = WS-F * 1000000000000000
     COMPUTE TL-OBSERVED-N ROUNDED = WS-SCALED
     COMPUTE WS-DIFF = TL-OBSERVED-N - TL-EXPECTED-N
     IF WS-DIFF >= -1 AND WS-DIFF <= 1
         MOVE TL-EXPECTED-N TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 0 TO WS-SEED
     CALL "NETHER-SETUP" USING WS-SEED
     MOVE "acceptance US12 37-2§4 master factory seed F of world seed 0" TO TL-CASE
     MOVE -4962768465676381896 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = NH-FS - 18446744073709551616
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 37-2§4 bedrock floor factory seed -7693059141002965223" TO TL-CASE
     MOVE -7693059141002965223 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = NH-FLOOR-FS - 18446744073709551616
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 37-2§12 12.5 bedrock roof factory seed 4929288967059825655" TO TL-CASE
     MOVE 4929288967059825655 TO TL-EXPECTED-N
     MOVE NH-ROOF-FS TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 CHECK-NAMED.
     MOVE 3 TO WS-WHICH
     MOVE 0 TO WS-X
     MOVE 0 TO WS-Y
     MOVE 0 TO WS-Z
     MOVE -12841822 TO WS-WANT
     MOVE "netherrack get(0, 0, 0) = -0.12841822 (12.2)" TO TL-CASE
     PERFORM CHECK-NOISE
     MOVE 10 TO WS-X
     MOVE -7 TO WS-Z
     MOVE 25088963 TO WS-WANT
     MOVE "netherrack get(10, 0, -7) = 0.25088963 (12.2)" TO TL-CASE
     PERFORM CHECK-NOISE
     MOVE 123 TO WS-X
     MOVE 456 TO WS-Z
     MOVE 54354382 TO WS-WANT
     MOVE "netherrack get(123, 0, 456) = 0.54354382 (12.2)" TO TL-CASE
     PERFORM CHECK-NOISE
     MOVE 2 TO WS-WHICH
     MOVE 0 TO WS-X
     MOVE 0 TO WS-Z
     MOVE -21776724 TO WS-WANT
     MOVE "nether_state_selector get(0, 0, 0) = -0.21776724 (12.2)" TO TL-CASE
     PERFORM CHECK-NOISE
     MOVE 10 TO WS-X
     MOVE -7 TO WS-Z
     MOVE 14769292 TO WS-WANT
     MOVE "nether_state_selector get(10, 0, -7) = 0.14769292 (12.2)" TO TL-CASE
     PERFORM CHECK-NOISE
     MOVE 123 TO WS-X
     MOVE 456 TO WS-Z
     MOVE -37847722 TO WS-WANT
     MOVE "nether_state_selector get(123, 0, 456) = -0.37847722 (12.2)" TO TL-CASE
     PERFORM CHECK-NOISE
     MOVE 4 TO WS-WHICH
     MOVE 0 TO WS-X
     MOVE 0 TO WS-Z
     MOVE -2168596 TO WS-WANT
     MOVE "nether_wart get(0, 0, 0) = -0.02168596 (12.2)" TO TL-CASE
     PERFORM CHECK-NOISE
     MOVE 10 TO WS-X
     MOVE -7 TO WS-Z
     MOVE 16548175 TO WS-WANT
     MOVE "nether_wart get(10, 0, -7) = 0.16548175 (12.2)" TO TL-CASE
     PERFORM CHECK-NOISE.

 CHECK-NOISE.
     MOVE TL-CASE TO WS-TMP
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 37-2§4 " FUNCTION TRIM(WS-TMP) DELIMITED BY SIZE INTO TL-CASE
     MOVE WS-WANT TO TL-EXPECTED-N
     CALL "NOISE-GET" USING NH-H-NOISE(WS-WHICH) WS-X WS-Y WS-Z WS-V
     PERFORM COMPARE-SCALED.

 COMPARE-SCALED.
     COMPUTE WS-SCALED = WS-V * 100000000
     COMPUTE TL-OBSERVED-N ROUNDED = WS-SCALED
     COMPUTE WS-DIFF = TL-OBSERVED-N - TL-EXPECTED-N
     IF WS-DIFF >= -1 AND WS-DIFF <= 1
         MOVE TL-EXPECTED-N TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 CHECK-CLIMATE.
     MOVE 0 TO WS-SEED
     CALL "NETHER-SETUP" USING WS-SEED
     MOVE 0 TO WS-X
     MOVE 0 TO WS-Y
     MOVE 0 TO WS-Z
     MOVE 1173 TO WS-WANT
     MOVE "seed 0 quart (0, 0) temperature quantised 1173" TO TL-CASE
     MOVE NH-H-TEMP TO WS-HANDLE
     PERFORM CHECK-QUANT
     MOVE -456 TO WS-WANT
     MOVE "seed 0 quart (0, 0) humidity quantised -456" TO TL-CASE
     MOVE NH-H-VEG TO WS-HANDLE
     PERFORM CHECK-QUANT
     MOVE 16 TO WS-X
     MOVE 16 TO WS-Z
     MOVE 2834 TO WS-WANT
     MOVE "seed 0 quart (16, 16) temperature quantised 2834" TO TL-CASE
     MOVE NH-H-TEMP TO WS-HANDLE
     PERFORM CHECK-QUANT
     MOVE 501 TO WS-WANT
     MOVE "seed 0 quart (16, 16) humidity quantised 501" TO TL-CASE
     MOVE NH-H-VEG TO WS-HANDLE
     PERFORM CHECK-QUANT
     MOVE -25 TO WS-X
     MOVE 40 TO WS-Z
     MOVE 1745 TO WS-WANT
     MOVE "seed 0 quart (-25, 40) temperature quantised 1745" TO TL-CASE
     MOVE NH-H-TEMP TO WS-HANDLE
     PERFORM CHECK-QUANT
     MOVE -3393 TO WS-WANT
     MOVE "seed 0 quart (-25, 40) humidity quantised -3393" TO TL-CASE
     MOVE NH-H-VEG TO WS-HANDLE
     PERFORM CHECK-QUANT
     MOVE 100 TO WS-X
     MOVE -100 TO WS-Z
     MOVE -1009 TO WS-WANT
     MOVE "seed 0 quart (100, -100) temperature quantised -1009" TO TL-CASE
     MOVE NH-H-TEMP TO WS-HANDLE
     PERFORM CHECK-QUANT
     MOVE -6818 TO WS-WANT
     MOVE "seed 0 quart (100, -100) humidity quantised -6818" TO TL-CASE
     MOVE NH-H-VEG TO WS-HANDLE
     PERFORM CHECK-QUANT
     MOVE 12345 TO WS-SEED
     CALL "NETHER-SETUP" USING WS-SEED
     MOVE 0 TO WS-X
     MOVE 0 TO WS-Z
     MOVE 620 TO WS-WANT
     MOVE "seed 12345 quart (0, 0) temperature quantised 620" TO TL-CASE
     MOVE NH-H-TEMP TO WS-HANDLE
     PERFORM CHECK-QUANT
     MOVE -936 TO WS-WANT
     MOVE "seed 12345 quart (0, 0) humidity quantised -936" TO TL-CASE
     MOVE NH-H-VEG TO WS-HANDLE
     PERFORM CHECK-QUANT
     MOVE 100 TO WS-X
     MOVE -100 TO WS-Z
     MOVE -1349 TO WS-WANT
     MOVE "seed 12345 quart (100, -100) temperature quantised -1349" TO TL-CASE
     MOVE NH-H-TEMP TO WS-HANDLE
     PERFORM CHECK-QUANT
     MOVE 4729 TO WS-WANT
     MOVE "seed 12345 quart (100, -100) humidity quantised 4729" TO TL-CASE
     MOVE NH-H-VEG TO WS-HANDLE
     PERFORM CHECK-QUANT.

 CHECK-QUANT.
     MOVE TL-CASE TO WS-TMP
     MOVE SPACES TO TL-CASE
     STRING "acceptance US12 37-2§12 12.1 " FUNCTION TRIM(WS-TMP) DELIMITED BY SIZE INTO TL-CASE
     MOVE WS-WANT TO TL-EXPECTED-N
     CALL "NOISE-GET" USING WS-HANDLE WS-X WS-Y WS-Z WS-V
     CALL "CLIMATE-F32-QUANTIZE" USING WS-V WS-Q
     MOVE WS-Q TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-NETHER-37-2-4.
