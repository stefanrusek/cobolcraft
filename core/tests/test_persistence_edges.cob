*> Implementation test of the world-folder readers on files other writers could produce (core/src/
*> persistence.cob; docs/protocol/07-nbt-and-anvil.md §1.2 "readers must not depend on order", §7.1,
*> §9): keys a reader does not know are skipped at every level (chunk section, block_states, palette
*> entry, entity, ground item stack, level.dat weather entry, access list entry, inventory entry); a
*> section whose Y is outside the dimension is ignored; an empty LevelName is written and read as an
*> empty name; a second save replaces the entities/ region files, so an entity that moved is stored
*> only in its new chunk.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-PERSISTENCE-EDGES.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY COREAPI.
 COPY DIMENSIONS.
 COPY ETIDS.
 COPY CELLS.
 COPY PROTO.
 01 WS-CAPACITY            BINARY-LONG VALUE 65536.
 01 WN                     PIC X(32).
 01 WL                     BINARY-LONG.
 01 WS-ELEMENT             BINARY-LONG VALUE -1.
 01 WS-ZERO                BINARY-LONG VALUE 0.
 01 WS-ONE                 BINARY-LONG VALUE 1.
 01 WS-TWO                 BINARY-LONG VALUE 2.
 01 WS-MINUS-ONE           BINARY-LONG VALUE -1.
 01 WS-THREE               BINARY-LONG VALUE 3.
 01 WS-FOUR                BINARY-LONG VALUE 4.
 01 WS-FIVE                BINARY-LONG VALUE 5.
 01 WS-T-STRING            BINARY-LONG VALUE 8.
 01 WS-T-DOUBLE            BINARY-LONG VALUE 6.
 01 WS-T-COMPOUND          BINARY-LONG VALUE 10.
 01 WS-INT                 BINARY-LONG.
 01 WS-DOUBLE              FLOAT-LONG.
 01 WS-TEXT                PIC X(64).
 01 WS-TEXT-LENGTH         BINARY-LONG.
 01 WS-DIM                 BINARY-LONG VALUE 1.
 01 WS-CX                  BINARY-LONG.
 01 WS-CZ                  BINARY-LONG.
 01 WS-ROW                 BINARY-LONG.
 01 WS-OUTCOME             BINARY-LONG.
 01 WS-KNOWN               BINARY-LONG.
 01 WS-PATH                PIC X(256).
 01 WS-PATH-LENGTH         BINARY-LONG.
 01 WS-NAME                PIC X(16) VALUE "Bob".
 01 WS-NAME-LENGTH         BINARY-LONG VALUE 3.
 01 WS-UUID                PIC X(16).
 01 WS-UUID-TEXT           PIC X(36).
 01 WS-TO-INTS             BINARY-LONG VALUE 0.
 01 WS-INTS.
    05 WS-INT-ITEM         BINARY-LONG OCCURS 4 TIMES.
 01 WS-VX                  FLOAT-LONG VALUE 0.
 01 WS-VY                  FLOAT-LONG VALUE 0.
 01 WS-VZ                  FLOAT-LONG VALUE 0.
 01 WS-X                   FLOAT-LONG VALUE 3.5.
 01 WS-Y                   FLOAT-LONG VALUE 60.
 01 WS-Z                   FLOAT-LONG VALUE 3.5.
 01 WS-ITEM                BINARY-LONG VALUE 3.
 01 WS-COUNT               BINARY-LONG VALUE 4.
 01 WS-DELAY               BINARY-LONG VALUE 0.
 01 WS-ENTITIES            PIC X(128) VALUE
     "build/core-test-world/dimensions/cobolcraft/main/entities".
 01 WS-ENTITIES-LENGTH     BINARY-LONG VALUE 57.
 01 WS-I                   BINARY-LONG.
 01 WS-OBSERVED            PIC X(1024).
 01 WS-EDIT                PIC -(10)9.
 PROCEDURE DIVISION.
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     MOVE 0 TO CS-HOSTILE-MOBS
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY

*>   A chunk payload with unknown keys, a palette entry {id, extra} and a section with Y 99.
     MOVE "test persistence edges a chunk with unknown keys at every level reads; a section with "
         & "Y outside the dimension is ignored" TO TL-CASE
     PERFORM ROOT-BEGIN
     MOVE "sections" TO WN MOVE 8 TO WL
     CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WN WL WS-T-COMPOUND WS-TWO
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WS-ELEMENT
     MOVE "Y" TO WN MOVE 1 TO WL
     CALL "NBT-WRITE-BYTE" USING PB-BUFFER WN WL WS-THREE
     PERFORM WRITE-EXTRA
     MOVE "block_states" TO WN MOVE 12 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     PERFORM WRITE-EXTRA
     MOVE "palette" TO WN MOVE 7 TO WL
     CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WN WL WS-T-COMPOUND WS-ONE
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WS-ELEMENT
     MOVE "id" TO WN MOVE 2 TO WL
     MOVE "cobolcraft:lucite" TO WS-TEXT MOVE 17 TO WS-TEXT-LENGTH
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WN WL WS-TEXT WS-TEXT-LENGTH
     PERFORM WRITE-EXTRA
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WS-ELEMENT
     MOVE "Y" TO WN MOVE 1 TO WL
     MOVE 99 TO WS-INT
     CALL "NBT-WRITE-BYTE" USING PB-BUFFER WN WL WS-INT
     MOVE "block_states" TO WN MOVE 12 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     MOVE "palette" TO WN MOVE 7 TO WL
     CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WN WL WS-T-STRING WS-ONE
     MOVE "cobolcraft:loam" TO WS-TEXT MOVE 15 TO WS-TEXT-LENGTH
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WN WS-ELEMENT WS-TEXT WS-TEXT-LENGTH
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE 40 TO WS-CX WS-CZ
     CALL "WORLD-CHUNK-LOAD" USING WS-DIM WS-CX WS-CZ WS-ROW
     MOVE 0 TO PB-POS
     CALL "CHUNK-NBT-READ" USING WS-ROW PB-BUFFER WS-OUTCOME
     SET ADDRESS OF CE-CHUNK TO CK-ADDR(WS-ROW)
     MOVE SPACES TO WS-OBSERVED
     MOVE WS-OUTCOME TO WS-EDIT PERFORM ADD-EDIT
     MOVE CE-STATE(12289) TO WS-EDIT PERFORM ADD-EDIT
     MOVE CE-STATE(16384) TO WS-EDIT PERFORM ADD-EDIT
     MOVE CE-STATE(1) TO WS-EDIT PERFORM ADD-EDIT
     MOVE CE-STATE(65536) TO WS-EDIT PERFORM ADD-EDIT
     MOVE "0 12 12 0 0" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test persistence edges an entity with unknown keys, and a stack with one, reads"
         TO TL-CASE
     PERFORM ROOT-BEGIN
     MOVE "Entities" TO WN MOVE 8 TO WL
     CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WN WL WS-T-COMPOUND WS-ONE
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WS-ELEMENT
     MOVE "id" TO WN MOVE 2 TO WL
     MOVE "cobolcraft:loose_item" TO WS-TEXT MOVE 21 TO WS-TEXT-LENGTH
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WN WL WS-TEXT WS-TEXT-LENGTH
     PERFORM WRITE-EXTRA
     MOVE "Item" TO WN MOVE 4 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     MOVE "id" TO WN MOVE 2 TO WL
     MOVE "cobolcraft:grit" TO WS-TEXT MOVE 15 TO WS-TEXT-LENGTH
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WN WL WS-TEXT WS-TEXT-LENGTH
     PERFORM WRITE-EXTRA
     MOVE "count" TO WN MOVE 5 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL WS-FIVE
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE 0 TO PB-POS
     CALL "ENTITY-NBT-READ" USING WS-DIM PB-BUFFER WS-OUTCOME
     MOVE SPACES TO WS-OBSERVED
     MOVE WS-OUTCOME TO WS-EDIT PERFORM ADD-EDIT
     PERFORM VARYING WS-ROW FROM 1 BY 1 UNTIL WS-ROW > EN-COUNT
         IF EN-USED(WS-ROW) = 1 AND EN-TYPE(WS-ROW) = ET-LOOSE-ITEM
             MOVE EN-ITEM(WS-ROW) TO WS-EDIT PERFORM ADD-EDIT
             MOVE EN-ITEM-COUNT(WS-ROW) TO WS-EDIT PERFORM ADD-EDIT
             CALL "ENTITY-REMOVE" USING WS-ROW
         END-IF
     END-PERFORM
     MOVE "0 5 5" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test persistence edges level.dat: a weather entry with an unknown key reads; an empty "
         & "LevelName reads and writes as empty" TO TL-CASE
     PERFORM ROOT-BEGIN
     MOVE "LevelName" TO WN MOVE 9 TO WL
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WN WL WS-TEXT WS-ZERO
     MOVE "Weather" TO WN MOVE 7 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     MOVE "cobolcraft:main" TO WN MOVE 15 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     MOVE "Kind" TO WN MOVE 4 TO WL
     MOVE "cobolcraft:drizzle" TO WS-TEXT MOVE 18 TO WS-TEXT-LENGTH
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WN WL WS-TEXT WS-TEXT-LENGTH
     PERFORM WRITE-EXTRA
     MOVE "Remaining" TO WN MOVE 9 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL WS-FIVE
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE "build/core-test-world/level.dat" TO WS-PATH
     PERFORM WRITE-FILE
     CALL "LEVEL-DAT-READ"
     MOVE SPACES TO WS-OBSERVED
     MOVE CW-RAINING TO WS-EDIT PERFORM ADD-EDIT
     MOVE CW-RAIN-TIME TO WS-EDIT PERFORM ADD-EDIT
     IF CW-NAME = SPACES
         STRING FUNCTION TRIM(WS-OBSERVED) " no-name" DELIMITED BY SIZE INTO WS-OBSERVED
     END-IF
     CALL "LEVEL-DAT-WRITE"
     MOVE "New" TO CW-NAME
     CALL "LEVEL-DAT-READ"
     IF CW-NAME = SPACES
         STRING FUNCTION TRIM(WS-OBSERVED) " still-no-name" DELIMITED BY SIZE INTO WS-OBSERVED
     END-IF
     MOVE "1 5 no-name still-no-name" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test persistence edges level.dat: a hailstorm entry of the earlier form with Remaining -1 reads as rain "
         & "and thunder for the longest time" TO TL-CASE
     PERFORM ROOT-BEGIN
     MOVE "Weather" TO WN MOVE 7 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     PERFORM WRITE-EXTRA
     MOVE "cobolcraft:main" TO WN MOVE 15 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     MOVE "Kind" TO WN MOVE 4 TO WL
     MOVE "cobolcraft:hailstorm" TO WS-TEXT MOVE 20 TO WS-TEXT-LENGTH
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WN WL WS-TEXT WS-TEXT-LENGTH
     MOVE "Remaining" TO WN MOVE 9 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL WS-MINUS-ONE
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE "build/core-test-world/level.dat" TO WS-PATH
     PERFORM WRITE-FILE
     CALL "LEVEL-DAT-READ"
     MOVE SPACES TO WS-OBSERVED
     MOVE CW-RAINING TO WS-EDIT PERFORM ADD-EDIT
     MOVE CW-THUNDERING TO WS-EDIT PERFORM ADD-EDIT
     MOVE CW-RAIN-TIME TO WS-EDIT PERFORM ADD-EDIT
     MOVE "1 1 2147483647" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test persistence edges access.dat: an identity with an unknown key reads" TO TL-CASE
     CALL "LOGIN-OFFLINE-UUID" USING WS-NAME WS-NAME-LENGTH WS-UUID
     CALL "PERSIST-UUID-INTS" USING WS-TO-INTS WS-UUID WS-INTS
     PERFORM ROOT-BEGIN
     MOVE "Bans" TO WN MOVE 4 TO WL
     CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WN WL WS-T-COMPOUND WS-ONE
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WS-ELEMENT
     MOVE "Name" TO WN MOVE 4 TO WL
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WN WL WS-NAME WS-NAME-LENGTH
     PERFORM WRITE-EXTRA
     MOVE "UUID" TO WN MOVE 4 TO WL
     CALL "NBT-WRITE-INT-ARRAY" USING PB-BUFFER WN WL WS-FOUR WS-INTS
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE "build/core-test-world/access.dat" TO WS-PATH
     PERFORM WRITE-FILE
     CALL "ACCESS-DAT-READ"
     MOVE SPACES TO WS-OBSERVED
     MOVE AC-COUNT(ACCESS-BANS) TO WS-EDIT PERFORM ADD-EDIT
     STRING FUNCTION TRIM(WS-OBSERVED) " " AC-NAME(ACCESS-BANS, 1) DELIMITED BY SIZE
         INTO WS-OBSERVED
     IF AC-UUID(ACCESS-BANS, 1) = WS-UUID
         STRING FUNCTION TRIM(WS-OBSERVED) " uuid" DELIMITED BY SIZE INTO WS-OBSERVED
     END-IF
     MOVE "1 Bob uuid" TO TL-EXPECTED
     PERFORM CHECK

     MOVE "test persistence edges a player file whose inventory entry has an unknown key reads"
         TO TL-CASE
     PERFORM ROOT-BEGIN
     MOVE "Inventory" TO WN MOVE 9 TO WL
     CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WN WL WS-T-COMPOUND WS-ONE
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WS-ELEMENT
     MOVE "Slot" TO WN MOVE 4 TO WL
     CALL "NBT-WRITE-BYTE" USING PB-BUFFER WN WL WS-TWO
     PERFORM WRITE-EXTRA
     MOVE "id" TO WN MOVE 2 TO WL
     MOVE "cobolcraft:loam" TO WS-TEXT MOVE 15 TO WS-TEXT-LENGTH
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WN WL WS-TEXT WS-TEXT-LENGTH
     MOVE "count" TO WN MOVE 5 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL WS-THREE
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "PERSIST-UUID-TEXT" USING WS-UUID WS-UUID-TEXT
     MOVE SPACES TO WS-PATH
     STRING "build/core-test-world/players/" WS-UUID-TEXT ".dat" DELIMITED BY SIZE INTO WS-PATH
     PERFORM WRITE-FILE
     CALL "PLAYER-DAT-READ" USING WS-UUID WS-KNOWN
     MOVE SPACES TO WS-OBSERVED
     MOVE KN-INVENTORY(WS-KNOWN)(17:8) TO WS-TEXT
     MOVE KN-INVENTORY(WS-KNOWN)(17:8) TO WS-INTS(1:8)
     MOVE WS-INT-ITEM(1) TO WS-EDIT PERFORM ADD-EDIT
     MOVE WS-INT-ITEM(2) TO WS-EDIT PERFORM ADD-EDIT
     MOVE "3 3" TO TL-EXPECTED
     PERFORM CHECK

*>   A ground item in chunk (0, 0) is saved, moves to chunk (6, 0) and is saved again.
     MOVE "test persistence edges a second save replaces the entity region files: the moved "
         & "ground item is in chunk (6, 0) only" TO TL-CASE
     CALL "GI-SPAWN" USING WS-DIM WS-X WS-Y WS-Z WS-VX WS-VY WS-VZ WS-ITEM WS-COUNT WS-DELAY
         WS-ROW
     CALL "CORE-SAVE"
     MOVE 100.5 TO EN-X(WS-ROW)
     CALL "CORE-SAVE"
     MOVE SPACES TO WS-OBSERVED
     MOVE 0 TO WS-CX WS-CZ
     CALL "REGION-READ" USING WS-ENTITIES WS-ENTITIES-LENGTH WS-CX WS-CZ PB-BUFFER WS-OUTCOME
     MOVE WS-OUTCOME TO WS-EDIT PERFORM ADD-EDIT
     MOVE 6 TO WS-CX
     CALL "REGION-READ" USING WS-ENTITIES WS-ENTITIES-LENGTH WS-CX WS-CZ PB-BUFFER WS-OUTCOME
     MOVE WS-OUTCOME TO WS-EDIT PERFORM ADD-EDIT
     MOVE "1 0" TO TL-EXPECTED
     PERFORM CHECK
     STOP RUN.

 ROOT-BEGIN.
     CALL "PB-RESET" USING PB-BUFFER
     MOVE SPACES TO WN
     MOVE 0 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL.

*> An entry the readers do not know: Byte "extra" 1.
 WRITE-EXTRA.
     MOVE "extra" TO WN MOVE 5 TO WL
     CALL "NBT-WRITE-BYTE" USING PB-BUFFER WN WL WS-ONE.

 WRITE-FILE.
     MOVE FUNCTION LENGTH(FUNCTION TRIM(WS-PATH)) TO WS-PATH-LENGTH
     CALL "NBT-FILE-WRITE" USING WS-PATH WS-PATH-LENGTH PB-BUFFER WS-OUTCOME.

 ADD-EDIT.
     STRING FUNCTION TRIM(WS-OBSERVED) " " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE
         INTO WS-OBSERVED.

 CHECK.
     MOVE "T" TO TL-MODE
     MOVE FUNCTION TRIM(WS-OBSERVED) TO TL-OBSERVED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-PERSISTENCE-EDGES.

 COPY CORETEST.
