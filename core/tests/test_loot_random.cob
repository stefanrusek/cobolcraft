*> Test of the loot random sources (core/src/loot-random.cob; docs/protocol/26-loot-and-predicates.md section 4, 10 section 2): the
*> Xoroshiro128++ seeding of 10 2.2 and its worked values of 10 2.7, the named random sequences of 26 section 4 step 5 (seeded from
*> the world seed, the salt and the MD5 of the sequence id, continuing where they stopped) and the Java LCG of explicit seeds
*> (10 2.6). The expected numbers were computed by an independent implementation of the documents' formulas (Python integers).
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-LOOT-RANDOM.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY LOOTSTATE.
 01 WS-LONG                BINARY-DOUBLE UNSIGNED.
 01 WS-EDIT                PIC Z(19)9.
 01 WS-SEED                BINARY-DOUBLE.
 01 WS-KEY                 PIC X(112).
 01 WS-KEY-LO              BINARY-DOUBLE UNSIGNED.
 01 WS-KEY-HI              BINARY-DOUBLE UNSIGNED.
 01 WS-ZERO                BINARY-LONG VALUE 0.
 01 WS-BOUND               BINARY-LONG.
 01 WS-INT                 BINARY-LONG.
 01 WS-FLOAT               FLOAT-LONG.
 01 WS-SCALED              BINARY-LONG.
 01 WS-BOOL                BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-TEXT                PIC X(200).
 01 WS-NUM                 PIC -(10)9.
 01 WS-SUM                 BINARY-DOUBLE.
 PROCEDURE DIVISION.
     MOVE 0 TO WS-SEED WS-KEY-LO WS-KEY-HI
     CALL "LOOT-RNG-SEED-128" USING WS-SEED WS-ZERO WS-KEY-LO WS-KEY-HI
     MOVE SPACES TO WS-TEXT
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 4
         CALL "LOOT-RNG-LONG" USING WS-LONG
         MOVE WS-LONG TO WS-EDIT
         STRING FUNCTION TRIM(WS-TEXT) " " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO WS-TEXT
     END-PERFORM
     MOVE "test loot random xoroshiro seed 0 first four nextLong (10 2.7)" TO TL-CASE
     MOVE "3038984756725240190 14752704786953913202 4633751808701151732 2160572957309072155" TO TL-EXPECTED
     MOVE FUNCTION TRIM(WS-TEXT) TO TL-OBSERVED
     PERFORM CHECK

     CALL "LOOT-RNG-SEED-128" USING WS-SEED WS-ZERO WS-KEY-LO WS-KEY-HI
     MOVE 100 TO WS-BOUND
     MOVE SPACES TO WS-TEXT
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 5
         CALL "LOOT-RNG-INT" USING WS-BOUND WS-INT
         MOVE WS-INT TO WS-NUM
         STRING FUNCTION TRIM(WS-TEXT) " " FUNCTION TRIM(WS-NUM) DELIMITED BY SIZE INTO WS-TEXT
     END-PERFORM
     MOVE "test loot random xoroshiro seed 0 first five nextInt(100) (10 2.7)" TO TL-CASE
     MOVE "96 18 15 31 88" TO TL-EXPECTED
     MOVE FUNCTION TRIM(WS-TEXT) TO TL-OBSERVED
     PERFORM CHECK

     CALL "LOOT-RNG-SEED-128" USING WS-SEED WS-ZERO WS-KEY-LO WS-KEY-HI
     MOVE SPACES TO WS-TEXT
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 2
         CALL "LOOT-RNG-FLOAT" USING WS-FLOAT
         COMPUTE WS-SCALED = WS-FLOAT * 16777216
         MOVE WS-SCALED TO WS-NUM
         STRING FUNCTION TRIM(WS-TEXT) " " FUNCTION TRIM(WS-NUM) DELIMITED BY SIZE INTO WS-TEXT
     END-PERFORM
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 3
         CALL "LOOT-RNG-BOOL" USING WS-BOOL
         MOVE WS-BOOL TO WS-NUM
         STRING FUNCTION TRIM(WS-TEXT) " " FUNCTION TRIM(WS-NUM) DELIMITED BY SIZE INTO WS-TEXT
     END-PERFORM
     MOVE "test loot random xoroshiro nextFloat (24 bits) and nextBoolean (low bit)" TO TL-CASE
     MOVE "2763940 13417506 0 1 1" TO TL-EXPECTED
     MOVE FUNCTION TRIM(WS-TEXT) TO TL-OBSERVED
     PERFORM CHECK

     CALL "LOOT-RNG-SEED-128" USING WS-SEED WS-ZERO WS-KEY-LO WS-KEY-HI
     MOVE SPACES TO WS-TEXT
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 4
         CALL "LOOT-RNG-LONG" USING WS-LONG
     END-PERFORM
     MOVE 7 TO WS-BOUND
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 5
         CALL "LOOT-RNG-INT" USING WS-BOUND WS-INT
         MOVE WS-INT TO WS-NUM
         STRING FUNCTION TRIM(WS-TEXT) " " FUNCTION TRIM(WS-NUM) DELIMITED BY SIZE INTO WS-TEXT
     END-PERFORM
     MOVE 1048576 TO WS-BOUND
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 2
         CALL "LOOT-RNG-INT" USING WS-BOUND WS-INT
         MOVE WS-INT TO WS-NUM
         STRING FUNCTION TRIM(WS-TEXT) " " FUNCTION TRIM(WS-NUM) DELIMITED BY SIZE INTO WS-TEXT
     END-PERFORM
     MOVE "test loot random xoroshiro nextInt(7) and nextInt(2^20) after four longs" TO TL-CASE
     MOVE "6 6 0 2 4 380878 611550" TO TL-EXPECTED
     MOVE FUNCTION TRIM(WS-TEXT) TO TL-OBSERVED
     PERFORM CHECK

     MOVE "minecraft:blocks/stone" TO WS-KEY
     CALL "LOOT-KEY-HASH" USING WS-KEY WS-KEY-LO WS-KEY-HI
     MOVE WS-KEY-LO TO WS-EDIT
     MOVE SPACES TO WS-TEXT
     STRING FUNCTION TRIM(WS-EDIT) " " DELIMITED BY SIZE INTO WS-TEXT
     MOVE WS-KEY-HI TO WS-EDIT
     STRING FUNCTION TRIM(WS-TEXT) " " FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE "test loot random seedFromHashOf is the two big-endian words of the MD5 of the id" TO TL-CASE
     MOVE "8630522255710752552 17182926204576828317" TO TL-EXPECTED
     PERFORM CHECK

     MOVE 0 TO LQ-SALT LQ-NO-WORLD-SEED LQ-NO-SEQUENCE-ID LQ-COUNT
     MOVE 12345 TO WS-SEED
     CALL "LOOT-RNG-SEED-SEQUENCE" USING WS-KEY WS-SEED
     MOVE 1000 TO WS-BOUND
     MOVE SPACES TO WS-TEXT
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 3
         CALL "LOOT-RNG-INT" USING WS-BOUND WS-INT
         MOVE WS-INT TO WS-NUM
         STRING FUNCTION TRIM(WS-TEXT) " " FUNCTION TRIM(WS-NUM) DELIMITED BY SIZE INTO WS-TEXT
     END-PERFORM
     MOVE "test loot random sequence minecraft:blocks/stone of world seed 12345 (26 section 4)" TO TL-CASE
     MOVE "841 606 635" TO TL-EXPECTED
     MOVE FUNCTION TRIM(WS-TEXT) TO TL-OBSERVED
     PERFORM CHECK

     CALL "LOOT-RNG-SAVE"
     CALL "LOOT-RNG-SEED-128" USING WS-SEED WS-ZERO WS-KEY-LO WS-KEY-HI
     CALL "LOOT-RNG-SEED-SEQUENCE" USING WS-KEY WS-SEED
     MOVE SPACES TO WS-TEXT
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 2
         CALL "LOOT-RNG-INT" USING WS-BOUND WS-INT
         MOVE WS-INT TO WS-NUM
         STRING FUNCTION TRIM(WS-TEXT) " " FUNCTION TRIM(WS-NUM) DELIMITED BY SIZE INTO WS-TEXT
     END-PERFORM
     MOVE "test loot random a saved sequence continues with its next draws" TO TL-CASE
     MOVE "738 337" TO TL-EXPECTED
     MOVE FUNCTION TRIM(WS-TEXT) TO TL-OBSERVED
     PERFORM CHECK
     MOVE LQ-COUNT TO TL-OBSERVED-N
     MOVE 1 TO TL-EXPECTED-N
     MOVE "test loot random one id keeps one sequence" TO TL-CASE
     PERFORM CHECK-NUM

     MOVE 5 TO LQ-SALT
     MOVE -77 TO WS-SEED
     MOVE "minecraft:chests/simple_dungeon" TO WS-KEY
     CALL "LOOT-RNG-SEED-SEQUENCE" USING WS-KEY WS-SEED
     MOVE SPACES TO WS-TEXT
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 3
         CALL "LOOT-RNG-INT" USING WS-BOUND WS-INT
         MOVE WS-INT TO WS-NUM
         STRING FUNCTION TRIM(WS-TEXT) " " FUNCTION TRIM(WS-NUM) DELIMITED BY SIZE INTO WS-TEXT
     END-PERFORM
     MOVE "test loot random a negative world seed and a salt of 5 seed another id" TO TL-CASE
     MOVE "161 389 388" TO TL-EXPECTED
     MOVE FUNCTION TRIM(WS-TEXT) TO TL-OBSERVED
     PERFORM CHECK
     MOVE LQ-COUNT TO TL-OBSERVED-N
     MOVE 2 TO TL-EXPECTED-N
     MOVE "test loot random a second id adds a second sequence" TO TL-CASE
     PERFORM CHECK-NUM

     MOVE 42 TO WS-SEED
     CALL "LOOT-RNG-SEED-LCG" USING WS-SEED
     MOVE 100 TO WS-BOUND
     MOVE SPACES TO WS-TEXT
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 5
         CALL "LOOT-RNG-INT" USING WS-BOUND WS-INT
         MOVE WS-INT TO WS-NUM
         STRING FUNCTION TRIM(WS-TEXT) " " FUNCTION TRIM(WS-NUM) DELIMITED BY SIZE INTO WS-TEXT
     END-PERFORM
     MOVE 64 TO WS-BOUND
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 2
         CALL "LOOT-RNG-INT" USING WS-BOUND WS-INT
         MOVE WS-INT TO WS-NUM
         STRING FUNCTION TRIM(WS-TEXT) " " FUNCTION TRIM(WS-NUM) DELIMITED BY SIZE INTO WS-TEXT
     END-PERFORM
     CALL "LOOT-RNG-FLOAT" USING WS-FLOAT
     COMPUTE WS-SCALED = WS-FLOAT * 16777216
     MOVE WS-SCALED TO WS-NUM
     STRING FUNCTION TRIM(WS-TEXT) " " FUNCTION TRIM(WS-NUM) DELIMITED BY SIZE INTO WS-TEXT
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 2
         CALL "LOOT-RNG-BOOL" USING WS-BOOL
         MOVE WS-BOOL TO WS-NUM
         STRING FUNCTION TRIM(WS-TEXT) " " FUNCTION TRIM(WS-NUM) DELIMITED BY SIZE INTO WS-TEXT
     END-PERFORM
     MOVE "test loot random java LCG seed 42: nextInt(100), a power-of-two bound, nextFloat, nextBoolean" TO TL-CASE
     MOVE "30 63 48 84 70 60 17 11873413 1 0" TO TL-EXPECTED
     MOVE FUNCTION TRIM(WS-TEXT) TO TL-OBSERVED
     PERFORM CHECK

     MOVE -5 TO WS-SEED
     CALL "LOOT-RNG-SEED-LCG" USING WS-SEED
     MOVE 10 TO WS-BOUND
     MOVE SPACES TO WS-TEXT
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 3
         CALL "LOOT-RNG-INT" USING WS-BOUND WS-INT
         MOVE WS-INT TO WS-NUM
         STRING FUNCTION TRIM(WS-TEXT) " " FUNCTION TRIM(WS-NUM) DELIMITED BY SIZE INTO WS-TEXT
     END-PERFORM
     MOVE "test loot random java LCG of a negative seed" TO TL-CASE
     MOVE "1 1 3" TO TL-EXPECTED
     MOVE FUNCTION TRIM(WS-TEXT) TO TL-OBSERVED
     PERFORM CHECK

     MOVE 1099511627776 TO WS-SEED
     CALL "LOOT-RNG-SEED-LCG" USING WS-SEED
     MOVE 1000 TO WS-BOUND
     MOVE SPACES TO WS-TEXT
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 3
         CALL "LOOT-RNG-INT" USING WS-BOUND WS-INT
         MOVE WS-INT TO WS-NUM
         STRING FUNCTION TRIM(WS-TEXT) " " FUNCTION TRIM(WS-NUM) DELIMITED BY SIZE INTO WS-TEXT
     END-PERFORM
     MOVE "test loot random java LCG of a seed above 32 bits" TO TL-CASE
     MOVE "984 140 77" TO TL-EXPECTED
     MOVE FUNCTION TRIM(WS-TEXT) TO TL-OBSERVED
     PERFORM CHECK
     MOVE 0 TO WS-SEED
     CALL "LOOT-RNG-SEED-128" USING WS-SEED WS-ZERO WS-KEY-LO WS-KEY-HI
     MOVE 2000000000 TO WS-BOUND
     MOVE 0 TO WS-SUM
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 60
         CALL "LOOT-RNG-INT" USING WS-BOUND WS-INT
         ADD WS-INT TO WS-SUM
     END-PERFORM
     COMPUTE WS-SUM = FUNCTION MOD(WS-SUM, 1000003)
     MOVE WS-SUM TO TL-OBSERVED-N
     MOVE 594133 TO TL-EXPECTED-N
     MOVE "test loot random xoroshiro nextInt of a large bound redraws below the threshold (60 draws)" TO TL-CASE
     PERFORM CHECK-NUM

     MOVE 42 TO WS-SEED
     CALL "LOOT-RNG-SEED-LCG" USING WS-SEED
     MOVE 1500000000 TO WS-BOUND
     MOVE SPACES TO WS-TEXT
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 8
         CALL "LOOT-RNG-INT" USING WS-BOUND WS-INT
         MOVE WS-INT TO WS-NUM
         STRING FUNCTION TRIM(WS-TEXT) " " FUNCTION TRIM(WS-NUM) DELIMITED BY SIZE INTO WS-TEXT
     END-PERFORM
     MOVE "test loot random java LCG nextInt of a large bound runs its rejection loop" TO TL-CASE
     MOVE "117392763 1467211248 102948884 662969970 595021505 1429255519 196118093 969067502" TO TL-EXPECTED
     MOVE FUNCTION TRIM(WS-TEXT) TO TL-OBSERVED
     PERFORM CHECK
     GOBACK.

 CHECK.
     MOVE "T" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.

 CHECK-NUM.
     MOVE "N" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-LOOT-RANDOM.
