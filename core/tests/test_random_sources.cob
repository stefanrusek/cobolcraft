*> Implementation test of the Xoroshiro128++ random sources (core/src/rng.cob XORO-*; T0409;
*> docs/protocol/10 sections 2.1 to 2.5 and the worked examples of 2.7): seeding, nextLong, nextInt(bound),
*> nextDouble, forks, positional factories at a position and by name hash (MD5), Mth.getSeed.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-RANDOM-SOURCES.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY XORO.
 01 WS-FACTORY.
    05 WS-FLO               BINARY-DOUBLE UNSIGNED.
    05 WS-FHI               BINARY-DOUBLE UNSIGNED.
 01 WS-SEED                BINARY-DOUBLE UNSIGNED.
 01 WS-U                   BINARY-DOUBLE UNSIGNED.
 01 WS-S                   BINARY-DOUBLE.
 01 WS-INT                 BINARY-LONG.
 01 WS-BOUND               BINARY-LONG.
 01 WS-D                   FLOAT-LONG.
 01 WS-BITS                BINARY-DOUBLE.
 01 WS-EDIT                PIC Z(19)9.
 01 WS-EDIT-S              PIC -(19)9.
 01 WS-TEXT                PIC X(240).
 01 WS-PTR                 BINARY-LONG.
 01 WS-X                   BINARY-LONG.
 01 WS-Y                   BINARY-LONG.
 01 WS-Z                   BINARY-LONG.
 01 WS-NAME                PIC X(64).
 01 WS-LEN                 BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 PROCEDURE DIVISION.
     MOVE "T" TO TL-MODE

     MOVE "test random seed 0 upgraded to 128 bits (10 2.7)" TO TL-CASE
     MOVE 0 TO WS-SEED
     CALL "XORO-SEED" USING WS-SEED XR-STATE
     MOVE XR-LO TO WS-EDIT
     MOVE FUNCTION TRIM(WS-EDIT) TO TL-OBSERVED
     MOVE "3847398142028685078" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "test random seed 0 hi word" TO TL-CASE
     MOVE XR-HI TO WS-EDIT
     MOVE FUNCTION TRIM(WS-EDIT) TO TL-OBSERVED
     MOVE "7192185014346937746" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test random first four nextLong of seed 0 (10 2.7)" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     PERFORM 4 TIMES
         CALL "XORO-NEXT-LONG" USING XR-STATE WS-U
         MOVE WS-U TO WS-EDIT
         STRING FUNCTION TRIM(WS-EDIT) " " DELIMITED BY SIZE INTO WS-TEXT POINTER WS-PTR
     END-PERFORM
     MOVE WS-TEXT TO TL-OBSERVED
     MOVE "3038984756725240190 14752704786953913202 4633751808701151732 2160572957309072155"
         TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test random first five nextInt(100) of seed 0 (10 2.7)" TO TL-CASE
     CALL "XORO-SEED" USING WS-SEED XR-STATE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     MOVE 100 TO WS-BOUND
     PERFORM 5 TIMES
         CALL "XORO-NEXT-INT" USING XR-STATE WS-BOUND WS-INT
         MOVE WS-INT TO WS-EDIT
         STRING FUNCTION TRIM(WS-EDIT) " " DELIMITED BY SIZE INTO WS-TEXT POINTER WS-PTR
     END-PERFORM
     MOVE WS-TEXT TO TL-OBSERVED
     MOVE "96 18 15 31 88" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test random first nextDouble of seed 0 is bit exact (10 2.7)" TO TL-CASE
     CALL "XORO-SEED" USING WS-SEED XR-STATE
     CALL "XORO-NEXT-DOUBLE" USING XR-STATE WS-D
     CALL STATIC "cc_f64_f64_bits" USING BY REFERENCE WS-D WS-BITS
     MOVE WS-BITS TO WS-EDIT-S
     MOVE FUNCTION TRIM(WS-EDIT-S) TO TL-OBSERVED
     MOVE "4595103537393514408" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "test random second nextDouble of seed 0" TO TL-CASE
     CALL "XORO-NEXT-DOUBLE" USING XR-STATE WS-D
     CALL STATIC "cc_f64_f64_bits" USING BY REFERENCE WS-D WS-BITS
     MOVE WS-BITS TO WS-EDIT-S
     MOVE FUNCTION TRIM(WS-EDIT-S) TO TL-OBSERVED
     MOVE "4605378688679531256" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test random positional factory of seed 0 (10 2.7)" TO TL-CASE
     CALL "XORO-SEED" USING WS-SEED XR-STATE
     CALL "XORO-FORK-POSITIONAL" USING XR-STATE WS-FACTORY
     MOVE WS-FLO TO WS-EDIT
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     STRING FUNCTION TRIM(WS-EDIT) " " DELIMITED BY SIZE INTO WS-TEXT POINTER WS-PTR
     MOVE WS-FHI TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO WS-TEXT POINTER WS-PTR
     MOVE WS-TEXT TO TL-OBSERVED
     MOVE "3038984756725240190 14752704786953913202" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test random positional factory of seed 12345 (10 2.7)" TO TL-CASE
     MOVE 12345 TO WS-SEED
     CALL "XORO-SEED" USING WS-SEED XR-STATE
     CALL "XORO-FORK-POSITIONAL" USING XR-STATE WS-FACTORY
     MOVE WS-FLO TO WS-EDIT
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     STRING FUNCTION TRIM(WS-EDIT) " " DELIMITED BY SIZE INTO WS-TEXT POINTER WS-PTR
     MOVE WS-FHI TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO WS-TEXT POINTER WS-PTR
     MOVE WS-TEXT TO TL-OBSERVED
     MOVE "10328258799079035131 8241557746459281790" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test random fork takes lo then hi from the next two draws" TO TL-CASE
     MOVE 0 TO WS-SEED
     CALL "XORO-SEED" USING WS-SEED XR-STATE
     CALL "XORO-FORK" USING XR-STATE WS-FACTORY
     MOVE WS-FLO TO WS-EDIT
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     STRING FUNCTION TRIM(WS-EDIT) " " DELIMITED BY SIZE INTO WS-TEXT POINTER WS-PTR
     MOVE WS-FHI TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO WS-TEXT POINTER WS-PTR
     MOVE WS-TEXT TO TL-OBSERVED
     MOVE "3038984756725240190 14752704786953913202" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test random Mth.getSeed(1, 2, 3) = -33674130277896 (10 2.7)" TO TL-CASE
     MOVE 1 TO WS-X MOVE 2 TO WS-Y MOVE 3 TO WS-Z
     CALL "XORO-GET-SEED" USING WS-X WS-Y WS-Z WS-S
     MOVE WS-S TO WS-EDIT-S
     MOVE FUNCTION TRIM(WS-EDIT-S) TO TL-OBSERVED
     MOVE "-33674130277896" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test random Mth.getSeed over the sign combinations of its steps (x = 1000 and negative z)" TO TL-CASE
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     MOVE 1000 TO WS-X MOVE 0 TO WS-Y MOVE 0 TO WS-Z
     PERFORM GET-SEED-TEXT
     MOVE 1000 TO WS-X MOVE 0 TO WS-Y MOVE 3 TO WS-Z
     PERFORM GET-SEED-TEXT
     MOVE 1000 TO WS-X MOVE 0 TO WS-Y MOVE -77 TO WS-Z
     PERFORM GET-SEED-TEXT
     MOVE 1000 TO WS-X MOVE 0 TO WS-Y MOVE -99999 TO WS-Z
     PERFORM GET-SEED-TEXT
     MOVE 1 TO WS-X MOVE 70 TO WS-Y MOVE -77 TO WS-Z
     PERFORM GET-SEED-TEXT
     MOVE 1 TO WS-X MOVE 0 TO WS-Y MOVE 3 TO WS-Z
     PERFORM GET-SEED-TEXT
     MOVE WS-TEXT TO TL-OBSERVED
     MOVE "-90802465359728 25704934047031 139782294657046 -95792739714406 -59185705345066 -34580789005993"
         TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test random named generator minecraft:continentalness at seed 0 (10 2.7)" TO TL-CASE
     MOVE 0 TO WS-SEED
     CALL "XORO-SEED" USING WS-SEED XR-STATE
     CALL "XORO-FORK-POSITIONAL" USING XR-STATE WS-FACTORY
     MOVE "minecraft:continentalness" TO WS-NAME
     MOVE 25 TO WS-LEN
     CALL "XORO-FROM-HASH" USING WS-FACTORY WS-NAME WS-LEN XR-STATE
     MOVE XR-LO TO WS-EDIT
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     STRING FUNCTION TRIM(WS-EDIT) " " DELIMITED BY SIZE INTO WS-TEXT POINTER WS-PTR
     MOVE XR-HI TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO WS-TEXT POINTER WS-PTR
     MOVE WS-TEXT TO TL-OBSERVED
     MOVE "12224115285347333916 7141049232686132191" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test random at(1, 2, 3) xors the position seed into lo and keeps hi" TO TL-CASE
     MOVE 1 TO WS-X MOVE 2 TO WS-Y MOVE 3 TO WS-Z
     CALL "XORO-AT" USING WS-FACTORY WS-X WS-Y WS-Z XR-STATE
     MOVE XR-LO TO WS-EDIT
     MOVE SPACES TO WS-TEXT
     MOVE 1 TO WS-PTR
     STRING FUNCTION TRIM(WS-EDIT) " " DELIMITED BY SIZE INTO WS-TEXT POINTER WS-PTR
     MOVE XR-HI TO WS-EDIT
     STRING FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO WS-TEXT POINTER WS-PTR
     MOVE WS-TEXT TO TL-OBSERVED
     MOVE "15407735541344659590 14752704786953913202" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     MOVE "test random nextInt(bound) with a bound that rejects draws sums as the reference (200 draws)" TO TL-CASE
     MOVE 0 TO WS-SEED
     CALL "XORO-SEED" USING WS-SEED XR-STATE
     MOVE 1500000000 TO WS-BOUND
     MOVE 0 TO WS-S
     PERFORM 200 TIMES
         CALL "XORO-NEXT-INT" USING XR-STATE WS-BOUND WS-INT
         ADD WS-INT TO WS-S
     END-PERFORM
     MOVE WS-S TO WS-EDIT
     MOVE FUNCTION TRIM(WS-EDIT) TO TL-OBSERVED
     MOVE "154788669935" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 GET-SEED-TEXT.
     CALL "XORO-GET-SEED" USING WS-X WS-Y WS-Z WS-S
     MOVE WS-S TO WS-EDIT-S
     STRING FUNCTION TRIM(WS-EDIT-S) " " DELIMITED BY SIZE INTO WS-TEXT POINTER WS-PTR.
 END PROGRAM TEST-RANDOM-SOURCES.
