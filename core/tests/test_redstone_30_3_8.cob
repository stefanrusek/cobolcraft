     CALL "RS1-HONEY-PROBE" USING WS-I1 WS-I2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1 5" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-HONEY-PROBE" USING WS-I1 WS-I2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-HONEY-PROBE" USING WS-I1 WS-I2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "0 5" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-HONEY-PROBE" USING WS-I1 WS-I2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-HONEY-PROBE" USING WS-I1 WS-I2 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1/1500001 1/1500001 0/1500001 0/1500001 0/1500001" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 30-3§8 Entities: fixEntityWithinPistonBase (8.4): d1 = depth + 0.01, d2 = depth of the clipped box + 0.01; when |d1 - d2| < 0.01 the entity is moved by min(d1, delta) + 0.01" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0 0 0 0.1 0.1 0.5" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-EP-FIX" USING WS-FX4 WS-FX5 WS-FX6 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 0 0.3 0.1 0.5" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-EP-FIX" USING WS-FX4 WS-FX5 WS-FX6 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 0 0.495 0.5 0.5" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-EP-FIX" USING WS-FX4 WS-FX5 WS-FX6 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 0 0.1 0.2 0.2" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-EP-FIX" USING WS-FX4 WS-FX5 WS-FX6 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 0 0.1 0.1 0.05" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-EP-FIX" USING WS-FX4 WS-FX5 WS-FX6 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1/120000 0/0 1/510000 0/0 1/60000" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 30-3§8 Entities: moveEntityByPiston (8.3): NOCLIP is set to the noclip direction for the move and cleared after; a stuck speed multiplier is not applied to a piston movement but" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-EP-MOVER" USING WS-I1 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-EP-MOVER" USING WS-I1 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1/0/1 1/1/1" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 BEGIN-CASE.
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR
     .

 LOAD-IN.
     MOVE 1 TO WS-P
     PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 16
         MOVE SPACES TO WS-TOK
         IF WS-P <= 160
             UNSTRING WS-IN DELIMITED BY ALL SPACE INTO WS-TOK WITH POINTER WS-P
         END-IF
         COMPUTE WS-FX(WS-K) = FUNCTION NUMVAL(WS-TOK)
         COMPUTE WS-I(WS-K) = FUNCTION NUMVAL(WS-TOK)
     END-PERFORM
     .

 ADD-N.
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N
         MOVE WS-R(WS-J) TO WS-SHOW
         IF WS-J > 1
             STRING "/" DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
         END-IF
         STRING FUNCTION TRIM(WS-SHOW) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-PERFORM
     STRING " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .

 ADD-TEXT.
     STRING FUNCTION TRIM(WS-T1) "|" FUNCTION TRIM(WS-T2) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .
