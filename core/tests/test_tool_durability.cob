     MOVE 0 TO WS-OK
     IF WS-E1 = 1000 AND WS-LEFT > 400 AND WS-LEFT < 600 AND WS-LEFT2 > 150 AND WS-LEFT2 < 350
         MOVE 1 TO WS-OK
     END-IF
     MOVE SPACES TO TL-OBSERVED
     MOVE WS-OK TO WS-E2
     MOVE FUNCTION TRIM(WS-E2) TO TL-OBSERVED
     MOVE "T" TO TL-MODE
     MOVE "1" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     STOP RUN.

 ADD-OBS.
     IF TL-OBSERVED = SPACES
         MOVE FUNCTION TRIM(WS-OBS) TO TL-OBSERVED
     ELSE
         STRING FUNCTION TRIM(TL-OBSERVED) " " FUNCTION TRIM(WS-OBS) DELIMITED BY SIZE INTO TL-OBSERVED
     END-IF.

 CHECK-DONE.
     MOVE "T" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-TOOL-DURABILITY.

