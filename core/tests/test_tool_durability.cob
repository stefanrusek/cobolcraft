     MOVE 0 TO PL-MODE(WS-ROWNO)
     MOVE 30 TO WS-AMOUNT
     CALL "TOOL-HURT-STACK" USING WS-CONN WS-SLOT WS-AMOUNT WS-BROKE
     MOVE PL-SLOT-VAR(WS-ROWNO, 1) TO WS-HANDLE
     CALL "SP-GET-DAMAGE" USING PL-SLOT-ITEM(WS-ROWNO, 1) WS-HANDLE WS-DAMAGE
     MOVE WS-DAMAGE TO WS-E1
     MOVE WS-BROKE TO WS-E2
     MOVE SPACES TO TL-OBSERVED
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO TL-OBSERVED
     MOVE 1 TO PL-MODE(WS-ROWNO)
     CALL "TOOL-HURT-STACK" USING WS-CONN WS-SLOT WS-AMOUNT WS-BROKE
     CALL "SP-GET-DAMAGE" USING PL-SLOT-ITEM(WS-ROWNO, 1) PL-SLOT-VAR(WS-ROWNO, 1) WS-DAMAGE
     MOVE WS-DAMAGE TO WS-E1
     STRING FUNCTION TRIM(TL-OBSERVED) " creative " FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO TL-OBSERVED
