     MOVE 2 TO WS-I1
     CALL "TOOL-DURABILITY-COST" USING WS-I1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 3 TO WS-I1
     CALL "TOOL-DURABILITY-COST" USING WS-I1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 4 TO WS-I1
     CALL "TOOL-DURABILITY-COST" USING WS-I1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 5 TO WS-I1
     CALL "TOOL-DURABILITY-COST" USING WS-I1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 6 TO WS-I1
     CALL "TOOL-DURABILITY-COST" USING WS-I1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 7 TO WS-I1
     CALL "TOOL-DURABILITY-COST" USING WS-I1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 8 TO WS-I1
     CALL "TOOL-DURABILITY-COST" USING WS-I1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "1 2 1 2 1 3 1 1" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 durability on a player stack: 30 damage then 70 more breaks the stack (count 0, Container Set Slot sent), creative takes none" TO TL-CASE
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     CALL "TEST-JOIN" USING WS-NAME WS-NAME-LENGTH WS-CONN
     MOVE CN-PLAYER(WS-CONN) TO WS-ROWNO
     MOVE 1 TO PL-SLOT-ITEM(WS-ROWNO, 1)
     MOVE 1 TO PL-SLOT-COUNT(WS-ROWNO, 1)
     MOVE 0 TO WS-HANDLE
     MOVE 2 TO WS-TYPE
     MOVE SPACES TO WS-VALUE
     MOVE X"64" TO WS-VALUE(1:1)
     MOVE 1 TO WS-LENGTH
     CALL "SP-SET-COMPONENT" USING WS-HANDLE WS-TYPE WS-VALUE WS-LENGTH
     MOVE WS-HANDLE TO PL-SLOT-VAR(WS-ROWNO, 1)
