     MOVE 2 TO WS-Y
     MOVE 2 TO WS-V
     CALL "MNG-SET" USING WS-G1 WS-X WS-Y WS-V
     MOVE 4 TO WS-X
     MOVE 3 TO WS-Y
     MOVE 2 TO WS-V
     CALL "MNG-SET" USING WS-G1 WS-X WS-Y WS-V
     MOVE 4 TO WS-X
     MOVE 4 TO WS-Y
     MOVE 2 TO WS-V
     CALL "MNG-SET" USING WS-G1 WS-X WS-Y WS-V
     MOVE 5 TO WS-X
     MOVE 3 TO WS-Y
     MOVE 1 TO WS-V
     CALL "MNG-SET" USING WS-G1 WS-X WS-Y WS-V

             END-EVALUATE
             MOVE WS-S TO WS-SEED
             CALL "JRAND-SET-SEED" USING SP-RNG WS-SEED
             PERFORM CLEAR-GRID3
             CALL "MNG-IDENTIFY" USING WS-G1 WS-G3
             MOVE 3 TO WS-HG
             PERFORM HASH-GRID
             MOVE WS-I TO WS-ED
             MOVE WS-S TO WS-ED2
             MOVE SPACES TO WS-CASE
             STRING "acceptance US12 36-7§5.4 identifyRooms shape " FUNCTION TRIM(WS-ED) " seed " FUNCTION TRIM(WS-ED2) ": the room codes (patterns, origin and door)"
                 DELIMITED BY SIZE INTO WS-CASE
             MOVE WS-CASE TO TL-CASE
             MOVE T54H-V1(WS-K) TO TL-EXPECTED-N
             MOVE WS-H TO TL-OBSERVED-N
             CALL "TEST-ASSERT" USING TESTLIB-ASSERT
             PERFORM NEXT-DRAW
             MOVE SPACES TO WS-CASE
             STRING "acceptance US12 36-7§5.4 identifyRooms shape " FUNCTION TRIM(WS-ED) " seed " FUNCTION TRIM(WS-ED2) ": the draws made" DELIMITED BY SIZE INTO WS-CASE
             MOVE WS-CASE TO TL-CASE
             MOVE T54H-V2(WS-K) TO TL-EXPECTED-N
             MOVE WS-N TO TL-OBSERVED-N
             CALL "TEST-ASSERT" USING TESTLIB-ASSERT
         END-PERFORM
     END-PERFORM
*>   a lone cell with no corridor has no door and its origin at its own corner (x0, y0): origin flag set, door flag clear
     PERFORM CLEAR-GRID1
     MOVE 6 TO WS-X
     MOVE 6 TO WS-Y
     MOVE 2 TO WS-V
     CALL "MNG-SET" USING WS-G1 WS-X WS-Y WS-V
     PERFORM CLEAR-GRID3
     MOVE 8 TO WS-SEED
     CALL "JRAND-SET-SEED" USING SP-RNG WS-SEED
     CALL "MNG-IDENTIFY" USING WS-G1 WS-G3
     CALL "MNG-GET" USING WS-G3 WS-X WS-Y WS-CODE
     MOVE "acceptance US12 36-7§5.4 a lone room cell without a corridor is 1x1 id 10, origin flag, no door" TO TL-CASE
     MOVE 1048576 TO TL-EXPECTED-N
     ADD 65536 TO TL-EXPECTED-N
     ADD 10 TO TL-EXPECTED-N
     MOVE WS-CODE TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   5.5 no candidate: the third grid is 5 everywhere, the stream is untouched
     MOVE 9 TO WS-SEED
     CALL "JRAND-SET-SEED" USING SP-RNG WS-SEED
     MOVE SP-RNG TO WS-BEFORE
     PERFORM CLEAR-GRID1
     MOVE 3 TO WS-X
     MOVE 3 TO WS-Y
     MOVE 1 TO WS-V
     CALL "MNG-SET" USING WS-G1 WS-X WS-Y WS-V
     MOVE 0 TO WS-V
     CALL "MNG-FILL" USING WS-G2 WS-ZERO WS-ZERO WS-TEN WS-TEN WS-V
     CALL "MNG-FILL" USING WS-G4 WS-ZERO WS-ZERO WS-TEN WS-TEN WS-V
     CALL "MNG-FILL" USING WS-G5 WS-ZERO WS-ZERO WS-TEN WS-TEN WS-V
     CALL "MNG-THIRD-FLOOR"
     MOVE 0 TO WS-N
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 121
         IF MN-CELL(2, WS-I) NOT = 5
             ADD 1 TO WS-N
         END-IF
     END-PERFORM
     MOVE "acceptance US12 36-7§5.5 setupThirdFloor without a door-bearing 1x2 room: all 5, no draw" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-N + (SP-RNG - WS-BEFORE)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   5.5 a stair room with no clear neighbour: draw nextInt(1) for the pick only; all 5, the stairs flag is taken back
     PERFORM CLEAR-GRID1
     MOVE 3 TO WS-X
     MOVE 3 TO WS-Y
     MOVE 1 TO WS-V
     CALL "MNG-SET" USING WS-G1 WS-X WS-Y WS-V
     MOVE 4 TO WS-X
     CALL "MNG-SET" USING WS-G1 WS-X WS-Y WS-V
     MOVE 0 TO WS-V
     CALL "MNG-FILL" USING WS-G2 WS-ZERO WS-ZERO WS-TEN WS-TEN WS-V
     CALL "MNG-FILL" USING WS-G4 WS-ZERO WS-ZERO WS-TEN WS-TEN WS-V
     CALL "MNG-FILL" USING WS-G5 WS-ZERO WS-ZERO WS-TEN WS-TEN WS-V
*>   (3, 3) is the door-bearing origin of a 1x2 room id 10, (4, 3) its other half
     MOVE 3 TO WS-X
     COMPUTE WS-V = 1048576 + 2097152 + 131072 + 10
     CALL "MNG-SET" USING WS-G4 WS-X WS-Y WS-V
     MOVE 4 TO WS-X
     COMPUTE WS-V = 131072 + 10
     CALL "MNG-SET" USING WS-G4 WS-X WS-Y WS-V
     MOVE 9 TO WS-SEED
     CALL "JRAND-SET-SEED" USING SP-RNG WS-SEED
     MOVE SP-RNG TO WS-REF
     CALL "JRAND-NEXT" USING WS-REF WS-BIT31 WS-R
     MOVE WS-REF TO WS-BEFORE
     MOVE 9 TO WS-SEED
     CALL "JRAND-SET-SEED" USING SP-RNG WS-SEED
     CALL "MNG-THIRD-FLOOR"
     MOVE 0 TO WS-N
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 121
         IF MN-CELL(2, WS-I) NOT = 5
             ADD 1 TO WS-N
         END-IF
     END-PERFORM
     MOVE "acceptance US12 36-7§5.5 a stair room with no clear side: third grid all 5, one draw (nextInt(1) for the pick)" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     IF SP-RNG = WS-BEFORE
         MOVE WS-N TO TL-OBSERVED-N
     ELSE
         COMPUTE TL-OBSERVED-N = WS-N + 1000
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 3 TO WS-X
     MOVE 3 TO WS-Y
     CALL "MNG-GET" USING WS-G4 WS-X WS-Y WS-CODE
     MOVE "acceptance US12 36-7§5.5 the stairs flag is removed again when the third floor cannot be made" TO TL-CASE
     COMPUTE TL-EXPECTED-N = 1048576 + 2097152 + 131072 + 10
     MOVE WS-CODE TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   5.1 the constructor, twelve seeds: the five grids and the stream position
     PERFORM VARYING WS-S FROM 1 BY 1 UNTIL WS-S > 12
         MOVE WS-S TO WS-SEED
         CALL "JRAND-SET-SEED" USING SP-RNG WS-SEED
         CALL "MNG-BUILD"
         MOVE WS-S TO WS-ED
         PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 5
             MOVE WS-I TO WS-HG
             PERFORM HASH-GRID
             MOVE WS-I TO WS-ED2
             MOVE SPACES TO WS-CASE
             STRING "acceptance US12 36-7§5.1 MansionGrid seed " FUNCTION TRIM(WS-ED) ": grid " FUNCTION TRIM(WS-ED2) " (base, third floor, rooms of floors 0, 1, 2)"
                 DELIMITED BY SIZE INTO WS-CASE
             MOVE WS-CASE TO TL-CASE
             EVALUATE WS-I
                 WHEN 1
                     MOVE T5-V1(WS-S) TO TL-EXPECTED-N
                 WHEN 2
                     MOVE T5-V2(WS-S) TO TL-EXPECTED-N
                 WHEN 3
                     MOVE T5-V3(WS-S) TO TL-EXPECTED-N
                 WHEN 4
                     MOVE T5-V4(WS-S) TO TL-EXPECTED-N
                 WHEN OTHER
                     MOVE T5-V5(WS-S) TO TL-EXPECTED-N
             END-EVALUATE
             MOVE WS-H TO TL-OBSERVED-N
             CALL "TEST-ASSERT" USING TESTLIB-ASSERT
         END-PERFORM
         PERFORM NEXT-DRAW
         MOVE SPACES TO WS-CASE
         STRING "acceptance US12 36-7§5.1 MansionGrid seed " FUNCTION TRIM(WS-ED) ": the constructor made exactly the draws of the text" DELIMITED BY SIZE INTO WS-CASE
         MOVE WS-CASE TO TL-CASE
         MOVE T5-V6(WS-S) TO TL-EXPECTED-N
         MOVE WS-N TO TL-OBSERVED-N
         CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     END-PERFORM
*>   5.1 step 7: the entrance side of floors 0 and 1 carries the corridor flag
     MOVE 8 TO WS-X
     MOVE 4 TO WS-Y
     CALL "MNG-GET" USING WS-G3 WS-X WS-Y WS-CODE
     MOVE WS-CODE TO WS-N
     MOVE 5 TO WS-Y
     CALL "MNG-GET" USING WS-G4 WS-X WS-Y WS-CODE
     MOVE "acceptance US12 36-7§5.1 step 7: cells (8, 4) and (8, 5) of floors 0 and 1 hold ROOM_CORRIDOR_FLAG 0x800000" TO TL-CASE
     COMPUTE TL-EXPECTED-N = 2 * 8388608
     COMPUTE TL-OBSERVED-N = WS-N + WS-CODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 CLEAR-GRID1.
     MOVE 0 TO WS-V
     CALL "MNG-FILL" USING WS-G1 WS-ZERO WS-ZERO WS-TEN WS-TEN WS-V
     .
 CLEAR-GRID3.
     MOVE 0 TO WS-V
     CALL "MNG-FILL" USING WS-G3 WS-ZERO WS-ZERO WS-TEN WS-TEN WS-V
     .
*> CLEAN-ALL: cleanEdges of grid 1 until it returns false; WS-PASSES counts the calls
 CLEAN-ALL.
     MOVE 0 TO WS-PASSES
     MOVE 1 TO WS-CHANGED
     PERFORM UNTIL WS-CHANGED = 0
         CALL "MNG-CLEAN-EDGES" USING WS-G1 WS-CHANGED
         ADD 1 TO WS-PASSES
     END-PERFORM
     .
*> CLEAN-CASE: the hand-built grid 1 is cleaned to a fixpoint and compared with the model (cases in order)
 CLEAN-CASE.
     ADD 1 TO WS-CC
     PERFORM CLEAN-ALL
     MOVE 1 TO WS-HG
     PERFORM HASH-GRID
     MOVE WS-CC TO WS-ED
     MOVE SPACES TO WS-CASE
     STRING "acceptance US12 36-7§5.3 cleanEdges hand-built grid " FUNCTION TRIM(WS-ED) ": passes and grid" DELIMITED BY SIZE INTO WS-CASE
     MOVE WS-CASE TO TL-CASE
     COMPUTE TL-EXPECTED-N = FUNCTION INTEGER(0)
     PERFORM EXPECT-CLEAN
     COMPUTE TL-OBSERVED-N = WS-PASSES * 1000000 + WS-H
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     .
 EXPECT-CLEAN.
     COMPUTE WS-K = WS-CC
     COMPUTE TL-EXPECTED-N = T53H-V1(WS-K) * 1000000 + T53H-V2(WS-K)
     .
*> HASH-GRID: WS-H the hash of grid WS-HG
 HASH-GRID.
     MOVE 0 TO WS-H
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > 121
         COMPUTE WS-H = FUNCTION MOD(WS-H * 7 + FUNCTION MOD(MN-CELL(WS-HG, WS-J), 1000003), 999983)
     END-PERFORM
     .
*> NEXT-DRAW: WS-N the next nextInt(1000000) of the generation random
 NEXT-DRAW.
     CALL "JRAND-NEXT-INT-BOUND" USING SP-RNG WS-MILLION WS-N
     .
 END PROGRAM TEST-STRUCT-36-7-5.
