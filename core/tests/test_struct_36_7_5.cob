 PROCEDURE DIVISION.
     MOVE "N" TO TL-MODE
*>   5.2 recursiveCorridor from (5, 5), depth 6, in each heading, four seeds
     MOVE 0 TO WS-K
     PERFORM VARYING WS-S FROM 1 BY 1 UNTIL WS-S > 4
         PERFORM VARYING WS-D FROM 0 BY 1 UNTIL WS-D > 3
             ADD 1 TO WS-K
             MOVE WS-S TO WS-SEED
             CALL "JRAND-SET-SEED" USING SP-RNG WS-SEED
             PERFORM CLEAR-GRID1
             CALL "MNG-CORRIDOR" USING WS-G1 WS-START WS-START WS-D WS-DEPTH
             MOVE 1 TO WS-HG
             PERFORM HASH-GRID
             MOVE WS-S TO WS-ED
             MOVE WS-D TO WS-ED2
             MOVE SPACES TO WS-CASE
             STRING "acceptance US12 36-7§5.2 recursiveCorridor seed " FUNCTION TRIM(WS-ED) " heading " FUNCTION TRIM(WS-ED2) ": the grid" DELIMITED BY SIZE INTO WS-CASE
             MOVE WS-CASE TO TL-CASE
             MOVE T52-V1(WS-K) TO TL-EXPECTED-N
             MOVE WS-H TO TL-OBSERVED-N
             CALL "TEST-ASSERT" USING TESTLIB-ASSERT
             PERFORM NEXT-DRAW
             MOVE SPACES TO WS-CASE
             STRING "acceptance US12 36-7§5.2 recursiveCorridor seed " FUNCTION TRIM(WS-ED) " heading " FUNCTION TRIM(WS-ED2) ": the draws made" DELIMITED BY SIZE INTO WS-CASE
             MOVE WS-CASE TO TL-CASE
             MOVE T52-V2(WS-K) TO TL-EXPECTED-N
             MOVE WS-N TO TL-OBSERVED-N
             CALL "TEST-ASSERT" USING TESTLIB-ASSERT
         END-PERFORM
     END-PERFORM
*>   a depth of 0 or less changes nothing and draws nothing
     MOVE 3 TO WS-SEED
     CALL "JRAND-SET-SEED" USING SP-RNG WS-SEED
     MOVE SP-RNG TO WS-BEFORE
     PERFORM CLEAR-GRID1
     CALL "MNG-CORRIDOR" USING WS-G1 WS-START WS-START WS-ZERO WS-ZERO
     MOVE 1 TO WS-HG
     PERFORM HASH-GRID
     MOVE "acceptance US12 36-7§5.2 recursiveCorridor with depth 0 returns at once: no cell, no draw" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-H + (SP-RNG - WS-BEFORE)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   5.3 cleanEdges to a fixpoint on corridor grids
     MOVE 0 TO WS-K
     PERFORM VARYING WS-S FROM 1 BY 1 UNTIL WS-S > 4
         ADD 1 TO WS-K
         MOVE WS-S TO WS-SEED
         CALL "JRAND-SET-SEED" USING SP-RNG WS-SEED
         PERFORM CLEAR-GRID1
         MOVE 3 TO WS-D
         CALL "MNG-CORRIDOR" USING WS-G1 WS-START WS-START WS-D WS-DEPTH
         MOVE SP-RNG TO WS-BEFORE
         PERFORM CLEAN-ALL
         MOVE 1 TO WS-HG
         PERFORM HASH-GRID
         MOVE WS-S TO WS-ED
         MOVE SPACES TO WS-CASE
         STRING "acceptance US12 36-7§5.3 cleanEdges seed " FUNCTION TRIM(WS-ED) ": passes until false" DELIMITED BY SIZE INTO WS-CASE
         MOVE WS-CASE TO TL-CASE
         MOVE T53-V1(WS-K) TO TL-EXPECTED-N
         MOVE WS-PASSES TO TL-OBSERVED-N
         CALL "TEST-ASSERT" USING TESTLIB-ASSERT
         MOVE SPACES TO WS-CASE
         STRING "acceptance US12 36-7§5.3 cleanEdges seed " FUNCTION TRIM(WS-ED) ": the grid, and no random draw" DELIMITED BY SIZE INTO WS-CASE
         MOVE WS-CASE TO TL-CASE
         MOVE T53-V2(WS-K) TO TL-EXPECTED-N
         COMPUTE TL-OBSERVED-N = WS-H + (SP-RNG - WS-BEFORE)
         CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     END-PERFORM
*>   hand-built grids
     PERFORM CLEAR-GRID1
     MOVE 3 TO WS-X
     MOVE 3 TO WS-Y
     MOVE 1 TO WS-V
     CALL "MNG-SET" USING WS-G1 WS-X WS-Y WS-V
     MOVE 5 TO WS-X
     MOVE 3 TO WS-Y
     MOVE 1 TO WS-V
     CALL "MNG-SET" USING WS-G1 WS-X WS-Y WS-V
     MOVE 4 TO WS-X
     MOVE 4 TO WS-Y
     MOVE 1 TO WS-V
     CALL "MNG-SET" USING WS-G1 WS-X WS-Y WS-V

     PERFORM CLEAN-CASE
     PERFORM CLEAR-GRID1
