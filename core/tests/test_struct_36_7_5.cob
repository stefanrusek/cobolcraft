*>   5.4 identifyRooms on corridor grids: rooms and the draws
     MOVE 0 TO WS-K
     PERFORM VARYING WS-S FROM 1 BY 1 UNTIL WS-S > 6
         ADD 1 TO WS-K
         MOVE WS-S TO WS-SEED
         CALL "JRAND-SET-SEED" USING SP-RNG WS-SEED
         PERFORM CLEAR-GRID1
         MOVE 3 TO WS-D
         CALL "MNG-CORRIDOR" USING WS-G1 WS-START WS-START WS-D WS-DEPTH
         PERFORM CLEAN-ALL
         PERFORM CLEAR-GRID3
         CALL "MNG-IDENTIFY" USING WS-G1 WS-G3
         MOVE 3 TO WS-HG
         PERFORM HASH-GRID
         MOVE WS-S TO WS-ED
         MOVE SPACES TO WS-CASE
         STRING "acceptance US12 36-7§5.4 identifyRooms seed " FUNCTION TRIM(WS-ED) ": the room codes" DELIMITED BY SIZE INTO WS-CASE
         MOVE WS-CASE TO TL-CASE
         MOVE T54-V1(WS-K) TO TL-EXPECTED-N
         MOVE WS-H TO TL-OBSERVED-N
         CALL "TEST-ASSERT" USING TESTLIB-ASSERT
         PERFORM NEXT-DRAW
         MOVE SPACES TO WS-CASE
         STRING "acceptance US12 36-7§5.4 identifyRooms seed " FUNCTION TRIM(WS-ED) ": shuffle and two booleans per room use the draws the text gives" DELIMITED BY SIZE INTO WS-CASE
         MOVE WS-CASE TO TL-CASE
         MOVE T54-V2(WS-K) TO TL-EXPECTED-N
         MOVE WS-N TO TL-OBSERVED-N
         CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     END-PERFORM
