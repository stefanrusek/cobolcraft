     PERFORM BEGIN-CASE
     MOVE "1 1 0 0 0 0 7" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS1-CONTROL-INPUT" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-I7 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 0 0 0 1 7" TO WS-IN
     PERFORM LOAD-IN
