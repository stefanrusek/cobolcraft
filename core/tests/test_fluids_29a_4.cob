 PROCEDURE DIVISION.
     MOVE "T" TO TL-MODE
     MOVE "acceptance US12 29a§4 Lava specifics: canSpreadFireAround: the rule -1 or a player close enough" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "-1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-CAN-SPREAD-FIRE" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "128 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-CAN-SPREAD-FIRE" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "128 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-CAN-SPREAD-FIRE" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29a§4 Lava specifics: fire spread offsets: each step moves (draw - 1, +1, draw - 1) from the previous position when n > 0, and (draw - 1, 0, draw - 1) from the lava cell when n =" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1 5 70 5 2 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-LAVA-STEP" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1 6 71 4 1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-LAVA-STEP" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "0 5 70 5 0 2" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-LAVA-STEP" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "6/71/4 6/72/4 4/70/6" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29a§4 Lava specifics: n > 0: an unloaded position or a motion-blocking block ends the tick, air with a flammable neighbour gets fire, other air goes on; n = 0: fire above a" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1 0 0 0 0 0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-LAVA-DECIDE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-I7 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 1 1 0 0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-LAVA-DECIDE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-I7 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 1 0 0 0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-LAVA-DECIDE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-I7 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 0 0 0 0 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-LAVA-DECIDE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-I7 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 0 0 0 0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-LAVA-DECIDE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-I7 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 0 0 1 1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-LAVA-DECIDE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-I7 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 1 0 0 1 1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-LAVA-DECIDE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-I7 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 1 0 0 0 1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-LAVA-DECIDE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-I7 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 1 0 0 1 0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-LAVA-DECIDE" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-I7 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "2 1 0 2 0 2 3 0 0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29a§4 Lava specifics: lavaIgnite raises the fire ticks to at least 300 unless the entity is fire-immune" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-IGNITE" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 100" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-IGNITE" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 400" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-IGNITE" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-IGNITE" USING WS-I1 WS-I2 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "300 300 400 0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29a§4 Lava specifics: lavaHurt deals 4.0 damage on the server to an entity that is not fire-immune and plays generic.burn unless silent" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0 1 0 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-LAVA-HURT" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 0 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-LAVA-HURT" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 0 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-LAVA-HURT" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "0 1 1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-LAVA-HURT" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "0 1 0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-LAVA-HURT" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "40/1 0/0 0/0 40/0 40/0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29a§4 Lava specifics: the generic.burn pitch is 2.0 + nextFloat * 0.4" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0.5" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-BURN-PITCH" USING WS-FX1 WS-RF1
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000000
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0.0" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-BURN-PITCH" USING WS-FX1 WS-RF1
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000000
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "2200000 2000000" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29a§4 Lava specifics: effects apply in the order freeze, clear freeze, fire ignite, lava ignite (then lavaHurt), extinguish; the pass stops once the entity is dead" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0 0 0 1 1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-EFFECTS" USING WS-ISG WS-I6 WS-RSG WS-R9
     MOVE 5 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 0 1 1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-EFFECTS" USING WS-ISG WS-I6 WS-RSG WS-R9
     MOVE 5 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 0 0 0 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-EFFECTS" USING WS-ISG WS-I6 WS-RSG WS-R9
     MOVE 5 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 0 0 0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-EFFECTS" USING WS-ISG WS-I6 WS-RSG WS-R9
     MOVE 5 TO WS-N
     PERFORM ADD-N
     MOVE "4/6/5/0/0 4/6/0/0/0 1/2/0/0/0 0/0/0/0/0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29a§4 Lava specifics: while in lava the fall distance halves each tick and the burning damage is skipped" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1 10" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-LAVA-TICK" USING WS-I1 WS-FX2 WS-RF1 WS-R2
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "0 10" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-LAVA-TICK" USING WS-I1 WS-FX2 WS-RF1 WS-R2
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "5000/1 10000/0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29a§4 Lava specifics: lava ambience: pop particle and sound only with air above on a 1 in 100 draw, ambient sound on a 1 in 200 draw" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1 0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-LAVA-AMBIENCE" USING WS-I1 WS-I2 WS-I3 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1 5 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-LAVA-AMBIENCE" USING WS-I1 WS-I2 WS-I3 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 7" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-LAVA-AMBIENCE" USING WS-I1 WS-I2 WS-I3 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1 99 199" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-LAVA-AMBIENCE" USING WS-I1 WS-I2 WS-I3 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1/1 0/1 0/0 0/0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29a§4 Lava specifics: water ambience: a flowing non-falling state plays ambient.water on a 1 in 64 draw; a source or falling state spawns an underwater particle on a 1 in 10 draw" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0 0 3" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-WATER-AMBIENCE" USING WS-I1 WS-I2 WS-I3 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "0 5 3" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-WATER-AMBIENCE" USING WS-I1 WS-I2 WS-I3 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-WATER-AMBIENCE" USING WS-I1 WS-I2 WS-I3 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 4" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-WATER-AMBIENCE" USING WS-I1 WS-I2 WS-I3 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1/0 0/0 0/1 0/0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29a§4 Lava specifics: lava.pop sound volume 0.2 + r * 0.2 and pitch 0.9 + r * 0.15; ambient.water volume r * 0.25 + 0.75 and pitch r + 0.5" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0.5 0.5" TO WS-IN
     PERFORM LOAD-IN
     CALL "FL-SOUND-FORMULAS" USING WS-FX1 WS-FX2 WS-RF1 WS-RF2 WS-RF3 WS-RF4
     COMPUTE WS-R1 ROUNDED = WS-RF1 * 1000000
     COMPUTE WS-R2 ROUNDED = WS-RF2 * 1000000
     COMPUTE WS-R3 ROUNDED = WS-RF3 * 1000000
     COMPUTE WS-R4 ROUNDED = WS-RF4 * 1000000
     MOVE 4 TO WS-N
     PERFORM ADD-N
     MOVE "300000/975000/875000/1000000" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 BEGIN-CASE.
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR
     .

 LOAD-IN.
     MOVE 1 TO WS-P
     PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 16
         MOVE SPACES TO WS-TOK
         IF WS-P <= 160
             UNSTRING WS-IN DELIMITED BY ALL SPACE INTO WS-TOK WITH POINTER WS-P
         END-IF
         COMPUTE WS-FX(WS-K) = FUNCTION NUMVAL(WS-TOK)
         COMPUTE WS-I(WS-K) = FUNCTION NUMVAL(WS-TOK)
     END-PERFORM
     .

 ADD-N.
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N
         MOVE WS-R(WS-J) TO WS-SHOW
         IF WS-J > 1
             STRING "/" DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
         END-IF
         STRING FUNCTION TRIM(WS-SHOW) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-PERFORM
     STRING " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .

 ADD-TEXT.
     STRING FUNCTION TRIM(WS-T1) "|" FUNCTION TRIM(WS-T2) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .
 END PROGRAM TEST-FLUIDS-29A-4.
