*> Acceptance test (lane 002-lane-mobsb4, T8804; docs/protocol/21 sections 5.5 and 5.6): the immunity to zombification (metadata 16 of a piglin or brute, 18 of a hoglin) stops the
*> conversion, and an adult hoglin's or zoglin's hit throws the player: k = 1 - resistance, horizontal k x (nextFloat x 0.5 + 0.2) turned by -10 to 10 degrees, vertical k x nextFloat x 0.5.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. ACC-US15-PIGLIN-IMMUNE-HOGLIN.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY PROTO.
 01 WS-PLAYER              BINARY-LONG.
 01 WS-KEY                 PIC X(112).
 01 WS-ENTITY-ROW          PIC X(66).
 01 WS-STATUS              BINARY-LONG.
 01 WS-PTYPE               BINARY-LONG.
 01 WS-HTYPE               BINARY-LONG.
 01 WS-DIM                 BINARY-LONG.
 01 WS-P                   BINARY-LONG.
 01 WS-H                   BINARY-LONG.
 01 WS-DONE                BINARY-LONG.
 01 WS-DX                  BINARY-LONG.
 01 WS-DZ                  BINARY-LONG.
 01 WS-RES                 BINARY-LONG.
 01 WS-R1                  BINARY-LONG.
 01 WS-R2                  BINARY-LONG.
 01 WS-R3                  BINARY-LONG.
 01 WS-VX                  BINARY-LONG.
 01 WS-VY                  BINARY-LONG.
 01 WS-VZ                  BINARY-LONG.
 01 WS-X                   FLOAT-LONG.
 01 WS-Y                   FLOAT-LONG.
 01 WS-Z                   FLOAT-LONG.
 01 WS-YAW                 FLOAT-SHORT VALUE 0.
 01 WS-CAPACITY            BINARY-LONG VALUE 64.
 LINKAGE SECTION.
 01 WS-VIEW.
    05 WS-BYTE             PIC X OCCURS 64 TIMES.
 PROCEDURE DIVISION.
     CALL "MS-TEST-OPEN" USING WS-PLAYER
     MOVE "N" TO TL-MODE
     MOVE PL-DIM(WS-PLAYER) TO WS-DIM
     MOVE "minecraft:piglin" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-PTYPE WS-ENTITY-ROW WS-STATUS
     MOVE "minecraft:hoglin" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-HTYPE WS-ENTITY-ROW WS-STATUS
     MOVE PL-X(WS-PLAYER) TO WS-X
     MOVE PL-Y(WS-PLAYER) TO WS-Y
     MOVE PL-Z(WS-PLAYER) TO WS-Z
*>   The throw vector.
     MOVE 1000 TO WS-DX
     MOVE 0 TO WS-DZ WS-RES WS-R1 WS-R3
     MOVE 10 TO WS-R2
     CALL "HOGLIN-THROW" USING WS-DX WS-DZ WS-RES WS-R1 WS-R2 WS-R3 WS-VX WS-VY WS-VZ
     MOVE "acceptance US15 21§5.6 k 1, roll 0: 0.2 along x, nothing vertical" TO TL-CASE
     MOVE 200 TO TL-EXPECTED-N
     MOVE WS-VX TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US15 21§5.6 vertical k x 0 x 0.5 is 0" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-VY + WS-VZ
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 999 TO WS-R1
     MOVE 999 TO WS-R3
     CALL "HOGLIN-THROW" USING WS-DX WS-DZ WS-RES WS-R1 WS-R2 WS-R3 WS-VX WS-VY WS-VZ
     MOVE "acceptance US15 21§5.6 roll 0.999: 0.2 + 0.4995 = 699 along x" TO TL-CASE
     MOVE 699 TO TL-EXPECTED-N
     MOVE WS-VX TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US15 21§5.6 vertical 0.999 x 0.5 = 499" TO TL-CASE
     MOVE 499 TO TL-EXPECTED-N
     MOVE WS-VY TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 0 TO WS-R1
     MOVE 20 TO WS-R2
     MOVE 0 TO WS-R3
     CALL "HOGLIN-THROW" USING WS-DX WS-DZ WS-RES WS-R1 WS-R2 WS-R3 WS-VX WS-VY WS-VZ
     MOVE "acceptance US15 21§5.6 turned +10 degrees: z is 200 sin 10 = 34" TO TL-CASE
     MOVE 34 TO TL-EXPECTED-N
     MOVE WS-VZ TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 10 TO WS-R2
     MOVE 600 TO WS-RES
     CALL "HOGLIN-THROW" USING WS-DX WS-DZ WS-RES WS-R1 WS-R2 WS-R3 WS-VX WS-VY WS-VZ
     MOVE "acceptance US15 21§5.6 knockback resistance 0.6 leaves k 0.4: 80" TO TL-CASE
     MOVE 80 TO TL-EXPECTED-N
     MOVE WS-VX TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 1000 TO WS-RES
     CALL "HOGLIN-THROW" USING WS-DX WS-DZ WS-RES WS-R1 WS-R2 WS-R3 WS-VX WS-VY WS-VZ
     MOVE "acceptance US15 21§5.6 resistance 1 leaves k 0: no throw" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-VX + WS-VY + WS-VZ
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   The hit.
     CALL "MOB-SPAWN" USING WS-DIM WS-HTYPE WS-X WS-Y WS-Z WS-YAW WS-H
     COMPUTE EN-X(WS-H) = PL-X(WS-PLAYER) - 1
     CALL "HOGLIN-HIT" USING WS-PLAYER WS-H WS-VX WS-VY WS-VZ
     MOVE "acceptance US15 21§5.6 an adult hoglin throws the player away from it (x positive)" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE 0 TO TL-OBSERVED-N
     IF WS-VX > 0
         MOVE 1 TO TL-OBSERVED-N
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE -24000 TO EN-MOBAGE(WS-H)
     CALL "HOGLIN-HIT" USING WS-PLAYER WS-H WS-VX WS-VY WS-VZ
     MOVE "acceptance US15 21§5.6 a baby hoglin does not throw" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION ABS(WS-VX) + FUNCTION ABS(WS-VY) + FUNCTION ABS(WS-VZ)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "MOB-SPAWN" USING WS-DIM WS-PTYPE WS-X WS-Y WS-Z WS-YAW WS-P
     CALL "HOGLIN-HIT" USING WS-PLAYER WS-P WS-VX WS-VY WS-VZ
     MOVE "acceptance US15 21§5.5 a piglin's hit does not throw" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = FUNCTION ABS(WS-VX) + FUNCTION ABS(WS-VY) + FUNCTION ABS(WS-VZ)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
*>   Immunity.
     MOVE 1 TO EN-PIG-IMMUNE(WS-P)
     MOVE 400 TO EN-ZOMBIFY(WS-P)
     CALL "PIGLIN-ZOMBIFY" USING WS-P WS-DONE
     MOVE "acceptance US15 21§5.5 an immune piglin does not convert and its counter resets" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     COMPUTE TL-OBSERVED-N = WS-DONE + EN-ZOMBIFY(WS-P)
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     CALL "STDMOB-VARIANT-BUILD" USING WS-P PB-BUFFER
     SET ADDRESS OF WS-VIEW TO PB-ADDR
     MOVE "T" TO TL-MODE
     MOVE "acceptance US15 21§5.5 piglin metadata 16 boolean true" TO TL-CASE
     MOVE "yes" TO TL-EXPECTED
     MOVE "no" TO TL-OBSERVED
     IF PB-LENGTH >= 6 AND WS-BYTE(1) = X"65" AND WS-BYTE(3) = X"10" AND WS-BYTE(5) = X"01"
         MOVE "yes" TO TL-OBSERVED
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "PB-RESET" USING PB-BUFFER
     MOVE 0 TO EN-PIG-IMMUNE(WS-P)
     CALL "STDMOB-VARIANT-BUILD" USING WS-P PB-BUFFER
     MOVE "N" TO TL-MODE
     MOVE "acceptance US15 21§5.5 a piglin that is not immune sends nothing" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE PB-LENGTH TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 1 TO EN-PIG-IMMUNE(WS-H)
     MOVE 0 TO EN-MOBAGE(WS-H)
     CALL "PB-RESET" USING PB-BUFFER
     CALL "STDMOB-VARIANT-BUILD" USING WS-H PB-BUFFER
     SET ADDRESS OF WS-VIEW TO PB-ADDR
     MOVE "T" TO TL-MODE
     MOVE "acceptance US15 21§5.6 hoglin metadata 18 boolean true" TO TL-CASE
     MOVE "yes" TO TL-EXPECTED
     MOVE "no" TO TL-OBSERVED
     IF PB-LENGTH >= 6 AND WS-BYTE(1) = X"65" AND WS-BYTE(3) = X"12" AND WS-BYTE(5) = X"01"
         MOVE "yes" TO TL-OBSERVED
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "PB-FREE" USING PB-BUFFER
     MOVE "N" TO TL-MODE
     MOVE 1 TO EN-PIG-IMMUNE(WS-H)
     MOVE 400 TO EN-ZOMBIFY(WS-H)
     CALL "PIGLIN-ZOMBIFY" USING WS-H WS-DONE
     MOVE "acceptance US15 21§5.6 an immune hoglin does not convert" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-DONE TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE 0 TO EN-PIG-IMMUNE(WS-H)
     MOVE 300 TO EN-ZOMBIFY(WS-H)
     CALL "PIGLIN-ZOMBIFY" USING WS-H WS-DONE
     MOVE "acceptance US15 21§5.6 a hoglin that is not immune converts above 300" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE WS-DONE TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.
 END PROGRAM ACC-US15-PIGLIN-IMMUNE-HOGLIN.
 COPY CORETEST.
 COPY MOBSPTEST.
