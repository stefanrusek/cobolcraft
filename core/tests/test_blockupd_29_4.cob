     COMPUTE WS-P4 = WS-GS
     COMPUTE WS-P5 = WS-G
     COMPUTE WS-P6 = 0
     PERFORM EXP
     MOVE "T" TO WS-LETTER
     COMPUTE WS-P1 = 3
     COMPUTE WS-P2 = WS-Y
     COMPUTE WS-P3 = 3
     COMPUTE WS-P4 = WS-GS
     COMPUTE WS-P5 = WS-G
     COMPUTE WS-P6 = 0
     PERFORM EXP
     PERFORM CHECK-KEEP
     PERFORM START-TRACE
     MOVE 300 TO CW-TICKS
     MOVE WS-BIG3 TO WS-MAX
     CALL "BT-DRAIN" USING WS-DIM WS-TYPE WS-MAX WS-RAN
     MOVE SPACES TO TL-EXPECTED
     MOVE 1 TO WS-PTR
     MOVE "T" TO WS-LETTER
     COMPUTE WS-P1 = 4
     COMPUTE WS-P2 = WS-Y
     COMPUTE WS-P3 = 3
     COMPUTE WS-P4 = WS-GS
     COMPUTE WS-P5 = WS-G
     COMPUTE WS-P6 = 0
     PERFORM EXP
     MOVE "T" TO WS-LETTER
     COMPUTE WS-P1 = 5
     COMPUTE WS-P2 = WS-Y
     COMPUTE WS-P3 = 3
     COMPUTE WS-P4 = WS-GS
     COMPUTE WS-P5 = WS-G
     COMPUTE WS-P6 = 0
     PERFORM EXP
     PERFORM CHECK

     MOVE "acceptance US12 29§4 Scheduled ticks: the call counts were 3 then 2"
         TO TL-CASE
     COMPUTE TL-OBSERVED-N = WS-RAN0 * 10 + WS-RAN
     MOVE 32 TO TL-EXPECTED-N
     PERFORM CHECK-N

     MOVE "acceptance US12 29§4 Scheduled ticks: the consumer drops a tick whose block changed: nothing runs and the tick is gone"
         TO TL-CASE
     MOVE 6 TO WS-X
     MOVE 3 TO WS-Z
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-X WS-Y WS-Z WS-GS
     MOVE 400 TO CW-TICKS
     MOVE 6 TO WS-X
     MOVE 3 TO WS-Z
     MOVE 0 TO WS-DELAY
     MOVE BT-P-NORMAL TO WS-PRIO
     CALL "BT-SCHEDULE" USING WS-DIM WS-TYPE WS-G WS-X WS-Y WS-Z WS-DELAY WS-PRIO WS-RESULT
     MOVE 6 TO WS-X
     MOVE 3 TO WS-Z
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-X WS-Y WS-Z WS-LS
     PERFORM START-TRACE
     MOVE 400 TO CW-TICKS
     MOVE WS-BIG TO WS-MAX
     CALL "BT-DRAIN" USING WS-DIM WS-TYPE WS-MAX WS-RAN
     COMPUTE TL-OBSERVED-N = BU-TRACE-LENGTH * 100 + WS-RAN * 10 + BT-COUNT
     MOVE 0 TO TL-EXPECTED-N
     PERFORM CHECK-N

     MOVE "acceptance US12 29§4 Scheduled ticks: a due tick in a chunk outside the ticking range waits"
         TO TL-CASE
     MOVE 8000 TO WS-X
     MOVE 3 TO WS-Z
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-X WS-Y WS-Z WS-GS
     MOVE 500 TO CW-TICKS
     MOVE 8000 TO WS-FAR
     MOVE WS-FAR TO WS-X
     MOVE 3 TO WS-Z
     MOVE 0 TO WS-DELAY
     MOVE BT-P-NORMAL TO WS-PRIO
     CALL "BT-SCHEDULE" USING WS-DIM WS-TYPE WS-G WS-X WS-Y WS-Z WS-DELAY WS-PRIO WS-RESULT
     PERFORM START-TRACE
     MOVE 500 TO CW-TICKS
     MOVE WS-BIG TO WS-MAX
     CALL "BT-DRAIN" USING WS-DIM WS-TYPE WS-MAX WS-RAN
     COMPUTE TL-OBSERVED-N = BU-TRACE-LENGTH * 100 + WS-RAN * 10 + BT-COUNT
     MOVE 1 TO TL-EXPECTED-N
     PERFORM CHECK-N
     MOVE 0 TO BT-COUNT

     MOVE "acceptance US12 29§4 Scheduled ticks: pack lists a chunk's ticks by sub-tick order with delay = trigger - game time and the priority "
         & "value (4.2)"
         TO TL-CASE
     MOVE 1 TO WS-X
     MOVE 7 TO WS-Z
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-X WS-Y WS-Z WS-GS
     MOVE 2 TO WS-X
     MOVE 7 TO WS-Z
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-X WS-Y WS-Z WS-GS
     MOVE 600 TO CW-TICKS
     MOVE 1 TO WS-X
     MOVE 7 TO WS-Z
     MOVE 5 TO WS-DELAY
     MOVE BT-P-LOW TO WS-PRIO
     CALL "BT-SCHEDULE" USING WS-DIM WS-TYPE WS-G WS-X WS-Y WS-Z WS-DELAY WS-PRIO WS-RESULT
     MOVE 2 TO WS-X
     MOVE 7 TO WS-Z
     MOVE 3 TO WS-DELAY
     MOVE BT-P-NORMAL TO WS-PRIO
     CALL "BT-SCHEDULE" USING WS-DIM WS-TYPE WS-G WS-X WS-Y WS-Z WS-DELAY WS-PRIO WS-RESULT
     MOVE 0 TO WS-CX
     MOVE 0 TO WS-CZ
     CALL "BT-PACK" USING WS-DIM WS-CX WS-CZ WS-TYPE BT-SAVED
     PERFORM SHOW-SAVED
     MOVE SPACES TO TL-EXPECTED
     MOVE 1 TO WS-PTR
     MOVE "1,Y,7,G,5,1;2,Y,7,G,3,0;" TO WS-TEMPLATE
     PERFORM EXPECT-SAVED
     PERFORM CHECK-PLAIN

     MOVE "acceptance US12 29§4 Scheduled ticks: unpack turns the list back into ticks with sub-tick orders -size to -1, drops positions outside"
         & " the chunk, and reloaded ticks run before later ones at the same time and priority"
         TO TL-CASE
     MOVE 0 TO BT-COUNT
     MOVE 3 TO BT-SV-COUNT
     MOVE 99 TO BT-SV-X(3)
     MOVE 99 TO BT-SV-Z(3)
     MOVE WS-Y TO BT-SV-Y(3)
     MOVE WS-G TO BT-SV-ID(3)
     MOVE 1 TO BT-SV-DELAY(3)
     MOVE 0 TO BT-SV-PRIO(3)
     CALL "BT-UNPACK" USING WS-DIM WS-CX WS-CZ WS-TYPE BT-SAVED
     MOVE 3 TO WS-X
     MOVE 7 TO WS-Z
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-X WS-Y WS-Z WS-GS
     MOVE 3 TO WS-X
     MOVE 7 TO WS-Z
     MOVE 5 TO WS-DELAY
     MOVE BT-P-LOW TO WS-PRIO
     CALL "BT-SCHEDULE" USING WS-DIM WS-TYPE WS-G WS-X WS-Y WS-Z WS-DELAY WS-PRIO WS-RESULT
     PERFORM START-TRACE
     MOVE 605 TO CW-TICKS
     MOVE WS-BIG TO WS-MAX
     CALL "BT-DRAIN" USING WS-DIM WS-TYPE WS-MAX WS-RAN
     MOVE SPACES TO TL-EXPECTED
     MOVE 1 TO WS-PTR
     MOVE "T" TO WS-LETTER
     COMPUTE WS-P1 = 2
     COMPUTE WS-P2 = WS-Y
     COMPUTE WS-P3 = 7
     COMPUTE WS-P4 = WS-GS
     COMPUTE WS-P5 = WS-G
     COMPUTE WS-P6 = 0
     PERFORM EXP
     MOVE "T" TO WS-LETTER
     COMPUTE WS-P1 = 1
     COMPUTE WS-P2 = WS-Y
     COMPUTE WS-P3 = 7
     COMPUTE WS-P4 = WS-GS
     COMPUTE WS-P5 = WS-G
     COMPUTE WS-P6 = 0
     PERFORM EXP
     MOVE "T" TO WS-LETTER
     COMPUTE WS-P1 = 3
     COMPUTE WS-P2 = WS-Y
     COMPUTE WS-P3 = 7
     COMPUTE WS-P4 = WS-GS
     COMPUTE WS-P5 = WS-G
     COMPUTE WS-P6 = 0
     PERFORM EXP
     PERFORM CHECK

     MOVE "acceptance US12 29§4 Scheduled ticks: copyArea copies ticks in a box with their remaining delays at an offset and clearArea removes t"
         & "hem"
         TO TL-CASE
     MOVE 0 TO BT-COUNT
     MOVE 700 TO CW-TICKS
     MOVE 1 TO WS-X
     MOVE 5 TO WS-Z
     MOVE 5 TO WS-DELAY
     MOVE BT-P-NORMAL TO WS-PRIO
     CALL "BT-SCHEDULE" USING WS-DIM WS-TYPE WS-G WS-X WS-Y WS-Z WS-DELAY WS-PRIO WS-RESULT
     MOVE 2 TO WS-X
     MOVE 5 TO WS-Z
     MOVE 6 TO WS-DELAY
     MOVE BT-P-NORMAL TO WS-PRIO
     CALL "BT-SCHEDULE" USING WS-DIM WS-TYPE WS-G WS-X WS-Y WS-Z WS-DELAY WS-PRIO WS-RESULT
     MOVE 3 TO WS-X
     MOVE 5 TO WS-Z
     MOVE 7 TO WS-DELAY
     MOVE BT-P-NORMAL TO WS-PRIO
     CALL "BT-SCHEDULE" USING WS-DIM WS-TYPE WS-G WS-X WS-Y WS-Z WS-DELAY WS-PRIO WS-RESULT
     MOVE 1 TO WS-X
     MOVE 2 TO WS-X2
     MOVE 5 TO WS-Z
     MOVE 10 TO WS-DX
     MOVE WS-Y TO WS-Y2
     MOVE WS-Z TO WS-Z2
     CALL "BT-COPY-AREA" USING WS-DIM WS-X WS-Y WS-Z WS-X2 WS-Y2 WS-Z2 WS-DX WS-ZERO WS-ZERO2
     CALL "BT-CLEAR-AREA" USING WS-DIM WS-X WS-Y WS-Z WS-X2 WS-Y2 WS-Z2
     MOVE 1 TO WS-X
     CALL "BT-HAS" USING WS-DIM WS-TYPE WS-G WS-X WS-Y WS-Z WS-RESULT
     MOVE WS-RESULT TO TL-OBSERVED-N
     MOVE 2 TO WS-X
     CALL "BT-HAS" USING WS-DIM WS-TYPE WS-G WS-X WS-Y WS-Z WS-RESULT
     COMPUTE TL-OBSERVED-N = TL-OBSERVED-N * 10 + WS-RESULT
     MOVE 3 TO WS-X
     CALL "BT-HAS" USING WS-DIM WS-TYPE WS-G WS-X WS-Y WS-Z WS-RESULT
     COMPUTE TL-OBSERVED-N = TL-OBSERVED-N * 10 + WS-RESULT
     MOVE 11 TO WS-X
     CALL "BT-HAS" USING WS-DIM WS-TYPE WS-G WS-X WS-Y WS-Z WS-RESULT
     COMPUTE TL-OBSERVED-N = TL-OBSERVED-N * 10 + WS-RESULT
     MOVE 12 TO WS-X
     CALL "BT-HAS" USING WS-DIM WS-TYPE WS-G WS-X WS-Y WS-Z WS-RESULT
     COMPUTE TL-OBSERVED-N = TL-OBSERVED-N * 10 + WS-RESULT
     MOVE 13 TO WS-X
     CALL "BT-HAS" USING WS-DIM WS-TYPE WS-G WS-X WS-Y WS-Z WS-RESULT
     COMPUTE TL-OBSERVED-N = TL-OBSERVED-N * 10 + WS-RESULT
     MOVE 001110 TO TL-EXPECTED-N
     PERFORM CHECK-N

     MOVE "acceptance US12 29§4 Scheduled ticks: a tick whose handler schedules itself with delay 0 is not seen by the same call and runs in the"
         & " next one"
         TO TL-CASE
     MOVE 0 TO BT-COUNT
     MOVE 800 TO CW-TICKS
     MOVE 4 TO WS-X
     MOVE 9 TO WS-Z
     CALL "WORLD-SET-BLOCK" USING WS-DIM WS-X WS-Y WS-Z WS-GS
     MOVE 7 TO WS-KIND
     MOVE WS-G TO WS-BLOCK
     MOVE 3 TO WS-EFFECT
     MOVE 0 TO WS-ARG
     MOVE 0 TO WS-FLAGS
     CALL "BU-RULE-ADD" USING WS-KIND WS-BLOCK WS-EFFECT WS-ARG WS-FLAGS
     MOVE 4 TO WS-X
     MOVE 9 TO WS-Z
     MOVE 0 TO WS-DELAY
     MOVE BT-P-NORMAL TO WS-PRIO
     CALL "BT-SCHEDULE" USING WS-DIM WS-TYPE WS-G WS-X WS-Y WS-Z WS-DELAY WS-PRIO WS-RESULT
     PERFORM START-TRACE
     MOVE 800 TO CW-TICKS
     MOVE WS-BIG TO WS-MAX
     CALL "BT-DRAIN" USING WS-DIM WS-TYPE WS-MAX WS-RAN
     MOVE WS-RAN TO WS-RAN0
     MOVE BT-COUNT TO WS-R1
     MOVE 800 TO CW-TICKS
     MOVE WS-BIG TO WS-MAX
     CALL "BT-DRAIN" USING WS-DIM WS-TYPE WS-MAX WS-RAN
     CALL "BU-RULES-CLEAR"
     COMPUTE TL-OBSERVED-N = WS-RAN0 * 100 + WS-R1 * 10 + WS-RAN
     MOVE 111 TO TL-EXPECTED-N
     PERFORM CHECK-N-PLAIN
     STOP RUN.

 START-TRACE.
     CALL "BU-RESET-TRACE"
     MOVE 1 TO BU-TRACE-ON
     .
 EXP.
     MOVE WS-P1 TO WS-E1
     MOVE WS-P2 TO WS-E2
     MOVE WS-P3 TO WS-E3
     MOVE WS-P4 TO WS-E4
     MOVE WS-P5 TO WS-E5
     MOVE WS-P6 TO WS-E6
     STRING WS-LETTER " " FUNCTION TRIM(WS-E1) " " FUNCTION TRIM(WS-E2) " " FUNCTION TRIM(WS-E3) " "
         FUNCTION TRIM(WS-E4) " " FUNCTION TRIM(WS-E5) " " FUNCTION TRIM(WS-E6) ";" DELIMITED BY SIZE
         INTO TL-EXPECTED POINTER WS-PTR
     .
 CHECK.
     MOVE "T" TO TL-MODE
     MOVE SPACES TO TL-OBSERVED
     IF BU-TRACE-LENGTH > 0
         MOVE BU-TRACE(1:BU-TRACE-LENGTH) TO TL-OBSERVED
     END-IF
     MOVE 0 TO BU-TRACE-ON
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     .
 CHECK-KEEP.
     MOVE "T" TO TL-MODE
     MOVE SPACES TO TL-OBSERVED
     IF BU-TRACE-LENGTH > 0
         MOVE BU-TRACE(1:BU-TRACE-LENGTH) TO TL-OBSERVED
     END-IF
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     .
 CHECK-PLAIN.
     MOVE "T" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     .
 CHECK-N.
     MOVE "N" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "T" TO TL-MODE
     .
 CHECK-N-PLAIN.
     MOVE 0 TO BU-TRACE-ON
     PERFORM CHECK-N
     .
 SHOW-SAVED.
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > BT-SV-COUNT
         MOVE BT-SV-X(WS-I) TO WS-E1
         MOVE BT-SV-Y(WS-I) TO WS-E2
         MOVE BT-SV-Z(WS-I) TO WS-E3
         MOVE BT-SV-ID(WS-I) TO WS-E4
         MOVE BT-SV-DELAY(WS-I) TO WS-E5
         MOVE BT-SV-PRIO(WS-I) TO WS-E6
         STRING FUNCTION TRIM(WS-E1) "," FUNCTION TRIM(WS-E2) "," FUNCTION TRIM(WS-E3) "," FUNCTION TRIM(WS-E4) ","
             FUNCTION TRIM(WS-E5) "," FUNCTION TRIM(WS-E6) ";" DELIMITED BY SIZE INTO TL-OBSERVED POINTER WS-PTR
     END-PERFORM
     .
 EXPECT-SAVED.
     MOVE WS-Y TO WS-E2
     MOVE WS-G TO WS-E4
     MOVE SPACES TO TL-EXPECTED
     MOVE 1 TO WS-PTR
     STRING "1," FUNCTION TRIM(WS-E2) ",7," FUNCTION TRIM(WS-E4) ",5,1;2," FUNCTION TRIM(WS-E2) ",7,"
         FUNCTION TRIM(WS-E4) ",3,0;" DELIMITED BY SIZE INTO TL-EXPECTED POINTER WS-PTR
     .
 END PROGRAM TEST-BLOCKUPD-29-4.

 COPY CORETEST.
