*> Test of the decimal-free random tick loops (core/src/worldsim-33f.cob, lane bugsw T10302): from several starting values of the level's randValue (zero, both 32-bit extremes, negative
*> and positive ones) WL-PRECIP-RUN leaves the same randValue as that many steps of WL-RANDOM-POS, and WL-SECTION-RUN on a section of an empty chunk (nothing random-ticks) does too.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-WORLDSIM-FAST.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY COREAPI.
 COPY DIMENSIONS.
 COPY WSIM.
 01 WS-DIM                 BINARY-LONG VALUE 1.
 01 WS-STARTS.
    05 FILLER              BINARY-LONG VALUE 0.
    05 FILLER              BINARY-LONG VALUE -2147483648.
    05 FILLER              BINARY-LONG VALUE 2147483647.
    05 FILLER              BINARY-LONG VALUE -1.
    05 FILLER              BINARY-LONG VALUE 123456789.
    05 FILLER              BINARY-LONG VALUE -987654321.
 01 WS-START-TABLE REDEFINES WS-STARTS.
    05 WS-START            BINARY-LONG OCCURS 6 TIMES.
 01 WS-I                   BINARY-LONG.
 01 WS-K                   BINARY-LONG.
 01 WS-RAND                BINARY-LONG.
 01 WS-COUNT               BINARY-LONG VALUE 300.
 01 WS-X0                  BINARY-LONG VALUE 0.
 01 WS-Y0                  BINARY-LONG VALUE 0.
 01 WS-Z0                  BINARY-LONG VALUE 0.
 01 WS-MASK                BINARY-LONG VALUE 15.
 01 WS-X                   BINARY-LONG.
 01 WS-Y                   BINARY-LONG.
 01 WS-Z                   BINARY-LONG.
 01 WS-DRY                 BINARY-LONG VALUE 0.
 01 WS-ROW                 BINARY-LONG.
 01 WS-ZERO                BINARY-LONG VALUE 0.
 01 WS-MIN-Y               BINARY-LONG.
 01 WS-SECTION-Y           BINARY-LONG.
 01 WS-EDIT                PIC -(10)9.
 PROCEDURE DIVISION.
     MOVE "N" TO TL-MODE
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     CALL "WORLDSIM-ENSURE"
     CALL "WORLD-CHUNK" USING WS-DIM WS-X0 WS-Z0 WS-ROW
     MOVE DM-MIN-Y(WS-DIM) TO WS-MIN-Y
     MOVE DM-MIN-Y(WS-DIM) TO WS-SECTION-Y
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 6
         MOVE WS-START(WS-I) TO WS-RAND
         PERFORM WS-COUNT TIMES
             CALL "WL-RANDOM-POS" USING WS-RAND WS-X0 WS-Y0 WS-Z0 WS-MASK WS-X WS-Y WS-Z
         END-PERFORM
         MOVE WS-START(WS-I) TO WSM-RAND(WS-DIM)
         CALL "WL-PRECIP-RUN" USING WS-DIM WS-X0 WS-Z0 WS-COUNT WS-DRY
         MOVE WS-START(WS-I) TO WS-K
         MOVE WS-START(WS-I) TO WS-EDIT
         MOVE SPACES TO TL-CASE
         STRING "test worldsim fast: WL-PRECIP-RUN from " FUNCTION TRIM(WS-EDIT) " ends at the randValue of 300 WL-RANDOM-POS steps" DELIMITED BY SIZE INTO TL-CASE
         MOVE WS-RAND TO TL-EXPECTED-N
         MOVE WSM-RAND(WS-DIM) TO TL-OBSERVED-N
         CALL "TEST-ASSERT" USING TESTLIB-ASSERT
         MOVE WS-START(WS-I) TO WSM-RAND(WS-DIM)
         CALL "WL-SECTION-RUN" USING WS-DIM WS-ZERO WS-X0 WS-Y0 WS-Z0 WS-COUNT WS-MIN-Y
         CALL "WL-SECTION-RUN" USING WS-DIM WS-ROW WS-X0 WS-SECTION-Y WS-Z0 WS-COUNT WS-MIN-Y
         MOVE SPACES TO TL-CASE
         STRING "test worldsim fast: WL-SECTION-RUN from " FUNCTION TRIM(WS-EDIT) " ends at the randValue of 300 WL-RANDOM-POS steps" DELIMITED BY SIZE INTO TL-CASE
         MOVE WS-RAND TO TL-EXPECTED-N
         MOVE WSM-RAND(WS-DIM) TO TL-OBSERVED-N
         CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     END-PERFORM
     STOP RUN.
 END PROGRAM TEST-WORLDSIM-FAST.
 COPY CORETEST.
