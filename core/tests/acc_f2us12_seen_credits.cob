*> Acceptance test (US12-3, 45 section 3 and 39 section 7.5): seenCredits is saved with the player (a Byte, always written) and read back
*> at the next join, so a player who saw the credits is not shown them again after the world is reopened; wonGame is not saved.
 IDENTIFICATION DIVISION.
 PROGRAM-ID. ACC-F2US12-SEEN-CREDITS.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY COREAPI.
 COPY PROTO.
 COPY ENDTRAVEL.
 01 WS-CAPACITY            BINARY-LONG VALUE 65536.
 01 WS-WORLD               PIC X(64) VALUE Z"build/core-test-world".
 01 WS-CREATED             BINARY-LONG.
 01 WS-ALICE-NAME          PIC X(16) VALUE "Alice".
 01 WS-BOB-NAME            PIC X(16) VALUE "Bob".
 01 WS-LENGTH-5            BINARY-LONG VALUE 5.
 01 WS-LENGTH-3            BINARY-LONG VALUE 3.
 01 WS-ALICE               BINARY-LONG.
 01 WS-BOB                 BINARY-LONG.
 01 WS-ROW                 BINARY-LONG.
 01 WS-FILE                PIC X(256).
 01 WS-ROOT                BINARY-LONG.
 01 WS-PATH                PIC X(128) VALUE "seenCredits".
 01 WS-TEXT                PIC X(8192).
 01 WS-HEX                 PIC X(1024).
 01 WS-AREA                PIC X(512).
 01 WS-SIXTEEN             BINARY-LONG VALUE 16.
 01 WS-CODE                BINARY-LONG.
 01 WS-ONE                 BINARY-LONG VALUE 1.
 PROCEDURE DIVISION.
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     MOVE 0 TO CS-DEFAULT-MODE CS-HOSTILE-MOBS
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     CALL "TEST-JOIN" USING WS-ALICE-NAME WS-LENGTH-5 WS-ALICE
     CALL "TEST-JOIN" USING WS-BOB-NAME WS-LENGTH-3 WS-BOB
     CALL "TEST-TICKS" USING WS-ONE
*>   Alice has seen the credits, Bob has not.
     MOVE CN-PLAYER(WS-ALICE) TO WS-ROW
     MOVE 1 TO ET-SEEN(WS-ROW)
     CALL "CORE-SAVE"
     MOVE "acceptance US12-3 seen credits: Alice's player file holds seenCredits 1" TO TL-CASE
     PERFORM PLAYER-FILE
     CALL "TEST-NBT-FILE" USING WS-FILE PB-BUFFER WS-ROOT
     CALL "TEST-NBT-GET" USING PB-BUFFER WS-ROOT WS-PATH WS-TEXT
     MOVE FUNCTION TRIM(WS-TEXT) TO TL-OBSERVED
     MOVE "1" TO TL-EXPECTED
     MOVE "T" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE CN-PLAYER(WS-BOB) TO WS-ROW
     MOVE "acceptance US12-3 seen credits: Bob's player file holds seenCredits 0 (always written)" TO TL-CASE
     PERFORM PLAYER-FILE
     CALL "TEST-NBT-FILE" USING WS-FILE PB-BUFFER WS-ROOT
     CALL "TEST-NBT-GET" USING PB-BUFFER WS-ROOT WS-PATH WS-TEXT
     MOVE FUNCTION TRIM(WS-TEXT) TO TL-OBSERVED
     MOVE "0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT

     CALL "CORE-CONN-CLOSED" USING WS-ALICE
     CALL "CORE-CONN-CLOSED" USING WS-BOB
     CALL "CORE-WORLD-OPEN" USING WS-WORLD CORE-SETTINGS WS-CREATED
     CALL "TEST-JOIN" USING WS-ALICE-NAME WS-LENGTH-5 WS-ALICE
     CALL "TEST-JOIN" USING WS-BOB-NAME WS-LENGTH-3 WS-BOB
     MOVE CN-PLAYER(WS-ALICE) TO WS-ROW
     COMPUTE WS-CODE = ET-SEEN(WS-ROW) * 1000 + ET-WON(WS-ROW) * 100
     MOVE CN-PLAYER(WS-BOB) TO WS-ROW
     COMPUTE WS-CODE = WS-CODE + ET-SEEN(WS-ROW) * 10 + ET-WON(WS-ROW)
     MOVE "acceptance US12-3 seen credits: after the world is reopened Alice has seen them, Bob has not, nobody has wonGame" TO TL-CASE
     MOVE "N" TO TL-MODE
     MOVE 1000 TO TL-EXPECTED-N
     MOVE WS-CODE TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 PLAYER-FILE.
     MOVE PL-UUID(WS-ROW) TO WS-AREA
     CALL "TEST-HEX-OF" USING WS-AREA WS-SIXTEEN WS-HEX
     MOVE SPACES TO WS-FILE
     STRING "build/core-test-world/players/" WS-HEX(1:8) "-" WS-HEX(9:4) "-" WS-HEX(13:4) "-"
         WS-HEX(17:4) "-" WS-HEX(21:12) ".dat" DELIMITED BY SIZE INTO WS-FILE.
 END PROGRAM ACC-F2US12-SEEN-CREDITS.

 COPY CORETEST.
