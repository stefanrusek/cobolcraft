 PROCEDURE DIVISION.
     MOVE "T" TO TL-MODE
     MOVE "acceptance US12 30-4§5 Hopper: placement (5.1): facing is the opposite of the clicked face, a vertical result replaced by down" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-FACING" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "2" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-FACING" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "3" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-FACING" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "4" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-FACING" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "5" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-FACING" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "6" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-FACING" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "3 4 1 2 6 6" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 30-4§5 Hopper: state defaults (5.1): facing down, enabled true" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-STATE" USING WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "6/1" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 30-4§5 Hopper: checkPoweredState (5.1): shouldEnable = not hasNeighborSignal at the hopper position only; a differing value is written with flags 2 (should enable, write, flags)" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-ENABLE" USING WS-I1 WS-I2 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "0 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-ENABLE" USING WS-I1 WS-I2 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-ENABLE" USING WS-I1 WS-I2 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-ENABLE" USING WS-I1 WS-I2 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1/1/2 1/0/0 0/0/0 0/1/2" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 30-4§5 Hopper: locked by signal (5.1): enabled false stops tryMoveItems and entityInside pickup, but pushes from droppers and other hoppers are still accepted (try move, entity" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-ACTIVE" USING WS-I1 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-ACTIVE" USING WS-I1 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "0/0/1 1/1/1" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 30-4§5 Hopper: spout (5.2 step 2): boxZ(4, 4, 8, 0, 8) turned to the facing about (8, 6, 8) and clipped to the block (x0, y0, z0, x1, y1, z1 in sixteenths); down gives the stub" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-SPOUT" USING WS-I1 WS-R1 WS-R2 WS-R3 WS-R4 WS-R5 WS-R6
     MOVE 6 TO WS-N
     PERFORM ADD-N
     MOVE "2" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-SPOUT" USING WS-I1 WS-R1 WS-R2 WS-R3 WS-R4 WS-R5 WS-R6
     MOVE 6 TO WS-N
     PERFORM ADD-N
     MOVE "3" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-SPOUT" USING WS-I1 WS-R1 WS-R2 WS-R3 WS-R4 WS-R5 WS-R6
     MOVE 6 TO WS-N
     PERFORM ADD-N
     MOVE "4" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-SPOUT" USING WS-I1 WS-R1 WS-R2 WS-R3 WS-R4 WS-R5 WS-R6
     MOVE 6 TO WS-N
     PERFORM ADD-N
     MOVE "6" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-SPOUT" USING WS-I1 WS-R1 WS-R2 WS-R3 WS-R4 WS-R5 WS-R6
     MOVE 6 TO WS-N
     PERFORM ADD-N
     MOVE "6/4/0/10/8/8 8/4/6/16/8/10 6/4/8/10/8/16 0/4/6/8/8/10 6/0/6/10/6/10" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 30-4§5 Hopper: bowl (5.2 step 1): the ring column(16, 10, 16), the neck column(8, 4, 10) and the removed cavity column(12, 11, 16)" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-BOWL" USING WS-I1 WS-R1 WS-R2 WS-R3 WS-R4 WS-R5 WS-R6
     MOVE 6 TO WS-N
     PERFORM ADD-N
     MOVE "2" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-BOWL" USING WS-I1 WS-R1 WS-R2 WS-R3 WS-R4 WS-R5 WS-R6
     MOVE 6 TO WS-N
     PERFORM ADD-N
     MOVE "3" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-BOWL" USING WS-I1 WS-R1 WS-R2 WS-R3 WS-R4 WS-R5 WS-R6
     MOVE 6 TO WS-N
     PERFORM ADD-N
     MOVE "0/10/0/16/16/16 4/4/4/12/10/12 2/11/2/14/16/14" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 30-4§5 Hopper: interaction shape (5.2): the cavity column plus a boxZ(4, 8, 10, 0, 4) stub turned to a horizontal facing; down has the cavity alone (stub present, box)" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-STUB" USING WS-I1 WS-R1 WS-R2 WS-R3 WS-R4 WS-R5 WS-R6 WS-R7
     MOVE 7 TO WS-N
     PERFORM ADD-N
     MOVE "2" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-STUB" USING WS-I1 WS-R1 WS-R2 WS-R3 WS-R4 WS-R5 WS-R6 WS-R7
     MOVE 7 TO WS-N
     PERFORM ADD-N
     MOVE "3" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-STUB" USING WS-I1 WS-R1 WS-R2 WS-R3 WS-R4 WS-R5 WS-R6 WS-R7
     MOVE 7 TO WS-N
     PERFORM ADD-N
     MOVE "4" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-STUB" USING WS-I1 WS-R1 WS-R2 WS-R3 WS-R4 WS-R5 WS-R6 WS-R7
     MOVE 7 TO WS-N
     PERFORM ADD-N
     MOVE "6" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-STUB" USING WS-I1 WS-R1 WS-R2 WS-R3 WS-R4 WS-R5 WS-R6 WS-R7
     MOVE 7 TO WS-N
     PERFORM ADD-N
     MOVE "1/6/8/0/10/10/4 1/12/8/6/16/10/10 1/6/8/12/10/10/16 1/0/8/6/4/10/10 0/0/0/0/0/0/0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 30-4§5 Hopper: cooldown handoff (5.3 item 2): an item into an empty hopper that is not on a custom cooldown gives 8 - 1 = 7 when the source is a hopper that ticked no later in" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1 1 0 1 100 100" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-HANDOFF" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 0 1 101 100" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-HANDOFF" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 0 1 99 100" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-HANDOFF" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 0 0 100 100" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-HANDOFF" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 1 0 1 100 100" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-HANDOFF" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 0 1 100 100" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-HANDOFF" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 1 1 100 100" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-HANDOFF" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-I5 WS-I6 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "7 7 8 8 0 0 0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 30-4§5 Hopper: throughput (5.3 item 1): one item per 8 ticks, so ticks / 8 items and 2.5 items per second (x 10)" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-RATE" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "7" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-RATE" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "8" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-RATE" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "20" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-RATE" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "160" TO WS-IN
     PERFORM LOAD-IN
     CALL "RS2-HOPPER-RATE" USING WS-I1 WS-R1 WS-R2
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "0/25 0/25 1/25 2/25 20/25" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 BEGIN-CASE.
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR
     .

 LOAD-IN.
     MOVE 1 TO WS-P
     PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 16
         MOVE SPACES TO WS-TOK
         IF WS-P <= 160
             UNSTRING WS-IN DELIMITED BY ALL SPACE INTO WS-TOK WITH POINTER WS-P
         END-IF
         COMPUTE WS-FX(WS-K) = FUNCTION NUMVAL(WS-TOK)
         COMPUTE WS-I(WS-K) = FUNCTION NUMVAL(WS-TOK)
     END-PERFORM
     .

 ADD-N.
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N
         MOVE WS-R(WS-J) TO WS-SHOW
         IF WS-J > 1
             STRING "/" DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
         END-IF
         STRING FUNCTION TRIM(WS-SHOW) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-PERFORM
     STRING " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .

 ADD-TEXT.
     STRING FUNCTION TRIM(WS-T1) "|" FUNCTION TRIM(WS-T2) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .
 END PROGRAM TEST-REDSTONE-30-4-5.
