*> Implementation test (002-lane-mobs, T4007): standard mobs round-trip through the entity storage of the world (ENTITY-NBT-WRITE and ENTITY-NBT-READ,
*> 07 section 9.3): every non-player entity of a type other than the ground item is a mob row, so a pig and a zombie of a standard world keep their
*> type, position and health across a save and a load. (The vanfmt lane's 26 3 layout reads and writes through the same programs.)
 IDENTIFICATION DIVISION.
 PROGRAM-ID. TEST-STDMOB-PERSIST.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY TESTLIB.
 COPY CORESTATE.
 COPY COREAPI.
 COPY CONTENT.
 COPY CITEMS.
 COPY PROTO.
 01 WS-CAPACITY            BINARY-LONG VALUE 65536.
 01 WS-NAME                PIC X(16) VALUE "Stefan".
 01 WS-NAME-LENGTH         BINARY-LONG VALUE 6.
 01 WS-CONN                BINARY-LONG.
 01 WS-PLAYER              BINARY-LONG.
 01 WS-DIM                 BINARY-LONG.
 01 WS-CX                  BINARY-LONG.
 01 WS-CZ                  BINARY-LONG.
 01 WS-PIG                 BINARY-LONG.
 01 WS-ZOMBIE              BINARY-LONG.
 01 WS-PIG-TYPE            BINARY-LONG.
 01 WS-ZOMBIE-TYPE         BINARY-LONG.
 01 WS-STATUS              BINARY-LONG.
 01 WS-OUTCOME             BINARY-LONG.
 01 WS-KEY                 PIC X(112).
 01 WS-ENTITY-ROW          PIC X(66).
 01 WS-X                   FLOAT-LONG.
 01 WS-Y                   FLOAT-LONG.
 01 WS-Z                   FLOAT-LONG.
 01 WS-X2                  FLOAT-LONG.
 01 WS-YAW                 FLOAT-SHORT VALUE 90.
 01 WS-I                   BINARY-LONG.
 01 WS-FOUND-PIG           BINARY-LONG.
 01 WS-FOUND-ZOMBIE        BINARY-LONG.
 PROCEDURE DIVISION.
     CALL "TEST-SETTINGS" USING CORE-SETTINGS
     MOVE 2 TO CS-VIEW-DISTANCE
     CALL "TEST-OPEN-WORLD" USING CORE-SETTINGS
     CALL "TEST-STANDARD-TABLES"
     CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
     CALL "TEST-JOIN" USING WS-NAME WS-NAME-LENGTH WS-CONN
     MOVE CN-PLAYER(WS-CONN) TO WS-PLAYER
     MOVE PL-DIM(WS-PLAYER) TO WS-DIM
     MOVE SPACES TO WS-KEY
     MOVE "minecraft:pig" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-PIG-TYPE WS-ENTITY-ROW WS-STATUS
     MOVE "minecraft:zombie" TO WS-KEY
     CALL "CONTENT-ENTITY-BY-KEY" USING WS-KEY WS-ZOMBIE-TYPE WS-ENTITY-ROW WS-STATUS
     COMPUTE WS-X = FUNCTION INTEGER(PL-X(WS-PLAYER)) + 2.5
     MOVE PL-Y(WS-PLAYER) TO WS-Y
     COMPUTE WS-Z = FUNCTION INTEGER(PL-Z(WS-PLAYER)) + 0.5
     COMPUTE WS-X2 = WS-X + 1
     CALL "MOB-SPAWN" USING WS-DIM WS-PIG-TYPE WS-X WS-Y WS-Z WS-YAW WS-PIG
     CALL "MOB-SPAWN" USING WS-DIM WS-ZOMBIE-TYPE WS-X2 WS-Y WS-Z WS-YAW WS-ZOMBIE
     MOVE 7 TO EN-HEALTH(WS-PIG)
     MOVE 15 TO EN-HEALTH(WS-ZOMBIE)
     COMPUTE WS-CX = FUNCTION INTEGER(WS-X / 16)
     COMPUTE WS-CZ = FUNCTION INTEGER(WS-Z / 16)
     CALL "PB-RESET" USING PB-BUFFER
     CALL "ENTITY-NBT-WRITE" USING WS-DIM WS-CX WS-CZ PB-BUFFER
     CALL "ENTITY-REMOVE" USING WS-PIG
     CALL "ENTITY-REMOVE" USING WS-ZOMBIE
     MOVE 0 TO PB-POS
     CALL "ENTITY-NBT-READ" USING WS-DIM PB-BUFFER WS-OUTCOME
     MOVE 0 TO WS-FOUND-PIG WS-FOUND-ZOMBIE
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > EN-COUNT
         IF EN-USED(WS-I) = 1 AND EN-TYPE(WS-I) = WS-PIG-TYPE AND EN-HEALTH(WS-I) = 7
                 AND EN-X(WS-I) = WS-X AND EN-Z(WS-I) = WS-Z
             MOVE 1 TO WS-FOUND-PIG
         END-IF
         IF EN-USED(WS-I) = 1 AND EN-TYPE(WS-I) = WS-ZOMBIE-TYPE AND EN-HEALTH(WS-I) = 15
                 AND EN-X(WS-I) = WS-X2 AND EN-Z(WS-I) = WS-Z
             MOVE 1 TO WS-FOUND-ZOMBIE
         END-IF
     END-PERFORM
     MOVE "N" TO TL-MODE
     MOVE "test stdmob persist: the entity payload reads back (outcome 0)" TO TL-CASE
     MOVE 0 TO TL-EXPECTED-N
     MOVE WS-OUTCOME TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "test stdmob persist: the pig comes back where it was with 7 health" TO TL-CASE
     MOVE 1 TO TL-EXPECTED-N
     MOVE WS-FOUND-PIG TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "test stdmob persist: the zombie comes back where it was with 15 health" TO TL-CASE
     MOVE WS-FOUND-ZOMBIE TO TL-OBSERVED-N
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     CALL "PB-FREE" USING PB-BUFFER
     STOP RUN.
 END PROGRAM TEST-STDMOB-PERSIST.
 COPY CORETEST.
