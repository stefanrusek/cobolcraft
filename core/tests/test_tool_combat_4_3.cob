     CALL "TOOL-SWEEPING-RATIO" USING WS-I1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 6000 TO WS-I1
     MOVE 0 TO WS-I2
     CALL "TOOL-SWEEP-DAMAGE" USING WS-I1 WS-I2 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 6000 TO WS-I1
     MOVE 750 TO WS-I2
     CALL "TOOL-SWEEP-DAMAGE" USING WS-I1 WS-I2 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "0 750 1000 5500" TO TL-EXPECTED
     PERFORM CHECK-DONE

