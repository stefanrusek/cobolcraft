      PERFORM VARYING WS-PY FROM 6 BY 1 UNTIL WS-PY > 34
       PERFORM VARYING WS-PZ FROM -8 BY 1 UNTIL WS-PZ > 24
        CALL "L32-GET-STORED" USING WS-I1 WS-PX WS-PY WS-PZ WS-LV
        IF WS-LV > 0
         ADD 1 TO WS-R1
         COMPUTE WS-PW = WS-PX * 7 + WS-PY * 13 + WS-PZ * 31
         COMPUTE WS-PW = 1 + FUNCTION MOD(WS-PW, 97)
         COMPUTE WS-R2 = WS-R2 + WS-LV * WS-PW
        END-IF
       END-PERFORM
      END-PERFORM
     END-PERFORM
     MOVE 2 TO WS-N
     PERFORM ADD-N
     MOVE "1 8 20 8" TO WS-IN
     PERFORM LOAD-IN
     CALL "L32-GET-STORED" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 12 20 8" TO WS-IN
     PERFORM LOAD-IN
     CALL "L32-GET-STORED" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 6 20 8" TO WS-IN
     PERFORM LOAD-IN
     CALL "L32-GET-STORED" USING WS-I1 WS-I2 WS-I3 WS-I4 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "2626 3303 0/0 4419 3484 3302/633620 10 6 12" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 BEGIN-CASE.
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR
     .

 LOAD-IN.
     MOVE 1 TO WS-P
     PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 16
         MOVE SPACES TO WS-TOK
         IF WS-P <= 160
             UNSTRING WS-IN DELIMITED BY ALL SPACE INTO WS-TOK WITH POINTER WS-P
         END-IF
         COMPUTE WS-FX(WS-K) = FUNCTION NUMVAL(WS-TOK)
         COMPUTE WS-I(WS-K) = FUNCTION NUMVAL(WS-TOK)
     END-PERFORM
     .

 ADD-N.
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N
         MOVE WS-R(WS-J) TO WS-SHOW
         IF WS-J > 1
             STRING "/" DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
         END-IF
         STRING FUNCTION TRIM(WS-SHOW) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-PERFORM
     STRING " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .

 ADD-TEXT.
     STRING FUNCTION TRIM(WS-T1) "|" FUNCTION TRIM(WS-T2) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .
 END PROGRAM TEST-LIGHT-32-4.
