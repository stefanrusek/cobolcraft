 PROCEDURE DIVISION.
     MOVE "acceptance US14 28.7 the ITEM set carries tool and enchantment_level; the ENTITY set this_entity, enchantment_level, origin; LOCATION adds enchantment_active; HIT_BLOCK adds block_state" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-I1
     CALL "TOOL-CTX-COUNT" USING WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 2 TO WS-I1
     CALL "TOOL-CTX-COUNT" USING WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 3 TO WS-I1
     CALL "TOOL-CTX-COUNT" USING WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 4 TO WS-I1
     CALL "TOOL-CTX-COUNT" USING WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 5 TO WS-I1
     CALL "TOOL-CTX-COUNT" USING WS-I1 WS-O1 WS-O2
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     MOVE WS-O2 TO WS-E2
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-E2) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "2/0 3/0 4/0 4/2 4/0" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 28.7 membership: DAMAGE has damage_source and the optional attacking_entity; ENTITY has no damage_source; ITEM has tool; LOCATION has enchantment_active; HIT_BLOCK has block_state (1 required, 2 optional, 0 absent)" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE 4 TO WS-I1
     MOVE SPACES TO WS-T1
     MOVE "damage_source" TO WS-T1
     CALL "TOOL-CTX-HAS" USING WS-I1 WS-T1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 4 TO WS-I1
     MOVE SPACES TO WS-T1
     MOVE "attacking_entity" TO WS-T1
     CALL "TOOL-CTX-HAS" USING WS-I1 WS-T1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 4 TO WS-I1
     MOVE SPACES TO WS-T1
     MOVE "direct_attacking_entity" TO WS-T1
     CALL "TOOL-CTX-HAS" USING WS-I1 WS-T1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 2 TO WS-I1
     MOVE SPACES TO WS-T1
     MOVE "damage_source" TO WS-T1
     CALL "TOOL-CTX-HAS" USING WS-I1 WS-T1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 1 TO WS-I1
     MOVE SPACES TO WS-T1
     MOVE "tool" TO WS-T1
     CALL "TOOL-CTX-HAS" USING WS-I1 WS-T1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 1 TO WS-I1
     MOVE SPACES TO WS-T1
     MOVE "this_entity" TO WS-T1
     CALL "TOOL-CTX-HAS" USING WS-I1 WS-T1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 3 TO WS-I1
     MOVE SPACES TO WS-T1
     MOVE "enchantment_active" TO WS-T1
     CALL "TOOL-CTX-HAS" USING WS-I1 WS-T1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 5 TO WS-I1
     MOVE SPACES TO WS-T1
     MOVE "block_state" TO WS-T1
     CALL "TOOL-CTX-HAS" USING WS-I1 WS-T1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 4 TO WS-I1
     MOVE SPACES TO WS-T1
     MOVE "block_state" TO WS-T1
     CALL "TOOL-CTX-HAS" USING WS-I1 WS-T1 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "1 2 2 0 1 0 1 1 0" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 28.7 post_piercing_attack loads against DAMAGE but runs in an ENTITY context, so damage_source and the attacker parameters can never match there while this_entity can" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE SPACES TO WS-T1
     MOVE "post_piercing_attack" TO WS-T1
     MOVE SPACES TO WS-T2
     MOVE "damage_source" TO WS-T2
     CALL "TOOL-CTX-RUNTIME" USING WS-T1 WS-T2 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "post_piercing_attack" TO WS-T1
     MOVE SPACES TO WS-T2
     MOVE "attacking_entity" TO WS-T2
     CALL "TOOL-CTX-RUNTIME" USING WS-T1 WS-T2 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "post_piercing_attack" TO WS-T1
     MOVE SPACES TO WS-T2
     MOVE "this_entity" TO WS-T2
     CALL "TOOL-CTX-RUNTIME" USING WS-T1 WS-T2 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "post_piercing_attack" TO WS-T1
     MOVE SPACES TO WS-T2
     MOVE "origin" TO WS-T2
     CALL "TOOL-CTX-RUNTIME" USING WS-T1 WS-T2 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "damage" TO WS-T1
     MOVE SPACES TO WS-T2
     MOVE "damage_source" TO WS-T2
     CALL "TOOL-CTX-RUNTIME" USING WS-T1 WS-T2 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "0 0 1 1 1" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 28.7 the enchantment level reaches predicates through enchantment_level only: Thorns chance 0.15 + 0.15 (L - 1)" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE 150 TO WS-I1
     MOVE 150 TO WS-I2
     MOVE 1 TO WS-I3
     CALL "TOOL-REQ-LEVEL-CHANCE" USING WS-I1 WS-I2 WS-I3 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 150 TO WS-I1
     MOVE 150 TO WS-I2
     MOVE 2 TO WS-I3
     CALL "TOOL-REQ-LEVEL-CHANCE" USING WS-I1 WS-I2 WS-I3 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE 150 TO WS-I1
     MOVE 150 TO WS-I2
     MOVE 3 TO WS-I3
     CALL "TOOL-REQ-LEVEL-CHANCE" USING WS-I1 WS-I2 WS-I3 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "150 300 450" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 28.7 one requirement per conditional effect, in list order before the effect; a failing requirement skips only that effect" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE SPACES TO WS-T1
     MOVE "1 0 1" TO WS-T1
     CALL "TOOL-REQ-LIST" USING WS-T1 WS-O1 WS-X1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-X1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "0 0" TO WS-T1
     CALL "TOOL-REQ-LIST" USING WS-T1 WS-O1 WS-X1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-X1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     CALL "TOOL-REQ-LIST" USING WS-T1 WS-O1 WS-X1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) "/" FUNCTION TRIM(WS-X1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "2/101 0/00 0/-" TO TL-EXPECTED
     PERFORM CHECK-DONE

     MOVE "acceptance US14 28.7 slot activity: any matches every slot, armor is feet legs chest head, hand is mainhand and offhand, the others match themselves" TO TL-CASE
     MOVE SPACES TO TL-OBSERVED
     MOVE SPACES TO WS-T1
     MOVE "any" TO WS-T1
     MOVE SPACES TO WS-T2
     MOVE "saddle" TO WS-T2
     CALL "TOOL-SLOT-ACTIVE" USING WS-T1 WS-T2 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "armor" TO WS-T1
     MOVE SPACES TO WS-T2
     MOVE "chest" TO WS-T2
     CALL "TOOL-SLOT-ACTIVE" USING WS-T1 WS-T2 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "armor" TO WS-T1
     MOVE SPACES TO WS-T2
     MOVE "mainhand" TO WS-T2
     CALL "TOOL-SLOT-ACTIVE" USING WS-T1 WS-T2 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "hand" TO WS-T1
     MOVE SPACES TO WS-T2
     MOVE "offhand" TO WS-T2
     CALL "TOOL-SLOT-ACTIVE" USING WS-T1 WS-T2 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "hand" TO WS-T1
     MOVE SPACES TO WS-T2
     MOVE "feet" TO WS-T2
     CALL "TOOL-SLOT-ACTIVE" USING WS-T1 WS-T2 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "feet" TO WS-T1
     MOVE SPACES TO WS-T2
     MOVE "feet" TO WS-T2
     CALL "TOOL-SLOT-ACTIVE" USING WS-T1 WS-T2 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "head" TO WS-T1
     MOVE SPACES TO WS-T2
     MOVE "legs" TO WS-T2
     CALL "TOOL-SLOT-ACTIVE" USING WS-T1 WS-T2 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "body" TO WS-T1
     MOVE SPACES TO WS-T2
     MOVE "body" TO WS-T2
     CALL "TOOL-SLOT-ACTIVE" USING WS-T1 WS-T2 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "saddle" TO WS-T1
     MOVE SPACES TO WS-T2
     MOVE "saddle" TO WS-T2
     CALL "TOOL-SLOT-ACTIVE" USING WS-T1 WS-T2 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE SPACES TO WS-T1
     MOVE "mainhand" TO WS-T1
     MOVE SPACES TO WS-T2
     MOVE "offhand" TO WS-T2
     CALL "TOOL-SLOT-ACTIVE" USING WS-T1 WS-T2 WS-O1
     MOVE SPACES TO WS-OBS
     MOVE WS-O1 TO WS-E1
     STRING FUNCTION TRIM(WS-E1) DELIMITED BY SIZE INTO WS-OBS
     PERFORM ADD-OBS
     MOVE "1 1 0 1 0 1 0 1 1 0" TO TL-EXPECTED
     PERFORM CHECK-DONE

     STOP RUN.

 ADD-OBS.
     IF TL-OBSERVED = SPACES
         MOVE FUNCTION TRIM(WS-OBS) TO TL-OBSERVED
     ELSE
         STRING FUNCTION TRIM(TL-OBSERVED) " " FUNCTION TRIM(WS-OBS) DELIMITED BY SIZE INTO TL-OBSERVED
     END-IF.

 CHECK-DONE.
     MOVE "T" TO TL-MODE
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT.
 END PROGRAM TEST-ENCH-7.
