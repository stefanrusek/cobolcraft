     MOVE -1 TO WS-N
     CALL "REGISTRY-PACKET-BUILD" USING WS-N PB-BUFFER
     MOVE PB-LENGTH TO WS-N PERFORM ADD-NUM
     MOVE 32 TO WS-N
     CALL "REGISTRY-PACKET-BUILD" USING WS-N PB-BUFFER
     MOVE PB-LENGTH TO WS-N PERFORM ADD-NUM
     MOVE "0 0" TO TL-EXPECTED
     PERFORM ASSERT-ROW

