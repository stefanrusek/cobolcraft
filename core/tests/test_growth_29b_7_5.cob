    05 WS-RF7 FLOAT-LONG.
    05 WS-RF8 FLOAT-LONG.
 01 WS-RFST REDEFINES WS-RFSG.
    05 WS-RF FLOAT-LONG OCCURS 8 TIMES.
 01 WS-IN                  PIC X(160).
 01 WS-TOK                 PIC X(24).
 01 WS-P                   BINARY-LONG.
 01 WS-K                   BINARY-LONG.
 01 WS-N                   BINARY-LONG.
 01 WS-J                   BINARY-LONG.
 01 WS-PTR                 BINARY-LONG.
 01 WS-SHOW                PIC -(9)9.
 01 WS-TEXTS.
    05 WS-T1               PIC X(96).
    05 WS-T2               PIC X(96).
 01 WS-DOC                PIC X(64).
 PROCEDURE DIVISION.
     MOVE "T" TO TL-MODE
     MOVE "acceptance US12 29b-7§5 Frogspawn: shape (5): column(16, 0, 1.5), a 1.5 pixel film (box x0 y0 z0 x1, y1 x 10, z1)" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC7-FROG-SHAPE" USING WS-R1 WS-R2 WS-R3 WS-R4 WS-R5 WS-R6
     MOVE 6 TO WS-N
     PERFORM ADD-N
     MOVE "0/0/0/16/15/16" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29b-7§5 Frogspawn: support (5): (supporting fluid or supporting block below) and no fluid above (fluid below, block below, fluid above empty)" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0 0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC7-FROG-SURVIVE" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC7-FROG-SURVIVE" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC7-FROG-SURVIVE" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC7-FROG-SURVIVE" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC7-FROG-SURVIVE" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC7-FROG-SURVIVE" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC7-FROG-SURVIVE" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC7-FROG-SURVIVE" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0 0 0 1 0 1 0 1" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29b-7§5 Frogspawn: hatch delay (5, validation): 3600 + nextInt(8400), 3600 to 11999" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC7-FROG-DELAY" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "8399" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC7-FROG-DELAY" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1234" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC7-FROG-DELAY" USING WS-I1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "3600 11999 4834" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29b-7§5 Frogspawn: triggers (5): PL schedules the hatch, ST gives air when it cannot survive, BT destroys when it cannot survive else hatches, a falling block entity inside" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "1 1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC7-FROG-TRIGGER" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "2 1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC7-FROG-TRIGGER" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "2 0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC7-FROG-TRIGGER" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "3 1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC7-FROG-TRIGGER" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "3 0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC7-FROG-TRIGGER" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "4 1 1" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC7-FROG-TRIGGER" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "4 1 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC7-FROG-TRIGGER" USING WS-I1 WS-I2 WS-I3 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "1 0 2 4 3 3 0" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29b-7§5 Frogspawn: tadpoles (5): nextInt(2, 6) gives 2 to 5, yaw nextInt(1, 361) gives 1 to 360, y = pos.y - 0.5 (x 1000) (count draw, yaw draw; tadpoles, yaw, y offset)" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0 0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC7-FROG-TADPOLES" USING WS-I1 WS-I2 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "3 359" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC7-FROG-TADPOLES" USING WS-I1 WS-I2 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "1 100" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC7-FROG-TADPOLES" USING WS-I1 WS-I2 WS-R1 WS-R2 WS-R3
     MOVE 3 TO WS-N
     PERFORM ADD-N
     MOVE "2/1/-500 5/360/-500 3/101/-500" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     MOVE "acceptance US12 29b-7§5 Frogspawn: spawn offset (5): clamp(nextDouble, 0.2, 0.8) with the float constants widened (x 1e9), worked example 6" TO TL-CASE
     PERFORM BEGIN-CASE
     MOVE "0.0" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC7-FROG-OFFSET" USING WS-FX1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0.1" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC7-FROG-OFFSET" USING WS-FX1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0.5" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC7-FROG-OFFSET" USING WS-FX1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0.75" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC7-FROG-OFFSET" USING WS-FX1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0.9" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC7-FROG-OFFSET" USING WS-FX1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "0.2" TO WS-IN
     PERFORM LOAD-IN
     CALL "GC7-FROG-OFFSET" USING WS-FX1 WS-R1
     MOVE 1 TO WS-N
     PERFORM ADD-N
     MOVE "200000003 200000003 500000000 750000000 799999997 200000003" TO TL-EXPECTED
     CALL "TEST-ASSERT" USING TESTLIB-ASSERT
     STOP RUN.

 BEGIN-CASE.
     MOVE SPACES TO TL-OBSERVED
     MOVE 1 TO WS-PTR
     .

 LOAD-IN.
     MOVE 1 TO WS-P
     PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 16
         MOVE SPACES TO WS-TOK
         IF WS-P <= 160
             UNSTRING WS-IN DELIMITED BY ALL SPACE INTO WS-TOK WITH POINTER WS-P
         END-IF
         COMPUTE WS-FX(WS-K) = FUNCTION NUMVAL(WS-TOK)
         COMPUTE WS-I(WS-K) = FUNCTION NUMVAL(WS-TOK)
     END-PERFORM
     .

 ADD-N.
     PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N
         MOVE WS-R(WS-J) TO WS-SHOW
         IF WS-J > 1
             STRING "/" DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
         END-IF
         STRING FUNCTION TRIM(WS-SHOW) DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     END-PERFORM
     STRING " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .

 ADD-TEXT.
     STRING FUNCTION TRIM(WS-T1) "|" FUNCTION TRIM(WS-T2) " " DELIMITED BY SIZE INTO TL-OBSERVED WITH POINTER WS-PTR
     .
 END PROGRAM TEST-GROWTH-29B-7-5.
