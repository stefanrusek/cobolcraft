     MOVE 70 TO WS-Y
     MOVE 5 TO WS-Z
     CALL "BE-CREATE" USING WS-D WS-X WS-Y WS-Z WS-NV WS-KEY WS-SVL WS-IDX
     MOVE 1.0 TO BE-XF(WS-IDX, 5)
     MOVE 1 TO BE-XF(WS-IDX, 9)
     MOVE 0 TO WS-A
     COMPUTE WS-FA = 0.0
     COMPUTE WS-FB = 0.0
     CALL "BE4-ENCH-TICK" USING WS-IDX WS-A WS-FA WS-FB WS-DRAWS WS-B
     MOVE 0 TO WS-A
