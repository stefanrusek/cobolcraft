     MOVE 0 TO WS-A
     COMPUTE WS-FA = 0.0
     COMPUTE WS-FB = 0.0
     CALL "BE4-ENCH-TICK" USING WS-IDX WS-A WS-FA WS-FB WS-DRAWS WS-B
     MOVE 0 TO WS-A
