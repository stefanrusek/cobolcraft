*> The dye, firework and banner components of a stack (lane itemcomp, T9614; docs/protocol/54 sections 17, 21 and 22, 43 section 7.4 and 8). Wire forms as the documents give them.
*>
*>   SC-DYE-GET USING handle, rgb out, has out          dyed_color (47): an Int, 4 bytes big-endian (the stored value as is)
*>   SC-DYE-SET USING handle (in, out), rgb
*>   SC-DYE-MIX USING handle (in, out), dye count, dye ids (16 BINARY-LONG)   DyedItemColor.applyDyes (43 section 7.4): the stack's colour counts as one more, the result has alpha 0
*>   SC-EXPLOSION-GET USING handle, EXREC record out, found out; SC-EXPLOSION-SET USING handle (in, out), EXREC record    firework_explosion (70): VarInt shape, colour and fade lists of Ints, two Booleans
*>   SC-BANNER-ADD USING handle (in, out), pattern registry position, dye id         banner_patterns (74): the layer (Holder = position + 1, VarInt dye) after the others
*>   SC-BANNER-COUNT USING handle, count out; SC-BANNER-NTH USING handle, n (1 based), pattern position out (-1 inline or past the end), dye out

 IDENTIFICATION DIVISION.
 PROGRAM-ID. SC-DYE-GET.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-TYPE                BINARY-LONG VALUE 47.
 01 WS-VALUE               PIC X(64).
 01 WS-LENGTH              BINARY-LONG.
 01 WS-FOUND               BINARY-LONG.
 01 WS-V                   BINARY-DOUBLE.
 01 WS-I                   BINARY-LONG.
 LINKAGE SECTION.
 01 L-HANDLE               BINARY-LONG.
 01 L-RGB                  BINARY-LONG.
 01 L-HAS                  BINARY-LONG.
 PROCEDURE DIVISION USING L-HANDLE L-RGB L-HAS.
     MOVE 0 TO L-HAS L-RGB
     CALL "SP-GET-COMPONENT" USING L-HANDLE WS-TYPE WS-VALUE WS-LENGTH WS-FOUND
     IF WS-FOUND = 1 AND WS-LENGTH >= 4
         MOVE 0 TO WS-V
         PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 4
             COMPUTE WS-V = WS-V * 256 + FUNCTION ORD(WS-VALUE(WS-I:1)) - 1
         END-PERFORM
         IF WS-V >= 2147483648
             COMPUTE WS-V = WS-V - 4294967296
         END-IF
         MOVE WS-V TO L-RGB
         MOVE 1 TO L-HAS
     END-IF
     GOBACK.
 END PROGRAM SC-DYE-GET.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. SC-DYE-SET.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-TYPE                BINARY-LONG VALUE 47.
 01 WS-VALUE               PIC X(64).
 01 WS-LENGTH              BINARY-LONG VALUE 4.
 01 WS-V                   BINARY-DOUBLE.
 01 WS-I                   BINARY-LONG.
 01 WS-BYTE                BINARY-LONG.
 LINKAGE SECTION.
 01 L-HANDLE               BINARY-LONG.
 01 L-RGB                  BINARY-LONG.
 PROCEDURE DIVISION USING L-HANDLE L-RGB.
     MOVE SPACES TO WS-VALUE
     MOVE L-RGB TO WS-V
     IF WS-V < 0
         ADD 4294967296 TO WS-V
     END-IF
     PERFORM VARYING WS-I FROM 4 BY -1 UNTIL WS-I < 1
         COMPUTE WS-BYTE = FUNCTION MOD(WS-V, 256)
         MOVE FUNCTION CHAR(WS-BYTE + 1) TO WS-VALUE(WS-I:1)
         COMPUTE WS-V = FUNCTION INTEGER(WS-V / 256)
     END-PERFORM
     CALL "SP-SET-COMPONENT" USING L-HANDLE WS-TYPE WS-VALUE WS-LENGTH
     GOBACK.
 END PROGRAM SC-DYE-SET.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. SC-DYE-MIX.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY DYES.
 01 WS-DT REDEFINES DYE-DATA.
    05 WS-D OCCURS 16 TIMES.
       10 WS-DIFFUSE       BINARY-LONG.
       10 WS-FIREWORK      BINARY-LONG.
 01 WS-RGB                 BINARY-LONG.
 01 WS-HAS                 BINARY-LONG.
 01 WS-SR                  BINARY-LONG.
 01 WS-SG                  BINARY-LONG.
 01 WS-SB                  BINARY-LONG.
 01 WS-MAXSUM              BINARY-LONG.
 01 WS-N                   BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-R                   BINARY-LONG.
 01 WS-G                   BINARY-LONG.
 01 WS-B                   BINARY-LONG.
 01 WS-AR                  BINARY-LONG.
 01 WS-AG                  BINARY-LONG.
 01 WS-AB                  BINARY-LONG.
 01 WS-AVGMAX              FLOAT-LONG.
 01 WS-TOP                 FLOAT-LONG.
 01 WS-OR                  BINARY-LONG.
 01 WS-OG                  BINARY-LONG.
 01 WS-OB                  BINARY-LONG.
 01 WS-OUT                 BINARY-LONG.
 LINKAGE SECTION.
 01 L-HANDLE               BINARY-LONG.
 01 L-COUNT                BINARY-LONG.
 01 L-DYES.
    05 L-DYE               BINARY-LONG OCCURS 16 TIMES.
 PROCEDURE DIVISION USING L-HANDLE L-COUNT L-DYES.
     MOVE 0 TO WS-SR WS-SG WS-SB WS-MAXSUM WS-N
     CALL "SC-DYE-GET" USING L-HANDLE WS-RGB WS-HAS
     IF WS-HAS = 1
         PERFORM ADD-COLOUR
     END-IF
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > L-COUNT
         MOVE WS-DIFFUSE(L-DYE(WS-I) + 1) TO WS-RGB
         PERFORM ADD-COLOUR
     END-PERFORM
     IF WS-N = 0
         GOBACK
     END-IF
     COMPUTE WS-AR = FUNCTION INTEGER(WS-SR / WS-N)
     COMPUTE WS-AG = FUNCTION INTEGER(WS-SG / WS-N)
     COMPUTE WS-AB = FUNCTION INTEGER(WS-SB / WS-N)
     COMPUTE WS-AVGMAX = WS-MAXSUM / WS-N
     COMPUTE WS-TOP = FUNCTION MAX(WS-AR, WS-AG, WS-AB)
     MOVE 0 TO WS-OR WS-OG WS-OB
     IF WS-TOP > 0
         COMPUTE WS-OR = FUNCTION INTEGER(WS-AR * WS-AVGMAX / WS-TOP)
         COMPUTE WS-OG = FUNCTION INTEGER(WS-AG * WS-AVGMAX / WS-TOP)
         COMPUTE WS-OB = FUNCTION INTEGER(WS-AB * WS-AVGMAX / WS-TOP)
     END-IF
     COMPUTE WS-OUT = WS-OR * 65536 + WS-OG * 256 + WS-OB
     CALL "SC-DYE-SET" USING L-HANDLE WS-OUT
     GO TO MAIN-EXIT.

 ADD-COLOUR.
     COMPUTE WS-R = FUNCTION MOD(FUNCTION INTEGER(WS-RGB / 65536), 256)
     COMPUTE WS-G = FUNCTION MOD(FUNCTION INTEGER(WS-RGB / 256), 256)
     COMPUTE WS-B = FUNCTION MOD(WS-RGB, 256)
     IF WS-RGB < 0
         COMPUTE WS-R = FUNCTION MOD(FUNCTION INTEGER((WS-RGB + 4294967296) / 65536), 256)
         COMPUTE WS-G = FUNCTION MOD(FUNCTION INTEGER((WS-RGB + 4294967296) / 256), 256)
         COMPUTE WS-B = FUNCTION MOD(WS-RGB + 4294967296, 256)
     END-IF
     ADD WS-R TO WS-SR
     ADD WS-G TO WS-SG
     ADD WS-B TO WS-SB
     ADD FUNCTION MAX(WS-R, WS-G, WS-B) TO WS-MAXSUM
     ADD 1 TO WS-N.
 MAIN-EXIT.
     CONTINUE.
 END PROGRAM SC-DYE-MIX.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. SC-EXPLOSION-GET.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-TYPE                BINARY-LONG VALUE 70.
 01 WS-VALUE               PIC X(2048).
 01 WS-LENGTH              BINARY-LONG.
 01 WS-POS                 BINARY-LONG.
 01 WS-N                   BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-LIST                BINARY-LONG.
 01 WS-V                   BINARY-DOUBLE.
 LINKAGE SECTION.
 01 L-HANDLE               BINARY-LONG.
 COPY EXPREC REPLACING LEADING ==EX-== BY ==L-EX-==.
 01 L-FOUND                BINARY-LONG.
 PROCEDURE DIVISION USING L-HANDLE L-EX-REC L-FOUND.
     INITIALIZE L-EX-REC
     CALL "SP-GET-COMPONENT-X" USING L-HANDLE WS-TYPE WS-VALUE WS-LENGTH L-FOUND
     IF L-FOUND = 0
         GOBACK
     END-IF
     MOVE 1 TO WS-POS
     CALL "SC-VGET" USING WS-VALUE WS-POS L-EX-SHAPE
     PERFORM VARYING WS-LIST FROM 1 BY 1 UNTIL WS-LIST > 2
         CALL "SC-VGET" USING WS-VALUE WS-POS WS-N
         PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-N
             MOVE 0 TO WS-V
             PERFORM 4 TIMES
                 COMPUTE WS-V = WS-V * 256 + FUNCTION ORD(WS-VALUE(WS-POS:1)) - 1
                 ADD 1 TO WS-POS
             END-PERFORM
             IF WS-V >= 2147483648
                 COMPUTE WS-V = WS-V - 4294967296
             END-IF
             IF WS-I <= 8
                 IF WS-LIST = 1
                     MOVE WS-I TO L-EX-N
                     MOVE WS-V TO L-EX-COLOR(WS-I)
                 ELSE
                     MOVE WS-I TO L-EX-FN
                     MOVE WS-V TO L-EX-FADE(WS-I)
                 END-IF
             END-IF
         END-PERFORM
     END-PERFORM
     COMPUTE L-EX-TRAIL = FUNCTION ORD(WS-VALUE(WS-POS:1)) - 1
     ADD 1 TO WS-POS
     COMPUTE L-EX-TWINKLE = FUNCTION ORD(WS-VALUE(WS-POS:1)) - 1
     GOBACK.
 END PROGRAM SC-EXPLOSION-GET.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. SC-EXPLOSION-SET.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-TYPE                BINARY-LONG VALUE 70.
 01 WS-VALUE               PIC X(2048).
 01 WS-LENGTH              BINARY-LONG.
 01 WS-POS                 BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-LIST                BINARY-LONG.
 01 WS-N                   BINARY-LONG.
 01 WS-V                   BINARY-DOUBLE.
 01 WS-BYTE                BINARY-LONG.
 01 WS-K                   BINARY-LONG.
 LINKAGE SECTION.
 01 L-HANDLE               BINARY-LONG.
 COPY EXPREC REPLACING LEADING ==EX-== BY ==L-EX-==.
 PROCEDURE DIVISION USING L-HANDLE L-EX-REC.
     MOVE SPACES TO WS-VALUE
     MOVE 1 TO WS-POS
     CALL "SC-VPUT" USING WS-VALUE WS-POS L-EX-SHAPE
     PERFORM VARYING WS-LIST FROM 1 BY 1 UNTIL WS-LIST > 2
         IF WS-LIST = 1
             MOVE L-EX-N TO WS-N
         ELSE
             MOVE L-EX-FN TO WS-N
         END-IF
         CALL "SC-VPUT" USING WS-VALUE WS-POS WS-N
         PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-N
             IF WS-LIST = 1
                 MOVE L-EX-COLOR(WS-I) TO WS-V
             ELSE
                 MOVE L-EX-FADE(WS-I) TO WS-V
             END-IF
             IF WS-V < 0
                 ADD 4294967296 TO WS-V
             END-IF
             PERFORM VARYING WS-K FROM 3 BY -1 UNTIL WS-K < 0
                 COMPUTE WS-BYTE = FUNCTION MOD(FUNCTION INTEGER(WS-V / (256 ** WS-K)), 256)
                 MOVE FUNCTION CHAR(WS-BYTE + 1) TO WS-VALUE(WS-POS:1)
                 ADD 1 TO WS-POS
             END-PERFORM
         END-PERFORM
     END-PERFORM
     COMPUTE WS-BYTE = L-EX-TRAIL + 1
     MOVE FUNCTION CHAR(WS-BYTE) TO WS-VALUE(WS-POS:1)
     ADD 1 TO WS-POS
     COMPUTE WS-BYTE = L-EX-TWINKLE + 1
     MOVE FUNCTION CHAR(WS-BYTE) TO WS-VALUE(WS-POS:1)
     ADD 1 TO WS-POS
     COMPUTE WS-LENGTH = WS-POS - 1
     CALL "SP-SET-COMPONENT-X" USING L-HANDLE WS-TYPE WS-VALUE WS-LENGTH
     GOBACK.
 END PROGRAM SC-EXPLOSION-SET.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. SC-BANNER-COUNT.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-TYPE                BINARY-LONG VALUE 74.
 01 WS-VALUE               PIC X(2048).
 01 WS-LENGTH              BINARY-LONG.
 01 WS-FOUND               BINARY-LONG.
 01 WS-POS                 BINARY-LONG.
 LINKAGE SECTION.
 01 L-HANDLE               BINARY-LONG.
 01 L-COUNT                BINARY-LONG.
 PROCEDURE DIVISION USING L-HANDLE L-COUNT.
     MOVE 0 TO L-COUNT
     CALL "SP-GET-COMPONENT-X" USING L-HANDLE WS-TYPE WS-VALUE WS-LENGTH WS-FOUND
     IF WS-FOUND = 1
         MOVE 1 TO WS-POS
         CALL "SC-VGET" USING WS-VALUE WS-POS L-COUNT
     END-IF
     GOBACK.
 END PROGRAM SC-BANNER-COUNT.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. SC-BANNER-NTH.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-TYPE                BINARY-LONG VALUE 74.
 01 WS-VALUE               PIC X(2048).
 01 WS-LENGTH              BINARY-LONG.
 01 WS-FOUND               BINARY-LONG.
 01 WS-POS                 BINARY-LONG.
 01 WS-COUNT               BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-HOLDER              BINARY-LONG.
 01 WS-DYE                 BINARY-LONG.
 LINKAGE SECTION.
 01 L-HANDLE               BINARY-LONG.
 01 L-N                    BINARY-LONG.
 01 L-PATTERN              BINARY-LONG.
 01 L-DYE                  BINARY-LONG.
 PROCEDURE DIVISION USING L-HANDLE L-N L-PATTERN L-DYE.
     MOVE -1 TO L-PATTERN
     MOVE 0 TO L-DYE
     CALL "SP-GET-COMPONENT-X" USING L-HANDLE WS-TYPE WS-VALUE WS-LENGTH WS-FOUND
     IF WS-FOUND = 0
         GOBACK
     END-IF
     MOVE 1 TO WS-POS
     CALL "SC-VGET" USING WS-VALUE WS-POS WS-COUNT
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-COUNT OR WS-I > L-N
         CALL "SC-VGET" USING WS-VALUE WS-POS WS-HOLDER
         CALL "SC-VGET" USING WS-VALUE WS-POS WS-DYE
         IF WS-I = L-N
             COMPUTE L-PATTERN = WS-HOLDER - 1
             MOVE WS-DYE TO L-DYE
         END-IF
     END-PERFORM
     GOBACK.
 END PROGRAM SC-BANNER-NTH.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. SC-BANNER-ADD.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-TYPE                BINARY-LONG VALUE 74.
 01 WS-VALUE               PIC X(2048).
 01 WS-NEW                 PIC X(2048).
 01 WS-LENGTH              BINARY-LONG.
 01 WS-FOUND               BINARY-LONG.
 01 WS-POS                 BINARY-LONG.
 01 WS-COUNT               BINARY-LONG.
 01 WS-OUT                 BINARY-LONG.
 01 WS-HOLDER              BINARY-LONG.
 LINKAGE SECTION.
 01 L-HANDLE               BINARY-LONG.
 01 L-PATTERN              BINARY-LONG.
 01 L-DYE                  BINARY-LONG.
 PROCEDURE DIVISION USING L-HANDLE L-PATTERN L-DYE.
     MOVE 0 TO WS-COUNT
     CALL "SP-GET-COMPONENT-X" USING L-HANDLE WS-TYPE WS-VALUE WS-LENGTH WS-FOUND
     IF WS-FOUND = 1
         MOVE 1 TO WS-POS
         CALL "SC-VGET" USING WS-VALUE WS-POS WS-COUNT
     END-IF
     IF WS-COUNT >= 100
         GOBACK
     END-IF
     MOVE SPACES TO WS-NEW
     MOVE 1 TO WS-OUT
     ADD 1 TO WS-COUNT
     CALL "SC-VPUT" USING WS-NEW WS-OUT WS-COUNT
     IF WS-FOUND = 1 AND WS-LENGTH >= WS-POS
         COMPUTE WS-LENGTH = WS-LENGTH - WS-POS + 1
         MOVE WS-VALUE(WS-POS:WS-LENGTH) TO WS-NEW(WS-OUT:WS-LENGTH)
         ADD WS-LENGTH TO WS-OUT
     END-IF
     COMPUTE WS-HOLDER = L-PATTERN + 1
     CALL "SC-VPUT" USING WS-NEW WS-OUT WS-HOLDER
     CALL "SC-VPUT" USING WS-NEW WS-OUT L-DYE
     SUBTRACT 1 FROM WS-OUT
     CALL "SP-SET-COMPONENT-X" USING L-HANDLE WS-TYPE WS-NEW WS-OUT
     GOBACK.
 END PROGRAM SC-BANNER-ADD.
