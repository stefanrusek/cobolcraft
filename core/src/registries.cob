     CALL "NBT-WRITE-INT" USING PB-BUFFER WS-NAME WS-NAME-LENGTH RD-HEIGHT(L-ROW)
     MOVE "logical_height" TO WS-NAME
     MOVE 14 TO WS-NAME-LENGTH
     CALL "NBT-WRITE-INT" USING PB-BUFFER WS-NAME WS-NAME-LENGTH RD-LOGICAL-HEIGHT(L-ROW)
     MOVE "infiniburn" TO WS-NAME
     MOVE 10 TO WS-NAME-LENGTH
     CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WS-NAME WS-NAME-LENGTH WS-END-TYPE WS-EMPTY
     CALL "NBT-WRITE-LIST-END" USING PB-BUFFER
