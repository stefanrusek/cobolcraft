 IDENTIFICATION DIVISION.
 PROGRAM-ID. REGISTRY-MV-ENTRY.
*> USING MV row (RM-), PB-BUFFER: the single cobolcraft:placeholder entry of an MV registry (§4.5).
*> With groups, the fields are written inside each group Compound in turn; without, on the entry.
*> A texture field is the placeholder texture String, a sound field the inline Compound {sound_id}.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY REGISTRY.
 01 WS-ONE                 BINARY-LONG VALUE 1.
 01 WS-ROOT                BINARY-LONG VALUE -2.
 01 WS-NAME                PIC X(40).
 01 WS-NAME-LENGTH         BINARY-LONG.
 01 WS-PASSES              BINARY-LONG.
 01 WS-G                   BINARY-LONG.
 01 WS-F                   BINARY-LONG.
 01 WS-END                 BINARY-LONG.
 LINKAGE SECTION.
 COPY PROTO.
 01 L-ROW                  BINARY-LONG.
 PROCEDURE DIVISION USING L-ROW PB-BUFFER.
     CALL "PB-PUT-IDENTIFIER" USING PB-BUFFER RG-PLACEHOLDER-KEY RG-PLACEHOLDER-KEY-LENGTH
     CALL "PB-PUT-BOOL" USING PB-BUFFER WS-ONE
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WS-NAME WS-ROOT
     COMPUTE WS-PASSES = FUNCTION MAX(1, RM-GROUP-COUNT(L-ROW))
     COMPUTE WS-END = RM-FIRST-FIELD(L-ROW) + RM-FIELD-COUNT(L-ROW)
     PERFORM VARYING WS-G FROM 1 BY 1 UNTIL WS-G > WS-PASSES
         IF RM-GROUP-COUNT(L-ROW) > 0
             CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER RM-GROUP-NAME(L-ROW, WS-G)
                 RM-GROUP-LENGTH(L-ROW, WS-G)
         END-IF
         PERFORM VARYING WS-F FROM RM-FIRST-FIELD(L-ROW) BY 1 UNTIL WS-F >= WS-END
             EVALUATE RF-KIND(WS-F)
                 WHEN RMF-TEXTURE
                     CALL "NBT-WRITE-STRING" USING PB-BUFFER RF-NAME(WS-F) RF-NAME-LENGTH(WS-F)
                         RG-PLACEHOLDER-TEXTURE RG-PLACEHOLDER-TEXTURE-LENGTH
                 WHEN RMF-SOUND
                     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER RF-NAME(WS-F)
                         RF-NAME-LENGTH(WS-F)
                     MOVE "sound_id" TO WS-NAME
                     MOVE 8 TO WS-NAME-LENGTH
                     CALL "NBT-WRITE-STRING" USING PB-BUFFER WS-NAME WS-NAME-LENGTH
                         RG-PLACEHOLDER-SOUND RG-PLACEHOLDER-SOUND-LENGTH
                     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
                 WHEN RMF-STRING
                     CALL "NBT-WRITE-STRING" USING PB-BUFFER RF-NAME(WS-F) RF-NAME-LENGTH(WS-F)
                         RF-STRING(WS-F) RF-STRING-LENGTH(WS-F)
                 WHEN OTHER
                     CALL "NBT-WRITE-INT" USING PB-BUFFER RF-NAME(WS-F) RF-NAME-LENGTH(WS-F)
                         RF-INT(WS-F)
             END-EVALUATE
         END-PERFORM
         IF RM-GROUP-COUNT(L-ROW) > 0
             CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
         END-IF
     END-PERFORM
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     GOBACK.
 END PROGRAM REGISTRY-MV-ENTRY.

