 IDENTIFICATION DIVISION.
 PROGRAM-ID. REGISTRY-CHAT-ENTRY.
*> USING row (RC-), PB-BUFFER: chat_type entry (§4.4): per decoration (chat, narration) a Compound
*> {translation_key (String), parameters (List of String)}; style absent.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY REGISTRY.
 01 WS-ONE                 BINARY-LONG VALUE 1.
 01 WS-ROOT                BINARY-LONG VALUE -2.
 01 WS-ELEMENT             BINARY-LONG VALUE -1.
 01 WS-STRING-TYPE         BINARY-LONG VALUE 8.
 01 WS-NAME                PIC X(40).
 01 WS-NAME-LENGTH         BINARY-LONG.
 01 WS-D                   BINARY-LONG.
 01 WS-P                   BINARY-LONG.
 LINKAGE SECTION.
 COPY PROTO.
 01 L-ROW                  BINARY-LONG.
 PROCEDURE DIVISION USING L-ROW PB-BUFFER.
     CALL "PB-PUT-IDENTIFIER" USING PB-BUFFER RC-KEY(L-ROW) RC-KEY-LENGTH(L-ROW)
     CALL "PB-PUT-BOOL" USING PB-BUFFER WS-ONE
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WS-NAME WS-ROOT
     PERFORM VARYING WS-D FROM 1 BY 1 UNTIL WS-D > 2
         CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER RC-DEC-NAME(L-ROW, WS-D)
             RC-DEC-NAME-LENGTH(L-ROW, WS-D)
         MOVE "translation_key" TO WS-NAME
         MOVE 15 TO WS-NAME-LENGTH
         CALL "NBT-WRITE-STRING" USING PB-BUFFER WS-NAME WS-NAME-LENGTH
             RC-DEC-KEY(L-ROW, WS-D) RC-DEC-KEY-LENGTH(L-ROW, WS-D)
         MOVE "parameters" TO WS-NAME
         MOVE 10 TO WS-NAME-LENGTH
         CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WS-NAME WS-NAME-LENGTH WS-STRING-TYPE
             RC-PARAM-COUNT(L-ROW, WS-D)
         PERFORM VARYING WS-P FROM 1 BY 1 UNTIL WS-P > RC-PARAM-COUNT(L-ROW, WS-D)
             CALL "NBT-WRITE-STRING" USING PB-BUFFER WS-NAME WS-ELEMENT
                 RC-PARAM-NAME(L-ROW, WS-D, WS-P) RC-PARAM-LENGTH(L-ROW, WS-D, WS-P)
         END-PERFORM
         CALL "NBT-WRITE-LIST-END" USING PB-BUFFER
         CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     END-PERFORM
