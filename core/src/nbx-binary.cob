*> Conversion between the NBT value tree (core/copy/NBXTREE.cpy) and binary NBT (docs/protocol/07-nbt-and-anvil.md §1): how the data of an entity or block entity that the
*> save code writes reaches /data and back. Entry points:
*>   NBX-TO-BUFFER USING PB-BUFFER, compound node: its entries appended as named tags (the begin and end tags are the caller's, as BE-SAVE leaves them)
*>   NBX-FROM-BUFFER USING PB-BUFFER, node out: the entries of a compound read from PB-POS up to an End tag or the end of the buffer, as a new compound
*> Arrays are cut at 256 elements; a list is written with the element type of its first element (an empty list as type 0).

 IDENTIFICATION DIVISION.
 PROGRAM-ID. NBX-WRITE-TAG RECURSIVE.
*> USING PB-BUFFER, node, named (1: named by NX-KEY, 0: a list element)
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY NBXTREE.
 LOCAL-STORAGE SECTION.
 01 LS-NAME                PIC X(64).
 01 LS-NAME-LENGTH         BINARY-LONG.
 01 LS-CHILD               BINARY-LONG.
 01 LS-COUNT               BINARY-LONG.
 01 LS-ELEMENT             BINARY-LONG.
 01 LS-INT                 BINARY-LONG.
 01 LS-LONG                BINARY-DOUBLE.
 01 LS-FLOAT               FLOAT-SHORT.
 01 LS-NAMED               BINARY-LONG VALUE 1.
 01 LS-UNNAMED             BINARY-LONG VALUE 0.
 01 LS-BYTES               PIC X(256).
 01 LS-INTS.
    05 LS-INT-ITEM          BINARY-LONG OCCURS 256 TIMES.
 01 LS-LONGS.
    05 LS-LONG-ITEM         BINARY-DOUBLE OCCURS 256 TIMES.
 01 LS-TEXT                PIC X(256).
 01 LS-TEXT-LENGTH         BINARY-LONG.
 LINKAGE SECTION.
 COPY PROTO.
 01 L-NODE                 BINARY-LONG.
 01 L-NAMED                BINARY-LONG.
 PROCEDURE DIVISION USING PB-BUFFER L-NODE L-NAMED.
     MOVE SPACES TO LS-NAME
     MOVE -1 TO LS-NAME-LENGTH
     IF L-NAMED = 1
         MOVE NX-KEY(L-NODE) TO LS-NAME
         MOVE NX-KLEN(L-NODE) TO LS-NAME-LENGTH
     END-IF
     EVALUATE NX-TYPE(L-NODE)
         WHEN 1
             MOVE NX-INT(L-NODE) TO LS-INT
             CALL "NBT-WRITE-BYTE" USING PB-BUFFER LS-NAME LS-NAME-LENGTH LS-INT
         WHEN 2
             MOVE NX-INT(L-NODE) TO LS-INT
             CALL "NBT-WRITE-SHORT" USING PB-BUFFER LS-NAME LS-NAME-LENGTH LS-INT
         WHEN 3
             MOVE NX-INT(L-NODE) TO LS-INT
             CALL "NBT-WRITE-INT" USING PB-BUFFER LS-NAME LS-NAME-LENGTH LS-INT
         WHEN 4
             MOVE NX-INT(L-NODE) TO LS-LONG
             CALL "NBT-WRITE-LONG" USING PB-BUFFER LS-NAME LS-NAME-LENGTH LS-LONG
         WHEN 5
             MOVE NX-DBL(L-NODE) TO LS-FLOAT
             CALL "NBT-WRITE-FLOAT" USING PB-BUFFER LS-NAME LS-NAME-LENGTH LS-FLOAT
         WHEN 6
             CALL "NBT-WRITE-DOUBLE" USING PB-BUFFER LS-NAME LS-NAME-LENGTH NX-DBL(L-NODE)
         WHEN 8
             MOVE NX-STR(L-NODE) TO LS-TEXT
             MOVE NX-SLEN(L-NODE) TO LS-TEXT-LENGTH
             CALL "NBT-WRITE-STRING" USING PB-BUFFER LS-NAME LS-NAME-LENGTH LS-TEXT LS-TEXT-LENGTH
         WHEN 7
             MOVE 0 TO LS-COUNT
             MOVE NX-FIRST(L-NODE) TO LS-CHILD
             PERFORM UNTIL LS-CHILD = 0 OR LS-COUNT = 256
                 ADD 1 TO LS-COUNT
                 MOVE FUNCTION CHAR(FUNCTION MOD(NX-INT(LS-CHILD), 256) + 1) TO LS-BYTES(LS-COUNT:1)
                 MOVE NX-NEXT(LS-CHILD) TO LS-CHILD
             END-PERFORM
             CALL "NBT-WRITE-BYTE-ARRAY" USING PB-BUFFER LS-NAME LS-NAME-LENGTH LS-COUNT LS-BYTES
         WHEN 11
             MOVE 0 TO LS-COUNT
             MOVE NX-FIRST(L-NODE) TO LS-CHILD
             PERFORM UNTIL LS-CHILD = 0 OR LS-COUNT = 256
                 ADD 1 TO LS-COUNT
                 MOVE NX-INT(LS-CHILD) TO LS-INT-ITEM(LS-COUNT)
                 MOVE NX-NEXT(LS-CHILD) TO LS-CHILD
             END-PERFORM
             CALL "NBT-WRITE-INT-ARRAY" USING PB-BUFFER LS-NAME LS-NAME-LENGTH LS-COUNT LS-INTS
         WHEN 12
             MOVE 0 TO LS-COUNT
             MOVE NX-FIRST(L-NODE) TO LS-CHILD
             PERFORM UNTIL LS-CHILD = 0 OR LS-COUNT = 256
                 ADD 1 TO LS-COUNT
                 MOVE NX-INT(LS-CHILD) TO LS-LONG-ITEM(LS-COUNT)
                 MOVE NX-NEXT(LS-CHILD) TO LS-CHILD
             END-PERFORM
             CALL "NBT-WRITE-LONG-ARRAY" USING PB-BUFFER LS-NAME LS-NAME-LENGTH LS-COUNT LS-LONGS
         WHEN 9
             MOVE 0 TO LS-ELEMENT
             IF NX-COUNT(L-NODE) > 0
                 MOVE NX-TYPE(NX-FIRST(L-NODE)) TO LS-ELEMENT
             END-IF
             CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER LS-NAME LS-NAME-LENGTH LS-ELEMENT NX-COUNT(L-NODE)
             MOVE NX-FIRST(L-NODE) TO LS-CHILD
             PERFORM UNTIL LS-CHILD = 0
                 CALL "NBX-WRITE-TAG" USING PB-BUFFER LS-CHILD LS-UNNAMED
                 MOVE NX-NEXT(LS-CHILD) TO LS-CHILD
             END-PERFORM
             CALL "NBT-WRITE-LIST-END" USING PB-BUFFER
         WHEN OTHER
             CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER LS-NAME LS-NAME-LENGTH
             MOVE NX-FIRST(L-NODE) TO LS-CHILD
             PERFORM UNTIL LS-CHILD = 0
                 CALL "NBX-WRITE-TAG" USING PB-BUFFER LS-CHILD LS-NAMED
                 MOVE NX-NEXT(LS-CHILD) TO LS-CHILD
             END-PERFORM
             CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     END-EVALUATE
     GOBACK.
 END PROGRAM NBX-WRITE-TAG.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. NBX-TO-BUFFER.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY NBXTREE.
 01 WS-CHILD               BINARY-LONG.
 01 WS-NAMED               BINARY-LONG VALUE 1.
 LINKAGE SECTION.
 COPY PROTO.
 01 L-NODE                 BINARY-LONG.
 PROCEDURE DIVISION USING PB-BUFFER L-NODE.
     MOVE NX-FIRST(L-NODE) TO WS-CHILD
     PERFORM UNTIL WS-CHILD = 0
         CALL "NBX-WRITE-TAG" USING PB-BUFFER WS-CHILD WS-NAMED
         MOVE NX-NEXT(WS-CHILD) TO WS-CHILD
     END-PERFORM
     GOBACK.
 END PROGRAM NBX-TO-BUFFER.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. NBX-READ-TAG RECURSIVE.
*> USING PB-BUFFER, tag type, node out: the payload of a tag of that type at PB-POS as a node
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY NBXTREE.
 01 WS-CAP-NAME            BINARY-LONG VALUE 64.
 01 WS-CAP-TEXT            BINARY-LONG VALUE 256.
 01 WS-CAP-ARRAY           BINARY-LONG VALUE 256.
 LOCAL-STORAGE SECTION.
 01 LS-TYPE                BINARY-LONG.
 01 LS-ELEMENT             BINARY-LONG.
 01 LS-COUNT               BINARY-LONG.
 01 LS-I                   BINARY-LONG.
 01 LS-CHILD               BINARY-LONG.
 01 LS-NAME                PIC X(64).
 01 LS-NAME-LENGTH         BINARY-LONG.
 01 LS-INT                 BINARY-LONG.
 01 LS-LONG                BINARY-DOUBLE.
 01 LS-FLOAT               FLOAT-SHORT.
 01 LS-DOUBLE              FLOAT-LONG.
 01 LS-BYTES               PIC X(256).
 01 LS-INTS.
    05 LS-INT-ITEM          BINARY-LONG OCCURS 256 TIMES.
 01 LS-LONGS.
    05 LS-LONG-ITEM         BINARY-DOUBLE OCCURS 256 TIMES.
 01 LS-ELEMENT-TYPE        BINARY-LONG.
 01 LS-VALUE               BINARY-DOUBLE.
 LINKAGE SECTION.
 COPY PROTO.
 01 L-TYPE                 BINARY-LONG.
 01 L-NODE                 BINARY-LONG.
 PROCEDURE DIVISION USING PB-BUFFER L-TYPE L-NODE.
     CALL "NBX-NEW" USING L-TYPE L-NODE
     EVALUATE L-TYPE
         WHEN 1
             CALL "PB-GET-BYTE" USING PB-BUFFER LS-INT
             MOVE LS-INT TO NX-INT(L-NODE)
         WHEN 2
             CALL "PB-GET-SHORT" USING PB-BUFFER LS-INT
             MOVE LS-INT TO NX-INT(L-NODE)
         WHEN 3
             CALL "PB-GET-INT" USING PB-BUFFER LS-INT
             MOVE LS-INT TO NX-INT(L-NODE)
         WHEN 4
             CALL "PB-GET-LONG" USING PB-BUFFER LS-LONG
             MOVE LS-LONG TO NX-INT(L-NODE)
         WHEN 5
             CALL "PB-GET-FLOAT" USING PB-BUFFER LS-FLOAT
             MOVE LS-FLOAT TO NX-DBL(L-NODE)
         WHEN 6
             CALL "PB-GET-DOUBLE" USING PB-BUFFER LS-DOUBLE
             MOVE LS-DOUBLE TO NX-DBL(L-NODE)
         WHEN 8
             MOVE SPACES TO NX-STR(L-NODE)
             CALL "NBT-READ-STRING" USING PB-BUFFER NX-STR(L-NODE) WS-CAP-TEXT LS-COUNT
             MOVE LS-COUNT TO NX-SLEN(L-NODE)
         WHEN 7
             CALL "NBT-READ-BYTE-ARRAY" USING PB-BUFFER WS-CAP-ARRAY LS-COUNT LS-BYTES
             MOVE 1 TO LS-ELEMENT-TYPE
             PERFORM VARYING LS-I FROM 1 BY 1 UNTIL LS-I > LS-COUNT
                 COMPUTE LS-VALUE = FUNCTION ORD(LS-BYTES(LS-I:1)) - 1
                 IF LS-VALUE > 127
                     SUBTRACT 256 FROM LS-VALUE
                 END-IF
                 CALL "NBX-NEW" USING LS-ELEMENT-TYPE LS-CHILD
                 MOVE LS-VALUE TO NX-INT(LS-CHILD)
                 CALL "NBX-ADD" USING L-NODE LS-CHILD
             END-PERFORM
         WHEN 11
             CALL "NBT-READ-INT-ARRAY" USING PB-BUFFER WS-CAP-ARRAY LS-COUNT LS-INTS
             MOVE 3 TO LS-ELEMENT-TYPE
             PERFORM VARYING LS-I FROM 1 BY 1 UNTIL LS-I > LS-COUNT
                 CALL "NBX-NEW" USING LS-ELEMENT-TYPE LS-CHILD
                 MOVE LS-INT-ITEM(LS-I) TO NX-INT(LS-CHILD)
                 CALL "NBX-ADD" USING L-NODE LS-CHILD
             END-PERFORM
         WHEN 12
             CALL "NBT-READ-LONG-ARRAY" USING PB-BUFFER WS-CAP-ARRAY LS-COUNT LS-LONGS
             MOVE 4 TO LS-ELEMENT-TYPE
             PERFORM VARYING LS-I FROM 1 BY 1 UNTIL LS-I > LS-COUNT
                 CALL "NBX-NEW" USING LS-ELEMENT-TYPE LS-CHILD
                 MOVE LS-LONG-ITEM(LS-I) TO NX-INT(LS-CHILD)
                 CALL "NBX-ADD" USING L-NODE LS-CHILD
             END-PERFORM
         WHEN 9
             CALL "NBT-READ-LIST-BEGIN" USING PB-BUFFER LS-ELEMENT LS-COUNT
             PERFORM VARYING LS-I FROM 1 BY 1 UNTIL LS-I > LS-COUNT OR PB-ERROR = 1
                 CALL "NBX-READ-TAG" USING PB-BUFFER LS-ELEMENT LS-CHILD
                 CALL "NBX-ADD" USING L-NODE LS-CHILD
             END-PERFORM
         WHEN OTHER
             PERFORM UNTIL PB-ERROR = 1
                 MOVE SPACES TO LS-NAME
                 CALL "NBT-READ-COMPOUND-NEXT" USING PB-BUFFER LS-TYPE LS-NAME WS-CAP-NAME LS-NAME-LENGTH
                 IF LS-TYPE = 0
                     EXIT PERFORM
                 END-IF
                 CALL "NBX-READ-TAG" USING PB-BUFFER LS-TYPE LS-CHILD
                 CALL "NBX-SET" USING L-NODE LS-NAME LS-NAME-LENGTH LS-CHILD
             END-PERFORM
     END-EVALUATE
     GOBACK.
 END PROGRAM NBX-READ-TAG.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. NBX-FROM-BUFFER.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY NBXTREE.
 01 WS-CAP-NAME            BINARY-LONG VALUE 64.
 01 WS-T-COMPOUND          BINARY-LONG VALUE 10.
 01 WS-TYPE                BINARY-LONG.
 01 WS-NAME                PIC X(64).
 01 WS-NAME-LENGTH         BINARY-LONG.
 01 WS-CHILD               BINARY-LONG.
 LINKAGE SECTION.
 COPY PROTO.
 01 L-NODE                 BINARY-LONG.
 PROCEDURE DIVISION USING PB-BUFFER L-NODE.
     CALL "NBX-NEW" USING WS-T-COMPOUND L-NODE
     PERFORM UNTIL PB-ERROR = 1 OR PB-POS >= PB-LENGTH
         MOVE SPACES TO WS-NAME
         CALL "NBT-READ-COMPOUND-NEXT" USING PB-BUFFER WS-TYPE WS-NAME WS-CAP-NAME WS-NAME-LENGTH
         IF WS-TYPE = 0
             EXIT PERFORM
         END-IF
         CALL "NBX-READ-TAG" USING PB-BUFFER WS-TYPE WS-CHILD
         CALL "NBX-SET" USING L-NODE WS-NAME WS-NAME-LENGTH WS-CHILD
     END-PERFORM
     GOBACK.
 END PROGRAM NBX-FROM-BUFFER.
