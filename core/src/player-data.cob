*> players/<offline-uuid>.dat (07 section 9.4): PLAYER-DAT-WRITE and PLAYER-DAT-READ. Split from persistence.cob (T0331).

 IDENTIFICATION DIVISION.
 PROGRAM-ID. PLAYER-DAT-WRITE.
*> USING known-player row (BINARY-LONG; CORESTATE CORE-KNOWN with its stored state): writes
*> <world>/players/<offline-uuid>.dat (07 §9.2): DataVersion, Name, Dimension, Pos, Rotation,
*> GameMode, Health, Food, foodSaturationLevel, Inventory (one {Slot, id, count[, components]} per non-empty slot, in
*> slot order), equipment (feet, legs, chest, head, offhand), recipeBook and HeldSlot (core/src/player-nbt.cob).
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CORESTATE.
 COPY DIMENSIONS.
 COPY CITEMS.
 COPY KNSTATE.
 COPY PROTO.
 01 WS-READY               PIC 9 VALUE 0.
 01 WS-CAPACITY            BINARY-LONG VALUE 524288.
 01 WN                     PIC X(32).
 01 WL                     BINARY-LONG.
 01 WS-ELEMENT             BINARY-LONG VALUE -1.
 01 WS-SATURATION          FLOAT-SHORT.
 01 WS-NEEDED              BINARY-LONG.
 01 WS-PROGRESS            FLOAT-SHORT.
 01 WS-DATA-VERSION        BINARY-LONG VALUE 5023.
 01 WS-T-FLOAT             BINARY-LONG VALUE 5.
 01 WS-T-DOUBLE            BINARY-LONG VALUE 6.
 01 WS-T-COMPOUND          BINARY-LONG VALUE 10.
 01 WS-TWO                 BINARY-LONG VALUE 2.
 01 WS-THREE               BINARY-LONG VALUE 3.
 01 WS-INT                 BINARY-LONG.
 01 WS-COUNT               BINARY-LONG.
 01 WS-S                   BINARY-LONG.
 01 WS-INVENTORY.
    05 WS-SLOT OCCURS 36 TIMES.
       10 WS-SLOT-ITEM     BINARY-LONG.
       10 WS-SLOT-COUNT    BINARY-LONG.
 01 WS-UUID-TEXT           PIC X(36).
 01 WS-SUFFIX              PIC X(128).
 01 WS-PATH                PIC X(1100).
 01 WS-PATH-LENGTH         BINARY-LONG.
 LINKAGE SECTION.
 01 L-KNOWN                BINARY-LONG.
 PROCEDURE DIVISION USING L-KNOWN.
     IF WS-READY = 0
         CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
         MOVE 1 TO WS-READY
     END-IF
     MOVE KN-INVENTORY(L-KNOWN) TO WS-INVENTORY
     CALL "PB-RESET" USING PB-BUFFER
     MOVE SPACES TO WN
     MOVE 0 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     MOVE "DataVersion" TO WN MOVE 11 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL WS-DATA-VERSION
     MOVE "Name" TO WN MOVE 4 TO WL
     CALL "NBT-WRITE-STRING" USING PB-BUFFER WN WL KN-NAME(L-KNOWN) KN-NAME-LENGTH(L-KNOWN)
*>   A player the file of which had no known Dimension (KN-DIM 0) keeps no place.
     IF KN-DIM(L-KNOWN) > 0
         MOVE "Dimension" TO WN MOVE 9 TO WL
         CALL "NBT-WRITE-STRING" USING PB-BUFFER WN WL DM-KEY(KN-DIM(L-KNOWN))
             DM-KEY-LENGTH(KN-DIM(L-KNOWN))
         MOVE "Pos" TO WN MOVE 3 TO WL
         CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WN WL WS-T-DOUBLE WS-THREE
         CALL "NBT-WRITE-DOUBLE" USING PB-BUFFER WN WS-ELEMENT KN-X(L-KNOWN)
         CALL "NBT-WRITE-DOUBLE" USING PB-BUFFER WN WS-ELEMENT KN-Y(L-KNOWN)
         CALL "NBT-WRITE-DOUBLE" USING PB-BUFFER WN WS-ELEMENT KN-Z(L-KNOWN)
         MOVE "Rotation" TO WN MOVE 8 TO WL
         CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WN WL WS-T-FLOAT WS-TWO
         CALL "NBT-WRITE-FLOAT" USING PB-BUFFER WN WS-ELEMENT KN-YAW(L-KNOWN)
         CALL "NBT-WRITE-FLOAT" USING PB-BUFFER WN WS-ELEMENT KN-PITCH(L-KNOWN)
     END-IF
     MOVE "GameMode" TO WN MOVE 8 TO WL
     MOVE KN-MODE(L-KNOWN) TO WS-INT
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL WS-INT
     MOVE "Health" TO WN MOVE 6 TO WL
     CALL "NBT-WRITE-FLOAT" USING PB-BUFFER WN WL KN-HEALTH(L-KNOWN)
     MOVE "Food" TO WN MOVE 4 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL KN-FOOD(L-KNOWN)
     MOVE "foodSaturationLevel" TO WN MOVE 19 TO WL
     MOVE KX-SATURATION(L-KNOWN) TO WS-SATURATION
     CALL "NBT-WRITE-FLOAT" USING PB-BUFFER WN WL WS-SATURATION
     MOVE "seenCredits" TO WN MOVE 11 TO WL
     MOVE KX-SEEN-CREDITS(L-KNOWN) TO WS-INT
     CALL "NBT-WRITE-BYTE" USING PB-BUFFER WN WL WS-INT
     MOVE 0 TO WS-COUNT
     PERFORM VARYING WS-S FROM 1 BY 1 UNTIL WS-S > 36
         IF WS-SLOT-COUNT(WS-S) > 0
             ADD 1 TO WS-COUNT
         END-IF
     END-PERFORM
     MOVE "XpLevel" TO WN MOVE 7 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL KX-XP-LEVEL(L-KNOWN)
     MOVE "XpTotal" TO WN MOVE 7 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL KX-XP-TOTAL(L-KNOWN)
     CALL "XP-NEEDED" USING KX-XP-LEVEL(L-KNOWN) WS-NEEDED
     COMPUTE WS-PROGRESS = KX-XP-POINTS(L-KNOWN) / WS-NEEDED
     MOVE "XpP" TO WN MOVE 3 TO WL
     CALL "NBT-WRITE-FLOAT" USING PB-BUFFER WN WL WS-PROGRESS
     MOVE "Inventory" TO WN MOVE 9 TO WL
     CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WN WL WS-T-COMPOUND WS-COUNT
     PERFORM VARYING WS-S FROM 1 BY 1 UNTIL WS-S > 36
         IF WS-SLOT-COUNT(WS-S) > 0
             CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WS-ELEMENT
             MOVE "Slot" TO WN MOVE 4 TO WL
             COMPUTE WS-INT = WS-S - 1
             CALL "NBT-WRITE-BYTE" USING PB-BUFFER WN WL WS-INT
             CALL "PNBT-STACK-WRITE" USING PB-BUFFER WS-SLOT-ITEM(WS-S) WS-SLOT-COUNT(WS-S)
                 KX-SLOT-KP(L-KNOWN, WS-S)
             CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
         END-IF
     END-PERFORM
     CALL "NBT-WRITE-LIST-END" USING PB-BUFFER
     CALL "PNBT-ENDER-WRITE" USING PB-BUFFER KN-UUID(L-KNOWN)
     MOVE "equipment" TO WN MOVE 9 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     CALL "PNBT-EQUIP-WRITE" USING PB-BUFFER L-KNOWN
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE "recipeBook" TO WN MOVE 10 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     CALL "PNBT-BOOK-WRITE" USING PB-BUFFER L-KNOWN
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE "HeldSlot" TO WN MOVE 8 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL KN-HELD(L-KNOWN)
*>   A world of the 26.3 layout also gets the keys of the standard player file (45-3 sections 2 and 3: SelectedItemSlot, playerGameType, the food keys, the
*>   counters at their defaults, abilities from the game mode, post_effects), so the game reads the file too; PLAYER-DAT-READ takes either set.
     IF CW-LAYOUT = 1
         CALL "PLAYER-STD-WRITE" USING L-KNOWN PB-BUFFER
     END-IF
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     CALL "PERSIST-UUID-TEXT" USING KN-UUID(L-KNOWN) WS-UUID-TEXT
     MOVE SPACES TO WS-SUFFIX
     IF CW-LAYOUT = 1
         STRING "/players/data/" WS-UUID-TEXT ".dat" DELIMITED BY SIZE INTO WS-SUFFIX
     ELSE
         STRING "/players/" WS-UUID-TEXT ".dat" DELIMITED BY SIZE INTO WS-SUFFIX
     END-IF
     CALL "PERSIST-PATH" USING WS-SUFFIX WS-PATH WS-PATH-LENGTH
     CALL "PERSIST-WRITE-FILE" USING WS-PATH WS-PATH-LENGTH PB-BUFFER
     GOBACK.
 END PROGRAM PLAYER-DAT-WRITE.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. PLAYER-DAT-READ.
*> USING offline UUID (PIC X(16)), known-player row out (BINARY-LONG; 0 when the world has no file
*> for that UUID, or the known-player table is full): reads players/<offline-uuid>.dat into a new
*> known-player row: its stored state (KN-STORED 1, not dirty) and the place it left from
*> (KN-PLACED 1; a Dimension the game does not know leaves KN-DIM 0, so the player starts at the
*> world spawn). Stored with health 0, the player left while dead (standin §10.6); the file keeps no
*> death cause, so the death screen shows the cause-less message of CAUSE-COMMAND (health set to 0).
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CORESTATE.
 COPY DIMENSIONS.
 COPY CITEMS.
 COPY RULES.
 COPY KNSTATE.
 COPY PROTO.
 01 WS-READY               PIC 9 VALUE 0.
 01 WS-CAPACITY            BINARY-LONG VALUE 4096.
 01 WN                     PIC X(32).
 01 WL                     BINARY-LONG.
 01 WS-NAME-CAPACITY       BINARY-LONG VALUE 32.
 01 WS-NAME-SIZE           BINARY-LONG VALUE 16.
 01 WS-TYPE                BINARY-LONG.
 01 WS-ELEMENT-TYPE        BINARY-LONG.
 01 WS-COUNT               BINARY-LONG.
 01 WS-INT                 BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-SLOT-NUMBER         BINARY-LONG.
 01 WS-ITEM                BINARY-LONG.
 01 WS-ITEM-COUNT          BINARY-LONG.
 01 WS-KP                  BINARY-LONG.
 01 WS-SATURATION          FLOAT-SHORT.
 01 WS-XPP                 FLOAT-SHORT VALUE 0.
 01 WS-NEEDED              BINARY-LONG.
 01 WS-KEY                 PIC X(32).
 01 WS-KEY-LENGTH          BINARY-LONG.
 01 WS-INVENTORY.
    05 WS-SLOT OCCURS 36 TIMES.
       10 WS-SLOT-ITEM     BINARY-LONG.
       10 WS-SLOT-COUNT    BINARY-LONG.
 01 WS-UUID-TEXT           PIC X(36).
 01 WS-SUFFIX              PIC X(128).
 01 WS-PATH                PIC X(1100).
 01 WS-PATH-LENGTH         BINARY-LONG.
 01 WS-FILE-INFO           PIC X(16).
 LINKAGE SECTION.
 01 L-UUID                 PIC X(16).
 01 L-KNOWN                BINARY-LONG.
 PROCEDURE DIVISION USING L-UUID L-KNOWN.
     MOVE 0 TO L-KNOWN
     CALL "PERSIST-UUID-TEXT" USING L-UUID WS-UUID-TEXT
     MOVE SPACES TO WS-SUFFIX
     IF CW-LAYOUT = 1
         STRING "/players/data/" WS-UUID-TEXT ".dat" DELIMITED BY SIZE INTO WS-SUFFIX
         CALL "PERSIST-PATH" USING WS-SUFFIX WS-PATH WS-PATH-LENGTH
         CALL "CBL_CHECK_FILE_EXIST" USING WS-PATH WS-FILE-INFO
         IF RETURN-CODE NOT = 0
             MOVE SPACES TO WS-SUFFIX
             STRING "/players/" WS-UUID-TEXT ".dat" DELIMITED BY SIZE INTO WS-SUFFIX
         END-IF
     ELSE
         STRING "/players/" WS-UUID-TEXT ".dat" DELIMITED BY SIZE INTO WS-SUFFIX
     END-IF
     CALL "PERSIST-PATH" USING WS-SUFFIX WS-PATH WS-PATH-LENGTH
     CALL "CBL_CHECK_FILE_EXIST" USING WS-PATH WS-FILE-INFO
     IF RETURN-CODE NOT = 0 OR KN-COUNT >= CORE-MAX-KNOWN
         MOVE 0 TO RETURN-CODE
         GOBACK
     END-IF
     IF WS-READY = 0
         CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
         MOVE 1 TO WS-READY
     END-IF
     ADD 1 TO KN-COUNT
     MOVE KN-COUNT TO L-KNOWN
     INITIALIZE KN-PLACE(L-KNOWN) KN-STATE(L-KNOWN)
     CALL "KX-ROW-FREE" USING L-KNOWN
     MOVE RULE-START-SATURATION TO KX-SATURATION(L-KNOWN)
     MOVE 0 TO KX-XP-LEVEL(L-KNOWN) KX-XP-POINTS(L-KNOWN) KX-XP-TOTAL(L-KNOWN) WS-XPP
     MOVE L-UUID TO KN-UUID(L-KNOWN)
     MOVE 0 TO KN-DEATH-CAUSE(L-KNOWN) KN-KILLER-LENGTH(L-KNOWN)
     MOVE SPACES TO KN-KILLER-NAME(L-KNOWN)
     INITIALIZE WS-INVENTORY
     CALL "PERSIST-READ-FILE" USING WS-PATH WS-PATH-LENGTH PB-BUFFER
     PERFORM UNTIL PB-ERROR = 1
         MOVE SPACES TO WN
         CALL "NBT-READ-COMPOUND-NEXT" USING PB-BUFFER WS-TYPE WN WS-NAME-CAPACITY WL
         IF WS-TYPE = 0
             EXIT PERFORM
         END-IF
         EVALUATE TRUE
             WHEN WN = "Name" AND WS-TYPE = 8
                 CALL "NBT-READ-STRING" USING PB-BUFFER KN-NAME(L-KNOWN) WS-NAME-SIZE
                     KN-NAME-LENGTH(L-KNOWN)
             WHEN WN = "Dimension" AND WS-TYPE = 8
                 MOVE SPACES TO WS-KEY
                 CALL "NBT-READ-STRING" USING PB-BUFFER WS-KEY WS-NAME-CAPACITY WS-KEY-LENGTH
                 PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > DIM-TABLE-ROWS
                     IF DM-KEY(WS-I) = WS-KEY
                         MOVE WS-I TO KN-DIM(L-KNOWN)
                     END-IF
                 END-PERFORM
             WHEN WN = "Pos" AND WS-TYPE = 9
                 CALL "NBT-READ-LIST-BEGIN" USING PB-BUFFER WS-ELEMENT-TYPE WS-COUNT
                 CALL "PB-GET-DOUBLE" USING PB-BUFFER KN-X(L-KNOWN)
                 CALL "PB-GET-DOUBLE" USING PB-BUFFER KN-Y(L-KNOWN)
                 CALL "PB-GET-DOUBLE" USING PB-BUFFER KN-Z(L-KNOWN)
             WHEN WN = "Rotation" AND WS-TYPE = 9
                 CALL "NBT-READ-LIST-BEGIN" USING PB-BUFFER WS-ELEMENT-TYPE WS-COUNT
                 CALL "PB-GET-FLOAT" USING PB-BUFFER KN-YAW(L-KNOWN)
                 CALL "PB-GET-FLOAT" USING PB-BUFFER KN-PITCH(L-KNOWN)
             WHEN WN = "GameMode" AND WS-TYPE = 3
                 CALL "PB-GET-INT" USING PB-BUFFER WS-INT
                 MOVE WS-INT TO KN-MODE(L-KNOWN)
             WHEN WN = "Health" AND WS-TYPE = 5
                 CALL "PB-GET-FLOAT" USING PB-BUFFER KN-HEALTH(L-KNOWN)
             WHEN WN = "Food" AND WS-TYPE = 3
                 CALL "PB-GET-INT" USING PB-BUFFER KN-FOOD(L-KNOWN)
             WHEN WN = "XpLevel" AND WS-TYPE = 3
                 CALL "PB-GET-INT" USING PB-BUFFER KX-XP-LEVEL(L-KNOWN)
             WHEN WN = "XpTotal" AND WS-TYPE = 3
                 CALL "PB-GET-INT" USING PB-BUFFER KX-XP-TOTAL(L-KNOWN)
             WHEN WN = "XpP" AND WS-TYPE = 5
                 CALL "PB-GET-FLOAT" USING PB-BUFFER WS-XPP
             WHEN WN = "HeldSlot" AND WS-TYPE = 3
                 CALL "PB-GET-INT" USING PB-BUFFER KN-HELD(L-KNOWN)
             WHEN WN = "SelectedItemSlot" AND WS-TYPE = 3
                 CALL "PB-GET-INT" USING PB-BUFFER KN-HELD(L-KNOWN)
             WHEN WN = "playerGameType" AND WS-TYPE = 3
                 CALL "PB-GET-INT" USING PB-BUFFER WS-INT
                 MOVE WS-INT TO KN-MODE(L-KNOWN)
             WHEN WN = "foodLevel" AND WS-TYPE = 3
                 CALL "PB-GET-INT" USING PB-BUFFER KN-FOOD(L-KNOWN)
             WHEN WN = "foodSaturationLevel" AND WS-TYPE = 5
                 CALL "PB-GET-FLOAT" USING PB-BUFFER WS-SATURATION
                 MOVE WS-SATURATION TO KX-SATURATION(L-KNOWN)
             WHEN WN = "seenCredits" AND WS-TYPE = 1
                 CALL "PB-GET-BYTE" USING PB-BUFFER WS-INT
                 MOVE WS-INT TO KX-SEEN-CREDITS(L-KNOWN)
             WHEN WN = "equipment" AND WS-TYPE = 10
                 CALL "PNBT-EQUIP-READ" USING PB-BUFFER L-KNOWN
             WHEN WN = "recipeBook" AND WS-TYPE = 10
                 CALL "PNBT-BOOK-READ" USING PB-BUFFER L-KNOWN
             WHEN WN = "EnderItems" AND WS-TYPE = 9
                 CALL "PNBT-ENDER-READ" USING PB-BUFFER L-UUID
             WHEN WN = "Inventory" AND WS-TYPE = 9
                 CALL "NBT-READ-LIST-BEGIN" USING PB-BUFFER WS-ELEMENT-TYPE WS-COUNT
                 PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-COUNT OR PB-ERROR = 1
                     CALL "PNBT-STACK-READ" USING PB-BUFFER WS-SLOT-NUMBER WS-ITEM WS-ITEM-COUNT WS-KP
                     IF WS-SLOT-NUMBER >= 0 AND WS-SLOT-NUMBER <= 35 AND WS-ITEM > 0 AND WS-ITEM-COUNT > 0
                         MOVE WS-ITEM TO WS-SLOT-ITEM(WS-SLOT-NUMBER + 1)
                         MOVE WS-ITEM-COUNT TO WS-SLOT-COUNT(WS-SLOT-NUMBER + 1)
                         CALL "KX-PATCH-FREE" USING KX-SLOT-KP(L-KNOWN, WS-SLOT-NUMBER + 1)
                         MOVE WS-KP TO KX-SLOT-KP(L-KNOWN, WS-SLOT-NUMBER + 1)
                     ELSE
                         CALL "KX-PATCH-FREE" USING WS-KP
                     END-IF
                 END-PERFORM
             WHEN OTHER
                 CALL "NBT-READ-SKIP" USING PB-BUFFER WS-TYPE
         END-EVALUATE
     END-PERFORM
     CALL "XP-NEEDED" USING KX-XP-LEVEL(L-KNOWN) WS-NEEDED
     COMPUTE KX-XP-POINTS(L-KNOWN) ROUNDED = WS-XPP * WS-NEEDED
     MOVE WS-INVENTORY TO KN-INVENTORY(L-KNOWN)
     MOVE 1 TO KN-STORED(L-KNOWN) KN-PLACED(L-KNOWN) KX-SET(L-KNOWN)
     MOVE 0 TO KN-DIRTY(L-KNOWN)
     IF KN-HEALTH(L-KNOWN) <= 0
         MOVE CAUSE-COMMAND TO KN-DEATH-CAUSE(L-KNOWN)
     END-IF
     GOBACK.
 END PROGRAM PLAYER-DAT-READ.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. PLAYER-STD-WRITE.
*> USING known row, PB-BUFFER (a player compound being written): the keys of the standard player file that the core holds the state of or that have a fixed default (45-3 sections 2 and 3):
*> SelectedItemSlot, playerGameType, foodLevel, foodTickTimer 0, foodExhaustionLevel 0.0, SleepTimer 0, XpSeed 0, Score 0, abilities (the seven values the game mode gives: 45-3
*> section 2.2), spawn_extra_particles_on_fall 0 and an empty post_effects. Not written (no state): LastDeathLocation, respawn, warden_spawn_tracker, entered_nether_pos,
*> last_explosion_impact_pos, raid_omen_position, ender_pearls, the shoulder entities, previousPlayerGameType.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CORESTATE.
 01 WN                     PIC X(32).
 01 WL                     BINARY-LONG.
 01 WS-ZERO                BINARY-LONG VALUE 0.
 01 WS-T-STRING            BINARY-LONG VALUE 8.
 01 WS-FLOAT               FLOAT-SHORT VALUE 0.
 01 WS-FLY-SPEED           FLOAT-SHORT VALUE 0.05.
 01 WS-WALK-SPEED          FLOAT-SHORT VALUE 0.1.
 01 WS-FLAG                BINARY-LONG.
 01 WS-MODE                BINARY-LONG.
 LINKAGE SECTION.
 01 L-KNOWN                BINARY-LONG.
 COPY PROTO.
 PROCEDURE DIVISION USING L-KNOWN PB-BUFFER.
     MOVE KN-MODE(L-KNOWN) TO WS-MODE
     MOVE "SelectedItemSlot" TO WN MOVE 16 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL KN-HELD(L-KNOWN)
     MOVE "playerGameType" TO WN MOVE 14 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL WS-MODE
     MOVE "foodLevel" TO WN MOVE 9 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL KN-FOOD(L-KNOWN)
     MOVE "foodTickTimer" TO WN MOVE 13 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL WS-ZERO
     MOVE "foodExhaustionLevel" TO WN MOVE 19 TO WL
     CALL "NBT-WRITE-FLOAT" USING PB-BUFFER WN WL WS-FLOAT
     MOVE "SleepTimer" TO WN MOVE 10 TO WL
     CALL "NBT-WRITE-SHORT" USING PB-BUFFER WN WL WS-ZERO
     MOVE "XpSeed" TO WN MOVE 6 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL WS-ZERO
     MOVE "Score" TO WN MOVE 5 TO WL
     CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL WS-ZERO
     MOVE "abilities" TO WN MOVE 9 TO WL
     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
     MOVE "invulnerable" TO WN MOVE 12 TO WL
     MOVE 0 TO WS-FLAG
     IF WS-MODE = 1 OR 3
         MOVE 1 TO WS-FLAG
     END-IF
     CALL "NBT-WRITE-BYTE" USING PB-BUFFER WN WL WS-FLAG
     MOVE "flying" TO WN MOVE 6 TO WL
     MOVE 0 TO WS-FLAG
     IF WS-MODE = 3
         MOVE 1 TO WS-FLAG
     END-IF
     CALL "NBT-WRITE-BYTE" USING PB-BUFFER WN WL WS-FLAG
     MOVE "mayfly" TO WN MOVE 6 TO WL
     MOVE 0 TO WS-FLAG
     IF WS-MODE = 1 OR 3
         MOVE 1 TO WS-FLAG
     END-IF
     CALL "NBT-WRITE-BYTE" USING PB-BUFFER WN WL WS-FLAG
     MOVE "instabuild" TO WN MOVE 10 TO WL
     MOVE 0 TO WS-FLAG
     IF WS-MODE = 1
         MOVE 1 TO WS-FLAG
     END-IF
     CALL "NBT-WRITE-BYTE" USING PB-BUFFER WN WL WS-FLAG
     MOVE "mayBuild" TO WN MOVE 8 TO WL
     MOVE 1 TO WS-FLAG
     IF WS-MODE = 2 OR 3
         MOVE 0 TO WS-FLAG
     END-IF
     CALL "NBT-WRITE-BYTE" USING PB-BUFFER WN WL WS-FLAG
     MOVE "flySpeed" TO WN MOVE 8 TO WL
     CALL "NBT-WRITE-FLOAT" USING PB-BUFFER WN WL WS-FLY-SPEED
     MOVE "walkSpeed" TO WN MOVE 9 TO WL
     CALL "NBT-WRITE-FLOAT" USING PB-BUFFER WN WL WS-WALK-SPEED
     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
     MOVE "spawn_extra_particles_on_fall" TO WN MOVE 29 TO WL
     CALL "NBT-WRITE-BYTE" USING PB-BUFFER WN WL WS-ZERO
     MOVE "post_effects" TO WN MOVE 12 TO WL
     CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WN WL WS-T-STRING WS-ZERO
     GOBACK.
 END PROGRAM PLAYER-STD-WRITE.
