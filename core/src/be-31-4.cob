 IDENTIFICATION DIVISION.
 PROGRAM-ID. BE4-ENCH-NORMALISE.
*> USING angle (FLOAT-SHORT in and out): into [-PI, PI) with the float constants 3.1415927 and 6.2831855 (6.3 step 5).
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-PI                  FLOAT-SHORT VALUE 3.1415927.
 01 WS-TWO-PI              FLOAT-SHORT VALUE 6.2831855.
 01 WS-V                   FLOAT-SHORT.
 LINKAGE SECTION.
 01 L-ANGLE                FLOAT-SHORT.
 PROCEDURE DIVISION USING L-ANGLE.
     MOVE L-ANGLE TO WS-V
     PERFORM UNTIL WS-V < WS-PI
         COMPUTE WS-V = WS-V - WS-TWO-PI
     END-PERFORM
     PERFORM UNTIL WS-V >= 0 - WS-PI
         COMPUTE WS-V = WS-V + WS-TWO-PI
     END-PERFORM
     MOVE WS-V TO L-ANGLE
     GOBACK.
 END PROGRAM BE4-ENCH-NORMALISE.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. BE4-ENCH-TICK.
*> USING index, a player within 3.0 (1/0), dx, dz to the player (FLOAT-LONG), the random draws in order (16 BINARY-LONG), draws used out: 6.3.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY BESTATE.
 01 WS-C01                 FLOAT-SHORT VALUE 0.1.
 01 WS-C002                FLOAT-SHORT VALUE 0.02.
 01 WS-C04                 FLOAT-SHORT VALUE 0.4.
 01 WS-C09                 FLOAT-SHORT VALUE 0.9.
 01 WS-C05                 FLOAT-SHORT VALUE 0.5.
 01 WS-CLAMP               FLOAT-SHORT VALUE 0.2.
 01 WS-NCLAMP              FLOAT-SHORT VALUE -0.2.
 01 WS-OLD                 FLOAT-SHORT.
 01 WS-DELTA               FLOAT-SHORT.
 01 WS-F                   FLOAT-SHORT.
 01 WS-A                   BINARY-LONG.
 01 WS-B                   BINARY-LONG.
 01 WS-DONE                BINARY-LONG.
 01 WS-PAIRS               BINARY-LONG.
 01 WS-ANGLE               FLOAT-LONG.
 LINKAGE SECTION.
 01 L-INDEX                BINARY-LONG.
 01 L-PRESENT              BINARY-LONG.
 01 L-DX                   FLOAT-LONG.
 01 L-DZ                   FLOAT-LONG.
 01 L-DRAWS.
    05 L-DRAW              BINARY-LONG OCCURS 16 TIMES.
 01 L-USED                 BINARY-LONG.
 PROCEDURE DIVISION USING L-INDEX L-PRESENT L-DX L-DZ L-DRAWS L-USED.
     MOVE 0 TO L-USED
     MOVE BE-XF(L-INDEX, 5) TO BE-XF(L-INDEX, 6)
     MOVE BE-XF(L-INDEX, 7) TO BE-XF(L-INDEX, 8)
     IF L-PRESENT = 1
         CALL STATIC "cc_f64_atan2_mth" USING BY REFERENCE L-DZ L-DX WS-ANGLE
         MOVE WS-ANGLE TO BE-XF(L-INDEX, 9)
         COMPUTE BE-XF(L-INDEX, 5) = BE-XF(L-INDEX, 5) + WS-C01
         MOVE 1 TO WS-PAIRS
         IF BE-XF(L-INDEX, 5) >= WS-C05
             ADD 1 TO L-USED
             IF L-DRAW(L-USED) NOT = 0
                 MOVE 0 TO WS-PAIRS
             END-IF
         END-IF
         MOVE 0 TO WS-DONE
         PERFORM UNTIL WS-PAIRS = 0 OR WS-DONE = 1
             MOVE BE-XF(L-INDEX, 3) TO WS-OLD
             MOVE L-DRAW(L-USED + 1) TO WS-A
             MOVE L-DRAW(L-USED + 2) TO WS-B
             ADD 2 TO L-USED
             COMPUTE BE-XF(L-INDEX, 3) = BE-XF(L-INDEX, 3) + (WS-A - WS-B)
             IF BE-XF(L-INDEX, 3) NOT = WS-OLD
                 MOVE 1 TO WS-DONE
             END-IF
         END-PERFORM
     ELSE
         COMPUTE BE-XF(L-INDEX, 9) = BE-XF(L-INDEX, 9) + WS-C002
         COMPUTE BE-XF(L-INDEX, 5) = BE-XF(L-INDEX, 5) - WS-C01
     END-IF
     CALL "BE4-ENCH-NORMALISE" USING BE-XF(L-INDEX, 7)
     CALL "BE4-ENCH-NORMALISE" USING BE-XF(L-INDEX, 9)
     COMPUTE WS-DELTA = BE-XF(L-INDEX, 9) - BE-XF(L-INDEX, 7)
     CALL "BE4-ENCH-NORMALISE" USING WS-DELTA
     COMPUTE WS-F = WS-DELTA * WS-C04
     COMPUTE BE-XF(L-INDEX, 7) = BE-XF(L-INDEX, 7) + WS-F
     IF BE-XF(L-INDEX, 5) < 0
         MOVE 0 TO BE-XF(L-INDEX, 5)
     END-IF
     IF BE-XF(L-INDEX, 5) > 1
         MOVE 1 TO BE-XF(L-INDEX, 5)
     END-IF
     ADD 1 TO BE-XI(L-INDEX, 1)
     MOVE BE-XF(L-INDEX, 1) TO BE-XF(L-INDEX, 2)
     COMPUTE WS-F = BE-XF(L-INDEX, 3) - BE-XF(L-INDEX, 1)
     COMPUTE WS-F = WS-F * WS-C04
     IF WS-F > WS-CLAMP
         MOVE WS-CLAMP TO WS-F
     END-IF
     IF WS-F < WS-NCLAMP
         MOVE WS-NCLAMP TO WS-F
     END-IF
     COMPUTE WS-F = WS-F - BE-XF(L-INDEX, 4)
     COMPUTE WS-F = WS-F * WS-C09
     COMPUTE BE-XF(L-INDEX, 4) = BE-XF(L-INDEX, 4) + WS-F
     COMPUTE BE-XF(L-INDEX, 1) = BE-XF(L-INDEX, 1) + BE-XF(L-INDEX, 4)
     GOBACK.
 END PROGRAM BE4-ENCH-TICK.

