 01 WS-SLOT                BINARY-LONG.
 01 WS-ITEM                BINARY-LONG.
 01 WS-ICOUNT              BINARY-LONG.
 01 WS-KP                  BINARY-LONG.
 01 WS-HANDLE              BINARY-LONG.
 01 WS-LONG                BINARY-DOUBLE.
 01 WS-INTS.
    05 WS-INT              BINARY-LONG OCCURS 64 TIMES.
 01 WS-I                   BINARY-LONG.
 01 WS-N                   BINARY-LONG.
 01 WS-BASE                BINARY-LONG.
 01 WS-SEEN                BINARY-LONG.
 LINKAGE SECTION.
 COPY PROTO.
 01 L-INDEX                BINARY-LONG.
 01 L-NAME                 PIC X(32).
 01 L-TAG                  BINARY-LONG.
 01 L-HANDLED              BINARY-LONG.
 PROCEDURE DIVISION USING L-INDEX L-NAME L-TAG PB-BUFFER L-HANDLED.
     GO TO MAIN-LINE.


 READ-STACK.
     CALL "PNBT-STACK-READ" USING PB-BUFFER WS-SLOT WS-ITEM WS-ICOUNT WS-KP
     CALL "KX-PATCH-TAKE" USING WS-KP WS-HANDLE
     CALL "KX-PATCH-FREE" USING WS-KP
     IF WS-ITEM > 0 AND WS-ICOUNT > 0
         MOVE WS-ITEM TO BE-SLOT-ITEM(L-INDEX, 1)
         MOVE WS-ICOUNT TO BE-SLOT-COUNT(L-INDEX, 1)
         MOVE WS-HANDLE TO BE-SLOT-VAR(L-INDEX, 1)
     END-IF
     .

 READ-BEE.
     ADD 1 TO WS-N
     COMPUTE WS-BASE = 6 + 4 * (FUNCTION MIN(WS-N, 8) - 1)
     IF WS-N <= 8
         MOVE 0 TO BE-XI(L-INDEX, WS-BASE) BE-XI(L-INDEX, WS-BASE + 1) BE-XI(L-INDEX, WS-BASE + 2) BE-XI(L-INDEX, WS-BASE + 3)
         MOVE SPACES TO BE-XT(L-INDEX, WS-N)
     END-IF
     PERFORM UNTIL PB-ERROR = 1
         MOVE SPACES TO WN
         CALL "NBT-READ-COMPOUND-NEXT" USING PB-BUFFER WS-TYPE WN WS-CAP32 WL
         IF WS-TYPE = 0
             EXIT PERFORM
         END-IF
         EVALUATE TRUE
             WHEN WN = "entity_data" AND WS-TYPE = 10
                 PERFORM READ-ENTITY
             WHEN WN = "ticks_in_hive" AND WS-TYPE = 3 AND WS-N <= 8
                 CALL "PB-GET-INT" USING PB-BUFFER BE-XI(L-INDEX, WS-BASE)
             WHEN WN = "min_ticks_in_hive" AND WS-TYPE = 3 AND WS-N <= 8
                 CALL "PB-GET-INT" USING PB-BUFFER BE-XI(L-INDEX, WS-BASE + 1)
             WHEN OTHER
                 CALL "NBT-READ-SKIP" USING PB-BUFFER WS-TYPE
         END-EVALUATE
     END-PERFORM
     .

 READ-ENTITY.
     PERFORM UNTIL PB-ERROR = 1
         MOVE SPACES TO WN2
         CALL "NBT-READ-COMPOUND-NEXT" USING PB-BUFFER WS-TYPE2 WN2 WS-CAP32 WL2
         IF WS-TYPE2 = 0
             EXIT PERFORM
         END-IF
         EVALUATE TRUE
             WHEN WN2 = "id" AND WS-TYPE2 = 8 AND WS-N <= 8
                 CALL "NBT-READ-STRING" USING PB-BUFFER BE-XT(L-INDEX, WS-N) WS-CAP64 BE-XI(L-INDEX, WS-BASE + 3)
             WHEN WN2 = "HasNectar" AND WS-TYPE2 = 1 AND WS-N <= 8
                 CALL "PB-GET-BYTE" USING PB-BUFFER BE-XI(L-INDEX, WS-BASE + 2)
             WHEN OTHER
                 CALL "NBT-READ-SKIP" USING PB-BUFFER WS-TYPE2
         END-EVALUATE
     END-PERFORM
     .

 MAIN-LINE.
     MOVE 0 TO L-HANDLED
     EVALUATE TRUE
         WHEN BE-TYPE(L-INDEX) = 4 AND L-NAME = "RecordItem" AND L-TAG = 10
             MOVE 1 TO L-HANDLED
             PERFORM READ-STACK
         WHEN BE-TYPE(L-INDEX) = 4 AND L-NAME = "ticks_since_song_started" AND L-TAG = 4
             MOVE 1 TO L-HANDLED
             CALL "PB-GET-LONG" USING PB-BUFFER WS-LONG
             MOVE WS-LONG TO BE-XI(L-INDEX, 6)
             MOVE 1 TO BE-XI(L-INDEX, 7)
         WHEN BE-TYPE(L-INDEX) = 29 AND L-NAME = "Book" AND L-TAG = 10
             MOVE 1 TO L-HANDLED
             PERFORM READ-STACK
         WHEN BE-TYPE(L-INDEX) = 29 AND L-NAME = "Page" AND L-TAG = 3
             MOVE 1 TO L-HANDLED
             CALL "PB-GET-INT" USING PB-BUFFER BE-XI(L-INDEX, 1)
         WHEN BE-TYPE(L-INDEX) = 32 AND L-NAME = "Items" AND L-TAG = 9
             MOVE 1 TO L-HANDLED
             CALL "NBT-READ-LIST-BEGIN" USING PB-BUFFER WS-ET WS-COUNT
             PERFORM VARYING WS-E FROM 1 BY 1 UNTIL WS-E > WS-COUNT OR PB-ERROR = 1
                 CALL "PNBT-STACK-READ" USING PB-BUFFER WS-SLOT WS-ITEM WS-ICOUNT WS-KP
                 CALL "KX-PATCH-TAKE" USING WS-KP WS-HANDLE
                 CALL "KX-PATCH-FREE" USING WS-KP
                 IF WS-SLOT >= 0 AND WS-SLOT < 4 AND WS-ITEM > 0 AND WS-ICOUNT > 0
                     COMPUTE WS-I = WS-SLOT + 1
                     MOVE WS-ITEM TO BE-SLOT-ITEM(L-INDEX, WS-I)
                     MOVE WS-ICOUNT TO BE-SLOT-COUNT(L-INDEX, WS-I)
                     MOVE WS-HANDLE TO BE-SLOT-VAR(L-INDEX, WS-I)
                 END-IF
             END-PERFORM
         WHEN BE-TYPE(L-INDEX) = 32 AND (L-NAME = "CookingTimes" OR L-NAME = "CookingTotalTimes") AND L-TAG = 11
             MOVE 1 TO L-HANDLED
             CALL "NBT-READ-INT-ARRAY" USING PB-BUFFER WS-CAP-INTS WS-COUNT WS-INTS
             MOVE 0 TO WS-BASE
             IF L-NAME = "CookingTotalTimes"
                 MOVE 4 TO WS-BASE
             END-IF
             PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > FUNCTION MIN(WS-COUNT, 4)
                 MOVE WS-INT(WS-I) TO BE-XI(L-INDEX, WS-BASE + WS-I)
             END-PERFORM
         WHEN BE-TYPE(L-INDEX) = 13 AND L-NAME = "CustomName" AND L-TAG = 8
             MOVE 1 TO L-HANDLED
             CALL "NBT-READ-STRING" USING PB-BUFFER BE-NAME(L-INDEX) WS-CAP64 BE-NAME-LENGTH(L-INDEX)
         WHEN BE-TYPE(L-INDEX) = 40 AND L-NAME = "LootTable" AND L-TAG = 8
             MOVE 1 TO L-HANDLED
             CALL "NBT-READ-STRING" USING PB-BUFFER BE-LOOT(L-INDEX) WS-CAP64 BE-LOOT-LENGTH(L-INDEX)
             MOVE 0 TO BE-SLOT-ITEM(L-INDEX, 1) BE-SLOT-COUNT(L-INDEX, 1) BE-SLOT-VAR(L-INDEX, 1)
         WHEN BE-TYPE(L-INDEX) = 40 AND L-NAME = "LootTableSeed" AND L-TAG = 4
             MOVE 1 TO L-HANDLED
             CALL "PB-GET-LONG" USING PB-BUFFER BE-SEED(L-INDEX)
         WHEN BE-TYPE(L-INDEX) = 40 AND L-NAME = "item" AND L-TAG = 10
             MOVE 1 TO L-HANDLED
             PERFORM READ-STACK
             IF BE-LOOT-LENGTH(L-INDEX) > 0
                 MOVE 0 TO BE-SLOT-ITEM(L-INDEX, 1) BE-SLOT-COUNT(L-INDEX, 1) BE-SLOT-VAR(L-INDEX, 1)
             END-IF
         WHEN BE-TYPE(L-INDEX) = 40 AND L-NAME = "hit_direction" AND L-TAG = 3
             MOVE 1 TO L-HANDLED
             CALL "PB-GET-INT" USING PB-BUFFER BE-XI(L-INDEX, 4)
         WHEN BE-TYPE(L-INDEX) = 33 AND L-NAME = "bees" AND L-TAG = 9
             MOVE 1 TO L-HANDLED
             CALL "NBT-READ-LIST-BEGIN" USING PB-BUFFER WS-ET WS-COUNT
             MOVE 0 TO WS-N
             PERFORM VARYING WS-E FROM 1 BY 1 UNTIL WS-E > WS-COUNT OR PB-ERROR = 1
                 PERFORM READ-BEE
             END-PERFORM
             MOVE FUNCTION MIN(WS-N, 8) TO BE-XI(L-INDEX, 5)
         WHEN BE-TYPE(L-INDEX) = 33 AND L-NAME = "flower_pos" AND L-TAG = 11
             MOVE 1 TO L-HANDLED
             CALL "NBT-READ-INT-ARRAY" USING PB-BUFFER WS-CAP-INTS WS-COUNT WS-INTS
             IF WS-COUNT = 3
                 MOVE 1 TO BE-XI(L-INDEX, 1)
                 MOVE WS-INT(1) TO BE-XI(L-INDEX, 2)
                 MOVE WS-INT(2) TO BE-XI(L-INDEX, 3)
                 MOVE WS-INT(3) TO BE-XI(L-INDEX, 4)
             END-IF
     END-EVALUATE
     .
 END PROGRAM BE4-LOAD-KEY.
