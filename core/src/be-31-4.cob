 IDENTIFICATION DIVISION.
 PROGRAM-ID. BE4-LECTERN-BUTTON.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY BESTATE.
 01 WS-N                   BINARY-LONG.
 01 WS-DELAY               BINARY-LONG.
 01 WS-EVENT               BINARY-LONG.
 LINKAGE SECTION.
 01 L-INDEX                BINARY-LONG.
 01 L-BUTTON               BINARY-LONG.
 01 L-MAY-BUILD            BINARY-LONG.
 01 L-HANDLED              BINARY-LONG.
 01 L-CHANGED              BINARY-LONG.
 01 L-TOOK                 BINARY-LONG.
 PROCEDURE DIVISION USING L-INDEX L-BUTTON L-MAY-BUILD L-HANDLED L-CHANGED L-TOOK.
     MOVE 0 TO L-HANDLED L-CHANGED L-TOOK
     EVALUATE TRUE
         WHEN L-BUTTON = 1
             COMPUTE WS-N = BE-XI(L-INDEX, 1) - 1
             CALL "BE4-LECTERN-PAGE" USING L-INDEX WS-N L-CHANGED WS-DELAY WS-EVENT
             MOVE 1 TO L-HANDLED
         WHEN L-BUTTON = 2
             COMPUTE WS-N = BE-XI(L-INDEX, 1) + 1
             CALL "BE4-LECTERN-PAGE" USING L-INDEX WS-N L-CHANGED WS-DELAY WS-EVENT
             MOVE 1 TO L-HANDLED
         WHEN L-BUTTON = 3 AND L-MAY-BUILD = 1
             MOVE 0 TO BE-SLOT-ITEM(L-INDEX, 1) BE-SLOT-COUNT(L-INDEX, 1) BE-SLOT-VAR(L-INDEX, 1)
             MOVE 0 TO BE-XI(L-INDEX, 1) BE-XI(L-INDEX, 2)
             MOVE 1 TO L-HANDLED L-TOOK
             CALL "BE-MARK-CHUNK" USING L-INDEX
         WHEN L-BUTTON >= 100
             COMPUTE WS-N = L-BUTTON - 100
             CALL "BE4-LECTERN-PAGE" USING L-INDEX WS-N L-CHANGED WS-DELAY WS-EVENT
             MOVE 1 TO L-HANDLED
     END-EVALUATE
     GOBACK.
 END PROGRAM BE4-LECTERN-BUTTON.

