 01 WS-ONE                 BINARY-LONG VALUE 1.
 LINKAGE SECTION.
 COPY PROTO.
 01 L-INDEX                BINARY-LONG.
 01 L-TYPE                 BINARY-LONG.
 PROCEDURE DIVISION USING L-INDEX L-TYPE PB-BUFFER.
     EVALUATE L-TYPE
         WHEN 4
             IF BE-SLOT-COUNT(L-INDEX, 1) > 0
                 MOVE "RecordItem" TO WN
                 MOVE 10 TO WL
                 CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
                 CALL "KX-PATCH-KEEP" USING BE-SLOT-VAR(L-INDEX, 1) WS-KP
                 CALL "PNBT-STACK-WRITE" USING PB-BUFFER BE-SLOT-ITEM(L-INDEX, 1) BE-SLOT-COUNT(L-INDEX, 1) WS-KP
                 CALL "KX-PATCH-FREE" USING WS-KP
                 CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
             END-IF
             IF BE-XI(L-INDEX, 2) = 1
                 MOVE "ticks_since_song_started" TO WN
                 MOVE 24 TO WL
                 MOVE BE-XI(L-INDEX, 1) TO WS-LONG
                 CALL "NBT-WRITE-LONG" USING PB-BUFFER WN WL WS-LONG
             END-IF
         WHEN 29
             IF BE-SLOT-COUNT(L-INDEX, 1) > 0
                 MOVE "Book" TO WN
                 MOVE 4 TO WL
                 CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
                 CALL "KX-PATCH-KEEP" USING BE-SLOT-VAR(L-INDEX, 1) WS-KP
                 CALL "PNBT-STACK-WRITE" USING PB-BUFFER BE-SLOT-ITEM(L-INDEX, 1) BE-SLOT-COUNT(L-INDEX, 1) WS-KP
                 CALL "KX-PATCH-FREE" USING WS-KP
                 CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
                 MOVE "Page" TO WN
                 MOVE 4 TO WL
                 CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL BE-XI(L-INDEX, 1)
             END-IF
         WHEN 32
             CALL "BE4-CAMPFIRE-ITEMS" USING L-INDEX PB-BUFFER
             MOVE "CookingTimes" TO WN
             MOVE 12 TO WL
             CALL "NBT-WRITE-INT-ARRAY" USING PB-BUFFER WN WL WS-FOUR BE-XI(L-INDEX, 1)
             MOVE "CookingTotalTimes" TO WN
             MOVE 17 TO WL
             CALL "NBT-WRITE-INT-ARRAY" USING PB-BUFFER WN WL WS-FOUR BE-XI(L-INDEX, 5)
         WHEN 13
             IF BE-NAME-LENGTH(L-INDEX) > 0
                 MOVE "CustomName" TO WN
                 MOVE 10 TO WL
                 CALL "NBT-WRITE-STRING" USING PB-BUFFER WN WL BE-NAME(L-INDEX) BE-NAME-LENGTH(L-INDEX)
             END-IF
         WHEN 40
             IF BE-LOOT-LENGTH(L-INDEX) > 0
                 MOVE "LootTable" TO WN
                 MOVE 9 TO WL
                 CALL "NBT-WRITE-STRING" USING PB-BUFFER WN WL BE-LOOT(L-INDEX) BE-LOOT-LENGTH(L-INDEX)
                 IF BE-SEED(L-INDEX) NOT = 0
                     MOVE "LootTableSeed" TO WN
                     MOVE 13 TO WL
                     CALL "NBT-WRITE-LONG" USING PB-BUFFER WN WL BE-SEED(L-INDEX)
                 END-IF
             ELSE
                 IF BE-SLOT-COUNT(L-INDEX, 1) > 0
                     MOVE "item" TO WN
                     MOVE 4 TO WL
                     CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
                     CALL "KX-PATCH-KEEP" USING BE-SLOT-VAR(L-INDEX, 1) WS-KP
                     CALL "PNBT-STACK-WRITE" USING PB-BUFFER BE-SLOT-ITEM(L-INDEX, 1) BE-SLOT-COUNT(L-INDEX, 1) WS-KP
                     CALL "KX-PATCH-FREE" USING WS-KP
                     CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
                 END-IF
             END-IF
         WHEN 33
             MOVE BE-XI(L-INDEX, 5) TO WS-COUNT
             MOVE "bees" TO WN
             MOVE 4 TO WL
             IF WS-COUNT = 0
                 CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WN WL WS-T-NONE WS-COUNT
             ELSE
                 CALL "NBT-WRITE-LIST-BEGIN" USING PB-BUFFER WN WL WS-T-COMPOUND WS-COUNT
             END-IF
             PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-COUNT
                 COMPUTE WS-BASE = 6 + 4 * (WS-I - 1)
                 MOVE "entity_data" TO WN
                 MOVE 11 TO WL
                 CALL "NBT-WRITE-COMPOUND-BEGIN" USING PB-BUFFER WN WL
                 MOVE "id" TO WN
                 MOVE 2 TO WL
                 CALL "NBT-WRITE-STRING" USING PB-BUFFER WN WL BE-XT(L-INDEX, WS-I) BE-XI(L-INDEX, WS-BASE + 3)
                 IF BE-XI(L-INDEX, WS-BASE + 2) = 1
                     MOVE "HasNectar" TO WN
                     MOVE 9 TO WL
                     CALL "NBT-WRITE-BYTE" USING PB-BUFFER WN WL WS-ONE
                 END-IF
                 CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
                 MOVE "ticks_in_hive" TO WN
                 MOVE 13 TO WL
                 CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL BE-XI(L-INDEX, WS-BASE)
                 MOVE "min_ticks_in_hive" TO WN
                 MOVE 17 TO WL
                 CALL "NBT-WRITE-INT" USING PB-BUFFER WN WL BE-XI(L-INDEX, WS-BASE + 1)
                 CALL "NBT-WRITE-COMPOUND-END" USING PB-BUFFER
             END-PERFORM
             IF BE-XI(L-INDEX, 1) = 1
                 MOVE "flower_pos" TO WN
                 MOVE 10 TO WL
                 CALL "NBT-WRITE-INT-ARRAY" USING PB-BUFFER WN WL WS-THREE BE-XI(L-INDEX, 2)
             END-IF
     END-EVALUATE
     GOBACK.
