 IDENTIFICATION DIVISION.
 PROGRAM-ID. BR-FEEDBACK-STYLED.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CORESTATE.
 COPY BRRUN.
 COPY PROTO REPLACING LEADING ==PB-== BY ==PK-==.
 01 WS-FEEDBACK-RULE       PIC X(40) VALUE "send_command_feedback".
 01 WS-LOG-RULE            PIC X(40) VALUE "log_admin_commands".
 01 WS-FEEDBACK            BINARY-DOUBLE.
 01 WS-LOG                 BINARY-DOUBLE.
 01 WS-ROW                 BINARY-LONG.
 01 WS-SHOWN               PIC X(1024).
 01 WS-SHOWN-LENGTH        BINARY-LONG.
 01 WS-SERVER              PIC X(16) VALUE "Server".
 LINKAGE SECTION.
 COPY PROTO.
 01 L-BROADCAST            BINARY-LONG.
 PROCEDURE DIVISION USING PB-TEXT PB-TEXT-STYLE L-BROADCAST.
     IF BS-SILENT = 0
         CALL "BR-RULE-GET" USING WS-FEEDBACK-RULE WS-FEEDBACK
         IF BS-ROW = 0 OR WS-FEEDBACK = 1
             CALL "BR-TELL-STYLED" USING BS-ROW PB-TEXT PB-TEXT-STYLE
         END-IF
         IF L-BROADCAST = 1 AND WS-FEEDBACK = 1
             CALL "BR-LANG-TEXT" USING PB-TEXT WS-SHOWN WS-SHOWN-LENGTH
             INITIALIZE PK-TEXT PK-TEXT-STYLE
             MOVE PB-TEXT-TRANSLATE TO PK-TX-KIND
             MOVE "chat.type.admin" TO PK-TX-VALUE
             MOVE 15 TO PK-TX-LENGTH
             MOVE 2 TO PK-TX-ARG-COUNT
             MOVE BS-NAME TO PK-TX-ARG-VALUE(1)
             MOVE BS-NAME-LENGTH TO PK-TX-ARG-LENGTH(1)
             MOVE WS-SHOWN TO PK-TX-ARG-VALUE(2)
             MOVE WS-SHOWN-LENGTH TO PK-TX-ARG-LENGTH(2)
             MOVE "gray" TO PK-TS-COLOR
             MOVE 1 TO PK-TS-ITALIC
             PERFORM VARYING WS-ROW FROM 1 BY 1 UNTIL WS-ROW > 64
                 IF PL-USED(WS-ROW) = 1 AND PL-OPERATOR(WS-ROW) = 1 AND WS-ROW NOT = BS-ROW
                     CALL "BR-TELL-STYLED" USING WS-ROW PK-TEXT PK-TEXT-STYLE
                 END-IF
             END-PERFORM
             CALL "BR-RULE-GET" USING WS-LOG-RULE WS-LOG
             IF BS-ROW NOT = 0 AND WS-LOG = 1
                 CALL "CONSOLE-TEXT" USING PK-TEXT
             END-IF
         END-IF
     END-IF
     GOBACK.
 END PROGRAM BR-FEEDBACK-STYLED.

