*> The chunk feed (core/src/chunk-feed.cob; CHUNKFEED.cpy): chunk streaming through the generation queue instead of generation inside the join or the move.
*>
*> Entry points:
*>   CHUNK-FEED-ON USING dimension row, flag out: 1 when that dimension's chunks are generated by the time-sliced queue (the feed then serves its players)
*>   CHUNK-FEED-RESET USING player row, chunk x, chunk z: the player's view is the square around that chunk and nothing of it is sent yet
*>   CHUNK-FEED-MOVE USING player row, new chunk x, new chunk z: the view moves; chunks inside both squares keep their sent flag
*>   CHUNK-FEED-PLAYER USING connection id: one tick of a player: the nearest unsent chunks of the view that are loaded are sent (at most CF-SENDS), the nearest unsent
*>     ones that are not are queued (looking at most CF-LOOKS unsent chunks ahead); a batch is Chunk Batch Start, the chunks, Chunk Batch Finished
*>   CHUNK-FEED-TICK: CHUNK-FEED-PLAYER for every connection in the play phase that has a player (called by CORE-TICK after the queue's share)

 IDENTIFICATION DIVISION.
 PROGRAM-ID. CHUNK-FEED-ON.
 DATA DIVISION.
 LINKAGE SECTION.
 01 L-DIM                  BINARY-LONG.
 01 L-FLAG                 BINARY-LONG.
 PROCEDURE DIVISION USING L-DIM L-FLAG.
     CALL "GEN-QUEUE-SLICED" USING L-DIM L-FLAG
     GOBACK.
 END PROGRAM CHUNK-FEED-ON.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. CHUNK-FEED-RESET.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CORESTATE.
 COPY CHUNKFEED.
 01 WS-I                   BINARY-LONG.
 LINKAGE SECTION.
 COPY COREAPI.
 01 L-PLAYER               BINARY-LONG.
 01 L-CX                   BINARY-LONG.
 01 L-CZ                   BINARY-LONG.
 PROCEDURE DIVISION USING L-PLAYER L-CX L-CZ.
     SET ADDRESS OF CORE-SETTINGS TO ADDRESS OF CW-SETTINGS
     MOVE 1 TO CF-ACTIVE(L-PLAYER)
     MOVE PL-DIM(L-PLAYER) TO CF-DIM(L-PLAYER)
     MOVE L-CX TO CF-CX(L-PLAYER)
     MOVE L-CZ TO CF-CZ(L-PLAYER)
     MOVE CS-VIEW-DISTANCE TO CF-D(L-PLAYER)
     IF CF-D(L-PLAYER) > CF-MAX-D
         MOVE CF-MAX-D TO CF-D(L-PLAYER)
     END-IF
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > CF-CELLS
         MOVE 0 TO CF-SENT(L-PLAYER, WS-I)
     END-PERFORM
     GOBACK.
 END PROGRAM CHUNK-FEED-RESET.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. CHUNK-FEED-MOVE.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CHUNKFEED.
 01 WS-OLD.
    05 WS-OLD-FLAG         BINARY-LONG OCCURS 2025 TIMES.
 01 WS-D                   BINARY-LONG.
 01 WS-W                   BINARY-LONG.
 01 WS-NEG                 BINARY-LONG.
 01 WS-DX                  BINARY-LONG.
 01 WS-DZ                  BINARY-LONG.
 01 WS-OX                  BINARY-LONG.
 01 WS-OZ                  BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-J                   BINARY-LONG.
 LINKAGE SECTION.
 01 L-PLAYER               BINARY-LONG.
 01 L-CX                   BINARY-LONG.
 01 L-CZ                   BINARY-LONG.
 PROCEDURE DIVISION USING L-PLAYER L-CX L-CZ.
     MOVE CF-D(L-PLAYER) TO WS-D
     COMPUTE WS-W = 2 * WS-D + 1
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > CF-CELLS
         MOVE CF-SENT(L-PLAYER, WS-I) TO WS-OLD-FLAG(WS-I)
         MOVE 0 TO CF-SENT(L-PLAYER, WS-I)
     END-PERFORM
     COMPUTE WS-NEG = 0 - WS-D
     PERFORM VARYING WS-DZ FROM WS-NEG BY 1 UNTIL WS-DZ > WS-D
         PERFORM VARYING WS-DX FROM WS-NEG BY 1 UNTIL WS-DX > WS-D
             COMPUTE WS-OX = L-CX + WS-DX - CF-CX(L-PLAYER)
             COMPUTE WS-OZ = L-CZ + WS-DZ - CF-CZ(L-PLAYER)
             IF FUNCTION ABS(WS-OX) <= WS-D AND FUNCTION ABS(WS-OZ) <= WS-D
                 COMPUTE WS-I = (WS-DZ + WS-D) * WS-W + WS-DX + WS-D + 1
                 COMPUTE WS-J = (WS-OZ + WS-D) * WS-W + WS-OX + WS-D + 1
                 MOVE WS-OLD-FLAG(WS-J) TO CF-SENT(L-PLAYER, WS-I)
             END-IF
         END-PERFORM
     END-PERFORM
     MOVE L-CX TO CF-CX(L-PLAYER)
     MOVE L-CZ TO CF-CZ(L-PLAYER)
     GOBACK.
 END PROGRAM CHUNK-FEED-MOVE.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. CHUNK-FEED-PLAYER.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CORESTATE.
 COPY CHUNKFEED.
 01 WS-READY               PIC 9 VALUE 0.
 01 WS-CAPACITY            BINARY-LONG VALUE 65536.
 01 WS-PLAYER              BINARY-LONG.
 01 WS-D                   BINARY-LONG.
 01 WS-W                   BINARY-LONG.
 01 WS-R                   BINARY-LONG.
 01 WS-DX                  BINARY-LONG.
 01 WS-DZ                  BINARY-LONG.
 01 WS-STEP                BINARY-LONG.
 01 WS-X                   BINARY-LONG.
 01 WS-Z                   BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 01 WS-ROW                 BINARY-LONG.
 01 WS-LOOKED              BINARY-LONG.
 01 WS-SENT                BINARY-LONG.
 01 WS-STARTED             BINARY-LONG.
 01 WS-DIM                 BINARY-LONG.
 01 WS-FLAG                BINARY-LONG.
 COPY PROTO.
 LINKAGE SECTION.
 01 L-ID                   BINARY-LONG.
 PROCEDURE DIVISION USING L-ID.
     MOVE CN-PLAYER(L-ID) TO WS-PLAYER
     IF WS-PLAYER = 0
         GOBACK
     END-IF
     IF CF-ACTIVE(WS-PLAYER) = 0 OR PL-USED(WS-PLAYER) = 0
         GOBACK
     END-IF
     MOVE CF-DIM(WS-PLAYER) TO WS-DIM
     IF PL-DIM(WS-PLAYER) NOT = WS-DIM
         GOBACK
     END-IF
     IF WS-READY = 0
         CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
         MOVE 1 TO WS-READY
     END-IF
     MOVE CF-D(WS-PLAYER) TO WS-D
     COMPUTE WS-W = 2 * WS-D + 1
     MOVE 0 TO WS-LOOKED WS-SENT WS-STARTED
     PERFORM VARYING WS-R FROM 0 BY 1 UNTIL WS-R > WS-D OR WS-LOOKED >= CF-LOOKS OR WS-SENT >= CF-SENDS
         PERFORM VARYING WS-DZ FROM 0 BY 1 UNTIL WS-DZ > WS-R * 2 OR WS-LOOKED >= CF-LOOKS OR WS-SENT >= CF-SENDS
             MOVE 1 TO WS-STEP
             IF WS-DZ > 0 AND WS-DZ < WS-R * 2
                 COMPUTE WS-STEP = WS-R * 2
             END-IF
             PERFORM VARYING WS-DX FROM 0 BY WS-STEP UNTIL WS-DX > WS-R * 2 OR WS-LOOKED >= CF-LOOKS OR WS-SENT >= CF-SENDS
                 COMPUTE WS-X = CF-CX(WS-PLAYER) + WS-DX - WS-R
                 COMPUTE WS-Z = CF-CZ(WS-PLAYER) + WS-DZ - WS-R
                 COMPUTE WS-I = (WS-DZ - WS-R + WS-D) * WS-W + (WS-DX - WS-R) + WS-D + 1
                 IF CF-SENT(WS-PLAYER, WS-I) = 0
                     ADD 1 TO WS-LOOKED
                     CALL "WORLD-FIND" USING WS-DIM WS-X WS-Z WS-ROW
                     IF WS-ROW = 0
                         CALL "GEN-QUEUE-WANT" USING WS-DIM WS-X WS-Z
                     ELSE
                         IF WS-STARTED = 0
                             CALL "PB-RESET" USING PB-BUFFER
                             CALL "CHUNK-BATCH-START-BUILD" USING PB-BUFFER
                             CALL "CORE-SEND" USING L-ID PB-BUFFER
                             MOVE 1 TO WS-STARTED
                         END-IF
                         CALL "PB-RESET" USING PB-BUFFER
                         CALL "CHUNK-PACKET-BUILD" USING WS-DIM WS-X WS-Z PB-BUFFER
                         CALL "CORE-SEND" USING L-ID PB-BUFFER
                         MOVE 1 TO CF-SENT(WS-PLAYER, WS-I)
                         ADD 1 TO WS-SENT
                     END-IF
                 END-IF
             END-PERFORM
         END-PERFORM
     END-PERFORM
     IF WS-STARTED = 1
         CALL "PB-RESET" USING PB-BUFFER
         CALL "CHUNK-BATCH-FINISHED-BUILD" USING WS-SENT PB-BUFFER
         CALL "CORE-SEND" USING L-ID PB-BUFFER
         ADD 1 TO PL-BATCH-PENDING(WS-PLAYER)
     END-IF
     GOBACK.
 END PROGRAM CHUNK-FEED-PLAYER.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. CHUNK-FEED-TICK.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CORESTATE.
 01 WS-I                   BINARY-LONG.
 PROCEDURE DIVISION.
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > CORE-MAX-CONNS
         IF CN-USED(WS-I) = 1 AND CN-PHASE(WS-I) = PH-PLAY
             CALL "CHUNK-FEED-PLAYER" USING WS-I
         END-IF
     END-PERFORM
     GOBACK.
 END PROGRAM CHUNK-FEED-TICK.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. WORLD-CHUNK-PEEK.
*> USING dim, chunk x, chunk z, row out (BINARY-LONG): the cache row of a chunk that a light needs as a neighbour. A dimension generated by the time-sliced queue never generates
*> it here (a neighbour that is not loaded answers row 0: the whole generation of a chunk would stall the tick); any other dimension loads it as WORLD-CHUNK-LOAD does.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-SLICED              BINARY-LONG.
 LINKAGE SECTION.
 01 L-DIM                  BINARY-LONG.
 01 L-CX                   BINARY-LONG.
 01 L-CZ                   BINARY-LONG.
 01 L-ROW                  BINARY-LONG.
 PROCEDURE DIVISION USING L-DIM L-CX L-CZ L-ROW.
     CALL "GEN-QUEUE-SLICED" USING L-DIM WS-SLICED
     IF WS-SLICED = 1
         CALL "WORLD-FIND" USING L-DIM L-CX L-CZ L-ROW
     ELSE
         CALL "WORLD-CHUNK-LOAD" USING L-DIM L-CX L-CZ L-ROW
     END-IF
     GOBACK.
 END PROGRAM WORLD-CHUNK-PEEK.
