 01 L-ROW                  BINARY-LONG.
 01 L-SLOT                 BINARY-LONG.
 01 L-AMOUNT               BINARY-LONG.
 PROCEDURE DIVISION USING L-ROW L-SLOT L-AMOUNT.
     IF MN-EQUIP-COUNT(L-ROW, L-SLOT) = 0
         GOBACK
     END-IF
     MOVE MN-EQUIP-VAR(L-ROW, L-SLOT) TO WS-HANDLE
     CALL "SP-GET-MAX-DAMAGE" USING MN-EQUIP-ITEM(L-ROW, L-SLOT) WS-HANDLE WS-MAX
     IF WS-MAX = 0
         GOBACK
     END-IF
     CALL "TOOL-ENCHANT-ID" USING WS-KEY WS-ID
     MOVE 0 TO WS-LEVEL
     IF WS-ID >= 0
         CALL "SP-ENCHANT-LEVEL" USING WS-HANDLE WS-ID WS-LEVEL
     END-IF
     CALL "TOOL-UNBREAKING-APPLY" USING L-AMOUNT WS-LEVEL WS-ARMOR WS-LEFT
     CALL "SP-GET-DAMAGE" USING MN-EQUIP-ITEM(L-ROW, L-SLOT) WS-HANDLE WS-DAMAGE
     MOVE PL-MODE(L-ROW) TO WS-CREATIVE
     CALL "TOOL-DAMAGE-STACK" USING WS-DAMAGE WS-MAX WS-LEFT WS-CREATIVE WS-NEW WS-BROKE WS-NEXT
     IF WS-NEW NOT = WS-DAMAGE
         CALL "SP-SET-DAMAGE" USING WS-HANDLE WS-NEW
         MOVE WS-HANDLE TO MN-EQUIP-VAR(L-ROW, L-SLOT)
     END-IF
     IF WS-BROKE = 1
         MOVE 0 TO MN-EQUIP-COUNT(L-ROW, L-SLOT) MN-EQUIP-VAR(L-ROW, L-SLOT)
     END-IF
     IF MN-WINDOW(L-ROW) = 0
         COMPUTE WS-MENU-SLOT = 9 - L-SLOT
         CALL "MENU-SLOT-SEND" USING PL-CONN(L-ROW) WS-MENU-SLOT
     END-IF
     GOBACK.
