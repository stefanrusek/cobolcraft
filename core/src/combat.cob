 IDENTIFICATION DIVISION.
 PROGRAM-ID. HEALTH-HURT.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY CORESTATE.
 COPY CMENU.
 COPY RULES.
 COPY PROTO.
 COPY CTOOLS.
 COPY ENCHCTX.
 01 WS-CAPACITY            BINARY-LONG VALUE 64.
 01 WS-ROW                 BINARY-LONG.
 01 WS-SOURCE              BINARY-LONG.
 01 WS-CAUSE               BINARY-LONG.
 01 WS-ATTACKER            BINARY-LONG.
 01 WS-APPLY               BINARY-LONG.
 01 WS-FRESH               BINARY-LONG.
 01 WS-TAKEN               BINARY-LONG.
 01 WS-EXHAUST             FLOAT-LONG.
 01 WS-ARMOR               BINARY-LONG.
 01 WS-TOUGHNESS           BINARY-LONG.
 01 WS-KNOCKBACK           BINARY-LONG.
 01 WS-PROTECTION          BINARY-LONG.
 01 WS-POINTS              BINARY-LONG.
 01 WS-RESISTANCE          BINARY-LONG.
 01 WS-LEVEL               BINARY-LONG.
 01 WS-TICKS               BINARY-LONG.
 01 WS-RESISTANCE-ID       BINARY-LONG VALUE 10.
 01 WS-DIFFICULTY          BINARY-LONG VALUE 0.
 01 WS-SCALES              BINARY-LONG VALUE 0.
 01 WS-BLOCKED             BINARY-LONG VALUE 0.
 01 WS-BYPASS-ARMOR        BINARY-LONG VALUE 0.
 01 WS-BYPASS-RESIST       BINARY-LONG VALUE 0.
 01 WS-BYPASS-EFFECTS      BINARY-LONG VALUE 0.
 01 WS-ABSORPTION          BINARY-LONG VALUE 0.
 01 WS-NEW-ABSORPTION      BINARY-LONG.
 01 WS-WEAR                BINARY-LONG.
 01 WS-SLOT                BINARY-LONG.
 LINKAGE SECTION.
 01 L-ROW                  BINARY-LONG.
 01 L-AMOUNT               BINARY-LONG.
 01 L-CAUSE                BINARY-LONG.
 01 L-SOURCE               BINARY-LONG.
 01 L-ATTACKER             BINARY-LONG.
 01 L-RESULT               BINARY-LONG.
 PROCEDURE DIVISION USING L-ROW L-AMOUNT L-CAUSE L-SOURCE L-ATTACKER L-RESULT.
     MOVE 0 TO L-RESULT
     MOVE L-ROW TO WS-ROW
     IF PL-MODE(WS-ROW) NOT = 0 OR PL-STATE(WS-ROW) NOT = PS-ALIVE
         GOBACK
     END-IF
     IF TS-OWNER(WS-ROW) NOT = PL-ENTITY-ID(WS-ROW)
         MOVE PL-ENTITY-ID(WS-ROW) TO TS-OWNER(WS-ROW)
         MOVE 0 TO TS-LAST-ATTACK(WS-ROW) TS-LAST-HURT(WS-ROW)
     END-IF
     IF PL-HURT-COOLDOWN(WS-ROW) > RULE-HURT-FRESH AND L-AMOUNT <= TS-LAST-HURT(WS-ROW)
         GOBACK
     END-IF
     MOVE L-CAUSE TO WS-CAUSE
     MOVE L-ATTACKER TO WS-ATTACKER
     MOVE 0 TO WS-SOURCE
     IF L-SOURCE > 0
         COMPUTE WS-SOURCE = L-SOURCE + 1
     END-IF
     MOVE 1 TO WS-FRESH
     MOVE L-AMOUNT TO WS-APPLY
     IF PL-HURT-COOLDOWN(WS-ROW) > RULE-HURT-FRESH
         MOVE 0 TO WS-FRESH
         COMPUTE WS-APPLY = L-AMOUNT - TS-LAST-HURT(WS-ROW)
     END-IF
     MOVE L-AMOUNT TO TS-LAST-HURT(WS-ROW)
     COMPUTE PL-LAST-HURT(WS-ROW) = L-AMOUNT / 1000
     MOVE WS-APPLY TO WS-TAKEN
     IF WS-CAUSE = CAUSE-PLAYER
         MOVE 1 TO EC-DIRECT
         MOVE "player_attack" TO EC-DAMAGE-KEY
         MOVE -1 TO EC-VICTIM-ID
         MOVE "player" TO EC-VICTIM-KEY
         CALL "COMBAT-ARMOR-STATS" USING WS-ROW ENCH-CTX WS-ARMOR WS-TOUGHNESS WS-KNOCKBACK WS-PROTECTION
         COMPUTE WS-POINTS = WS-PROTECTION / 10000
         CALL "EFFECT-LEVEL" USING WS-ROW WS-RESISTANCE-ID WS-LEVEL WS-TICKS
         COMPUTE WS-RESISTANCE = WS-LEVEL - 1
         IF WS-ARMOR > 0 OR WS-POINTS > 0 OR WS-RESISTANCE >= 0
             CALL "TOOL-HURT-PIPELINE" USING WS-APPLY WS-DIFFICULTY WS-SCALES WS-BLOCKED WS-ARMOR WS-TOUGHNESS WS-BYPASS-ARMOR
                 WS-RESISTANCE WS-BYPASS-RESIST WS-BYPASS-EFFECTS WS-POINTS WS-ABSORPTION WS-TAKEN WS-NEW-ABSORPTION WS-WEAR
             IF WS-ARMOR > 0
                 PERFORM VARYING WS-SLOT FROM 1 BY 1 UNTIL WS-SLOT > 4
                     CALL "COMBAT-EQUIP-HURT" USING WS-ROW WS-SLOT WS-WEAR
                 END-PERFORM
             END-IF
         END-IF
     END-IF
     MOVE 1 TO L-RESULT
     IF WS-FRESH = 0
         MOVE 2 TO L-RESULT
     END-IF
     COMPUTE WS-EXHAUST = RULE-CAUSE-EXHAUST(WS-CAUSE) / 1000
     CALL "HUNGER-EXHAUST" USING WS-ROW WS-EXHAUST
     COMPUTE PL-HEALTH(WS-ROW) = FUNCTION MAX(0, PL-HEALTH(WS-ROW) - WS-TAKEN / 1000)
     IF WS-FRESH = 1
         MOVE RULE-HURT-WINDOW TO PL-HURT-COOLDOWN(WS-ROW)
         CALL "PB-INIT" USING PB-BUFFER WS-CAPACITY
         CALL "DAMAGE-EVENT-BUILD" USING PL-ENTITY-ID(WS-ROW) RULE-CAUSE-TYPE(WS-CAUSE) WS-SOURCE
             PB-BUFFER
         CALL "CORE-SEND" USING PL-CONN(WS-ROW) PB-BUFFER
         CALL "HEALTH-VIEWERS-SEND" USING PL-ENTITY-ROW(WS-ROW) PB-BUFFER
         CALL "PB-RESET" USING PB-BUFFER
         CALL "HURT-ANIMATION-BUILD" USING PL-ENTITY-ID(WS-ROW) PB-BUFFER
         CALL "CORE-SEND" USING PL-CONN(WS-ROW) PB-BUFFER
         CALL "HEALTH-VIEWERS-SEND" USING PL-ENTITY-ROW(WS-ROW) PB-BUFFER
         CALL "PB-FREE" USING PB-BUFFER
     END-IF
     CALL "HEALTH-SEND" USING WS-ROW
     IF PL-HEALTH(WS-ROW) <= 0
         CALL "HEALTH-DIE" USING WS-ROW WS-CAUSE WS-ATTACKER
     END-IF
     GOBACK.
 END PROGRAM HEALTH-HURT.

