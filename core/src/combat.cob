 LINKAGE SECTION.
 COPY COREAPI.
 01 L-ROW                  BINARY-LONG.
 01 L-ENTITY               BINARY-LONG.
 PROCEDURE DIVISION USING L-ROW L-ENTITY.
     SET ADDRESS OF CORE-SETTINGS TO ADDRESS OF CW-SETTINGS
     MOVE EN-PLAYER(L-ENTITY) TO WS-TARGET
     IF WS-TARGET > 0 AND CS-PLAYER-COMBAT NOT = 1
         GOBACK
     END-IF
     IF TS-OWNER(L-ROW) NOT = PL-ENTITY-ID(L-ROW)
         MOVE PL-ENTITY-ID(L-ROW) TO TS-OWNER(L-ROW)
         MOVE 0 TO TS-LAST-ATTACK(L-ROW) TS-LAST-HURT(L-ROW)
     END-IF
*>   The held item: its key and the stats of its attack_damage and attack_speed components (no such item: the bare hand, 1.0 and speed 4.0).
     MOVE 0 TO WS-ITEM WS-HANDLE
     IF PL-SLOT-COUNT(L-ROW, PL-HELD(L-ROW) + 1) > 0
         MOVE PL-SLOT-ITEM(L-ROW, PL-HELD(L-ROW) + 1) TO WS-ITEM
         MOVE PL-SLOT-VAR(L-ROW, PL-HELD(L-ROW) + 1) TO WS-HANDLE
     END-IF
     MOVE SPACES TO WS-KEY
     MOVE 0 TO WS-FOUND WS-LEN
     IF WS-ITEM > 0 AND WS-ITEM < IT-COUNT
         MOVE IT-KEY(WS-ITEM + 1) TO WS-KEY
         CALL "TOOL-ITEM-STATS" USING WS-KEY WS-FOUND WS-DURABILITY WS-DAMAGE10K WS-SPEED10K WS-COOLDOWN WS-MINING
     END-IF
     IF WS-FOUND = 0
         MOVE 10000 TO WS-DAMAGE10K
         MOVE 40000 TO WS-SPEED10K
     END-IF
     COMPUTE WS-LEN = FUNCTION LENGTH(FUNCTION TRIM(WS-KEY))
     COMPUTE WS-MODIFIER = (WS-SPEED10K - 40000) / 10
     CALL "EFFECT-LEVEL" USING L-ROW WS-HASTE-ID WS-HASTE WS-TICKS
     CALL "EFFECT-LEVEL" USING L-ROW WS-FATIGUE-ID WS-FATIGUE WS-TICKS
     CALL "EFFECT-LEVEL" USING L-ROW WS-STRENGTH-ID WS-STRENGTH WS-TICKS
     CALL "EFFECT-LEVEL" USING L-ROW WS-WEAKNESS-ID WS-WEAKNESS WS-TICKS
     CALL "EFFECT-LEVEL" USING L-ROW WS-BLIND-ID WS-BLIND WS-TICKS
     IF WS-BLIND > 0
         MOVE 1 TO WS-BLIND
     END-IF
     CALL "TOOL-ATTACK-SPEED" USING WS-MODIFIER WS-HASTE WS-FATIGUE WS-SPEED
     CALL "TOOL-ATTACK-DELAY" USING WS-SPEED WS-DELAY
     IF TS-LAST-ATTACK(L-ROW) = 0
         MOVE 1000 TO WS-TICKER
     ELSE
         COMPUTE WS-TICKER = CW-TICKS + 1 - TS-LAST-ATTACK(L-ROW)
     END-IF
     CALL "TOOL-ATTACK-SCALE" USING WS-TICKER WS-A WS-DELAY WS-SCALE
*>   The attack resets the ticker whether or not the hit lands (17 section 4.2 step 7).
     COMPUTE TS-LAST-ATTACK(L-ROW) = CW-TICKS + 1
     COMPUTE WS-BONUS = WS-DAMAGE10K / 10 - 1000
     CALL "TOOL-ATTACK-ATTR" USING WS-BONUS WS-STRENGTH WS-WEAKNESS WS-BASE
*>   The damage enchantments of the held stack (28 section 6; the registry rows) before the scale factor.
     MOVE 1 TO EC-DIRECT
     MOVE "player_attack" TO EC-DAMAGE-KEY
     MOVE EN-TYPE(L-ENTITY) TO EC-VICTIM-ID
     MOVE SPACES TO EC-VICTIM-KEY
     IF WS-TARGET > 0
         MOVE "player" TO EC-VICTIM-KEY
     END-IF
     MOVE "minecraft:damage" TO WS-COMPONENT
     COMPUTE WS-START = WS-BASE * 10
     CALL "COMBAT-ENCHANT-SUM" USING WS-HANDLE WS-COMPONENT ENCH-CTX WS-START WS-SUM
     COMPUTE WS-ENCHANT = FUNCTION MAX(0, (WS-SUM - WS-START) / 10)
     MOVE PL-SPRINTING(L-ROW) TO WS-SPRINTING
     MOVE 0 TO WS-FALL
     MOVE PL-ON-GROUND(L-ROW) TO WS-GROUND
     IF PL-ON-GROUND(L-ROW) = 0 AND PL-FALL-START(L-ROW) > PL-Y(L-ROW)
         MOVE 1 TO WS-FALL
     END-IF
     CALL "TOOL-BREAK-MODS" USING L-ROW WS-EFFICIENCY WS-HASTE WS-FATIGUE WS-WATER
     MOVE 0 TO WS-BONUS
     CALL "TOOL-ATTACK-CALC" USING WS-BASE WS-ENCHANT WS-SCALE WS-SPRINTING WS-FALL WS-GROUND WS-CLIMB WS-WATER WS-BLIND
         WS-PASSENGER WS-ONE WS-BONUS WS-TOTAL WS-CRIT WS-SPRINT-KB WS-FULL
     IF WS-TOTAL <= 0
         GOBACK
     END-IF
     MOVE 0 TO WS-RESULT
     IF WS-TARGET = 0
         MOVE CAUSE-PLAYER TO WS-CAUSE
         COMPUTE WS-MOB-AMOUNT ROUNDED = FUNCTION MAX(1, WS-TOTAL / 1000)
         CALL "HEALTH-MOB-DAMAGE" USING L-ENTITY WS-MOB-AMOUNT WS-CAUSE L-ROW
         MOVE 1 TO WS-RESULT
     ELSE
         CALL "HEALTH-HURT" USING WS-TARGET WS-TOTAL CAUSE-PLAYER PL-ENTITY-ID(L-ROW) L-ROW WS-RESULT
     END-IF
     IF WS-RESULT = 0
         GOBACK
     END-IF
*>   Knockback of a fresh hit on a player: 0.4 away from the attacker, then (attack_knockback + Knockback level) / 2, plus 0.5 sprinting.
     IF WS-TARGET > 0 AND WS-RESULT = 1 AND PL-STATE(WS-TARGET) = PS-ALIVE
         MOVE "minecraft:knockback" TO WS-COMPONENT
         MOVE 0 TO WS-START
         CALL "COMBAT-ENCHANT-SUM" USING WS-HANDLE WS-COMPONENT ENCH-CTX WS-START WS-SUM
         COMPUTE WS-KB-LEVEL = WS-SUM / 10000
         CALL "TOOL-ATTACK-KNOCKBACK" USING WS-ZERO WS-KB-LEVEL WS-SPRINT-KB WS-K
         CALL "COMBAT-KNOCKBACK-HIT" USING WS-TARGET L-ROW WS-K
     END-IF
*>   The held tool wears (5.1): item_damage_per_attack 1 for a sword, mace, trident or spear, 2 for a pickaxe, axe, shovel or hoe.
     MOVE 0 TO WS-COST
     MOVE WS-KEY TO WS-SHORT
     COMPUTE WS-LEN = FUNCTION LENGTH(FUNCTION TRIM(WS-SHORT))
     IF WS-SHORT = "mace" OR "trident"
         MOVE 1 TO WS-COST
     END-IF
     IF WS-LEN >= 6
         IF WS-SHORT(WS-LEN - 5:6) = "_sword" OR "_spear"
             MOVE 1 TO WS-COST
         END-IF
     END-IF
     IF WS-LEN >= 4
         IF WS-SHORT(WS-LEN - 3:4) = "_axe" OR "_hoe"
             MOVE 2 TO WS-COST
         END-IF
     END-IF
     IF WS-LEN >= 7
         IF WS-SHORT(WS-LEN - 6:7) = "_shovel"
             MOVE 2 TO WS-COST
         END-IF
     END-IF
     IF WS-COST > 0
         CALL "TOOL-HURT-STACK" USING PL-CONN(L-ROW) PL-HELD(L-ROW) WS-COST WS-BROKE
     END-IF
     GOBACK.
 END PROGRAM COMBAT-ATTACK.
