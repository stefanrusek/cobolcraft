*> Entity and location effects (docs/protocol/28 section 6; US14; T2171): the numeric and decision rules of the effect objects. Thousandths unless said.
*>   TOOL-EFFECT-MOB-EFFECT USING min duration, max duration (seconds), min amplifier, max amplifier, roll duration, roll amplifier (0 to 1000),
*>     duration out (ticks: round half up of the seconds x 20), amplifier out (max(0, round half up))
*>   TOOL-EFFECT-ITEM-DAMAGE USING amount, damage out (truncated toward zero; negative repairs)
*>   TOOL-EFFECT-SOUND-INDEX USING level, count, index out (clamp(level - 1, 0, count - 1))
*>   TOOL-SOUND-CLAMP USING volume, pitch (hundred-thousandths), volume out (1.0E-5 to 10.0), pitch out (at least 1.0E-5)
*>   TOOL-DISK-LAYER USING height, lowest y offset out (min(height - 1, 0)); TOOL-DISK-CELL USING radius, dx, dz, in out (dx² + dz² < r²)
*>   TOOL-IMPULSE USING direction x, y, z, coordinate scale x, y, z, magnitude, vx out, vy out, vz out, grace ticks out (10)
*>   TOOL-PARTICLE-COORD USING type (0 entity_position, 1 in_bounding_box), entity coordinate, centre, extent, scale, offset, roll (0 to 1000), out
*>   TOOL-ATTR-ID USING id, slot name, modifier id out ("id/slot")
*>   TOOL-LOCATION-STEP USING slot set, enchantment active in the slot, effect was active, requirements match, action out (0 nothing, 1 apply newly
*>     active, 2 apply, 3 remove the enchantment's entry and deactivate its effects, 4 deactivate this effect)
*>   TOOL-LOCATION-EMPTY USING active effects left, remove entry out (1 when none left)
*>   TOOL-EFFECT-RULES USING ignite seconds unit, exhaustion players only, run_function permission level out

 IDENTIFICATION DIVISION.
 PROGRAM-ID. TOOL-EFFECT-MOB-EFFECT.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-SECONDS             BINARY-LONG.
 01 WS-AMP                 BINARY-LONG.
 LINKAGE SECTION.
 01 L-MIN-DURATION         BINARY-LONG.
 01 L-MAX-DURATION         BINARY-LONG.
 01 L-MIN-AMPLIFIER        BINARY-LONG.
 01 L-MAX-AMPLIFIER        BINARY-LONG.
 01 L-ROLL-DURATION        BINARY-LONG.
 01 L-ROLL-AMPLIFIER       BINARY-LONG.
 01 L-TICKS                BINARY-LONG.
 01 L-AMPLIFIER            BINARY-LONG.
 PROCEDURE DIVISION USING L-MIN-DURATION L-MAX-DURATION L-MIN-AMPLIFIER L-MAX-AMPLIFIER L-ROLL-DURATION L-ROLL-AMPLIFIER
         L-TICKS L-AMPLIFIER.
     COMPUTE WS-SECONDS = L-MIN-DURATION + L-ROLL-DURATION * (L-MAX-DURATION - L-MIN-DURATION) / 1000
     COMPUTE L-TICKS = FUNCTION INTEGER((WS-SECONDS * 20 + 500) / 1000)
     COMPUTE WS-AMP = L-MIN-AMPLIFIER + L-ROLL-AMPLIFIER * (L-MAX-AMPLIFIER - L-MIN-AMPLIFIER) / 1000
     COMPUTE L-AMPLIFIER = FUNCTION INTEGER((WS-AMP + 500) / 1000)
     IF L-AMPLIFIER < 0
         MOVE 0 TO L-AMPLIFIER
     END-IF
     GOBACK.
 END PROGRAM TOOL-EFFECT-MOB-EFFECT.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. TOOL-EFFECT-ITEM-DAMAGE.
 DATA DIVISION.
 LINKAGE SECTION.
 01 L-AMOUNT               BINARY-LONG.
 01 L-DAMAGE               BINARY-LONG.
 PROCEDURE DIVISION USING L-AMOUNT L-DAMAGE.
     COMPUTE L-DAMAGE = L-AMOUNT / 1000
     GOBACK.
 END PROGRAM TOOL-EFFECT-ITEM-DAMAGE.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. TOOL-EFFECT-SOUND-INDEX.
 DATA DIVISION.
 LINKAGE SECTION.
 01 L-LEVEL                BINARY-LONG.
 01 L-COUNT                BINARY-LONG.
 01 L-INDEX                BINARY-LONG.
 PROCEDURE DIVISION USING L-LEVEL L-COUNT L-INDEX.
     COMPUTE L-INDEX = L-LEVEL - 1
     IF L-INDEX > L-COUNT - 1
         COMPUTE L-INDEX = L-COUNT - 1
     END-IF
     IF L-INDEX < 0
         MOVE 0 TO L-INDEX
     END-IF
     GOBACK.
 END PROGRAM TOOL-EFFECT-SOUND-INDEX.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. TOOL-SOUND-CLAMP.
 DATA DIVISION.
 LINKAGE SECTION.
 01 L-VOLUME               BINARY-LONG.
 01 L-PITCH                BINARY-LONG.
 01 L-NEW-VOLUME           BINARY-LONG.
 01 L-NEW-PITCH            BINARY-LONG.
 PROCEDURE DIVISION USING L-VOLUME L-PITCH L-NEW-VOLUME L-NEW-PITCH.
     MOVE L-VOLUME TO L-NEW-VOLUME
     MOVE L-PITCH TO L-NEW-PITCH
     IF L-NEW-VOLUME < 1
         MOVE 1 TO L-NEW-VOLUME
     END-IF
     IF L-NEW-VOLUME > 1000000
         MOVE 1000000 TO L-NEW-VOLUME
     END-IF
     IF L-NEW-PITCH < 1
         MOVE 1 TO L-NEW-PITCH
     END-IF
     GOBACK.
 END PROGRAM TOOL-SOUND-CLAMP.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. TOOL-DISK-LAYER.
 DATA DIVISION.
 LINKAGE SECTION.
 01 L-HEIGHT               BINARY-LONG.
 01 L-LOW                  BINARY-LONG.
 PROCEDURE DIVISION USING L-HEIGHT L-LOW.
     COMPUTE L-LOW = L-HEIGHT - 1
     IF L-LOW > 0
         MOVE 0 TO L-LOW
     END-IF
     GOBACK.
 END PROGRAM TOOL-DISK-LAYER.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. TOOL-DISK-CELL.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-D2                  BINARY-DOUBLE.
 01 WS-R2                  BINARY-DOUBLE.
 LINKAGE SECTION.
 01 L-RADIUS               BINARY-LONG.
 01 L-DX                   BINARY-LONG.
 01 L-DZ                   BINARY-LONG.
 01 L-IN                   BINARY-LONG.
 PROCEDURE DIVISION USING L-RADIUS L-DX L-DZ L-IN.
     COMPUTE WS-D2 = L-DX * L-DX + L-DZ * L-DZ
     COMPUTE WS-R2 = L-RADIUS * L-RADIUS * 1000000
     MOVE 0 TO L-IN
     IF WS-D2 < WS-R2
         MOVE 1 TO L-IN
     END-IF
     GOBACK.
 END PROGRAM TOOL-DISK-CELL.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. TOOL-IMPULSE.
 DATA DIVISION.
 LINKAGE SECTION.
 01 L-DX                   BINARY-LONG.
 01 L-DY                   BINARY-LONG.
 01 L-DZ                   BINARY-LONG.
 01 L-SX                   BINARY-LONG.
 01 L-SY                   BINARY-LONG.
 01 L-SZ                   BINARY-LONG.
 01 L-MAGNITUDE            BINARY-LONG.
 01 L-VX                   BINARY-LONG.
 01 L-VY                   BINARY-LONG.
 01 L-VZ                   BINARY-LONG.
 01 L-GRACE                BINARY-LONG.
 PROCEDURE DIVISION USING L-DX L-DY L-DZ L-SX L-SY L-SZ L-MAGNITUDE L-VX L-VY L-VZ L-GRACE.
     COMPUTE L-VX = L-DX * L-SX / 1000 * L-MAGNITUDE / 1000
     COMPUTE L-VY = L-DY * L-SY / 1000 * L-MAGNITUDE / 1000
     COMPUTE L-VZ = L-DZ * L-SZ / 1000 * L-MAGNITUDE / 1000
     MOVE 10 TO L-GRACE
     GOBACK.
 END PROGRAM TOOL-IMPULSE.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. TOOL-PARTICLE-COORD.
 DATA DIVISION.
 LINKAGE SECTION.
 01 L-TYPE                 BINARY-LONG.
 01 L-POSITION             BINARY-LONG.
 01 L-CENTRE               BINARY-LONG.
 01 L-EXTENT               BINARY-LONG.
 01 L-SCALE                BINARY-LONG.
 01 L-OFFSET               BINARY-LONG.
 01 L-ROLL                 BINARY-LONG.
 01 L-OUT                  BINARY-LONG.
 PROCEDURE DIVISION USING L-TYPE L-POSITION L-CENTRE L-EXTENT L-SCALE L-OFFSET L-ROLL L-OUT.
     IF L-TYPE = 0
         COMPUTE L-OUT = L-POSITION + L-OFFSET
     ELSE
         COMPUTE L-OUT = L-CENTRE + (L-ROLL - 500) * L-EXTENT / 1000 * L-SCALE / 1000 + L-OFFSET
     END-IF
     GOBACK.
 END PROGRAM TOOL-PARTICLE-COORD.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. TOOL-ATTR-ID.
 DATA DIVISION.
 LINKAGE SECTION.
 01 L-ID                   PIC X(48).
 01 L-SLOT                 PIC X(48).
 01 L-OUT                  PIC X(48).
 PROCEDURE DIVISION USING L-ID L-SLOT L-OUT.
     MOVE SPACES TO L-OUT
     STRING FUNCTION TRIM(L-ID) "/" FUNCTION TRIM(L-SLOT) DELIMITED BY SIZE INTO L-OUT
     GOBACK.
 END PROGRAM TOOL-ATTR-ID.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. TOOL-LOCATION-STEP.
 DATA DIVISION.
 LINKAGE SECTION.
 01 L-SLOT                 BINARY-LONG.
 01 L-ACTIVE               BINARY-LONG.
 01 L-WAS                  BINARY-LONG.
 01 L-MATCH                BINARY-LONG.
 01 L-ACTION               BINARY-LONG.
 PROCEDURE DIVISION USING L-SLOT L-ACTIVE L-WAS L-MATCH L-ACTION.
     MOVE 0 TO L-ACTION
     EVALUATE TRUE
         WHEN L-SLOT = 0
             CONTINUE
         WHEN L-ACTIVE = 0
             MOVE 3 TO L-ACTION
         WHEN L-MATCH = 1 AND L-WAS = 0
             MOVE 1 TO L-ACTION
         WHEN L-MATCH = 1
             MOVE 2 TO L-ACTION
         WHEN L-WAS = 1
             MOVE 4 TO L-ACTION
     END-EVALUATE
     GOBACK.
 END PROGRAM TOOL-LOCATION-STEP.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. TOOL-LOCATION-EMPTY.
 DATA DIVISION.
 LINKAGE SECTION.
 01 L-LEFT                 BINARY-LONG.
 01 L-REMOVE               BINARY-LONG.
 PROCEDURE DIVISION USING L-LEFT L-REMOVE.
     MOVE 0 TO L-REMOVE
     IF L-LEFT = 0
         MOVE 1 TO L-REMOVE
     END-IF
     GOBACK.
 END PROGRAM TOOL-LOCATION-EMPTY.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. TOOL-EFFECT-RULES.
 DATA DIVISION.
 LINKAGE SECTION.
 01 L-IGNITE               BINARY-LONG.
 01 L-EXHAUSTION           BINARY-LONG.
 01 L-PERMISSION           BINARY-LONG.
 PROCEDURE DIVISION USING L-IGNITE L-EXHAUSTION L-PERMISSION.
     MOVE 1 TO L-IGNITE L-EXHAUSTION
     MOVE 2 TO L-PERMISSION
     GOBACK.
 END PROGRAM TOOL-EFFECT-RULES.
