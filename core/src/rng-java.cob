*> The Java LCG source of the classic carvers (docs/protocol/10 section 2.6, 11 section 4): java.util.Random's 48 bit linear
*> congruential generator and the large feature seeding. The state is one BINARY-DOUBLE UNSIGNED (the 48 bit seed); seeds and
*> nextLong results are unsigned 64 bit words (the bits of the Java long).
*>
*> Entry points:
*>   JRAND-SET-SEED USING state out (u64), seed (u64): state = (seed xor 0x5DEECE66D) and (2^48 - 1)
*>   JRAND-NEXT USING state (in and out), bits (BINARY-LONG 1 to 32), result out (BINARY-DOUBLE): next(bits), a signed int for 32
*>   JRAND-NEXT-INT-BOUND USING state, bound (BINARY-LONG, positive), result out (BINARY-LONG): nextInt(bound)
*>   JRAND-NEXT-LONG USING state, result out (u64): the bits of nextLong()
*>   JRAND-NEXT-FLOAT USING state, result out (FLOAT-LONG): nextFloat(), next(24) / 2^24
*>   JRAND-LARGE-FEATURE-SEED USING state out, seed (u64), cx, cz (BINARY-LONG): setLargeFeatureSeed (11 section 4)

 IDENTIFICATION DIVISION.
 PROGRAM-ID. JRAND-SET-SEED.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-MULT                BINARY-DOUBLE UNSIGNED VALUE 25214903917.
 01 WS-M48                 BINARY-DOUBLE UNSIGNED VALUE 281474976710656.
 01 WS-T                   BINARY-DOUBLE UNSIGNED.
 LINKAGE SECTION.
 01 L-STATE                BINARY-DOUBLE UNSIGNED.
 01 L-SEED                 BINARY-DOUBLE UNSIGNED.
 PROCEDURE DIVISION USING L-STATE L-SEED.
     MOVE L-SEED TO WS-T
     CALL "CBL_XOR" USING WS-MULT WS-T BY VALUE 8
     COMPUTE L-STATE = FUNCTION MOD(WS-T, WS-M48)
     GOBACK.
 END PROGRAM JRAND-SET-SEED.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. JRAND-NEXT.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-MULT                BINARY-DOUBLE UNSIGNED VALUE 25214903917.
 01 WS-M48                 BINARY-DOUBLE UNSIGNED VALUE 281474976710656.
 01 WS-POW                 BINARY-DOUBLE UNSIGNED.
 01 WS-SHIFT               BINARY-LONG.
 LINKAGE SECTION.
 01 L-STATE                BINARY-DOUBLE UNSIGNED.
 01 L-BITS                 BINARY-LONG.
 01 L-RESULT               BINARY-DOUBLE.
 PROCEDURE DIVISION USING L-STATE L-BITS L-RESULT.
     COMPUTE L-STATE = FUNCTION MOD(L-STATE * WS-MULT + 11, WS-M48)
     COMPUTE WS-SHIFT = 48 - L-BITS
     COMPUTE WS-POW = 2 ** WS-SHIFT
     COMPUTE L-RESULT = FUNCTION INTEGER(L-STATE / WS-POW)
     IF L-BITS = 32 AND L-RESULT >= 2147483648
         SUBTRACT 4294967296 FROM L-RESULT
     END-IF
     GOBACK.
 END PROGRAM JRAND-NEXT.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. JRAND-NEXT-INT-BOUND.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-BITS                BINARY-LONG VALUE 31.
 01 WS-R                   BINARY-DOUBLE.
 01 WS-VAL                 BINARY-DOUBLE.
 01 WS-POW                 BINARY-DOUBLE.
 01 WS-DONE                BINARY-LONG.
 LINKAGE SECTION.
 01 L-STATE                BINARY-DOUBLE UNSIGNED.
 01 L-BOUND                BINARY-LONG.
 01 L-RESULT               BINARY-LONG.
 PROCEDURE DIVISION USING L-STATE L-BOUND L-RESULT.
     MOVE 1 TO WS-POW
     PERFORM UNTIL WS-POW >= L-BOUND
         COMPUTE WS-POW = WS-POW * 2
     END-PERFORM
     IF WS-POW = L-BOUND
         CALL "JRAND-NEXT" USING L-STATE WS-BITS WS-R
         COMPUTE L-RESULT = FUNCTION INTEGER((L-BOUND * WS-R) / 2147483648)
         GOBACK
     END-IF
     MOVE 0 TO WS-DONE
     PERFORM UNTIL WS-DONE = 1
         CALL "JRAND-NEXT" USING L-STATE WS-BITS WS-R
         COMPUTE WS-VAL = FUNCTION MOD(WS-R, L-BOUND)
         IF WS-R - WS-VAL + (L-BOUND - 1) < 2147483648
             MOVE 1 TO WS-DONE
         END-IF
     END-PERFORM
     MOVE WS-VAL TO L-RESULT
     GOBACK.
 END PROGRAM JRAND-NEXT-INT-BOUND.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. JRAND-NEXT-LONG.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-M64                 PIC 9(20) VALUE 18446744073709551616.
 01 WS-BITS                BINARY-LONG VALUE 32.
 01 WS-HI                  BINARY-DOUBLE.
 01 WS-LO                  BINARY-DOUBLE.
 LINKAGE SECTION.
 01 L-STATE                BINARY-DOUBLE UNSIGNED.
 01 L-RESULT               BINARY-DOUBLE UNSIGNED.
 PROCEDURE DIVISION USING L-STATE L-RESULT.
     CALL "JRAND-NEXT" USING L-STATE WS-BITS WS-HI
     CALL "JRAND-NEXT" USING L-STATE WS-BITS WS-LO
     COMPUTE L-RESULT = FUNCTION MOD(WS-HI * 4294967296 + WS-LO, WS-M64)
     GOBACK.
 END PROGRAM JRAND-NEXT-LONG.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. JRAND-NEXT-FLOAT.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-BITS                BINARY-LONG VALUE 24.
 01 WS-R                   BINARY-DOUBLE.
 01 WS-F                   FLOAT-LONG.
 01 WS-SCALE               FLOAT-LONG VALUE 16777216.
 LINKAGE SECTION.
 01 L-STATE                BINARY-DOUBLE UNSIGNED.
 01 L-RESULT               FLOAT-LONG.
 PROCEDURE DIVISION USING L-STATE L-RESULT.
     CALL "JRAND-NEXT" USING L-STATE WS-BITS WS-R
     MOVE WS-R TO WS-F
     CALL STATIC "cc_f64_div" USING BY REFERENCE WS-F WS-SCALE L-RESULT
     GOBACK.
 END PROGRAM JRAND-NEXT-FLOAT.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. JRAND-LARGE-FEATURE-SEED.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-M64                 PIC 9(20) VALUE 18446744073709551616.
 01 WS-A                   BINARY-DOUBLE UNSIGNED.
 01 WS-B                   BINARY-DOUBLE UNSIGNED.
 01 WS-P                   BINARY-DOUBLE UNSIGNED.
 01 WS-Q                   BINARY-DOUBLE UNSIGNED.
 LINKAGE SECTION.
 01 L-STATE                BINARY-DOUBLE UNSIGNED.
 01 L-SEED                 BINARY-DOUBLE UNSIGNED.
 01 L-CX                   BINARY-LONG.
 01 L-CZ                   BINARY-LONG.
 PROCEDURE DIVISION USING L-STATE L-SEED L-CX L-CZ.
     CALL "JRAND-SET-SEED" USING L-STATE L-SEED
     CALL "JRAND-NEXT-LONG" USING L-STATE WS-A
     CALL "JRAND-NEXT-LONG" USING L-STATE WS-B
     COMPUTE WS-P = FUNCTION MOD(L-CX * WS-A, WS-M64)
     COMPUTE WS-Q = FUNCTION MOD(L-CZ * WS-B, WS-M64)
     CALL "CBL_XOR" USING WS-Q WS-P BY VALUE 8
     CALL "CBL_XOR" USING L-SEED WS-P BY VALUE 8
     CALL "JRAND-SET-SEED" USING L-STATE WS-P
     GOBACK.
 END PROGRAM JRAND-LARGE-FEATURE-SEED.
