*> Small builders and readers of the NBT value tree for the data sources of /data (core/src/cmds-data.cob). Entry points:
*>   NBX-PUT USING compound, key (PIC X(64)), key length, type, integer (BINARY-DOUBLE), float (FLOAT-LONG), node out: a number node (types 1 to 6) set in the compound
*>   NBX-PUT-STR USING compound, key, key length, text (PIC X(256)), text length: a string entry
*>   NBX-ELEM USING list, type, integer, float: a number element added to the list
*>   NBX-UUID-BYTES USING bytes (PIC X(16)), node out: an int array of the four big-endian words
*>   NBX-GET-NUM USING compound, key, key length, value out (FLOAT-LONG), found out (1 when the entry is a number)
*>   NBX-GET-ELEM USING list, index (1 based), value out (FLOAT-LONG), found out (1 when the element exists and is a number)

 IDENTIFICATION DIVISION.
 PROGRAM-ID. NBX-PUT.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY NBXTREE.
 LINKAGE SECTION.
 01 L-COMPOUND             BINARY-LONG.
 01 L-KEY                  PIC X(64).
 01 L-KLEN                 BINARY-LONG.
 01 L-TYPE                 BINARY-LONG.
 01 L-INT                  BINARY-DOUBLE.
 01 L-DBL                  FLOAT-LONG.
 01 L-NODE                 BINARY-LONG.
 PROCEDURE DIVISION USING L-COMPOUND L-KEY L-KLEN L-TYPE L-INT L-DBL L-NODE.
     CALL "NBX-NEW" USING L-TYPE L-NODE
     MOVE L-INT TO NX-INT(L-NODE)
     MOVE L-DBL TO NX-DBL(L-NODE)
     CALL "NBX-SET" USING L-COMPOUND L-KEY L-KLEN L-NODE
     GOBACK.
 END PROGRAM NBX-PUT.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. NBX-PUT-STR.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY NBXTREE.
 01 WS-NODE                BINARY-LONG.
 01 WS-T-STRING            BINARY-LONG VALUE 8.
 LINKAGE SECTION.
 01 L-COMPOUND             BINARY-LONG.
 01 L-KEY                  PIC X(64).
 01 L-KLEN                 BINARY-LONG.
 01 L-TEXT                 PIC X(256).
 01 L-LENGTH               BINARY-LONG.
 PROCEDURE DIVISION USING L-COMPOUND L-KEY L-KLEN L-TEXT L-LENGTH.
     CALL "NBX-NEW" USING WS-T-STRING WS-NODE
     MOVE L-TEXT TO NX-STR(WS-NODE)
     MOVE L-LENGTH TO NX-SLEN(WS-NODE)
     CALL "NBX-SET" USING L-COMPOUND L-KEY L-KLEN WS-NODE
     GOBACK.
 END PROGRAM NBX-PUT-STR.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. NBX-ELEM.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY NBXTREE.
 01 WS-NODE                BINARY-LONG.
 LINKAGE SECTION.
 01 L-LIST                 BINARY-LONG.
 01 L-TYPE                 BINARY-LONG.
 01 L-INT                  BINARY-DOUBLE.
 01 L-DBL                  FLOAT-LONG.
 PROCEDURE DIVISION USING L-LIST L-TYPE L-INT L-DBL.
     CALL "NBX-NEW" USING L-TYPE WS-NODE
     MOVE L-INT TO NX-INT(WS-NODE)
     MOVE L-DBL TO NX-DBL(WS-NODE)
     CALL "NBX-ADD" USING L-LIST WS-NODE
     GOBACK.
 END PROGRAM NBX-ELEM.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. NBX-UUID-BYTES.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY NBXTREE.
 01 WS-T-INT-ARRAY         BINARY-LONG VALUE 11.
 01 WS-T-INT               BINARY-LONG VALUE 3.
 01 WS-W                   BINARY-LONG.
 01 WS-B                   BINARY-LONG.
 01 WS-WORD                BINARY-DOUBLE.
 01 WS-NODE                BINARY-LONG.
 01 WS-POS                 BINARY-LONG.
 LINKAGE SECTION.
 01 L-BYTES                PIC X(16).
 01 L-NODE                 BINARY-LONG.
 PROCEDURE DIVISION USING L-BYTES L-NODE.
     CALL "NBX-NEW" USING WS-T-INT-ARRAY L-NODE
     PERFORM VARYING WS-W FROM 0 BY 1 UNTIL WS-W > 3
         MOVE 0 TO WS-WORD
         PERFORM VARYING WS-B FROM 1 BY 1 UNTIL WS-B > 4
             COMPUTE WS-POS = WS-W * 4 + WS-B
             COMPUTE WS-WORD = WS-WORD * 256 + FUNCTION ORD(L-BYTES(WS-POS:1)) - 1
         END-PERFORM
         CALL "NBX-WRAP" USING WS-T-INT WS-WORD
         CALL "NBX-NEW" USING WS-T-INT WS-NODE
         MOVE WS-WORD TO NX-INT(WS-NODE)
         CALL "NBX-ADD" USING L-NODE WS-NODE
     END-PERFORM
     GOBACK.
 END PROGRAM NBX-UUID-BYTES.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. NBX-NUM-VALUE.
*> USING node, value out (FLOAT-LONG), found out: the number a node of type 1 to 6 holds
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY NBXTREE.
 LINKAGE SECTION.
 01 L-NODE                 BINARY-LONG.
 01 L-VALUE                FLOAT-LONG.
 01 L-FOUND                BINARY-LONG.
 PROCEDURE DIVISION USING L-NODE L-VALUE L-FOUND.
     MOVE 1 TO L-FOUND
     EVALUATE TRUE
         WHEN NX-TYPE(L-NODE) <= 4
             MOVE NX-INT(L-NODE) TO L-VALUE
         WHEN NX-TYPE(L-NODE) <= 6
             MOVE NX-DBL(L-NODE) TO L-VALUE
         WHEN OTHER
             MOVE 0 TO L-FOUND
     END-EVALUATE
     GOBACK.
 END PROGRAM NBX-NUM-VALUE.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. NBX-GET-NUM.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-NODE                BINARY-LONG.
 LINKAGE SECTION.
 01 L-COMPOUND             BINARY-LONG.
 01 L-KEY                  PIC X(64).
 01 L-KLEN                 BINARY-LONG.
 01 L-VALUE                FLOAT-LONG.
 01 L-FOUND                BINARY-LONG.
 PROCEDURE DIVISION USING L-COMPOUND L-KEY L-KLEN L-VALUE L-FOUND.
     MOVE 0 TO L-FOUND
     CALL "NBX-FIND" USING L-COMPOUND L-KEY L-KLEN WS-NODE
     IF WS-NODE > 0
         CALL "NBX-NUM-VALUE" USING WS-NODE L-VALUE L-FOUND
     END-IF
     GOBACK.
 END PROGRAM NBX-GET-NUM.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. NBX-GET-ELEM.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY NBXTREE.
 01 WS-NODE                BINARY-LONG.
 01 WS-I                   BINARY-LONG.
 LINKAGE SECTION.
 01 L-LIST                 BINARY-LONG.
 01 L-INDEX                BINARY-LONG.
 01 L-VALUE                FLOAT-LONG.
 01 L-FOUND                BINARY-LONG.
 PROCEDURE DIVISION USING L-LIST L-INDEX L-VALUE L-FOUND.
     MOVE 0 TO L-FOUND
     MOVE NX-FIRST(L-LIST) TO WS-NODE
     PERFORM VARYING WS-I FROM 2 BY 1 UNTIL WS-I > L-INDEX OR WS-NODE = 0
         MOVE NX-NEXT(WS-NODE) TO WS-NODE
     END-PERFORM
     IF WS-NODE > 0
         CALL "NBX-NUM-VALUE" USING WS-NODE L-VALUE L-FOUND
     END-IF
     GOBACK.
 END PROGRAM NBX-GET-ELEM.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. NBX-PUT-N.
*> USING compound, key (PIC X(16), its length is the text without trailing spaces), type, integer, float, node out: NBX-PUT with a short key (types 9 and 10 make an empty list or compound).
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 WS-KEY                 PIC X(64).
 01 WS-KLEN                BINARY-LONG.
 LINKAGE SECTION.
 01 L-COMPOUND             BINARY-LONG.
 01 L-KEY                  PIC X(16).
 01 L-TYPE                 BINARY-LONG.
 01 L-INT                  BINARY-DOUBLE.
 01 L-DBL                  FLOAT-LONG.
 01 L-NODE                 BINARY-LONG.
 PROCEDURE DIVISION USING L-COMPOUND L-KEY L-TYPE L-INT L-DBL L-NODE.
     MOVE L-KEY TO WS-KEY
     COMPUTE WS-KLEN = FUNCTION LENGTH(FUNCTION TRIM(L-KEY TRAILING))
     CALL "NBX-PUT" USING L-COMPOUND WS-KEY WS-KLEN L-TYPE L-INT L-DBL L-NODE
     GOBACK.
 END PROGRAM NBX-PUT-N.

