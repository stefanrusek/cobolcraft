 PROGRAM-ID. LOOT-RNG-SEED-SEQUENCE.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY LOOTSTATE.
 01 WS-P64                 PIC 9(20) VALUE 18446744073709551616.
 01 WS-I                   BINARY-LONG.
 01 WS-FOUND               BINARY-LONG.
 01 WS-S                   BINARY-DOUBLE.
 01 WS-SALT                BINARY-DOUBLE.
 01 WS-USE-KEY             BINARY-LONG.
 01 WS-KEY-LO              BINARY-DOUBLE UNSIGNED.
 01 WS-KEY-HI              BINARY-DOUBLE UNSIGNED.
 LINKAGE SECTION.
 01 L-KEY                  PIC X(112).
 01 L-WORLD-SEED           BINARY-DOUBLE.
 PROCEDURE DIVISION USING L-KEY L-WORLD-SEED.
     MOVE 0 TO WS-FOUND
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > LQ-COUNT OR WS-FOUND > 0
         IF LQ-KEY(WS-I) = L-KEY
             MOVE WS-I TO WS-FOUND
         END-IF
     END-PERFORM
     IF WS-FOUND > 0
         MOVE WS-FOUND TO LW-SEQ
         MOVE LQ-LO(WS-FOUND) TO LW-LO
         MOVE LQ-HI(WS-FOUND) TO LW-HI
         MOVE 1 TO LW-KIND
         GOBACK
     END-IF
*>   S = (include world seed ? W : 0) xor (long)(int) salt (sign-extended); the key words when the id is included.
     MOVE 0 TO WS-S
     IF LQ-NO-WORLD-SEED = 0
         MOVE L-WORLD-SEED TO WS-S
     END-IF
     COMPUTE WS-SALT = FUNCTION MOD(LQ-SALT, WS-P64)
     CALL "CBL_XOR" USING WS-SALT WS-S BY VALUE 8
     MOVE 0 TO WS-USE-KEY WS-KEY-LO WS-KEY-HI
     IF LQ-NO-SEQUENCE-ID = 0
         MOVE 1 TO WS-USE-KEY
         CALL "LOOT-KEY-HASH" USING L-KEY WS-KEY-LO WS-KEY-HI
     END-IF
     CALL "LOOT-RNG-SEED-128" USING WS-S WS-USE-KEY WS-KEY-LO WS-KEY-HI
     IF LQ-COUNT < LQ-MAX
         ADD 1 TO LQ-COUNT
     END-IF
     MOVE L-KEY TO LQ-KEY(LQ-COUNT)
     MOVE LQ-COUNT TO LW-SEQ
     GOBACK.
 END PROGRAM LOOT-RNG-SEED-SEQUENCE.

