 PROGRAM-ID. LOOT-LCG-NEXT.
*> USING bits (BINARY-LONG, 1 to 31), value out (BINARY-LONG): next(bits) of the Java LCG (10 2.6).
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY LOOTSTATE.
 01 WS-P48                 PIC 9(20) VALUE 281474976710656.
 01 WS-MULTIPLIER          BINARY-DOUBLE UNSIGNED VALUE 25214903917.
 01 WS-DIVISOR             BINARY-DOUBLE UNSIGNED.
 LINKAGE SECTION.
 01 L-BITS                 BINARY-LONG.
 01 L-VALUE                BINARY-LONG.
 PROCEDURE DIVISION USING L-BITS L-VALUE.
     COMPUTE LW-LO = FUNCTION MOD(LW-LO * WS-MULTIPLIER + 11, WS-P48)
     COMPUTE WS-DIVISOR = 2 ** (48 - L-BITS)
     COMPUTE L-VALUE = LW-LO / WS-DIVISOR
     GOBACK.
 END PROGRAM LOOT-LCG-NEXT.

 IDENTIFICATION DIVISION.
 PROGRAM-ID. LOOT-RNG-INT.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY LOOTSTATE.
 01 WS-P32                 PIC 9(20) VALUE 4294967296.
 01 WS-P31                 PIC 9(20) VALUE 2147483648.
 01 WS-DRAW                BINARY-DOUBLE UNSIGNED.
 01 WS-M                   BINARY-DOUBLE UNSIGNED.
 01 WS-LOW                 BINARY-DOUBLE UNSIGNED.
 01 WS-THRESHOLD           BINARY-DOUBLE UNSIGNED.
 01 WS-BOUND               BINARY-DOUBLE UNSIGNED.
 01 WS-POWER               BINARY-DOUBLE UNSIGNED.
 01 WS-BITS                BINARY-LONG VALUE 31.
 01 WS-R                   BINARY-LONG.
 01 WS-U                   BINARY-LONG.
 01 WS-SPAN                BINARY-DOUBLE.
 LINKAGE SECTION.
 01 L-BOUND                BINARY-LONG.
 01 L-RESULT               BINARY-LONG.
 PROCEDURE DIVISION USING L-BOUND L-RESULT.
     MOVE L-BOUND TO WS-BOUND
     IF LW-KIND = 1
*>       Lemire's method on the low 32 bits (10 2.3).
         CALL "LOOT-RNG-LONG" USING WS-DRAW
         COMPUTE WS-DRAW = FUNCTION MOD(WS-DRAW, WS-P32)
         COMPUTE WS-M = WS-DRAW * WS-BOUND
         COMPUTE WS-LOW = FUNCTION MOD(WS-M, WS-P32)
         IF WS-LOW < WS-BOUND
             COMPUTE WS-THRESHOLD = FUNCTION MOD(WS-P32 - WS-BOUND, WS-BOUND)
             PERFORM UNTIL WS-LOW >= WS-THRESHOLD
                 CALL "LOOT-RNG-LONG" USING WS-DRAW
                 COMPUTE WS-DRAW = FUNCTION MOD(WS-DRAW, WS-P32)
                 COMPUTE WS-M = WS-DRAW * WS-BOUND
                 COMPUTE WS-LOW = FUNCTION MOD(WS-M, WS-P32)
             END-PERFORM
         END-IF
         COMPUTE L-RESULT = WS-M / WS-P32
         GOBACK
     END-IF
*>   Java's Random.nextInt(bound): a power of two scales next(31), else the rejection loop on next(31) % bound.
     CALL "LOOT-LCG-NEXT" USING WS-BITS WS-R
     MOVE 1 TO WS-POWER
     PERFORM UNTIL WS-POWER >= WS-BOUND
         COMPUTE WS-POWER = WS-POWER * 2
     END-PERFORM
     IF WS-POWER = WS-BOUND
         COMPUTE L-RESULT = (WS-BOUND * WS-R) / WS-P31
         GOBACK
     END-IF
     MOVE WS-R TO WS-U
     COMPUTE WS-R = FUNCTION MOD(WS-U, L-BOUND)
     COMPUTE WS-SPAN = WS-U - WS-R + L-BOUND - 1
     PERFORM UNTIL WS-SPAN < WS-P31
         CALL "LOOT-LCG-NEXT" USING WS-BITS WS-U
         COMPUTE WS-R = FUNCTION MOD(WS-U, L-BOUND)
         COMPUTE WS-SPAN = WS-U - WS-R + L-BOUND - 1
     END-PERFORM
     MOVE WS-R TO L-RESULT
     GOBACK.
 END PROGRAM LOOT-RNG-INT.

