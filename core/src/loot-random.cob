 PROGRAM-ID. LOOT-RNG-LONG.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 COPY LOOTSTATE.
 01 WS-P64                 PIC 9(20) VALUE 18446744073709551616.
 01 WS-P17                 PIC 9(20) VALUE 131072.
 01 WS-P47                 PIC 9(20) VALUE 140737488355328.
 01 WS-P49                 PIC 9(20) VALUE 562949953421312.
 01 WS-P15                 PIC 9(20) VALUE 32768.
 01 WS-P21                 PIC 9(20) VALUE 2097152.
 01 WS-P28                 PIC 9(20) VALUE 268435456.
 01 WS-P36                 PIC 9(20) VALUE 68719476736.
 01 WS-SUM                 BINARY-DOUBLE UNSIGNED.
 01 WS-HI                  BINARY-DOUBLE UNSIGNED.
 01 WS-SHIFTED             BINARY-DOUBLE UNSIGNED.
 01 WS-LO                  BINARY-DOUBLE UNSIGNED.
 LINKAGE SECTION.
 01 L-VALUE                BINARY-DOUBLE UNSIGNED.
 PROCEDURE DIVISION USING L-VALUE.
*>   result = rotl(lo + hi, 17) + lo
     COMPUTE WS-SUM = FUNCTION MOD(LW-LO + LW-HI, WS-P64)
     COMPUTE WS-SHIFTED = WS-SUM / WS-P47
     COMPUTE L-VALUE = FUNCTION MOD(FUNCTION MOD(WS-SUM * WS-P17, WS-P64) + WS-SHIFTED + LW-LO, WS-P64)
*>   hi = hi xor lo; lo = rotl(lo, 49) xor hi xor (hi << 21); hi = rotl(hi, 28)
     MOVE LW-HI TO WS-HI
     CALL "CBL_XOR" USING LW-LO WS-HI BY VALUE 8
     COMPUTE WS-SHIFTED = LW-LO / WS-P15
     COMPUTE WS-LO = FUNCTION MOD(LW-LO * WS-P49, WS-P64) + WS-SHIFTED
     CALL "CBL_XOR" USING WS-HI WS-LO BY VALUE 8
     COMPUTE WS-SHIFTED = FUNCTION MOD(WS-HI * WS-P21, WS-P64)
     CALL "CBL_XOR" USING WS-SHIFTED WS-LO BY VALUE 8
     MOVE WS-LO TO LW-LO
     COMPUTE WS-SHIFTED = WS-HI / WS-P36
     COMPUTE LW-HI = FUNCTION MOD(WS-HI * WS-P28, WS-P64) + WS-SHIFTED
     GOBACK.
 END PROGRAM LOOT-RNG-LONG.

