     END-IF
     CALL STATIC "cc_f64_add" USING BY REFERENCE L-CX L-HR WS-T
     CALL STATIC "cc_f64_floor" USING BY REFERENCE WS-T WS-A
     COMPUTE WS-XHI = WS-A - WS-MINX
     IF WS-XHI > 15
