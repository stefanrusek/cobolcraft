 CLOCK-NOW.
     MOVE FUNCTION CURRENT-DATE TO WS-CLOCK
     COMPUTE WS-NOW = ((WS-CLOCK-HH * 60 + WS-CLOCK-MM) * 60 + WS-CLOCK-SS) * 100 + WS-CLOCK-CC.

 REPORT-ONE.
     PERFORM CLOCK-NOW
     COMPUTE WS-ELAPSED = WS-NOW - WS-START
     IF WS-ELAPSED < 0
         ADD 8640000 TO WS-ELAPSED
     END-IF
     COMPUTE WS-SECONDS = WS-ELAPSED / 100
     ADD 1 TO WS-TOTAL
     MOVE WS-STATUS TO WS-SHOWN
     IF WS-STATUS = CT-OK
         DISPLAY "LOADER " FUNCTION TRIM(WS-NAME) " status=" WS-SHOWN " ok seconds=" FUNCTION TRIM(WS-SECONDS) UPON STDERR
     ELSE
         ADD 1 TO WS-FAILED
         DISPLAY "LOADER " FUNCTION TRIM(WS-NAME) " status=" WS-SHOWN " FAILED seconds=" FUNCTION TRIM(WS-SECONDS) UPON STDERR
     END-IF.
