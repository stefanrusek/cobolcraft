 IDENTIFICATION DIVISION.
 PROGRAM-ID. CV-SERVER-START.
 ENVIRONMENT DIVISION.
 INPUT-OUTPUT SECTION.
 FILE-CONTROL.
     SELECT CONF-FILE ASSIGN TO WS-PATH
         ORGANIZATION LINE SEQUENTIAL
         FILE STATUS WS-STATUS.
 DATA DIVISION.
 FILE SECTION.
 FD CONF-FILE.
 01 CONF-LINE              PIC X(1024).
 WORKING-STORAGE SECTION.
 COPY SVSTATE.
 01 WS-PATH                PIC X(256).
 01 WS-STATUS              PIC XX.
 01 WS-PORT                BINARY-LONG.
 01 WS-EDIT                PIC Z(5)9.
 01 WS-I                   BINARY-LONG.
 01 WS-FROM                BINARY-LONG.
 01 WS-END                 BINARY-LONG.
 LINKAGE SECTION.
 COPY CONVH.
 01 L-CONF                 PIC X(1024).
 PROCEDURE DIVISION USING CONVH L-CONF.
     CALL "CV-FREE-PORT" USING WS-PORT
     MOVE SPACES TO WS-PATH
     STRING CV-DIR(1:CV-DIR-LENGTH) "/server/cobolcraft-server.conf" DELIMITED BY SIZE
         INTO WS-PATH
     OPEN OUTPUT CONF-FILE
     MOVE WS-PORT TO WS-EDIT
     MOVE SPACES TO CONF-LINE
     STRING "port=" FUNCTION TRIM(WS-EDIT) DELIMITED BY SIZE INTO CONF-LINE
     WRITE CONF-LINE
     MOVE 1024 TO WS-END
     PERFORM UNTIL WS-END = 0 OR L-CONF(WS-END:1) NOT = SPACE
         SUBTRACT 1 FROM WS-END
     END-PERFORM
     MOVE 1 TO WS-FROM
     PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-END + 1
         IF WS-I > WS-END OR L-CONF(WS-I:1) = "|"
             IF WS-I > WS-FROM
                 MOVE L-CONF(WS-FROM:WS-I - WS-FROM) TO CONF-LINE
                 WRITE CONF-LINE
             END-IF
             COMPUTE WS-FROM = WS-I + 1
         END-IF
     END-PERFORM
     CLOSE CONF-FILE
     CALL "CV-CD-SERVER" USING CONVH
     CALL "SV-START"
     CALL "CV-CD-BACK"
     MOVE 1 TO CV-SERVER
     MOVE SV-BOUND-PORT TO CV-PORT
     GOBACK.
 END PROGRAM CV-SERVER-START.

